# =============================================================================
# Unio — copie para .env.local e ajuste com seus dados locais
# cp .env.local.example .env.local
# =============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=altere-para-uma-string-aleatoria-longa
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB/MySQL — porta fixa 3308 (container mariadb)
DATABASE_URL="mysql://root:SUA_SENHA@127.0.0.1:3308/unio?serverVersion=10.11.15-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Desenvolvimento (sem envio): null://null
# Docker + Mailpit: smtp://127.0.0.1:1025  (UI em http://127.0.0.1:8025)
# Produção (SMTP real — obrigatório para reset de senha por e-mail):
# MAILER_DSN=smtp://usuario:senha@smtp.seudominio.com:587
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@suaempresa.com
###< symfony/mailer ###

###> symfony/mercure-bundle ###
# docker compose up -d mercure  (porta 3000)
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=changeme
###< symfony/mercure-bundle ###

###> symfony/cache — produção: docker compose up -d redis ###
REDIS_URL=redis://127.0.0.1:6379
###< symfony/cache ###

###> vitoria-ai (services/vitoria-ai — FastAPI) ###
# Suba: cd services/vitoria-ai && uvicorn app.main:app --reload --port 8100
VITORIA_AI_ENABLED=true
VITORIA_AI_URL=http://127.0.0.1:8100
VITORIA_AI_KEY=dev-vitoria-key-change-me
###< vitoria-ai ###

###> unio-organismo ###
# Transição Colônia / Pulso / Lumen (false = shell legado hub/núcleo)
UNIO_ORGANISMO_ENABLED=true
UNIO_ORGANISMO_PULSO_HOME=true
#
# Perfil do deploy (define o que fica ativo):
# - Unio Saúde / clínica: defaults em config/packages/unio_organismo.yaml
# - Uniowork Studio: copie UNIO_ORGANISMO_* de .env.prod.example para .env.local
#
# Com perfil Studio, rotas de carteirinha/comprovante/verificar/paciente/wallet retornam 404.
###< unio-organismo ###

###> symfony/debug ###
# VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/debug ###

###> unio — senha padrão de logins demo/seed ###
# Usada por app:seed-users e app:users:reset-all-passwords
APP_DEFAULT_USER_PASSWORD=altere-para-sua-senha-segura
###< unio — senha padrão de logins demo/seed ###

###> whatsapp meta cloud api (Unio Saúde) ###
# Vazio = noop (wa.me + webhook). Para envio live: WHATSAPP_PROVIDER=meta
WHATSAPP_PROVIDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v21.0
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_EMPRESA_CNPJ=
# Múltiplos números: {"PHONE_NUMBER_ID":"CNPJ_SEM_PONTUACAO"}
WHATSAPP_META_TENANT_MAP={}
###< whatsapp meta cloud api ###

###> asaas payments (Unio Saúde) ###
ASAAS_API_KEY=
# Múltiplas clínicas: {"CNPJ_SEM_PONTUACAO":"$aact_..."}
ASAAS_API_KEYS_JSON={}
# Token global do webhook Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
###< asaas payments ###
