# Copie para .env.local no servidor de homologacao (NAO commite .env.local)
# Caminho sugerido: ~/unio-staging/.env.local
# URL: https://staging.uniowork.com.br
# Branch: new_staging

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=altere-gerar-string-aleatoria-64-chars

DEFAULT_URI=https://staging.uniowork.com.br

DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO?serverVersion=5.7.44&charset=utf8mb4"

MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@uniowork.com.br

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

REDIS_URL=

VITORIA_AI_ENABLED=false
