# Copie para .env.local no servidor Unio Saúde (NÃO commite .env.local)
# Caminho: ~/unio-uniosaude/.env.local
# URL: https://uniosaude.uniowork.com.br

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=altere-gerar-string-aleatoria-64-chars

DEFAULT_URI=https://uniosaude.uniowork.com.br

DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/joabef36_unio_uniosaude?serverVersion=5.7.44&charset=utf8mb4"

MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@uniowork.com.br

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

REDIS_URL=

# Shell Unio Saúde (Organismo)
UNIO_ORGANISMO_ENABLED=true
UNIO_ORGANISMO_PULSO_HOME=true
UNIO_ORGANISMO_BRAND_NAME="Unio Saúde"
UNIO_ORGANISMO_BRAND_SLOGAN="Saúde que acompanha."
UNIO_ORGANISMO_HERO_TITLE="Acompanhamento pós-cirúrgico"
UNIO_ORGANISMO_HERO_TITLE_ACCENT="inteligente e humano."
UNIO_ORGANISMO_HERO_DESC="Unio Saúde reúne cadastro de pacientes, protocolos de recuperação, alertas clínicos e questionários de acompanhamento."
UNIO_ORGANISMO_LUMEN_SUBTITLE="Assistente clínico"
UNIO_ORGANISMO_UNIT_LABEL="Clínica"
UNIO_ORGANISMO_UNIT_LABEL_ARTIGO="da clínica"
UNIO_ORGANISMO_UNIT_LABEL_PLURAL="Clínicas"
UNIO_ORGANISMO_NAV_MATURIDADE="Painel de Recuperação"
UNIO_ORGANISMO_NAV_SECTION_CLIENTS="Pacientes"
UNIO_ORGANISMO_NAV_PACIENTES="Pacientes"
UNIO_ORGANISMO_NAV_SALA_CRITICA="Sala Crítica"
UNIO_ORGANISMO_NAV_ALERTAS="Alertas"
UNIO_ORGANISMO_NAV_SECTION_DELIVERABLES="Acompanhamento"
UNIO_ORGANISMO_NAV_PROTOCOLOS="Protocolos"
UNIO_ORGANISMO_NAV_QUESTIONARIOS="Questionários"
UNIO_ORGANISMO_NAV_PORTAL="Portal do Paciente"
UNIO_ORGANISMO_PULSO_PROJECTS_ACTIVE="Pacientes ativos"
UNIO_ORGANISMO_PULSO_IN_PROGRESS="Em acompanhamento"
UNIO_ORGANISMO_PULSO_CASES_HEADING="Casos em andamento"
UNIO_ORGANISMO_PULSO_KPIS_HEADING="Sinais vitais da clínica"
UNIO_ORGANISMO_PULSO_EMPTY="Nenhum caso ativo — tudo tranquilo na clínica."
UNIO_ORGANISMO_HUB_HERO_TITLE="Painel clínico"
UNIO_ORGANISMO_MARKETING_EYEBROW="Plataforma clínica pós-operatória"
UNIO_ORGANISMO_MARKETING_TAGLINE="Saúde que acompanha."

VITORIA_AI_ENABLED=false
VITORIA_AI_URL=
VITORIA_AI_KEY=

MERCURE_URL=
MERCURE_PUBLIC_URL=
MERCURE_JWT_SECRET=

###> wallet passes (Apple / Google) — apenas Unio Saúde ###
WALLET_APPLE_PASS_TYPE_ID=pass.br.com.uniosaude.carteirinha
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_CERT_PATH=config/wallet/apple-pass.p12
WALLET_APPLE_CERT_PASSWORD=
WALLET_APPLE_WWDR_PATH=config/wallet/AppleWWDRCAG4.pem
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_SERVICE_ACCOUNT_PATH=config/wallet/google-service-account.json
WALLET_GOOGLE_ORIGINS=https://uniosaude.uniowork.com.br
###< wallet passes ###

###> whatsapp meta cloud api ###
# Envio automático D-1 + questionário. Sem isto, permanece wa.me + webhook.
WHATSAPP_PROVIDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v21.0
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
# Instalação com um número:
WHATSAPP_META_EMPRESA_CNPJ=
# Múltiplos números: {"PHONE_NUMBER_ID":"CNPJ_SEM_PONTUACAO"}
WHATSAPP_META_TENANT_MAP={}
# WHATSAPP_PROVIDER=meta
###< whatsapp meta cloud api ###

###> asaas payments ###
# Instalação com uma conta:
ASAAS_API_KEY=
# Múltiplas clínicas: {"CNPJ_SEM_PONTUACAO":"$aact_..."}
ASAAS_API_KEYS_JSON={}
# Segredo obrigatório, enviado pelo Asaas no header asaas-access-token
ASAAS_WEBHOOK_TOKEN=
###< asaas payments ###
