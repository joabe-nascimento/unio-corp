# Copie para .env.local no servidor Clinica Unio (NÃO commite .env.local)
# Caminho: ~/unio-clinicaunio/.env.local
# URL: https://clinicaunio.uniowork.com.br

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=altere-gerar-string-aleatoria-64-chars

DEFAULT_URI=https://clinicaunio.uniowork.com.br

DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/joabef36_unio_clinicaunio?serverVersion=5.7.44&charset=utf8mb4"

MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@uniowork.com.br

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

REDIS_URL=

# Shell Unio Clínica (Organismo)
UNIO_ORGANISMO_ENABLED=true
UNIO_ORGANISMO_PULSO_HOME=true

VITORIA_AI_ENABLED=false
VITORIA_AI_URL=
VITORIA_AI_KEY=

MERCURE_URL=
MERCURE_PUBLIC_URL=
MERCURE_JWT_SECRET=
