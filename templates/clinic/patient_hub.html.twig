{% extends 'beneficiary/layout.html.twig' %}

{% block benef_title %}Área do paciente{% endblock %}
{% block benef_product %}{{ hub.branding.nome_exibicao|default('Área do paciente') }}{% endblock %}
{% set benef_nav_active = 'home' %}

{% block benef_head %}
<link rel="stylesheet" href="{{ asset('css/clinic-patient-hub.css') }}?v=3">
{% endblock %}

{% block benef_content %}
<div class="benef-shell clinic-patient-hub" style="--clinic-primary: {{ hub.branding.cor_primaria|default('#4b72be') }}">
    <div class="benef-card clinic-patient-hub__hero">
        <header class="benef-card__head clinic-patient-hub__head">
            {% if hub.branding.logo_url|default('') %}
            <img src="{{ hub.branding.logo_url }}" alt="" class="clinic-patient-hub__logo" width="120" height="40">
            {% endif %}
            <div>
                <p class="clinic-patient-hub__eyebrow">Área do paciente</p>
                <h1>{{ hub.branding.nome_exibicao|default('Área do paciente') }}</h1>
                <p>{{ hub.branding.slogan|default('Um só lugar para recuperação, documentos e contato com a clínica.') }}</p>
            </div>
        </header>
    </div>

    {% if not authenticated %}
    <div class="benef-card clinic-patient-hub__intro-card">
        <p class="clinic-patient-hub__lede">Identifique-se em qualquer produto abaixo (CPF + código em dois passos) para ver seu painel personalizado.</p>
        <div class="clinic-patient-hub__demo">
            <h2>Demonstração sandbox</h2>
            <p>Ana Costa, João Pereira e Maria Silva. Use na carteirinha digital:</p>
            <ul>
                <li>CPF <code>{{ hub.demo_access.cpf_masked|default('529.982.247-25') }}</code> + código <code>{{ hub.demo_access.codigo|default('PO-0042') }}</code></li>
            </ul>
        </div>
    </div>
    {% else %}
    <div class="benef-card clinic-patient-hub__welcome-card">
        <div class="clinic-patient-hub__welcome">
            <div>
                <h2>Olá, {{ hub.patient.nome|default('Beneficiário') }}</h2>
                {% if hub.patient.status_clinico|default('') %}
                <p class="clinic-patient-hub__status">{{ hub.patient.status_clinico }}</p>
                {% endif %}
            </div>
            {% if hub.dependents|default([])|length > 1 %}
            <div class="clinic-patient-hub__dependents">
                <span>Trocar beneficiário:</span>
                {% for dep in hub.dependents %}
                <a href="{{ path('app_paciente_trocar', {patientId: dep.id}) }}" class="clinic-patient-hub__dep{% if dep.codigo == hub.patient.codigo %} is-active{% endif %}">{{ dep.nome }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>

    {% if hub.notifications|default([])|length %}
    <section class="clinic-patient-hub__alerts" aria-label="Avisos">
        {% for n in hub.notifications %}
        <div class="clinic-patient-hub__alert clinic-patient-hub__alert--{{ n.tipo }}">{{ n.texto }}</div>
        {% endfor %}
    </section>
    {% endif %}

    <div class="benef-card clinic-patient-hub__panel">
        <h3 class="clinic-patient-hub__section-title">Minha recuperação</h3>
        <ol class="clinic-patient-hub__milestones">
            {% for item in hub.timeline|default([]) %}
            <li class="is-{{ item.status }}">
                <strong>{{ item.label }}</strong>
                <span>{{ item.desc }}</span>
            </li>
            {% endfor %}
        </ol>
    </div>

    <div class="benef-card clinic-patient-hub__panel">
        <h3 class="clinic-patient-hub__section-title">Documentos</h3>
        <div class="clinic-patient-hub__doc-grid">
            {% for doc in hub.documents|default([]) %}
            <a href="{{ path(doc.route, doc.params|default({})) }}" class="clinic-patient-hub__doc">
                <i class="fas fa-file" aria-hidden="true"></i>
                <span>{{ doc.label }}</span>
                {% if doc.valido_ate %}<small>Válido até {{ doc.valido_ate }}</small>{% endif %}
                {% if doc.hash_curto|default(doc.hash)|default('') %}<small>Assinatura {{ doc.hash_curto|default(doc.hash|slice(0,12)) }}</small>{% endif %}
            </a>
            {% endfor %}
        </div>
    </div>

    <div class="benef-card clinic-patient-hub__panel">
        <h3 class="clinic-patient-hub__section-title">Ações rápidas</h3>
        <div class="clinic-patient-hub__action-grid">
            {% for action in hub.actions|default([]) %}
            <a href="{{ path(action.route, action.params|default({})) }}" class="clinic-patient-hub__action">
                <i class="fas {{ action.icon }}" aria-hidden="true"></i>
                {{ action.label }}
            </a>
            {% endfor %}
        </div>
    </div>

    {% if hub.retornos|default([])|length %}
    <div class="benef-card clinic-patient-hub__panel">
        <h3 class="clinic-patient-hub__section-title">Retornos</h3>
        <ul class="clinic-patient-hub__retornos">
            {% for r in hub.retornos %}
            <li><strong>{{ r.marco }}</strong>: {{ r.data }} · {{ r.local }} ({{ r.status }})</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    {% endif %}

    <section class="clinic-patient-hub__products" aria-labelledby="clinic-patient-hub-products-title">
        <h2 id="clinic-patient-hub-products-title" class="clinic-patient-hub__section-title clinic-patient-hub__section-title--lg">Produtos para você</h2>
        <div class="clinic-patient-hub__grid">
            {% for card in hub.products|default([]) %}
            <a href="{{ path(card.route) }}" class="clinic-patient-hub__card">
                <span class="clinic-patient-hub__card-icon" aria-hidden="true"><i class="fas {{ card.icon }}"></i></span>
                <h3>{{ card.label }}</h3>
                <p>{{ card.desc }}</p>
            </a>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
