{# Toolbar Clínica — menu à esquerda, perfil à direita (Vitória vive na aba de borda) #}
<nav class="main-header navbar navbar-expand organismo-toolbar" aria-label="Barra superior">

    <div class="organismo-toolbar__start">
        <a class="nav-link nav-toggle-btn organismo-toolbar__menu" data-unio-shell-toggle="sidebar" href="#" role="button" aria-label="Alternar menu lateral">
            <span class="nav-toggle-icon" aria-hidden="true">
                <span class="nav-toggle-bars">
                    <span class="nav-toggle-line"></span>
                    <span class="nav-toggle-line"></span>
                    <span class="nav-toggle-line"></span>
                </span>
                <svg class="nav-toggle-collapse" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4.75 5.5A1.75 1.75 0 0 1 6.5 3.75h11A1.75 1.75 0 0 1 19.25 5.5v13a1.75 1.75 0 0 1-1.75 1.75h-11A1.75 1.75 0 0 1 4.75 18.5v-13Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                    <path d="M9.25 3.75v16.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    <path d="M15.25 12H12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    <path d="M14 9.25 11.25 12 14 14.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
        </a>
    </div>

    <div class="organismo-toolbar__end">
        {% if app.user %}
        {% include 'components/agente_autonomo_meter.html.twig' %}
        {% include 'components/ai_token_meter.html.twig' %}
        <div class="organismo-toolbar__identity">
            {% include 'components/sidebar_identity_hub.html.twig' %}
        </div>
        {% endif %}
    </div>

</nav>
