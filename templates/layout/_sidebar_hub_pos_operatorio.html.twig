{# Menu lateral — Unio Clínica (modo legado com grants) #}
{% import 'macros/sidebar_nav.html.twig' as nav %}

<li class="nav-item sidebar-hub-current">
    <a href="{{ path('app_pos_operatorio') }}" class="nav-link{{ route == 'app_pos_operatorio' ? ' active' : '' }}">
        <i class="fas fa-heart-pulse nav-icon"></i>
        <p>Unio Clínica</p>
    </a>
</li>

{% if product_grant('hub_pos_operatorio', 'pacientes') %}
<li class="nav-item nav-item--cta">
    <a href="{{ path('app_pos_operatorio_pacientes', { open_novo: 1 }) }}" class="nav-link nav-link--cta{{ route == 'app_pos_operatorio_pacientes' and app.request.query.getBoolean('open_novo') ? ' active' : '' }}">
        <i class="fas fa-plus nav-icon" aria-hidden="true"></i>
        <p>Novo paciente</p>
    </a>
</li>
{% endif %}

{% set pos_op_group_open = {
    'clinica': nav_modulo_pos_op_clinica_open|default(false),
    'monitoramento': nav_modulo_pos_op_monitoramento_open|default(false),
    'paciente': nav_modulo_pos_op_paciente_open|default(false),
} %}

{% for group in pos_op_sidebar_groups() %}
    {% set group_open = pos_op_group_open[group.key]|default(false) %}

    {% set group_visible = false %}
    {% for mod in pos_op_modules_for_group(group.key) %}
        {% if product_grant('hub_pos_operatorio', mod.grant) %}
            {% set group_visible = true %}
        {% endif %}
    {% endfor %}

    {% if group_visible %}
    <li class="nav-item has-treeview"
        data-module-tree
        data-auto-open="{{ group_open ? '1' : '0' }}"
        data-storage-key="{{ group.storage_key }}">
        <a href="#" class="nav-link{{ group_open ? ' active' : '' }}">
            <i class="fas {{ group.icon }} nav-icon"></i>
            <p>{{ group.label }} <i class="fas fa-angle-left right"></i></p>
        </a>
        <ul class="nav nav-treeview nav-product-children">
            {% for mod in pos_op_modules_for_group(group.key) %}
                {% if product_grant('hub_pos_operatorio', mod.grant) %}
                    {{ nav.submenu(
                        pos_op_module_sidebar_label(mod),
                        path(mod.route),
                        pos_op_module_route_active(route, mod)
                    ) }}
                {% endif %}
            {% endfor %}
        </ul>
    </li>
    {% endif %}
{% endfor %}
