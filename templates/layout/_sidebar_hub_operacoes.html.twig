{% import 'macros/sidebar_nav.html.twig' as nav %}
{# Hub de Operações — painel interno #}
<li class="nav-item sidebar-hub-current">
    <a href="{{ path('app_hub_operacoes') }}" class="nav-link{{ route == 'app_hub_operacoes' ? ' active' : '' }}">
        <i class="fas fa-building nav-icon"></i>
        <p>Hub de Operações</p>
    </a>
</li>

{% if nav_show_modulo_rh|default(false) %}
<li class="nav-item has-treeview"
    data-rh-module-tree
    data-auto-open="{{ modulo_rh_open ? '1' : '0' }}">
    <a href="#" class="nav-link{{ modulo_rh_open ? ' active' : '' }}">
        <i class="fas fa-id-card nav-icon"></i>
        <p>Recursos Humanos <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children rh-product-children">
        {% include 'components/rh/sidebar_nav.html.twig' %}
    </ul>
</li>
{% endif %}

{% if nav_show_modulo_pessoas|default(false) %}
<li class="nav-item has-treeview"
    data-module-tree
    data-auto-open="{{ modulo_pessoas_open ? '1' : '0' }}"
    data-storage-key="pessoas-sidebar-collapsed">
    <a href="#" class="nav-link{{ modulo_pessoas_open ? ' active' : '' }}">
        <i class="fas fa-people-group nav-icon"></i>
        <p>Gestão de Pessoas <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children">
        {{ nav.submenu('Visão geral', path('app_pessoas'), route == 'app_pessoas') }}
        {% if product_grant('product_pessoas', 'membros') %}
        {{ nav.submenu('Membros', path('app_pessoas_membros'), route starts with 'app_pessoas_membro') }}
        {% endif %}
        {% if product_grant('product_pessoas', 'equipes') %}
        {{ nav.submenu('Equipes', path('app_pessoas_equipes'), route starts with 'app_pessoas_equipe') }}
        {% endif %}
        {% if product_grant('product_pessoas', 'cargos') %}
        {{ nav.submenu('Cargos', path('app_pessoas_cargos'), route == 'app_pessoas_cargos') }}
        {% endif %}
        {% if product_grant('product_pessoas', 'membros') %}
        {{ nav.submenu('Organograma', path('app_pessoas_organograma'), route == 'app_pessoas_organograma') }}
        {% endif %}
        {% if product_grant('product_pessoas', 'avaliacao') %}
        {{ nav.submenu('Avaliação', path('app_pessoas_avaliacao'), route == 'app_pessoas_avaliacao') }}
        {% endif %}
    </ul>
</li>
{% endif %}

{% if nav_show_modulo_engenharia|default(false) %}
<li class="nav-item has-treeview"
    data-module-tree
    data-auto-open="{{ modulo_engenharia_open ? '1' : '0' }}"
    data-storage-key="engenharia-sidebar-collapsed">
    <a href="#" class="nav-link{{ modulo_engenharia_open ? ' active' : '' }}">
        <i class="fas fa-hard-hat nav-icon"></i>
        <p>Obras e Projetos <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children">
        {{ nav.submenu('Visão geral', path('app_engenharia'), route == 'app_engenharia') }}
        {{ nav.submenu('Projetos e Obras', path('app_engenharia_projetos'), route == 'app_engenharia_projetos') }}
        {{ nav.submenu('Cronograma', path('app_engenharia_cronograma'), route == 'app_engenharia_cronograma') }}
        {{ nav.submenu('Orçamentos', path('app_engenharia_orcamentos'), route == 'app_engenharia_orcamentos') }}
        {{ nav.submenu('Equipes de Campo', path('app_engenharia_equipes'), route == 'app_engenharia_equipes') }}
        {{ nav.submenu('Documentação Técnica', path('app_engenharia_documentacao'), route == 'app_engenharia_documentacao') }}
        {{ nav.submenu('Normas e Conformidade', path('app_engenharia_normas'), route == 'app_engenharia_normas') }}
    </ul>
</li>
{% endif %}
