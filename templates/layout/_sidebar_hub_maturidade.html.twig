{% import 'macros/sidebar_nav.html.twig' as nav %}
<li class="nav-item sidebar-hub-current">
    <a href="{{ path('app_maturidade') }}" class="nav-link{{ route == 'app_maturidade' ? ' active' : '' }}">
        <i class="fas fa-seedling nav-icon"></i>
        <p>Núcleo de Maturidade</p>
    </a>
</li>
{% if product_grant('hub_maturidade', 'avaliacao') %}
<li class="nav-item">
    <a href="{{ path('app_maturidade_avaliacao') }}" class="nav-link {{ route == 'app_maturidade_avaliacao' ? 'active' : '' }}">
        <i class="fas fa-clipboard-check nav-icon"></i>
        <p>Avaliação</p>
    </a>
</li>
{% endif %}
{% if product_grant('hub_maturidade', 'radar') %}
<li class="nav-item">
    <a href="{{ path('app_maturidade_radar') }}" class="nav-link {{ route == 'app_maturidade_radar' ? 'active' : '' }}">
        <i class="fas fa-bullseye nav-icon"></i>
        <p>Radar de Maturidade</p>
    </a>
</li>
{% endif %}
{% if product_grant('hub_maturidade', 'plano') %}
<li class="nav-item">
    <a href="{{ path('app_maturidade_plano') }}" class="nav-link {{ route == 'app_maturidade_plano' ? 'active' : '' }}">
        <i class="fas fa-list-check nav-icon"></i>
        <p>Plano de Ação</p>
    </a>
</li>
{% endif %}
{% if product_grant('hub_maturidade', 'historico') %}
<li class="nav-item">
    <a href="{{ path('app_maturidade_historico') }}" class="nav-link {{ route == 'app_maturidade_historico' ? 'active' : '' }}">
        <i class="fas fa-clock-rotate-left nav-icon"></i>
        <p>Histórico</p>
    </a>
</li>
{% endif %}

{% if nav_show_modulo_publicidade|default(false) %}
<li class="nav-item has-treeview"
    data-module-tree
    data-auto-open="{{ modulo_publicidade_open ? '1' : '0' }}"
    data-storage-key="publicidade-sidebar-collapsed">
    <a href="#" class="nav-link{{ modulo_publicidade_open ? ' active' : '' }}">
        <i class="fas fa-bullhorn nav-icon"></i>
        <p>Marca e Comunicação <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children">
        {{ nav.submenu('Visão geral', path('app_publicidade'), route == 'app_publicidade') }}
        {{ nav.submenu('Campanhas', path('app_publicidade_campanhas'), route == 'app_publicidade_campanhas') }}
        {{ nav.submenu('Clientes e Marcas', path('app_publicidade_clientes'), route == 'app_publicidade_clientes') }}
        {{ nav.submenu('Criativos', path('app_publicidade_criativos'), route == 'app_publicidade_criativos') }}
        {{ nav.submenu('Mídia e Canais', path('app_publicidade_midia'), route == 'app_publicidade_midia') }}
        {{ nav.submenu('Briefings', path('app_publicidade_briefings'), route == 'app_publicidade_briefings') }}
        {{ nav.submenu('Métricas e ROI', path('app_publicidade_metricas'), route == 'app_publicidade_metricas') }}
    </ul>
</li>
{% endif %}
