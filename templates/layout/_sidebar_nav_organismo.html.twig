{# Navegação Organismo — Studio (prod) vs Clínica (uniosaude) #}
{% import 'macros/sidebar_nav.html.twig' as nav %}
{% set route = app.request.attributes.get('_route') %}
{% set badges = clinic_nav_badges|default({}) %}
{% set copy = organismo.copy|default({}) %}
{% set _clinic = org_clinic|default(false) %}

<li class="nav-item">
    <a href="{{ path('app_dashboard') }}" class="nav-link {{ route == 'app_dashboard' or route == 'app_pulso' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-house-medical' : 'fa-house' }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>Início</p>
    </a>
</li>

{% if _clinic and clinic_nav_sections is defined and clinic_nav_features is defined %}
{# ── Produtos modulares (grupo expansível) ── #}
{% set _products_open = clinic_products_nav_open(route, clinic_products|default([])) %}
<li class="nav-item has-treeview clinic-nav-group"
    data-module-tree
    data-auto-open="{{ _products_open ? '1' : '0' }}"
    data-storage-key="clinic-produtos-sidebar-collapsed">
    <a href="#" class="nav-link clinic-nav-group__trigger{{ _products_open ? ' active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-layer-group nav-icon" aria-hidden="true"></i>
        </span>
        <p>Produtos <i class="fas fa-angle-left right" aria-hidden="true"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children clinic-nav-group__children">
        <li class="nav-item">
            <a href="{{ path('app_pos_operatorio_produtos') }}"
               class="nav-link nav-submenu-link clinic-nav-submenu-link{{ route == 'app_pos_operatorio_produtos' ? ' active' : '' }}"
               {{ route == 'app_pos_operatorio_produtos' ? ' aria-current="page"' : '' }}>
                <p>Todos os produtos</p>
            </a>
        </li>
        {% for product in clinic_products|default([]) %}
        {% if product.enabled|default(true) %}
        {% set _prod_route = product.route|default('') %}
        {% set _prod_prefix = product.route_prefix|default(_prod_route) %}
        {% set _prod_active = route == _prod_route or (_prod_prefix != '' and route starts with _prod_prefix) %}
        <li class="nav-item">
            <a href="{{ path(product.route, product.route_params|default({})) }}"
               class="nav-link nav-submenu-link clinic-nav-submenu-link{{ _prod_active ? ' active' : '' }}"
               {{ _prod_active ? ' aria-current="page"' : '' }}>
                <p>{{ product.short|default(product.label) }}</p>
            </a>
        </li>
        {% endif %}
        {% endfor %}
    </ul>
</li>

{# ── Capacidades por área (grupos expansíveis) ── #}
{% for section in clinic_nav_sections %}
{% set _section_features = clinic_features_for_group(clinic_nav_features, section.key) %}
{% if _section_features|length > 0 %}
{% set _group_open = clinic_group_open(section.key, route, clinic_nav_features) %}
<li class="nav-item has-treeview clinic-nav-group"
    data-module-tree
    data-auto-open="{{ _group_open ? '1' : '0' }}"
    data-storage-key="{{ section.storage_key }}">
    <a href="#" class="nav-link clinic-nav-group__trigger{{ _group_open ? ' active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ section.icon }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ section.label }} <i class="fas fa-angle-left right" aria-hidden="true"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children clinic-nav-group__children">
        {% for feature in _section_features %}
        {% include 'components/clinic_sidebar_submenu_item.html.twig' with {
            feature: feature,
            route: route,
            badges: badges
        } %}
        {% endfor %}
    </ul>
</li>
{% endif %}
{% endfor %}

{% else %}
{# ── Studio / legado ── #}
<li class="nav-item">
    <a href="{{ path('app_maturidade') }}" class="nav-link {{ route starts with 'app_maturidade' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-stethoscope' : 'fa-chart-line' }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ copy.nav_maturidade|default(_clinic ? 'Painel de Recuperação' : 'Painel de entregas') }}</p>
    </a>
</li>

<li class="sidebar-hub-separator" aria-hidden="true"></li>
<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading">
        <span class="sidebar-hub-heading-label">{{ copy.nav_section_clients|default(_clinic ? 'Pacientes' : 'Projetos') }}</span>
    </div>
</li>

<li class="nav-item">
    <a href="{{ path('app_pos_operatorio_pacientes') }}" class="nav-link {{ route starts with 'app_pos_operatorio_paciente' or route == 'app_pos_operatorio_pacientes' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-user-injured' : 'fa-folder-open' }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ copy.nav_pacientes|default(_clinic ? 'Pacientes' : 'Clientes') }}</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_pos_operatorio_sala_critica') }}" class="nav-link {{ route == 'app_pos_operatorio_sala_critica' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-bed-pulse' : 'fa-flag' }} nav-icon" aria-hidden="true"></i>
            {% if badges.sala_critica|default(0) > 0 %}
            <span class="nav-clinic-badge nav-clinic-badge--danger">{{ badges.sala_critica }}</span>
            {% endif %}
        </span>
        <p>{{ copy.nav_sala_critica|default(_clinic ? 'Sala Crítica' : 'Prioridade alta') }}</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_pos_operatorio_alertas') }}" class="nav-link {{ route starts with 'app_pos_operatorio_alerta' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-triangle-exclamation nav-icon" aria-hidden="true"></i>
            {% if badges.alertas|default(0) > 0 %}
            <span class="nav-clinic-badge nav-clinic-badge--warning">{{ badges.alertas }}</span>
            {% endif %}
        </span>
        <p>{{ copy.nav_alertas|default('Alertas') }}</p>
    </a>
</li>

<li class="sidebar-hub-separator" aria-hidden="true"></li>
<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading">
        <span class="sidebar-hub-heading-label">{{ copy.nav_section_deliverables|default(_clinic ? 'Acompanhamento' : 'Produção') }}</span>
    </div>
</li>

<li class="nav-item">
    <a href="{{ path('app_pos_operatorio_protocolos') }}" class="nav-link {{ route starts with 'app_pos_operatorio_protocolo' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-file-medical' : 'fa-book' }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ copy.nav_protocolos|default(_clinic ? 'Protocolos' : 'Playbooks') }}</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_pos_operatorio_questionarios') }}" class="nav-link {{ route == 'app_pos_operatorio_questionarios' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-clipboard-list nav-icon" aria-hidden="true"></i>
            {% if badges.questionarios|default(0) > 0 %}
            <span class="nav-clinic-badge">{{ badges.questionarios }}</span>
            {% endif %}
        </span>
        <p>{{ copy.nav_questionarios|default(_clinic ? 'Questionários' : 'Check-ins') }}</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_portal_patient_login') }}" class="nav-link" target="_blank" rel="noopener">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-person-circle-check' : 'fa-globe' }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ copy.nav_portal|default(_clinic ? 'Portal do Paciente' : 'Portal do cliente') }}</p>
    </a>
</li>
{% endif %}

<li class="sidebar-hub-separator" aria-hidden="true"></li>

{% if nav_show_plataforma|default(false) %}
<li class="nav-item">
    <a href="{{ path('app_admin') }}" class="nav-link {{ route starts with 'app_admin' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-sliders nav-icon" aria-hidden="true"></i>
        </span>
        <p>Administração</p>
    </a>
</li>
{% endif %}
