{# Navegação Organismo — Studio (prod) vs Clínica (uniosaude) #}
{% set route = app.request.attributes.get('_route') %}
{% set badges = clinic_nav_badges|default({}) %}
{% set copy = organismo.copy|default({}) %}
{% set _clinic = org_clinic|default(false) %}

<li class="nav-item">
    <a href="{{ path('app_dashboard') }}" class="nav-link {{ route == 'app_dashboard' or route == 'app_pulso' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas {{ _clinic ? 'fa-house-medical' : 'fa-house' }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>Início</p>
    </a>
</li>

{% if _clinic and clinic_nav_sections is defined and clinic_nav_features is defined %}
{# ── Produtos modulares da plataforma ── #}
<li class="sidebar-hub-separator" aria-hidden="true"></li>
<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading">
        <span class="sidebar-hub-heading-label">Produtos</span>
    </div>
</li>
<li class="nav-item">
    <a href="{{ path('app_pos_operatorio_produtos') }}" class="nav-link {{ route == 'app_pos_operatorio_produtos' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-layer-group nav-icon" aria-hidden="true"></i>
        </span>
        <p>Todos os produtos</p>
    </a>
</li>
{% for product in clinic_products|default([]) %}
{% if product.enabled|default(true) %}
<li class="nav-item">
    <a href="{{ path(product.route, product.route_params|default({})) }}"
       class="nav-link{{ not product.enabled|default(true) ? ' nav-link--muted' : '' }}"
       {% if not product.enabled|default(true) %}title="Produto desativado — ative em Produtos"{% endif %}>
        <span class="nav-icon-slot">
            <i class="fas {{ product.icon }} nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ product.short|default(product.label) }}</p>
    </a>
</li>
{% endif %}
{% endfor %}

{# ── Capacidades por área ── #}
{% for section in clinic_nav_sections %}
<li class="sidebar-hub-separator" aria-hidden="true"></li>
<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading">
        <span class="sidebar-hub-heading-label">{{ section.label }}</span>
    </div>
</li>
{% for feature in clinic_nav_features %}
{% if feature.group == section.key %}
<li class="nav-item">
    <a href="{{ path(feature.route) }}"
       class="nav-link {{ route == feature.route or (feature.route_prefix|default('') != '' and route starts with feature.route_prefix) ? 'active' : '' }}"
       {% if feature.external|default(false) %}target="_blank" rel="noopener"{% endif %}>
        <span class="nav-icon-slot">
            <i class="fas {{ feature.icon }} nav-icon" aria-hidden="true"></i>
            {% set _bk = feature.badge_key|default('') %}
            {% if _bk and badges[_bk]|default(0) > 0 %}
            <span class="nav-clinic-badge{% if _bk == 'sala_critica' %} nav-clinic-badge--danger{% elseif _bk in ['alertas', 'questionarios'] %} nav-clinic-badge--warning{% endif %}" aria-label="{{ badges[_bk] }}">{{ badges[_bk] }}</span>
            {% endif %}
        </span>
        <p>{{ feature.short|default(feature.title) }}</p>
    </a>
</li>
{% endif %}
{% endfor %}
{% endfor %}

{% else %}
{# ── Studio — plataforma base ── #}
{% set _studio = clinic_nav_badges|default({}) %}
{% set _maturidade_tab = app.request.query.get('tab', '') %}
<li class="nav-item">
    <a href="{{ path('app_maturidade') }}" class="nav-link {{ route starts with 'app_maturidade' and _maturidade_tab not in ['entregas', 'prioridades'] ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-chart-line nav-icon" aria-hidden="true"></i>
        </span>
        <p>{{ copy.nav_maturidade|default('Painel de entregas') }}</p>
    </a>
</li>

<li class="sidebar-hub-separator" aria-hidden="true"></li>
<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading">
        <span class="sidebar-hub-heading-label">Clientes &amp; volume</span>
    </div>
</li>

<li class="nav-item">
    <a href="{{ path('app_admin_empresas') }}" class="nav-link {{ route starts with 'app_admin_empresa' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-building nav-icon" aria-hidden="true"></i>
            {% if _studio.clientes|default(0) > 0 %}
            <span class="nav-clinic-badge">{{ _studio.clientes }}</span>
            {% endif %}
        </span>
        <p>Carteira de clientes</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_publicidade_clientes') }}" class="nav-link {{ route == 'app_publicidade_clientes' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-address-book nav-icon" aria-hidden="true"></i>
        </span>
        <p>Contatos &amp; contas</p>
    </a>
</li>

<li class="sidebar-hub-separator" aria-hidden="true"></li>
<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading">
        <span class="sidebar-hub-heading-label">{{ copy.nav_section_deliverables|default('Projetos') }}</span>
    </div>
</li>

<li class="nav-item">
    <a href="{{ path('app_core_projetos') }}" class="nav-link {{ route starts with 'app_core_projetos' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-diagram-project nav-icon" aria-hidden="true"></i>
            {% if _studio.projetos_ativos|default(0) > 0 %}
            <span class="nav-clinic-badge">{{ _studio.projetos_ativos }}</span>
            {% endif %}
        </span>
        <p>Projetos desenvolvidos</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_core_projetos', { view: 'kanban' }) }}" class="nav-link {{ route starts with 'app_core_projetos' and app.request.query.get('view') == 'kanban' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-flag nav-icon" aria-hidden="true"></i>
            {% if _studio.prioridade_alta|default(0) > 0 %}
            <span class="nav-clinic-badge nav-clinic-badge--danger">{{ _studio.prioridade_alta }}</span>
            {% endif %}
        </span>
        <p>Prioridade alta</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_maturidade', { tab: 'entregas' }) }}" class="nav-link {{ route starts with 'app_maturidade' and _maturidade_tab == 'entregas' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-scale-balanced nav-icon" aria-hidden="true"></i>
            {% if _studio.balanceamento|default(0) > 0 %}
            <span class="nav-clinic-badge">{{ _studio.balanceamento }}%</span>
            {% endif %}
        </span>
        <p>Balanceamento</p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_notifications') }}" class="nav-link {{ route == 'app_notifications' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-triangle-exclamation nav-icon" aria-hidden="true"></i>
            {% if _studio.alertas|default(0) > 0 %}
            <span class="nav-clinic-badge nav-clinic-badge--warning">{{ _studio.alertas }}</span>
            {% endif %}
        </span>
        <p>{{ copy.nav_alertas|default('Alertas') }}</p>
    </a>
</li>
{% endif %}

<li class="sidebar-hub-separator" aria-hidden="true"></li>

{% if nav_show_plataforma|default(false) %}
<li class="nav-item">
    <a href="{{ path('app_admin') }}" class="nav-link {{ route starts with 'app_admin' ? 'active' : '' }}">
        <span class="nav-icon-slot">
            <i class="fas fa-sliders nav-icon" aria-hidden="true"></i>
        </span>
        <p>Administração</p>
    </a>
</li>
{% endif %}
