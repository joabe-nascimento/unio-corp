{#
  page_list — layout padrão para listagens
  (título + CTAs no cabeçalho; filtros/busca na section_toolbar)

  Variáveis:
    page_list_title (string)
    page_list_actions_in_top (bool, default true) — CTAs no cabeçalho

  Blocks:
    page_list_toolbar_actions   ← botões primários (+ Novo …)
    page_list_toolbar_subnav
    page_list_kpis
    page_list_section_toolbar   ← filtros / busca (sem CTA principal)
    page_list_content
#}
{% extends 'base.html.twig' %}
{% block page_scroll_mode %}{{ page_list_body_mode|default('scroll') == 'fill' ? 'fill' : 'flow' }}{% endblock %}
{% block page_toolbar_layout %}yes{% endblock %}
{% block page_show_title %}{% endblock %}

{% block content_lead %}
<div class="page-lead-zone">
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: page_list_title|default(''),
        actions_in_top: page_list_actions_in_top|default(true),
        actions_before_title: page_list_actions_before_title|default(false)
    } %}
        {% block toolbar_actions %}{% block page_list_toolbar_actions %}{% endblock %}{% endblock %}
        {% block toolbar_subnav %}{% block page_list_toolbar_subnav %}{% endblock %}{% endblock %}
    {% endembed %}
</div>
{% endblock %}

{% block content %}
{% set _list_body_mode = page_list_body_mode|default('scroll') %}
<div class="page-body-inner page-body-shell{% if _list_body_mode == 'fill' %} page-body-fill{% else %} page-body-scroll{% endif %}">
    {% block page_list_kpis %}{% endblock %}
    {% block page_list_section_toolbar %}{% endblock %}
    {% block page_list_content %}{% endblock %}
</div>
{% endblock %}
