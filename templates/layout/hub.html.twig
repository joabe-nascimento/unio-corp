{% extends 'base.html.twig' %}
{% block page_scroll_mode %}{{ hub_page_body_mode|default('scroll') == 'fill' ? 'fill' : 'flow' }}{% endblock %}
{% block page_toolbar_layout %}yes{% endblock %}
{% block page_show_title %}{% endblock %}
{% block permissions_scope %}{% endblock %}
{% block content_lead %}
{% set perm_scope = block('permissions_scope')|trim %}
{% set _org = organismo.enabled|default(false) %}
{% set _can_manage_perm = not _org and perm_scope != '' and can_manage_permissions(perm_scope) %}
{% set _show_perm_tab = not _org and (_can_manage_perm or (hub_permissions_tab|default(false) and perm_scope != '')) %}
{% set _show_hub_tabs = hub_show_tabs|default(_can_manage_perm or _show_perm_tab) %}
<div class="page-lead-zone{% if _show_hub_tabs %} page-lead-zone--hub-tabs{% endif %}{% if _org %} page-lead-zone--organismo{% endif %}">
    {% if _org %}
    {% set _hub_extra_tabs_html %}
{{ block('hub_extra_tabs') }}
    {% endset %}
    {% set _hub_actions_html %}
{{ block('hub_toolbar_actions') }}
    {% endset %}
    {# Clínica: marca no eyebrow por padrão em todas as telas hub #}
    {% set _hub_eyebrow = hub_page_eyebrow|default(null) %}
    {% if _hub_eyebrow is same as(null) and org_clinic|default(false) %}
        {% set _hub_eyebrow = org_brand_label|default('Unio Saúde') %}
    {% elseif _hub_eyebrow is same as(null) %}
        {% set _hub_eyebrow = '' %}
    {% endif %}
    {% include 'components/org_hub_lead.html.twig' with {
        page_title: hub_page_title|default(''),
        page_subtitle: hub_page_subtitle|default(''),
        page_eyebrow: _hub_eyebrow,
        show_hub_tabs: _show_hub_tabs,
        show_perm_tab: _show_perm_tab,
        back_label: hub_back_label|default(organismo.copy.pulso|default('Pulso')),
        hub_extra_tabs_html: _hub_extra_tabs_html,
        hub_actions_html: _hub_actions_html,
        hub_use_clinic_tabs: hub_use_clinic_tabs|default(false),
        hub_clinic_tabs: hub_clinic_tabs|default([])
    } %}
    {% else %}
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: hub_page_title|default(''),
        page_subtitle: hub_page_subtitle|default(''),
        search_placeholder: hub_search_placeholder|default('Buscar…'),
        search_disabled: hub_search_disabled|default(true),
        search_hidden: hub_search_hidden|default(true),
        actions_in_top: true,
        actions_before_title: hub_actions_before_title|default(false)
    } %}
        {% block toolbar_actions %}{{ block('hub_toolbar_actions') }}{% endblock %}
        {% block toolbar_filters %}{% block hub_toolbar_filters %}{% endblock %}{% endblock %}
        {% block toolbar_subnav %}
            {% if _show_hub_tabs %}
                <div class="list-toolbar-subnav">
                    <div class="hub-overview-tabs" data-hub-tabs role="tablist" aria-label="Visão do núcleo">
                        <button type="button" class="hub-overview-tab hub-overview-tab--active" data-hub-tab="overview" role="tab" aria-selected="true">
                            Visão geral
                        </button>
                        {{ block('hub_extra_tabs') }}
                        {% if _show_perm_tab %}
                        <button type="button" class="hub-overview-tab" data-hub-tab="permissions" role="tab" aria-selected="false">
                            <i class="fas fa-shield-halved mr-1" aria-hidden="true"></i> Permissões
                        </button>
                        {% endif %}
                    </div>
                </div>
                <hr class="hub-toolbar-tabs-divider">
            {% endif %}
        {% endblock %}
    {% endembed %}
    {% endif %}
</div>
{% endblock %}
{% block content %}
{% set perm_scope = block('permissions_scope')|trim %}
{% set _org = organismo.enabled|default(false) %}
{% set _can_manage_perm = not _org and perm_scope != '' and can_manage_permissions(perm_scope) %}
{% set _show_perm_tab = not _org and (_can_manage_perm or (hub_permissions_tab|default(false) and perm_scope != '')) %}
{% set _show_hub_tabs = hub_show_tabs|default(_can_manage_perm or _show_perm_tab) %}
{% set _body_mode = hub_page_body_mode|default('scroll') %}
<div class="page-body-inner page-body-shell{% if _body_mode == 'fill' %} page-body-fill{% else %} page-body-scroll{% endif %}{% if _show_hub_tabs %} page-body-inner--hub-tabs{% endif %}{% if _org %} page-body-inner--organismo{% endif %}{% if perm_scope == 'hub_recrutamento' %} recrutamento-hub{% endif %}">
    {% block hub_kpis %}{% endblock %}
    <div class="hub-tab-panel hub-tab-panel--active" data-hub-panel="overview" role="tabpanel">
        {# Faixa padrão: chips + busca + filtros avançados — use hub_page_filter_bar #}
        {% block hub_section_toolbar %}{% endblock %}
        {% block hub_content %}{% endblock %}
    </div>

    {% block hub_extra_panels %}{% endblock %}

    {% if _show_perm_tab %}
        {% set permission_data = permissions_scope(perm_scope) %}
        <div class="hub-tab-panel" data-hub-panel="permissions" role="tabpanel" hidden>
            {% if permission_data %}
                {% include 'components/permissions_panel.html.twig' with { permission_data: permission_data } %}
            {% else %}
                <div class="unio-card">
                    {% include 'components/hub_permissions_fallback.html.twig' with { reason: 'unavailable' } %}
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>

{% endblock %}

{% block hub_extra_tabs %}{% endblock %}
{% block hub_toolbar_actions %}{% endblock %}
