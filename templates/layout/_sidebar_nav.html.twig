{# ── Layout admin: só administração ── #}
{% if nav_show_admin|default(false) %}
<li class="nav-header">Administração</li>
<li class="nav-item {{ route starts with 'app_admin' ? 'menu-open' : '' }}">
    <a href="{{ path('app_admin') }}" class="nav-link {{ route starts with 'app_admin' ? 'active' : '' }}">
        <i class="fas fa-shield-halved nav-icon"></i>
        <p>Admin <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview">
        <li class="nav-item">
            <a href="{{ path('app_admin') }}" class="nav-link {{ route == 'app_admin' ? 'active' : '' }}">
                <i class="fas fa-table-cells nav-icon"></i><p>Visão geral</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_usuarios') }}" class="nav-link {{ route == 'app_admin_usuarios' ? 'active' : '' }}">
                <i class="fas fa-user-shield nav-icon"></i><p>Usuários</p>
            </a>
        </li>
        {% if nav_show_tenant_empresas|default(false) %}
        <li class="nav-item">
            <a href="{{ path('app_admin_empresas') }}" class="nav-link {{ route == 'app_admin_empresas' ? 'active' : '' }}">
