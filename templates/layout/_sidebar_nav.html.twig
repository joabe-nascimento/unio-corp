{# Menu lateral — itens principais + zona Hub Selecionado (lista / painel) #}
{% set route = app.request.attributes.get('_route') %}
{% set hub_operacoes_open = nav_hub_operacoes_active|default(false) %}
{% set modulo_rh_open = nav_modulo_rh_active|default(false) %}
{% set modulo_pessoas_open = nav_modulo_pessoas_active|default(false) %}
{% set modulo_engenharia_open = nav_modulo_engenharia_active|default(false) %}
{% set modulo_publicidade_open = nav_modulo_publicidade_active|default(false) %}
{% set _active_hub = nav_active_hub|default(null) %}
{% set _in_hub = _active_hub is not null %}

{% include 'layout/_sidebar_nav_primary.html.twig' %}

{% if nav_has_hubs|default(false) %}
<li class="sidebar-hub-separator" aria-hidden="true"></li>

<li class="nav-item sidebar-hub-heading-item">
    <div class="sidebar-hub-heading" data-sidebar-hub-heading>
        <span class="sidebar-hub-heading-label">Hub Selecionado</span>
        <a href="#"
           class="sidebar-hub-back{% if not _in_hub %} is-hidden{% endif %}"
           data-sidebar-hub-back
           aria-label="Voltar para lista de hubs"
           title="Voltar">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
        </a>
    </div>
</li>

{% include 'layout/_sidebar_hub_picker.html.twig' with { hub_picker_hidden: _in_hub } %}

{% if nav_show_hub_operacoes|default(false) %}
<li class="sidebar-hub-panel-root{% if _active_hub != 'operacoes' %} is-hidden{% endif %}" data-sidebar-hub-panel="operacoes">
    <ul class="nav nav-pills flex-column sidebar-hub-panel-list">
        {% include 'layout/_sidebar_hub_operacoes.html.twig' %}
    </ul>
</li>
{% endif %}

{% if nav_show_hub_talentos|default(false) %}
<li class="sidebar-hub-panel-root{% if _active_hub != 'talentos' %} is-hidden{% endif %}" data-sidebar-hub-panel="talentos">
    <ul class="nav nav-pills flex-column sidebar-hub-panel-list">
        {% include 'layout/_sidebar_hub_talentos.html.twig' %}
    </ul>
</li>
{% endif %}

{% if nav_show_hub_maturidade|default(false) %}
<li class="sidebar-hub-panel-root{% if _active_hub != 'maturidade' %} is-hidden{% endif %}" data-sidebar-hub-panel="maturidade">
    <ul class="nav nav-pills flex-column sidebar-hub-panel-list">
        {% include 'layout/_sidebar_hub_maturidade.html.twig' %}
    </ul>
</li>
{% endif %}

{% if nav_show_plataforma|default(false) %}
<li class="sidebar-hub-panel-root{% if _active_hub != 'admin' %} is-hidden{% endif %}" data-sidebar-hub-panel="admin">
    <ul class="nav nav-pills flex-column sidebar-hub-panel-list">
        {% include 'layout/_sidebar_hub_admin.html.twig' %}
    </ul>
</li>
{% endif %}

{% for hub in nav_planned_hubs|default([]) %}
<li class="sidebar-hub-panel-root{% if _active_hub != hub.id %} is-hidden{% endif %}" data-sidebar-hub-panel="{{ hub.id }}">
    <ul class="nav nav-pills flex-column sidebar-hub-panel-list">
        {% include 'layout/_sidebar_hub_planned_panel.html.twig' with { hub: hub } %}
    </ul>
</li>
{% endfor %}
{% endif %}
