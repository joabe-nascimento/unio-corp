            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_admissoes') }}" class="nav-link {{ route == 'app_rh_admissoes' ? 'active' : '' }}">
                <i class="fas fa-user-plus nav-icon"></i>
                <p>Admissões</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_ferias') }}" class="nav-link {{ route == 'app_rh_ferias' ? 'active' : '' }}">
                <i class="fas fa-umbrella-beach nav-icon"></i>
                <p>Férias</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_rh_folha') }}" class="nav-link {{ route == 'app_rh_folha' ? 'active' : '' }}">
                <i class="fas fa-money-bill-wave nav-icon"></i>
                <p>Folha de Pag.</p>
            </a>
        </li>

        <li class="nav-item nav-subheader">
            <span>Gestão de Pessoas</span>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_pessoas') }}" class="nav-link {{ route == 'app_pessoas' ? 'active' : '' }}">
                <i class="fas fa-people-group nav-icon"></i>
                <p>Resumo Pessoas</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_pessoas_equipes') }}" class="nav-link {{ route == 'app_pessoas_equipes' ? 'active' : '' }}">
                <i class="fas fa-user-group nav-icon"></i>
                <p>Equipes</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_pessoas_cargos') }}" class="nav-link {{ route == 'app_pessoas_cargos' ? 'active' : '' }}">
                <i class="fas fa-layer-group nav-icon"></i>
                <p>Cargos</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_pessoas_organograma') }}" class="nav-link {{ route == 'app_pessoas_organograma' ? 'active' : '' }}">
                <i class="fas fa-sitemap nav-icon"></i>
                <p>Organograma</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_pessoas_avaliacao') }}" class="nav-link {{ route == 'app_pessoas_avaliacao' ? 'active' : '' }}">
                <i class="fas fa-star-half-stroke nav-icon"></i>
                <p>Avaliação</p>
            </a>
        </li>
    </ul>
</li>
{% endif %}

