                    <a href="{{ path('app_rh_funcionarios') }}" class="nav-link {{ route == 'app_rh_funcionarios' ? 'active' : '' }}">
                        <i class="fas fa-user-tie nav-icon"></i>
                        <p>Funcionários</p>
