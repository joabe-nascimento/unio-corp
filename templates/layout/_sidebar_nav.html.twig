{# Menu lateral por perfil principal (layout admin vs operacional) #}
{% import 'macros/sidebar_nav.html.twig' as nav %}
{% set route = app.request.attributes.get('_route') %}
{% set perfil = app.user.perfil %}
{% set hub_operacoes_open = nav_hub_operacoes_active|default(false) %}
{% set modulo_rh_open = nav_modulo_rh_active|default(false) %}
{% set modulo_pessoas_open = nav_modulo_pessoas_active|default(false) %}
{% set modulo_engenharia_open = nav_modulo_engenharia_active|default(false) %}
{% set modulo_publicidade_open = nav_modulo_publicidade_active|default(false) %}

<li class="nav-item">
    <a href="{{ path('app_dashboard') }}" class="nav-link {{ route starts with 'app_dashboard' ? 'active' : '' }}">
        <i class="fas fa-house nav-icon"></i>
        <p>Dashboard</p>
    </a>
</li>

{% if nav_show_projetos_metas|default(false) %}
<li class="nav-item">
    <a href="{{ path('app_core_projetos') }}" class="nav-link {{ route starts with 'app_core_projetos' or route == 'app_core_metas_nova' or route == 'app_core_tarefa_mover' ? 'active' : '' }}">
        <i class="fas fa-diagram-project nav-icon"></i>
        <p>Projetos e Metas</p>
    </a>
</li>
{% endif %}

<li class="nav-item">
    <a href="{{ path('app_chat') }}" class="nav-link {{ route starts with 'app_chat' ? 'active' : '' }}">
        <i class="fas fa-comments nav-icon"></i>
        <p>
            Chat Bate Papo
            {% if nav_chat_unread|default(0) > 0 %}
                <span class="nav-unread-badge">{{ nav_chat_unread }}</span>
            {% endif %}
        </p>
    </a>
</li>

<li class="nav-item">
    <a href="{{ path('app_notifications') }}" class="nav-link {{ route starts with 'app_notifications' ? 'active' : '' }}">
        <i class="fas fa-bell nav-icon"></i>
        <p>
            Notificações
            {% if nav_notifications_unread|default(0) > 0 %}
                <span class="nav-notif-badge">{{ nav_notifications_unread }}</span>
            {% endif %}
        </p>
    </a>
</li>

{# ── Layout operacional: hubs conforme o perfil ── #}
{% if nav_show_hub_operacoes|default(false) or nav_show_hub_talentos|default(false) or nav_show_hub_maturidade|default(false) %}
<li class="nav-header">Hubs</li>
{% endif %}

{% if nav_show_hub_operacoes|default(false) %}
<li class="nav-item has-treeview nav-hub {{ hub_operacoes_open ? 'menu-open' : '' }}">
    <a href="{{ path('app_hub_operacoes') }}" class="nav-link {{ route starts with 'app_hub_operacoes' ? 'active' : '' }}">
        <i class="fas fa-briefcase nav-icon"></i>
        <p>Hub Operações <i class="fas fa-angle-left right"></i></p>
