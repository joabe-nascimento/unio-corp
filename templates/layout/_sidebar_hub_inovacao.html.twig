{% import 'macros/sidebar_nav.html.twig' as nav %}

{# ── Núcleo — visão geral ─────────────────────────────────────────────────── #}
<li class="nav-item sidebar-hub-current">
    <a href="{{ path('app_inovacao') }}" class="nav-link{{ route == 'app_inovacao' ? ' active' : '' }}">
        <i class="fas fa-lightbulb nav-icon"></i>
        <p>Núcleo Inovação</p>
    </a>
</li>

{# ── Nova Ideia CTA ─────────────────────────────────────────────────────── #}
{% if product_grant('hub_inovacao', 'backlog') %}
<li class="nav-item nav-item--cta">
    <a href="{{ path('app_inovacao_nova_ideia') }}" class="nav-link nav-link--cta{{ route == 'app_inovacao_nova_ideia' ? ' active' : '' }}">
        <i class="fas fa-plus nav-icon" aria-hidden="true"></i>
        <p>Nova Ideia</p>
    </a>
</li>
{% endif %}

{# ── Fluxo de experimentos ──────────────────────────────────────────────── #}
{% set show_fluxo = product_grant('hub_inovacao', 'pipeline')
    or product_grant('hub_inovacao', 'laboratorio')
    or product_grant('hub_inovacao', 'experimentos') %}
{% if show_fluxo %}
<li class="nav-item has-treeview"
    data-module-tree
    data-auto-open="{{ modulo_inovacao_fluxo_open ? '1' : '0' }}"
    data-storage-key="inovacao-fluxo-sidebar-collapsed">
    <a href="#" class="nav-link{{ modulo_inovacao_fluxo_open ? ' active' : '' }}">
        <i class="fas fa-layer-group nav-icon"></i>
        <p>Fluxo de Experimentos <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children">
        {% if product_grant('hub_inovacao', 'pipeline') %}
        {{ nav.submenu('Pipeline', path('app_inovacao_pipeline'), route == 'app_inovacao_pipeline') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'laboratorio') %}
        {{ nav.submenu('Laboratório', path('app_inovacao_laboratorio'), route == 'app_inovacao_laboratorio') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'experimentos') %}
        {{ nav.submenu('Experimentos', path('app_inovacao_experimentos'), route == 'app_inovacao_experimentos') }}
        {% endif %}
    </ul>
</li>
{% endif %}

{# ── Ideação ────────────────────────────────────────────────────────────── #}
{% if product_grant('hub_inovacao', 'backlog') %}
<li class="nav-item has-treeview"
    data-module-tree
    data-auto-open="{{ modulo_inovacao_ideacao_open ? '1' : '0' }}"
    data-storage-key="inovacao-ideacao-sidebar-collapsed">
    <a href="#" class="nav-link{{ modulo_inovacao_ideacao_open ? ' active' : '' }}">
        <i class="fas fa-inbox nav-icon"></i>
        <p>Ideação <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children">
        {{ nav.submenu('Backlog de Ideias', path('app_inovacao_backlog'), route == 'app_inovacao_backlog' or route == 'app_inovacao_nova_ideia') }}
    </ul>
</li>
{% endif %}

{# ── Inteligência & impacto ───────────────────────────────────────────────── #}
{% set show_intel = product_grant('hub_inovacao', 'analytics')
    or product_grant('hub_inovacao', 'conexoes')
    or product_grant('hub_inovacao', 'impact')
    or product_grant('hub_inovacao', 'tendencias')
    or product_grant('hub_inovacao', 'portfolio')
    or product_grant('hub_inovacao', 'novidades') %}
{% if show_intel %}
<li class="nav-item has-treeview"
    data-module-tree
    data-auto-open="{{ modulo_inovacao_inteligencia_open ? '1' : '0' }}"
    data-storage-key="inovacao-inteligencia-sidebar-collapsed">
    <a href="#" class="nav-link{{ modulo_inovacao_inteligencia_open ? ' active' : '' }}">
        <i class="fas fa-chart-pie nav-icon"></i>
        <p>Inteligência & Impacto <i class="fas fa-angle-left right"></i></p>
    </a>
    <ul class="nav nav-treeview nav-product-children">
        {% if product_grant('hub_inovacao', 'analytics') %}
        {{ nav.submenu('Radar & Analytics', path('app_inovacao_analytics'), route == 'app_inovacao_analytics') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'conexoes') %}
        {{ nav.submenu('Conexões', path('app_inovacao_conexoes'), route == 'app_inovacao_conexoes') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'impact') %}
        {{ nav.submenu('Impacto', path('app_inovacao_impact'), route == 'app_inovacao_impact') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'tendencias') %}
        {{ nav.submenu('Tendências', path('app_inovacao_tendencias'), route == 'app_inovacao_tendencias') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'portfolio') %}
        {{ nav.submenu('Portfólio', path('app_inovacao_portfolio'), route == 'app_inovacao_portfolio') }}
        {% endif %}
        {% if product_grant('hub_inovacao', 'novidades') %}
        {{ nav.submenu('Novidades', path('app_inovacao_novidades'), route == 'app_inovacao_novidades') }}
        {% endif %}
    </ul>
</li>
{% endif %}
