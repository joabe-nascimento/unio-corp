{% extends 'base.html.twig' %}

{% block title %}{% block portal_title %}Portal do Paciente{% endblock %} · Pós-Operatório{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pos-operatorio-portal.css') }}?v=5">
<link rel="manifest" href="{{ asset('pos-operatorio/manifest.webmanifest') }}">
{% endblock %}

{% block body_attrs %} data-portal-layout="1"{% endblock %}
{% block page_show_title %}{% endblock %}
{% block page_toolbar_layout %}yes{% endblock %}

{% block content_lead %}
<div class="page-lead-zone page-lead-zone--portal">
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: portal_page_title|default('Portal do paciente'),
        page_subtitle: portal_page_subtitle|default(empresa ? empresa.nome : ''),
        search_hidden: true,
        page_back_hide: true,
        actions_in_top: true,
        actions_before_title: true
    } %}
        {% block toolbar_actions %}
            {% block portal_toolbar_actions %}
            {% include 'components/page_back_link.html.twig' with {
                href: path('app_pos_operatorio'),
                label: 'Painel clínico',
                small: true,
                inline: true
            } %}
            {% endblock %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}

{% block content %}
<div class="page-body-inner pos-portal-body">
    {% block portal_content %}{% endblock %}

    <footer class="pos-portal-footer">
        <p>Em emergência: <strong>192 (SAMU)</strong> · A Vitória não substitui avaliação médica presencial.</p>
    </footer>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% block portal_javascripts %}{% endblock %}
{% endblock %}
