{% extends 'base.html.twig' %}

{% block title %}{% block portal_title %}Portal do Cliente{% endblock %} · {{ org_brand_label|default('Unio Clínica') }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pos-operatorio-portal.css') }}?v=10">
<link rel="manifest" href="{{ asset('pos-operatorio/manifest.webmanifest') }}">
{% endblock %}

{% block body_attrs %} data-portal-layout="1"{% endblock %}
{% block app_sidebar %}{% endblock %}
{% block app_topbar %}{% endblock %}
{% block page_show_title %}{% endblock %}
{% block page_toolbar_layout %}{% endblock %}

{% block content_lead %}{% endblock %}

{% block content %}
<header class="pos-portal-topbar">
    <div class="pos-portal-topbar__brand">
        <span class="pos-portal-topbar__icon" aria-hidden="true"><i class="fas fa-heart-pulse"></i></span>
        <div class="pos-portal-topbar__text">
            <strong class="pos-portal-topbar__title">{% block portal_topbar_title %}{{ portal_page_title|default('Acompanhamento') }}{% endblock %}</strong>
            <span class="pos-portal-topbar__sub">{{ portal_page_subtitle|default(org_brand_label|default('Unio Clínica')) }}</span>
        </div>
    </div>
    <a href="{{ path('app_portal_patient_logout') }}" class="pos-portal-topbar__logout" title="Sair">
        <i class="fas fa-right-from-bracket" aria-hidden="true"></i>
        <span>Sair</span>
    </a>
</header>

<div class="page-body-inner pos-portal-body">
    {% block portal_content %}{% endblock %}

    <footer class="pos-portal-footer">
        <p>Em emergência: <strong>192 (SAMU)</strong> · A Vitória não substitui avaliação médica presencial.</p>
    </footer>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% block portal_javascripts %}{% endblock %}
{% endblock %}
