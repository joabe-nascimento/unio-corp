{# Lista de núcleos (modo seleção) — agrupada por domínio #}
{% set _pick_hidden = hub_picker_hidden|default(false) ? ' is-hidden' : '' %}

<li class="sidebar-hub-group sidebar-hub-group--core{{ _pick_hidden }}">
    <span class="sidebar-hub-group-label">Operação</span>
    <ul class="sidebar-hub-group-list">
        {% if nav_show_hub_operacoes|default(false) %}
        <li class="nav-item sidebar-hub-pick-item">
            <a href="{{ path('app_hub_operacoes') }}" class="nav-link sidebar-hub-pick-link" data-hub-pick="operacoes">
                <i class="fas fa-building nav-icon"></i>
                <p>Núcleo de Operações</p>
            </a>
        </li>
        {% endif %}
        {% if nav_show_hub_talentos|default(false) %}
        <li class="nav-item sidebar-hub-pick-item">
            <a href="{{ path('app_talentos') }}" class="nav-link sidebar-hub-pick-link" data-hub-pick="talentos">
                <i class="fas fa-gem nav-icon"></i>
                <p>Núcleo de Talentos</p>
            </a>
        </li>
        {% endif %}
        {% if nav_show_hub_maturidade|default(false) %}
        <li class="nav-item sidebar-hub-pick-item">
            <a href="{{ path('app_maturidade') }}" class="nav-link sidebar-hub-pick-link" data-hub-pick="maturidade">
                <i class="fas fa-seedling nav-icon"></i>
                <p>Núcleo de Maturidade</p>
            </a>
        </li>
        {% endif %}
        {% if nav_show_hub_recrutamento|default(false) %}
        <li class="nav-item sidebar-hub-pick-item">
            <a href="{{ path('app_recrutamento') }}" class="nav-link sidebar-hub-pick-link" data-hub-pick="recrutamento">
                <i class="fas fa-user-tie nav-icon"></i>
                <p>Núcleo de Recrutamento</p>
            </a>
        </li>
        {% endif %}
    </ul>
</li>

{% for group in nav_planned_hub_groups|default([]) %}
<li class="sidebar-hub-group{{ _pick_hidden }}">
    <span class="sidebar-hub-group-label">{{ group.label }}</span>
    <ul class="sidebar-hub-group-list">
        {% for hub in group.hubs %}
        <li class="nav-item sidebar-hub-pick-item">
            <a href="{{ path(hub.route) }}" class="nav-link sidebar-hub-pick-link" data-hub-pick="{{ hub.id }}" title="{{ hub.label }}">
                <i class="fas {{ hub.icon }} nav-icon"></i>
                <p>{{ hub.label }}</p>
            </a>
        </li>
        {% endfor %}
    </ul>
</li>
{% endfor %}

{% if nav_show_plataforma|default(false) %}
<li class="sidebar-hub-group sidebar-hub-group--platform{{ _pick_hidden }}">
    <span class="sidebar-hub-group-label">Plataforma</span>
    <ul class="sidebar-hub-group-list">
        <li class="nav-item sidebar-hub-pick-item">
            <a href="{{ path('app_admin') }}" class="nav-link sidebar-hub-pick-link" data-hub-pick="admin">
                <i class="fas fa-shield-halved nav-icon"></i>
                <p>Plataforma</p>
            </a>
        </li>
    </ul>
</li>
{% endif %}
