{% extends 'base.html.twig' %}

{% block title %}Tokens Azure OpenAI{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 860px;">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-sync-alt"></i>
                Sincronização automática — Azure OpenAI
            </h3>
        </div>
        <div class="card-body">
            {% if imported and syncResult %}
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <strong>Sincronizado!</strong> Dados atualizados da Azure.
                    <ul class="mb-0 mt-2">
                        <li><strong>Hoje:</strong> {{ syncResult.today.total_tokens|number_format(0, ',', '.') }} tokens · {{ syncResult.today.requests|number_format(0, ',', '.') }} calls</li>
                        <li><strong>Mês:</strong> {{ syncResult.month.total_tokens|number_format(0, ',', '.') }} tokens · {{ syncResult.month.requests|number_format(0, ',', '.') }} calls</li>
                        <li><strong>90 dias:</strong> {{ syncResult.lifetime.total_tokens|number_format(0, ',', '.') }} tokens · {{ syncResult.lifetime.requests|number_format(0, ',', '.') }} calls</li>
                    </ul>
                </div>
            {% elseif error %}
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Erro:</strong> {{ error }}
                </div>
            {% endif %}

            {% if azureConfigured %}
                <p class="text-muted">
                    Puxa automaticamente <strong>Total Tokens</strong> e <strong>Total Calls</strong> da Azure Monitor API — igual ao portal.
                </p>

                {% if lastSync %}
                    <p class="small text-muted mb-3">
                        Última sync: {{ lastSync.synced_at|default('—') }}
                        · Hoje: {{ lastSync.today.total_tokens|number_format(0, ',', '.') }} tok
                        · Mês: {{ lastSync.month.total_tokens|number_format(0, ',', '.') }} tok
                    </p>
                {% endif %}

                <form method="post">
                    <input type="hidden" name="action" value="sync_azure">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-cloud-download-alt"></i>
                        Sincronizar agora da Azure
                    </button>
                </form>
            {% else %}
                <div class="alert alert-warning">
                    <h5 class="alert-heading">Configuração pendente</h5>
                    <p>Adicione no <code>.env</code> do servidor:</p>
                    <pre class="bg-dark text-light p-3 rounded small mb-0">AZURE_TENANT_ID=seu-tenant-id
AZURE_CLIENT_ID=seu-app-id
AZURE_CLIENT_SECRET=seu-secret
AZURE_OPENAI_RESOURCE_ID=/subscriptions/.../providers/Microsoft.CognitiveServices/accounts/uniojuridico-openai</pre>
                </div>
                <p class="small text-muted mb-0">
                    Crie um <strong>App Registration</strong> no Azure AD com permissão <em>Monitoring Reader</em> no recurso <code>uniojuridico-openai</code>.
                </p>
            {% endif %}
        </div>
    </div>

    <details class="card shadow-sm">
        <summary class="card-header" style="cursor:pointer;">
            <strong>Importação manual</strong> (fallback)
        </summary>
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="action" value="manual">

                <h5 class="text-primary">Hoje (24h)</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Tokens</label>
                        <input type="number" name="today_tokens" class="form-control" min="0" value="0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Requests</label>
                        <input type="number" name="today_requests" class="form-control" min="0" value="0">
                    </div>
                </div>

                <h5 class="text-primary">Mês</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Tokens</label>
                        <input type="number" name="month_tokens" class="form-control" min="0" value="0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Requests</label>
                        <input type="number" name="month_requests" class="form-control" min="0" value="0">
                    </div>
                </div>

                <h5 class="text-primary">Lifetime (90 dias)</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Tokens</label>
                        <input type="number" name="lifetime_tokens" class="form-control" min="0" value="0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Requests</label>
                        <input type="number" name="lifetime_requests" class="form-control" min="0" value="0">
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-primary">Importar manualmente</button>
            </form>
        </div>
    </details>
</div>
{% endblock %}
