<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Huplex{% endblock %} | Huplex</title>

    {# AdminLTE 3 + Bootstrap 4 via CDN #}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('huplex-theme')||'dark')}catch(e){}</script>

    <link rel="stylesheet" href="{{ asset('css/huplex-app.css') }}?v=60">

    {% block stylesheets %}{% endblock %}
</head>
{% import 'macros/empresa.html.twig' as empresa_macro %}
{% import 'macros/helix.html.twig' as helix %}
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    {# ── Top Navbar (sem workspace — só toggle + usuário) ── #}
    <nav class="main-header navbar navbar-expand navbar-dark">
        <a class="nav-link nav-toggle-btn" data-widget="pushmenu" href="#" role="button" aria-label="Alternar menu lateral">
            <span class="nav-toggle-icon" aria-hidden="true">
                <span class="nav-toggle-line"></span>
                <span class="nav-toggle-line"></span>
                <span class="nav-toggle-line"></span>
            </span>
        </a>

        <ul class="navbar-nav ml-auto align-items-center mb-0">
            <li class="nav-item d-flex align-items-center">
                <button type="button" class="helix-trigger" id="helixOpenBtn" aria-expanded="false" aria-controls="helixPanel" title="Helix — Assistente virtual">
                    {{ helix.face('xs') }}
                </button>
            </li>
            <li class="nav-item d-flex align-items-center">
                <button type="button" class="theme-btn" id="themeToggle" title="Alternar tema" onclick="toggleTheme()">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </button>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link user-menu-btn d-flex align-items-center" data-toggle="dropdown" href="#" style="gap:8px;padding:4px 8px!important">
                    <span class="avatar-circle">{{ app.user.initials }}</span>
                    <span class="d-none d-sm-inline" style="color:var(--text-2);font-size:13px;font-weight:500">{{ app.user.nome|split(' ')|first }}</span>
                    <i class="fas fa-chevron-down d-none d-sm-inline" style="font-size:9px;color:var(--text-3)"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right huplex-dropdown">
                    <div class="dd-head">
                        <div style="color:var(--text-1);font-size:13px;font-weight:600">{{ app.user.nome }}</div>
                        <div style="color:var(--text-3);font-size:11px">{{ app.user.email }}</div>
                        <div class="mt-1"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span></div>
                    </div>
                    <a class="dropdown-item" href="{{ path('app_profile') }}">
                        <i class="fas fa-user"></i> Meu Perfil
                    </a>
                    {% if empresas is defined and empresas|length > 0 %}
                    <a class="dropdown-item" href="{{ path('app_workspace_select', {force: 1}) }}">
                        <i class="fas fa-building"></i> Trocar área de trabalho
                    </a>
                    {% endif %}
                    <a class="dropdown-item" href="#" onclick="toggleTheme();return false;">
                        <i class="fas fa-adjust" id="themeMenuIcon"></i>
                        <span id="themeMenuLabel">Tema claro</span>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item dropdown-item-danger" href="{{ path('app_logout') }}">
                        <i class="fas fa-sign-out-alt"></i> Sair
                    </a>
                </div>
            </li>
        </ul>
    </nav>

    {# ── Sidebar ── #}
    <aside class="main-sidebar sidebar-dark-primary elevation-0">
        <div class="sidebar-top">
            <a href="{{ path('app_dashboard') }}" class="brand-link elevation-0" title="Huplex Corp">
                <span class="brand-text font-weight-bold">
                    Hup<span class="accent">lex</span><span class="brand-suffix"> Corp</span>
                </span>
            </a>
        </div>

        <div class="sidebar">
            <nav class="mt-2 pb-3">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false" data-animation-speed="0" data-expand-sidebar="true">
                    {% include 'layout/_sidebar_nav.html.twig' %}
                </ul>
            </nav>
        </div>

        {% if empresa is defined and empresa %}
        <div class="sidebar-bottom">
            <a href="{{ path('app_workspace_select', {force: 1}) }}"
               class="sidebar-empresa sidebar-empresa-link"
               title="Trocar área de trabalho — {{ empresa.nome }}">
                {{ empresa_macro.logo(empresa, 'empresa-logo se-logo') }}
                <div class="se-info">
                    <div class="se-name">{{ empresa.nome }}</div>
                    {% if empresa.setor %}<div class="se-setor">{{ empresa.setor }}</div>{% endif %}
                </div>
                {% if empresas is defined and empresas|length > 1 %}
                <i class="fas fa-chevron-right se-chevron"></i>
                {% endif %}
            </a>
        </div>
        {% endif %}
    </aside>

    {# ── Content ── #}
    <div class="content-wrapper">
        {# Bloco só para flag — nunca renderizar aqui (evita exibir "1" na página) #}
        {% if false %}{% block page_toolbar_layout %}{% endblock %}{% endif %}
        {% set show_page_header = block('page_toolbar_layout')|trim is empty and (block('page_show_title')|trim or block('breadcrumb')|trim) %}
        {% if show_page_header %}
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2 align-items-center">
                    <div class="col-12 col-sm-6">
                        {% if false %}{% block page_show_title %}{% endblock %}{% endif %}
                        {% if block('page_show_title')|trim %}
                        <h1 class="m-0">{% block page_title '' %}</h1>
                        {% endif %}
                    </div>
                    <div class="col-12 col-sm-6 text-sm-right">
                        <ol class="breadcrumb breadcrumb--page mb-0 d-inline-block">
                            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Início</a></li>
                            {% block breadcrumb %}{% endblock %}
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <section class="content{% if block('page_toolbar_layout')|trim %} content--with-toolbar{% elseif not show_page_header %} content--no-header{% endif %}">
            {% block content_lead %}{% endblock %}
            <div class="container-fluid container-fluid--page-body">
                {% for flash_type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ flash_type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block content %}{% endblock %}
            </div>
        </section>
    </div>

    <footer class="main-footer text-center">
        <strong>Huplex</strong> &copy; {{ "now"|date("Y") }} — Plataforma de Gestão de Pessoas
    </footer>
</div>

{% include 'components/helix_assistant.html.twig' %}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js" defer></script>
<script>
window.addEventListener('load', function () {
    if (typeof jQuery === 'undefined') return;
    var $body = jQuery('body');
    var $pushMenu = jQuery('[data-widget="pushmenu"]');
    var MOBILE_BP = 992;

    function isMobile() {
        return window.innerWidth < MOBILE_BP;
    }

    function applyMobileSidebar() {
        if (isMobile()) {
            $body.addClass('sidebar-collapse');
            $body.removeClass('sidebar-open');
        }
    }

    applyMobileSidebar();

    var resizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(applyMobileSidebar, 150);
    });

    jQuery(document).on('click', function (e) {
        if (!isMobile() || !$body.hasClass('sidebar-open')) return;
        if (jQuery(e.target).closest('.main-sidebar, [data-widget="pushmenu"]').length) return;
        if ($pushMenu.length && typeof $pushMenu.PushMenu === 'function') {
            $pushMenu.PushMenu('collapse');
        } else {
            $body.removeClass('sidebar-open');
        }
    });

    jQuery('[data-widget="treeview"]').on('expanded.lte.treeview', function () {
        if ($body.hasClass('sidebar-mini') && $body.hasClass('sidebar-collapse') && !isMobile()) {
            $pushMenu.PushMenu('expand');
        }
    });
});
</script>
<script>
(function () {
    'use strict';
    document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-search-expand]').forEach(function (wrap) {
            var toggle = wrap.querySelector('.list-search-toggle');
            var input = wrap.querySelector('.list-search-input');
            var closeBtn = wrap.querySelector('.list-search-close');
            if (!toggle || !input) return;

            if (toggle.contains(e.target)) {
                wrap.classList.add('is-expanded');
                toggle.setAttribute('aria-expanded', 'true');
                setTimeout(function () { input.focus(); }, 50);
                return;
            }
            if (closeBtn && closeBtn.contains(e.target)) {
                wrap.classList.remove('is-expanded');
                toggle.setAttribute('aria-expanded', 'false');
                input.value = '';
                return;
            }
            if (wrap.classList.contains('is-expanded') && !wrap.contains(e.target) && !input.value.trim()) {
                wrap.classList.remove('is-expanded');
                toggle.setAttribute('aria-expanded', 'false');
            }
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('[data-search-expand].is-expanded').forEach(function (wrap) {
            var toggle = wrap.querySelector('.list-search-toggle');
            var input = wrap.querySelector('.list-search-input');
            wrap.classList.remove('is-expanded');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            if (input) input.value = '';
        });
    });
})();
</script>
<script>
(function() {
    var saved = localStorage.getItem('huplex-theme') || 'dark';
    applyTheme(saved);

    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var icon = document.getElementById('themeIcon');
        var mIcon = document.getElementById('themeMenuIcon');
        var mLabel = document.getElementById('themeMenuLabel');
        if (t === 'dark') {
            if (icon) icon.className = 'fas fa-sun';
            if (mIcon) mIcon.className = 'fas fa-sun mr-2';
            if (mLabel) mLabel.textContent = 'Tema claro';
        } else {
            if (icon) icon.className = 'fas fa-moon';
            if (mIcon) mIcon.className = 'fas fa-moon mr-2';
            if (mLabel) mLabel.textContent = 'Tema escuro';
        }
    }

    window.toggleTheme = function() {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        localStorage.setItem('huplex-theme', next);
        applyTheme(next);
    };
})();
</script>
{% block javascripts %}{% endblock %}

{# ── View Toggle — JS genérico, carregado uma vez no base ── #}
<script>
(function () {
    'use strict';

    function applyViewMode(toggle, container, mode) {
        var key = toggle.dataset.vtKey;
        // Atualiza botões
        toggle.querySelectorAll('[data-vt-mode]').forEach(function (btn) {
            btn.classList.toggle('view-btn--active', btn.dataset.vtMode === mode);
        });
        // Atualiza container via atributo data-view-mode
        container.setAttribute('data-view-mode', mode);
        // Persiste preferência
        try { localStorage.setItem(key, mode); } catch (e) {}
    }

    function initToggle(toggle) {
        var containerId = toggle.dataset.vtContainer;
        var container   = document.getElementById(containerId);
        if (!container) return;

        var key         = toggle.dataset.vtKey;
        var defaultMode = toggle.dataset.vtDefault || 'list';
        var saved;
        try { saved = localStorage.getItem(key); } catch (e) {}

        applyViewMode(toggle, container, saved || defaultMode);

        toggle.querySelectorAll('[data-vt-mode]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                applyViewMode(toggle, container, btn.dataset.vtMode);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.view-toggle-group').forEach(initToggle);
    });
})();
</script>
<script>
(function () {
    'use strict';

    var STORAGE_KEY = 'huplex-helix-sessions';
    var panel = document.getElementById('helixPanel');
    var openBtn = document.getElementById('helixOpenBtn');
    var form = document.getElementById('helixForm');
    var input = document.getElementById('helixInput');
    var sendBtn = document.getElementById('helixSendBtn');
    var messagesEl = document.getElementById('helixMessages');
    var historyList = document.getElementById('helixHistoryList');
    var historyEmpty = document.getElementById('helixHistoryEmpty');
    var historyCount = document.getElementById('helixHistoryCount');
    var historyToggle = document.getElementById('helixHistoryToggle');
    var historyToggleCount = document.getElementById('helixHistoryToggleCount');
    var suggestions = document.getElementById('helixSuggestions');
    var mobileMq = window.matchMedia('(max-width: 575.98px)');

    if (!panel || !openBtn) return;

    var FACE_SM = '<span class="helix-face helix-face--sm" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle class="helix-face-ring" cx="20" cy="20" r="18"/><circle class="helix-face-eye" cx="14.5" cy="17" r="2.25"/><circle class="helix-face-eye" cx="25.5" cy="17" r="2.25"/><path class="helix-face-smile" d="M13.5 24.2c2.6 2.4 10.4 2.4 13 0"/></svg></span>';

    var currentSessionId = null;

    function isMobileHelix() {
        return mobileMq.matches;
    }

    function setHistoryOpen(open) {
        panel.classList.toggle('is-history-open', open);
        if (historyToggle) historyToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function closeHistoryIfMobile() {
        if (isMobileHelix()) setHistoryOpen(false);
    }

    function loadSessions() {
        try {
            var raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (e) {
            return [];
        }
    }

    function saveSessions(sessions) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(sessions));
        } catch (e) {}
    }

    function uid() {
        return 'h' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
    }

    function formatDate(iso) {
        try {
            var d = new Date(iso);
            return d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        } catch (e) {
            return '';
        }
    }

    function getSession(id) {
        return loadSessions().find(function (s) { return s.id === id; }) || null;
    }

    function upsertSession(session) {
        var sessions = loadSessions().filter(function (s) { return s.id !== session.id; });
        sessions.unshift(session);
        if (sessions.length > 50) sessions = sessions.slice(0, 50);
        saveSessions(sessions);
    }

    function ensureSession() {
        if (currentSessionId && getSession(currentSessionId)) return currentSessionId;
        var session = {
            id: uid(),
            title: 'Nova conversa',
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            messages: []
        };
        upsertSession(session);
        currentSessionId = session.id;
        return currentSessionId;
    }

    function scrollMessages() {
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function renderWelcomeOnly() {
        if (!messagesEl) return;
        var first = panel.dataset.userFirst || '';
        var greeting = first ? 'Olá, ' + escapeHtml(first) + '.' : 'Olá.';
        messagesEl.innerHTML =
            '<div class="helix-msg helix-msg--assistant">' + FACE_SM +
            '<div class="helix-msg-bubble">' +
            '<p>' + greeting + ' Sou o Helix — seu assistente na Huplex.</p>' +
            '<p class="mb-0 helix-msg-muted">A IA chega em breve. Suas mensagens já ficam salvas no histórico.</p>' +
            '</div></div>';
        if (suggestions) suggestions.style.display = '';
    }

    function renderMessages(session) {
        if (!messagesEl || !session) return;
        var html = '';
        session.messages.forEach(function (m) {
            html += messageHtml(m.role, m.text);
        });
        if (!html) {
            renderWelcomeOnly();
            return;
        }
        messagesEl.innerHTML = html;
        if (suggestions) suggestions.style.display = session.messages.length ? 'none' : '';
        scrollMessages();
    }

    function messageHtml(role, text) {
        var isUser = role === 'user';
        var esc = escapeHtml(text);
        return '<div class="helix-msg helix-msg--' + (isUser ? 'user' : 'assistant') + '">' +
            (isUser ? '' : FACE_SM) +
            '<div class="helix-msg-bubble"><p class="mb-0">' + esc.replace(/\n/g, '<br>') + '</p></div>' +
            '</div>';
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function assistantReply() {
        return 'Obrigado pela mensagem! A inteligência artificial do Helix está em desenvolvimento — em breve responderei de forma automática. Sua conversa foi salva no histórico.';
    }

    function sendMessage(text) {
        text = (text || '').trim();
        if (!text) return;

        var sid = ensureSession();
        var session = getSession(sid);
        if (!session) return;

        session.messages.push({ role: 'user', text: text, at: new Date().toISOString() });
        if (session.title === 'Nova conversa') {
            session.title = text.length > 48 ? text.slice(0, 48) + '…' : text;
        }
        session.messages.push({ role: 'assistant', text: assistantReply(), at: new Date().toISOString() });
        session.updatedAt = new Date().toISOString();
        upsertSession(session);
        renderMessages(session);
        renderHistory();
        if (input) {
            input.value = '';
            input.style.height = '';
            updateSendState();
        }
    }

    function renderHistory() {
        var sessions = loadSessions();
        var count = String(sessions.length);
        if (historyCount) historyCount.textContent = count;
        if (historyToggleCount) {
            historyToggleCount.textContent = count;
            historyToggleCount.setAttribute('data-count', count);
        }
        if (!historyList || !historyEmpty) return;

        historyList.innerHTML = '';
        if (!sessions.length) {
            historyEmpty.style.display = '';
            return;
        }
        historyEmpty.style.display = 'none';

        sessions.forEach(function (s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'helix-history-item' + (s.id === currentSessionId ? ' helix-history-item--active' : '');
            btn.dataset.sessionId = s.id;
            btn.innerHTML =
                '<span class="helix-history-item-title">' + escapeHtml(s.title || 'Conversa') + '</span>' +
                '<span class="helix-history-item-date">' + escapeHtml(formatDate(s.updatedAt)) + '</span>';
            historyList.appendChild(btn);
        });
    }

    function openPanel() {
        setHistoryOpen(false);
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
        openBtn.setAttribute('aria-expanded', 'true');
        openBtn.classList.add('is-active');
        document.body.classList.add('helix-open');
        setTimeout(function () { if (input) input.focus(); }, 200);
        renderHistory();
    }

    function closePanel() {
        setHistoryOpen(false);
        panel.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
        openBtn.setAttribute('aria-expanded', 'false');
        openBtn.classList.remove('is-active');
        document.body.classList.remove('helix-open');
    }

    function newChat() {
        currentSessionId = null;
        renderWelcomeOnly();
        renderHistory();
        closeHistoryIfMobile();
        if (input) {
            input.value = '';
            updateSendState();
            input.focus();
        }
    }

    function loadSession(id) {
        var session = getSession(id);
        if (!session) return;
        currentSessionId = id;
        renderMessages(session);
        renderHistory();
        closeHistoryIfMobile();
    }

    function updateSendState() {
        if (!sendBtn || !input) return;
        sendBtn.disabled = !input.value.trim();
    }

    openBtn.addEventListener('click', function () {
        if (panel.classList.contains('is-open')) closePanel();
        else openPanel();
    });

    panel.querySelectorAll('[data-helix-close]').forEach(function (el) {
        el.addEventListener('click', closePanel);
    });

    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            sendMessage(input ? input.value : '');
        });
    }

    if (input) {
        input.addEventListener('input', function () {
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 100) + 'px';
            updateSendState();
        });
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                form.dispatchEvent(new Event('submit', { cancelable: true }));
            }
        });
    }

    document.getElementById('helixNewChat')?.addEventListener('click', newChat);

    historyToggle?.addEventListener('click', function () {
        setHistoryOpen(!panel.classList.contains('is-history-open'));
    });

    document.getElementById('helixClearHistory')?.addEventListener('click', function () {
        if (!confirm('Limpar todo o histórico do Helix?')) return;
        saveSessions([]);
        currentSessionId = null;
        newChat();
    });

    if (historyList) {
        historyList.addEventListener('click', function (e) {
            var item = e.target.closest('.helix-history-item');
            if (!item) return;
            loadSession(item.dataset.sessionId);
        });
    }

    panel.querySelectorAll('[data-helix-prompt]').forEach(function (chip) {
        chip.addEventListener('click', function () {
            if (input) input.value = chip.dataset.helixPrompt || '';
            updateSendState();
            input.focus();
        });
    });

    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' || !panel.classList.contains('is-open')) return;
        if (panel.classList.contains('is-history-open')) setHistoryOpen(false);
        else closePanel();
    });

    renderHistory();
    updateSendState();
})();
</script>
</body>
</html>
