<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Huplex{% endblock %} | Huplex</title>

    {# AdminLTE 3 + Bootstrap 4 via CDN #}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <style>
        :root {
            --accent:  #4F7FFF;
            --bg:      #080A12;
            --surface: #0D0F1A;
            --border:  rgba(255,255,255,0.06);
            --text-1:  #E2E4EA;
            --text-2:  rgba(226,228,234,0.45);
            --text-3:  rgba(226,228,234,0.22);
        }

        body, .wrapper { font-family: 'Inter', sans-serif !important; }

        /* ── Navbar ── */
        .main-header.navbar {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border);
            box-shadow: none !important;
        }

        /* ── Sidebar ── */
        .main-sidebar {
            background: var(--bg) !important;
            border-right: none !important;
            box-shadow: none !important;
        }

        .brand-link {
            background: var(--bg) !important;
            border-bottom: 1px solid var(--border) !important;
            padding: 14px 16px !important;
        }

        .brand-text {
            color: var(--text-1) !important;
            font-weight: 700 !important;
            font-size: 16px !important;
            letter-spacing: -0.02em;
        }

        .brand-text span.accent { color: var(--accent); }

        /* Nav links */
        .nav-sidebar .nav-item .nav-link {
            color: var(--text-2) !important;
            font-size: 13px;
            font-weight: 500;
            border-radius: 6px;
            margin: 1px 8px;
            padding: 7px 12px !important;
            transition: color 0.15s, background 0.15s;
            border-left: none !important;
        }

        .nav-sidebar .nav-item .nav-link:hover {
            color: var(--text-1) !important;
            background: rgba(255,255,255,0.04) !important;
        }

        .nav-sidebar .nav-item .nav-link.active {
            color: var(--text-1) !important;
            background: rgba(79,127,255,0.1) !important;
            border-left: none !important;
        }

        .nav-sidebar .nav-item .nav-link i.nav-icon {
            color: var(--text-3) !important;
            width: 18px;
            transition: color 0.15s;
        }

        .nav-sidebar .nav-item .nav-link:hover i.nav-icon,
        .nav-sidebar .nav-item .nav-link.active i.nav-icon {
            color: var(--accent) !important;
        }

        /* Submenu dot icons */
        .nav-treeview .nav-link i.nav-icon {
            color: var(--text-3) !important;
        }
        .nav-treeview .nav-link.active i.nav-icon,
        .nav-treeview .nav-link:hover i.nav-icon {
            color: var(--accent) !important;
        }

        /* Treeview arrow */
        .nav-sidebar .nav-item .nav-link .right {
            color: var(--text-3) !important;
            font-size: 11px;
        }

        .nav-header {
            color: var(--text-3) !important;
            font-size: 10px !important;
            font-weight: 600 !important;
            letter-spacing: 0.08em !important;
            text-transform: uppercase !important;
            padding: 20px 20px 6px !important;
        }

        /* ── Content ── */
        .content-wrapper { background: var(--bg) !important; }

        .content-header h1 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-1);
            letter-spacing: -0.02em;
        }

        .breadcrumb { background: transparent !important; }

        .breadcrumb-item a,
        .breadcrumb-item.active {
            color: var(--text-3) !important;
            font-size: 12px;
        }

        /* ── Cards ── */
        .huplex-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 22px;
            transition: border-color 0.2s;
        }

        .huplex-card:hover { border-color: rgba(79,127,255,0.18); }

        .huplex-card .card-title {
            color: var(--text-1);
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .huplex-card .card-value {
            color: var(--text-1);
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1;
        }

        .huplex-card .card-label {
            color: var(--text-3);
            font-size: 12px;
        }

        .huplex-card .card-icon {
            width: 42px;
            height: 42px;
            border-radius: 9px;
            background: rgba(79,127,255,0.08);
            border: 1px solid rgba(79,127,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 17px;
        }

        .section-title {
            color: var(--text-1);
            font-size: 16px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 3px;
        }

        .section-subtitle {
            color: var(--text-3);
            font-size: 13px;
        }

        /* ── Badges de perfil — paleta discreta, monocromática ── */
        .badge-perfil {
            display: inline-block;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 2px 9px;
            border-radius: 100px;
            background: rgba(79,127,255,0.1);
            color: rgba(79,127,255,0.85);
            border: 1px solid rgba(79,127,255,0.2);
        }

        .badge-perfil.tenant            { background: rgba(120,100,220,0.1); color: rgba(160,140,255,0.85); border-color: rgba(120,100,220,0.2); }
        .badge-perfil.admin             { background: rgba(200,70,70,0.08);  color: rgba(220,110,110,0.85); border-color: rgba(200,70,70,0.18); }
        .badge-perfil.gestor            { background: rgba(180,150,40,0.08); color: rgba(210,185,90,0.85);  border-color: rgba(180,150,40,0.18); }
        .badge-perfil.gestor-equipe     { background: rgba(190,120,50,0.08); color: rgba(215,160,90,0.85);  border-color: rgba(190,120,50,0.18); }
        .badge-perfil.supervisor        { background: rgba(50,160,100,0.08); color: rgba(90,190,140,0.85);  border-color: rgba(50,160,100,0.18); }
        .badge-perfil.supervisor-equipe { background: rgba(40,150,200,0.08); color: rgba(80,185,225,0.85);  border-color: rgba(40,150,200,0.18); }
        .badge-perfil.membro            { background: rgba(120,130,150,0.08); color: rgba(160,170,190,0.75); border-color: rgba(120,130,150,0.15); }

        /* ── Table ── */
        .table-huplex { color: var(--text-2) !important; }

        .table-huplex thead th {
            background: rgba(255,255,255,0.02) !important;
            color: var(--text-3) !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            letter-spacing: 0.07em !important;
            text-transform: uppercase !important;
            border-color: var(--border) !important;
            padding: 11px 16px !important;
        }

        .table-huplex td {
            border-color: var(--border) !important;
            padding: 11px 16px !important;
            vertical-align: middle !important;
            font-size: 13px !important;
        }

        .table-huplex tbody tr:hover td {
            background: rgba(255,255,255,0.015) !important;
        }

        /* ── Buttons ── */
        .btn-huplex {
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 7px 17px;
            font-size: 13px;
            font-weight: 600;
            transition: opacity 0.15s;
        }

        .btn-huplex:hover { opacity: 0.85; color: #fff; }

        .btn-huplex-ghost {
            background: transparent;
            color: var(--text-2);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 6px 15px;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.15s;
        }

        .btn-huplex-ghost:hover { color: var(--text-1); border-color: rgba(255,255,255,0.15); }

        /* ── Avatar ── */
        .avatar-circle {
            width: 34px; height: 34px;
            border-radius: 50%;
            background: rgba(79,127,255,0.1);
            border: 1px solid rgba(79,127,255,0.22);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 12px;
            font-weight: 700;
        }

        /* ── Empty state ── */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 56px 24px;
            text-align: center;
        }

        .empty-state .empty-icon {
            width: 56px; height: 56px;
            border-radius: 12px;
            background: rgba(79,127,255,0.07);
            border: 1px dashed rgba(79,127,255,0.2);
            display: flex; align-items: center; justify-content: center;
            color: var(--accent);
            font-size: 20px;
            margin-bottom: 14px;
            opacity: 0.8;
        }

        .empty-state h6 { color: var(--text-1); font-weight: 600; margin-bottom: 5px; }
        .empty-state p  { color: var(--text-3); font-size: 13px; }

        /* ── Footer ── */
        .main-footer {
            background: var(--bg) !important;
            border-top: 1px solid var(--border) !important;
            color: var(--text-3) !important;
            font-size: 12px;
        }

        [data-widget="pushmenu"] { color: var(--text-2) !important; }
        .navbar-nav .nav-link    { color: var(--text-2) !important; }

        /* ── Navbar compacta (sem workspace) ── */
        .main-header.navbar {
            height: 54px;
            padding: 0 16px !important;
            display: flex !important;
            align-items: center !important;
        }
        .main-header .navbar-nav { flex-direction: row; align-items: center; }
        .nav-toggle-btn {
            width: 34px; height: 34px;
            border-radius: 7px;
            display: inline-flex !important;
            align-items: center; justify-content: center;
            color: var(--text-2) !important;
            transition: background 0.15s;
        }
        .nav-toggle-btn:hover { background: rgba(255,255,255,0.05) !important; }

        /* ── Topo da sidebar: logo + empresa ativa ── */
        .sidebar-top {
            border-bottom: 1px solid var(--border);
            background: var(--bg);
            flex-shrink: 0;
        }
        .sidebar-top .brand-link {
            border-bottom: none !important;
            padding: 12px 14px !important;
            height: auto !important;
            display: flex !important;
            align-items: center !important;
        }
        .sidebar-empresa {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px 12px;
            min-height: 40px;
        }
        .sidebar-empresa .se-logo {
            width: 32px; height: 32px;
            border-radius: 8px;
            background: rgba(79,127,255,0.1);
            border: 1px solid rgba(79,127,255,0.18);
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 700; color: var(--accent);
            flex-shrink: 0;
        }
        .sidebar-empresa .se-info { min-width: 0; flex: 1; overflow: hidden; }
        .sidebar-empresa .se-name {
            font-size: 12px; font-weight: 600;
            color: var(--text-1);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            line-height: 1.3;
        }
        .sidebar-empresa .se-setor {
            font-size: 10px; color: var(--text-3);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* ── Sidebar mini (colapsada): logo pequeno + ícones centralizados ── */
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .sidebar-top .brand-link {
            justify-content: center !important;
            padding: 10px 4px !important;
        }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .brand-text {
            display: inline !important;
            font-size: 10.5px !important;
            letter-spacing: -0.04em;
            line-height: 1.15;
            text-align: center;
        }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .brand-link::after { content: none !important; }

        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .sidebar-empresa .se-info { display: none; }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .sidebar-empresa {
            justify-content: center;
            padding: 0 0 8px;
        }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .sidebar-empresa .se-logo {
            width: 28px; height: 28px;
            font-size: 10px;
        }

        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-header { display: none !important; }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-treeview { display: none !important; }

        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-sidebar > .nav-item {
            display: flex;
            justify-content: center;
            width: 100%;
        }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-sidebar > .nav-item > .nav-link {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            width: 36px !important;
            height: 36px !important;
            margin: 2px auto !important;
            padding: 0 !important;
            border-radius: 8px !important;
        }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-sidebar > .nav-item > .nav-link p,
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-sidebar > .nav-item > .nav-link .right {
            display: none !important;
        }
        .sidebar-mini.sidebar-collapse:not(.sidebar-open) .nav-sidebar > .nav-item > .nav-link .nav-icon {
            margin: 0 !important;
            width: auto !important;
            min-width: 0 !important;
            font-size: 14px !important;
            text-align: center !important;
            float: none !important;
        }

        /* Sobrescreve AdminLTE sidebar-mini */
        .sidebar-mini.sidebar-collapse .nav-sidebar .nav-link {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
        .sidebar-mini.sidebar-collapse .nav-sidebar > .nav-item.menu-open > .nav-link {
            margin-left: auto !important;
            margin-right: auto !important;
        }

        /* Hover expande — volta ao layout normal */
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .sidebar-empresa .se-info,
        .sidebar-mini.sidebar-open .sidebar-empresa .se-info { display: block !important; }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .sidebar-empresa,
        .sidebar-mini.sidebar-open .sidebar-empresa {
            justify-content: flex-start !important;
            padding: 0 14px 12px !important;
        }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .brand-text,
        .sidebar-mini.sidebar-open .brand-text { font-size: 16px !important; }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .sidebar-top .brand-link,
        .sidebar-mini.sidebar-open .sidebar-top .brand-link {
            justify-content: flex-start !important;
            padding: 12px 14px !important;
        }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .nav-header,
        .sidebar-mini.sidebar-open .nav-header { display: block !important; }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .nav-sidebar > .nav-item > .nav-link,
        .sidebar-mini.sidebar-open .nav-sidebar > .nav-item > .nav-link {
            width: auto !important;
            height: auto !important;
            margin: 1px 8px !important;
            padding: 7px 12px !important;
            justify-content: flex-start !important;
        }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover .nav-sidebar > .nav-item > .nav-link p,
        .sidebar-mini.sidebar-open .nav-sidebar > .nav-item > .nav-link p { display: block !important; }

        .main-sidebar { display: flex !important; flex-direction: column !important; }
        .main-sidebar .sidebar { flex: 1; overflow-y: auto; overflow-x: hidden; padding-bottom: 56px; }

        /* Layout alinhado — sidebar e header na mesma largura */
        body:not(.sidebar-collapse) .main-sidebar { width: 224px !important; }
        body:not(.sidebar-collapse) .content-wrapper,
        body:not(.sidebar-collapse) .main-footer,
        body:not(.sidebar-collapse) .main-header { margin-left: 224px !important; }
        .sidebar-mini.sidebar-collapse .main-sidebar { width: 4.6rem !important; }
        .sidebar-mini.sidebar-collapse .content-wrapper,
        .sidebar-mini.sidebar-collapse .main-footer,
        .sidebar-mini.sidebar-collapse .main-header { margin-left: 4.6rem !important; }
        .sidebar-mini.sidebar-collapse .main-sidebar:hover,
        .sidebar-mini.sidebar-open .main-sidebar {
            width: 224px !important;
            z-index: 1040;
            box-shadow: 4px 0 24px rgba(0,0,0,0.35);
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    {# ── Top Navbar (sem workspace — só toggle + usuário) ── #}
    <nav class="main-header navbar navbar-expand navbar-dark">
        <a class="nav-link nav-toggle-btn" data-widget="pushmenu" href="#" role="button">
            <i class="fas fa-bars"></i>
        </a>

        <ul class="navbar-nav ml-auto align-items-center mb-0">
            <li class="nav-item dropdown">
                <a class="nav-link d-flex align-items-center" data-toggle="dropdown" href="#" style="gap:8px;padding:4px 8px!important">
                    <span class="avatar-circle">{{ app.user.initials }}</span>
                    <span style="color:var(--text-2);font-size:13px;font-weight:500">{{ app.user.nome|split(' ')|first }}</span>
                    <i class="fas fa-chevron-down" style="font-size:9px;color:var(--text-3)"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right"
                     style="background:var(--surface);border:1px solid var(--border);border-radius:10px;min-width:200px;padding:6px">
                    <div class="px-3 py-2" style="border-bottom:1px solid var(--border);margin-bottom:4px">
                        <div style="color:var(--text-1);font-size:13px;font-weight:600">{{ app.user.nome }}</div>
                        <div style="color:var(--text-3);font-size:11px">{{ app.user.email }}</div>
                        <div class="mt-1"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span></div>
                    </div>
                    <a class="dropdown-item py-2" href="#" style="color:var(--text-2);font-size:13px;border-radius:6px">
                        <i class="fas fa-user mr-2" style="width:16px;color:var(--text-3)"></i> Meu Perfil
                    </a>
                    {% if empresas is defined and empresas|length > 0 %}
                    <a class="dropdown-item py-2" href="{{ path('app_workspace_select', {force: 1}) }}" style="color:var(--text-2);font-size:13px;border-radius:6px">
                        <i class="fas fa-building mr-2" style="width:16px;color:var(--text-3)"></i> Trocar área de trabalho
                    </a>
                    {% endif %}
                    <div class="dropdown-divider" style="border-color:var(--border);margin:4px 0"></div>
                    <a class="dropdown-item py-2" href="{{ path('app_logout') }}" style="color:rgba(220,80,80,0.8);font-size:13px;border-radius:6px">
                        <i class="fas fa-sign-out-alt mr-2" style="width:16px"></i> Sair
                    </a>
                </div>
            </li>
        </ul>
    </nav>

    {# ── Sidebar ── #}
    <aside class="main-sidebar sidebar-dark-primary elevation-0">
        <div class="sidebar-top">
            <a href="{{ path('app_dashboard') }}" class="brand-link elevation-0">
                <span class="brand-text font-weight-bold" style="font-size:16px">
                    Hup<span class="accent">lex</span>
                </span>
            </a>
            {% if empresa is defined and empresa %}
            <div class="sidebar-empresa" title="{{ empresa.nome }}">
                <span class="se-logo">{{ empresa.nome|slice(0,2)|upper }}</span>
                <div class="se-info">
                    <div class="se-name">{{ empresa.nome }}</div>
                    {% if empresa.setor %}<div class="se-setor">{{ empresa.setor }}</div>{% endif %}
                </div>
            </div>
            {% endif %}
        </div>

        <div class="sidebar">
            <nav class="mt-2 pb-3">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">

                    <li class="nav-item">
                        <a href="{{ path('app_dashboard') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active' : '' }}">
                            <i class="fas fa-house nav-icon"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    {% if is_granted('ROLE_SUPERVISOR_EQUIPE') %}
                    <li class="nav-header">RH & Pessoas</li>

                    <li class="nav-item {{ app.request.attributes.get('_route') starts with 'app_rh' ? 'menu-open' : '' }}">
                        <a href="{{ path('app_rh') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_rh' ? 'active' : '' }}">
                            <i class="fas fa-id-card nav-icon"></i>
                            <p>RH <i class="fas fa-angle-left right"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a href="{{ path('app_rh_funcionarios') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_rh_funcionarios' ? 'active' : '' }}">
                                    <i class="fas fa-user-tie nav-icon"></i>
                                    <p>Funcionários</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('app_rh_admissoes') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_rh_admissoes' ? 'active' : '' }}">
                                    <i class="fas fa-user-plus nav-icon"></i>
                                    <p>Admissões</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('app_rh_ferias') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_rh_ferias' ? 'active' : '' }}">
                                    <i class="fas fa-umbrella-beach nav-icon"></i>
                                    <p>Férias</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('app_rh_folha') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_rh_folha' ? 'active' : '' }}">
                                    <i class="fas fa-money-bill-wave nav-icon"></i>
                                    <p>Folha de Pag.</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item {{ app.request.attributes.get('_route') starts with 'app_pessoas' ? 'menu-open' : '' }}">
                        <a href="{{ path('app_pessoas') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_pessoas' ? 'active' : '' }}">
