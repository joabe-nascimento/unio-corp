<script>
function runShellSidebarControls() {
    if (typeof jQuery === 'undefined') return;
    if (window.__UNIO_SHELL_SIDEBAR_INIT__) return;
    window.__UNIO_SHELL_SIDEBAR_INIT__ = true;

    var $body = jQuery('body');
    var $toggle = jQuery('[data-unio-shell-toggle="sidebar"]');
    var DRAWER_MQ = window.matchMedia('(max-width: 1199.98px)');

    function isDrawer() {
        return DRAWER_MQ.matches;
    }

    var desktopSidebarCollapsed = null;

    function applyShellSidebar() {
        jQuery('#sidebar-overlay').remove();
        if (isDrawer()) {
            if (desktopSidebarCollapsed === null) {
                desktopSidebarCollapsed = $body.hasClass('sidebar-collapse');
            }
            $body.addClass('sidebar-collapse');
            $body.removeClass('sidebar-open sidebar-closed sidebar-is-opening');
        } else {
            $body.removeClass('sidebar-open sidebar-closed sidebar-is-opening');
            if (desktopSidebarCollapsed !== null) {
                $body.toggleClass('sidebar-collapse', desktopSidebarCollapsed);
                desktopSidebarCollapsed = null;
            }
        }
    }

    function closeDrawer() {
        $body.removeClass('sidebar-open sidebar-closed sidebar-is-opening');
    }

    function toggleDrawer() {
        $body.toggleClass('sidebar-open');
        $body.removeClass('sidebar-closed sidebar-is-opening');
    }

    function toggleDesktopSidebar() {
        $body.toggleClass('sidebar-collapse');
    }

    function shouldCloseOnNav(href) {
        if (!href || href.charAt(0) === '#' || href.indexOf('javascript:') === 0) return false;
        try {
            var url = new URL(href, window.location.href);
            return url.origin === window.location.origin;
        } catch (err) {
            return false;
        }
    }

    applyShellSidebar();

    var resizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(applyShellSidebar, 150);
    });

    jQuery(document).on('click.unioShellDrawer', function (e) {
        if (!isDrawer() || !$body.hasClass('sidebar-open')) return;
        if (jQuery(e.target).closest('.main-sidebar, [data-unio-shell-toggle="sidebar"], .shell-mobile-nav').length) return;
        closeDrawer();
    });

    jQuery(document).on('click.unioShellNav', 'a[href]', function () {
        if (!isDrawer()) return;
        if (shouldCloseOnNav(this.getAttribute('href') || '')) {
            try { sessionStorage.setItem('unio-shell-close-sidebar', '1'); } catch (err) {}
            closeDrawer();
        }
    });

    jQuery('[data-widget="treeview"]').on('expanded.lte.treeview', function () {
        if ($body.hasClass('sidebar-mini') && $body.hasClass('sidebar-collapse') && !isDrawer()) {
            $body.removeClass('sidebar-collapse');
        }
    });

    jQuery(document).on('click.unioShellMenu', '[data-shell-mobile-action="open-sidebar"]', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (!isDrawer()) return;
        toggleDrawer();
    });

    $toggle.off('click.unioShellToggle').on('click.unioShellToggle', function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        if (isDrawer()) {
            toggleDrawer();
        } else {
            toggleDesktopSidebar();
        }
    });
}

document.addEventListener('DOMContentLoaded', runShellSidebarControls);
window.addEventListener('load', runShellSidebarControls);
</script>
<script>
(function () {
    'use strict';
    document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-search-expand]').forEach(function (wrap) {
            var toggle = wrap.querySelector('.list-search-toggle');
            var input = wrap.querySelector('.list-search-input');
            var closeBtn = wrap.querySelector('.list-search-close');
            if (!toggle || !input) return;

            if (toggle.contains(e.target)) {
                wrap.classList.add('is-expanded');
                toggle.setAttribute('aria-expanded', 'true');
                setTimeout(function () { input.focus(); }, 50);
                return;
            }
            if (closeBtn && closeBtn.contains(e.target)) {
                wrap.classList.remove('is-expanded');
                toggle.setAttribute('aria-expanded', 'false');
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                return;
            }
            if (wrap.classList.contains('is-expanded') && !wrap.contains(e.target) && !input.value.trim()) {
                wrap.classList.remove('is-expanded');
                toggle.setAttribute('aria-expanded', 'false');
            }
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('[data-search-expand].is-expanded').forEach(function (wrap) {
            var toggle = wrap.querySelector('.list-search-toggle');
            var input = wrap.querySelector('.list-search-input');
            wrap.classList.remove('is-expanded');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            if (input) {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
            }
        });
    });
})();
</script>
<script>
(function() {
    var saved = localStorage.getItem('unio-theme') || 'dark';
    applyTheme(saved);

    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var mIcon = document.getElementById('themeMenuIcon');
        var mLabel = document.getElementById('themeMenuLabel');
        if (t === 'dark') {
            if (mIcon) mIcon.className = 'fas fa-sun';
            if (mLabel) mLabel.textContent = 'Tema claro';
        } else {
            if (mIcon) mIcon.className = 'fas fa-moon';
            if (mLabel) mLabel.textContent = 'Tema escuro';
        }
    }

    window.toggleTheme = function() {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        localStorage.setItem('unio-theme', next);
        applyTheme(next);
    };
})();
</script>
