<script>
(function () {
    'use strict';
    var DRAWER_MQ = window.matchMedia('(max-width: 1199.98px)');
    var NAV_FLAG = 'unio-shell-close-sidebar';

    function isDrawerViewport() {
        return DRAWER_MQ.matches;
    }

    function resetMobileSidebar() {
        if (!isDrawerViewport() || !document.body) return;
        document.body.classList.add('sidebar-collapse');
        document.body.classList.remove('sidebar-open', 'sidebar-closed', 'sidebar-is-opening');
        var overlay = document.getElementById('sidebar-overlay');
        if (overlay) overlay.remove();
    }

    if (sessionStorage.getItem(NAV_FLAG) === '1') {
        sessionStorage.removeItem(NAV_FLAG);
    }
    resetMobileSidebar();
    document.addEventListener('DOMContentLoaded', resetMobileSidebar);
    window.addEventListener('pageshow', resetMobileSidebar);
    window.addEventListener('pagehide', resetMobileSidebar);
    window.addEventListener('load', resetMobileSidebar);

    document.addEventListener('click', function (e) {
        if (e.target.closest('[data-shell-mobile-action="open-sidebar"], [data-unio-shell-toggle="sidebar"]')) return;
        if (!isDrawerViewport()) return;
        var link = e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href') || '';
        if (!href || href.charAt(0) === '#' || href.indexOf('javascript:') === 0) return;
        sessionStorage.setItem(NAV_FLAG, '1');
        document.body.classList.remove('sidebar-open', 'sidebar-closed', 'sidebar-is-opening');
    }, true);
})();
</script>
