</script>
<script>
(function () {
    'use strict';
    document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-search-expand]').forEach(function (wrap) {
            var toggle = wrap.querySelector('.list-search-toggle');
            var input = wrap.querySelector('.list-search-input');
            var closeBtn = wrap.querySelector('.list-search-close');
            if (!toggle || !input) return;

            if (toggle.contains(e.target)) {
                wrap.classList.add('is-expanded');
                toggle.setAttribute('aria-expanded', 'true');
                setTimeout(function () { input.focus(); }, 50);
                return;
            }
            if (closeBtn && closeBtn.contains(e.target)) {
                wrap.classList.remove('is-expanded');
                toggle.setAttribute('aria-expanded', 'false');
                input.value = '';
                return;
            }
            if (wrap.classList.contains('is-expanded') && !wrap.contains(e.target) && !input.value.trim()) {
                wrap.classList.remove('is-expanded');
                toggle.setAttribute('aria-expanded', 'false');
            }
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('[data-search-expand].is-expanded').forEach(function (wrap) {
            var toggle = wrap.querySelector('.list-search-toggle');
            var input = wrap.querySelector('.list-search-input');
            wrap.classList.remove('is-expanded');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            if (input) input.value = '';
        });
    });
})();
</script>
<script>
(function() {
    var saved = localStorage.getItem('huplex-theme') || 'dark';
    applyTheme(saved);

    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var icon = document.getElementById('themeIcon');
        var mIcon = document.getElementById('themeMenuIcon');
        var mLabel = document.getElementById('themeMenuLabel');
        if (t === 'dark') {
            if (icon) icon.className = 'fas fa-sun';
            if (mIcon) mIcon.className = 'fas fa-sun mr-2';
            if (mLabel) mLabel.textContent = 'Tema claro';
        } else {
            if (icon) icon.className = 'fas fa-moon';
            if (mIcon) mIcon.className = 'fas fa-moon mr-2';
            if (mLabel) mLabel.textContent = 'Tema escuro';
        }
    }

    window.toggleTheme = function() {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        localStorage.setItem('huplex-theme', next);
        applyTheme(next);
    };
})();
</script>
