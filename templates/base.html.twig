<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Huplex{% endblock %} | Huplex</title>

    {# AdminLTE 3 + Bootstrap 4 via CDN #}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('huplex-theme')||'dark')}catch(e){}</script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/huplex-app.css') }}?v=1">

    {% block stylesheets %}{% endblock %}
</head>
{% import 'macros/empresa.html.twig' as empresa_macro %}
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    {# ── Top Navbar (sem workspace — só toggle + usuário) ── #}
    <nav class="main-header navbar navbar-expand navbar-dark">
        <a class="nav-link nav-toggle-btn" data-widget="pushmenu" href="#" role="button">
            <i class="fas fa-bars"></i>
        </a>

        <ul class="navbar-nav ml-auto align-items-center mb-0">
            <li class="nav-item d-flex align-items-center">
                <button type="button" class="theme-btn" id="themeToggle" title="Alternar tema" onclick="toggleTheme()">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </button>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link user-menu-btn d-flex align-items-center" data-toggle="dropdown" href="#" style="gap:8px;padding:4px 8px!important">
                    <span class="avatar-circle">{{ app.user.initials }}</span>
                    <span style="color:var(--text-2);font-size:13px;font-weight:500">{{ app.user.nome|split(' ')|first }}</span>
                    <i class="fas fa-chevron-down" style="font-size:9px;color:var(--text-3)"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right huplex-dropdown">
                    <div class="dd-head">
                        <div style="color:var(--text-1);font-size:13px;font-weight:600">{{ app.user.nome }}</div>
                        <div style="color:var(--text-3);font-size:11px">{{ app.user.email }}</div>
                        <div class="mt-1"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span></div>
                    </div>
                    <a class="dropdown-item" href="#">
                        <i class="fas fa-user"></i> Meu Perfil
                    </a>
                    {% if empresas is defined and empresas|length > 0 %}
                    <a class="dropdown-item" href="{{ path('app_workspace_select', {force: 1}) }}">
                        <i class="fas fa-building"></i> Trocar área de trabalho
                    </a>
                    {% endif %}
                    <a class="dropdown-item" href="#" onclick="toggleTheme();return false;">
                        <i class="fas fa-adjust" id="themeMenuIcon"></i>
                        <span id="themeMenuLabel">Tema claro</span>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item dropdown-item-danger" href="{{ path('app_logout') }}">
                        <i class="fas fa-sign-out-alt"></i> Sair
                    </a>
                </div>
            </li>
        </ul>
    </nav>

    {# ── Sidebar ── #}
    <aside class="main-sidebar sidebar-dark-primary elevation-0">
        <div class="sidebar-top">
            <a href="{{ path('app_dashboard') }}" class="brand-link elevation-0" title="Huplex Corp">
                <span class="brand-text font-weight-bold">
                    Hup<span class="accent">lex</span>
                    <span class="brand-suffix">Corp</span>
                </span>
            </a>
        </div>

        <div class="sidebar">
            <nav class="mt-2 pb-3">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                    {% include 'layout/_sidebar_nav.html.twig' %}
                </ul>
            </nav>
        </div>

        {% if empresa is defined and empresa %}
        <div class="sidebar-bottom">
            <a href="{{ path('app_workspace_select', {force: 1}) }}"
               class="sidebar-empresa sidebar-empresa-link"
               title="Trocar área de trabalho — {{ empresa.nome }}">
                {{ empresa_macro.logo(empresa, 'empresa-logo se-logo') }}
                <div class="se-info">
                    <div class="se-name">{{ empresa.nome }}</div>
                    {% if empresa.setor %}<div class="se-setor">{{ empresa.setor }}</div>{% endif %}
                </div>
                            {% if empresas is defined and empresas|length > 1 %}
                <i class="fas fa-chevron-right se-chevron"></i>
                {% endif %}
            </a>
        </div>
        {% endif %}
    </aside>

    {# ── Content ── #}
    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2 align-items-center">
                    <div class="col-sm-6">
                        <h1 class="m-0">{% block page_title '' %}</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Início</a></li>
                            {% block breadcrumb %}{% endblock %}
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                {% for flash_type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ flash_type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block content %}{% endblock %}
            </div>
        </section>
    </div>

    <footer class="main-footer text-center">
        <strong>Huplex</strong> &copy; {{ "now"|date("Y") }} — Plataforma de Gestão de Pessoas
    </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js" defer></script>
<script>
(function() {
    var saved = localStorage.getItem('huplex-theme') || 'dark';
    applyTheme(saved);

    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var icon = document.getElementById('themeIcon');
        var mIcon = document.getElementById('themeMenuIcon');
        var mLabel = document.getElementById('themeMenuLabel');
        if (t === 'dark') {
            if (icon) icon.className = 'fas fa-sun';
            if (mIcon) mIcon.className = 'fas fa-sun mr-2';
            if (mLabel) mLabel.textContent = 'Tema claro';
        } else {
            if (icon) icon.className = 'fas fa-moon';
            if (mIcon) mIcon.className = 'fas fa-moon mr-2';
            if (mLabel) mLabel.textContent = 'Tema escuro';
        }
    }

    window.toggleTheme = function() {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        localStorage.setItem('huplex-theme', next);
        applyTheme(next);
    };
})();
</script>
<script>
(function () {
    'use strict';
    function applyViewMode(toggle, container, mode) {
        var key = toggle.dataset.vtKey;
        toggle.querySelectorAll('[data-vt-mode]').forEach(function (btn) {
            btn.classList.toggle('view-btn--active', btn.dataset.vtMode === mode);
        });
        container.setAttribute('data-view-mode', mode);
        try { localStorage.setItem(key, mode); } catch (e) {}
    }
    function initToggle(toggle) {
        var container = document.getElementById(toggle.dataset.vtContainer);
        if (!container) return;
        var saved;
        try { saved = localStorage.getItem(toggle.dataset.vtKey); } catch (e) {}
        applyViewMode(toggle, container, saved || toggle.dataset.vtDefault || 'list');
        toggle.querySelectorAll('[data-vt-mode]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                applyViewMode(toggle, container, btn.dataset.vtMode);
            });
        });
    }
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.view-toggle-group').forEach(initToggle);
    });
})();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>