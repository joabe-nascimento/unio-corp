<!DOCTYPE html>
{% set _pnome = platform_config.plataforma_nome|default('Unio') %}
{% set _tema  = platform_config.tema|default('dark') %}
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ _pnome }}{% endblock %} | {{ _pnome }}</title>

    {% include 'components/platform_favicon.html.twig' %}

    {# AdminLTE 3 + Bootstrap 4 via CDN #}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('unio-theme')||'{{ _tema }}')}catch(e){}</script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap4.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    {% set _unio_css = app.debug ? 'css/unio-app.css' : 'css/unio-app.min.css' %}
    <link rel="stylesheet" href="{{ asset(_unio_css) }}?v=270">

    {% block stylesheets %}{% endblock %}
    {% if app.user %}
    <link rel="stylesheet" href="{{ asset('css/ti-chat-widget.css') }}?v=3">
    {% endif %}
</head>
{% import 'macros/helix.html.twig' as helix %}
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    {# ── Top Navbar (Vitória, apps) ── #}
    <nav class="main-header navbar navbar-expand navbar-dark">
        <a class="nav-link nav-toggle-btn" data-widget="pushmenu" href="#" role="button" aria-label="Alternar menu lateral">
            <span class="nav-toggle-icon" aria-hidden="true">
                <span class="nav-toggle-line"></span>
                <span class="nav-toggle-line"></span>
                <span class="nav-toggle-line"></span>
            </span>
        </a>

        <div class="main-header-search d-none d-md-flex">
            {% include 'components/global_search.html.twig' %}
        </div>

        <ul class="navbar-nav ml-auto align-items-center mb-0">
            <li class="nav-item d-flex align-items-center">
                <button type="button" class="helix-trigger" id="helixOpenBtn" aria-expanded="false" aria-controls="helixPanel" title="Vitória — Assistente virtual">
                    {{ helix.avatar('sm') }}
                </button>
            </li>
            {% if platform_modules|default([])|length > 0 %}
            <li class="nav-item d-flex align-items-center">
                {% include 'components/platform_apps_launcher.html.twig' %}
            </li>
            {% endif %}
        </ul>
    </nav>

    {# ── Sidebar ── #}
    <aside class="main-sidebar sidebar-dark-primary elevation-0">
        <div class="sidebar-top">
            {% if app.user %}
                {% include 'components/sidebar_identity_hub.html.twig' %}
            {% else %}
                <a href="{{ path('app_dashboard') }}" class="brand-link elevation-0" title="{{ _pnome }}">
                    {% include 'components/platform_logo.html.twig' with {
                        variant: 'full',
                        class: 'sidebar-logo sidebar-logo-full'
                    } only %}
                </a>
            {% endif %}
        </div>

        <div class="sidebar">
            <nav class="mt-2 pb-3">
                <ul class="nav nav-pills nav-sidebar flex-column"
                    data-widget="treeview"
                    data-sidebar-hubs
                    data-active-hub="{{ nav_active_hub|default('') }}"
                    role="menu"
                    data-accordion="false"
                    data-animation-speed="0"
                    data-expand-sidebar="true">
                    {% include 'layout/_sidebar_nav.html.twig' %}
                </ul>
            </nav>
        </div>

        {% if app.user %}
        <div class="sidebar-bottom">
            {% include 'components/sidebar_ambient_sound.html.twig' with {
                user_id: app.user.id
            } only %}
        </div>
        {% endif %}
    </aside>

    {# ── Content ── #}
    <div class="content-wrapper">
        {# Bloco só para flag — nunca renderizar aqui (evita exibir "1" na página) #}
        {% if false %}{% block page_toolbar_layout %}{% endblock %}{% endif %}
        {% set show_page_header = block('page_toolbar_layout')|trim is empty and (block('page_show_title')|trim or block('breadcrumb')|trim) %}
        {% if show_page_header %}
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2 align-items-center">
                    <div class="col-12 col-sm-6">
                        {% if false %}{% block page_show_title %}{% endblock %}{% endif %}
                        {% if block('page_show_title')|trim %}
                        <h1 class="m-0">{% block page_title '' %}</h1>
                        {% endif %}
                    </div>
                    <div class="col-12 col-sm-6 text-sm-right">
                        <ol class="breadcrumb breadcrumb--page mb-0 d-inline-block">
                            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Início</a></li>
                            {% block breadcrumb %}{% endblock %}
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <section class="content{% if block('page_toolbar_layout')|trim %} content--with-toolbar{% elseif not show_page_header %} content--no-header{% endif %}">
            {% block content_lead %}{% endblock %}
            <div class="container-fluid container-fluid--page-body">
                {% block content %}{% endblock %}
            </div>
        </section>
    </div>

    {% block page_overlays %}{% endblock %}

    {% include 'components/unio_toast_stack.html.twig' %}

    {% if app.user %}
    {% include 'components/ti/chamado_chat_global.html.twig' %}
    {% endif %}

    {% if platform_config.manutencao ?? false %}
    <div class="manut-tenant-banner" role="alert">
        <i class="fas fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        <strong>Modo manutenção ativo</strong> — outros usuários não estão conseguindo acessar a plataforma.
        <a href="{{ path('app_admin_configuracoes') }}#cfg-manutencao" class="ml-2" style="color:inherit;text-decoration:underline;">Desativar</a>
    </div>
    {% endif %}

    <footer class="main-footer text-center">
        <div class="main-footer__line">
            <strong>{{ _pnome }}</strong> &copy; {{ "now"|date("Y") }} — {{ platform_config.rodape_texto|default(platform_config.plataforma_tagline|default('Plataforma de Gestão de Pessoas')) }}
        </div>
        {% include 'components/platform_support.html.twig' with { extra_class: ' platform-support--footer' } %}
    </footer>
</div>

{% include 'components/helix_assistant.html.twig' %}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" defer></script>
