{# ── View Toggle — JS genérico, carregado uma vez no base ── #}
<script>
(function () {
    'use strict';

    function applyViewMode(toggle, container, mode) {
        var key = toggle.dataset.vtKey;
        // Atualiza botões
        toggle.querySelectorAll('[data-vt-mode]').forEach(function (btn) {
            btn.classList.toggle('view-btn--active', btn.dataset.vtMode === mode);
        });
        // Atualiza container via atributo data-view-mode
        container.setAttribute('data-view-mode', mode);
        // Persiste preferência
        try { localStorage.setItem(key, mode); } catch (e) {}
    }

    function initToggle(toggle) {
        var containerId = toggle.dataset.vtContainer;
        var container   = document.getElementById(containerId);
        if (!container) return;

        var key         = toggle.dataset.vtKey;
        var defaultMode = toggle.dataset.vtDefault || 'list';
        var saved;
        try { saved = localStorage.getItem(key); } catch (e) {}

        applyViewMode(toggle, container, saved || defaultMode);

        toggle.querySelectorAll('[data-vt-mode]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                applyViewMode(toggle, container, btn.dataset.vtMode);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.view-toggle-group').forEach(initToggle);
    });
})();
</script>
<script>
(function () {
    'use strict';

    var STORAGE_KEY = 'unio-helix-sessions';
    var panel = document.getElementById('helixPanel');
    var openBtn = document.getElementById('helixOpenBtn');
    var form = document.getElementById('helixForm');
    var input = document.getElementById('helixInput');
    var sendBtn = document.getElementById('helixSendBtn');
    var messagesEl = document.getElementById('helixMessages');
    var historyList = document.getElementById('helixHistoryList');
    var historyEmpty = document.getElementById('helixHistoryEmpty');
    var historyCount = document.getElementById('helixHistoryCount');
    var historyToggle = document.getElementById('helixHistoryToggle');
    var historyToggleCount = document.getElementById('helixHistoryToggleCount');
    var suggestions = document.getElementById('helixSuggestions');
    var mobileMq = window.matchMedia('(max-width: 575.98px)');

    if (!panel || !openBtn) return;

    /* Apresenta a aba de borda uma vez (descoberta do novo lugar) */
    if (openBtn.classList.contains('helix-dock')) {
        try {
            if (!sessionStorage.getItem('unio-helix-dock-intro')) {
                sessionStorage.setItem('unio-helix-dock-intro', '1');
                window.setTimeout(function () {
                    openBtn.classList.add('is-expanded');
                    window.setTimeout(function () {
                        openBtn.classList.remove('is-expanded');
                    }, 2400);
                }, 700);
            }
        } catch (e) { /* ignore */ }
    }

    var faceTplEl = document.getElementById('helixFaceSmTemplate');
    var FACE_SM = faceTplEl ? faceTplEl.innerHTML.trim() : '';
    if (!FACE_SM && panel.dataset.assistantAvatar) {
        FACE_SM = '<span class="helix-face helix-face--sm" aria-hidden="true"><img src="' +
            panel.dataset.assistantAvatar.replace(/"/g, '&quot;') + '" alt=""></span>';
    }

    var currentSessionId = null;
    var helixRequestInFlight = false;
    var subtitleEl = panel.querySelector('.helix-subtitle');
    var subtitleDefault = subtitleEl ? subtitleEl.textContent : '';
    var LEX_STORAGE_KEY = 'unio-helix-lex-mode';
    var lexToggle = document.getElementById('helixLexToggle');
    var lexMode = false;
    var isStudio = panel.dataset.studio === '1';
    var studioExitUrl = panel.dataset.studioExit || '';

    function isLexMode() {
        return !!lexMode;
    }

    function setLexMode(on) {
        lexMode = !!on;
        try { localStorage.setItem(LEX_STORAGE_KEY, lexMode ? '1' : '0'); } catch (e) {}
        if (lexToggle) {
            lexToggle.classList.toggle('is-active', lexMode);
            lexToggle.setAttribute('aria-pressed', lexMode ? 'true' : 'false');
        }
        panel.classList.toggle('is-lex-mode', lexMode);
        if (subtitleEl && !helixRequestInFlight) {
            subtitleEl.textContent = lexMode
                ? 'Modo Lex · raciocínio superior'
                : subtitleDefault;
        }
    }

    try {
        setLexMode(localStorage.getItem(LEX_STORAGE_KEY) === '1');
    } catch (e) {
        setLexMode(false);
    }

    if (lexToggle) {
        lexToggle.addEventListener('click', function () {
            setLexMode(!isLexMode());
        });
    }

    function assistantName() {
        return panel.dataset.assistantName || (panel.dataset.juridico === '1' ? 'Sasha' : 'Sasha');
    }

    function setHelixLoading(loading) {
        helixRequestInFlight = loading;
        panel.classList.toggle('is-helix-loading', loading);
        if (input) input.disabled = loading;
        if (sendBtn) {
            sendBtn.classList.toggle('is-busy', loading);
            sendBtn.disabled = loading || !(input && input.value.trim());
            sendBtn.setAttribute('aria-busy', loading ? 'true' : 'false');
        }
        if (subtitleEl) {
            subtitleEl.textContent = loading
                ? assistantName() + ' está digitando…'
                : (isLexMode() ? 'Modo Lex · raciocínio superior' : subtitleDefault);
        }
    }

    var HELIX_TYPING_STEPS = {
        clinic: [
            { icon: 'fa-magnifying-glass', text: 'Lendo sua mensagem…' },
            { icon: 'fa-heart-pulse', text: 'Consultando Pulso e protocolos…' },
            { icon: 'fa-lightbulb', text: 'Organizando a resposta…' },
            { icon: 'fa-check', text: 'Quase pronto…' }
        ],
        juridico: [
            { icon: 'fa-magnifying-glass', text: 'Lendo sua mensagem…' },
            { icon: 'fa-scale-balanced', text: 'Coletando informações do caso…' },
            { icon: 'fa-gavel', text: 'Consultando prazos e jurisprudência…' },
            { icon: 'fa-file-lines', text: 'Redigindo a resposta…' },
            { icon: 'fa-check', text: 'Quase pronto…' }
        ],
        juridicoLex: [
            { icon: 'fa-gem', text: 'Modo Lex ativo…' },
            { icon: 'fa-brain', text: 'Raciocinando em camadas…' },
            { icon: 'fa-robot', text: 'Acionando agentes e tools…' },
            { icon: 'fa-scale-balanced', text: 'Montando estratégia…' },
            { icon: 'fa-feather', text: 'Redigindo como sócio sênior…' }
        ],
        organismo: [
            { icon: 'fa-magnifying-glass', text: 'Lendo sua intenção…' },
            { icon: 'fa-diagram-project', text: 'Buscando na colônia…' },
            { icon: 'fa-lightbulb', text: 'Organizando a resposta…' },
            { icon: 'fa-check', text: 'Quase pronto…' }
        ],
        default: [
            { icon: 'fa-magnifying-glass', text: 'Lendo sua mensagem…' },
            { icon: 'fa-database', text: 'Buscando contexto…' },
            { icon: 'fa-lightbulb', text: 'Organizando a resposta…' },
            { icon: 'fa-check', text: 'Quase pronto…' }
        ]
    };
    var typingStepTimer = null;

    function typingSteps() {
        if (panel.dataset.clinic === '1') return HELIX_TYPING_STEPS.clinic;
        if (panel.dataset.juridico === '1') {
            return isLexMode() ? HELIX_TYPING_STEPS.juridicoLex : HELIX_TYPING_STEPS.juridico;
        }
        if (panel.dataset.organismo === '1') return HELIX_TYPING_STEPS.organismo;
        return HELIX_TYPING_STEPS.default;
    }

    function typingIndicatorHtml() {
        var name = assistantName();
        var steps = typingSteps();
        var first = steps[0];
        var dotsHtml = steps.map(function (_, i) {
            return '<span class="helix-typing-progress-dot' + (i === 0 ? ' is-active' : '') + '"></span>';
        }).join('');
        return '<div class="helix-msg helix-msg--assistant helix-msg--typing" id="helixTypingIndicator" aria-live="polite" aria-label="' +
            escapeHtml(name) + ' está digitando">' +
            FACE_SM +
            '<div class="helix-msg-bubble helix-msg-bubble--typing">' +
            '<div class="helix-typing-row">' +
            '<span class="helix-typing-icon-wrap"><i class="fas ' + first.icon + ' helix-typing-icon" id="helixTypingIcon" aria-hidden="true"></i></span>' +
            '<span class="helix-typing-label" id="helixTypingLabel">' + escapeHtml(first.text) + '</span>' +
            '</div>' +
            '<div class="helix-typing-progress" id="helixTypingProgress">' + dotsHtml + '</div>' +
            '</div></div>';
    }

    function showTypingIndicator() {
        hideTypingIndicator();
        if (!messagesEl) return;
        messagesEl.insertAdjacentHTML('beforeend', typingIndicatorHtml());
        scrollMessages();

        var steps = typingSteps();
        var idx = 0;
        typingStepTimer = setInterval(function () {
            idx += 1;
            if (idx >= steps.length) {
                idx = steps.length - 1;
            }
            var iconEl = document.getElementById('helixTypingIcon');
            var labelEl = document.getElementById('helixTypingLabel');
            var progressEl = document.getElementById('helixTypingProgress');
            if (!iconEl || !labelEl || !progressEl) {
                clearInterval(typingStepTimer);
                typingStepTimer = null;
                return;
            }
            var step = steps[idx];
            iconEl.className = 'fas ' + step.icon + ' helix-typing-icon';
            labelEl.textContent = step.text;
            var dots = progressEl.querySelectorAll('.helix-typing-progress-dot');
            dots.forEach(function (dot, i) {
                dot.classList.toggle('is-active', i <= idx);
            });
            scrollMessages();
            if (idx >= steps.length - 1) {
                clearInterval(typingStepTimer);
                typingStepTimer = null;
            }
        }, 1400);
    }

    function hideTypingIndicator() {
        if (typingStepTimer) {
            clearInterval(typingStepTimer);
            typingStepTimer = null;
        }
        var el = document.getElementById('helixTypingIndicator');
        if (el) el.remove();
    }

    function isMobileHelix() {
        return mobileMq.matches;
    }

    function setHistoryOpen(open) {
        panel.classList.toggle('is-history-open', open);
        if (historyToggle) historyToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function closeHistoryIfMobile() {
        if (isMobileHelix()) setHistoryOpen(false);
    }

    function loadSessions() {
        try {
            var raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (e) {
            return [];
        }
    }

    function saveSessions(sessions) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(sessions));
        } catch (e) {}
    }

    function uid() {
        return 'h' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
    }

    function formatDate(iso) {
        try {
            var d = new Date(iso);
            return d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        } catch (e) {
            return '';
        }
    }

    function getSession(id) {
        return loadSessions().find(function (s) { return s.id === id; }) || null;
    }

    function upsertSession(session) {
        var sessions = loadSessions().filter(function (s) { return s.id !== session.id; });
        sessions.unshift(session);
        if (sessions.length > 50) sessions = sessions.slice(0, 50);
        saveSessions(sessions);
    }

    function ensureSession() {
        if (currentSessionId && getSession(currentSessionId)) return currentSessionId;
        var session = {
            id: uid(),
            title: 'Nova conversa',
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            messages: []
        };
        upsertSession(session);
        currentSessionId = session.id;
        return currentSessionId;
    }

    function scrollMessages() {
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function renderWelcomeOnly() {
        if (!messagesEl) return;
        var first = panel.dataset.userFirst || '';
        var assistant = assistantName();
        var isOrganismo = panel.dataset.organismo === '1';
        var isClinic = panel.dataset.clinic === '1';
        var isJuridico = panel.dataset.juridico === '1';
        var slogan = panel.dataset.brandSlogan || 'Saúde que acompanha.';
        var greeting = first ? 'Olá, ' + escapeHtml(first) + '.' : 'Olá.';
        var lead;
        var sub;
        if (isClinic) {
            lead = greeting + ' Sou ' + escapeHtml(assistant) + ' — assistente clínico da Unio Saúde.';
            sub = 'Posso ajudar com Pulso, Sala Crítica, pacientes na Trilha e contratos de cuidado.';
        } else if (isJuridico) {
            lead = greeting + ' Sou ' + escapeHtml(assistant) + ' — assistente jurídica da Unio Jurídico.';
            sub = 'Posso calcular prazos processuais, pesquisar jurisprudência, resumir peças, analisar contratos e ajudar com clientes e casos do escritório.';
        } else if (isOrganismo) {
            lead = greeting + ' Sou ' + escapeHtml(assistant) + ' — a consciência da sua colônia.';
            sub = 'Posso buscar membros, listar férias pendentes ou abrir uma admissão.';
        } else {
            lead = greeting + ' Sou ' + escapeHtml(assistant) + ' — sua assistente na Unio.';
            sub = 'Posso ajudar com operação, alertas clínicos e fluxos dos núcleos.';
        }
        messagesEl.innerHTML =
            '<div class="helix-msg helix-msg--assistant helix-msg--welcome">' + FACE_SM +
            '<div class="helix-msg-bubble">' +
            '<p>' + lead + '</p>' +
            '<p class="mb-0 helix-msg-muted">' + sub + '</p>' +
            (isClinic ? '<span class="helix-msg__signature">' + escapeHtml(slogan) + '</span>' : '') +
            '</div></div>';
        if (suggestions) suggestions.style.display = '';
    }

    function renderMessages(session) {
        if (!messagesEl || !session) return;
        var html = '';
        session.messages.forEach(function (m) {
            html += messageHtml(m.role, m.text, m.actionsHtml || '', m);
        });
        if (!html) {
            renderWelcomeOnly();
            return;
        }
        messagesEl.innerHTML = html;
        if (suggestions) suggestions.style.display = session.messages.length ? 'none' : '';
        applyCardStates(session);
        
        // Aplicar melhorias visuais de mensagem (timestamps, avatares, botões)
        if (typeof HelixFeatures !== 'undefined') {
            messagesEl.querySelectorAll('.helix-msg').forEach(function(msgEl, idx) {
                var msg = session.messages[idx];
                if (msg) {
                    HelixFeatures.enhanceMessage(msgEl, msg, msg.role === 'assistant');
                }
            });
        }
        
        // Renderizar markdown
        if (typeof HelixMarkdown !== 'undefined') {
            messagesEl.querySelectorAll('.helix-msg--assistant .helix-msg-bubble > p').forEach(function(p) {
                if (!p.querySelector('.helix-tool-actions, .helix-confirm-card')) {
                    var text = p.textContent || '';
                    p.innerHTML = HelixMarkdown.render(text);
                }
            });
        }
        
        scrollMessages();
    }

    function messageHtml(role, text, actionsHtml, message) {
        var isUser = role === 'user';
        var esc = escapeHtml(text);
        var isClinic = panel.dataset.clinic === '1';
        var slogan = panel.dataset.brandSlogan || 'Saúde que acompanha.';
        var signature = (!isUser && isClinic)
            ? '<span class="helix-msg__signature">' + escapeHtml(slogan) + '</span>'
            : '';

        var timestamp = message && message.at ? message.at : new Date().toISOString();

        var attachmentsHtml = '';
        if (isUser && message && message.attachments && message.attachments.length) {
            attachmentsHtml = '<div class="helix-msg-attachments">' + message.attachments.map(function (att) {
                var title = att.truncated ? 'Texto truncado (documento muito longo)' : att.filename;
                return '<span class="helix-msg-attachment" title="' + escapeHtml(title) + '">' +
                    '<i class="fas fa-file-lines" aria-hidden="true"></i>' +
                    escapeHtml(att.filename) +
                    '</span>';
            }).join('') + '</div>';
        }

        var bodyHtml = '<p class="mb-0">' + esc.replace(/\n/g, '<br>') + '</p>' + attachmentsHtml;
        if (isUser) {
            bodyHtml = '<div class="helix-msg__body">' + bodyHtml + '</div>';
        }

        return '<div class="helix-msg helix-msg--' + (isUser ? 'user' : 'assistant') + '">' +
            (isUser ? '' : FACE_SM) +
            '<div class="helix-msg-bubble">' +
            bodyHtml +
            (actionsHtml || '') +
            signature +
            '</div></div>';
    }

    function renderToolActions(results) {
        if (!results || !results.length) return '';
        var html = '<div class="helix-tool-actions mt-2">';
        results.forEach(function (r) {
            if (r.type === 'confirm') {
                html += renderConfirmCard(r);
            } else if (r.url) {
                var label = r.nome || r.label || r.membro || 'Abrir';
                html += '<a class="helix-tool-action-btn" href="' + escapeHtml(r.url) + '">' + escapeHtml(label) + '</a>';
            } else if (r.action === 'open_url' && r.url) {
                html += '<a class="helix-tool-action-btn helix-tool-action-btn--primary" href="' + escapeHtml(r.url) + '">' + escapeHtml(r.label || 'Executar') + '</a>';
            }
        });
        html += '</div>';
        return html;
    }

    var helixConfirmCardSeq = 0;

    /**
     * Cartão de confirmação antes de qualquer gravação (criar tarefa, registrar prazo,
     * salvar jurisprudência…). Nada é escrito no sistema sem o clique explícito aqui —
     * é o "aperto de mão" humano entre a sugestão da Sasha e a ação de verdade.
     */
    function renderConfirmCard(item) {
        var cardId = 'helix-confirm-' + (++helixConfirmCardSeq);
        var rows = (item.preview || []).map(function (p) {
            return '<div class="helix-confirm-row">' +
                '<span class="helix-confirm-row__label">' + escapeHtml(p.label || '') + '</span>' +
                '<span class="helix-confirm-row__value">' + escapeHtml(p.value || '') + '</span>' +
                '</div>';
        }).join('');
        var paramsJson = escapeHtml(JSON.stringify(item.params || {}));

        return '<div class="helix-confirm-card" id="' + cardId + '">' +
            (item.title ? '<div class="helix-confirm-card__title"><i class="fas fa-file-signature" aria-hidden="true"></i>' + escapeHtml(item.title) + '</div>' : '') +
            (rows ? '<div class="helix-confirm-card__body">' + rows + '</div>' : '') +
            '<div class="helix-confirm-card__actions">' +
            '<button type="button" class="helix-confirm-btn helix-confirm-btn--yes" ' +
            'data-run-suggested-tool="' + escapeHtml(item.tool) + '" data-run-suggested-params="' + paramsJson + '" data-confirm-card="' + cardId + '">' +
            '<i class="fas fa-check" aria-hidden="true"></i> ' + escapeHtml(item.confirm_label || 'Confirmar') + '</button>' +
            '<button type="button" class="helix-confirm-btn helix-confirm-btn--no" data-cancel-card="' + cardId + '">' +
            escapeHtml(item.cancel_label || 'Agora não') + '</button>' +
            '</div></div>';
    }

    /**
     * Botões "Executar" sugeridos pela camada de intenção (LegalIntentDetector) junto
     * com a resposta da Sasha — a IA responde em texto, e ao lado disso o sistema já
     * oferece a ação determinística (calcular prazo, honorários, analisar carteira…)
     * pronta para rodar com um clique, sem depender do serviço de IA estar disponível.
     */
    function renderSuggestedActions(actions) {
        if (!actions || !actions.length) return '';
        var html = '<div class="helix-tool-actions mt-2">';
        actions.forEach(function (a) {
            if (!a || !a.tool) return;
            var paramsJson = escapeHtml(JSON.stringify(a.params || {}));
            html += '<button type="button" class="helix-tool-action-btn helix-tool-action-btn--primary" ' +
                'data-run-suggested-tool="' + escapeHtml(a.tool) + '" data-run-suggested-params="' + paramsJson + '">' +
                '<i class="fas fa-bolt" aria-hidden="true"></i> ' + escapeHtml(a.label || 'Executar') + '</button>';
        });
        html += '</div>';
        return html;
    }

    function runHelixTool(toolName, params, confirmCardId) {
        var base = panel.dataset.sashaToolsUrl || '';
        if (!base) {
            console.error('[Helix] sashaToolsUrl não definido');
            return;
        }
        var url = base.replace(/\/$/, '') + '/' + encodeURIComponent(toolName);
        console.log('[Helix] Executando ferramenta:', toolName, 'Params:', params, 'URL:', url);
        
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin',
            body: JSON.stringify(params || {})
        })
            .then(function (r) {
                console.log('[Helix] Response status:', r.status);
                if (!r.ok) {
                    throw new Error('HTTP ' + r.status);
                }
                return r.json();
            })
            .then(function (data) {
                console.log('[Helix] Tool result:', data);
                var sid = ensureSession();
                var session = getSession(sid);
                if (!session) return;
                markCardState(session, confirmCardId, 'done');
                session.messages.push({
                    role: 'assistant',
                    text: data.summary || 'Ação concluída.',
                    at: new Date().toISOString(),
                    actionsHtml: renderToolActions(data.results)
                });
                session.updatedAt = new Date().toISOString();
                upsertSession(session);
                renderMessages(session);
                renderHistory();
            })
            .catch(function (err) {
                console.error('[Helix] Tool execution failed:', err);
                var sid2 = ensureSession();
                var session2 = getSession(sid2);
                if (session2) {
                    markCardState(session2, confirmCardId, null);
                    upsertSession(session2);
                    renderMessages(session2);
                }
                sendMessage('Não consegui executar a ação agora. Erro: ' + err.message);
            });
    }

    /**
     * Guarda, dentro da própria sessão, o desfecho de um cartão de confirmação
     * (feito, cancelado ou de volta ao normal) — assim ele nunca "reaparece"
     * clicável depois de um novo render da conversa.
     */
    function markCardState(session, cardId, state) {
        if (!cardId || !session) return;
        session.cardStates = session.cardStates || {};
        if (state) {
            session.cardStates[cardId] = state;
        } else {
            delete session.cardStates[cardId];
        }
    }

    function applyCardStates(session) {
        if (!messagesEl || !session || !session.cardStates) return;
        Object.keys(session.cardStates).forEach(function (id) {
            var card = document.getElementById(id);
            if (!card) return;
            var state = session.cardStates[id];
            card.classList.remove('is-loading');
            if (state === 'done') {
                card.classList.add('is-done');
                card.innerHTML = '<div class="helix-confirm-done"><i class="fas fa-circle-check" aria-hidden="true"></i> Feito — já providenciei isso pra você.</div>';
            } else if (state === 'cancelled') {
                card.classList.add('is-dismissed');
                card.innerHTML = '<div class="helix-confirm-dismissed"><i class="fas fa-circle-check" aria-hidden="true"></i> Tudo bem, não fiz nada.</div>';
            }
        });
    }

    function renderMessagesWithActions(session) {
        renderMessages(session);
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function assistantReplyFallback() {
        return 'Não consegui contactar a ' + assistantName() + ' agora. Sua mensagem foi salva — tente novamente em instantes.';
    }

    function sendMessage(text) {
        text = (text || '').trim();

        var hasAttachments = typeof HelixAttachments !== 'undefined' && HelixAttachments.hasPending();
        if (!text && !hasAttachments) return;
        if (helixRequestInFlight) return;

        if (hasAttachments && HelixAttachments.isBusy()) {
            if (typeof HelixFeatures !== 'undefined') {
                HelixFeatures.showToast('Aguarde o processamento do(s) anexo(s)…', 'error');
            }
            return;
        }

        var attachmentSuffix = hasAttachments ? HelixAttachments.buildMessageSuffix() : '';
        var attachmentMeta = hasAttachments ? HelixAttachments.getReadySnapshot() : [];
        if (!text && attachmentSuffix) {
            text = 'Analise o(s) documento(s) anexado(s).';
        }
        var textToSend = text + attachmentSuffix;

        var sid = ensureSession();
        var session = getSession(sid);
        if (!session) return;

        session.messages.push({
            role: 'user',
            text: text,
            attachments: attachmentMeta,
            at: new Date().toISOString()
        });
        if (session.title === 'Nova conversa') {
            session.title = text.length > 48 ? text.slice(0, 48) + '…' : text;
        }
        session.updatedAt = new Date().toISOString();
        upsertSession(session);
        renderMessages(session);
        renderHistory();

        if (input) {
            input.value = '';
            input.style.height = '';
        }
        if (hasAttachments) {
            HelixAttachments.clear();
        }
        updateSendState();

        var chatUrl = panel.dataset.sashaChatUrl || '';
        if (!chatUrl) {
            session.messages.push({ role: 'assistant', text: assistantReplyFallback(), at: new Date().toISOString() });
            upsertSession(session);
            renderMessages(session);
            renderHistory();
            return;
        }

        var history = session.messages.slice(0, -1).map(function (m) {
            return { role: m.role, content: m.text };
        });

        setHelixLoading(true);
        showTypingIndicator();
        
        // Usar HelixTyping se disponível
        if (typeof HelixTyping !== 'undefined') {
            HelixTyping.show();
        }

        // Enviar conversation_id se existir
        var payload = {
            message: textToSend,
            history: history,
            mode: isLexMode() ? 'superior' : 'standard',
            context: {
                hub: document.body.dataset.activeHub || document.querySelector('[data-sidebar-hubs]')?.dataset.activeHub || '',
                patient_codigo: document.body.dataset.patientCodigo || null,
                numero_processo: document.body.dataset.processoNumero || null,
                mode: isLexMode() ? 'superior' : 'standard'
            }
        };
        
        // Se session tem conversation_id, incluir no payload
        if (session.conversationId) {
            payload.conversation_id = session.conversationId;
        }
        
        fetch(chatUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                // Salvar conversation_id retornado pelo backend
                if (data.conversation_id && !session.conversationId) {
                    session.conversationId = data.conversation_id;
                    if (typeof HelixHistory !== 'undefined') {
                        HelixHistory.setCurrentConversationId(data.conversation_id);
                        HelixHistory.loadConversations();
                    }
                }
                
                var actionsHtml = (renderToolActions(data.tool_results) || '') + (renderSuggestedActions(data.suggested_actions) || '');
                session.messages.push({
                    role: 'assistant',
                    text: data.reply || assistantReplyFallback(),
                    at: new Date().toISOString(),
                    actionsHtml: actionsHtml
                });
                session.updatedAt = new Date().toISOString();
                upsertSession(session);
                renderMessages(session);
                renderHistory();
            })
            .catch(function () {
                session.messages.push({ role: 'assistant', text: assistantReplyFallback(), at: new Date().toISOString() });
                session.updatedAt = new Date().toISOString();
                upsertSession(session);
                renderMessages(session);
                renderHistory();
            })
            .finally(function () {
                hideTypingIndicator();
                if (typeof HelixTyping !== 'undefined') {
                    HelixTyping.hide();
                }
                setHelixLoading(false);
                updateSendState();
            });
    }

    function renderHistory() {
        // Se HelixHistory disponível, usar a API do banco
        if (typeof HelixHistory !== 'undefined') {
            HelixHistory.loadConversations();
            return;
        }
        
        // Fallback: histórico local
        var sessions = loadSessions();
        var count = String(sessions.length);
        if (historyCount) historyCount.textContent = count;
        if (historyToggleCount) {
            historyToggleCount.textContent = count;
            historyToggleCount.setAttribute('data-count', count);
        }
        if (!historyList || !historyEmpty) return;

        historyList.innerHTML = '';
        if (!sessions.length) {
            historyEmpty.style.display = '';
            return;
        }
        historyEmpty.style.display = 'none';

        sessions.forEach(function (s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'helix-history-item' + (s.id === currentSessionId ? ' helix-history-item--active' : '');
            btn.dataset.sessionId = s.id;
            btn.innerHTML =
                '<span class="helix-history-item-title">' + escapeHtml(s.title || 'Conversa') + '</span>' +
                '<span class="helix-history-item-date">' + escapeHtml(formatDate(s.updatedAt)) + '</span>' +
                '<span class="helix-history-item__actions">' +
                    '<span class="helix-history-action helix-history-action--pin" title="Fixar" aria-hidden="true"></span>' +
                    '<span class="helix-history-action helix-history-action--delete" title="Excluir" aria-hidden="true"></span>' +
                '</span>';
            historyList.appendChild(btn);
        });
    }

    function prepareDockLaunchOrigin() {
        var drawer = panel.querySelector('.helix-drawer');
        if (!drawer || isStudio || mobileMq.matches) {
            return;
        }
        var btnRect = openBtn.getBoundingClientRect();
        var vw = window.innerWidth || document.documentElement.clientWidth;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var destX = vw / 2;
        var destY = vh / 2;
        var srcX = btnRect.left + (btnRect.width / 2);
        var srcY = btnRect.top + (btnRect.height / 2);
        var scale = Math.max(0.06, Math.min(0.2, btnRect.width / Math.min(960, vw - 32)));
        drawer.style.setProperty('--helix-from-x', (srcX - destX) + 'px');
        drawer.style.setProperty('--helix-from-y', (srcY - destY) + 'px');
        drawer.style.setProperty('--helix-from-s', String(scale));
    }

    function openPanel() {
        if (!isStudio) setHistoryOpen(false);
        panel.classList.remove('is-closing');
        prepareDockLaunchOrigin();
        openBtn.classList.remove('is-active');
        openBtn.classList.add('is-launching');
        window.setTimeout(function () {
            openBtn.classList.remove('is-launching');
            if (panel.classList.contains('is-open') && !panel.classList.contains('is-closing')) {
                openBtn.classList.add('is-active');
            }
        }, 420);
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
        openBtn.setAttribute('aria-expanded', 'true');
        document.body.classList.add('helix-open');
        
        setTimeout(function () {
            if (input) {
                growHelixInput();
                input.focus();
            }
        }, 280);
        renderHistory();
    }

    function closePanel() {
        if (isStudio) {
            if (studioExitUrl) {
                window.location.href = studioExitUrl;
            }
            return;
        }
        setHistoryOpen(false);
        prepareDockLaunchOrigin();
        panel.classList.add('is-closing');
        openBtn.setAttribute('aria-expanded', 'false');
        openBtn.classList.remove('is-active');
        window.setTimeout(function () {
            panel.classList.remove('is-open');
            panel.classList.remove('is-closing');
            panel.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('helix-open');
        }, 420);
    }

    function newChat() {
        currentSessionId = null;
        // Usa resetCurrentConversation (não newConversation) para evitar recursão:
        // newConversation() chama window.helixClearChat, que é esta própria função.
        if (typeof HelixHistory !== 'undefined') {
            HelixHistory.resetCurrentConversation();
        }
        renderWelcomeOnly();
        renderHistory();
        closeHistoryIfMobile();
        if (input) {
            input.value = '';
            input.style.height = '';
            updateSendState();
            input.focus();
        }
    }

    function loadSession(id) {
        var session = getSession(id);
        if (!session) return;
        currentSessionId = id;
        renderMessages(session);
        renderHistory();
        closeHistoryIfMobile();
    }

    function updateSendState() {
        if (!sendBtn || !input) return;
        if (helixRequestInFlight) {
            sendBtn.disabled = true;
            return;
        }
        var hasAttachment = typeof HelixAttachments !== 'undefined' && HelixAttachments.hasPending();
        sendBtn.disabled = !input.value.trim() && !hasAttachment;
    }
    window.helixUpdateSendState = updateSendState;

    /* Recalcula a altura do textarea a partir do conteúdo atual — precisa ser
       chamada tanto ao digitar quanto sempre que o valor é definido via JS
       (sugestões/chips, histórico, prompts externos), senão o campo fica
       "preso" na altura de 1 linha e o texto some atrás de scroll interno. */
    function growHelixInput() {
        if (!input) return;
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 160) + 'px';
    }

    openBtn.addEventListener('click', function () {
        if (isStudio) {
            openPanel();
            return;
        }
        if (panel.classList.contains('is-open')) closePanel();
        else openPanel();
    });

    panel.querySelectorAll('[data-helix-close]').forEach(function (el) {
        el.addEventListener('click', closePanel);
    });

    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            sendMessage(input ? input.value : '');
        });
    }

    if (input) {
        input.addEventListener('input', function () {
            growHelixInput();
            updateSendState();
        });
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                form.dispatchEvent(new Event('submit', { cancelable: true }));
            }
        });
    }

    document.getElementById('helixNewChat')?.addEventListener('click', newChat);

    historyToggle?.addEventListener('click', function () {
        setHistoryOpen(!panel.classList.contains('is-history-open'));
    });

    document.getElementById('helixClearHistory')?.addEventListener('click', function () {
        if (!confirm('Excluir todo o histórico de conversas com ' + assistantName() + '? Esta ação não pode ser desfeita.')) return;
        saveSessions([]);
        currentSessionId = null;
        if (typeof HelixHistory !== 'undefined') {
            HelixHistory.deleteAllConversations();
        }
        newChat();
    });

    if (historyList) {
        historyList.addEventListener('click', function (e) {
            var item = e.target.closest('.helix-history-item');
            if (!item) return;
            loadSession(item.dataset.sessionId);
        });
    }

    panel.querySelectorAll('[data-helix-tool]').forEach(function (chip) {
        chip.addEventListener('click', function () {
            var params = {};
            if (chip.dataset.helixToolQuery) params.query = chip.dataset.helixToolQuery;
            runHelixTool(chip.dataset.helixTool, params);
        });
    });

    if (messagesEl) {
        messagesEl.addEventListener('click', function (e) {
            var cancelBtn = e.target.closest('[data-cancel-card]');
            if (cancelBtn) {
                var cardId = cancelBtn.dataset.cancelCard;
                var card = document.getElementById(cardId);
                if (card) {
                    card.classList.add('is-dismissed');
                    card.innerHTML = '<div class="helix-confirm-dismissed"><i class="fas fa-circle-check" aria-hidden="true"></i> Tudo bem, não fiz nada.</div>';
                }
                var sid = ensureSession();
                var session = getSession(sid);
                if (session) {
                    markCardState(session, cardId, 'cancelled');
                    upsertSession(session);
                }
                return;
            }

            var btn = e.target.closest('[data-run-suggested-tool]');
            if (!btn) return;
            
            console.log('[Helix] Botão de ação sugerida clicado:', btn.dataset.runSuggestedTool);
            
            var params = {};
            try {
                params = JSON.parse(btn.dataset.runSuggestedParams || '{}');
            } catch (err) {
                console.error('[Helix] Erro ao parsear params:', err);
                params = {};
            }

            var confirmCardId = btn.dataset.confirmCard || null;
            var confirmCard = confirmCardId ? document.getElementById(confirmCardId) : null;
            if (confirmCard) {
                confirmCard.classList.add('is-loading');
                confirmCard.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
                var icon = btn.querySelector('i');
                if (icon) icon.className = 'fas fa-spinner fa-spin';
            } else {
                // Feedback visual para botões sem card de confirmação
                btn.disabled = true;
                var btnIcon = btn.querySelector('i');
                if (btnIcon) {
                    btnIcon.className = 'fas fa-spinner fa-spin';
                }
                btn.style.opacity = '0.7';
            }
            
            runHelixTool(btn.dataset.runSuggestedTool, params, confirmCardId);
        });
    }

    panel.querySelectorAll('[data-helix-prompt]').forEach(function (chip) {
        chip.addEventListener('click', function () {
            if (chip.classList.contains('helix-studio-action--lex')) {
                setLexMode(true);
            }
            if (input) input.value = chip.dataset.helixPrompt || '';
            growHelixInput();
            updateSendState();
            input.focus();
        });
    });

    function openHelixWithPrompt(prompt) {
        if (!panel.classList.contains('is-open')) {
            openBtn?.click();
        }
        if (input && prompt) {
            input.value = prompt;
            growHelixInput();
            updateSendState();
            input.focus();
        }
    }

    document.querySelectorAll('.js-unio-open-helix').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            openBtn?.click();
        });
    });

    document.querySelectorAll('.js-helix-prompt').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            openHelixWithPrompt(link.dataset.helixPrompt || '');
        });
    });

    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' || !panel.classList.contains('is-open')) return;
        if (panel.classList.contains('is-history-open')) {
            setHistoryOpen(false);
            return;
        }
        if (isStudio) return;
        closePanel();
    });

    renderHistory();
    updateSendState();
    growHelixInput();
    window.addEventListener('resize', growHelixInput);

    if (isStudio) {
        openPanel();
        try {
            var bootEl = document.getElementById('sashaStudioBoot');
            if (bootEl) JSON.parse(bootEl.textContent || '{}');
        } catch (e) { /* ignore */ }
        var anchor = document.getElementById('sashaStudioAnchor');
        if (anchor) {
            try { anchor.focus({ preventScroll: true }); } catch (e2) { anchor.focus(); }
        }
    }
    
    // Expor funções para os módulos externos
    window.helixScrollToBottom = scrollMessages;
    window.helixRenderHistory = function(messages, conversationId) {
        // Sempre substitui a sessão atual pela conversa selecionada no histórico,
        // independente de já existir uma sessão ativa (corrige clique no histórico
        // não fazendo nada quando o usuário já estava numa conversa).
        var msgs = (messages || []).map(function(m) {
            return {
                role: m.role,
                text: m.content,
                at: m.created_at || new Date().toISOString()
            };
        });
        var title = 'Conversa';
        var firstUser = msgs.find(function(m) { return m.role === 'user'; });
        if (firstUser && firstUser.text) {
            title = firstUser.text.length > 48 ? firstUser.text.slice(0, 48) + '…' : firstUser.text;
        }
        var session = {
            id: uid(),
            title: title,
            createdAt: (msgs[0] && msgs[0].at) || new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            messages: msgs,
            conversationId: conversationId || null
        };
        upsertSession(session);
        currentSessionId = session.id;
        renderMessages(session);
        if (suggestions) suggestions.style.display = msgs.length ? 'none' : '';
        closeHistoryIfMobile();
        scrollMessages();
    };
    window.helixClearChat = newChat;
    window.helixResendMessage = sendMessage;
    window.helixAssistantName = assistantName();
})();
</script>
