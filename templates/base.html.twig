<script>
(function () {
    'use strict';
    var scrollEl = document.querySelector('.app-page-scroll');
    var chromeEl = document.querySelector('.app-page-chrome');
    if (!scrollEl) return;

    function findScrollTarget() {
        if (scrollEl.scrollHeight > scrollEl.clientHeight + 1) {
            return scrollEl;
        }
        var inner = scrollEl.querySelector('.chat-messages, .chat-colleague-list, .empty-state-panel .empty-state');
        return inner || scrollEl;
    }

    var scrollTarget = findScrollTarget();

    function syncPageScrollChrome() {
        var scrolled = scrollTarget.scrollTop > 2;
        scrollEl.classList.toggle('is-scrolled', scrolled);
        if (chromeEl) {
            chromeEl.classList.toggle('is-scrolled-below', scrolled);
        }
    }

    scrollTarget.addEventListener('scroll', syncPageScrollChrome, { passive: true });
    syncPageScrollChrome();
})();
</script>
