<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Huplex{% endblock %} | Huplex</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <style>
        /* ══════════════════════════════════════════
           TOKENS — Dark (padrão)
        ══════════════════════════════════════════ */
        :root,
        [data-theme="dark"] {
            --accent:       #4F7FFF;
            --accent-dim:   rgba(79,127,255,0.1);
            --accent-line:  rgba(79,127,255,0.18);
            --bg:           #080A12;
            --sidebar-bg:   #060810;
            --surface:      #0D0F1A;
            --surface-2:    #111424;
            --border:       rgba(255,255,255,0.06);
            --border-2:     rgba(255,255,255,0.1);
            --text-1:       #E2E4EA;
            --text-2:       rgba(226,228,234,0.5);
            --text-3:       rgba(226,228,234,0.24);
            --nav-hover-bg: rgba(255,255,255,0.04);
            --nav-active-bg:rgba(79,127,255,0.1);
            --shadow:       0 4px 24px rgba(0,0,0,0.4);
            --dropdown-bg:  #0D0F1A;
        }

        /* ══════════════════════════════════════════
           TOKENS — Light
        ══════════════════════════════════════════ */
        [data-theme="light"] {
            --accent:       #3D6FFF;
            --accent-dim:   rgba(61,111,255,0.08);
            --accent-line:  rgba(61,111,255,0.18);
            --bg:           #F2F4F8;
            --sidebar-bg:   #FFFFFF;
            --surface:      #FFFFFF;
            --surface-2:    #F7F8FC;
            --border:       rgba(0,0,0,0.07);
            --border-2:     rgba(0,0,0,0.12);
            --text-1:       #111827;
            --text-2:       rgba(17,24,39,0.55);
            --text-3:       rgba(17,24,39,0.3);
            --nav-hover-bg: rgba(0,0,0,0.04);
            --nav-active-bg:rgba(61,111,255,0.08);
            --shadow:       0 4px 24px rgba(0,0,0,0.08);
            --dropdown-bg:  #FFFFFF;
        }

        * { box-sizing: border-box; }
        body, .wrapper { font-family: 'Inter', sans-serif !important; background: var(--bg) !important; }

        /* ══════════════════════════════════════════
           NAVBAR
        ══════════════════════════════════════════ */
        .main-header.navbar {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border) !important;
            box-shadow: none !important;
            padding: 0 16px !important;
            height: 54px;
        }

        .main-header .navbar-nav .nav-link { color: var(--text-2) !important; padding: 0 !important; }

        [data-widget="pushmenu"] {
            width: 34px; height: 34px;
            border-radius: 7px;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            color: var(--text-2) !important;
            transition: background 0.15s;
        }
        [data-widget="pushmenu"]:hover { background: var(--nav-hover-bg) !important; }
        [data-widget="pushmenu"] i { font-size: 13px; }

        /* workspace pill */
        .ws-pill {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 5px 10px;
            border: 1px solid var(--border-2);
            border-radius: 8px;
            background: var(--surface-2);
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
            text-decoration: none !important;
            max-width: 180px;
        }
        .ws-pill:hover { border-color: var(--accent-line); background: var(--accent-dim); }
        .ws-pill .ws-logo {
            width: 22px; height: 22px;
            border-radius: 5px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-line);
            display: flex; align-items: center; justify-content: center;
            font-size: 9px; font-weight: 700; color: var(--accent);
            flex-shrink: 0;
        }
        .ws-pill .ws-name {
            font-size: 12px; font-weight: 500;
            color: var(--text-1);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .ws-pill .ws-caret { font-size: 8px; color: var(--text-3); flex-shrink: 0; }

        /* theme toggle */
        .theme-btn {
            width: 34px; height: 34px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: var(--surface-2);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            color: var(--text-2);
            font-size: 13px;
            transition: all 0.15s;
        }
        .theme-btn:hover { border-color: var(--border-2); color: var(--text-1); }

        /* user pill */
        .user-pill {
            display: flex; align-items: center; gap: 8px;
            padding: 4px 4px 4px 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface-2);
            cursor: pointer;
            transition: border-color 0.15s;
            text-decoration: none !important;
        }
        .user-pill:hover { border-color: var(--border-2); }
        .user-pill .u-name { font-size: 12px; font-weight: 500; color: var(--text-1); }
        .user-pill .u-role { font-size: 10px; color: var(--text-3); }

        .avatar-sm {
            width: 28px; height: 28px;
            border-radius: 7px;
            background: var(--accent-dim);
            border: 1px solid var(--accent-line);
            display: flex; align-items: center; justify-content: center;
            color: var(--accent); font-size: 10px; font-weight: 700; flex-shrink: 0;
        }
        .avatar-circle {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--accent-dim);
            border: 1px solid var(--accent-line);
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--accent); font-size: 12px; font-weight: 700;
        }

        /* dropdown */
        .huplex-dropdown {
            background: var(--dropdown-bg) !important;
            border: 1px solid var(--border-2) !important;
            border-radius: 10px !important;
            box-shadow: var(--shadow) !important;
            padding: 6px !important;
            min-width: 200px;
        }
        .huplex-dropdown .dd-head {
            padding: 8px 10px 10px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 4px;
        }
        .huplex-dropdown .dd-item {
            display: flex; align-items: center; gap: 9px;
            padding: 7px 10px;
            border-radius: 7px;
            font-size: 13px;
            color: var(--text-2);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.12s, color 0.12s;
        }
        .huplex-dropdown .dd-item:hover { background: var(--nav-hover-bg); color: var(--text-1); }
        .huplex-dropdown .dd-item.danger { color: rgba(220,80,80,0.75); }
        .huplex-dropdown .dd-item.danger:hover { background: rgba(220,80,80,0.07); color: rgba(220,80,80,0.9); }
        .huplex-dropdown .dd-item i { width: 14px; font-size: 12px; color: var(--text-3); }
        .huplex-dropdown .dd-item.danger i { color: inherit; }
        .huplex-dropdown .dd-sep { height: 1px; background: var(--border); margin: 5px 0; }

        /* ws dropdown items */
        .ws-option {
            display: flex; align-items: center; gap: 9px;
            padding: 7px 10px; border-radius: 7px;
            text-decoration: none; transition: background 0.12s;
        }
        .ws-option:hover { background: var(--nav-hover-bg); }
        .ws-option.active-ws { background: var(--accent-dim); }
        .ws-option .wo-logo {
            width: 30px; height: 30px; border-radius: 7px;
            background: var(--accent-dim); border: 1px solid var(--accent-line);
            display: flex; align-items: center; justify-content: center;
            font-size: 10px; font-weight: 700; color: var(--accent); flex-shrink: 0;
        }
        .ws-option .wo-name { font-size: 12px; font-weight: 500; color: var(--text-1); line-height: 1.3; }
        .ws-option .wo-sub  { font-size: 10px; color: var(--text-3); }

        /* ══════════════════════════════════════════
           SIDEBAR
        ══════════════════════════════════════════ */
        .main-sidebar {
            background: var(--sidebar-bg) !important;
            border-right: 1px solid var(--border) !important;
            box-shadow: none !important;
            width: 224px !important;
        }

        .brand-link {
            background: var(--sidebar-bg) !important;
            border-bottom: 1px solid var(--border) !important;
            padding: 13px 16px !important;
            height: 54px;
            display: flex !important;
            align-items: center !important;
        }
        .brand-text {
            font-size: 15px !important; font-weight: 700 !important;
            color: var(--text-1) !important; letter-spacing: -0.02em;
        }
        .brand-text .accent { color: var(--accent); }
        .brand-text .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; margin: 0 1px 1px; }

        /* nav section headers */
        .nav-header {
            font-size: 9.5px !important;
            font-weight: 600 !important;
            letter-spacing: 0.09em !important;
            text-transform: uppercase !important;
            color: var(--text-3) !important;
            padding: 18px 16px 5px !important;
        }

        /* nav items */
        .nav-sidebar .nav-item .nav-link {
            display: flex !important;
            align-items: center !important;
            gap: 9px !important;
            margin: 1px 8px !important;
            padding: 6px 10px !important;
            border-radius: 7px !important;
            color: var(--text-2) !important;
            font-size: 12.5px !important;
            font-weight: 500 !important;
            border: none !important;
            transition: background 0.12s, color 0.12s !important;
            white-space: nowrap;
        }
        .nav-sidebar .nav-item .nav-link:hover {
            background: var(--nav-hover-bg) !important;
            color: var(--text-1) !important;
        }
        .nav-sidebar .nav-item .nav-link.active {
            background: var(--nav-active-bg) !important;
            color: var(--accent) !important;
        }

        /* icon slot */
        .nav-sidebar .nav-link .nav-icon {
            font-size: 12px !important;
            width: 14px !important;
            min-width: 14px !important;
            text-align: center !important;
            color: var(--text-3) !important;
            transition: color 0.12s !important;
        }
        .nav-sidebar .nav-link:hover .nav-icon { color: var(--text-2) !important; }
        .nav-sidebar .nav-link.active .nav-icon { color: var(--accent) !important; }

        /* treeview indent */
        .nav-treeview { padding-left: 0 !important; }
        .nav-treeview .nav-link {
            padding-left: 33px !important;
            font-size: 12px !important;
            color: var(--text-3) !important;
        }
        .nav-treeview .nav-link:hover { color: var(--text-1) !important; }
        .nav-treeview .nav-link.active { color: var(--accent) !important; }
        .nav-treeview .nav-link .nav-icon { font-size: 10px !important; }

        /* chevron arrow */
        .nav-sidebar .nav-link .right {
            font-size: 9px !important;
            margin-left: auto !important;
            color: var(--text-3) !important;
            transition: transform 0.2s, color 0.12s !important;
        }
        .nav-sidebar .menu-open > .nav-link .right { transform: rotate(-90deg); color: var(--text-2) !important; }

        /* sidebar bottom — user snippet */
        .sidebar-footer {
            position: absolute; bottom: 0; left: 0; right: 0;
            padding: 12px 10px;
            border-top: 1px solid var(--border);
            background: var(--sidebar-bg);
            display: flex; align-items: center; gap: 9px;
        }
        .sidebar-footer .sf-info .sf-name { font-size: 12px; font-weight: 600; color: var(--text-1); line-height: 1.2; }
        .sidebar-footer .sf-info .sf-role { font-size: 10px; color: var(--text-3); }
        .sidebar-footer .sf-logout {
            margin-left: auto; width: 28px; height: 28px;
            border-radius: 7px; border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            color: var(--text-3); font-size: 12px; cursor: pointer;
            transition: all 0.12s; flex-shrink: 0; text-decoration: none;
        }
        .sidebar-footer .sf-logout:hover { border-color: rgba(220,80,80,0.3); color: rgba(220,80,80,0.7); background: rgba(220,80,80,0.06); }

        /* ══════════════════════════════════════════
           CONTENT
        ══════════════════════════════════════════ */
        .content-wrapper { background: var(--bg) !important; }

        .content-header {
            padding: 16px 20px 0 !important;
            background: var(--bg) !important;
        }
        .content-header h1 {
            font-size: 18px; font-weight: 700;
            color: var(--text-1); letter-spacing: -0.02em;
        }
        .breadcrumb { background: transparent !important; margin-bottom: 0 !important; padding: 0 !important; }
        .breadcrumb-item a, .breadcrumb-item.active, .breadcrumb-item + .breadcrumb-item::before {
            color: var(--text-3) !important; font-size: 12px;
        }

        /* ══════════════════════════════════════════
           CARDS
        ══════════════════════════════════════════ */
        .huplex-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px; padding: 20px;
            transition: border-color 0.15s;
        }
        .huplex-card:hover { border-color: var(--accent-line); }
        .card-value { color: var(--text-1); font-size: 28px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
        .card-label { color: var(--text-3); font-size: 11.5px; margin-top: 2px; }
        .card-icon {
            width: 38px; height: 38px; border-radius: 9px;
            background: var(--accent-dim); border: 1px solid var(--accent-line);
            display: flex; align-items: center; justify-content: center;
            color: var(--accent); font-size: 14px; flex-shrink: 0;
        }
        .section-title { color: var(--text-1); font-size: 15px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 2px; }
        .section-subtitle { color: var(--text-3); font-size: 12px; }

        /* module card */
        .module-card {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 9px; padding: 13px 15px;
            transition: border-color 0.15s, background 0.15s;
        }
        .module-card:hover { border-color: var(--accent-line); background: var(--accent-dim); }

        /* ══════════════════════════════════════════
           BADGES
        ══════════════════════════════════════════ */
        .badge-perfil {
            display: inline-block; font-size: 9.5px; font-weight: 600;
            letter-spacing: 0.05em; text-transform: uppercase;
            padding: 2px 8px; border-radius: 100px;
            background: var(--accent-dim); color: var(--accent); border: 1px solid var(--accent-line);
        }
        .badge-perfil.tenant            { background: rgba(120,100,220,0.1); color: rgba(160,140,255,0.85); border-color: rgba(120,100,220,0.2); }
        .badge-perfil.admin             { background: rgba(200,70,70,0.08);  color: rgba(220,110,110,0.85); border-color: rgba(200,70,70,0.18); }
        .badge-perfil.gestor            { background: rgba(180,150,40,0.08); color: rgba(210,185,90,0.85);  border-color: rgba(180,150,40,0.18); }
        .badge-perfil.gestor-equipe     { background: rgba(190,120,50,0.08); color: rgba(215,160,90,0.85);  border-color: rgba(190,120,50,0.18); }
        .badge-perfil.supervisor        { background: rgba(50,160,100,0.08); color: rgba(90,190,140,0.85);  border-color: rgba(50,160,100,0.18); }
        .badge-perfil.supervisor-equipe { background: rgba(40,150,200,0.08); color: rgba(80,185,225,0.85);  border-color: rgba(40,150,200,0.18); }
        .badge-perfil.membro            { background: rgba(120,130,150,0.07); color: rgba(160,170,190,0.7);  border-color: rgba(120,130,150,0.14); }

        /* ══════════════════════════════════════════
           TABLE
        ══════════════════════════════════════════ */
        .table-huplex { color: var(--text-2) !important; }
        .table-huplex thead th {
            background: var(--surface-2) !important; color: var(--text-3) !important;
            font-size: 10.5px !important; font-weight: 600 !important;
            letter-spacing: 0.07em !important; text-transform: uppercase !important;
            border-color: var(--border) !important; padding: 10px 16px !important;
        }
        .table-huplex td { border-color: var(--border) !important; padding: 10px 16px !important; vertical-align: middle !important; font-size: 13px !important; }
        .table-huplex tbody tr:hover td { background: var(--nav-hover-bg) !important; }

        /* ══════════════════════════════════════════
           BUTTONS
        ══════════════════════════════════════════ */
        .btn-huplex { background: var(--accent); color: #fff; border: none; border-radius: 7px; padding: 7px 16px; font-size: 12.5px; font-weight: 600; transition: opacity 0.15s; }
        .btn-huplex:hover { opacity: 0.82; color: #fff; }
        .btn-huplex-ghost { background: transparent; color: var(--text-2); border: 1px solid var(--border-2); border-radius: 7px; padding: 6px 14px; font-size: 12.5px; font-weight: 500; transition: all 0.15s; }
        .btn-huplex-ghost:hover { color: var(--text-1); border-color: var(--border-2); background: var(--nav-hover-bg); }

        /* ══════════════════════════════════════════
           EMPTY STATE
        ══════════════════════════════════════════ */
        .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 52px 24px; text-align: center; }
        .empty-state .empty-icon { width: 52px; height: 52px; border-radius: 12px; background: var(--accent-dim); border: 1px dashed var(--accent-line); display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 18px; margin-bottom: 14px; }
        .empty-state h6 { color: var(--text-1); font-weight: 600; margin-bottom: 5px; }
        .empty-state p  { color: var(--text-3); font-size: 13px; }

        /* ══════════════════════════════════════════
           FOOTER
        ══════════════════════════════════════════ */
        .main-footer { background: var(--bg) !important; border-top: 1px solid var(--border) !important; color: var(--text-3) !important; font-size: 11px !important; }

        /* AdminLTE overrides */
        .sidebar { padding-bottom: 64px; }
        .content-wrapper { margin-left: 224px !important; }
        .main-sidebar { width: 224px !important; }
        @media (max-width: 767px) { .content-wrapper { margin-left: 0 !important; } }

        /* Light theme - AdminLTE body bg */
        [data-theme="light"] body { background: var(--bg) !important; }
        [data-theme="light"] .main-sidebar { background: var(--sidebar-bg) !important; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    {# ══ NAVBAR ══ #}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light d-flex align-items-center">

        {# Hamburguer #}
        <a class="nav-link mr-3" data-widget="pushmenu" href="#" role="button">
            <i class="fa-regular fa-bars"></i>
        </a>

        {# Workspace switcher #}
        {% if empresas is defined and empresas|length > 0 %}
        <div class="nav-item dropdown mr-3">
            <a class="ws-pill nav-link" data-toggle="dropdown" href="#" id="wsDropdown">
                <span class="ws-logo">{{ empresa is defined and empresa ? empresa.nome|slice(0,2)|upper : 'WS' }}</span>
                <span class="ws-name">{{ empresa is defined and empresa ? empresa.nome : 'Workspace' }}</span>
                <i class="fa-solid fa-chevron-down ws-caret"></i>
            </a>
            <div class="dropdown-menu huplex-dropdown" style="min-width:220px">
                <div class="dd-head">
                    <div style="font-size:10px;color:var(--text-3);font-weight:600;text-transform:uppercase;letter-spacing:0.07em">Área de trabalho</div>
                </div>
                {% for emp in empresas %}
                <a href="{{ path('app_workspace_switch', {id: emp.id}) }}"
                   class="ws-option {% if empresa is defined and empresa and empresa.id == emp.id %}active-ws{% endif %}">
                    <span class="wo-logo">{{ emp.nome|slice(0,2)|upper }}</span>
                    <div>
                        <div class="wo-name">{{ emp.nome }}</div>
                        {% if emp.setor %}<div class="wo-sub">{{ emp.setor }}</div>{% endif %}
                    </div>
                    {% if empresa is defined and empresa and empresa.id == emp.id %}
                    <i class="fa-solid fa-check ml-auto" style="font-size:10px;color:var(--accent)"></i>
                    {% endif %}
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="ml-auto d-flex align-items-center" style="gap:8px">

            {# Theme toggle #}
            <button class="theme-btn" id="themeToggle" title="Alternar tema" onclick="toggleTheme()">
                <i class="fa-regular fa-sun" id="themeIcon"></i>
            </button>

            {# User dropdown #}
            <div class="nav-item dropdown">
                <a class="user-pill nav-link" data-toggle="dropdown" href="#">
                    <div style="line-height:1.2">
                        <div class="u-name">{{ app.user.nome }}</div>
                        <div class="u-role">{{ app.user.perfilLabel }}</div>
                    </div>
                    <div class="avatar-sm">{{ app.user.initials }}</div>
                </a>
                <div class="dropdown-menu dropdown-menu-right huplex-dropdown">
                    <div class="dd-head">
                        <div style="color:var(--text-1);font-size:13px;font-weight:600;line-height:1.3">{{ app.user.nome }}</div>
                        <div style="color:var(--text-3);font-size:11px;margin-top:1px">{{ app.user.email }}</div>
                        <div class="mt-2"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span></div>
                    </div>
                    <a class="dd-item" href="#">
                        <i class="fa-regular fa-user"></i> Meu Perfil
                    </a>
                    <a class="dd-item" href="#" onclick="toggleTheme();return false;">
                        <i class="fa-regular fa-circle-half-stroke" id="themeMenuIcon"></i>
                        <span id="themeMenuLabel">Tema Claro</span>
                    </a>
                    <div class="dd-sep"></div>
                    <a class="dd-item danger" href="{{ path('app_logout') }}">
                        <i class="fa-regular fa-arrow-right-from-bracket"></i> Sair
                    </a>
                </div>
            </div>
        </div>
    </nav>

    {# ══ SIDEBAR ══ #}
