{% extends 'base.html.twig' %}
{% block title %}Hub de Talentos{% endblock %}
{% block page_title %}Hub de Talentos{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Hub de Talentos</li>{% endblock %}
{% block content %}
<div class="row mb-4">
    {% for item in [
        { icon:'fas fa-database',     title:'Banco de Talentos', value:'0',  color:'#3D72FF' },
        { icon:'fas fa-briefcase',    title:'Vagas Abertas',     value:'0',  color:'#8b5cf6' },
        { icon:'fas fa-route',        title:'Trilhas Ativas',    value:'0',  color:'#eab308' },
        { icon:'fas fa-handshake',    title:'Mentorias Ativas',  value:'0',  color:'#22c55e' },
    ] %}
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="huplex-card d-flex align-items-center">
            <div class="card-icon" style="background:{{ item.color }}12;border-color:{{ item.color }}25;color:{{ item.color }}">
                <i class="{{ item.icon }}"></i>
            </div>
            <div class="ml-3">
                <div class="card-value">{{ item.value }}</div>
                <div class="card-label">{{ item.title }}</div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="huplex-card h-100">
            <div class="section-title mb-1">Banco de Talentos</div>
            <div class="section-subtitle mb-4">Profissionais identificados para crescimento</div>
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-star"></i></div>
                <h6>Banco de talentos vazio</h6>
                <p>Identifique talentos a partir das avaliações de desempenho.</p>
                <a href="{{ path('app_talentos_banco') }}" class="btn-huplex mt-3">Gerenciar Talentos</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="huplex-card h-100">
            <div class="section-title mb-1">Trilhas de Carreira</div>
            <div class="section-subtitle mb-4">Planos de desenvolvimento individuais</div>
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-route"></i></div>
                <h6>Nenhuma trilha criada</h6>
                <p>Crie trilhas de carreira personalizadas para cada cargo.</p>
                <a href="{{ path('app_talentos_trilhas') }}" class="btn-huplex mt-3">Criar Trilha</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
