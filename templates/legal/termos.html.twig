{% extends 'legal/layout.html.twig' %}

{% set _legal_brand = platform_config.plataforma_nome|default('Unio Saúde') %}

{% block legal_title %}Termos de Uso{% endblock %}
{% block legal_heading %}Termos de Uso{% endblock %}

{% block legal_content %}
<p>
    Estes Termos de Uso regulam o acesso e a utilização da plataforma
    <strong>{{ _legal_brand }}</strong>
    (“Plataforma”), solução digital de gestão clínica e acompanhamento pós-operatório,
