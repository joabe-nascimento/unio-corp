{% set _tema = platform_config.tema|default('dark') %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block legal_title %}Documento legal{% endblock %} | {{ platform_config.plataforma_nome|default('Unio') }}</title>
    <script>try{var _t=localStorage.getItem('unio-theme')||'{{ _tema }}';document.documentElement.setAttribute('data-theme',_t);}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/legal-pages.css') }}?v=3">
</head>
<body class="legal-page">
{% include 'components/guest_theme_toggle.html.twig' %}

<div class="legal-page__wrap">
    <header class="legal-page__top">
        <a href="{{ path('app_home') }}" class="legal-page__back">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Voltar ao início
        </a>
        <div class="legal-page__hero">
            <div class="legal-page__logo">
                {% include 'components/platform_logo.html.twig' with {
                    variant: 'full',
                    class: 'legal-page__logo-img'
                } only %}
            </div>
            <h1>{% block legal_heading %}{% endblock %}</h1>
            <p class="legal-page__updated">Última atualização: {{ platform_config.legal_ultima_atualizacao|default("now"|date("d/m/Y")) }}</p>
        </div>
    </header>

    {% include 'legal/_operator_block.html.twig' %}

    <main>
        {% block legal_content %}{% endblock %}
    </main>

    <footer class="legal-page__foot">
        {% include 'components/platform_support.html.twig' %}
        {% include 'components/platform_legal.html.twig' with { variant: 'links' } %}
    </footer>
</div>

{% include 'components/cookie_consent_banner.html.twig' %}
<script src="{{ asset('js/unio-cookie-consent.js') }}?v=1" defer></script>
</body>
</html>
