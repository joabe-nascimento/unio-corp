{% extends 'emails/recrutamento/generic.html.twig' %}
{% block body %}
<p>Olá, {{ payload.candidato_nome }}!</p>
<p>Seu processo seletivo para <strong>{{ payload.vaga_titulo }}</strong> foi atualizado.</p>
<p><strong>Nova etapa:</strong> {{ payload.etapa_para }}</p>
{% if payload.etapa_de is defined %}
<p><em>Anterior:</em> {{ payload.etapa_de }}</p>
{% endif %}
<p>Em breve nossa equipe pode entrar em contato com mais detalhes.</p>
{% endblock %}
