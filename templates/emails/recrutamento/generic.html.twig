<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"></head>
<body style="font-family:sans-serif;background:#F1F5F9;margin:0;padding:20px;">
<div style="max-width:520px;margin:auto;background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.1);">
    <div style="background:#0F172A;color:#fff;padding:20px 24px;">
        <span style="font-size:13px;color:#94A3B8;">{{ payload.empresa_nome|default('Unio') }}</span>
        <h2 style="margin:4px 0 0;font-size:18px;">{{ assunto }}</h2>
    </div>
    <div style="padding:24px;color:#334155;font-size:15px;line-height:1.6;">
        {% block body %}
        <p>Olá, {{ payload.candidato_nome|default('') }}!</p>
        {% endblock %}
    </div>
    {% include 'emails/_legal_footer.html.twig' with {
        termos_url: absolute_url(path('app_legal_termos')),
        privacidade_url: absolute_url(path('app_legal_privacidade')),
        lgpd_url: absolute_url(path('app_legal_lgpd')),
    } %}
</div>
</body>
</html>
