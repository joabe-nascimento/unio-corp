<div style="background:#F8FAFC;padding:12px 24px;font-size:12px;color:#64748B;line-height:1.5;border-top:1px solid #E2E8F0;">
    <p style="margin:0 0 6px;">
        {{ platform_config.plataforma_nome|default('Unio') }}
        {% if platform_config.operadora_cnpj|default('')|trim %}
            · CNPJ {{ platform_config.operadora_cnpj|trim }}
        {% endif %}
    </p>
    <p style="margin:0;">
        <a href="{{ termos_url }}" style="color:#3D5AE8;text-decoration:none;">Termos de Uso</a>
        ·
        <a href="{{ privacidade_url }}" style="color:#3D5AE8;text-decoration:none;">Política de Privacidade</a>
        ·
        <a href="{{ lgpd_url }}" style="color:#3D5AE8;text-decoration:none;">Canal LGPD</a>
    </p>
    <p style="margin:8px 0 0;font-size:11px;color:#94A3B8;">
        Mensagem automática. Não responda este e-mail, salvo indicação em contrário.
    </p>
</div>
