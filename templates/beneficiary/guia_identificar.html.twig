{% extends 'beneficiary/layout.html.twig' %}

{% block benef_title %}Acessar guia médico{% endblock %}
{% block benef_product %}Guia médico{% endblock %}
{% set benef_nav_active = 'guia' %}
{% set _preview = demo_preview|default({}) %}

{% block benef_content %}
<section class="benef-shell benef-shell--split">
    <div class="benef-product-intro">
        <div class="benef-product-intro__access">
            <div class="benef-card">
                <header class="benef-card__head">
                    <div>
                        <h1>Seu guia médico</h1>
                        <p>Orientações da sua recuperação, lembretes e sinais de alerta — com acesso seguro por CPF ou código.</p>
                    </div>
                </header>

                {% for msg in app.flashes('error') %}
                <div class="benef-alert benef-alert--error" role="alert">{{ msg }}</div>
                {% endfor %}

                {% include 'beneficiary/_access_form_identify.html.twig' with { csrf_name: 'beneficiary_guia' } %}

                <details class="benef-demo-hint">
                    <summary>Ver dados de demonstração</summary>
                    <ul>
                        <li><strong>CPF:</strong> {{ demo_hints.cpf_masked }}</li>
                        <li><strong>Código:</strong> {{ demo_hints.codigo }}</li>
                        <li><strong>Carteirinha:</strong> {{ demo_hints.verificacao }}</li>
                    </ul>
                </details>
            </div>
        </div>

        <aside class="benef-product-intro__preview" aria-label="Prévia do que você verá após validar">
            {% include 'components/marketing/_patient_demo_embed_guia.html.twig' with {
                card: _preview.card|default({}),
                access: _preview.access|default({}),
                active_step: 1
            } %}
        </aside>
    </div>
</section>
{% endblock %}
