{% extends 'beneficiary/layout.html.twig' %}

{% block benef_title %}Comprovante de procedimento{% endblock %}
{% block benef_product %}Comprovante{% endblock %}
{% set benef_nav_active = 'comprovante' %}
{% set _preview = demo_preview|default({}) %}

{% block benef_content %}
<section class="benef-shell benef-shell--split">
    <div class="benef-product-intro">
        <div class="benef-product-intro__access">
            <div class="benef-card">
                <header class="benef-card__head">
                    <div>
                        <h1>Acessar comprovante</h1>
                        <p>Documento do seu procedimento com validação em duas etapas.</p>
                    </div>
                </header>

                {% for msg in app.flashes('error') %}
                <div class="benef-alert benef-alert--error" role="alert">{{ msg }}</div>
                {% endfor %}

                {% include 'beneficiary/_access_form_identify.html.twig' with {
                    csrf_name: 'beneficiary_comprovante',
                    form_action: path('app_comprovante_procedimento'),
                    verificacao_label: 'Código do comprovante'
                } %}

                <details class="benef-demo-hint">
                    <summary>Ver dados de demonstração</summary>
                    <ul>
                        <li><strong>CPF:</strong> {{ demo_hints.cpf_masked }}</li>
                        <li><strong>Código:</strong> {{ demo_hints.codigo }}</li>
                        <li><strong>Comprovante:</strong> {{ demo_hints.verificacao }}</li>
                    </ul>
                    <p class="benef-demo-hint__note">Use dois dados diferentes nos passos 1 e 2.</p>
                </details>
            </div>
        </div>

        <aside class="benef-product-intro__preview" aria-label="Prévia do comprovante">
            {% include 'components/marketing/_patient_demo_embed_comprovante.html.twig' with {
                card: _preview.card|default({}),
                theme: _preview.theme|default('profissional'),
                access: _preview.access|default({}),
                active_step: 1
            } %}
        </aside>
    </div>
</section>

<script src="{{ asset('js/marketing-carteirinha.js') }}?v=6" defer></script>
{% endblock %}
