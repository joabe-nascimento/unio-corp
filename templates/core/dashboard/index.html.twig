{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Dashboard</li>{% endblock %}

{% block content %}

{# ── Banner por perfil ── #}
{% if layout == 'admin' %}
    {% include 'components/page_banner.html.twig' with {
        icon: 'fa-shield-halved',
        title: 'Visão Administrativa' ~ (is_granted('ROLE_TENANT') ? ' · Multi-empresa' : ''),
        subtitle: 'Acesso total à plataforma' ~ (empresa ? ' — ' ~ empresa.nome : ''),
        use_empresa_logo: true
    } %}
{% elseif layout == 'gestor' %}
    {% include 'components/page_banner.html.twig' with {
        icon: 'fa-chart-pie',
        title: 'Visão do Gestor' ~ (empresa ? ' — ' ~ empresa.nome : ''),
        subtitle: 'Dados consolidados da empresa'
    } %}
{% elseif layout == 'supervisor' %}
    {% include 'components/page_banner.html.twig' with {
        icon: 'fa-user-group',
        title: 'Sua Equipe' ~ (empresa ? ' — ' ~ empresa.nome : ''),
        subtitle: 'Colaboradores sob sua supervisão'
    } %}
{% endif %}

{# ── Stats ── #}
<div class="row stats-row mb-2">
    {% if layout == 'admin' %}
        {% set cards = [
            {icon:'fa-users',          v: stats.funcionarios,  l:'Funcionários'},
            {icon:'fa-sitemap',        v: stats.departamentos, l:'Departamentos'},
            {icon:'fa-briefcase',      v: stats.vagas_abertas, l:'Vagas Abertas'},
            {icon:'fa-graduation-cap', v: stats.treinamentos,  l:'Treinamentos'},
            {icon:'fa-user-shield',    v: stats.usuarios,      l:'Usuários'},
            {icon:'fa-building',       v: stats.empresas,      l:'Empresas'},
        ] %}
        {% for c in cards %}
        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            {% include 'components/stat_card.html.twig' with { icon: c.icon, value: c.v, label: c.l } %}
        </div>
        {% endfor %}
    {% elseif layout == 'membro' %}
        <div class="col-12 mb-2">
            <div class="huplex-card d-flex align-items-center" style="gap:14px;min-height:86px;padding:16px 18px">
                <div class="avatar-circle" style="width:52px;height:52px;font-size:18px;border-radius:13px;flex-shrink:0">{{ app.user.initials }}</div>
                <div>
                    <div style="color:var(--text-1);font-weight:700;font-size:16px">Olá, {{ app.user.nome }}</div>
                    <div style="margin-top:4px">
                        <span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span>
                        {% if empresa %}<span style="color:var(--text-3);font-size:12px;margin-left:8px">{{ empresa.nome }}</span>{% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            {% include 'components/stat_card.html.twig' with { icon: 'fa-graduation-cap', value: stats.treinamentos, label: 'Treinamentos' } %}
        </div>
        <div class="col-md-3 col-sm-6">
            {% include 'components/stat_card.html.twig' with { icon: 'fa-chart-bar', value: stats.avaliacoes, label: 'Avaliações' } %}
        </div>
    {% else %}
        {% set cards = [
            {icon:'fa-users',          v: stats.funcionarios,  l:'Funcionários'},
            {icon:'fa-sitemap',        v: stats.departamentos, l:'Departamentos'},
            {icon:'fa-briefcase',      v: stats.vagas_abertas, l:'Vagas Abertas'},
            {icon:'fa-graduation-cap', v: stats.treinamentos,  l:'Treinamentos'},
        ] %}
        {% for c in cards %}
        <div class="col-lg-3 col-md-6 col-sm-6">
            {% include 'components/stat_card.html.twig' with { icon: c.icon, value: c.v, label: c.l } %}
        </div>
        {% endfor %}
    {% endif %}
</div>

{# ── Módulos + painel ── #}
<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="huplex-card">
            <div class="mb-4">
                <div class="section-title">Módulos da Plataforma</div>
                <div class="section-subtitle">Acesso rápido às funcionalidades</div>
            </div>
            <div class="row">
                {% if nav_show_hub_operacoes|default(false) %}
                <div class="col-md-6 mb-3 d-flex">
                    {% include 'components/module_tile.html.twig' with {
                        icon: 'fa-briefcase',
                        title: 'Hub Operações',
                        subtitle: 'RH e Gestão de Pessoas',
                        route: 'app_hub_operacoes'
                    } %}
                </div>
                {% endif %}
                {% if nav_show_hub_talentos|default(false) %}
                <div class="col-md-6 mb-3 d-flex">
                    {% include 'components/module_tile.html.twig' with {
                        icon: 'fa-gem',
                        title: 'Hub de Talentos',
                        subtitle: 'Banco, vagas e trilhas',
                        route: 'app_talentos'
                    } %}
                </div>
                {% endif %}
                {% if nav_show_hub_maturidade|default(false) %}
                <div class="col-md-6 mb-3 d-flex">
                    {% include 'components/module_tile.html.twig' with {
                        icon: 'fa-gauge-high',
                        title: 'Hub de Maturidade',
                        subtitle: 'Radar e plano de ação',
                        route: 'app_maturidade'
                    } %}
                </div>
                {% endif %}
                {% if nav_show_admin|default(false) %}
                <div class="col-md-6 mb-3 d-flex">
                    {% include 'components/module_tile.html.twig' with {
                        icon: 'fa-shield-halved',
                        title: 'Administração',
                        subtitle: 'Usuários e configurações',
                        route: 'app_admin'
                    } %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="huplex-card">
            <div class="section-title mb-1">Meu Acesso</div>
            <div class="section-subtitle mb-3">Nível de permissão atual</div>

            <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle" style="width:46px;height:46px;font-size:15px;border-radius:12px;flex-shrink:0">{{ app.user.initials }}</div>
                <div class="ml-3 min-w-0">
                    <div style="color:var(--text-1);font-weight:600;font-size:13px;line-height:1.3">{{ app.user.nome }}</div>
                    <div style="color:var(--text-3);font-size:11px">{{ app.user.email }}</div>
                    <div class="mt-1"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span></div>
                </div>
            </div>

            {% if empresa %}
            <div class="empresa-box mb-3">
                {% import 'macros/empresa.html.twig' as empresa_macro %}
                {{ empresa_macro.logo(empresa, 'empresa-logo') }}
                <div class="min-w-0">
                    <div class="eb-name">{{ empresa.nome }}</div>
                    {% if empresa.setor %}<div class="eb-setor">{{ empresa.setor }}</div>{% endif %}
                </div>
            </div>
            {% endif %}

            <div style="font-size:10px;color:var(--text-3);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px">Permissões</div>
            {% set perms = [
                {l:'Dashboard',        g: true},
                {l:'Hub Operações',  g: nav_show_hub_operacoes|default(false)},
                {l:'Hub Talentos',   g: nav_show_hub_talentos|default(false)},
                {l:'Hub Maturidade', g: nav_show_hub_maturidade|default(false)},
                {l:'Administração',  g: nav_show_admin|default(false)},
                {l:'Multi-empresa',  g: nav_show_tenant_empresas|default(false)},
            ] %}
            {% for p in perms %}
            <div class="perm-row">
                <span class="perm-label">{{ p.l }}</span>
                {% if p.g %}<i class="fas fa-check-circle perm-yes"></i>{% else %}<i class="fas fa-lock perm-no"></i>{% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{% endblock %}
