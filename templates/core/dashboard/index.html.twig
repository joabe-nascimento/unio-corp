{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_show_title %}{% endblock %}

{% block content %}

<div class="dashboard-page" id="dashboardPage">

{% if account_pending|default(false) %}
    {% include 'components/account_pending_banner.html.twig' %}
{% endif %}

{% include 'components/dashboard_welcome.html.twig' %}

{% include 'components/welcome/onboarding_checklist.html.twig' with {
    onboarding: onboarding|default({ visible: false })
} only %}

{% set dashboard_modules = platform_modules|default([]) %}

{% if kpis|length > 0 %}
<section class="dashboard-kpis-section mb-4" aria-label="Indicadores">
    <div class="dashboard-kpis-grid">
        {% for kpi in kpis %}
            {% if kpi.route is defined and kpi.route %}
            <a href="{{ path(kpi.route) }}" class="dashboard-kpi-card dashboard-kpi-card--link">
                <div class="dashboard-kpi-icon" aria-hidden="true"><i class="fas {{ kpi.icon }}"></i></div>
                <div class="dashboard-kpi-body">
                    <span class="dashboard-kpi-value">{{ kpi.value }}</span>
                    <span class="dashboard-kpi-label">{{ kpi.label }}</span>
                </div>
                <i class="fas fa-chevron-right dashboard-kpi-arrow" aria-hidden="true"></i>
            </a>
            {% else %}
            <div class="dashboard-kpi-card">
                <div class="dashboard-kpi-icon" aria-hidden="true"><i class="fas {{ kpi.icon }}"></i></div>
                <div class="dashboard-kpi-body">
                    <span class="dashboard-kpi-value">{{ kpi.value }}</span>
                    <span class="dashboard-kpi-label">{{ kpi.label }}</span>
                </div>
            </div>
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}

{% if dashboard_modules|length > 0 %}
<section class="dashboard-modules-section huplex-card mb-4">
    {% if account_pending|default(false) and dashboard_modules|length == 0 %}
    <p class="dashboard-modules-empty text-muted mb-0">
        Nenhum módulo disponível até que sua conta seja vinculada a uma empresa.
    </p>
    {% elseif dashboard_modules|length > 0 %}
    <header class="dashboard-modules-head">
        <div>
            <h2 class="dashboard-modules-title">Módulos da plataforma</h2>
            <p class="dashboard-modules-sub">Acesso rápido às funcionalidades</p>
        </div>
        <a href="{{ path('app_welcome') }}" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-house-chimney mr-1" aria-hidden="true"></i> Início
        </a>
    </header>
    <div class="dashboard-module-grid">
        {% for m in dashboard_modules %}
            {% include 'components/module_tile.html.twig' with m %}
        {% endfor %}
    </div>
    {% endif %}
</section>
{% endif %}

{% include 'components/charts/panel.html.twig' with {
    sections: chart_sections|default([]),
    class: 'dashboard-analytics'
} %}

</div>

{% endblock %}

{% block javascripts %}
{% include 'components/charts/assets.html.twig' with { sections: chart_sections|default([]), version: 2 } only %}
<script src="{{ asset('js/dashboard-home.js') }}?v=1"></script>
<script src="{{ asset('js/onboarding-checklist.js') }}?v=1"></script>
{% endblock %}
