{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_show_title %}{% endblock %}

{% block content %}

{% if account_pending|default(false) %}
    {% include 'components/account_pending_banner.html.twig' %}
{% endif %}

{% include 'components/dashboard_welcome.html.twig' %}

{# ── Banner por perfil ── #}
{% if layout == 'tenant' %}
    {% include 'components/page_banner.html.twig' with {
        icon: 'fa-shield-halved',
        title: 'Gestão da Plataforma · Multi-empresa',
        subtitle: 'Acesso total — hubs operacionais e configuração' ~ (empresa ? ' · ' ~ empresa.nome : ''),
        use_huplex_mark: true
    } %}
{% elseif layout == 'gestor' %}
    {% include 'components/page_banner.html.twig' with {
        icon: 'fa-chart-pie',
        title: 'Visão do Gestor' ~ (empresa ? ' — ' ~ empresa.nome : ''),
        subtitle: 'Dados consolidados da empresa'
    } %}
{% elseif layout == 'supervisor' %}
    {% include 'components/page_banner.html.twig' with {
        icon: 'fa-user-group',
        title: 'Sua Equipe' ~ (empresa ? ' — ' ~ empresa.nome : ''),
        subtitle: 'Colaboradores sob sua supervisão'
    } %}
{% endif %}

{% set dashboard_modules = platform_modules|default([]) %}

{# ── Stats (tenant / gestor / supervisor) — linha própria ── #}
{% if layout != 'membro' %}
<div class="row stats-row mb-2">
    {% if layout == 'tenant' %}
        {% set cards = [
            {icon:'fa-users',          v: stats.funcionarios,  l:'Funcionários'},
            {icon:'fa-sitemap',        v: stats.departamentos, l:'Departamentos'},
            {icon:'fa-briefcase',      v: stats.vagas_abertas, l:'Vagas Abertas'},
            {icon:'fa-graduation-cap', v: stats.treinamentos,  l:'Treinamentos'},
            {icon:'fa-user-shield',    v: stats.usuarios,      l:'Usuários'},
            {icon:'fa-building',       v: stats.empresas,      l:'Empresas'},
        ] %}
        {% for c in cards %}
        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            {% include 'components/stat_card.html.twig' with { icon: c.icon, value: c.v, label: c.l } %}
        </div>
        {% endfor %}
    {% else %}
        {% set cards = [
            {icon:'fa-users',          v: stats.funcionarios,  l:'Funcionários'},
            {icon:'fa-sitemap',        v: stats.departamentos, l:'Departamentos'},
            {icon:'fa-briefcase',      v: stats.vagas_abertas, l:'Vagas Abertas'},
            {icon:'fa-graduation-cap', v: stats.treinamentos,  l:'Treinamentos'},
        ] %}
        {% for c in cards %}
        <div class="col-lg-3 col-md-6 col-sm-6">
            {% include 'components/stat_card.html.twig' with { icon: c.icon, value: c.v, label: c.l } %}
        </div>
        {% endfor %}
    {% endif %}
</div>
{% endif %}

{# ── KPIs + módulos (membro: bloco único; demais: só módulos) ── #}
<div class="row dashboard-main-row">
    <div class="col-12 mb-4">
        <div class="huplex-card dashboard-modules-card">
            {% if layout == 'membro' %}
                {% include 'components/kpi_row.html.twig' with {
                    items: [
                        { value: stats.treinamentos, label: 'Treinamentos' },
                        { value: stats.avaliacoes, label: 'Avaliações' },
                    ],
                    mb: 'mb-4'
                } %}
            {% endif %}

            {% if account_pending|default(false) and dashboard_modules|length == 0 %}
                <div class="text-muted" style="font-size: 13px;">
                    Nenhum módulo disponível até que sua conta seja vinculada a uma empresa.
                </div>
            {% elseif dashboard_modules|length > 0 %}
                <div class="{% if layout == 'membro' %}dashboard-modules-section{% else %}mb-0{% endif %}">
                    <div class="section-title">Módulos da Plataforma</div>
                    <div class="section-subtitle mb-3">Acesso rápido às funcionalidades</div>
                    <div class="dashboard-module-grid">
                        {% for m in dashboard_modules %}
                            {% include 'components/module_tile.html.twig' with m %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}
