{% extends 'base.html.twig' %}

{% block title %}Chat Papo{% endblock %}
{% block page_show_title %}{% endblock %}

{% block content %}
<div class="chat-page">
    {% include 'components/chat_app.html.twig' %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';

    var app = document.getElementById('chatApp');
    if (!app) return;

    var dataEl = document.getElementById('chatInitialData');
    var convList = document.getElementById('chatConvList');
    var chatEmpty = document.getElementById('chatEmpty');
    var chatRoom = document.getElementById('chatRoom');
    var chatMessages = document.getElementById('chatMessages');
    var chatRoomName = document.getElementById('chatRoomName');
    var chatRoomStatus = document.getElementById('chatRoomStatus');
    var chatRoomAvatar = document.getElementById('chatRoomAvatar');
    var chatSearch = document.getElementById('chatSearch');
    var chatForm = document.getElementById('chatForm');
    var chatInput = document.getElementById('chatInput');
    var chatSendBtn = document.getElementById('chatSendBtn');
    var chatBackBtn = document.getElementById('chatBackBtn');
    var mobileMq = window.matchMedia('(max-width: 767.98px)');

    var STORAGE_KEY = app.dataset.storageKey || 'huplex-chat-papo';
    var USER_INITIALS = app.dataset.userInitials || 'U';
    var conversations = [];
    var activeId = null;
    var activeTab = 'all';
    var readState = {};

    var MOCK_REPLIES = [
        'Recebido! Já estou vendo isso.',
        'Perfeito, obrigado pelo retorno.',
        'Combinado. Te aviso assim que tiver novidade.',
        'Entendi. Vou alinhar com a equipe.',
        'Show! Qualquer coisa me chama por aqui.',
    ];

    function parseInitial() {
        try {
            return dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
        } catch (e) {
            return [];
        }
    }

    function loadState() {
        try {
            var raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : {};
        } catch (e) {
            return {};
        }
    }

    function saveState() {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                extraMessages: getExtraMessages(),
                readState: readState,
                lastActiveId: activeId,
            }));
        } catch (e) {}
    }

    function getExtraMessages() {
        var out = {};
        conversations.forEach(function (c) {
            var extras = (c.messages || []).filter(function (m) { return m.local; });
            if (extras.length) out[c.id] = extras;
        });
        return out;
    }

    function mergeState() {
        var state = loadState();
        readState = state.readState || {};
        if (state.extraMessages) {
            conversations.forEach(function (c) {
                if (state.extraMessages[c.id]) {
                    c.messages = (c.messages || []).concat(state.extraMessages[c.id]);
                }
            });
        }
        if (state.readState) {
            conversations.forEach(function (c) {
                if (readState[c.id]) c.unread = 0;
            });
        }
        if (state.lastActiveId && getConv(state.lastActiveId)) {
            activeId = state.lastActiveId;
        }
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function getConv(id) {
        return conversations.find(function (c) { return c.id === id; }) || null;
    }

    function formatTime(iso) {
        try {
            var d = new Date(iso);
            return d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        } catch (e) {
            return '';
        }
    }

    function formatDateLabel(iso) {
        try {
            var d = new Date(iso);
            var today = new Date();
            var sameDay = d.toDateString() === today.toDateString();
            if (sameDay) return 'Hoje';
            var yesterday = new Date(today);
            yesterday.setDate(today.getDate() - 1);
            if (d.toDateString() === yesterday.toDateString()) return 'Ontem';
            return d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
        } catch (e) {
            return '';
        }
    }

    function filteredConversations() {
        var q = (chatSearch ? chatSearch.value : '').trim().toLowerCase();
        return conversations.filter(function (c) {
            if (activeTab !== 'all' && c.type !== activeTab) return false;
            if (!q) return true;
            return (c.name || '').toLowerCase().indexOf(q) !== -1
                || (c.preview || '').toLowerCase().indexOf(q) !== -1;
        });
    }

    function renderConvList() {
        if (!convList) return;
        var items = filteredConversations();
        convList.innerHTML = '';
        if (!items.length) {
            convList.innerHTML = '<p class="chat-conv-empty">Nenhuma conversa encontrada.</p>';
            return;
        }
        items.forEach(function (c) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'chat-conv-item' + (c.id === activeId ? ' chat-conv-item--active' : '');
            btn.dataset.convId = c.id;
            btn.setAttribute('role', 'listitem');
            btn.innerHTML =
                '<span class="chat-conv-avatar' + (c.online ? ' chat-conv-avatar--online' : '') + '">' + escapeHtml(c.initials) + '</span>' +
                '<span class="chat-conv-body">' +
                    '<span class="chat-conv-row">' +
                        '<span class="chat-conv-name">' + escapeHtml(c.name) + '</span>' +
                        '<span class="chat-conv-time">' + escapeHtml(c.time_label || '') + '</span>' +
                    '</span>' +
                    '<span class="chat-conv-row">' +
                        '<span class="chat-conv-preview">' + escapeHtml(c.preview || '') + '</span>' +
                        (c.unread > 0 ? '<span class="chat-conv-badge">' + c.unread + '</span>' : '') +
                    '</span>' +
                '</span>';
            convList.appendChild(btn);
        });
    }

    function renderMessages(conv) {
        if (!chatMessages || !conv) return;
        var html = '';
        var lastDate = '';
        (conv.messages || []).forEach(function (m) {
            var dateLabel = formatDateLabel(m.at);
            if (dateLabel && dateLabel !== lastDate) {
                html += '<div class="chat-date-sep"><span>' + escapeHtml(dateLabel) + '</span></div>';
                lastDate = dateLabel;
            }
            if (m.role === 'system') {
                html += '<div class="chat-msg chat-msg--system"><span>' + escapeHtml(m.text) + '</span></div>';
                return;
            }
            var isUser = m.role === 'user';
            html += '<div class="chat-msg chat-msg--' + (isUser ? 'user' : 'other') + '">' +
                '<div class="chat-msg-bubble">' +
                (conv.type === 'group' && !isUser && m.sender ? '<span class="chat-msg-sender">' + escapeHtml(m.sender) + '</span>' : '') +
                '<p class="mb-0">' + escapeHtml(m.text).replace(/\n/g, '<br>') + '</p>' +
                '<span class="chat-msg-time">' + escapeHtml(formatTime(m.at)) + '</span>' +
                '</div></div>';
        });
        chatMessages.innerHTML = html;
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function openConversation(id) {
        var conv = getConv(id);
        if (!conv) return;
        activeId = id;
        conv.unread = 0;
        readState[id] = true;
        if (chatEmpty) chatEmpty.hidden = true;
        if (chatRoom) chatRoom.hidden = false;
        if (chatRoomName) chatRoomName.textContent = conv.name;
        if (chatRoomStatus) {
            if (conv.type === 'group') chatRoomStatus.textContent = 'Grupo · ' + (conv.messages || []).length + ' mensagens';
            else chatRoomStatus.textContent = conv.online ? 'Online' : 'Offline';
        }
        if (chatRoomAvatar) {
            chatRoomAvatar.textContent = conv.initials;
            chatRoomAvatar.classList.toggle('chat-room-avatar--online', !!conv.online);
        }
        renderMessages(conv);
        renderConvList();
        saveState();
        if (mobileMq.matches) app.classList.add('is-room-open');
        if (chatInput) chatInput.focus();
    }

    function closeRoomMobile() {
        app.classList.remove('is-room-open');
    }

    function mockReply(conv) {
        var text = MOCK_REPLIES[Math.floor(Math.random() * MOCK_REPLIES.length)];
        var sender = conv.type === 'group' ? 'Equipe' : conv.name.split(' ')[0];
        conv.messages.push({
            id: 'local-r-' + Date.now(),
            role: 'other',
            sender: conv.type === 'group' ? sender : null,
            text: text,
            at: new Date().toISOString(),
            local: true,
        });
        conv.preview = sender + ': ' + text;
        conv.time_label = 'Agora';
        renderMessages(conv);
        renderConvList();
        saveState();
    }

    function sendMessage(text) {
        text = (text || '').trim();
        if (!text || !activeId) return;
        var conv = getConv(activeId);
        if (!conv) return;
        conv.messages.push({
            id: 'local-u-' + Date.now(),
            role: 'user',
            sender: null,
            text: text,
            at: new Date().toISOString(),
            local: true,
        });
        conv.preview = 'Você: ' + text;
        conv.time_label = 'Agora';
        renderMessages(conv);
        renderConvList();
        saveState();
        if (chatInput) {
            chatInput.value = '';
            chatInput.style.height = '';
            updateSendState();
        }
        setTimeout(function () { mockReply(conv); }, 900 + Math.random() * 800);
    }

    function updateSendState() {
        if (!chatSendBtn || !chatInput) return;
        chatSendBtn.disabled = !chatInput.value.trim() || !activeId;
    }

    function setTab(tab) {
        activeTab = tab;
        app.querySelectorAll('.chat-tab').forEach(function (btn) {
            var on = btn.dataset.chatTab === tab;
            btn.classList.toggle('chat-tab--active', on);
            btn.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        renderConvList();
    }

    conversations = parseInitial();
    mergeState();
    renderConvList();
    if (activeId) openConversation(activeId);
    updateSendState();

    convList && convList.addEventListener('click', function (e) {
        var item = e.target.closest('.chat-conv-item');
        if (!item) return;
        openConversation(item.dataset.convId);
    });

    chatSearch && chatSearch.addEventListener('input', renderConvList);

    app.querySelectorAll('[data-chat-tab]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            setTab(btn.dataset.chatTab || 'all');
        });
    });

    chatForm && chatForm.addEventListener('submit', function (e) {
        e.preventDefault();
        sendMessage(chatInput ? chatInput.value : '');
    });

    chatInput && chatInput.addEventListener('input', function () {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
        updateSendState();
    });

    chatInput && chatInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            chatForm.dispatchEvent(new Event('submit', { cancelable: true }));
        }
    });

    chatBackBtn && chatBackBtn.addEventListener('click', closeRoomMobile);

    var chatToast = document.getElementById('chatToast');
    function showSoonFeature(label) {
        if (!chatToast) return;
        chatToast.textContent = label + ' estará disponível em breve no Chat Papo.';
        chatToast.hidden = false;
        clearTimeout(showSoonFeature._t);
        showSoonFeature._t = setTimeout(function () { chatToast.hidden = true; }, 3200);
    }
    app.querySelectorAll('.chat-action-soon').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var labelEl = btn.querySelector('span');
            showSoonFeature(labelEl ? labelEl.textContent.trim() : 'Recurso');
        });
    });
})();
</script>
{% endblock %}
