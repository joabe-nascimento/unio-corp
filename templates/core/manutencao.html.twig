{% set _tema = platform_config.tema|default('dark') %}
{% set _email = platform_config.suporte_email|default('')|trim %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Manutenção · {{ platform_config.plataforma_nome|default('Unio') }}</title>
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('unio-theme')||'{{ _tema }}')}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/maintenance-page.css') }}?v=1">
</head>
<body class="maintenance-page">
<main class="maintenance-page__inner">
    <div class="maintenance-page__logo">
        {% include 'components/platform_logo.html.twig' with { variant: 'full', class: 'maintenance-page__logo-img' } only %}
    </div>

    <p class="maintenance-page__status">
        <span class="maintenance-page__status-dot" aria-hidden="true"></span>
        Manutenção
    </p>

    <p class="maintenance-page__message">{{ msg }}</p>

    {% if _email %}
    <p class="maintenance-page__contact">
        Dúvidas: <a href="mailto:{{ _email }}">{{ _email }}</a>
    </p>
    {% endif %}

    <p class="maintenance-page__action">
        <a href="{{ app.user ? path('app_logout') : path('app_login') }}">
            {{ app.user ? 'Sair e ir ao login' : 'Ir ao login' }}
        </a>
    </p>
</main>
</body>
</html>
