{% extends 'base.html.twig' %}

{% block title %}{{ org_brand_label|default(org_juridico|default(false) ? 'Unio Jurídico' : 'Unio Saúde') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/unio-pulso.css') }}?v=17">
    {% if org_clinic|default(false) %}
    <link rel="stylesheet" href="{{ asset('css/clinic-finance-dashboard.css') }}?v=1">
    {% endif %}
{% endblock %}

{% block page_toolbar_layout %}yes{% endblock %}
{% block page_scroll_mode %}flow{% endblock %}

{% block content %}
<div class="pulso-root" id="pulsoRoot" data-api-url="{{ pulso_api_url }}">

    {% if org_clinic|default(false) %}
    {% include 'components/unio/ritual_banner.html.twig' %}
    {% elseif org_juridico|default(false) %}
    {% include 'components/unio/ritual_banner_juridico.html.twig' %}
    {% endif %}

    <section class="unio-card pulso-hero-card">
        <div class="pulso-hero">
            <div class="pulso-hero__text">
                {% if org_clinic|default(false) or org_juridico|default(false) %}
                <p class="pulso-hero__eyebrow">
                    <i class="fas {{ org_clinic|default(false) ? 'fa-house-medical' : 'fa-scale-balanced' }}" aria-hidden="true"></i>
                    {{ org_brand_label|default(org_juridico|default(false) ? 'Unio Jurídico' : 'Unio Saúde') }}
                </p>
                <h1 class="pulso-hero__title">Pulso</h1>
                {% else %}
                <h1 class="pulso-hero__title">{{ org_brand_label|default('Unio') }}</h1>
                {% endif %}
                <p class="pulso-hero__sub">{{ organismo.copy.brand_slogan|default(org_juridico|default(false) ? 'Justiça que acompanha.' : 'Saúde que acompanha.') }}</p>
            </div>
            <div class="pulso-hero__actions">
                <div class="pulso-vital pulso-vital--{{ snapshot.pulso.nivel|default('saudavel') }}" id="pulsoVitalBadge">
                    <span class="pulso-vital__wave" aria-hidden="true"></span>
                    {% if snapshot.pulso.score is not null %}
                    <span class="pulso-vital__score">{{ snapshot.pulso.score }}</span>
                    {% endif %}
                    <span class="pulso-vital__label">{{ snapshot.pulso.nivel|default('saudavel')|capitalize }}</span>
                </div>
                {% if org_clinic|default(false) %}
                <form method="post" action="{{ path('app_organismo_tick') }}" class="d-inline">
                    <button type="submit" class="btn-unio-ghost btn-sm">Tick</button>
                </form>
                {% endif %}
                <button type="button" class="btn-unio-ghost btn-sm" id="pulsoRefreshBtn">Atualizar</button>
            </div>
        </div>
        {% if snapshot.organismo.vitalidade.orgaos|default([])|length > 0 %}
        <div class="pulso-organs" aria-label="Órgãos do organismo">
            {% for org in snapshot.organismo.vitalidade.orgaos %}
            <div class="pulso-organ pulso-organ--{{ org.score >= 78 ? 'ok' : (org.score >= 55 ? 'warn' : 'crit') }}">
                <i class="fas {{ org.icon }}" aria-hidden="true"></i>
                <span class="pulso-organ__label">{{ org.label }}</span>
                <strong class="pulso-organ__score">{{ org.score }}</strong>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    {% set _sinais_sublist = [] %}
    {% for sinal in snapshot.sinais|default([]) %}
        {% set _sinais_sublist = _sinais_sublist|merge([{ valor: sinal.valor, rotulo: sinal.rotulo }]) %}
    {% else %}
        {% set _sinais_sublist = [{ rotulo: 'Nenhum alerta no momento' }] %}
    {% endfor %}

    <div class="pulso-kpis-wrap">
    {% include 'components/kpi_row.html.twig' with {
        items: [
            {
                value: snapshot.pulso.cenas_ativas|default(0),
                label: organismo.copy.pulso_projects_active|default(org_juridico|default(false) ? 'Casos ativos' : (org_clinic|default(false) ? 'Pacientes ativos' : 'Projetos ativos')),
                tone: 'sky',
                kpi_key: 'pulso_ativas'
            },
            {
                value: snapshot.pulso.cenas_aguardando|default(0),
                label: organismo.copy.pulso_in_progress|default(org_juridico|default(false) ? 'Em andamento' : (org_clinic|default(false) ? 'Em acompanhamento' : 'Em progresso')),
                tone: 'amber',
                kpi_key: 'pulso_aguardando'
            },
            {
                label: 'Alertas recentes',
                tone: 'rose',
                span: 2,
                sublist_id: 'pulsoSinaisList',
                sublist: _sinais_sublist
            }
        ]
    } %}
    </div>

    {% set _org = snapshot.organismo|default({}) %}
    {% if org_clinic|default(false) and (_org.gemeo|default([])|length > 0 or _org.memoria.recent|default([])|length > 0 or _org.reflexos|default([])|length > 0) %}
    <div class="pulso-runtime-grid">
        {% if _org.gemeo|default([])|length > 0 %}
        <section class="unio-card pulso-runtime-card">
            {% include 'components/section_header.html.twig' with {
                title: 'Gêmeo do dia',
                subtitle: 'Cascata prevista — top riscos'
            } %}
            <ul class="pulso-gemeo list-unstyled mb-0">
                {% for s in _org.gemeo %}
                <li class="pulso-gemeo__item pulso-gemeo__item--{{ s.impacto|default('medio') }}">
                    <div class="pulso-gemeo__prob">{{ s.probabilidade }}%</div>
                    <div class="pulso-gemeo__body">
                        <strong>{{ s.titulo }}</strong>
                        <span class="text-muted small">{{ s.acao_sugerida }} · confiança {{ s.confianca }}%</span>
                    </div>
                    {% if s.route|default('') %}
                    <a href="{{ path(s.route) }}" class="btn-unio-ghost btn-sm">Abrir</a>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}

        {% if _org.memoria.recent|default([])|length > 0 or _org.reflexos|default([])|length > 0 %}
        <section class="unio-card pulso-runtime-card">
            {% include 'components/section_header.html.twig' with {
                title: 'Memória e reflexos',
                subtitle: 'O organismo aprende e reage'
            } %}
            {% if _org.reflexos|default([])|length > 0 %}
            <h3 class="pulso-runtime-card__mini">Reflexos recentes</h3>
            <ul class="list-unstyled pulso-reflex-list mb-3">
                {% for r in _org.reflexos %}
                <li>
                    <strong>{{ r.motivo }}</strong>
                    <span class="text-muted small">{{ r.em }} · {{ r.code }}</span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if _org.memoria.patterns|default([])|length > 0 %}
            <h3 class="pulso-runtime-card__mini">Padrões (30 dias)</h3>
            <ul class="list-unstyled pulso-pattern-list mb-0">
                {% for p in _org.memoria.patterns %}
                <li>{{ p.label }} <strong>{{ p.total }}</strong></li>
                {% endfor %}
            </ul>
            {% endif %}
            <p class="px-3 pb-3 mb-0 mt-2">
                <a href="{{ path('app_organismo_contratos') }}" class="btn-unio-ghost btn-sm">Contratos de cuidado</a>
            </p>
        </section>
        {% endif %}
    </div>
    {% endif %}

    {% if org_clinic|default(false) %}
    <section class="unio-card pulso-shortcuts-card" aria-label="Atalhos de faturamento">
        {% include 'components/section_header.html.twig' with {
            title: 'Faturamento e agenda',
            subtitle: 'Atalhos para o fluxo do dia'
        } %}
        <div class="pulso-shortcuts">
            <a href="{{ path('app_pos_operatorio_agenda') }}" class="pulso-shortcut">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                <span>Agenda</span>
            </a>
            <a href="{{ path('app_pos_operatorio_atendimento') }}" class="pulso-shortcut">
                <i class="fas fa-stethoscope" aria-hidden="true"></i>
                <span>Atendimentos</span>
            </a>
            <a href="{{ path('app_pos_operatorio_contas', { status: 'aberto' }) }}" class="pulso-shortcut">
                <i class="fas fa-file-invoice" aria-hidden="true"></i>
                <span>Contas</span>
            </a>
            <a href="{{ path('app_pos_operatorio_guias') }}" class="pulso-shortcut">
                <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                <span>Guias TISS</span>
            </a>
            <a href="{{ path('app_pos_operatorio_lotes') }}" class="pulso-shortcut">
                <i class="fas fa-boxes-stacked" aria-hidden="true"></i>
                <span>Lotes</span>
            </a>
            <a href="{{ path('app_pos_operatorio_convenios') }}" class="pulso-shortcut">
                <i class="fas fa-handshake" aria-hidden="true"></i>
                <span>Convênios</span>
            </a>
        </div>
    </section>

    {# Dashboard Financeiro Executivo #}
    {% include 'components/clinic/finance_dashboard_widget.html.twig' %}
    {% elseif org_juridico|default(false) %}
    <section class="unio-card pulso-shortcuts-card" aria-label="Atalhos do escritório">
        {% include 'components/section_header.html.twig' with {
            title: 'Operação jurídica',
            subtitle: 'Atalhos para o fluxo do dia'
        } %}
        <div class="pulso-shortcuts">
            <a href="{{ path('app_juridico') }}" class="pulso-shortcut">
                <i class="fas fa-th-large" aria-hidden="true"></i>
                <span>Hub Jurídico</span>
            </a>
            <a href="{{ path('app_juridico_modulo', { slug: 'processos' }) }}" class="pulso-shortcut">
                <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                <span>Processos</span>
            </a>
            <a href="{{ path('app_juridico_modulo', { slug: 'prazos' }) }}" class="pulso-shortcut">
                <i class="fas fa-hourglass-half" aria-hidden="true"></i>
                <span>Prazos</span>
            </a>
            <a href="#" class="pulso-shortcut js-unio-open-helix">
                <i class="fas fa-robot" aria-hidden="true"></i>
                <span>{{ organismo.copy.lumen|default('Bruna') }}</span>
            </a>
            <a href="{{ path('app_juridico_modulo', { slug: 'clientes' }) }}" class="pulso-shortcut">
                <i class="fas fa-user-tie" aria-hidden="true"></i>
                <span>CRM</span>
            </a>
            <a href="{{ path('app_financeiro') }}" class="pulso-shortcut">
                <i class="fas fa-coins" aria-hidden="true"></i>
                <span>Financeiro</span>
            </a>
        </div>
    </section>
    {% endif %}

    <section class="unio-card pulso-cenas-card" aria-labelledby="pulsoCenasHeading">
        {% set _headline = snapshot.pulso.headline|default('') %}
        {% if _headline is iterable %}
            {% set _headline_sub = _headline.subtitle|default(_headline.title|default('')) %}
        {% else %}
            {% set _headline_sub = _headline %}
        {% endif %}
        {% include 'components/section_header.html.twig' with {
            title: organismo.copy.pulso_cases_heading|default('Casos em andamento'),
            subtitle: _headline_sub
        } %}
        <div class="pulso-cenas-card__body">
            <div class="pulso-cenas-grid" id="pulsoCenasGrid">
                {% for cena in snapshot.cenas|default([]) %}
                {% include 'core/pulso/_cena_card.html.twig' with { cena: cena } %}
                {% else %}
                <div class="pulso-empty">
                    <p>{{ organismo.copy.pulso_empty|default(org_juridico|default(false) ? 'Nenhum processo ativo no escritório.' : (org_clinic|default(false) ? 'Nenhum paciente em acompanhamento ativo.' : 'Nenhum caso em andamento.')) }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% if snapshot.kpis|default([])|length > 0 %}
    <section class="unio-card pulso-kpis-card" aria-labelledby="pulsoKpisHeading">
        {% include 'components/section_header.html.twig' with {
            title: organismo.copy.pulso_kpis_heading|default(org_juridico|default(false) ? 'Indicadores do escritório' : (org_clinic|default(false) ? 'Indicadores da clínica' : 'Indicadores')),
        } %}
        <div class="pulso-kpis-card__body">
            <div class="org-kpi-strip org-kpi-strip--tiles">
                {% for kpi in snapshot.kpis %}
                <article class="org-kpi-strip__item org-kpi-strip__item--neutral">
                    <div class="org-kpi-strip__body">
                        <span class="org-kpi-strip__value">{{ kpi.value }}</span>
                        <span class="org-kpi-strip__label">{{ kpi.label }}</span>
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/unio-pulso.js') }}?v=3" defer></script>
    {% if org_clinic|default(false) %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="{{ asset('js/clinic-finance-dashboard.js') }}?v=1" defer></script>
    {% endif %}
{% endblock %}
