{% set _tipo = cena.tipo|default('paciente') %}
{% set _tag = cena.url|default(null) ? 'a' : 'article' %}

<{{ _tag }}
    class="pulso-cena-card pulso-cena-card--{{ cena.estado|default('ativa') }}{% if cena.mock|default(false) %} pulso-cena-card--mock{% endif %}{% if cena.url|default(null) %} pulso-cena-card--link{% endif %}"
    {% if cena.url|default(null) %}href="{{ cena.url }}"{% endif %}
>
    <div class="pulso-cena-card__head">
        <span class="pulso-cena-card__tipo">{{ _tipo|replace({'_': ' '}) }}</span>
        {% if cena.mock|default(false) %}
        <span class="pulso-cena-card__badge">Demo</span>
        {% endif %}
    </div>
    <h3 class="pulso-cena-card__title">{{ cena.titulo }}</h3>
    {% if cena.dias_aberta is defined and cena.dias_aberta > 0 or cena.condutor|default(null) %}
    <div class="pulso-cena-card__meta">
        {% if cena.dias_aberta is defined and cena.dias_aberta > 0 %}
        <span>{{ cena.dias_aberta }}d</span>
        {% endif %}
        {% if cena.condutor|default(null) %}
        <span>{{ cena.condutor }}</span>
        {% endif %}
    </div>
    {% endif %}
    {% if cena.praticas|default([])|length > 0 %}
    <div class="pulso-cena-card__praticas">
        {% for p in cena.praticas %}
        <span class="pulso-pratica-tag">{{ p|replace({'_': ' '}) }}</span>
        {% endfor %}
    </div>
    {% endif %}
</{{ _tag }}>
