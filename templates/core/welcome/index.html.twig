{% extends 'base.html.twig' %}

{% block title %}Bem-vindo{% endblock %}
{% block page_show_title %}{% endblock %}

{% block content %}
{% embed 'components/inset_page_shell.html.twig' with {
    shell_class: 'welcome-page-shell',
    content_class: 'welcome-page welcome-page--present',
    content_id: 'welcomePage',
    geo_id: 'welcome',
    bg_class: 'welcome-page-bg',
    content_attrs: {
        'data-user-id': app.user.id,
        'data-layout': 'comfortable'
    }
} %}
{% import 'macros/unio_offcanvas.html.twig' as offcanvas %}
{% block inset_content %}
    <div class="welcome-page-inner">

    <div class="welcome-page-toolbar">
        <p class="welcome-page-toolbar-label">Centro de partida</p>
        <span id="welcome-personalize">
            {{ offcanvas.open_button('welcome-personalize', 'Personalizar', { ghost: true, icon: 'fa-sliders', class: 'welcome-personalize-btn' }) }}
        </span>
    </div>

    {% include 'components/welcome/presentation_hero.html.twig' with {
        presentation: presentation,
        greeting: greeting,
        perfil_label: perfil_label,
        weekday: weekday,
        date_label: date_label,
        time_label: time_label,
        empresas_count: empresas_count,
        empresa: empresa
    } only %}

    {% include 'components/welcome/onboarding_checklist.html.twig' with {
        onboarding: onboarding
    } only %}

    <div class="welcome-page-sections">
        <section class="welcome-section unio-card unio-shell-surface" id="welcome-hubs" data-welcome-section="hubs">
            {% include 'components/shell_section_head.html.twig' with {
                head_class: 'welcome-section-header',
                title_class: 'welcome-section-title',
                sub_class: 'welcome-section-sub',
                count_class: 'welcome-section-count',
                title_tag: 'h2',
                title: 'Por onde começar',
                subtitle: 'Núcleos disponíveis — fixe favoritos com a estrela',
                count: hubs|length ~ ' núcleos'
            } only %}

            {% if hubs|length > 0 %}
            {% include 'components/hub_dock.html.twig' with {
                items: hubs,
                show_pin: true,
                dock_id: 'welcomeHubsGrid'
            } only %}
            {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-layer-group',
                title: 'Nenhum núcleo disponível',
                text: 'Seu perfil ainda não possui núcleos ativos nesta área.'
            } %}
            {% endif %}
        </section>
    </div>

    {% include 'components/welcome/ai_spotlight.html.twig' %}

    {% include 'components/welcome/metrics_showcase.html.twig' with {
        metrics: presentation.metrics
    } only %}

    {% if chart_sections|length > 0 %}
    <div id="welcome-analytics" data-welcome-section="graficos">
        {% include 'components/charts/panel.html.twig' with {
            sections: chart_sections,
            chart_executive: chart_executive|default({ kpis: [] }),
            border_top: true,
            show_chartjs_badge: false,
            title: 'Command Center · Analytics',
            subtitle: 'Inteligência executiva ponta a ponta — people, RH, delivery e governança',
            data_section_attr: 'graficos'
        } %}
    </div>
    {% endif %}

    {% include 'components/welcome/news_updates_panel.html.twig' with {
        news: welcome_content.news,
        news_meta: welcome_content.news_meta,
        updates: welcome_content.updates,
        updates_meta: welcome_content.updates_meta
    } only %}

    {% if novidades|length > 0 %}
    <section class="welcome-section welcome-section--spotlight unio-card unio-shell-surface" data-welcome-section="novidades">
        {% include 'components/shell_section_head.html.twig' with {
            head_class: 'welcome-section-header',
            title_class: 'welcome-section-title',
            sub_class: 'welcome-section-sub',
            count_class: 'welcome-section-count',
            title_tag: 'h2',
            title: 'Em destaque para você',
            subtitle: 'Novidades liberadas no seu perfil nesta área de trabalho',
            count: novidades|length ~ ' novos'
        } only %}
        <div class="welcome-novidades-track">
            {% for n in novidades %}
            <article class="welcome-novidade-card" data-novidade-id="{{ n.id }}">
                <button type="button"
                        class="welcome-novidade-dismiss"
                        data-welcome-dismiss-novidade="{{ n.id }}"
                        title="Ocultar destaque"
                        aria-label="Ocultar {{ n.title }}">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
                <a href="{{ path(n.route) }}" class="welcome-novidade-link">
                    <div class="welcome-novidade-icon"><i class="fas {{ n.icon }}" aria-hidden="true"></i></div>
                    <div class="welcome-novidade-body">
                        <div class="welcome-novidade-title">{{ n.title }}</div>
                        <div class="welcome-novidade-desc">{{ n.description }}</div>
                    </div>
                    <div class="welcome-novidade-footer">
                        <span class="welcome-badge-new">Novo</span>
                        <i class="fas fa-arrow-right welcome-novidade-arrow" aria-hidden="true"></i>
                    </div>
                </a>
            </article>
            {% endfor %}
        </div>
    </section>
    {% endif %}
    </div>{# .welcome-page-inner #}
{% endblock %}
{% endembed %}
{% endblock %}

{% block page_overlays %}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'welcome-personalize',
    title: 'Personalizar experiência',
    subtitle: 'Preferências salvas neste navegador',
    icon: 'fa-sliders',
    size: 'sm'
} %}
    {% block offcanvas_body %}
        {% include 'components/welcome/prefs_panel.html.twig' with {
            chart_sections: chart_sections|default([])
        } only %}
    {% endblock %}
    {% block offcanvas_footer %}
    <div class="unio-offcanvas-footer">
        <button type="button" class="btn-unio-ghost" id="welcomePrefsReset">
            <i class="fas fa-rotate-left mr-1" aria-hidden="true"></i> Restaurar padrão
        </button>
        <button type="button" class="btn-unio" data-unio-offcanvas-close>Concluir</button>
    </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block javascripts %}
{% if chart_sections|length > 0 %}
<script>document.body.dataset.unioChartsJs = {{ (asset('js/unio-charts.js') ~ '?v=6')|json_encode|raw }};</script>
<script src="{{ asset('js/welcome-charts-lazy.js') }}?v=1" defer></script>
{% endif %}
<script src="{{ asset('js/welcome-home.js') }}?v=6"></script>
<script src="{{ asset('js/welcome-news.js') }}?v=5" defer></script>
<script src="{{ asset('js/onboarding-checklist.js') }}?v=2"></script>
{% endblock %}
