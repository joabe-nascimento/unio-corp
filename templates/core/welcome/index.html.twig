{% extends 'base.html.twig' %}

{% block title %}Bem-vindo{% endblock %}
{% block page_title %}Bem-vindo{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Início</a></li>
    <li class="breadcrumb-item active">Bem-vindo</li>
{% endblock %}

{% block content %}

<div class="welcome-hero huplex-card mb-4">
    <div class="welcome-hero-main">
        <div class="welcome-hero-greeting">{{ greeting }}, {{ app.user.nome|split(' ')|first }}!</div>
        <div class="welcome-hero-sub">
            Você entrou na área de trabalho
            {% if empresa %}<strong>{{ empresa.nome }}</strong>{% else %}selecionada{% endif %}.
        </div>
        <div class="welcome-hero-datetime">
            <span><i class="fas fa-calendar-day"></i> {{ weekday }}, {{ date_label }}</span>
            <span><i class="fas fa-clock"></i> {{ time_label }}</span>
        </div>
    </div>
    <div class="welcome-hero-actions">
        <a href="{{ path('app_dashboard') }}" class="btn btn-primary btn-sm">
            <i class="fas fa-house mr-1"></i> Ir para o Dashboard
        </a>
        {% if empresas is defined and empresas|length > 1 %}
        <a href="{{ path('app_workspace_select', {force: 1}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-building mr-1"></i> Trocar área
        </a>
        {% endif %}
    </div>
</div>

{% if novidades|length > 0 %}
<div class="huplex-card mb-4">
    <div class="section-title mb-1">Novidades</div>
    <div class="section-subtitle mb-3">Recursos recentes na sua área de trabalho</div>
    <div class="welcome-novidades">
        {% for n in novidades %}
        <a href="{{ path(n.route) }}" class="welcome-novidade-item">
            <div class="welcome-novidade-icon"><i class="fas {{ n.icon }}"></i></div>
            <div class="welcome-novidade-body">
                <div class="welcome-novidade-title">{{ n.title }}</div>
                <div class="welcome-novidade-desc">{{ n.description }}</div>
            </div>
            <div class="welcome-novidade-end">
                <span class="welcome-badge-new">Novo</span>
                <i class="fas fa-chevron-right welcome-novidade-arrow"></i>
            </div>
        </a>
        {% endfor %}
    </div>
</div>
{% endif %}

<div class="huplex-card">
    <div class="section-title mb-1">Seus hubs</div>
    <div class="section-subtitle mb-3">Escolha por onde começar nesta área de trabalho</div>

    {% if hubs|length > 0 %}
    <div class="row">
        {% for hub in hubs %}
        <div class="col-md-6 col-lg-4 mb-3 d-flex">
            <a href="{{ path(hub.route) }}" class="welcome-hub-card">
                <div class="welcome-hub-icon"><i class="fas {{ hub.icon }}"></i></div>
                <div class="welcome-hub-body">
                    <div class="welcome-hub-title">{{ hub.title }}</div>
                    <div class="welcome-hub-sub">{{ hub.subtitle }}</div>
                </div>
                <i class="fas fa-arrow-right welcome-hub-arrow"></i>
            </a>
        </div>
        {% endfor %}
    </div>
    {% else %}
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-layer-group',
        title: 'Nenhum hub disponível',
        text: 'Seu perfil ainda não possui hubs ativos nesta área.'
    } %}
    {% endif %}
</div>

{% endblock %}
