{% extends 'base.html.twig' %}
{% import 'macros/huplex_offcanvas.html.twig' as offcanvas %}

{% block title %}Bem-vindo{% endblock %}
{% block page_show_title %}{% endblock %}

{% block content %}

<div class="welcome-page welcome-page--present"
     id="welcomePage"
     data-user-id="{{ app.user.id }}"
     data-layout="comfortable">

    <div class="welcome-page-toolbar">
        <p class="welcome-page-toolbar-label">Experiência de boas-vindas</p>
        <span id="welcome-personalize">
            {{ offcanvas.open_button('welcome-personalize', 'Personalizar', { ghost: true, icon: 'fa-sliders', class: 'welcome-personalize-btn' }) }}
        </span>
    </div>

    {% include 'components/welcome/presentation_hero.html.twig' with {
        presentation: presentation,
        greeting: greeting,
        perfil_class: perfil_class,
        perfil_label: perfil_label,
        weekday: weekday,
        date_label: date_label,
        time_label: time_label,
        empresas_count: empresas_count
    } only %}

    {% include 'components/welcome/metrics_showcase.html.twig' with {
        metrics: presentation.metrics
    } only %}

    {% include 'components/welcome/highlights_grid.html.twig' with {
        highlights: presentation.highlights
    } only %}

    {% include 'components/welcome/journey_steps.html.twig' with {
        journey: presentation.journey
    } only %}

    <div class="welcome-page-sections">

        {% if novidades|length > 0 %}
        <section class="welcome-section welcome-section--spotlight huplex-card" data-welcome-section="novidades">
            <header class="welcome-section-header">
                <div>
                    <h2 class="welcome-section-title">Em destaque para você</h2>
                    <p class="welcome-section-sub">Novidades liberadas no seu perfil nesta área de trabalho</p>
                </div>
                <span class="welcome-section-count">{{ novidades|length }} novos</span>
            </header>
            <div class="welcome-novidades-track">
                {% for n in novidades %}
                <article class="welcome-novidade-card" data-novidade-id="{{ n.id }}">
                    <button type="button"
                            class="welcome-novidade-dismiss"
                            data-welcome-dismiss-novidade="{{ n.id }}"
                            title="Ocultar destaque"
                            aria-label="Ocultar {{ n.title }}">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                    <a href="{{ path(n.route) }}" class="welcome-novidade-link">
                        <div class="welcome-novidade-icon"><i class="fas {{ n.icon }}" aria-hidden="true"></i></div>
                        <div class="welcome-novidade-body">
                            <div class="welcome-novidade-title">{{ n.title }}</div>
                            <div class="welcome-novidade-desc">{{ n.description }}</div>
                        </div>
                        <div class="welcome-novidade-footer">
                            <span class="welcome-badge-new">Novo</span>
                            <i class="fas fa-arrow-right welcome-novidade-arrow" aria-hidden="true"></i>
                        </div>
                    </a>
                </article>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <section class="welcome-section huplex-card" data-welcome-section="hubs">
            <header class="welcome-section-header">
                <div>
                    <h2 class="welcome-section-title">Escolha seu ponto de partida</h2>
                    <p class="welcome-section-sub">Hubs disponíveis — fixe favoritos com a estrela</p>
                </div>
                <span class="welcome-section-count">{{ hubs|length }} hubs</span>
            </header>

            {% if hubs|length > 0 %}
            <div class="welcome-hubs-grid welcome-hubs-grid--present" id="welcomeHubsGrid">
                {% for hub in hubs %}
                <article class="welcome-hub-tile welcome-hub-tile--present{% if loop.first %} welcome-hub-tile--featured{% endif %}"
                         data-hub-id="{{ hub.id }}">
                    <button type="button"
                            class="welcome-hub-pin"
                            data-welcome-pin-hub="{{ hub.id }}"
                            title="Fixar hub"
                            aria-label="Fixar {{ hub.title }}">
                        <i class="far fa-star" aria-hidden="true"></i>
                    </button>
                    <a href="{{ path(hub.route) }}" class="welcome-hub-tile-link">
                        {% if loop.first %}
                        <span class="welcome-hub-featured-badge">Recomendado</span>
                        {% endif %}
                        <div class="welcome-hub-icon"><i class="fas {{ hub.icon }}" aria-hidden="true"></i></div>
                        <div class="welcome-hub-body">
                            <div class="welcome-hub-title">{{ hub.title }}</div>
                            <div class="welcome-hub-sub">{{ hub.subtitle }}</div>
                        </div>
                        <span class="welcome-hub-enter">Entrar <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                    </a>
                </article>
                {% endfor %}
            </div>
            {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-layer-group',
                title: 'Nenhum hub disponível',
                text: 'Seu perfil ainda não possui hubs ativos nesta área.'
            } %}
            {% endif %}
        </section>
    </div>

    {% if chart_sections|length > 0 %}
    <div id="welcome-analytics" data-welcome-section="graficos">
        {% include 'components/charts/panel.html.twig' with {
            sections: chart_sections,
            border_top: true,
            show_chartjs_badge: false,
            title: 'Visão analítica da sua área',
            subtitle: 'Indicadores construídos com os dados já cadastrados na plataforma'
        } %}
    </div>
    {% endif %}
</div>

{% endblock %}

{% block page_overlays %}
{% embed 'components/huplex_offcanvas.html.twig' with {
    id: 'welcome-personalize',
    title: 'Personalizar experiência',
    subtitle: 'Preferências salvas neste navegador',
    icon: 'fa-sliders',
    size: 'sm'
} %}
    {% block offcanvas_body %}
    <div class="welcome-prefs">
        <p class="welcome-prefs-group-label">Layout</p>
        <div class="welcome-prefs-layout" role="radiogroup" aria-label="Densidade do layout">
            <label class="welcome-prefs-layout-opt">
                <input type="radio" name="welcome_layout" value="comfortable" checked data-welcome-pref="layout">
                <span><i class="fas fa-table-columns" aria-hidden="true"></i> Confortável</span>
            </label>
            <label class="welcome-prefs-layout-opt">
                <input type="radio" name="welcome_layout" value="compact" data-welcome-pref="layout">
                <span><i class="fas fa-compress" aria-hidden="true"></i> Compacto</span>
            </label>
        </div>

        <p class="welcome-prefs-group-label mt-4">Seções visíveis</p>
        <label class="welcome-prefs-toggle">
            <input type="checkbox" checked data-welcome-pref-section="metrics">
            <span class="welcome-prefs-toggle-ui"></span>
            <span>Panorama em números</span>
        </label>
        <label class="welcome-prefs-toggle">
            <input type="checkbox" checked data-welcome-pref-section="highlights">
            <span class="welcome-prefs-toggle-ui"></span>
            <span>Por que usar a plataforma</span>
        </label>
        <label class="welcome-prefs-toggle">
            <input type="checkbox" checked data-welcome-pref-section="journey">
            <span class="welcome-prefs-toggle-ui"></span>
            <span>Sua jornada</span>
        </label>
        <label class="welcome-prefs-toggle">
            <input type="checkbox" checked data-welcome-pref-section="novidades">
            <span class="welcome-prefs-toggle-ui"></span>
            <span>Em destaque</span>
        </label>
        <label class="welcome-prefs-toggle">
            <input type="checkbox" checked data-welcome-pref-section="hubs">
            <span class="welcome-prefs-toggle-ui"></span>
            <span>Hubs</span>
        </label>
        {% if chart_sections|default([])|length > 0 %}
        <label class="welcome-prefs-toggle">
            <input type="checkbox" checked data-welcome-pref-section="graficos">
            <span class="welcome-prefs-toggle-ui"></span>
            <span>Visão analítica</span>
        </label>
        {% endif %}

        <p class="welcome-prefs-hint mt-3">
            <i class="fas fa-thumbtack mr-1" aria-hidden="true"></i>
            Use a estrela nos hubs para fixar favoritos no topo.
        </p>
    </div>
    {% endblock %}
    {% block offcanvas_footer %}
    <div class="huplex-offcanvas-footer">
        <button type="button" class="btn-huplex-ghost" id="welcomePrefsReset">
            <i class="fas fa-rotate-left mr-1" aria-hidden="true"></i> Restaurar padrão
        </button>
        <button type="button" class="btn-huplex" data-huplex-offcanvas-close>Concluir</button>
    </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block javascripts %}
{% include 'components/charts/assets.html.twig' with { sections: chart_sections, version: 2 } only %}
<script src="{{ asset('js/welcome-home.js') }}?v=3"></script>
{% endblock %}
