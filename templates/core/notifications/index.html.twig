{% extends 'base.html.twig' %}

{% block title %}Notificações{% endblock %}
{% block page_show_title %}{% endblock %}
{% block page_toolbar_layout %}1{% endblock %}

{% block content_lead %}
<div class="page-lead-zone">
{% embed 'components/list_toolbar.html.twig' with {
    page_title: 'Notificações',
    search_placeholder: 'Buscar notificações…',
    search_disabled: true,
    search_in_top: true,
    filters_in_top: true
} %}
    {% block toolbar_actions %}
        <span class="notif-toolbar-badge">{{ unread_count }} não lida{{ unread_count != 1 ? 's' : '' }}</span>
        {% if unread_count > 0 %}
        <form method="post" action="{{ path('app_notifications_mark_all') }}" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('notifications_mark_all') }}">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-check-double mr-1"></i> Marcar todas como lidas
            </button>
        </form>
        {% endif %}
    {% endblock %}
    {% block toolbar_filters %}
        <div class="notif-filter-chips" role="group" aria-label="Filtrar notificações">
            <a href="{{ path('app_notifications', { filtro: 'todas' }) }}" class="notif-filter-chip {{ filtro|default('todas') == 'todas' ? 'notif-filter-chip--active' : '' }}">Todas ({{ total_count }})</a>
            <a href="{{ path('app_notifications', { filtro: 'nao_lidas' }) }}" class="notif-filter-chip {{ filtro|default('todas') == 'nao_lidas' ? 'notif-filter-chip--active' : '' }}">Não lidas ({{ unread_count }})</a>
        </div>
    {% endblock %}
{% endembed %}
</div>
{% endblock %}

{% block content %}

<div class="page-body-inner page-body-shell page-body-scroll">
<div class="unio-card notif-card">
    <p class="section-subtitle mb-3">Atualizações recentes da sua área de trabalho</p>
    {% include 'components/notifications_list.html.twig' with { notifications: notifications } %}
</div>
</div>

{% endblock %}
