{% extends 'base.html.twig' %}
{% block title %}Funcionários{% endblock %}
{% block page_title %}Funcionários{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_rh') }}">RH</a></li>
    <li class="breadcrumb-item active">Funcionários</li>
{% endblock %}
{% block content %}
<div class="huplex-card">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="section-title">Lista de Funcionários</div>
            <div class="section-subtitle">Gerencie o quadro completo de colaboradores</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn-huplex-ghost"><i class="fas fa-filter mr-1"></i> Filtrar</button>
            <button class="btn-huplex"><i class="fas fa-plus mr-1"></i> Novo</button>
        </div>
    </div>

    {# Filtros rápidos #}
    <div class="d-flex gap-2 mb-4 flex-wrap">
        {% for label, color in {'Todos':'#3D72FF','Ativos':'#22c55e','Férias':'#eab308','Afastados':'#94a3b8'} %}
        <button style="background:{{ color }}12;border:1px solid {{ color }}25;color:{{ color }};border-radius:100px;padding:4px 14px;font-size:12px;font-weight:600;cursor:pointer">
            {{ label }}
        </button>
        {% endfor %}
    </div>

    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-id-card"></i></div>
        <h6>Nenhum funcionário encontrado</h6>
        <p>Adicione funcionários para visualizá-los aqui.</p>
        <button class="btn-huplex mt-3"><i class="fas fa-plus mr-1"></i> Cadastrar Funcionário</button>
    </div>
</div>
{% endblock %}
