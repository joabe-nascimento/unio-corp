{% extends 'base.html.twig' %}
{% block title %}RH{% endblock %}
{% block page_title %}Recursos Humanos{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">RH</li>{% endblock %}
{% block content %}
<div class="row">
    {% set cards = [
        { icon:'fas fa-user-plus',     title:'Admissões',       sub:'Novas contratações pendentes', value:'3',  route:'app_rh_admissoes', color:'#3D72FF' },
        { icon:'fas fa-umbrella-beach',title:'Férias',           sub:'Colaboradores em férias',      value:'8',  route:'app_rh_ferias',    color:'#8b5cf6' },
        { icon:'fas fa-user-minus',    title:'Demissões',        sub:'Processos em andamento',       value:'1',  route:'app_rh_demissoes', color:'#ef4444' },
        { icon:'fas fa-file-invoice-dollar',title:'Folha',      sub:'Processamento do mês',         value:'OK', route:'app_rh_folha',     color:'#22c55e' },
    ] %}
    {% for c in cards %}
    <div class="col-md-3 col-sm-6 mb-3">
        <a href="{{ path(c.route) }}" class="text-decoration-none">
            <div class="huplex-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="card-label mb-1">{{ c.sub }}</div>
                        <div class="card-value">{{ c.value }}</div>
                        <div style="color:#fff;font-size:13px;font-weight:600;margin-top:4px">{{ c.title }}</div>
                    </div>
                    <div class="card-icon" style="background:{{ c.color }}15;border-color:{{ c.color }}30;color:{{ c.color }}">
                        <i class="{{ c.icon }}"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    {% endfor %}
</div>

<div class="huplex-card">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <div class="section-title">Funcionários Recentes</div>
            <div class="section-subtitle">Últimas alterações no quadro</div>
        </div>
        <a href="{{ path('app_rh_funcionarios') }}" class="btn-huplex">
            <i class="fas fa-plus mr-1"></i> Novo Funcionário
        </a>
    </div>
    <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-users"></i></div>
        <h6>Nenhum funcionário cadastrado</h6>
        <p>Comece cadastrando o primeiro funcionário da empresa.</p>
        <a href="{{ path('app_rh_funcionarios') }}" class="btn-huplex mt-3">Cadastrar Funcionário</a>
    </div>
</div>
{% endblock %}
