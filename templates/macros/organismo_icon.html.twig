{# Ícone circular humanizado — Organismo #}
{% macro nav(icon, tone = 'neutral', size = 'md') %}
<span class="org-icon org-icon--{{ tone }} org-icon--{{ size }}" aria-hidden="true">
    <i class="fas {{ icon }}"></i>
</span>
{% endmacro %}

{% macro dot(tone = 'neutral', size = 'md') %}
<span class="org-dot org-dot--{{ tone }} org-dot--{{ size }}" aria-hidden="true"></span>
{% endmacro %}

{% macro inline(icon, tone = 'neutral', size = 'sm') %}
<span class="org-icon org-icon--{{ tone }} org-icon--{{ size }} org-icon--inline" aria-hidden="true">
    <i class="fas {{ icon }}"></i>
</span>
{% endmacro %}
