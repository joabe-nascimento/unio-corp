{# Itens reutilizáveis do menu lateral (AdminLTE: has-treeview no pai expansível) #}

{% macro overview(label, href, active, icon) %}
        <li class="nav-item nav-hub-overview">
            <a href="{{ href }}" class="nav-link{{ active ? ' active' : '' }}"{{ active ? ' aria-current="page"' : '' }}>
                <i class="fas fa-{{ icon|default('table-cells') }} nav-icon"></i>
                <p>{{ label }}</p>
            </a>
        </li>
{% endmacro %}

{% macro module(label, icon, href, active) %}
        <li class="nav-item nav-hub-module">
            <a href="{{ href }}" class="nav-link{{ active ? ' active' : '' }}"{{ active ? ' aria-current="page"' : '' }}>
                <i class="fas fa-{{ icon }} nav-icon"></i>
                <p>{{ label }}</p>
            </a>
        </li>
{% endmacro %}

{% macro product_link(label, icon, href, active) %}
                <li class="nav-item">
                    <a href="{{ href }}" class="nav-link{{ active ? ' active' : '' }}"{{ active ? ' aria-current="page"' : '' }}>
                        <i class="fas fa-{{ icon }} nav-icon"></i>
                        <p>{{ label }}</p>
                    </a>
                </li>
{% endmacro %}

{# Subitem dentro de módulo expansível — ícone leve opcional (5º arg) #}
{% macro submenu(label, href, active, extra_class, icon) %}
<li class="nav-item">
    <a href="{{ href }}" class="nav-link nav-submenu-link{{ extra_class ? ' ' ~ extra_class : '' }}{{ active ? ' active' : '' }}"{{ active ? ' aria-current="page"' : '' }}>
        <span class="nav-submenu-icon-slot" aria-hidden="true">
            <i class="fas {{ icon|default('fa-circle') }} nav-submenu-icon"></i>
        </span>
        <p>{{ label }}</p>
    </a>
</li>
{% endmacro %}
