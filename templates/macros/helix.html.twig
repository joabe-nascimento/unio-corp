{# Assistente virtual Helix — rosto e avatar #}
{% macro face(size) %}
{% set s = size|default('md') %}
<span class="helix-face helix-face--{{ s }}" aria-hidden="true">
    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle class="helix-face-ring" cx="20" cy="20" r="18"/>
        <circle class="helix-face-eye" cx="14.5" cy="17" r="2.25"/>
        <circle class="helix-face-eye" cx="25.5" cy="17" r="2.25"/>
        <path class="helix-face-smile" d="M13.5 24.2c2.6 2.4 10.4 2.4 13 0"/>
    </svg>
</span>
{% endmacro %}

{% macro avatar(size) %}
{% set s = size|default('sm') %}
<span class="helix-avatar helix-avatar--{{ s }}" aria-hidden="true">
    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Helix">
        <defs>
            <linearGradient id="helixBotBg" x1="8" y1="4" x2="32" y2="36" gradientUnits="userSpaceOnUse">
                <stop stop-color="#22D3EE"/>
                <stop offset="0.45" stop-color="#12616E"/>
                <stop offset="1" stop-color="#6366F1"/>
            </linearGradient>
            <linearGradient id="helixBotFace" x1="12" y1="14" x2="28" y2="30" gradientUnits="userSpaceOnUse">
                <stop stop-color="#F8FAFC"/>
                <stop offset="1" stop-color="#CBD5E1"/>
            </linearGradient>
            <radialGradient id="helixBotEyeL" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(15 19) rotate(90) scale(4)">
                <stop stop-color="#67E8F9"/>
                <stop offset="1" stop-color="#0891B2"/>
            </radialGradient>
            <radialGradient id="helixBotEyeR" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(25 19) rotate(90) scale(4)">
                <stop stop-color="#A5B4FC"/>
                <stop offset="1" stop-color="#4F46E5"/>
            </radialGradient>
        </defs>
        <circle cx="20" cy="20" r="19" fill="url(#helixBotBg)"/>
        <circle cx="20" cy="20" r="19" stroke="rgba(255,255,255,0.22)" stroke-width="0.75"/>
        <rect x="11" y="8" width="3" height="5" rx="1.5" fill="#94A3B8"/>
        <rect x="26" y="8" width="3" height="5" rx="1.5" fill="#94A3B8"/>
        <circle cx="12.5" cy="7" r="2.2" fill="#FB923C"/>
        <circle cx="27.5" cy="7" r="2.2" fill="#F472B6"/>
        <rect x="11" y="14" width="18" height="14" rx="5" fill="url(#helixBotFace)" stroke="#E2E8F0" stroke-width="0.75"/>
        <rect x="14.5" y="17.5" width="4.5" height="4.5" rx="1.2" fill="url(#helixBotEyeL)"/>
        <rect x="21" y="17.5" width="4.5" height="4.5" rx="1.2" fill="url(#helixBotEyeR)"/>
        <circle cx="16.2" cy="18.8" r="0.9" fill="#FFFFFF" opacity="0.95"/>
        <circle cx="22.7" cy="18.8" r="0.9" fill="#FFFFFF" opacity="0.95"/>
        <path d="M15.5 24.5h9" stroke="#64748B" stroke-width="1.4" stroke-linecap="round"/>
        <rect x="14" y="29" width="12" height="5" rx="2.5" fill="#0F766E" stroke="#5EEAD4" stroke-width="0.6"/>
        <circle cx="17" cy="31.5" r="0.9" fill="#FDE047"/>
        <circle cx="20" cy="31.5" r="0.9" fill="#34D399"/>
        <circle cx="23" cy="31.5" r="0.9" fill="#F472B6"/>
    </svg>
</span>
{% endmacro %}
