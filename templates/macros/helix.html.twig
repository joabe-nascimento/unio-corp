{# Assistente virtual — avatar foto (Vitória / Lumen / Bruna conforme contexto) #}
{% macro face(size, src) %}
{% set s = size|default('md') %}
{% set _src = src|default('images/avatar.jpg') %}
<span class="helix-face helix-face--{{ s }}" aria-hidden="true">
    <img src="{{ asset(_src) }}" alt="">
</span>
{% endmacro %}

{% macro avatar(size, wave, src) %}
{% set s = size|default('sm') %}
{% set _wave = wave|default(false) %}
{% set _src = src|default('images/avatar.jpg') %}
<span class="helix-avatar helix-avatar--{{ s }}{{ _wave ? ' helix-avatar--wave' : '' }}" aria-hidden="true">
    <img src="{{ asset(_src) }}" alt="">
</span>
{% endmacro %}
