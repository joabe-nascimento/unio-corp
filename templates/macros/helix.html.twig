{# Assistente virtual Helix — avatar feminino ilustrado #}
{% macro face(size) %}
{% set s = size|default('md') %}
{% set uid = 'hf' ~ random(100000, 999999) %}
<span class="helix-face helix-face--{{ s }}" aria-hidden="true">
    {% include 'components/helix/woman_avatar_svg.html.twig' with { uid: uid } only %}
</span>
{% endmacro %}

{% macro avatar(size) %}
{% set s = size|default('sm') %}
{% set uid = 'ha' ~ random(100000, 999999) %}
<span class="helix-avatar helix-avatar--{{ s }}" aria-hidden="true">
    {% include 'components/helix/woman_avatar_svg.html.twig' with { uid: uid } only %}
</span>
{% endmacro %}
