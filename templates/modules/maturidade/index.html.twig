{% extends 'layout/hub.html.twig' %}
{% block title %}Painel de Recuperação{% endblock %}
{% block permissions_scope %}{% endblock %}
{% set hub_page_title = 'Painel de Recuperação' %}
{% set hub_page_eyebrow = 'Unio Clínica' %}
{% set hub_page_subtitle = 'Situação atual dos pacientes, alertas e protocolos pós-cirúrgicos' %}
{% set hub_show_tabs = true %}
{% set hub_use_clinic_tabs = true %}
{% set hub_clinic_tabs = [
    { id: 'overview', label: 'Alertas', hint: 'Monitoramento em tempo real' },
    { id: 'retornos', label: 'Próximos retornos', hint: 'Agenda de consultas' },
    { id: 'questionarios', label: 'Questionários', hint: 'Respostas dos pacientes' },
] %}

{% block hub_content %}
<div class="clinic-hub-overview">
    <div class="clinic-hub-block">
        <div class="clinic-hub-metrics">
            <article class="clinic-metric">
                <span class="clinic-metric__label">Pacientes ativos</span>
                <span class="clinic-metric__value">—</span>
            </article>
            <article class="clinic-metric">
                <span class="clinic-metric__label">Alertas críticos</span>
                <span class="clinic-metric__value">—</span>
            </article>
            <article class="clinic-metric">
                <span class="clinic-metric__label">Protocolos ativos</span>
                <span class="clinic-metric__value">—</span>
            </article>
            <article class="clinic-metric">
                <span class="clinic-metric__label">Questionários pendentes</span>
                <span class="clinic-metric__value">—</span>
            </article>
        </div>

        <section class="clinic-hub-panel clinic-hub-panel--main clinic-hub-panel--full">
            <header class="clinic-hub-panel__head">
                <div class="clinic-hub-panel__head-text">
                    <h2 class="clinic-hub-panel__title">Acompanhamento pós-cirúrgico</h2>
                    <p class="clinic-hub-panel__sub">Visão consolidada dos pacientes em recuperação</p>
                </div>
            </header>
            <div class="clinic-hub-panel__body clinic-hub-panel__body--placeholder">
                <div class="clinic-placeholder">
                    <span class="clinic-placeholder__icon"><i class="fas fa-person-walking-arrow-right"></i></span>
                    <p class="clinic-placeholder__title">Nenhum paciente em acompanhamento</p>
                    <p class="clinic-placeholder__sub">Cadastre o primeiro paciente para iniciar o monitoramento.</p>
                    <button type="button" class="clinic-placeholder__btn">
                        <i class="fas fa-user-plus" aria-hidden="true"></i> Novo paciente
                    </button>
                </div>
            </div>
        </section>

        <div class="clinic-hub-tab-panel">
            <div class="clinic-hub-subtab-panel__empty">
                <i class="fas fa-circle-check clinic-empty-check" aria-hidden="true"></i>
                <div>
                    <p class="clinic-hub-subtab-panel__title">Sem alertas ativos</p>
                    <p class="clinic-hub-subtab-panel__sub">Nenhum paciente precisa de atenção imediata no momento.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block hub_extra_panels %}
<div class="hub-tab-panel" data-hub-panel="retornos" role="tabpanel" hidden>
    <div class="clinic-hub-overview">
        <div class="clinic-hub-block">
            <div class="clinic-hub-tab-panel">
                <div class="clinic-hub-subtab-panel__empty">
                    <i class="fas fa-calendar-day clinic-empty-check clinic-empty-check--muted" aria-hidden="true"></i>
                    <div>
                        <p class="clinic-hub-subtab-panel__title">Agenda de retornos</p>
                        <p class="clinic-hub-subtab-panel__sub">Consulte pacientes em acompanhamento e questionários pendentes.</p>
                    </div>
                </div>
                <a href="{{ path('app_pos_operatorio_pacientes') }}" class="clinic-ficha-action">
                    <i class="fas fa-user-injured" aria-hidden="true"></i> Ver pacientes
                </a>
                <a href="{{ path('app_pos_operatorio_questionarios') }}" class="clinic-ficha-action">
                    <i class="fas fa-clipboard-list" aria-hidden="true"></i> Questionários pendentes
                </a>
            </div>
        </div>
    </div>
</div>

<div class="hub-tab-panel" data-hub-panel="questionarios" role="tabpanel" hidden>
    <div class="clinic-hub-overview">
        <div class="clinic-hub-block">
            <div class="clinic-hub-tab-panel">
                <div class="clinic-hub-subtab-panel__empty">
                    <i class="fas fa-circle-check clinic-empty-check" aria-hidden="true"></i>
                    <div>
                        <p class="clinic-hub-subtab-panel__title">Todos respondidos</p>
                        <p class="clinic-hub-subtab-panel__sub">Não há questionários pendentes de revisão clínica.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
