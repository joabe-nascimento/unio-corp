{% extends 'layout/hub.html.twig' %}
{% block title %}Núcleo de Maturidade{% endblock %}
{% block permissions_scope %}hub_maturidade{% endblock %}
{% set hub_page_title = 'Núcleo de Maturidade' %}
{% block hub_kpis %}
{% if scope_has_products('hub_maturidade') %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: '—', label: 'Nível Médio',      sub: 'Aguardando avaliação' },
        { value: '0',  label: 'Avaliações',       sub: 'Realizadas' },
        { value: '0',  label: 'Planos de Ação',   sub: 'Em andamento' },
        { value: '0',  label: 'Maturidade Alta',  sub: 'Colaboradores' },
    ], mb: 'mb-0' } %}
</div>
{% endif %}
{% endblock %}
{% block hub_content %}
{% if scope_has_products('hub_maturidade') %}
<div class="row hub-overview-grid">
    {% if product_grant('hub_maturidade', 'avaliacao') or product_grant('hub_maturidade', 'radar') %}
    <div class="col-md-7 mb-4 d-flex">
        <div class="unio-card flex-fill">
            {% include 'components/section_header.html.twig' with {
                title: 'Radar de Maturidade',
                subtitle: 'Visão geral por dimensão organizacional'
            } %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-bullseye',
                title: 'Radar não disponível',
                text: 'Realize a primeira avaliação para gerar o radar.',
                btn_label: product_grant('hub_maturidade', 'avaliacao') ? 'Iniciar Avaliação' : '',
                btn_href: path('app_maturidade_avaliacao'),
                compact: true
            } %}
        </div>
    </div>
    {% endif %}
    {% if product_grant('hub_maturidade', 'avaliacao') %}
    <div class="col-md-5 mb-4">
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with {
                title: 'Dimensões Avaliadas',
                subtitle: 'Clique para detalhar cada área'
            } %}
            {% for dim in ['Liderança','Cultura Organizacional','Processos','Tecnologia','Pessoas','Estratégia'] %}
            <div class="d-flex align-items-center justify-content-between py-2 perm-row">
                <span class="perm-label">{{ dim }}</span>
                <div class="d-flex align-items-center" style="gap:8px">
                    <div style="width:80px;height:4px;background:var(--border);border-radius:2px">
                        <div style="width:0%;height:100%;background:var(--accent);border-radius:2px"></div>
                    </div>
                    <span style="color:var(--text-3);font-size:11px;font-family:monospace">—</span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    {% if nav_show_modulo_publicidade|default(false) and scope_has_products('product_publicidade') %}
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Marca e Comunicação',
            subtitle: 'Campanhas, criativos, mídia e ROI',
            links: [
                { label: 'Campanhas',  route: 'app_publicidade_campanhas' },
                { label: 'Métricas',   route: 'app_publicidade_metricas' },
                { label: 'Abrir módulo', route: 'app_publicidade', primary: true },
            ]
        } %}
    </div>
    {% endif %}
</div>
{% else %}
    {% include 'components/hub_scope_empty.html.twig' with {
        icon: 'fa-bullseye',
        title: 'Nenhuma área disponível em Maturidade',
        text: 'Você ainda não tem permissão para acessar Avaliações, Radar ou Planos de Ação. Solicite ao gestor da equipe.'
    } %}
{% endif %}
{% endblock %}
