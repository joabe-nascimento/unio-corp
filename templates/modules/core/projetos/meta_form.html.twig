{# Legado: redireciona para index com offcanvas de meta aberto #}
{% extends 'layout/page_list.html.twig' %}
{% block title %}Nova meta{% endblock %}
{% set page_list_title = 'Nova meta' %}

{% block page_list_content %}
<div class="huplex-card">
    <p class="mb-3">Use o botão <strong>Nova meta</strong> na aba Metas para abrir o painel lateral.</p>
    <a href="{{ path('app_core_projetos', { view: 'metas', open_nova_meta: 1 }) }}" class="btn-huplex">Ir para Projetos e Metas</a>
</div>
{% endblock %}
