{#
  Campos do formulário de meta (offcanvas)

  Variáveis: rd (array), projetos (collection)
#}
{% set rd = rd|default({}) %}
{% set projeto_options = [{ value: '', label: 'Meta da plataforma (sem projeto)' }] %}
{% for p in projetos|default([]) %}
    {% set projeto_options = projeto_options|merge([{ value: p.id, label: p.nome }]) %}
{% endfor %}
{% include 'components/unio_form_field.html.twig' with { id: 'titulo', name: 'titulo', label: 'Título', value: rd.titulo|default(''), required: true } %}
{% include 'components/unio_form_field.html.twig' with { id: 'projeto_id', name: 'projeto_id', label: 'Projeto', type: 'select', value: rd.projeto_id|default(''), options: projeto_options } %}
{% include 'components/unio_form_field.html.twig' with { id: 'descricao', name: 'descricao', label: 'Descrição', type: 'textarea', value: rd.descricao|default('') } %}
{% include 'components/unio_form_field.html.twig' with {
    id: 'prioridade', name: 'prioridade', label: 'Prioridade', type: 'select', value: rd.prioridade|default('MEDIA'),
    options: [{ value: 'ALTA', label: 'Alta' }, { value: 'MEDIA', label: 'Média' }, { value: 'BAIXA', label: 'Baixa' }]
} %}
{% include 'components/unio_form_field.html.twig' with { id: 'progresso', name: 'progresso', label: 'Progresso %', value: rd.progresso|default('0') } %}
{% include 'components/unio_form_field.html.twig' with { id: 'data_alvo', name: 'data_alvo', label: 'Data alvo', type: 'date', value: rd.data_alvo|default('') } %}
