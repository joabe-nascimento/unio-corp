{% extends 'layout/page_list.html.twig' %}
{% block title %}Novo projeto{% endblock %}
{% set page_list_title = 'Novo projeto' %}
{% set rd = request_data|default({}) %}

{% block page_list_toolbar_actions %}
{% include 'components/page_back_link.html.twig' with { href: path('app_core_projetos') } %}
{% endblock %}

{% block page_list_content %}
{% embed 'components/huplex_form_panel.html.twig' with {
    subtitle: 'Ex.: "Hub Operações — layout", "Login Unio", "Módulo RH".',
    submit_label: 'Criar projeto'
} %}
    {% block form_panel_fields %}
        {% include 'components/huplex_form_field.html.twig' with { id: 'nome', name: 'nome', label: 'Nome', value: rd.nome|default(''), required: true } %}
        {% include 'components/huplex_form_field.html.twig' with { id: 'area', name: 'area', label: 'Área / módulo', value: rd.area|default(''), placeholder: 'Ex.: Hub Operações, Auth, Core UI' } %}
        {% include 'components/huplex_form_field.html.twig' with { id: 'codigo', name: 'codigo', label: 'Referência', value: rd.codigo|default('') } %}
        {% include 'components/huplex_form_field.html.twig' with { id: 'descricao', name: 'descricao', label: 'Descrição', type: 'textarea', value: rd.descricao|default('') } %}
        {% include 'components/huplex_form_field.html.twig' with {
            id: 'status', name: 'status', label: 'Status', type: 'select', value: rd.status|default('EM_ANDAMENTO'),
            options: [
                { value: 'IDEIA', label: 'Ideia' },
                { value: 'EM_ANDAMENTO', label: 'Em andamento' },
                { value: 'PAUSADO', label: 'Pausado' },
                { value: 'FEITO', label: 'Feito' },
            ]
        } %}
        {% include 'components/huplex_form_field.html.twig' with { id: 'cor', name: 'cor', label: 'Cor', value: rd.cor|default('#4F7FFF') } %}
        {% include 'components/huplex_form_field.html.twig' with { id: 'data_alvo', name: 'data_alvo', label: 'Meta de entrega', type: 'date', value: rd.data_alvo|default('') } %}
    {% endblock %}
{% endembed %}
{% endblock %}
