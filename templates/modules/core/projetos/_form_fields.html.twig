{#
  Campos do formulário de projeto (offcanvas e página legada)

  Variável: rd (array) dados do request para repopular
#}
{% set rd = rd|default({}) %}
<p class="section-subtitle mb-3">Ex.: &quot;Núcleo de Operações — layout&quot;, &quot;Login Unio&quot;, &quot;Módulo RH&quot;.</p>
{% include 'components/unio_form_field.html.twig' with { id: 'nome', name: 'nome', label: 'Nome', value: rd.nome|default(''), required: true } %}
{% include 'components/unio_form_field.html.twig' with { id: 'area', name: 'area', label: 'Área / módulo', value: rd.area|default(''), placeholder: 'Ex.: Núcleo de Operações, Auth, Core UI' } %}
{% include 'components/unio_form_field.html.twig' with { id: 'codigo', name: 'codigo', label: 'Referência', value: rd.codigo|default('') } %}
{% include 'components/unio_form_field.html.twig' with { id: 'descricao', name: 'descricao', label: 'Descrição', type: 'textarea', value: rd.descricao|default('') } %}
{% include 'components/unio_form_field.html.twig' with {
    id: 'status', name: 'status', label: 'Status', type: 'select', value: rd.status|default('EM_ANDAMENTO'),
    options: [
        { value: 'IDEIA', label: 'Ideia' },
        { value: 'EM_ANDAMENTO', label: 'Em andamento' },
        { value: 'PAUSADO', label: 'Pausado' },
        { value: 'FEITO', label: 'Feito' },
    ]
} %}
{% include 'components/unio_color_picker.html.twig' with { id: 'cor', name: 'cor', label: 'Cor do projeto', value: rd.cor|default('#4F7FFF') } %}
{% include 'components/unio_form_field.html.twig' with { id: 'data_alvo', name: 'data_alvo', label: 'Meta de entrega', type: 'date', value: rd.data_alvo|default('') } %}
