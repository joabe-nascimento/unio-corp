{% extends 'layout/hub.html.twig' %}
{% block title %}Clientes · Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Clientes' %}
{% set hub_page_subtitle = 'Núcleo Comercial · Contas' %}

{% block hub_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="crm-conta-nova">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Novo cliente
</button>
{% endblock %}

{% block hub_content %}
<div class="unio-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Contas',
        subtitle: (contas|length) ~ ' cliente(s)'
    } %}
    {% if contas|length == 0 %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-building',
            title: 'Nenhum cliente',
            text: 'Cadastre contas ou converta leads qualificados.',
            btn_label: 'Novo cliente',
            btn_opens: 'crm-conta-nova',
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="table unio-table mb-0">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Documento</th>
                    <th>Contato</th>
                    <th>Segmento</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for c in contas %}
                <tr>
                    <td><a href="{{ path('app_comercial_cliente_show', { id: c.id }) }}">{{ c.nome }}</a></td>
                    <td>{{ c.documento|default('—') }}</td>
                    <td class="small">{{ c.email|default('—') }}</td>
                    <td>{{ c.segmento|default('—') }}</td>
                    <td><span class="badge badge-soft">{{ c.status }}</span></td>
                    <td class="text-end"><a href="{{ path('app_comercial_cliente_show', { id: c.id }) }}" class="btn-unio-ghost btn-sm">Abrir</a></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block page_overlays %}
{% include 'components/comercial/conta_offcanvas.html.twig' with {
    open: open_novo|default(false),
    status_options: status_options
} %}
{% endblock %}
