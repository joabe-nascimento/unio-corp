{% extends 'layout/hub.html.twig' %}
{% block title %}Atividades · Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Atividades' %}
{% set hub_page_subtitle = 'Núcleo Comercial · Follow-ups' %}
{% set hub_page_eyebrow = org_clinic|default(false) ? (org_brand_label|default('Unio Saúde')) : '' %}
{% set hub_search_hidden = true %}
{% set tipo_labels = tipo_labels|default({}) %}
{% set tipo_tones = {
    ligacao: 'sky',
    reuniao: 'lavender',
    email: 'amber',
    tarefa: 'default',
    nota: 'success'
} %}

{% block hub_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="crm-atividade-nova">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Nova atividade
</button>
<a href="{{ path('app_comercial_pipeline') }}" class="btn-unio-ghost btn-sm">Pipeline</a>
{% endblock %}

{% set _ac = atividade_counts|default({}) %}
{% set _fq = filter_q|default('') %}
{% set _ft = filter_tipo|default('') %}
{% set _fv = filter_vencidas|default('') %}
{% set _hidden = {} %}
{% if _ft != '' %}{% set _hidden = _hidden|merge({ tipo: _ft }) %}{% endif %}
{% if _fv != '' %}{% set _hidden = _hidden|merge({ vencidas: _fv }) %}{% endif %}
{% set _qmerge = _fq ? { q: _fq } : {} %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_comercial_atividades'),
    show_search: true,
    use_form: true,
    search_placeholder: 'Buscar título, lead ou cliente…',
    search_name: 'q',
    search_value: _fq,
    hidden_fields: _hidden
} %}
    {% block filter_chips %}
    <div class="hub-page-filter-bar__chip-groups">
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar por tipo',
            chips: [
                { href: path('app_comercial_atividades', _qmerge|merge(_fv ? { vencidas: _fv } : {})), label: 'Todas', active: _ft == '', count: _ac.total|default(null) },
            ]|merge(
                tipo_options|map(tid => {
                    href: path('app_comercial_atividades', { tipo: tid }|merge(_qmerge)|merge(_fv ? { vencidas: _fv } : {})),
                    label: tipo_labels[tid]|default(tid),
                    active: _ft == tid,
                    count: _ac[tid]|default(null)
                })
            )
        } %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar por prazo',
            chips: [
                { href: path('app_comercial_atividades', _qmerge|merge(_ft ? { tipo: _ft } : {})), label: 'Todas', active: _fv == '' },
                { href: path('app_comercial_atividades', { vencidas: '1' }|merge(_qmerge)|merge(_ft ? { tipo: _ft } : {})), label: 'Vencidas', active: _fv == '1', count: _ac.vencidas|default(null) },
            ]
        } %}
    </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
<section class="unio-card p-0 ops-queue-animate">
    {% if atividades|length == 0 %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-list-check',
            title: 'Nada pendente',
            text: 'Registre uma ligação, reunião ou tarefa para acompanhar o funil.',
            btn_label: 'Nova atividade',
            btn_opens: 'crm-atividade-nova',
            btn_icon: 'fa-plus',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="table admin-table mb-0 align-middle clinic-stack-mobile">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Tipo</th>
                    <th>Vence</th>
                    <th>Vínculo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for a in atividades %}
                <tr>
                    <td data-label="Título">
                        <div class="fw-medium">{{ a.titulo }}</div>
                        {% if a.descricao %}<div class="small text-muted">{{ a.descricao|length > 80 ? a.descricao|slice(0, 80) ~ '…' : a.descricao }}</div>{% endif %}
                    </td>
                    <td data-label="Tipo">
                        <span class="badge-perfil {{ tipo_tones[a.tipo]|default('default') }}">{{ tipo_labels[a.tipo]|default(a.tipo) }}</span>
                    </td>
                    <td data-label="Vence">{{ a.venceEm ? a.venceEm|date('d/m/Y') : '—' }}</td>
                    <td data-label="Vínculo" class="small">
                        {% if a.lead %}Lead: {{ a.lead.nome }}{% elseif a.conta %}Cliente: {{ a.conta.nome }}{% else %}—{% endif %}
                    </td>
                    <td data-label="Ações" class="text-right text-nowrap">
                        <form method="post" action="{{ path('app_comercial_atividade_concluir', { id: a.id }) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('crm_atividade_done_' ~ a.id) }}">
                            <button type="submit" class="btn-unio btn-sm">Concluir</button>
                        </form>
                        <form method="post" action="{{ path('app_comercial_atividade_excluir', { id: a.id }) }}" class="d-inline" onsubmit="return confirm('Excluir esta atividade?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('crm_atividade_delete_' ~ a.id) }}">
                            <button type="submit" class="btn-unio-ghost btn-sm">Excluir</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}

{% block page_overlays %}
{% include 'components/comercial/atividade_offcanvas.html.twig' with {
    open: open_novo|default(false),
    tipo_options: tipo_options,
    tipo_labels: tipo_labels,
    leads: leads,
    contas: contas
} %}
{% endblock %}
