{% extends 'layout/hub.html.twig' %}
{% block title %}Leads · Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Leads' %}
{% set hub_page_subtitle = 'Núcleo Comercial · Captação' %}

{% block hub_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="crm-lead-novo">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Novo lead
</button>
{% endblock %}

{% block hub_content %}
<div class="unio-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Lista de leads',
        subtitle: filter_status ? 'Filtro: ' ~ filter_status : (leads|length) ~ ' registro(s)'
    } %}
    <div class="px-3 pb-2 d-flex flex-wrap gap-2">
        <a href="{{ path('app_comercial_leads') }}" class="btn-unio-ghost btn-sm{{ filter_status == '' ? ' is-active' : '' }}">Todos</a>
        {% for s in status_options %}
        <a href="{{ path('app_comercial_leads', { status: s }) }}" class="btn-unio-ghost btn-sm{{ filter_status == s ? ' is-active' : '' }}">{{ s }}</a>
        {% endfor %}
    </div>
    {% if leads|length == 0 %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-user-plus',
            title: 'Sem leads',
            text: 'Crie o primeiro lead para alimentar o pipeline.',
            btn_label: 'Novo lead',
            btn_opens: 'crm-lead-novo',
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="table unio-table mb-0">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Empresa</th>
                    <th>Contato</th>
                    <th>Status</th>
                    <th>Origem</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for lead in leads %}
                <tr>
                    <td><a href="{{ path('app_comercial_lead_show', { id: lead.id }) }}">{{ lead.nome }}</a></td>
                    <td>{{ lead.empresaNome|default('—') }}</td>
                    <td class="small">{{ lead.email|default('—') }}{% if lead.telefone %}<br>{{ lead.telefone }}{% endif %}</td>
                    <td><span class="badge badge-soft">{{ lead.status }}</span></td>
                    <td>{{ lead.origem }}</td>
                    <td class="text-end">
                        <a href="{{ path('app_comercial_lead_show', { id: lead.id }) }}" class="btn-unio-ghost btn-sm">Abrir</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block page_overlays %}
{% include 'components/comercial/lead_offcanvas.html.twig' with {
    open: open_novo|default(false),
    origem_options: origem_options,
    status_options: status_options
} %}
{% endblock %}
