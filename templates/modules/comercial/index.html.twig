{% extends 'layout/hub.html.twig' %}
{% block title %}Núcleo Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Núcleo Comercial' %}
{% set hub_page_subtitle = 'CRM · Leads, pipeline e clientes' %}
{% set hub_page_eyebrow = org_clinic|default(false) ? (org_brand_label|default('Unio Saúde')) : '' %}
{% set status_tones = {
    novo: 'sky',
    qualificando: 'amber',
    qualificado: 'success',
    descartado: 'default',
    convertido: 'success'
} %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_comercial_leads', { novo: 1 }) }}" class="btn-unio btn-sm">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Novo lead
</a>
<a href="{{ path('app_comercial_pipeline') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-diagram-project mr-1" aria-hidden="true"></i> Pipeline
</a>
{% endblock %}

{% block hub_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: kpis, mb: 'mb-0' } %}
</div>
{% endblock %}

{% block hub_content %}
<div class="row g-4">
    <div class="col-xl-8">
        {% set module_items = [] %}
        {% for m in modules %}
            {% set module_items = module_items|merge([{
                icon: m.icon,
                title: m.label,
                subtitle: m.subtitle,
                route: m.route
            }]) %}
        {% endfor %}
        {% include 'components/module_grid.html.twig' with {
            title: 'Módulos do CRM',
            subtitle: 'Pack completo — captação até fechamento',
            items: module_items,
            cols: 2
        } %}

        <div class="unio-card mt-4 p-0 ops-queue-animate">
            {% include 'components/section_header.html.twig' with {
                title: 'Leads recentes',
                subtitle: 'Últimas atualizações',
                btn_label: 'Ver todos',
                btn_href: path('app_comercial_leads'),
                btn_ghost: true
            } %}
            {% if recent_leads|length == 0 %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'fa-user-plus',
                    title: 'Ainda sem leads',
                    text: 'Cadastre o primeiro contato ou carregue dados de demonstração.',
                    btn_label: 'Novo lead',
                    btn_href: path('app_comercial_leads', { novo: 1 }),
                    btn_sm: true,
                    compact: true
                } %}
                <div class="px-3 pb-3">
                    <a href="{{ path('app_comercial', { seed: 1 }) }}" class="btn-unio-ghost btn-sm">Carregar demo CRM</a>
                </div>
            {% else %}
            <div class="table-responsive">
                <table class="table admin-table mb-0 clinic-stack-mobile">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Empresa</th>
                            <th>Situação</th>
                            <th>Origem</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for lead in recent_leads %}
                        <tr>
                            <td data-label="Nome"><a href="{{ path('app_comercial_lead_show', { id: lead.id }) }}"><strong>{{ lead.nome }}</strong></a></td>
                            <td data-label="Empresa">{{ lead.empresaNome|default('—') }}</td>
                            <td data-label="Situação">
                                <span class="badge-perfil {{ status_tones[lead.status]|default('default') }}">{{ status_labels[lead.status]|default(lead.status) }}</span>
                            </td>
                            <td data-label="Origem">{{ origem_labels[lead.origem]|default(lead.origem) }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="col-xl-4">
        <div class="unio-card mb-4">
            {% include 'components/section_header.html.twig' with {
                title: 'Atividades pendentes',
                subtitle: 'Próximas ações',
                btn_label: 'Ver',
                btn_href: path('app_comercial_atividades'),
                btn_ghost: true
            } %}
            {% if pending_atividades|length == 0 %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'fa-list-check',
                    title: 'Nada pendente',
                    text: 'Registre um follow-up quando precisar.',
                    btn_label: 'Nova atividade',
                    btn_href: path('app_comercial_atividades', { novo: 1 }),
                    btn_sm: true,
                    compact: true
                } %}
            {% else %}
            <ul class="list-unstyled mb-0 px-3 pb-3">
                {% for a in pending_atividades %}
                <li class="d-flex justify-content-between align-items-start gap-2 py-2 border-bottom">
                    <div>
                        <div class="fw-medium">{{ a.titulo }}</div>
                        <div class="small text-muted">{{ tipo_labels[a.tipo]|default(a.tipo) }}{% if a.venceEm %} · {{ a.venceEm|date('d/m/Y') }}{% endif %}</div>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>

        <div class="unio-card">
            {% include 'components/section_header.html.twig' with {
                title: 'Pipeline (resumo)',
                subtitle: 'Oportunidades por estágio',
                btn_label: 'Abrir',
                btn_href: path('app_comercial_pipeline'),
                btn_ghost: true
            } %}
            <ul class="list-unstyled mb-0 px-3 pb-3">
                {% for stage, items in pipeline_preview %}
                    {% if stage not in ['ganho', 'perdido'] or items|length > 0 %}
                    <li class="d-flex justify-content-between py-1">
                        <span>{{ stage_meta[stage].label|default(stage) }}</span>
                        <strong>{{ items|length }}</strong>
                    </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
