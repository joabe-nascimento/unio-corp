{% extends 'layout/hub.html.twig' %}
{% block title %}Analytics · Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Analytics comercial' %}
{% set hub_page_subtitle = 'Núcleo Comercial · Funil e conversão' %}

{% block hub_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: analytics.leads_total, label: 'Leads', sub: analytics.leads_convertidos ~ ' convertidos' },
        { value: analytics.conversao_lead_pct is not null ? analytics.conversao_lead_pct ~ '%' : '—', label: 'Conversão lead', sub: 'Lead → cliente' },
        { value: analytics.win_rate_pct is not null ? analytics.win_rate_pct ~ '%' : '—', label: 'Win rate', sub: 'Ganho / fechados' },
        { value: 'R$ ' ~ (analytics.pipeline_valor|number_format(0, ',', '.')), label: 'Pipeline', sub: 'Valor em aberto' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block hub_content %}
<div class="row g-4">
    <div class="col-md-6">
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Leads por origem', subtitle: 'Captação' } %}
            <ul class="list-unstyled mb-0 px-3 pb-3">
                {% for origem, qtd in analytics.by_origem %}
                <li class="d-flex justify-content-between py-1 border-bottom">
                    <span>{{ analytics.origem_labels[origem]|default(origem) }}</span>
                    <strong>{{ qtd }}</strong>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Funil por estágio', subtitle: 'Oportunidades' } %}
            <ul class="list-unstyled mb-0 px-3 pb-3">
                {% for stage, qtd in analytics.by_stage %}
                <li class="d-flex justify-content-between py-1 border-bottom">
                    <span>{{ analytics.stage_meta[stage].label|default(stage) }}</span>
                    <strong>{{ qtd }}</strong>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
