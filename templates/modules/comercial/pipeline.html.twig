{% extends 'layout/hub.html.twig' %}
{% block title %}Pipeline · Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Pipeline' %}
{% set hub_page_subtitle = 'Núcleo Comercial · Oportunidades' %}

{% block hub_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="crm-oportunidade-nova">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Nova oportunidade
</button>
{% endblock %}

{% block hub_content %}
<div class="crm-pipeline-board" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;align-items:start">
    {% for stage in stages %}
    {% set items = pipeline_board[stage]|default([]) %}
    <div class="unio-card" style="min-height:220px">
        {% include 'components/section_header.html.twig' with {
            title: stage_meta[stage].label|default(stage),
            subtitle: items|length ~ ' oportunidade(s)'
        } %}
        <div class="px-2 pb-2">
            {% if items|length == 0 %}
            <p class="text-muted small px-2">Vazio</p>
            {% else %}
                {% for op in items %}
                <div class="unio-card mb-2 p-2" style="box-shadow:none;border:1px solid var(--unio-border, #e5e7eb)">
                    <a href="{{ path('app_comercial_oportunidade_show', { id: op.id }) }}" class="fw-medium d-block mb-1">{{ op.titulo }}</a>
                    <div class="small text-muted mb-2">
                        {% if op.valor %}R$ {{ op.valor|number_format(2, ',', '.') }} · {% endif %}{{ op.probabilidade }}%
                    </div>
                    <form method="post" action="{{ path('app_comercial_oportunidade_mover', { id: op.id }) }}" class="d-flex gap-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('crm_oportunidade_move_' ~ op.id) }}">
                        <select name="estagio" class="form-control form-control-sm" onchange="this.form.submit()">
                            {% for s in stages %}
                            <option value="{{ s }}" {% if op.estagio == s %}selected{% endif %}>{{ stage_meta[s].label|default(s) }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}

{% block page_overlays %}
{% include 'components/comercial/oportunidade_offcanvas.html.twig' with {
    open: open_novo|default(false),
    stages: stages,
    stage_meta: stage_meta,
    contas: contas,
    leads: leads
} %}
{% endblock %}
