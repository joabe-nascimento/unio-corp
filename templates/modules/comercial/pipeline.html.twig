{% extends 'layout/hub.html.twig' %}
{% block title %}Pipeline · Comercial{% endblock %}
{% block permissions_scope %}hub_comercial{% endblock %}
{% set hub_page_title = 'Pipeline' %}
{% set hub_page_subtitle = 'Núcleo Comercial · Oportunidades' %}

{% set stage_icons = {
    lead: 'fa-user-plus',
    qualificacao: 'fa-comments',
    proposta: 'fa-file-invoice',
    negociacao: 'fa-handshake',
    ganho: 'fa-trophy',
    perdido: 'fa-xmark'
} %}

{% set open_items = (pipeline_board.lead|default([]))
    |merge(pipeline_board.qualificacao|default([]))
    |merge(pipeline_board.proposta|default([]))
    |merge(pipeline_board.negociacao|default([])) %}
{% set open_count = open_items|length %}
{% set _open_sum = namespace({ v: 0 }) %}
{% for op in open_items %}
    {% set _open_sum.v = _open_sum.v + (op.valor ? op.valor * 1 : 0) %}
{% endfor %}
{% set open_value = _open_sum.v %}
{% set won_count = pipeline_board.ganho|default([])|length %}
{% set lost_count = pipeline_board.perdido|default([])|length %}

{% block hub_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="crm-oportunidade-nova">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Nova oportunidade
</button>
{% endblock %}

{% block hub_content %}
<div class="crm-pipeline">
    <div class="crm-pipeline__summary" aria-label="Resumo do pipeline">
        <div class="crm-pipeline__stat">
            <span class="crm-pipeline__stat-label">Em aberto</span>
            <strong class="crm-pipeline__stat-value">{{ open_count }}</strong>
        </div>
        <div class="crm-pipeline__stat">
            <span class="crm-pipeline__stat-label">Pipeline</span>
            <strong class="crm-pipeline__stat-value">R$ {{ open_value|number_format(2, ',', '.') }}</strong>
        </div>
        <div class="crm-pipeline__stat crm-pipeline__stat--ok">
            <span class="crm-pipeline__stat-label">Ganhas</span>
            <strong class="crm-pipeline__stat-value">{{ won_count }}</strong>
        </div>
        <div class="crm-pipeline__stat crm-pipeline__stat--muted">
            <span class="crm-pipeline__stat-label">Perdidas</span>
            <strong class="crm-pipeline__stat-value">{{ lost_count }}</strong>
        </div>
    </div>

    <div class="crm-pipeline__board kanban-board" role="list" aria-label="Estágios do pipeline">
        {% for stage in stages %}
        {% set items = pipeline_board[stage]|default([]) %}
        {% set meta = stage_meta[stage]|default({ label: stage, tone: 'sky' }) %}
        {% set _col_sum = namespace({ v: 0 }) %}
        {% for op in items %}
            {% set _col_sum.v = _col_sum.v + (op.valor ? op.valor * 1 : 0) %}
        {% endfor %}
        {% set col_value = _col_sum.v %}

        <section class="crm-pipeline__col kanban-column crm-pipeline__col--{{ meta.tone|default('sky') }}" role="listitem" aria-label="{{ meta.label }}">
            <header class="crm-pipeline__col-head kanban-column-header">
                <div class="crm-pipeline__col-title">
                    <span class="crm-pipeline__col-dot" aria-hidden="true"></span>
                    <span class="crm-pipeline__col-label">
                        <i class="fas {{ stage_icons[stage]|default('fa-circle') }}" aria-hidden="true"></i>
                        {{ meta.label|default(stage) }}
                    </span>
                </div>
                <div class="crm-pipeline__col-meta">
                    {% if items|length > 0 and col_value > 0 %}
                    <span class="crm-pipeline__col-sum" title="Soma do estágio">R$ {{ col_value|number_format(0, ',', '.') }}</span>
                    {% endif %}
                    <span class="kanban-column-count">{{ items|length }}</span>
                </div>
            </header>

            <div class="crm-pipeline__col-body kanban-column-body">
                <div class="kanban-column-cards">
                    {% if items|length == 0 %}
                    <div class="crm-pipeline__empty">
                        <i class="fas fa-inbox" aria-hidden="true"></i>
                        <p>Vazio</p>
                        {% if stage == 'lead' %}
                        <button type="button" class="btn-unio-ghost btn-sm" data-unio-offcanvas-open="crm-oportunidade-nova">
                            <i class="fas fa-plus mr-1" aria-hidden="true"></i> Nova
                        </button>
                        {% endif %}
                    </div>
                    {% else %}
                        {% for op in items %}
                        <article class="crm-pipeline__card kanban-card">
                            <a href="{{ path('app_comercial_oportunidade_show', { id: op.id }) }}" class="crm-pipeline__card-title">
                                {{ op.titulo }}
                            </a>

                            {% if op.conta or op.lead %}
                            <p class="crm-pipeline__card-sub">
                                {% if op.conta %}{{ op.conta.nome }}{% elseif op.lead %}{{ op.lead.nome }}{% endif %}
                            </p>
                            {% endif %}

                            <div class="crm-pipeline__card-metrics">
                                <span class="crm-pipeline__card-value">
                                    {% if op.valor %}R$ {{ op.valor|number_format(2, ',', '.') }}{% else %}Sem valor{% endif %}
                                </span>
                                <span class="crm-pipeline__card-prob">{{ op.probabilidade }}%</span>
                            </div>
                            <div class="crm-pipeline__prob-bar" aria-hidden="true">
                                <span style="width: {{ op.probabilidade }}%"></span>
                            </div>

                            {% if op.fechaPrevista %}
                            <p class="crm-pipeline__card-date">
                                <i class="fas fa-calendar-day" aria-hidden="true"></i>
                                Fecha {{ op.fechaPrevista|date('d/m/Y') }}
                            </p>
                            {% endif %}

                            <div class="crm-pipeline__card-foot">
                                <form method="post" action="{{ path('app_comercial_oportunidade_mover', { id: op.id }) }}" class="crm-pipeline__move">
                                    <input type="hidden" name="_token" value="{{ csrf_token('crm_oportunidade_move_' ~ op.id) }}">
                                    <label class="sr-only" for="crm-move-{{ op.id }}">Mover estágio</label>
                                    <select id="crm-move-{{ op.id }}" name="estagio" class="crm-pipeline__move-select" onchange="this.form.submit()" title="Mover para…">
                                        {% for s in stages %}
                                        <option value="{{ s }}" {% if op.estagio == s %}selected{% endif %}>
                                            {{ op.estagio == s ? 'Estágio atual' : '→ ' ~ (stage_meta[s].label|default(s)) }}
                                        </option>
                                        {% endfor %}
                                    </select>
                                </form>
                                <a href="{{ path('app_comercial_oportunidade_show', { id: op.id }) }}" class="crm-pipeline__card-open" title="Abrir">
                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    <span class="sr-only">Abrir</span>
                                </a>
                            </div>
                        </article>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </section>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block page_overlays %}
{% include 'components/comercial/oportunidade_offcanvas.html.twig' with {
    open: open_novo|default(false),
    stages: stages,
    stage_meta: stage_meta,
    contas: contas,
    leads: leads
} %}
{% endblock %}
