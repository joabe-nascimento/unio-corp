{% extends 'layout/page_list.html.twig' %}
{% set _crm = organismo.enabled|default(false) and not org_clinic|default(false) %}
{% block title %}{{ _crm ? 'Clientes' : 'Empresas' }} — Administração{% endblock %}
{% set page_list_title = _crm ? 'Clientes' : 'Empresas' %}
{% set page_list_actions_in_top = true %}

{% block page_list_section_toolbar %}
<form method="get" action="{{ path('app_admin_empresas') }}" style="display:contents;">
{% embed 'components/section_toolbar.html.twig' with {
    btn_label: _crm ? 'Novo cliente' : 'Nova empresa',
    btn_icon: 'fa-plus',
    btn_opens: 'admin-nova-empresa',
    search_in_section: true,
    search_placeholder: _crm ? 'Buscar por nome, documento ou segmento…' : 'Buscar por nome, CNPJ ou setor…',
    search_name: 'q',
    search_value: busca
} %}
    {% block section_toolbar_filters %}
        {% include 'components/toolbar_filter_actions.html.twig' with {
            clear_href: path('app_admin_empresas'),
            has_filters: busca is not empty
        } %}
    {% endblock %}
{% endembed %}
</form>
{% endblock %}

{% block page_list_content %}
{% if empresas is empty %}
    {% include 'components/empty_state.html.twig' with {
        icon: _crm ? 'fa-handshake' : 'fa-building-slash',
        title: _crm ? 'Nenhum cliente encontrado' : 'Nenhuma empresa encontrada',
        text: _crm ? 'Ajuste o filtro ou cadastre um novo cliente.' : 'Ajuste o filtro ou cadastre uma nova empresa.'
    } %}
{% else %}
<div class="unio-card p-0">
    <table class="admin-table">
        <thead>
            <tr>
                <th>{{ _crm ? 'Cliente' : 'Empresa' }}</th>
                <th>{{ _crm ? 'CNPJ / Documento' : 'CNPJ' }}</th>
                <th>{{ _crm ? 'Segmento' : 'Setor' }}</th>
                <th>{{ _crm ? 'Contatos' : 'Usuários' }}</th>
                <th>Status</th>
                <th>{{ _crm ? 'Desde' : 'Cadastro' }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for e in empresas %}
        <tr class="admin-table-row{{ not e.ativo ? ' admin-table-row--inactive' : '' }}">
            <td><div class="admin-user-name">{{ e.nome }}</div></td>
            <td class="admin-table-mono">{{ e.cnpj }}</td>
            <td>{{ e.setor|default('—') }}</td>
            <td>{{ e.usuarios|length }}</td>
            <td>
                {% if e.ativo %}
                    {% include 'components/status_badge.html.twig' with { label: 'Ativo', variant: 'success' } %}
                {% else %}
                    {% include 'components/status_badge.html.twig' with { label: 'Inativo', variant: 'secondary' } %}
                {% endif %}
            </td>
            <td class="admin-table-date">{{ e.criadoEm|date('d/m/Y') }}</td>
            <td class="admin-table-actions">
                <button type="button"
                        class="btn-unio-ghost btn-xs"
                        data-admin-edit-empresa="{{ e.id }}"
                        data-nome="{{ e.nome|e('html_attr') }}"
                        data-cnpj="{{ e.cnpj|e('html_attr') }}"
                        data-setor="{{ e.setor|default('')|e('html_attr') }}"
                        data-ativo="{{ e.ativo ? '1' : '0' }}"
                        title="Editar">
                    <i class="fas fa-pen" aria-hidden="true"></i>
                </button>
                <form method="post" action="{{ path('app_admin_empresa_acao', { id: e.id }) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_acao }}">
                    <input type="hidden" name="acao" value="{{ e.ativo ? 'desativar' : 'ativar' }}">
                    <button type="submit"
                            class="btn-unio-ghost btn-xs {{ e.ativo ? 'btn-danger-ghost' : '' }}"
                            title="{{ e.ativo ? 'Desativar' : 'Ativar' }}"
                            onclick="return confirm('{{ e.ativo ? 'Desativar' : 'Ativar' }} {{ _crm ? 'cliente' : 'empresa' }} {{ e.nome|e('js') }}?')">
                        <i class="fas {{ e.ativo ? 'fa-ban' : 'fa-check-circle' }}" aria-hidden="true"></i>
                    </button>
                </form>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
<p class="admin-list-count">
    {{ empresas|length }}
    {{ _crm
        ? (empresas|length != 1 ? 'clientes encontrados' : 'cliente encontrado')
        : (empresas|length != 1 ? 'empresas encontradas' : 'empresa encontrada')
    }}
</p>
{% endblock %}

{% block page_overlays %}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'admin-nova-empresa',
    title: _crm ? 'Novo cliente' : 'Nova Empresa',
    subtitle: _crm ? 'Cadastre um cliente e acompanhe a relação comercial' : 'Cadastre um tenant ou empresa',
    icon: _crm ? 'fa-handshake' : 'fa-building-circle-check',
    size: 'md',
    open: app.request.query.getBoolean('open_novo')
} %}
    {% block offcanvas_body %}
    <form method="post" action="{{ path('app_admin_empresa_nova') }}" class="unio-form" id="adminNovaEmpresaForm">
        <input type="hidden" name="_token" value="{{ csrf_form }}">
        {% include 'components/unio_form_field.html.twig' with {
            id: 'nova_empresa_nome', name: 'nome', label: _crm ? 'Nome do cliente' : 'Nome da empresa',
            placeholder: _crm ? 'Ex.: União Médica' : 'Ex.: Unio Demo', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'nova_empresa_cnpj', name: 'cnpj', label: _crm ? 'CNPJ / Documento' : 'CNPJ',
            placeholder: '00.000.000/0001-00', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'nova_empresa_setor', name: 'setor', label: _crm ? 'Segmento' : 'Setor',
            placeholder: _crm ? 'Ex.: Saúde, Educação, Varejo' : 'Ex.: Tecnologia'
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'nova_empresa_logo', name: 'logo', label: 'Logo (URL)',
            placeholder: 'https://…/logo.png'
        } %}
    </form>
    {% endblock %}
    {% block offcanvas_footer %}
    <div class="unio-offcanvas-footer">
        <button type="submit" form="adminNovaEmpresaForm" class="btn-unio">
            <i class="fas fa-check mr-1"></i> {{ _crm ? 'Cadastrar cliente' : 'Cadastrar' }}
        </button>
        <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
    </div>
    {% endblock %}
{% endembed %}

{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'admin-editar-empresa',
    title: _crm ? 'Editar cliente' : 'Editar Empresa',
    icon: 'fa-pen-to-square',
    size: 'md'
} %}
    {% block offcanvas_body %}
    <form method="post"
          action="{{ path('app_admin_empresa_editar', { id: 0 }) }}"
          class="unio-form"
          id="adminEditarEmpresaForm">
        <input type="hidden" name="_token" value="{{ csrf_form }}">
        {% include 'components/unio_form_field.html.twig' with {
            id: 'edit_empresa_nome', name: 'nome', label: _crm ? 'Nome do cliente' : 'Nome da empresa', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'edit_empresa_cnpj', name: 'cnpj', label: _crm ? 'CNPJ / Documento' : 'CNPJ',
            placeholder: 'Deixe em branco para manter'
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'edit_empresa_setor', name: 'setor', label: _crm ? 'Segmento' : 'Setor',
            placeholder: _crm ? 'Ex.: Saúde, Educação' : 'Ex.: Tecnologia'
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'edit_empresa_logo', name: 'logo', label: 'Logo (URL)',
            placeholder: 'https://…/logo.png'
        } %}
        <div class="unio-form-group">
            <label class="unio-form-check d-flex align-items-center gap-2" for="edit_empresa_ativo">
                <input type="checkbox" id="edit_empresa_ativo" name="ativo" value="1" class="unio-checkbox">
                <span>{{ _crm ? 'Cliente ativo' : 'Empresa ativa' }}</span>
            </label>
        </div>
    </form>
    {% endblock %}
    {% block offcanvas_footer %}
    <div class="unio-offcanvas-footer">
        <button type="submit" form="adminEditarEmpresaForm" class="btn-unio">
            <i class="fas fa-check mr-1"></i> Salvar alterações
        </button>
        <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
    </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';
    var editForm   = document.getElementById('adminEditarEmpresaForm');
    var baseAction = editForm ? editForm.action : '';
    document.querySelectorAll('[data-admin-edit-empresa]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (!editForm) { return; }
            editForm.action = baseAction.replace('/0/', '/' + btn.dataset.adminEditEmpresa + '/');
            editForm.querySelector('[name="nome"]').value  = btn.dataset.nome;
            editForm.querySelector('[name="cnpj"]').value  = '';
            editForm.querySelector('[name="setor"]').value = btn.dataset.setor || '';
            editForm.querySelector('[name="logo"]').value  = btn.dataset.logo || '';
            var chk = editForm.querySelector('[name="ativo"]');
            if (chk) { chk.checked = btn.dataset.ativo === '1'; }
            window.UnioOffcanvas && window.UnioOffcanvas.open('admin-editar-empresa');
        });
    });
}());
</script>
{% endblock %}
