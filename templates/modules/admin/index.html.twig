{% extends 'base.html.twig' %}
{% block title %}Administração{% endblock %}
{% block page_title %}Administração{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Admin</li>{% endblock %}
{% block content %}

<div class="row stats-row">
    <div class="col-md-4 mb-2 d-flex">
        <a href="{{ path('app_admin_usuarios') }}" class="text-decoration-none d-flex w-100">
            <div class="huplex-card w-100" style="min-height:120px;padding:20px">
                <div class="card-icon mb-3"><i class="fas fa-user-cog"></i></div>
                <div class="section-title" style="font-size:15px">Usuários</div>
                <div class="section-subtitle mt-1">Gerencie acessos e perfis</div>
            </div>
        </a>
    </div>
    {% if is_granted('ROLE_TENANT') %}
    <div class="col-md-4 mb-2 d-flex">
        <a href="{{ path('app_admin_empresas') }}" class="text-decoration-none d-flex w-100">
            <div class="huplex-card w-100" style="min-height:120px;padding:20px">
                <div class="card-icon mb-3"><i class="fas fa-building"></i></div>
                <div class="section-title" style="font-size:15px">Empresas</div>
                <div class="section-subtitle mt-1">Tenants e empresas cadastradas</div>
            </div>
        </a>
    </div>
    {% endif %}
    <div class="col-md-4 mb-2 d-flex">
        <a href="{{ path('app_admin_configuracoes') }}" class="text-decoration-none d-flex w-100">
            <div class="huplex-card w-100" style="min-height:120px;padding:20px">
                <div class="card-icon mb-3"><i class="fas fa-sliders"></i></div>
                <div class="section-title" style="font-size:15px">Configurações</div>
                <div class="section-subtitle mt-1">Parâmetros da plataforma</div>
            </div>
        </a>
    </div>
</div>
{% endblock %}
