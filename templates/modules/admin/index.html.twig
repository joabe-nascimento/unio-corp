{% extends 'layout/hub.html.twig' %}
{% block title %}Administração{% endblock %}
{% block permissions_scope %}hub_admin{% endblock %}
{% set hub_page_title = 'Administração' %}

{% block hub_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: total_usuarios, label: 'Usuários', sub: 'Total cadastrado' },
        { value: total_ativos,   label: 'Ativos',   sub: 'Com acesso' },
        { value: total_empresas, label: 'Empresas', sub: 'Cadastradas' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block hub_content %}
<div class="row hub-action-grid stats-row">
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Usuários',
            subtitle: 'Gerencie acessos e perfis',
            route: 'app_admin_usuarios',
            icon: 'fa-user-shield'
        } %}
    </div>
    {% if is_granted('ROLE_PLATFORM_OWNER') %}
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Operações',
            subtitle: 'Logs, deploy e saúde do ambiente',
            route: 'app_admin_operacoes',
            icon: 'fa-server'
        } %}
    </div>
    {% endif %}
    {% if is_granted('ROLE_TENANT') %}
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Empresas',
            subtitle: 'Tenants e empresas cadastradas',
            route: 'app_admin_empresas',
            icon: 'fa-building'
        } %}
    </div>
    {% endif %}
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Configurações',
            subtitle: 'Parâmetros da plataforma',
            route: 'app_admin_configuracoes',
            icon: 'fa-sliders'
        } %}
    </div>
</div>
{% endblock %}
