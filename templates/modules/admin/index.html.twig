{% extends 'layout/hub.html.twig' %}
{% block title %}Administração{% endblock %}
{% block permissions_scope %}hub_admin{% endblock %}
{% set hub_page_title = 'Administração' %}
{% block hub_content %}
<div class="row stats-row">
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Usuários',
            subtitle: 'Gerencie acessos e perfis',
            route: 'app_admin_usuarios',
            icon: 'fa-user-shield'
        } %}
    </div>
    {% if is_granted('ROLE_TENANT') %}
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Empresas',
            subtitle: 'Tenants e empresas cadastradas',
            route: 'app_admin_empresas',
            icon: 'fa-building'
        } %}
    </div>
    {% endif %}
    <div class="col-md-4 mb-2 d-flex">
        {% include 'components/action_card.html.twig' with {
            title: 'Configurações',
            subtitle: 'Parâmetros da plataforma',
            route: 'app_admin_configuracoes',
            icon: 'fa-sliders'
        } %}
    </div>
</div>
{% endblock %}
