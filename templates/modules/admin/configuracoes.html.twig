{% extends 'layout/hub.html.twig' %}
{% block title %}Configurações — Administração{% endblock %}
{% block permissions_scope %}hub_admin{% endblock %}
{% set hub_page_title = 'Configurações' %}
{% set hub_actions_before_title = true %}
{% set hub_page_body_mode = 'scroll' %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_admin') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left" aria-hidden="true"></i> Admin
</a>
{% endblock %}

{% block hub_content %}
<div class="cfg-layout">

    {# ── Sidebar de navegação ── #}
    <nav class="cfg-sidebar" id="cfgSidebar" aria-label="Seções de configuração">
        <a href="#cfg-plataforma"  class="cfg-sidebar-item cfg-sidebar-item--active" data-cfg-nav="plataforma">
            <i class="fas fa-paint-brush" aria-hidden="true"></i> Identidade
        </a>
        <a href="#cfg-contato"     class="cfg-sidebar-item" data-cfg-nav="contato">
            <i class="fas fa-headset" aria-hidden="true"></i> Contato &amp; Suporte
        </a>
        <a href="#cfg-seguranca"   class="cfg-sidebar-item" data-cfg-nav="seguranca">
            <i class="fas fa-shield-halved" aria-hidden="true"></i> Segurança
        </a>
        <a href="#cfg-manutencao"  class="cfg-sidebar-item" data-cfg-nav="manutencao">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i> Manutenção
        </a>
        <a href="#cfg-sistema"     class="cfg-sidebar-item" data-cfg-nav="sistema">
            <i class="fas fa-server" aria-hidden="true"></i> Sistema
        </a>
    </nav>

    {# ── Conteúdo das seções ── #}
    <div class="cfg-content">

        <form method="post" action="{{ path('app_admin_configuracoes') }}" class="unio-form" id="cfgForm"
              enctype="multipart/form-data"
              data-upload-max="{{ config.upload_max|default('32M') }}"
              data-post-max="{{ config.post_max|default('48M') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_config') }}">

        {# ── 1. Identidade da Plataforma ── #}
        <section class="cfg-section cfg-section--visible" id="cfg-plataforma" data-cfg-section="plataforma">
            <div class="cfg-section-header">
                <div class="cfg-section-icon"><i class="fas fa-paint-brush" aria-hidden="true"></i></div>
                <div>
                    <h2 class="cfg-section-title">Identidade da plataforma</h2>
                    <p class="cfg-section-sub">Nome, marca e aparência exibidos na interface.</p>
                </div>
            </div>

            <div class="cfg-fields">
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'cfg_plataforma_nome',
                    name: 'plataforma_nome',
                    label: 'Nome da plataforma',
                    value: config.plataforma_nome|default('Unio'),
                    placeholder: 'Ex.: Unio'
                } %}

                {% include 'components/unio_form_field.html.twig' with {
                    id: 'cfg_plataforma_tagline',
                    name: 'plataforma_tagline',
                    label: 'Tagline',
                    value: config.plataforma_tagline|default(''),
                    placeholder: 'Ex.: Plataforma de Gestão de Pessoas'
                } %}

                {% set _upload_max = config.upload_max|default('32M') %}
                <div class="cfg-row-2">
                    {% include 'components/cfg_asset_preview.html.twig' with {
                        variant: 'logo',
                        picker_id: 'logoPicker',
                        preview_id: 'logoPreview',
                        input_key: 'logo_url',
                        file_key: 'logo_file',
                        clear_key: 'logo_url_clear',
                        default_asset: 'images/logos/logo-placeholder-full.svg',
                        label: 'Logotipo',
                        alt: 'Logo atual',
                        url_placeholder: '/uploads/… ou https://…/logo.svg',
                        file_hint: 'PNG, SVG, JPG, ICO — máx. ' ~ _upload_max,
                        file_accept: 'image/*,.ico,.svg'
                    } %}

                    {% include 'components/cfg_asset_preview.html.twig' with {
                        variant: 'favicon',
                        picker_id: 'faviconPicker',
                        preview_id: 'faviconPreview',
                        preview_sm: true,
                        input_key: 'favicon_url',
                        file_key: 'favicon_file',
                        clear_key: 'favicon_url_clear',
                        default_asset: 'images/logos/favicon-placeholder.svg',
                        label: 'Favicon',
                        alt: 'Favicon atual',
                        url_placeholder: '/uploads/… ou https://…/favicon.ico',
                        file_hint: 'ICO, PNG, SVG — máx. ' ~ _upload_max,
                        file_accept: 'image/*,.ico'
                    } %}
                </div>

                {# ── Logos da sidebar ── #}
                <div class="cfg-form-section-label">Logos da barra lateral</div>
                <p class="cfg-section-sub mb-3" style="margin-top:-4px;">
                    Sidebar fechada: ícone/marca. Sidebar aberta ou ao passar o mouse: logotipo completo. Deixe em branco para exibir o placeholder padrão.
                </p>
                <div class="cfg-row-2 mb-3">
                    {% include 'components/cfg_asset_preview.html.twig' with {
                        variant: 'mark',
                        picker_id: 'logoMarkPicker',
                        preview_sm: true,
                        compact: true,
                        input_key: 'logo_mark_url',
                        file_key: 'logo_mark_file',
                        clear_key: 'logo_mark_url_clear',
                        default_asset: 'images/logos/logo-placeholder-mark.svg',
                        label: 'Ícone / Marca <span style="opacity:.5">(sidebar fechada)</span>',
                        label_style: 'font-size:11px;',
                        alt: 'Ícone atual',
                        url_placeholder: '/uploads/… ou https://…/mark.png',
                        file_hint: 'PNG, SVG — máx. ' ~ _upload_max,
                        file_accept: 'image/*,.svg'
                    } %}

                    {% include 'components/cfg_asset_preview.html.twig' with {
                        variant: 'full',
                        picker_id: 'logoFullPicker',
                        compact: true,
                        input_key: 'logo_full_url',
                        file_key: 'logo_full_file',
                        clear_key: 'logo_full_url_clear',
                        default_asset: 'images/logos/logo-placeholder-full.svg',
                        label: 'Logotipo completo <span style="opacity:.5">(sidebar aberta)</span>',
                        label_style: 'font-size:11px;',
                        alt: 'Logotipo atual',
                        url_placeholder: '/uploads/… ou https://…/logotipo.png',
                        file_hint: 'PNG, SVG — máx. ' ~ _upload_max,
                        file_accept: 'image/*,.svg'
                    } %}
                </div>

                <div class="cfg-row-2">
                    {% include 'components/unio_color_picker.html.twig' with {
                        id: 'cfg_cor_primaria',
                        name: 'cor_primaria',
                        label: 'Cor de destaque (accent)',
                        value: config.cor_primaria|default('#3D5AE8')
                    } %}
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'cfg_tema',
                        name: 'tema',
                        label: 'Tema padrão',
                        type: 'select',
                        value: config.tema|default('dark'),
                        options: [
                            { value: 'dark', label: 'Escuro (padrão)' },
                            { value: 'light', label: 'Claro' },
                        ]
                    } %}
                </div>
            </div>
        </section>

        {# ── 2. Contato & Suporte ── #}
        <section class="cfg-section" id="cfg-contato" data-cfg-section="contato">
            <div class="cfg-section-header">
                <div class="cfg-section-icon"><i class="fas fa-headset" aria-hidden="true"></i></div>
                <div>
                    <h2 class="cfg-section-title">Contato &amp; Suporte</h2>
                    <p class="cfg-section-sub">Dados de contato exibidos nos rodapés e e-mails automáticos.</p>
                </div>
            </div>

            <div class="cfg-fields">
                <div class="cfg-row-2">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'cfg_suporte_email',
                        name: 'suporte_email',
                        label: 'E-mail de suporte',
                        type: 'email',
                        value: config.suporte_email|default(''),
                        placeholder: 'suporte@empresa.com'
                    } %}
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'cfg_suporte_telefone',
                        name: 'suporte_telefone',
                        label: 'Telefone de suporte',
                        value: config.suporte_telefone|default(''),
                        placeholder: '(00) 0000-0000'
                    } %}
                </div>
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'cfg_website',
                    name: 'website',
                    label: 'Website',
                    value: config.website|default(''),
                    placeholder: 'https://empresa.com.br'
                } %}
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'cfg_rodape_texto',
                    name: 'rodape_texto',
                    label: 'Texto do rodapé',
                    value: config.rodape_texto|default(''),
                    placeholder: 'Ex.: © 2026 Unio — Todos os direitos reservados.'
                } %}
            </div>
        </section>

        {# ── 3. Segurança ── #}
        <section class="cfg-section" id="cfg-seguranca" data-cfg-section="seguranca">
            <div class="cfg-section-header">
                <div class="cfg-section-icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></div>
                <div>
                    <h2 class="cfg-section-title">Segurança &amp; Acesso</h2>
                    <p class="cfg-section-sub">Política de senhas, sessões e restrições de acesso.</p>
                </div>
            </div>

            <div class="cfg-fields">
                <div class="cfg-row-2">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'cfg_senha_min',
                        name: 'senha_min',
                        label: 'Tamanho mínimo da senha',
                        type: 'number',
                        value: config.senha_min|default(8) ~ '',
                        attrs: { min: '6', max: '32' }
                    } %}
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'cfg_sessao_timeout',
                        name: 'sessao_timeout',
                        label: 'Tempo de sessão (minutos)',
                        type: 'number',
                        value: config.sessao_timeout|default(120) ~ '',
                        attrs: { min: '15', max: '1440' },
                        help_text: 'Inatividade antes do logout automático (aplicado a todos os usuários logados).'
                    } %}
                </div>

                <div class="cfg-toggles">
                    <div class="cfg-toggle-row">
                        <div class="cfg-toggle-info">
                            <span class="cfg-toggle-label">Exigir letra maiúscula na senha</span>
                            <span class="cfg-toggle-sub">Força pelo menos uma letra maiúscula nas senhas de novos usuários.</span>
                        </div>
                        <label class="cfg-switch">
                            <input type="checkbox" name="senha_maiuscula" value="1"
                                   {{ config.senha_maiuscula|default(false) ? 'checked' : '' }}>
                            <span class="cfg-switch-track"></span>
                        </label>
                    </div>
                    <div class="cfg-toggle-row">
                        <div class="cfg-toggle-info">
                            <span class="cfg-toggle-label">Exigir número na senha</span>
                            <span class="cfg-toggle-sub">Força pelo menos um número nas senhas de novos usuários.</span>
                        </div>
                        <label class="cfg-switch">
                            <input type="checkbox" name="senha_numero" value="1"
                                   {{ config.senha_numero|default(false) ? 'checked' : '' }}>
                            <span class="cfg-switch-track"></span>
                        </label>
                    </div>
                    <div class="cfg-toggle-row">
                        <div class="cfg-toggle-info">
                            <span class="cfg-toggle-label">Permitir autorregistro</span>
                            <span class="cfg-toggle-sub">Exibe o link "Criar conta" na tela de login.</span>
                        </div>
                        <label class="cfg-switch">
                            <input type="checkbox" name="registro_publico" value="1"
                                   {{ (config.registro_publico ?? true) ? 'checked' : '' }}>
                            <span class="cfg-switch-track"></span>
                        </label>
                    </div>
                </div>
            </div>
        </section>

        {# ── 4. Manutenção ── #}
        <section class="cfg-section" id="cfg-manutencao" data-cfg-section="manutencao">
            <div class="cfg-section-header">
                <div class="cfg-section-icon cfg-section-icon--warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></div>
                <div>
                    <h2 class="cfg-section-title">Modo Manutenção</h2>
                    <p class="cfg-section-sub">Quando ativo, apenas tenants conseguem acessar a plataforma. Clique em <strong>Salvar configurações</strong> para aplicar — os demais usuários são bloqueados na próxima página que abrirem.</p>
                </div>
            </div>

            <div class="cfg-fields">
                <div class="cfg-toggle-row cfg-toggle-row--card {{ (config.manutencao ?? false) ? 'cfg-toggle-row--danger-active' : '' }}" id="cfgManutencaoToggleRow">
                    <div class="cfg-toggle-info">
                        <span class="cfg-toggle-label">Ativar modo de manutenção</span>
                        <span class="cfg-toggle-sub">Usuários verão apenas a mensagem abaixo e não poderão navegar.</span>
                    </div>
                    <label class="cfg-switch">
                        <input type="checkbox" name="manutencao" value="1" id="cfgManutencaoChk"
                               {{ (config.manutencao ?? false) ? 'checked' : '' }}>
                        <span class="cfg-switch-track cfg-switch-track--danger"></span>
                    </label>
                </div>

                {% include 'components/unio_form_field.html.twig' with {
                    id: 'cfg_msg_manutencao',
                    name: 'msg_manutencao',
                    label: 'Mensagem exibida aos usuários',
                    type: 'textarea',
                    rows: 3,
                    value: config.msg_manutencao|default('Estamos realizando melhorias. Voltamos em breve!'),
                    placeholder: 'Estamos realizando melhorias. Voltamos em breve!'
                } %}

                <div class="cfg-preview-banner {{ (config.manutencao ?? false) ? '' : 'hidden' }}" id="cfgManutencaoPreview">
                    <i class="fas fa-triangle-exclamation mr-2" aria-hidden="true"></i>
                    <strong>Prévia:</strong>
                    <span id="cfgManutencaoPreviewMsg">{{ config.msg_manutencao|default('Estamos realizando melhorias. Voltamos em breve!') }}</span>
                </div>

                <div class="cfg-form-actions">
                    <span class="cfg-save-hint" id="cfgSaveHint" hidden>
                        <i class="fas fa-circle-check mr-1 text-success" aria-hidden="true"></i> Salvo com sucesso
                    </span>
                    <button type="submit" class="btn-unio">
                        <i class="fas fa-save mr-1" aria-hidden="true"></i> Salvar configurações
                    </button>
                </div>
            </div>
        </section>

        </form>{# /form #}

        {# ── 5. Sistema (somente leitura — fora do formulário) ── #}
        <section class="cfg-section cfg-section--sistema" id="cfg-sistema" data-cfg-section="sistema">
            <div class="cfg-section-header">
                <div class="cfg-section-icon"><i class="fas fa-server" aria-hidden="true"></i></div>
                <div>
                    <h2 class="cfg-section-title">Informações do sistema</h2>
                    <p class="cfg-section-sub">Dados técnicos do ambiente de execução.</p>
                </div>
            </div>

            <div class="cfg-fields">
                <div class="cfg-info-grid">
                    {% set info_items = [
                        { label: 'Ambiente',         value: app.environment|upper, badge: app.environment == 'prod' ? 'success' : 'info' },
                        { label: 'Debug mode',        value: app.debug ? 'Ativado' : 'Desativado', badge: app.debug ? 'warning' : 'success' },
                        { label: 'PHP',               value: constant('PHP_VERSION') },
                        { label: 'Servidor',          value: constant('PHP_OS') },
                        { label: 'Memória máxima',    value: config.mem_limit|default('—') },
                        { label: 'Upload máximo',     value: config.upload_max|default('—') },
                        { label: 'POST máximo',       value: config.post_max|default('—') },
                    ] %}
                    {% for item in info_items %}
                    <div class="cfg-info-item">
                        <span class="cfg-info-label">{{ item.label }}</span>
                        <span class="cfg-info-value">
                            {% if item.badge is defined %}
                                {% include 'components/status_badge.html.twig' with {
                                    label: item.value,
                                    variant: item.badge == 'muted' ? 'secondary' : item.badge
                                } %}
                            {% else %}
                                {{ item.value }}
                            {% endif %}
                        </span>
                    </div>
                    {% endfor %}
                </div>

                <p class="cfg-system-hint mb-2">
                    <i class="fas fa-circle-info mr-1" aria-hidden="true"></i>
                    Upload de logo/favicon respeita o limite <strong>{{ config.upload_max|default('—') }}</strong> do PHP.
                </p>

                <div class="cfg-section-actions mt-2">
                    <form method="post" action="{{ path('app_admin_configuracoes_clear_cache') }}"
                          onsubmit="return confirm('Limpar o cache do Symfony? A página pode demorar alguns segundos.')">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_clear_cache') }}">
                        <button type="submit" class="btn-unio-ghost btn-sm">
                            <i class="fas fa-broom mr-1" aria-hidden="true"></i> Limpar cache
                        </button>
                    </form>
                </div>
            </div>
        </section>

    </div>{# /cfg-content #}
</div>{# /cfg-layout #}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';

    /* ── Sidebar navigation — uma seção visível por vez ── */
    var sidebarItems = document.querySelectorAll('[data-cfg-nav]');
    var sections     = document.querySelectorAll('[data-cfg-section]');

    function showSection(navId) {
        sections.forEach(function (section) {
            var visible = section.dataset.cfgSection === navId;
            section.classList.toggle('cfg-section--visible', visible);
            section.hidden = !visible;
        });
    }

    function setActive(navId) {
        sidebarItems.forEach(function (el) {
            el.classList.toggle('cfg-sidebar-item--active', el.dataset.cfgNav === navId);
        });
        showSection(navId);
    }

    sidebarItems.forEach(function (item) {
        item.addEventListener('click', function (e) {
            e.preventDefault();
            setActive(item.dataset.cfgNav);
        });
    });

    if (sidebarItems.length && sections.length) {
        var hash = (window.location.hash || '').replace('#', '');
        var hashNav = hash.indexOf('cfg-') === 0 ? hash.replace(/^cfg-/, '') : '';
        var hashSection = hashNav && document.querySelector('[data-cfg-section="' + hashNav + '"]') ? hashNav : null;
        var initial = hashSection
            ? hashNav
            : (document.querySelector('.cfg-sidebar-item--active') || sidebarItems[0]).dataset.cfgNav;
        setActive(initial);
    }

    /* ── Maintenance toggle ── */
    var manutChk    = document.getElementById('cfgManutencaoChk');
    var manutRow    = document.getElementById('cfgManutencaoToggleRow');
    var manutPreview = document.getElementById('cfgManutencaoPreview');
    var manutMsg    = document.querySelector('[name="msg_manutencao"]');
    var previewMsg  = document.getElementById('cfgManutencaoPreviewMsg');

    function syncManutencao() {
        if (!manutChk) { return; }
        var on = manutChk.checked;
        if (manutRow) { manutRow.classList.toggle('cfg-toggle-row--danger-active', on); }
        if (manutPreview) { manutPreview.classList.toggle('hidden', !on); }
    }
    if (manutChk) { manutChk.addEventListener('change', syncManutencao); }
    if (manutMsg && previewMsg) {
        manutMsg.addEventListener('input', function () { previewMsg.textContent = manutMsg.value; });
    }

    /* ── Image pickers (logo + favicon) ── */
    document.querySelectorAll('.cfg-img-picker').forEach(function (picker) {
        var pickerId   = picker.id;
        var urlInputId = picker.dataset.inputId;
        var fileInputId = picker.dataset.fileInputId;
        var urlInput   = document.getElementById(urlInputId);
        var fileInput  = document.getElementById(fileInputId);
        var clearInput = picker.querySelector('.cfg-img-panel[data-panel="url"] input[type="hidden"]');
        var preview    = picker.querySelector('.cfg-img-preview img') ||
                         picker.querySelector('.cfg-img-preview');

        // Tab switching
        picker.querySelectorAll('.cfg-img-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                var targetPanel = tab.dataset.tab;
                picker.querySelectorAll('.cfg-img-tab').forEach(function (t) {
                    t.classList.toggle('cfg-img-tab--active', t.dataset.tab === targetPanel);
                });
                picker.querySelectorAll('.cfg-img-panel').forEach(function (p) {
                    p.classList.toggle('cfg-img-panel--active', p.dataset.panel === targetPanel);
                });
                // Clear opposite field when switching
                if (targetPanel === 'file' && urlInput) {
                    // keep URL but mark file as primary
                } else if (targetPanel === 'url' && fileInput) {
                    fileInput.value = '';
                }
            });
        });

        // URL input: live preview
        if (urlInput) {
            urlInput.addEventListener('input', function () {
                if (clearInput && urlInput.value.trim() !== '') {
                    clearInput.value = '0';
                }
                refreshPreview(picker, urlInput.value);
            });
        }

        // File input: preview + highlight drop zone
        if (fileInput) {
            fileInput.addEventListener('change', function () {
                if (!fileInput.files || !fileInput.files[0]) { return; }
                if (clearInput) { clearInput.value = '0'; }
                var file = fileInput.files[0];
                var label = picker.querySelector('.cfg-file-drop-label');
                if (label) { label.textContent = file.name; }
                ensureRemoveButton(picker, urlInput, fileInput, clearInput);
                var previewEl = picker.querySelector('.cfg-img-preview');
                if (isSvgSrc(file.name)) {
                    var textReader = new FileReader();
                    textReader.onload = function (e) {
                        if (!previewEl) { return; }
                        previewEl.classList.remove('cfg-img-preview--default');
                        previewEl.dataset.custom = '1';
                        previewEl.innerHTML = '';
                        var host = document.createElement('div');
                        host.className = 'cfg-preview-svg-host cfg-preview-img';
                        host.dataset.role = 'preview-host';
                        previewEl.appendChild(host);
                        if (!mountInlineSvg(host, e.target.result, '')) {
                            showDefaultPreview(previewEl, picker);
                        }
                    };
                    textReader.readAsText(file);
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (e) { refreshPreview(picker, e.target.result); };
                reader.readAsDataURL(file);
            });

            // Drag & drop styling
            var dropZone = picker.querySelector('.cfg-file-drop');
            if (dropZone) {
                ['dragover','dragenter'].forEach(function (ev) {
                    dropZone.addEventListener(ev, function (e) { e.preventDefault(); dropZone.classList.add('cfg-file-drop--over'); });
                });
                ['dragleave','drop'].forEach(function (ev) {
                    dropZone.addEventListener(ev, function () { dropZone.classList.remove('cfg-file-drop--over'); });
                });
            }
        }

        // Remove button
        picker.querySelectorAll('.cfg-img-remove').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var ui = document.getElementById(btn.dataset.urlInput);
                var fi = document.getElementById(btn.dataset.fileInput);
                var clearInput = btn.dataset.clearInput && document.getElementById(btn.dataset.clearInput);
                if (ui) { ui.value = ''; }
                if (fi) { fi.value = ''; }
                if (clearInput) { clearInput.value = '1'; }
                refreshPreview(picker, '');
                btn.remove();
            });
        });
    });

    function fallbackAssetPreview(previewEl, src) {
        if (!previewEl || !src) { return; }
        var url = resolvePreviewSrc(src);
        previewEl.innerHTML = '';
        previewEl.classList.remove('cfg-img-preview--default');
        previewEl.dataset.custom = '1';
        if (isSvgSrc(src)) {
            var obj = document.createElement('object');
            obj.type = 'image/svg+xml';
            obj.data = url;
            obj.className = 'cfg-preview-img platform-asset-svg';
            obj.setAttribute('aria-label', 'Preview');
            previewEl.appendChild(obj);
            return;
        }
        var img = document.createElement('img');
        img.className = 'cfg-preview-img';
        img.alt = 'Preview';
        img.src = url;
        previewEl.appendChild(img);
    }

    function ensureRemoveButton(picker, urlInput, fileInput, clearInput) {
        if (!picker || picker.querySelector('.cfg-img-remove')) { return; }
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cfg-img-remove';
        btn.dataset.picker = picker.id;
        btn.dataset.urlInput = urlInput ? urlInput.id : '';
        btn.dataset.fileInput = fileInput ? fileInput.id : '';
        btn.dataset.clearInput = clearInput ? clearInput.id : '';
        btn.innerHTML = '<i class="fas fa-trash-alt fa-xs mr-1"></i> Remover';
        btn.addEventListener('click', function () {
            if (urlInput) { urlInput.value = ''; }
            if (fileInput) { fileInput.value = ''; }
            if (clearInput) { clearInput.value = '1'; }
            refreshPreview(picker, '');
            btn.remove();
        });
        picker.querySelector('.cfg-img-controls').appendChild(btn);
    }

    function resolvePreviewSrc(src) {
        if (!src) { return ''; }
        if (/^https?:\/\//i.test(src)) { return src; }
        if (/^data:/i.test(src)) { return src; }
        if (src.charAt(0) === '/') { return src; }
        return '/' + src.replace(/^\.\//, '');
    }

    function isSvgSrc(src) {
        if (!src) { return false; }
        if (/^data:image\/svg/i.test(src)) { return true; }
        var clean = String(src).split('?')[0].split('#')[0];
        return /\.svg$/i.test(clean);
    }

    function resolveSvgBase(src) {
        if (/^data:/i.test(src)) { return ''; }
        return resolvePreviewSrc(src).replace(/[^/]+$/, '');
    }

    function mountInlineSvg(host, svgText, base) {
        host.innerHTML = svgText;
        var svg = host.querySelector('svg');
        if (!svg) { return false; }
        svg.removeAttribute('width');
        svg.removeAttribute('height');
        svg.style.width = '100%';
        svg.style.height = '100%';
        svg.style.display = 'block';
        if (base) {
            svg.querySelectorAll('[href], [xlink\\:href]').forEach(function (node) {
                var attr = node.hasAttribute('href') ? 'href' : 'xlink:href';
                var val = node.getAttribute(attr);
                if (!val || /^(https?:|data:|#|\/)/i.test(val)) { return; }
                node.setAttribute(attr, base + val.replace(/^\.\//, ''));
            });
        }
        return true;
    }

    function renderAssetPreview(previewEl, src, onFail) {
        previewEl.innerHTML = '';
        if (isSvgSrc(src)) {
            if (/^data:/i.test(src)) {
                var dataImg = document.createElement('img');
                dataImg.className = 'cfg-preview-img';
                dataImg.alt = 'Preview';
                dataImg.src = src;
                dataImg.addEventListener('error', onFail);
                previewEl.appendChild(dataImg);
                return;
            }
            var host = document.createElement('div');
            host.className = 'cfg-preview-svg-host cfg-preview-img';
            host.dataset.role = 'preview-host';
            previewEl.appendChild(host);
            var url = resolvePreviewSrc(src);
            fetch(url, { credentials: 'same-origin' })
                .then(function (res) {
                    if (!res.ok) { throw new Error('fetch failed'); }
                    return res.text();
                })
                .then(function (text) {
                    if (!mountInlineSvg(host, text, resolveSvgBase(src))) {
                        throw new Error('invalid svg');
                    }
                })
                .catch(onFail);
            return;
        }
        var img = document.createElement('img');
        img.className = 'cfg-preview-img';
        img.alt = 'Preview';
        img.src = resolvePreviewSrc(src);
        img.addEventListener('error', onFail);
        previewEl.appendChild(img);
    }

    function showDefaultPreview(previewEl, picker) {
        if (!previewEl || !picker) { return; }
        var tpl = picker.querySelector('.cfg-preview-default-tpl');
        previewEl.innerHTML = '';
        previewEl.classList.add('cfg-img-preview--default');
        previewEl.dataset.custom = '0';
        if (tpl && tpl.content) {
            previewEl.appendChild(tpl.content.cloneNode(true));
        }
    }

    function showCustomPreview(previewEl, picker, src) {
        if (!previewEl || !picker || !src) {
            showDefaultPreview(previewEl, picker);
            return;
        }
        previewEl.classList.remove('cfg-img-preview--default');
        previewEl.dataset.custom = '1';
        renderAssetPreview(previewEl, src, function () {
            fallbackAssetPreview(previewEl, src);
        });
    }

    function refreshPreview(picker, src) {
        var previewEl = picker.querySelector('.cfg-img-preview');
        if (!previewEl) { return; }
        if (src && String(src).trim() !== '') {
            showCustomPreview(previewEl, picker, src);
        } else {
            showDefaultPreview(previewEl, picker);
        }
    }

    document.querySelectorAll('.cfg-img-preview [data-preview-src]').forEach(function (host) {
        var previewEl = host.closest('.cfg-img-preview');
        var picker = host.closest('.cfg-img-picker');
        if (!previewEl || !picker) { return; }
        var src = host.dataset.previewSrc;
        fetch(resolvePreviewSrc(src), { credentials: 'same-origin' })
            .then(function (res) {
                if (!res.ok) { throw new Error('fetch failed'); }
                return res.text();
            })
            .then(function (text) {
                if (!mountInlineSvg(host, text, resolveSvgBase(src))) {
                    throw new Error('invalid svg');
                }
            })
            .catch(function () {
                fallbackAssetPreview(previewEl, src);
            });
    });

    document.querySelectorAll('.cfg-img-picker').forEach(function (picker) {
        var previewEl = picker.querySelector('.cfg-img-preview');
        var img = previewEl && previewEl.querySelector('img.cfg-preview-img');
        if (img) {
            img.addEventListener('error', function () {
                showDefaultPreview(previewEl, picker);
            });
        }
    });

    /* ── Flash "saved" hint ── */
    var hint = document.getElementById('cfgSaveHint');
    if (hint && window.location.search.indexOf('saved=1') !== -1) {
        hint.hidden = false;
        setTimeout(function () { hint.hidden = true; }, 4000);
    }

    function parseIniSize(value) {
        if (!value) { return 0; }
        var v = String(value).trim().toLowerCase();
        var n = parseFloat(v);
        if (isNaN(n)) { return 0; }
        if (v.endsWith('g')) { return n * 1024 * 1024 * 1024; }
        if (v.endsWith('m')) { return n * 1024 * 1024; }
        if (v.endsWith('k')) { return n * 1024; }
        return n;
    }

    var cfgForm = document.getElementById('cfgForm');
    if (cfgForm) {
        cfgForm.addEventListener('submit', function (e) {
            var uploadMax = parseIniSize(cfgForm.dataset.uploadMax);
            var postMax = parseIniSize(cfgForm.dataset.postMax);
            var total = 0;
            var tooLarge = null;

            cfgForm.querySelectorAll('input[type="file"]').forEach(function (input) {
                if (!input.files || !input.files[0]) {
                    input.disabled = true;
                    return;
                }
                var picker = input.closest('.cfg-img-picker');
                if (picker) {
                    var clear = picker.querySelector('.cfg-img-panel[data-panel="url"] input[type="hidden"]');
                    if (clear) { clear.value = '0'; }
                }
                var size = input.files[0].size;
                total += size;
                if (uploadMax > 0 && size > uploadMax) {
                    tooLarge = input.files[0].name;
                }
            });

            if (tooLarge) {
                e.preventDefault();
                cfgForm.querySelectorAll('input[type="file"]').forEach(function (input) {
                    input.disabled = false;
                });
                window.alert('O arquivo "' + tooLarge + '" excede o limite por arquivo (' + cfgForm.dataset.uploadMax + '). Use um arquivo menor ou a opção URL.');
                return;
            }

            if (postMax > 0 && total > postMax * 0.9) {
                e.preventDefault();
                cfgForm.querySelectorAll('input[type="file"]').forEach(function (input) {
                    input.disabled = false;
                });
                window.alert(
                    'Os arquivos selecionados somam ~' + Math.ceil(total / (1024 * 1024)) + ' MB e podem exceder o limite do servidor (' +
                    cfgForm.dataset.postMax + '). Salve um logo por vez ou use arquivos SVG otimizados.'
                );
            }
        });
    }
}());
</script>
{% endblock %}
