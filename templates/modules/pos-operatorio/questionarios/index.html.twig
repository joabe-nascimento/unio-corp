{% extends 'layout/hub.html.twig' %}

{% set _copy = organismo.copy|default({}) %}
{% set _label_checkins = _copy.nav_questionarios|default(org_clinic|default(false) ? 'Questionários' : 'Check-ins') %}

{% block title %}{{ _label_checkins }}{% if not org_clinic %} · {{ _copy.brand_name|default('Studio') }}{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = _label_checkins %}
{% set hub_page_eyebrow = org_clinic ? org_brand_label : '' %}
{% set hub_page_subtitle = org_clinic|default(false) ? 'Respostas diárias dos pacientes' : 'Respostas pendentes de revisão' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_portal_patient_login') }}" class="btn-unio-ghost btn-sm" target="_blank" rel="noopener">
    <i class="fas fa-globe mr-1"></i> {{ _copy.nav_portal|default(org_clinic|default(false) ? 'Portal do paciente' : 'Portal do cliente') }}
</a>
{% if not org_clinic %}
<a href="{{ path('app_pos_operatorio') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left mr-1"></i> Visão geral
</a>
{% endif %}
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
        { value: stats.hoje, label: 'Respondidos hoje', icon: 'fa-file-medical', tone: 'sage' },
        { value: stats.pendentes, label: 'Pendentes hoje', icon: 'fa-clock', tone: 'amber', variant: stats.pendentes > 0 ? 'warning' : '' },
        { value: stats.total, label: 'Últimas respostas', icon: 'fa-list', tone: 'sky' },
    ], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<section class="unio-card clinic-questionarios-table">
    {% if items is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-notes-medical',
            title: 'Nenhuma resposta',
            text: 'Nenhuma resposta registrada ainda.',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Paciente</th>
                    <th>Fase</th>
                    <th>Dor</th>
                    <th>Febre</th>
                    <th>Score</th>
                    <th>Enviado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for row in items %}
                <tr>
                    <td>{{ row.data }}</td>
                    <td>
                        <strong>{{ row.paciente_nome }}</strong><br>
                        <code class="admin-table-mono">{{ row.paciente_codigo }}</code>
                    </td>
                    <td>{% if row.dia_pos is not null %}D+{{ row.dia_pos }}{% else %}—{% endif %}</td>
                    <td>{{ row.dor }}</td>
                    <td>{{ row.febre }}</td>
                    <td>
                        {% include 'components/status_badge.html.twig' with {
                            label: row.score,
                            variant: row.score >= 70 ? 'danger' : (row.score >= 40 ? 'warning' : 'success')
                        } %}
                        {% if row.alerta_gerado %}
                        <span class="badge-perfil danger ml-1">Alerta</span>
                        {% endif %}
                    </td>
                    <td class="admin-table-date">{{ row.respondido_em }}</td>
                    <td class="text-right">
                        <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: row.paciente_id }) }}" class="btn-unio-ghost btn-sm">Ficha</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

<div class="clinic-questionarios-foot">
    <section class="unio-card clinic-questionarios-help">
        <header class="clinic-questionarios-help__head">
            <span class="org-icon org-icon--sm org-icon--lavender" aria-hidden="true"><i class="fas fa-circle-info"></i></span>
            <div>
                <h3 class="clinic-questionarios-help__title">Como interpretar os scores</h3>
                <p class="clinic-questionarios-help__sub">Triagem automática com base nas respostas do portal</p>
            </div>
        </header>
        <div class="clinic-questionarios-help__grid">
            <div class="clinic-questionarios-help__item">
                {% include 'components/status_badge.html.twig' with { label: '0–39', variant: 'success' } %}
                <p>Recuperação dentro do esperado. Sem ação imediata.</p>
            </div>
            <div class="clinic-questionarios-help__item">
                {% include 'components/status_badge.html.twig' with { label: '40–69', variant: 'warning' } %}
                <p>Atenção moderada. Revisar na próxima rodada de triagem.</p>
            </div>
            <div class="clinic-questionarios-help__item">
                {% include 'components/status_badge.html.twig' with { label: '70+', variant: 'danger' } %}
                <p>Risco elevado. Verificar alertas e abrir a ficha do paciente.</p>
            </div>
        </div>
        <div class="clinic-questionarios-help__actions">
            {% if stats.pendentes > 0 %}
            <span class="clinic-questionarios-help__pending">
                <i class="fas fa-clock" aria-hidden="true"></i>
                {{ stats.pendentes }} paciente{{ stats.pendentes > 1 ? 's' : '' }} aguardando resposta hoje
            </span>
            {% endif %}
            <a href="{{ path('app_pos_operatorio_alertas') }}" class="btn-unio-ghost btn-sm">
                <i class="fas fa-bell mr-1" aria-hidden="true"></i> Ver alertas
            </a>
            <a href="{{ path('app_pos_operatorio_pacientes') }}" class="btn-unio-ghost btn-sm">
                <i class="fas fa-user-injured mr-1" aria-hidden="true"></i> Pacientes
            </a>
        </div>
    </section>
</div>
{% endblock %}
