{% extends 'layout/hub.html.twig' %}
{% block title %}Branding{% endblock %}
{% block hub_content %}
<section class="pos-op-page">
    <header class="pos-op-page__head">
        <h1>White-label da clínica</h1>
    </header>
    <div class="pos-op-panel">
    <form method="post" class="pos-op-form">
        <label>Nome exibido <input name="nome_exibicao" value="{{ branding.nome_exibicao }}"></label>
        <label>Slogan <input name="slogan" value="{{ branding.slogan }}"></label>
        <label>Logo URL <input name="logo_url" value="{{ branding.logo_url }}"></label>
        <label>Cor primária <input name="cor_primaria" value="{{ branding.cor_primaria }}"></label>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </form>
    </div>
</section>
{% endblock %}
