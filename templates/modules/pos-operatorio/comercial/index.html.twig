{% extends 'layout/hub.html.twig' %}

{% block title %}Comercial e escala · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Comercial e escala' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'White-label, limites do plano, onboarding e auditoria' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_content %}
{% for msg in app.flashes('success') %}
<div class="clinic-banner clinic-banner--ok"><i class="fas fa-circle-check" aria-hidden="true"></i><div>{{ msg }}</div></div>
{% endfor %}

<div class="clinic-ops-grid">
    <a class="unio-card clinic-ops-card clinic-ops-card--stacked p-3" href="{{ path('app_pos_operatorio_comercial_branding') }}">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">Branding</strong>
            <p class="clinic-ops-card__desc">Logo, cores e slogan por clínica.</p>
        </div>
    </a>

    <a class="unio-card clinic-ops-card clinic-ops-card--stacked p-3" href="{{ path('app_pos_operatorio_comercial_limites') }}">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">Planos e limites</strong>
            <p class="clinic-ops-card__desc">{{ limits.beneficiarios_ativos }}/{{ limits.max_beneficiarios }} beneficiários · Wallet {{ limits.wallet_ativo ? 'ativo' : 'add-on' }}</p>
        </div>
    </a>

    <a class="unio-card clinic-ops-card clinic-ops-card--stacked p-3" href="{{ path('app_pos_operatorio_comercial_onboarding') }}">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">Onboarding</strong>
            <p class="clinic-ops-card__desc">{{ onboarding.concluido ? 'Concluído' : 'Em andamento' }}: CSV, sandbox e 1ª carteirinha.</p>
        </div>
    </a>

    <a class="unio-card clinic-ops-card clinic-ops-card--stacked p-3" href="{{ path('app_pos_operatorio_comercial_auditoria_csv') }}">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">Auditoria CSV</strong>
            <p class="clinic-ops-card__desc">Emissões, revogações e logs de verificação.</p>
        </div>
    </a>

    <a class="unio-card clinic-ops-card clinic-ops-card--stacked p-3" href="{{ path('app_pos_operatorio_painel_dia') }}">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">Painel do dia</strong>
            <p class="clinic-ops-card__desc">Operação da recepção e fila clínica.</p>
        </div>
    </a>

    <a class="unio-card clinic-ops-card clinic-ops-card--stacked p-3" href="{{ path('app_pos_operatorio_recepcao') }}">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">Scanner recepção</strong>
            <p class="clinic-ops-card__desc">Check-in por QR, CPF ou código.</p>
        </div>
    </a>
</div>
{% endblock %}
