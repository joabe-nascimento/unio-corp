{% extends 'layout/hub.html.twig' %}

{% block title %}Comercial e escala{% endblock %}

{% block hub_content %}
<section class="pos-op-page">
    <header class="pos-op-page__head">
        <h1>Comercial e escala</h1>
        <p>White-label, limites do plano, onboarding e auditoria.</p>
    </header>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
        <a class="pos-op-card" href="{{ path('app_pos_operatorio_comercial_branding') }}">
            <h2>Branding</h2>
            <p>Logo, cores e slogan por clínica.</p>
        </a>
        <a class="pos-op-card" href="{{ path('app_pos_operatorio_comercial_limites') }}">
            <h2>Planos e limites</h2>
            <p>{{ limits.beneficiarios_ativos }}/{{ limits.max_beneficiarios }} beneficiários · Wallet {{ limits.wallet_ativo ? 'ativo' : 'add-on' }}</p>
        </a>
        <a class="pos-op-card" href="{{ path('app_pos_operatorio_comercial_onboarding') }}">
            <h2>Onboarding</h2>
            <p>{{ onboarding.concluido ? 'Concluído' : 'Em andamento' }} — CSV, sandbox e 1ª carteirinha.</p>
        </a>
        <a class="pos-op-card" href="{{ path('app_pos_operatorio_comercial_auditoria_csv') }}">
            <h2>Auditoria CSV</h2>
            <p>Emissões, revogações e logs de verificação.</p>
        </a>
        <a class="pos-op-card" href="{{ path('app_pos_operatorio_painel_dia') }}">
            <h2>Painel do dia</h2>
            <p>Operação da recepção e fila clínica.</p>
        </a>
        <a class="pos-op-card" href="{{ path('app_pos_operatorio_recepcao') }}">
            <h2>Scanner recepção</h2>
            <p>Check-in por QR, CPF ou código.</p>
        </a>
    </div>
</section>
{% endblock %}
