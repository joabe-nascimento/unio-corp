{% extends 'layout/hub.html.twig' %}

{% block title %}Planos e limites · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Planos e limites' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Capacidade de beneficiários e add-ons do plano comercial' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_content %}
<p class="pos-op-back">
    <a href="{{ path('app_pos_operatorio_comercial') }}"><i class="fas fa-arrow-left" aria-hidden="true"></i> Voltar para Comercial</a>
</p>

{% for msg in app.flashes('success') %}
<div class="alert alert-success">{{ msg }}</div>
{% endfor %}

<section class="unio-card p-4" style="max-width:560px">
    <form method="post">
        <div class="form-group">
            <label for="plano_comercial">Plano comercial</label>
            <select id="plano_comercial" name="plano_comercial" class="form-control">
                {% for plan in commercial_plans|default([]) %}
                <option value="{{ plan.id }}" {% if limits.plano_comercial == plan.id %}selected{% endif %}>
                    {{ plan.nome }} · {{ plan.preco }}{% if plan.preco_sufixo %} {{ plan.preco_sufixo }}{% endif %}
                    (até {{ plan.max_beneficiarios }} pacientes)
                </option>
                {% else %}
                <option value="essencial" {% if limits.plano_comercial == 'essencial' %}selected{% endif %}>Essencial</option>
                <option value="clinica" {% if limits.plano_comercial == 'clinica' %}selected{% endif %}>Clínica</option>
                <option value="rede" {% if limits.plano_comercial == 'rede' %}selected{% endif %}>Rede</option>
                {% endfor %}
            </select>
            <p class="text-muted small mt-1 mb-0">Essencial R$ 189 · Clínica R$ 279 · Rede sob consulta (por clínica / mês).</p>
        </div>
        <div class="form-group">
            <label for="max_beneficiarios">Máx. beneficiários</label>
            <input id="max_beneficiarios" name="max_beneficiarios" type="number" class="form-control" value="{{ limits.max_beneficiarios }}" min="10">
        </div>
        <label class="pos-op-check">
            <input type="checkbox" name="wallet_incluso" value="1" {% if limits.wallet_incluso %}checked{% endif %}>
            <span>Wallet (Apple/Google) incluso no plano</span>
        </label>
        <p class="text-muted small mt-3 mb-3">Uso atual: <strong>{{ limits.beneficiarios_ativos }}</strong> beneficiários ativos.</p>
        <button type="submit" class="btn-unio">Salvar limites</button>
    </form>
</section>
{% endblock %}
