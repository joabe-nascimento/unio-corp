{% extends 'layout/hub.html.twig' %}

{% block title %}Carteirinha · {{ paciente.nome }}{% endblock %}

{% set hub_page_title = paciente.nome %}
{% set hub_page_eyebrow = 'Carteirinha digital' %}
{% set hub_page_subtitle = paciente.codigo ~ ' · ' ~ (paciente.procedimento|default('Procedimento')) %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = true %}
{% set hub_use_clinic_tabs = true %}
{% set hub_clinic_tabs = [
    { id: 'overview', label: 'Emissão', hint: 'Plano, validade e foto' },
] %}
{% if tem_emissao %}
    {% set hub_clinic_tabs = hub_clinic_tabs|merge([
        { id: 'enviar', label: 'Enviar ao paciente', hint: 'Link, códigos e WhatsApp' },
    ]) %}
{% endif %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_carteirinha') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left mr-1"></i> Voltar
</a>
<a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: paciente.id }) }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-folder-open mr-1"></i> Ficha
</a>
{% endblock %}

{% block hub_content %}
<div class="clinic-carteirinha-paciente">
    {% include 'modules/pos-operatorio/carteirinha/_emissao_paciente.html.twig' %}
    {% include 'modules/pos-operatorio/carteirinha/_preview_paciente.html.twig' %}
</div>
{% endblock %}

{% block hub_extra_panels %}
{% if tem_emissao %}
<div class="hub-tab-panel" data-hub-panel="enviar" role="tabpanel" hidden>
    <div class="clinic-carteirinha-paciente">
        <section class="unio-card clinic-carteirinha-paciente__actions">
            {% include 'modules/pos-operatorio/carteirinha/_share_paciente.html.twig' with {
                verificacao_url: verificacao_url|default(null)
            } %}
        </section>
        {% include 'modules/pos-operatorio/carteirinha/_preview_paciente.html.twig' %}
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/marketing-carteirinha.js') }}?v=7" defer></script>
<script src="{{ asset('js/clinic-carteirinha-preview.js') }}?v=2" defer></script>
{% if tem_emissao %}
<script src="{{ asset('js/clinic-carteirinha-share.js') }}?v=1" defer></script>
{% endif %}
<script>
(function () {
    document.querySelectorAll('[data-clinic-file-input]').forEach(function (input) {
        var control = input.closest('.clinic-file-input__control');
        var nameEl = control ? control.querySelector('[data-clinic-file-name]') : null;
        if (!nameEl) return;
        input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            nameEl.textContent = file ? file.name : 'Nenhum arquivo escolhido';
        });
    });
})();
</script>
{% endblock %}
