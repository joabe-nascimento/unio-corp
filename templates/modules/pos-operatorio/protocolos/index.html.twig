{% extends 'layout/hub.html.twig' %}

{% set _copy = organismo.copy|default({}) %}
{% set _label_playbooks = _copy.nav_protocolos|default(org_clinic|default(false) ? 'Protocolos' : 'Playbooks') %}

{% block title %}{{ _label_playbooks }}{% if not org_clinic %} · {{ _copy.brand_name|default('Studio') }}{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = _label_playbooks %}
{% set hub_page_eyebrow = org_clinic ? org_brand_label : '' %}
{% set hub_page_subtitle = org_clinic|default(false) ? 'Modelos de acompanhamento por procedimento' : 'Templates e fluxos de implementação' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_protocolo_novo') }}" class="btn-unio btn-sm">
    <i class="fas fa-plus mr-1"></i> {{ org_clinic|default(false) ? 'Novo protocolo' : 'Novo playbook' }}
</a>
{% if not org_clinic %}
<a href="{{ path('app_pos_operatorio') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left mr-1"></i> Visão geral
</a>
{% endif %}
{% endblock %}

{% set _pc = protocolo_counts|default({}) %}
{% set _fq = filter_q|default('') %}
{% set _fa = filter_ativo|default('') %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_pos_operatorio_protocolos'),
    show_search: true,
    use_form: true,
    search_placeholder: org_clinic|default(false) ? 'Buscar protocolo…' : 'Buscar playbook…',
    search_name: 'q',
    search_value: _fq,
    hidden_fields: _fa != '' ? { ativo: _fa } : {}
} %}
    {% block filter_chips %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar por status',
            chips: [
                { href: path('app_pos_operatorio_protocolos', _fq ? { q: _fq } : {}), label: 'Todos', active: _fa == '', count: _pc.total|default(null) },
                { href: path('app_pos_operatorio_protocolos', { ativo: '1' }|merge(_fq ? { q: _fq } : {})), label: 'Ativos', active: _fa == '1', count: _pc.ativos|default(null) },
                { href: path('app_pos_operatorio_protocolos', { ativo: '0' }|merge(_fq ? { q: _fq } : {})), label: 'Inativos', active: _fa == '0', count: _pc.inativos|default(null) },
            ]
        } %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
{% set _proto_cta = org_clinic|default(false) ? 'Novo protocolo' : 'Novo playbook' %}

<section class="unio-card p-0 ops-queue-animate">
    {% if protocolos is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-clipboard-list',
            title: org_clinic|default(false) ? 'Nenhum protocolo cadastrado' : 'Nenhum playbook cadastrado',
            text: 'Crie o primeiro modelo para orientar o acompanhamento.',
            btn_label: _proto_cta,
            btn_href: path('app_pos_operatorio_protocolo_novo'),
            btn_icon: 'fa-plus',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Duração</th>
                    <th>Checklist</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for pr in protocolos %}
                <tr>
                    <td data-label="Nome"><strong>{{ pr.nome }}</strong></td>
                    <td data-label="Tipo">{{ pr.tipoProcedimento|default('—') }}</td>
                    <td data-label="Duração">{{ pr.duracaoDias }} dias</td>
                    <td data-label="Checklist">{{ pr.checklist|length }} itens</td>
                    <td data-label="Status">
                        <span class="badge-perfil {{ pr.ativo ? 'success' : 'default' }}">{{ pr.ativo ? 'Ativo' : 'Inativo' }}</span>
                    </td>
                    <td data-label="Ações" class="text-right">
                        {% embed 'components/row_actions_menu.html.twig' with {
                            aria_label: 'Mais ações de ' ~ pr.nome
                        } %}
                            {% block items %}
                            <a href="{{ path('app_pos_operatorio_protocolo_editar', { id: pr.id }) }}" class="dropdown-item">Editar</a>
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
