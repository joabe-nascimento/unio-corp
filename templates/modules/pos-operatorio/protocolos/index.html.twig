{% extends 'layout/hub.html.twig' %}

{% set _copy = organismo.copy|default({}) %}
{% set _label_playbooks = _copy.nav_protocolos|default(org_clinic|default(false) ? 'Protocolos' : 'Playbooks') %}

{% block title %}{{ _label_playbooks }}{% if not org_clinic %} · {{ _copy.brand_name|default('Studio') }}{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = _label_playbooks %}
{% set hub_page_eyebrow = org_clinic ? org_brand_label : '' %}
{% set hub_page_subtitle = org_clinic|default(false) ? 'Modelos de acompanhamento por procedimento' : 'Templates e fluxos de implementação' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_protocolo_novo') }}" class="btn-unio btn-sm">
    <i class="fas fa-plus mr-1"></i> {{ org_clinic|default(false) ? 'Novo protocolo' : 'Novo playbook' }}
</a>
{% if not org_clinic %}
<a href="{{ path('app_pos_operatorio') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left mr-1"></i> Visão geral
</a>
{% endif %}
{% endblock %}

{% block hub_content %}
{% set _proto_cta = org_clinic|default(false) ? 'Novo protocolo' : 'Novo playbook' %}
<section class="unio-card">
    {% if protocolos is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-clipboard-list',
            title: org_clinic|default(false) ? 'Nenhum protocolo cadastrado' : 'Nenhum playbook cadastrado',
            text: 'Crie o primeiro modelo para orientar o acompanhamento.',
            btn_label: _proto_cta,
            btn_href: path('app_pos_operatorio_protocolo_novo'),
            btn_icon: 'fa-plus',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Duração</th>
                    <th>Checklist</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for pr in protocolos %}
                <tr>
                    <td><strong>{{ pr.nome }}</strong></td>
                    <td>{{ pr.tipoProcedimento|default('—') }}</td>
                    <td>{{ pr.duracaoDias }} dias</td>
                    <td>{{ pr.checklist|length }} itens</td>
                    <td>{{ pr.ativo ? 'Ativo' : 'Inativo' }}</td>
                    <td class="text-right">
                        <a href="{{ path('app_pos_operatorio_protocolo_editar', { id: pr.id }) }}" class="btn-unio-ghost btn-sm">Editar</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
