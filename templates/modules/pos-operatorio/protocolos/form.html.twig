{% extends 'layout/hub.html.twig' %}



{% block title %}{{ protocolo ? 'Editar' : 'Novo' }} protocolo · Pós-Operatório{% endblock %}

{% block permissions_scope %}hub_pos_operatorio{% endblock %}



{% set hub_page_title = protocolo ? 'Editar protocolo' : 'Novo protocolo' %}

{% set hub_page_subtitle = 'Checklist, regras de alerta e duração' %}

{% set hub_search_hidden = true %}

{% set hub_show_tabs = false %}



{% block hub_content %}

<section class="unio-card p-4" style="max-width: 720px;">

    <form method="post">

        <input type="hidden" name="_token" value="{{ csrf_token('pos_op_protocolo') }}">



        <div class="form-group">

            <label for="nome">Nome *</label>

            <input id="nome" name="nome" class="form-control" required value="{{ protocolo ? protocolo.nome : '' }}">

        </div>



        <div class="row">

            <div class="col-md-6 form-group">

                <label for="tipo">Tipo de procedimento</label>

                <input id="tipo" name="tipo" class="form-control" value="{{ protocolo ? protocolo.tipoProcedimento : '' }}">

            </div>

            <div class="col-md-6 form-group">

                <label for="duracao_dias">Duração (dias)</label>

                <input id="duracao_dias" name="duracao_dias" type="number" min="1" class="form-control"

                       value="{{ protocolo ? protocolo.duracaoDias : 14 }}">

            </div>

        </div>



        <div class="form-group">

            <label for="checklist_text">Checklist por dia pós-operatório</label>

            <textarea id="checklist_text" name="checklist_text" class="form-control font-monospace" rows="6"

                      placeholder="1: Repouso relativo&#10;3: Retirada de curativo">{{ checklist_text|default('') }}</textarea>

            <small class="text-muted">Um item por linha, formato <code>DIA: descrição</code></small>

        </div>



        <fieldset class="border rounded p-3 mb-3">

            <legend class="small text-muted px-1 mb-0">Regras de alerta (triagem)</legend>

            <div class="row mt-2">

                <div class="col-md-6 form-group mb-0">

                    <label for="regras_dor_p1">Dor mínima para P1</label>

                    <input id="regras_dor_p1" name="regras_dor_p1" type="number" min="0" max="10" class="form-control"

                           value="{{ regras_dor_p1|default(8) }}">

                </div>

                <div class="col-md-6 form-group mb-0">

                    <label for="regras_febre_p2">Febre mínima para P2 (°C)</label>

                    <input id="regras_febre_p2" name="regras_febre_p2" type="number" step="0.1" class="form-control"

                           value="{{ regras_febre_p2|default(38.5) }}">

                </div>

            </div>

        </fieldset>



        {% if protocolo %}

        <div class="mb-3">

            <p class="small text-muted mb-1">

                {{ protocolo.perguntas|length }} pergunta(s) no portal ·

                {{ protocolo.checklist|length }} item(ns) no checklist

            </p>

            <div class="form-check">

                <input type="checkbox" class="form-check-input" id="ativo" name="ativo" value="1"{{ protocolo.ativo ? ' checked' : '' }}>

                <label class="form-check-label" for="ativo">Protocolo ativo</label>

            </div>

        </div>

        {% else %}

        <p class="small text-muted">As perguntas padrão do portal (dor, febre, náusea, sangramento) serão aplicadas automaticamente.</p>

        {% endif %}



        <div class="d-flex gap-2 mt-4">

            <button type="submit" class="btn-unio">Salvar</button>

            <a href="{{ path('app_pos_operatorio_protocolos') }}" class="btn-unio-ghost">Cancelar</a>

        </div>

    </form>

</section>

{% endblock %}

