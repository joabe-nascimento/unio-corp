{% extends 'layout/portal_patient.html.twig' %}

{% set portal_page_title = 'Acompanhamento pós-operatório' %}
{% set portal_page_subtitle = org_brand_label|default(empresa ? empresa.nome : '') %}

{% block portal_title %}Acompanhamento pós-operatório{% endblock %}

{% block portal_content %}
    {% if not paciente %}
        <section class="unio-card p-4 mb-3 pos-portal-card--info">
            <div class="pos-portal-card__icon" aria-hidden="true"><i class="fas fa-user-lock"></i></div>
            {% include 'components/section_header.html.twig' with {
                title: 'Acompanhamento não encontrado',
                subtitle: 'Este login não está vinculado a um paciente ativo.'
            } %}
            <p class="text-muted small mb-3">
                Se você é paciente, confirme com a clínica se seu acesso já foi liberado.
                Se entrou com a conta da equipe, use o <a href="{{ path('app_portal_patient_login') }}">login do portal do paciente</a>
                com as credenciais que a clínica enviou.
            </p>
            <a href="{{ path('app_portal_patient_logout') }}" class="btn-unio btn-sm">Sair e tentar outro login</a>
        </section>

    {% elseif not has_consent %}
        <section class="unio-card p-4">
            {% include 'components/section_header.html.twig' with {
                title: 'Consentimento LGPD',
                subtitle: 'Autorização para tratamento de dados sensíveis de saúde'
            } %}
            <p class="text-muted small mb-3">
                Autorizo o tratamento dos meus <strong>dados sensíveis de saúde</strong> para acompanhamento
                pós-operatório, conforme a Política de Privacidade da clínica e a LGPD (Art. 11).
            </p>
            <ul class="pos-portal-bullets">
                <li>Finalidade: monitoramento clínico pós-cirúrgico</li>
                <li>Dados: respostas de questionários, alertas e comunicações com a equipe</li>
                <li>Revogação: solicite à clínica a qualquer momento</li>
            </ul>
            <form method="post" action="{{ path('app_pos_operatorio_portal_consentimento') }}" class="pos-portal-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_consent') }}">
                <label class="pos-portal-check">
                    <input type="checkbox" name="aceite" value="1" required>
                    <span>Li e concordo com o tratamento dos meus dados de saúde</span>
                </label>
                <button type="submit" class="btn-unio">Continuar para o questionário</button>
            </form>
        </section>

    {% else %}
        <section class="pos-portal-hero mb-3" aria-label="Resumo do paciente">
            <div class="pos-portal-hero__main">
                <h2 class="pos-portal-hero__name">{{ paciente.nome }}</h2>
                <p class="pos-portal-hero__meta">
                    <code>{{ paciente.codigo }}</code>
                    <span aria-hidden="true">·</span>
                    {{ paciente.procedimento|default('Procedimento') }}
                </p>
                {% if protocolo_nome %}
                <p class="pos-portal-hero__protocol"><i class="fas fa-clipboard-list" aria-hidden="true"></i> {{ protocolo_nome }}</p>
                {% endif %}
            </div>
            {% if dia_pos is not null %}
            <div class="pos-portal-hero__badge" aria-label="Dia pós-operatório">
                <span class="pos-portal-hero__badge-val">D+{{ dia_pos }}</span>
                <span class="pos-portal-hero__badge-lbl">pós-op</span>
            </div>
            {% endif %}
        </section>

        {% set kpi_items = [
            {
                value: questionario_resumo ? 'Enviado' : 'Pendente',
                label: 'Questionário de hoje',
                icon: questionario_resumo ? 'fa-circle-check' : 'fa-file-medical',
                sub: questionario_resumo ? ('Hoje às ' ~ questionario_resumo.respondido_em|split(' ')|last) : 'Preencha abaixo'
            }
        ] %}
        {% if questionario_resumo %}
            {% set kpi_items = kpi_items|merge([
                { value: questionario_resumo.score, label: 'Score de risco', icon: 'fa-chart-line' },
                { value: (questionario_resumo.dor ?? '—') ~ '/10', label: 'Dor', icon: 'fa-heart-pulse' },
                { value: (questionario_resumo.febre ?? '—') ~ ' °C', label: 'Temperatura', icon: 'fa-temperature-half' }
            ]) %}
        {% elseif medico_nome %}
            {% set kpi_items = kpi_items|merge([
                { value: medico_nome, label: 'Médico responsável', icon: 'fa-user-doctor' }
            ]) %}
        {% endif %}
        {% include 'components/kpi_row.html.twig' with { items: kpi_items, mb: 'mb-3', extra_class: 'pos-portal-kpis' } %}

        <div class="row g-3 pos-portal-grid align-items-start">
            {% if checklist_hoje|length > 0 or medico_email or paciente.telefoneContato %}
            <div class="col-lg-4 pos-portal-grid__aside">
                {% if checklist_hoje|length > 0 %}
                <section class="unio-card p-0 pos-portal-card--orientacoes">
                    {% include 'components/section_header.html.twig' with {
                        title: 'Orientações de hoje',
                        subtitle: 'Protocolo pós-operatório'
                    } %}
                    <div class="pos-portal-card-body">
                        <ul class="pos-portal-checklist">
                            {% for item in checklist_hoje %}
                            <li class="pos-portal-checklist__item">
                                <span class="pos-portal-checklist__day">D+{{ item.dia }}</span>
                                <span class="pos-portal-checklist__text">{{ item.item }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                        {% if checklist_proximos|default([])|length > 0 %}
                        <details class="pos-portal-details">
                            <summary>Próximas etapas do protocolo</summary>
                            <ul class="pos-portal-checklist pos-portal-checklist--muted">
                                {% for item in checklist_proximos %}
                                <li class="pos-portal-checklist__item">
                                    <span class="pos-portal-checklist__day">D+{{ item.dia }}</span>
                                    <span class="pos-portal-checklist__text">{{ item.item }}</span>
                                </li>
                                {% endfor %}
                            </ul>
                        </details>
                        {% endif %}
                    </div>
                </section>
                {% endif %}

                {% if medico_email or paciente.telefoneContato %}
                <section class="unio-card p-0{% if checklist_hoje|length > 0 %} mt-3{% endif %} pos-portal-card--contact">
                    {% include 'components/section_header.html.twig' with { title: 'Contato da equipe' } %}
                    <dl class="pos-portal-dl pos-portal-dl--compact px-3 pb-3">
                        {% if medico_nome %}<dt>Médico</dt><dd>{{ medico_nome }}</dd>{% endif %}
                        {% if medico_email %}<dt>E-mail</dt><dd><a href="mailto:{{ medico_email }}">{{ medico_email }}</a></dd>{% endif %}
                        {% if paciente.telefoneContato %}<dt>Telefone</dt><dd>{{ paciente.telefoneContato }}</dd>{% endif %}
                    </dl>
                </section>
                {% endif %}
            </div>
            {% endif %}

            <div class="col-lg-{{ (checklist_hoje|length > 0 or medico_email or paciente.telefoneContato) ? '8' : '12' }} pos-portal-grid__main">
                <section class="unio-card p-0 h-100">
                    {% include 'components/section_header.html.twig' with {
                        title: 'Questionário de hoje',
                        subtitle: questionario_resumo ? 'Respostas registradas' : 'Preencha e envie uma vez por dia'
                    } %}

                    <div class="px-3 pb-3">
                        {% if questionario_resumo %}
                        <div class="pos-portal-success">
                            <div class="pos-portal-success__head">
                                <i class="fas fa-circle-check" aria-hidden="true"></i>
                                <strong>Enviado hoje às {{ questionario_resumo.respondido_em|split(' ')|last }}</strong>
                            </div>
                            <p class="text-muted small mb-0">Novo questionário disponível amanhã. Em piora, contate a clínica.</p>
                        </div>
                        {% else %}
                        <form method="post" action="{{ path('app_pos_operatorio_portal_questionario') }}" class="pos-portal-form pos-portal-form--questionario">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_q') }}">

                            {% for pergunta in perguntas %}
                                {% set pid = pergunta.id %}
                                {% set tipo = pergunta.tipo|default('texto') %}
                                <div class="pos-portal-field{% if tipo == 'texto' %} pos-portal-field--full{% endif %}">
                                    <label class="pos-portal-field__label" for="q_{{ pid }}">{{ pergunta.label }}</label>

                                    {% if tipo == 'escala' %}
                                    <div class="pos-portal-range-wrap">
                                        <input type="range" class="pos-portal-range" id="q_{{ pid }}" name="{{ pid }}"
                                               min="{{ pergunta.min|default(0) }}" max="{{ pergunta.max|default(10) }}"
                                               value="{{ pergunta.default|default(3) }}" data-range-out="out_{{ pid }}">
                                        <output id="out_{{ pid }}" class="pos-portal-range__out">{{ pergunta.default|default(3) }}</output>
                                    </div>
                                    <div class="pos-portal-range-labels">
                                        <span>Sem dor</span><span>Intensa</span>
                                    </div>
                                    {% elseif tipo == 'numero' %}
                                    <input type="number" step="{{ pergunta.step|default(0.1) }}" class="pos-portal-input"
                                           id="q_{{ pid }}" name="{{ pid }}" placeholder="{{ pergunta.placeholder|default('36.5') }}">
                                    {% elseif tipo == 'select' %}
                                    <select class="pos-portal-select" id="q_{{ pid }}" name="{{ pid }}">
                                        {% for op in pergunta.opcoes|default([]) %}
                                        <option value="{{ op.value }}">{{ op.label }}</option>
                                        {% endfor %}
                                    </select>
                                    {% else %}
                                    <textarea class="pos-portal-textarea" id="q_{{ pid }}" name="{{ pid }}" rows="2"
                                              {% if not pergunta.optional|default(false) %}required{% endif %}></textarea>
                                    {% endif %}
                                </div>
                            {% endfor %}

                            <button type="submit" class="btn-unio pos-portal-field--full">
                                <i class="fas fa-paper-plane mr-1" aria-hidden="true"></i> Enviar questionário
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </section>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block portal_javascripts %}
<script>
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('{{ asset('pos-operatorio/sw.js') }}').catch(function () {});
}
document.querySelectorAll('.pos-portal-range').forEach(function (input) {
    var outId = input.getAttribute('data-range-out');
    var out = outId ? document.getElementById(outId) : null;
    function sync() { if (out) out.textContent = input.value; }
    input.addEventListener('input', sync);
    sync();
});
</script>
{% endblock %}
