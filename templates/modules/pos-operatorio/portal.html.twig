{% extends 'layout/portal_patient.html.twig' %}

{% set _is_pre = is_pre_op|default(false) %}
{% set _dia_lbl = dia_relativo_label|default(dia_pos is not null ? 'D+' ~ dia_pos : null) %}
{% set portal_page_title = _is_pre ? 'Preparação pré-operatória' : 'Pós-operatório' %}
{% set portal_page_subtitle = clinica_nome|default(org_brand_label|default(empresa ? empresa.nome : '')) %}

{% block portal_title %}{{ _is_pre ? 'Preparação para a cirurgia' : 'Acompanhamento pós-operatório' }}{% endblock %}

{% block portal_topbar_meta %}
{% if paciente %}
<div class="pos-portal-topbar__meta">
    {% if _dia_lbl %}
    <span class="pos-portal-topbar__chip">{{ _dia_lbl }}</span>
    {% endif %}
    {% if has_consent|default(false) %}
        {% if questionario_resumo %}
        <span class="pos-portal-topbar__chip pos-portal-topbar__chip--ok">Enviado hoje</span>
        {% else %}
        <span class="pos-portal-topbar__chip pos-portal-topbar__chip--warn">Responder hoje</span>
        {% endif %}
    {% endif %}
</div>
{% endif %}
{% endblock %}

{% block portal_content %}
    {% if not paciente %}
        <section class="pos-portal-panel pos-portal-panel--info">
            <div class="pos-portal-panel__icon" aria-hidden="true"><i class="fas fa-user-lock"></i></div>
            <h2 class="pos-portal-panel__title">Acompanhamento não encontrado</h2>
            <p class="pos-portal-panel__sub">Este login não está vinculado a um paciente ativo.</p>
            <p class="pos-portal-panel__text">
                Se você é paciente, confirme com a clínica se seu acesso já foi liberado.
                Se entrou com a conta da equipe, use o
                <a href="{{ path('app_portal_patient_login') }}">login do portal do paciente</a>
                com as credenciais que a clínica enviou.
            </p>
            <a href="{{ path('app_portal_patient_logout') }}" class="pos-portal-btn pos-portal-btn--primary">Sair e tentar outro login</a>
        </section>

    {% elseif not has_consent %}
        <section class="pos-portal-panel">
            <div class="pos-portal-panel__content">
            <h2 class="pos-portal-panel__title">Consentimento LGPD</h2>
            <p class="pos-portal-panel__sub">Autorização para tratamento de dados sensíveis de saúde</p>
            <p class="pos-portal-panel__text">
                Autorizo o tratamento dos meus <strong>dados sensíveis de saúde</strong> para acompanhamento
                pós-operatório, conforme a Política de Privacidade da clínica e a LGPD (Art. 11).
            </p>
            <ul class="pos-portal-bullets">
                <li>Finalidade: monitoramento clínico pós-cirúrgico</li>
                <li>Dados: respostas de questionários, alertas e comunicações com a equipe</li>
                <li>Revogação: solicite à clínica a qualquer momento</li>
            </ul>
            <form method="post" action="{{ path('app_pos_operatorio_portal_consentimento') }}" class="pos-portal-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_consent') }}">
                <label class="pos-portal-check">
                    <input type="checkbox" name="aceite" value="1" required>
                    <span>Li e concordo com o tratamento dos meus dados de saúde</span>
                </label>
                <button type="submit" class="pos-portal-btn pos-portal-btn--primary pos-portal-btn--block">Continuar para o questionário</button>
            </form>
            </div>
        </section>

    {% else %}
        {% if alerta_equipe|default(null) and alerta_equipe.ativo %}
        <div class="pos-portal-banner pos-portal-banner--care" role="status">
            <i class="fas fa-user-nurse" aria-hidden="true"></i>
            <div>
                <strong>{{ alerta_equipe.em_atendimento ? 'Equipe em contato' : 'Atenção da equipe' }}</strong>
                <p>{{ alerta_equipe.mensagem }}</p>
            </div>
        </div>
        {% endif %}

        {% if is_d0|default(false) %}
        <div class="pos-portal-banner pos-portal-banner--care" role="status">
            <i class="fas fa-arrows-turn-right" aria-hidden="true"></i>
            <div>
                <strong>Dia da cirurgia · handoff</strong>
                <p>{{ handoff_label|default('A Trilha Unio passa da preparação para o acompanhamento pós-operatório.') }}</p>
            </div>
        </div>
        {% endif %}

        <section class="pos-portal-hero" aria-label="Resumo do paciente">
            <div class="pos-portal-hero__main">
                <p class="pos-portal-hero__eyebrow">{{ status_label|default('Recuperação ativa') }}</p>
                <h1 class="pos-portal-hero__name">{{ paciente.nome }}</h1>
                <p class="pos-portal-hero__meta">
                    <span class="pos-portal-hero__code">{{ paciente.codigo }}</span>
                    {{ procedimento_label|default(paciente.procedimento|default('Procedimento')) }}
                </p>
                <dl class="pos-portal-hero__facts">
                    {% if data_cirurgia_label %}
                    <div><dt>Cirurgia</dt><dd>{{ data_cirurgia_label }}</dd></div>
                    {% endif %}
                    {% if medico_nome %}
                    <div><dt>Médico</dt><dd>{{ medico_nome }}</dd></div>
                    {% endif %}
                    {% if duracao_dias %}
                    <div><dt>Protocolo</dt><dd>{{ duracao_dias }} dias</dd></div>
                    {% endif %}
                </dl>
            </div>
            {% if _dia_lbl %}
            <div class="pos-portal-hero__badge" aria-label="{{ _is_pre ? 'Dia pré-operatório' : 'Dia pós-operatório' }}">
                <span class="pos-portal-hero__badge-val">{{ _dia_lbl }}</span>
                <span class="pos-portal-hero__badge-lbl">{{ _is_pre ? 'pré-op' : 'pós-op' }}</span>
            </div>
            {% endif %}
        </section>

        {% if duracao_dias and _dia_lbl %}
        <section class="pos-portal-progress" aria-label="{{ _is_pre ? 'Progresso da preparação' : 'Progresso da recuperação' }}">
            <div class="pos-portal-progress__head">
                <span class="pos-portal-progress__label">{{ _is_pre ? 'Preparação' : 'Recuperação' }}</span>
                <span class="pos-portal-progress__value">{{ progress_pct|default(0) }}%</span>
            </div>
            <div class="pos-portal-progress__track" role="progressbar" aria-valuenow="{{ progress_pct|default(0) }}" aria-valuemin="0" aria-valuemax="100">
                <span class="pos-portal-progress__fill" style="width: {{ progress_pct|default(0) }}%"></span>
            </div>
            {% if fase_label %}
            <p class="pos-portal-progress__phase">{{ fase_label }}</p>
            {% endif %}
        </section>
        {% endif %}

        {% if not _is_pre %}
        {% include 'components/pos_operatorio/medical_guide.html.twig' with { guia_medico: guia_medico|default(null) } %}
        {% endif %}

        {% if _is_pre %}
        <section class="pos-portal-panel pos-portal-panel--day" aria-label="Preparação para a cirurgia">
            <header class="pos-portal-panel__head">
                <h2 class="pos-portal-panel__title">Preparação para a cirurgia</h2>
                <p class="pos-portal-panel__sub">{{ 'now'|date('d/m/Y') }}{% if _dia_lbl %} · {{ _dia_lbl }}{% endif %}{% if data_cirurgia_label %} · cirurgia {{ data_cirurgia_label }}{% endif %}</p>
            </header>
            <div class="pos-portal-panel__content">
                {% if checklist_hoje|default([])|length > 0 %}
                <div class="pos-portal-day-focus">
                    <strong>Marco de hoje</strong>
                    <p>{{ checklist_hoje[0].item }}</p>
                </div>
                <ul class="pos-portal-checklist mt-3">
                    {% for item in checklist_hoje %}
                    <li class="pos-portal-checklist__item">
                        <span class="pos-portal-checklist__day">{{ item.dia < 0 ? 'D−' ~ (item.dia|abs) : 'D+' ~ item.dia }}</span>
                        <span class="pos-portal-checklist__text">{{ item.item }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="pos-portal-panel__text">Siga as orientações da clínica e responda o check-in abaixo para avançar na Trilha Unio.</p>
                {% endif %}
                {% if fase_label %}
                <p class="pos-portal-day-phase">{{ fase_label }}</p>
                {% endif %}
            </div>
        </section>
        {% else %}
        <section class="pos-portal-panel pos-portal-panel--day" aria-label="Resumo do dia">
            <header class="pos-portal-panel__head">
                <h2 class="pos-portal-panel__title">Resumo do dia</h2>
                <p class="pos-portal-panel__sub">{{ 'now'|date('d/m/Y') }}{% if _dia_lbl %} · {{ _dia_lbl }}{% endif %}{% if procedimento_label %} · {{ procedimento_label }}{% endif %}</p>
            </header>
            <div class="pos-portal-panel__content">
                <div class="pos-portal-day-grid">
                    <div class="pos-portal-day-stat">
                        <strong>{{ questionario_resumo ? 'Enviado' : 'Pendente' }}</strong>
                        <span>Questionário de hoje</span>
                    </div>
                    <div class="pos-portal-day-stat">
                        <strong>{% if questionario_resumo %}{{ questionario_resumo.dor ?? '—' }}/10{% else %}—{% endif %}</strong>
                        <span>Nível de dor</span>
                    </div>
                    <div class="pos-portal-day-stat">
                        <strong>{% if questionario_resumo %}{{ questionario_resumo.score }}{% else %}—{% endif %}</strong>
                        <span>Score de risco</span>
                    </div>
                    <div class="pos-portal-day-stat">
                        <strong>{{ dias_respondidos|default(0) }}</strong>
                        <span>Dias respondidos</span>
                    </div>
                </div>

                {% if fase_label %}
                <p class="pos-portal-day-phase">{{ fase_label }}</p>
                {% endif %}

                {% if checklist_hoje|default([])|length > 0 %}
                <div class="pos-portal-day-focus">
                    <strong>Orientação de hoje</strong>
                    <p>{{ checklist_hoje[0].item }}</p>
                </div>
                {% endif %}

                {% if checklist_progress|default([])|length > 0 %}
                <div class="pos-portal-day-protocol">
                    <p class="pos-portal-day-protocol__title">Linha do protocolo</p>
                    <ol class="pos-portal-timeline pos-portal-timeline--compact">
                        {% for step in checklist_progress|slice(0, 4) %}
                        <li class="pos-portal-timeline__item{{ step.done ? ' is-done' : '' }}{{ step.current ? ' is-current' : '' }}">
                            <span class="pos-portal-timeline__dot" aria-hidden="true"></span>
                            <div class="pos-portal-timeline__body">
                                <span class="pos-portal-timeline__day">{{ step.dia < 0 ? 'D−' ~ (step.dia|abs) : 'D+' ~ step.dia }}</span>
                                <span class="pos-portal-timeline__text">{{ step.item }}</span>
                            </div>
                        </li>
                        {% endfor %}
                    </ol>
                </div>
                {% endif %}
            </div>
        </section>
        {% endif %}

        <div class="pos-portal-status{% if questionario_resumo %} pos-portal-status--answered{% endif %}" role="list">
            <article class="pos-portal-status__card pos-portal-status__card--{{ questionario_resumo ? 'done' : 'pending' }}" role="listitem">
                <span class="pos-portal-status__icon" aria-hidden="true">
                    <i class="fas {{ questionario_resumo ? 'fa-circle-check' : 'fa-file-medical' }}"></i>
                </span>
                <div class="pos-portal-status__body">
                    <strong class="pos-portal-status__value">{{ questionario_resumo ? 'Enviado' : 'Aguardando você' }}</strong>
                    <span class="pos-portal-status__label">Questionário de hoje</span>
                    <span class="pos-portal-status__hint">{{ questionario_resumo ? ('Hoje às ' ~ questionario_resumo.respondido_em|split(' ')|last) : 'Preencha o formulário abaixo' }}</span>
                </div>
            </article>

            <article class="pos-portal-status__card" role="listitem">
                <span class="pos-portal-status__icon" aria-hidden="true"><i class="fas fa-calendar-check"></i></span>
                <div class="pos-portal-status__body">
                    <strong class="pos-portal-status__value">{{ dias_respondidos|default(0) }}</strong>
                    <span class="pos-portal-status__label">Dias respondidos</span>
                    <span class="pos-portal-status__hint">{{ _is_pre ? 'Na preparação' : 'Desde a cirurgia' }}</span>
                </div>
            </article>

            {% if questionario_resumo %}
            <article class="pos-portal-status__card" role="listitem">
                <span class="pos-portal-status__icon" aria-hidden="true"><i class="fas fa-chart-line"></i></span>
                <div class="pos-portal-status__body">
                    <strong class="pos-portal-status__value">{{ questionario_resumo.score }}</strong>
                    <span class="pos-portal-status__label">Score de risco</span>
                    <span class="pos-portal-status__hint">Atualizado hoje</span>
                </div>
            </article>
            <article class="pos-portal-status__card" role="listitem">
                <span class="pos-portal-status__icon" aria-hidden="true"><i class="fas fa-heart-pulse"></i></span>
                <div class="pos-portal-status__body">
                    <strong class="pos-portal-status__value">{{ questionario_resumo.dor ?? '—' }}/10</strong>
                    <span class="pos-portal-status__label">Dor</span>
                </div>
            </article>
            {% elseif medico_nome %}
            <article class="pos-portal-status__card" role="listitem">
                <span class="pos-portal-status__icon" aria-hidden="true"><i class="fas fa-user-doctor"></i></span>
                <div class="pos-portal-status__body">
                    <strong class="pos-portal-status__value pos-portal-status__value--sm">{{ medico_nome }}</strong>
                    <span class="pos-portal-status__label">Médico responsável</span>
                </div>
            </article>
            {% endif %}
        </div>

        <div class="pos-portal-stack">
            <section class="pos-portal-panel pos-portal-panel--actions" aria-label="Ações rápidas">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Precisa de ajuda?</h2>
                    <p class="pos-portal-panel__sub">A equipe clínica recebe o pedido na fila de atendimento</p>
                </header>
                <div class="pos-portal-panel__content">
                    {% if ajuda_pendente|default(false) %}
                    <p class="pos-portal-help-status">
                        <i class="fas fa-clock" aria-hidden="true"></i>
                        Seu pedido já está com a equipe. Aguarde o contato.
                    </p>
                    {% else %}
                    <form method="post" action="{{ path('app_pos_operatorio_portal_ajuda') }}" class="pos-portal-form pos-portal-form--help">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_ajuda') }}">
                        <div class="pos-portal-field">
                            <label class="pos-portal-field__label" for="ajuda_mensagem">Mensagem (opcional)</label>
                            <textarea class="pos-portal-textarea" id="ajuda_mensagem" name="mensagem" rows="2" placeholder="Descreva o que está sentindo ou sua dúvida"></textarea>
                        </div>
                        <button type="submit" class="pos-portal-btn pos-portal-btn--care pos-portal-btn--block">
                            <i class="fas fa-hand-holding-medical" aria-hidden="true"></i>
                            Preciso de ajuda
                        </button>
                    </form>
                    {% endif %}
                </div>
            </section>

            {% if retorno_hoje|default(null) %}
            <section class="pos-portal-panel pos-portal-panel--retorno" aria-label="Retorno ambulatorial">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Retorno hoje</h2>
                    <p class="pos-portal-panel__sub">{{ retorno_hoje.dia < 0 ? 'D−' ~ (retorno_hoje.dia|abs) : 'D+' ~ retorno_hoje.dia }} · {{ retorno_hoje.item }}</p>
                </header>
                <div class="pos-portal-panel__content">
                    {% if retorno_confirmado|default(false) %}
                    <p class="pos-portal-retorno-ok">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        Retorno confirmado. A clínica foi avisada.
                    </p>
                    {% else %}
                    <p class="pos-portal-panel__text">Confirme se comparecerá ao retorno agendado para hoje.</p>
                    <form method="post" action="{{ path('app_pos_operatorio_portal_retorno') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_retorno') }}">
                        <button type="submit" class="pos-portal-btn pos-portal-btn--primary pos-portal-btn--block">
                            Confirmar retorno de hoje
                        </button>
                    </form>
                    {% endif %}
                </div>
            </section>
            {% endif %}

            <section class="pos-portal-panel" aria-label="Mensagens com a equipe">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Mensagens</h2>
                    <p class="pos-portal-panel__sub">Thread curta com a clínica</p>
                </header>
                <div class="pos-portal-panel__content">
                    {% if mensagens_equipe|default([])|length > 0 %}
                    <ul class="pos-portal-messages">
                        {% for msg in mensagens_equipe %}
                        <li class="pos-portal-messages__item{{ msg.origem == 'Você' ? ' is-self' : '' }}">
                            <header class="pos-portal-messages__head">
                                <strong>{{ msg.origem }}</strong>
                                <time datetime="{{ msg.data_label }} {{ msg.hora }}">{{ msg.data_label }} · {{ msg.hora }}</time>
                            </header>
                            <p>{{ msg.texto }}</p>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="pos-portal-muted small mb-3">Ainda sem mensagens — pode escrever à equipe abaixo.</p>
                    {% endif %}
                    <form method="post" action="{{ path('app_pos_operatorio_portal_mensagem') }}" class="pos-portal-form pos-portal-form--help">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_mensagem') }}">
                        <div class="pos-portal-field">
                            <label class="pos-portal-field__label" for="chat_mensagem">Sua mensagem</label>
                            <textarea class="pos-portal-textarea" id="chat_mensagem" name="mensagem" rows="2" placeholder="Dúvida rápida para a equipe"></textarea>
                        </div>
                        <button type="submit" class="pos-portal-btn pos-portal-btn--ghost">
                            Enviar mensagem
                        </button>
                    </form>
                </div>
            </section>

            <section class="pos-portal-panel pos-portal-panel--questionario" id="questionario-hoje">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">{{ _is_pre ? 'Check-in de preparação' : 'Questionário de hoje' }}</h2>
                    <p class="pos-portal-panel__sub">{{ questionario_resumo ? 'Respostas registradas na clínica' : (_is_pre ? 'Confirme o marco do dia e avance na Trilha Unio' : 'Preencha e envie uma vez por dia') }}</p>
                </header>

                <div class="pos-portal-panel__content">
                    {% if questionario_resumo %}
                    <div class="pos-portal-success">
                        <div class="pos-portal-success__head">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            <strong>Enviado hoje às {{ questionario_resumo.respondido_em|split(' ')|last }}</strong>
                        </div>
                        <p class="pos-portal-success__text">{{ _is_pre ? 'Sua preparação na Trilha Unio foi atualizada. Em dúvida, fale com a clínica.' : 'A equipe recebeu suas respostas. Novo questionário amanhã. Em piora, contate a clínica.' }}</p>
                    </div>
                    {% else %}
                    <form method="post" action="{{ path('app_pos_operatorio_portal_questionario') }}" class="pos-portal-form pos-portal-form--questionario">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_portal_q') }}">

                        {% for pergunta in perguntas %}
                            {% set pid = pergunta.id %}
                            {% set tipo = pergunta.tipo|default('texto') %}
                            <div class="pos-portal-field">
                                <label class="pos-portal-field__label" for="q_{{ pid }}">{{ pergunta.label }}</label>

                                {% if tipo == 'escala' %}
                                <div class="pos-portal-range-wrap">
                                    <input type="range" class="pos-portal-range" id="q_{{ pid }}" name="{{ pid }}"
                                           min="{{ pergunta.min|default(0) }}" max="{{ pergunta.max|default(10) }}"
                                           value="{{ pergunta.default|default(3) }}" data-range-out="out_{{ pid }}">
                                    <output id="out_{{ pid }}" class="pos-portal-range__out" for="q_{{ pid }}">{{ pergunta.default|default(3) }}</output>
                                </div>
                                <div class="pos-portal-range-labels">
                                    <span>Sem dor</span><span>Intensa</span>
                                </div>
                                {% elseif tipo == 'numero' %}
                                <input type="number" step="{{ pergunta.step|default(0.1) }}" class="pos-portal-input"
                                       id="q_{{ pid }}" name="{{ pid }}" inputmode="decimal"
                                       placeholder="{{ pergunta.placeholder|default('36.5') }}">
                                {% elseif tipo == 'select' %}
                                <select class="pos-portal-select" id="q_{{ pid }}" name="{{ pid }}">
                                    {% for op in pergunta.opcoes|default([]) %}
                                    <option value="{{ op.value }}">{{ op.label }}</option>
                                    {% endfor %}
                                </select>
                                {% else %}
                                <textarea class="pos-portal-textarea" id="q_{{ pid }}" name="{{ pid }}" rows="3"
                                          {% if not pergunta.optional|default(false) %}required{% endif %}></textarea>
                                {% endif %}
                            </div>
                        {% endfor %}

                        <button type="submit" class="pos-portal-btn pos-portal-btn--primary pos-portal-btn--block">{{ _is_pre ? 'Confirmar preparação de hoje' : 'Enviar questionário de hoje' }}</button>
                    </form>
                    {% endif %}
                </div>
            </section>

            {% if not _is_pre and checklist_hoje|default([])|length > 0 %}
            <section class="pos-portal-panel">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Orientações de hoje</h2>
                    <p class="pos-portal-panel__sub">{{ protocolo_nome|default('Protocolo pós-operatório') }}</p>
                </header>
                <div class="pos-portal-panel__content">
                <ul class="pos-portal-checklist">
                    {% for item in checklist_hoje %}
                    <li class="pos-portal-checklist__item">
                        <span class="pos-portal-checklist__day">{{ item.dia < 0 ? 'D−' ~ (item.dia|abs) : 'D+' ~ item.dia }}</span>
                        <span class="pos-portal-checklist__text">{{ item.item }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% if checklist_proximos|default([])|length > 0 %}
                <details class="pos-portal-details">
                    <summary>Próximas etapas</summary>
                    <ul class="pos-portal-checklist pos-portal-checklist--muted">
                        {% for item in checklist_proximos %}
                        <li class="pos-portal-checklist__item">
                            <span class="pos-portal-checklist__day">{{ item.dia < 0 ? 'D−' ~ (item.dia|abs) : 'D+' ~ item.dia }}</span>
                            <span class="pos-portal-checklist__text">{{ item.item }}</span>
                        </li>
                        {% endfor %}
                    </ul>
                </details>
                {% endif %}
                </div>
            </section>
            {% endif %}

            {% if checklist_progress|default([])|length > 0 %}
            <section class="pos-portal-panel">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Linha do protocolo</h2>
                    <p class="pos-portal-panel__sub">{{ _is_pre ? 'Marcos da preparação e recuperação' : 'Marcos da recuperação' }}</p>
                </header>
                <div class="pos-portal-panel__content">
                <ol class="pos-portal-timeline">
                    {% for step in checklist_progress %}
                    <li class="pos-portal-timeline__item{{ step.done ? ' is-done' : '' }}{{ step.current ? ' is-current' : '' }}">
                        <span class="pos-portal-timeline__dot" aria-hidden="true"></span>
                        <div class="pos-portal-timeline__body">
                            <span class="pos-portal-timeline__day">{{ step.dia < 0 ? 'D−' ~ (step.dia|abs) : 'D+' ~ step.dia }}</span>
                            <span class="pos-portal-timeline__text">{{ step.item }}</span>
                        </div>
                    </li>
                    {% endfor %}
                </ol>
                </div>
            </section>
            {% endif %}

            {% if historico_questionarios|default([])|length > 0 %}
            <section class="pos-portal-panel">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Histórico recente</h2>
                    <p class="pos-portal-panel__sub">Questionários enviados</p>
                </header>
                <div class="pos-portal-panel__content">
                <ul class="pos-portal-history">
                    {% for item in historico_questionarios %}
                    <li class="pos-portal-history__item">
                        <span class="pos-portal-history__date">{{ item.data_label }}</span>
                        <strong>{{ item.dia_relativo_label|default(item.dia_pos is not null ? 'D+' ~ item.dia_pos : '—') }} · Score {{ item.score }}</strong>
                        <p>Dor {{ item.dor ?? '—' }}/10{% if item.febre is not null %} · Febre {{ item.febre }}°C{% endif %}</p>
                    </li>
                    {% endfor %}
                </ul>
                </div>
            </section>
            {% endif %}

            {% if medico_nome or medico_email or paciente.telefoneContato or telefone_emergencia %}
            <section class="pos-portal-panel pos-portal-panel--contact">
                <header class="pos-portal-panel__head">
                    <h2 class="pos-portal-panel__title">Contato da clínica</h2>
                </header>
                <div class="pos-portal-panel__content">
                <dl class="pos-portal-contact">
                    {% if medico_nome %}
                    <div><dt>Médico</dt><dd>{{ medico_nome }}</dd></div>
                    {% endif %}
                    {% if medico_email %}
                    <div><dt>E-mail</dt><dd><a href="mailto:{{ medico_email }}">{{ medico_email }}</a></dd></div>
                    {% endif %}
                    {% if paciente.telefoneContato %}
                    <div><dt>Telefone</dt><dd><a href="tel:{{ paciente.telefoneContato|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ paciente.telefoneContato }}</a></dd></div>
                    {% endif %}
                    {% if contato_emergencia %}
                    <div><dt>Contato emergência</dt><dd>{{ contato_emergencia }}{% if telefone_emergencia %} · {{ telefone_emergencia }}{% endif %}</dd></div>
                    {% endif %}
                </dl>
                </div>
            </section>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block portal_javascripts %}
<script>
document.querySelectorAll('[data-range-out]').forEach(function (input) {
    var out = document.getElementById(input.getAttribute('data-range-out'));
    if (!out) return;
    var sync = function () { out.textContent = input.value; };
    input.addEventListener('input', sync);
    sync();
});
</script>
{% endblock %}
