{% extends 'layout/hub.html.twig' %}

{% set _copy = organismo.copy|default({}) %}
{% set _is_jur = org_juridico|default(false) %}
{% set _label_sala = _is_jur ? 'Prazos Críticos' : _copy.nav_sala_critica|default(org_clinic|default(false) ? 'Sala Crítica' : 'Prioridade alta') %}

{% block title %}{{ _label_sala }}{% if not org_clinic and not _is_jur %} · {{ _copy.brand_name|default('Studio') }}{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic and not _is_jur %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = _label_sala %}
{% set hub_page_eyebrow = (org_clinic or _is_jur) ? org_brand_label : '' %}
{% set hub_page_subtitle = org_clinic|default(false) ? 'Alertas P1 · coordenação clínica' : (_is_jur ? 'Prazos críticos · atenção imediata do escritório' : 'Alertas P1 · atenção imediata') %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_toolbar_actions %}
<span class="badge-perfil {{ p1_count > 0 ? 'danger' : 'success' }}">
    {{ p1_count > 0 ? (p1_count ~ ' P1 ativo' ~ (p1_count != 1 ? 's' : '')) : 'Estável' }}
</span>
<a href="{{ path('app_pos_operatorio_alertas') }}" class="btn-unio-ghost btn-sm ml-2">
    <i class="fas fa-list mr-1"></i> Fila completa
</a>
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
        { value: p1_count, label: 'Incidentes P1', icon: 'fa-fire', tone: 'rose', variant: p1_count > 0 ? 'danger' : 'success', pulse: p1_count > 0 },
        { value: severity_score|default(0), label: 'Índice severidade', icon: 'fa-heart-pulse', tone: 'amber', variant: severity_level|default('stable') == 'critical' ? 'danger' : (severity_level|default('stable') == 'elevated' ? 'warning' : '') },
        { value: stats.em_atendimento|default(0), label: 'Em atendimento', icon: org_juridico|default(false) ? 'fa-user-tie' : 'fa-user-nurse', tone: 'sage' },
        { value: stats.abertos|default(0), label: 'Aguardando triagem', icon: 'fa-inbox', tone: 'sky', route: 'app_pos_operatorio_alertas' },
    ], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<div data-pos-op-live
     data-pos-op-mercure-url="{{ path('app_pos_operatorio_api_mercure') }}"
     data-pos-op-poll-url="{{ path('app_pos_operatorio_api_alertas_poll') }}"
     data-pos-op-stats="{{ stats|json_encode|e('html_attr') }}"
     hidden aria-hidden="true"></div>
<div class="pos-op-war-room{{ p1_count > 0 ? ' is-critical' : '' }}">
    {% if org_clinic|default(false) %}
    <div class="pos-op-war-room__brand">
        {% include 'components/unio/selo.html.twig' with { variant: 'stamp', label: 'Atenção imediata', show_slogan: true } %}
        <span class="pos-op-war-room__tag">
            <i class="fas fa-heart-pulse" aria-hidden="true"></i>
            {{ p1_count > 0 ? 'Pulso elevado' : 'Operação estável' }}
        </span>
    </div>
    {% endif %}

    <div class="clinic-banner {{ p1_count > 0 ? 'clinic-banner--danger' : 'clinic-banner--ok' }} mb-3">
        <i class="fas fa-heart-pulse" aria-hidden="true"></i>
        <div>
            <strong>{{ command_brief.headline }}</strong>
            <div>{{ command_brief.summary }}</div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <section class="unio-card mb-3 p-0">
                {% include 'components/section_header.html.twig' with {
                    title: 'Incidentes P1',
                    subtitle: p1_count ~ ' alerta(s) prioritário(s)'
                } %}
                {% if p1_incidents %}
                {% for inc in p1_incidents %}
                <div class="p-3 border-bottom pos-op-p1-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <strong>{{ inc.paciente_nome }}</strong>
                            <code class="ml-2">{{ inc.paciente_codigo }}</code>
                            <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: inc.paciente_id }) }}" class="btn-unio-ghost btn-xs ml-2">Ficha</a>
                            <p class="mb-1 mt-1">{{ inc.motivo }}</p>
                            <span class="small text-muted">{{ inc.timeline_hint }}</span>
                        </div>
                        <div class="text-right">
                            <span class="badge-perfil danger">{{ inc.prioridade }}</span>
                            <div class="small mt-1{{ inc.sla_breach_imminent ? ' text-danger font-weight-bold' : '' }}">SLA {{ inc.sla_remaining_label }}</div>
                        </div>
                    </div>
                    <form method="post" action="{{ path('app_pos_operatorio_alerta_assumir', {id: inc.id}) }}" class="mt-2">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_alerta_' ~ inc.id) }}">
                        <button type="submit" class="btn-unio btn-sm">Assumir agora</button>
                    </form>
                </div>
                {% endfor %}
                {% else %}
                    {% include 'components/empty_state.html.twig' with {
                        icon: 'fa-heart-pulse',
                        title: 'Operação estável',
                        text: 'Nenhum P1 ativo. Monitore a fila completa se precisar.',
                        btn_label: 'Fila de alertas',
                        btn_href: path('app_pos_operatorio_alertas'),
                        btn_sm: true,
                        compact: true
                    } %}
                {% endif %}
            </section>
        </div>
        <div class="col-lg-4">
            <section class="unio-card p-3">
                <h3 class="h6 mb-2">Índice de severidade</h3>
                <p class="display-4 mb-0">{{ severity_score }}<span class="h6 text-muted">/100</span></p>
                <p class="mb-0 mt-2">
                    <span class="badge-perfil {{ severity_level|default('stable') == 'critical' ? 'danger' : (severity_level|default('stable') == 'elevated' ? 'warning' : 'success') }}">
                        {{ severity_level|default('stable') }}
                    </span>
                </p>
            </section>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/pos-operatorio-live.js') }}?v=1"></script>
{% endblock %}
