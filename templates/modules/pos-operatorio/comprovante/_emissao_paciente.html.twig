<section class="unio-card clinic-carteirinha-paciente__actions">
    <h3 class="clinic-ops-panel__title">Emissão</h3>

    {% if tem_emissao %}
    <p class="text-muted small mb-3">
        Código <strong>{{ paciente.comprovanteVerificacao }}</strong>
        · válido até {{ paciente.comprovanteValidoAte|date('d/m/Y') }}
    </p>
    {% else %}
    <p class="text-muted small mb-3">Nenhum comprovante ativo. É necessário data da cirurgia no cadastro.</p>
    {% endif %}

    <form method="post" action="{{ path('app_pos_operatorio_comprovante_emitir', { id: paciente.id }) }}" class="clinic-carteirinha-form">
        <input type="hidden" name="_token" value="{{ csrf_token('comprovante_emitir_' ~ paciente.id) }}">
        <div class="form-group">
            <label class="unio-form-label" for="validade_dias">Validade (dias)</label>
            <input id="validade_dias" name="validade_dias" type="number" min="7" max="180" class="form-control" value="30">
        </div>
        <button type="submit" class="btn-unio btn-block" {{ paciente.dataCirurgia ? '' : 'disabled' }}>
            {{ tem_emissao ? 'Reemitir comprovante' : 'Emitir comprovante' }}
        </button>
    </form>

    {% if tem_emissao %}
    <form method="post" action="{{ path('app_pos_operatorio_comprovante_revogar', { id: paciente.id }) }}" class="mt-3" onsubmit="return confirm('Revogar comprovante deste paciente?');">
        <input type="hidden" name="_token" value="{{ csrf_token('comprovante_revogar_' ~ paciente.id) }}">
        <button type="submit" class="btn-unio-ghost btn-sm text-danger">Revogar emissão</button>
    </form>
    {% endif %}
</section>
