{% extends 'layout/hub.html.twig' %}

{% block title %}Comprovante · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Comprovante de procedimento' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = 'Documento do episódio cirúrgico com QR de validação pública' %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_pacientes') }}" class="btn-unio-ghost btn-sm">Pacientes</a>
<a href="{{ path('app_pos_operatorio_carteirinha') }}" class="btn-unio-ghost btn-sm">Carteirinhas</a>
{% endblock %}

{% set _cc = comprovante_counts|default({}) %}
{% set _fq = filter_q|default('') %}
{% set _fp = filter_painel|default('') %}
{% set _hidden = _fp != '' ? { painel: _fp } : {} %}
{% set _qmerge = _fq ? { q: _fq } : {} %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_pos_operatorio_comprovante'),
    show_search: true,
    use_form: true,
    search_placeholder: 'Buscar paciente, código ou procedimento…',
    search_name: 'q',
    search_value: _fq,
    hidden_fields: _hidden,
    meta_text: _cc.pendentes|default(0) > 0 and _fp != 'emitidos' ? (_cc.pendentes ~ ' paciente(s) sem comprovante') : ''
} %}
    {% block filter_chips %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar comprovantes',
            chips: [
                { href: path('app_pos_operatorio_comprovante', _qmerge), label: 'Todos', active: _fp == '' },
                { href: path('app_pos_operatorio_comprovante', { painel: 'emitidos' }|merge(_qmerge)), label: 'Emitidos', active: _fp == 'emitidos', count: _cc.emitidos|default(null) },
                { href: path('app_pos_operatorio_comprovante', { painel: 'pendentes' }|merge(_qmerge)), label: 'Sem emissão', active: _fp == 'pendentes', count: _cc.pendentes|default(null) },
            ]
        } %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
<div class="clinic-carteirinha-layout">
    {% if _fp != 'pendentes' %}
    <section class="unio-card clinic-carteirinha-panel p-0 ops-queue-animate">
        <h3 class="clinic-ops-panel__title px-3 pt-3">Emitidos recentemente</h3>
        {% if emitidos is empty %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-file-circle-check',
                title: 'Nenhum comprovante',
                text: 'Nenhum comprovante emitido ainda.',
                btn_label: 'Ver pacientes',
                btn_href: path('app_pos_operatorio_pacientes'),
                btn_sm: true,
                compact: true
            } %}
        {% else %}
        <div class="table-responsive">
            <table class="admin-table clinic-stack-mobile mb-0">
                <thead><tr><th>Paciente</th><th>Procedimento</th><th>Validade</th><th></th></tr></thead>
                <tbody>
                    {% for p in emitidos %}
                    <tr>
                        <td data-label="Paciente"><strong>{{ p.nome }}</strong><span class="d-block text-muted small">{{ p.codigo }}</span></td>
                        <td data-label="Procedimento">{{ p.procedimento|default('—') }}</td>
                        <td data-label="Validade">{{ p.comprovanteValidoAte ? p.comprovanteValidoAte|date('d/m/Y') : '—' }}</td>
                        <td data-label="Ações" class="text-right">
                            {% embed 'components/row_actions_menu.html.twig' with { aria_label: 'Mais ações de ' ~ p.nome } %}
                                {% block items %}
                                <a href="{{ path('app_pos_operatorio_comprovante_paciente', { id: p.id }) }}" class="dropdown-item">Abrir</a>
                                {% endblock %}
                            {% endembed %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </section>
    {% endif %}

    {% if _fp != 'emitidos' %}
    <section class="unio-card clinic-carteirinha-panel p-0 ops-queue-animate">
        <h3 class="clinic-ops-panel__title px-3 pt-3">Pacientes para emitir</h3>
        {% if pacientes is empty %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-user-plus',
                title: 'Sem pacientes',
                text: 'Cadastre pacientes para emitir comprovantes.',
                btn_label: 'Pacientes',
                btn_href: path('app_pos_operatorio_pacientes'),
                btn_icon: 'fa-plus',
                btn_sm: true,
                compact: true
            } %}
        {% else %}
        <div class="table-responsive">
            <table class="admin-table clinic-stack-mobile mb-0">
                <thead><tr><th>Paciente</th><th>Cirurgia</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    {% for p in pacientes %}
                    <tr>
                        <td data-label="Paciente"><strong>{{ p.nome }}</strong></td>
                        <td data-label="Cirurgia">{{ p.dataCirurgia ? p.dataCirurgia|date('d/m/Y') : '—' }}</td>
                        <td data-label="Status">
                            {% if p.hasComprovanteAtivo %}<span class="badge-perfil success">Ativo</span>
                            {% else %}<span class="badge-perfil default">Sem emissão</span>{% endif %}
                        </td>
                        <td data-label="Ações" class="text-right">
                            <a href="{{ path('app_pos_operatorio_comprovante_paciente', { id: p.id }) }}" class="btn-unio btn-sm">
                                {{ p.hasComprovanteAtivo ? 'Gerenciar' : 'Emitir' }}
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </section>
    {% endif %}
</div>
{% endblock %}
