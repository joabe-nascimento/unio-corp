{% extends 'layout/hub.html.twig' %}

{% block title %}Guia médico · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Guia médico' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = 'Orientações por fase exibidas no portal do paciente' %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_guia_medico_novo') }}" class="btn-unio btn-sm">
    <i class="fas fa-plus mr-1"></i> Novo guia
</a>
{% endblock %}

{% set _gc = guia_counts|default({}) %}
{% set _fq = filter_q|default('') %}
{% set _fa = filter_ativo|default('') %}
{% set _fp = filter_padrao|default('') %}
{% set _hidden = {} %}
{% if _fa != '' %}{% set _hidden = _hidden|merge({ ativo: _fa }) %}{% endif %}
{% if _fp != '' %}{% set _hidden = _hidden|merge({ padrao: _fp }) %}{% endif %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_pos_operatorio_guia_medico'),
    show_search: true,
    use_form: true,
    search_placeholder: 'Buscar nome ou tipo de procedimento…',
    search_name: 'q',
    search_value: _fq,
    hidden_fields: _hidden
} %}
    {% block filter_chips %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar guias médicos',
            chips: [
                { href: path('app_pos_operatorio_guia_medico', _fq ? { q: _fq } : {}), label: 'Todos', active: _fa == '' and _fp == '', count: _gc.total|default(null) },
                { href: path('app_pos_operatorio_guia_medico', { ativo: '1' }|merge(_fq ? { q: _fq } : {})), label: 'Ativos', active: _fa == '1' and _fp == '', count: _gc.ativos|default(null) },
                { href: path('app_pos_operatorio_guia_medico', { ativo: '0' }|merge(_fq ? { q: _fq } : {})), label: 'Inativos', active: _fa == '0' and _fp == '', count: _gc.inativos|default(null) },
                { href: path('app_pos_operatorio_guia_medico', { padrao: '1' }|merge(_fq ? { q: _fq } : {})), label: 'Padrão', active: _fp == '1', count: _gc.padrao|default(null) },
            ]
        } %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
{% if guias is empty %}
<section class="unio-card">
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-book-medical',
        title: 'Nenhum guia cadastrado',
        text: 'O sistema usa o modelo padrão até você criar um.',
        btn_label: 'Criar primeiro guia',
        btn_href: path('app_pos_operatorio_guia_medico_novo'),
        btn_icon: 'fa-plus',
        btn_sm: true,
        compact: true
    } %}
</section>
{% else %}
<div class="clinic-guia-list">
    {% for guia in guias %}
    <article class="unio-card clinic-guia-card">
        <header class="clinic-guia-card__head">
            <div>
                <h3>{{ guia.nome }}</h3>
                {% if guia.tipo_procedimento %}
                <p class="text-muted small mb-0">{{ guia.tipo_procedimento }}</p>
                {% endif %}
            </div>
            <div class="d-flex gap-2 align-items-center">
                {% if guia.padrao|default(false) %}
                <span class="badge-perfil success">Padrão</span>
                {% endif %}
                <span class="badge-perfil {{ guia.ativo|default(true) ? 'default' : 'warning' }}">
                    {{ guia.ativo|default(true) ? 'Ativo' : 'Inativo' }}
                </span>
            </div>
        </header>
        <p class="text-muted small">{{ guia.subtitulo|default('') }}</p>
        <ul class="clinic-guia-card__preview">
            {% for line in guia.orientacoes_aguda|default([])|slice(0, 2) %}
            <li>{{ line }}</li>
            {% endfor %}
        </ul>
        <footer class="d-flex justify-content-end mt-3">
            {% embed 'components/row_actions_menu.html.twig' with { aria_label: 'Mais ações do guia' } %}
                {% block items %}
                <a href="{{ path('app_pos_operatorio_guia_medico_editar', { id: guia.id }) }}" class="dropdown-item">Editar</a>
                <div class="dropdown-divider"></div>
                <form method="post" action="{{ path('app_pos_operatorio_guia_medico_excluir', { id: guia.id }) }}" onsubmit="return confirm('Remover este guia?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('guia_medico_delete_' ~ guia.id) }}">
                    <button type="submit" class="dropdown-item text-danger">Excluir</button>
                </form>
                {% endblock %}
            {% endembed %}
        </footer>
    </article>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
