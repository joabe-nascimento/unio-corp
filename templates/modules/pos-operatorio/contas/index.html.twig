{% extends 'layout/hub.html.twig' %}

{% block title %}Contas · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Contas' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Particular, cortesia e convênio após o atendimento' %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_atendimento') }}" class="btn-unio-ghost btn-sm">Atendimentos</a>
<a href="{{ path('app_pos_operatorio_guias') }}" class="btn-unio-ghost btn-sm">Guias TISS</a>
<a href="{{ path('app_pos_operatorio_convenios') }}" class="btn-unio-ghost btn-sm">Convênios</a>
{% endblock %}

{% block hub_content %}
{% if list_truncated|default(false) %}
<div class="alert alert-warning">
    Exibindo as {{ list_limit }} contas mais recentes de {{ list_total }}. Refine o filtro de status para ver o restante.
</div>
{% endif %}
<p class="pos-op-back mb-3">
    <a href="{{ path('app_pos_operatorio_contas', { status: 'aberto' }) }}" class="{{ filtro_status == 'aberto' ? 'fw-bold' : '' }}">Abertas</a>
    <a href="{{ path('app_pos_operatorio_contas', { status: 'pago' }) }}" class="{{ filtro_status == 'pago' ? 'fw-bold' : '' }}">Pagas</a>
    <a href="{{ path('app_pos_operatorio_contas', { status: 'glosado' }) }}" class="{{ filtro_status == 'glosado' ? 'fw-bold' : '' }}">Glosadas</a>
    <a href="{{ path('app_pos_operatorio_contas', { status: 'cancelado' }) }}" class="{{ filtro_status == 'cancelado' ? 'fw-bold' : '' }}">Canceladas</a>
    <a href="{{ path('app_pos_operatorio_contas', { status: 'todos' }) }}" class="{{ filtro_status == 'todos' ? 'fw-bold' : '' }}">Todas</a>
</p>

<section class="unio-card p-0 clinic-conta-card">
    {% if contas is empty %}
    <div class="p-4 text-muted">Nenhuma conta neste filtro. Contas nascem ao finalizar um atendimento.</div>
    {% else %}
    <div class="table-responsive clinic-conta-table-wrap">
        <table class="table admin-table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Criada</th>
                    <th>Paciente</th>
                    <th>Descrição</th>
                    <th>Tipo</th>
                    <th>Status</th>
                    <th>Valor</th>
                    <th class="clinic-conta-col-actions">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for c in contas %}
                {% set guia = guia_por_conta[c.id]|default(null) %}
                {% set can_settle = c.status == 'aberto' and c.tipo != 'convenio' and not guia %}
                {% set can_cancel = c.status == 'aberto' and c.tipo != 'convenio' %}
                {% set has_atendimento = c.atendimento is not null %}
                {% set show_overflow = can_settle or (guia and has_atendimento) or (not guia and not can_settle and has_atendimento) %}
                <tr>
                    <td data-label="Criada">{{ c.criadoEm|date('d/m/Y H:i') }}</td>
                    <td data-label="Paciente">
                        <strong>{{ c.paciente.nome }}</strong>
                        <div class="small text-muted">{{ c.paciente.codigo }}</div>
                    </td>
                    <td data-label="Descrição">{{ c.descricao|default('—') }}</td>
                    <td data-label="Tipo">{{ tipo_labels[c.tipo]|default(c.tipo) }}</td>
                    <td data-label="Status">{{ status_labels[c.status]|default(c.status) }}</td>
                    <td data-label="Valor">
                        {% if c.valorCentavos is not null %}
                            R$ {{ (c.valorCentavos / 100)|number_format(2, ',', '.') }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td data-label="Ações" class="clinic-conta-col-actions clinic-agenda-col-actions">
                        <div class="clinic-agenda-row-actions clinic-conta-row-actions">
                            <div class="clinic-agenda-row-actions__primary">
                                {% if guia %}
                                <a href="{{ path('app_pos_operatorio_guias_show', { id: guia.id }) }}" class="btn-unio btn-sm">Abrir guia</a>
                                {% elseif can_settle %}
                                <form method="post" action="{{ path('app_pos_operatorio_contas_acao', { id: c.id }) }}" class="clinic-conta-pay-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('clinic_conta_' ~ c.id) }}">
                                    <input type="text" name="valor" class="form-control form-control-sm clinic-conta-row-actions__valor" placeholder="0,00" inputmode="decimal" required aria-label="Valor pago">
                                    <button type="submit" name="action" value="pago" class="btn-unio btn-sm">Pago</button>
                                </form>
                                {% elseif has_atendimento %}
                                <a href="{{ path('app_pos_operatorio_atendimento_show', { id: c.atendimento.id }) }}" class="btn-unio-ghost btn-sm">Atendimento</a>
                                {% else %}
                                <span class="text-muted small">—</span>
                                {% endif %}
                            </div>

                            {% if show_overflow %}
                            <div class="dropdown clinic-agenda-row-actions__menu">
                                <button type="button"
                                        class="clinic-agenda-menu-btn"
                                        data-toggle="dropdown"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        aria-label="Mais ações para {{ c.paciente.nome|e('html_attr') }}"
                                        title="Mais ações">
                                    <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right unio-dropdown clinic-agenda-row-dropdown clinic-conta-row-dropdown">
                                    {% if can_settle %}
                                    <form method="post" action="{{ path('app_pos_operatorio_contas_acao', { id: c.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clinic_conta_' ~ c.id) }}">
                                        <button type="submit" name="action" value="cortesia" class="dropdown-item">
                                            <i class="fas fa-gift" aria-hidden="true"></i> Cortesia
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('app_pos_operatorio_contas_acao', { id: c.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clinic_conta_' ~ c.id) }}">
                                        <button type="submit" name="action" value="cancelar" class="dropdown-item text-danger">
                                            <i class="fas fa-ban" aria-hidden="true"></i> Cancelar
                                        </button>
                                    </form>
                                    {% if convenios is not empty %}
                                    <div class="dropdown-divider"></div>
                                    <form method="post" action="{{ path('app_pos_operatorio_guias_from_conta', { contaId: c.id }) }}" class="clinic-conta-guia-form px-3 py-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clinic_conta_guia_' ~ c.id) }}">
                                        <label class="small text-muted d-block mb-1" for="convenio_id_{{ c.id }}">Gerar guia TISS</label>
                                        <select id="convenio_id_{{ c.id }}" name="convenio_id" class="form-control form-control-sm clinic-conta-row-actions__convenio mb-2" required aria-label="Convênio">
                                            <option value="">Convênio…</option>
                                            {% for conv in convenios %}
                                            <option value="{{ conv.id }}">{{ conv.nome }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn-unio-ghost btn-sm btn-block">Gerar guia</button>
                                    </form>
                                    {% endif %}
                                    {% elseif guia %}
                                    {% if has_atendimento %}
                                    <a href="{{ path('app_pos_operatorio_atendimento_show', { id: c.atendimento.id }) }}" class="dropdown-item">
                                        <i class="fas fa-stethoscope" aria-hidden="true"></i> Atendimento
                                    </a>
                                    {% endif %}
                                    {% else %}
                                    {% if has_atendimento %}
                                    <a href="{{ path('app_pos_operatorio_atendimento_show', { id: c.atendimento.id }) }}" class="dropdown-item">
                                        <i class="fas fa-stethoscope" aria-hidden="true"></i> Atendimento
                                    </a>
                                    {% endif %}
                                    {% if can_cancel %}
                                    {% if has_atendimento %}<div class="dropdown-divider"></div>{% endif %}
                                    <form method="post" action="{{ path('app_pos_operatorio_contas_acao', { id: c.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clinic_conta_' ~ c.id) }}">
                                        <button type="submit" name="action" value="cancelar" class="dropdown-item text-danger">
                                            <i class="fas fa-ban" aria-hidden="true"></i> Cancelar
                                        </button>
                                    </form>
                                    {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
