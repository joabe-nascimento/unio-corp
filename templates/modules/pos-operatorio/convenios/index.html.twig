{% extends 'layout/hub.html.twig' %}
{% import 'macros/cadastro_offcanvas.html.twig' as cadastro %}

{% block title %}Convênios · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Convênios' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Operadoras para guias TISS' %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_guias') }}" class="btn-unio-ghost btn-sm">Guias TISS</a>
<a href="{{ path('app_pos_operatorio_contas') }}" class="btn-unio-ghost btn-sm">Contas</a>
{{ cadastro.create_button('clinic-convenio', 'Novo convênio') }}
{% endblock %}

{% set _cc = convenio_counts|default({}) %}
{% set _fq = filter_q|default('') %}
{% set _fa = filter_ativo|default('') %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_pos_operatorio_convenios'),
    show_search: true,
    use_form: true,
    search_placeholder: 'Buscar nome, ANS ou código…',
    search_name: 'q',
    search_value: _fq,
    hidden_fields: _fa != '' ? { ativo: _fa } : {}
} %}
    {% block filter_chips %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar convênios',
            chips: [
                { href: path('app_pos_operatorio_convenios', _fq ? { q: _fq } : {}), label: 'Todos', active: _fa == '', count: _cc.total|default(null) },
                { href: path('app_pos_operatorio_convenios', { ativo: '1' }|merge(_fq ? { q: _fq } : {})), label: 'Ativos', active: _fa == '1', count: _cc.ativos|default(null) },
                { href: path('app_pos_operatorio_convenios', { ativo: '0' }|merge(_fq ? { q: _fq } : {})), label: 'Inativos', active: _fa == '0', count: _cc.inativos|default(null) },
            ]
        } %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
<section class="unio-card clinic-convenio-list p-0">
    {% if convenios is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-building',
            title: 'Nenhum convênio cadastrado',
            text: 'Cadastre a primeira operadora para guias TISS.',
            btn_sm: true,
            compact: true,
            btn_label: 'Novo convênio',
            btn_opens: 'clinic-convenio',
            btn_icon: 'fa-plus'
        } %}
    {% else %}
    <div class="clinic-cadastro-list">
        {% for c in convenios %}
        <article class="clinic-cadastro-item clinic-cadastro-item--rich">
            <div class="clinic-cadastro-item__view">
                <div class="clinic-cadastro-item__main">
                    <div class="clinic-cadastro-item__body">
                        <div class="clinic-cadastro-item__title-row">
                            <h3 class="clinic-cadastro-item__title">{{ c.nome }}</h3>
                            <span class="clinic-cadastro-chip {{ c.ativo ? 'clinic-cadastro-chip--ok' : 'clinic-cadastro-chip--off' }}">
                                {{ c.ativo ? 'Ativo' : 'Inativo' }}
                            </span>
                        </div>
                        <dl class="clinic-cadastro-facts">
                            {% if c.registroAns %}
                            <div>
                                <dt>ANS</dt>
                                <dd>{{ c.registroAns }}</dd>
                            </div>
                            {% endif %}
                            {% if c.versaoTiss %}
                            <div>
                                <dt>TISS</dt>
                                <dd>{{ c.versaoTiss }}</dd>
                            </div>
                            {% endif %}
                            <div>
                                <dt>Prazo glosa</dt>
                                <dd>{{ c.prazoGlosaDias }} dias</dd>
                            </div>
                            {% if c.telefoneFaturamento or c.emailFaturamento %}
                            <div>
                                <dt>Faturamento</dt>
                                <dd>
                                    {% if c.telefoneFaturamento %}{{ c.telefoneFaturamento|br_phone }}{% endif %}
                                    {% if c.telefoneFaturamento and c.emailFaturamento %} · {% endif %}
                                    {% if c.emailFaturamento %}{{ c.emailFaturamento }}{% endif %}
                                </dd>
                            </div>
                            {% endif %}
                        </dl>
                    </div>
                </div>
                <div class="clinic-cadastro-item__actions">
                    {{ cadastro.edit_button('clinic-convenio', c.id, csrf_token('clinic_convenio_' ~ c.id), {
                        fields: {
                            nome: c.nome,
                            registro_ans: c.registroAns|default(''),
                            cnpj: c.cnpj|default(''),
                            codigo_prestador: c.codigoPrestador|default(''),
                            versao_tiss: c.versaoTiss|default(''),
                            contato_faturamento: c.contatoFaturamento|default(''),
                            email_faturamento: c.emailFaturamento|default(''),
                            telefone_faturamento: c.telefoneFaturamento|default(''),
                            prazo_glosa_dias: c.prazoGlosaDias,
                            observacoes: c.observacoes|default(''),
                            ativo: c.ativo ? '1' : '0'
                        }
                    }) }}
                </div>
            </div>
        </article>
        {% endfor %}
    </div>
    {% endif %}
</section>

{% embed 'components/cadastro_form_offcanvas.html.twig' with {
    id: 'clinic-convenio',
    form_id: 'clinicConvenioForm',
    title: 'Novo convênio',
    title_edit: 'Editar convênio',
    subtitle: 'Operadora, TISS e faturamento',
    icon: 'fa-building',
    size: 'lg',
    create_action: path('app_pos_operatorio_convenios'),
    edit_action: path('app_pos_operatorio_convenios_editar', { id: 0 }),
    create_token: csrf_token('clinic_convenio_new'),
    ativo_label: 'Convênio ativo'
} %}
    {% block form_fields %}
        <fieldset class="crm-form-section">
            <legend class="crm-form-section__title">Operadora</legend>
            {% include 'components/unio_form_field.html.twig' with {
                id: 'conv_nome', name: 'nome', label: 'Nome da operadora', required: true,
                placeholder: 'Ex.: Unimed', attrs: { maxlength: '180' }
            } %}
            <div class="row g-2">
                <div class="col-md-4">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_ans', name: 'registro_ans', label: 'Registro ANS',
                        placeholder: '343889', inputmode: 'numeric',
                        attrs: { maxlength: '20', pattern: '[0-9]*', autocomplete: 'off' }
                    } %}
                </div>
                <div class="col-md-4">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_cnpj', name: 'cnpj', label: 'CNPJ',
                        placeholder: '00.000.000/0001-00', inputmode: 'numeric',
                        attrs: { maxlength: '18', 'data-mask': 'cnpj', autocomplete: 'off' }
                    } %}
                </div>
                <div class="col-md-4">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_prest', name: 'codigo_prestador', label: 'Cód. prestador',
                        placeholder: 'Na operadora', attrs: { maxlength: '40' }
                    } %}
                </div>
            </div>
        </fieldset>
        <fieldset class="crm-form-section">
            <legend class="crm-form-section__title">TISS e glosa</legend>
            <div class="row g-2">
                <div class="col-md-6">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_tiss', name: 'versao_tiss', label: 'Versão TISS', type: 'select',
                        options: versoes_tiss
                    } %}
                </div>
                <div class="col-md-6">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_glosa', name: 'prazo_glosa_dias', label: 'Prazo de glosa (dias)', type: 'number',
                        value: '30', placeholder: '30', required: true,
                        attrs: { min: '1', max: '180' }
                    } %}
                </div>
            </div>
        </fieldset>
        <fieldset class="crm-form-section">
            <legend class="crm-form-section__title">Contato de faturamento</legend>
            {% include 'components/unio_form_field.html.twig' with {
                id: 'conv_contato', name: 'contato_faturamento', label: 'Nome do contato',
                placeholder: 'Responsável pelo faturamento', attrs: { maxlength: '120' }
            } %}
            <div class="row g-2">
                <div class="col-md-6">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_email', name: 'email_faturamento', label: 'E-mail', type: 'email',
                        placeholder: 'faturamento@operadora.com',
                        attrs: { maxlength: '120', autocomplete: 'email' }
                    } %}
                </div>
                <div class="col-md-6">
                    {% include 'components/unio_form_field.html.twig' with {
                        id: 'conv_tel', name: 'telefone_faturamento', label: 'Telefone',
                        placeholder: '(11) 3000-0000', inputmode: 'tel',
                        attrs: { maxlength: '16', 'data-mask': 'phone', autocomplete: 'tel' }
                    } %}
                </div>
            </div>
            {% include 'components/unio_form_field.html.twig' with {
                id: 'conv_obs', name: 'observacoes', label: 'Observações', type: 'textarea', rows: 2,
                placeholder: 'Regras internas, tabela própria…'
            } %}
        </fieldset>
    {% endblock %}
{% endembed %}
{% endblock %}
