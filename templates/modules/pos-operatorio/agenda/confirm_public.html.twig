<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if ok|default(false) %}Confirmado{% else %}Confirmação{% endif %} · Unio Saúde</title>
    <style>
        :root { --ink:#132033; --muted:#5b6b7c; --ok:#0f766e; --err:#b45309; --bg:#f4f7fb; }
        * { box-sizing: border-box; }
        body { margin:0; font-family: Georgia, "Times New Roman", serif; background: linear-gradient(160deg,#e8f0f7 0%,#f7fafc 45%,#eef3f8 100%); color:var(--ink); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:1.5rem; }
        .card { width:min(28rem,100%); background:rgba(255,255,255,.92); border:1px solid rgba(19,32,51,.08); border-radius:1.25rem; padding:2rem 1.75rem; box-shadow:0 18px 40px rgba(19,32,51,.08); }
        .brand { font-size:.8rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin:0 0 .75rem; font-family: system-ui, sans-serif; }
        h1 { font-size:1.55rem; margin:0 0 .75rem; line-height:1.25; }
        p { margin:0; color:var(--muted); line-height:1.5; font-family: system-ui, sans-serif; font-size:.95rem; }
        .meta { margin-top:1.25rem; padding-top:1rem; border-top:1px solid rgba(19,32,51,.08); font-family: system-ui, sans-serif; font-size:.9rem; color:var(--ink); }
        .status { display:inline-block; margin-bottom:.85rem; font-family: system-ui, sans-serif; font-size:.75rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color: {% if ok|default(false) %}var(--ok){% else %}var(--err){% endif %}; }
    </style>
</head>
<body>
    <main class="card">
        <p class="brand">Unio Saúde</p>
        <span class="status">{% if ok|default(false) %}Confirmado{% else %}Atenção{% endif %}</span>
        <h1>{{ message }}</h1>
        {% if agendamento is defined and agendamento %}
        <div class="meta">
            <strong>{{ agendamento.titulo|default('Consulta') }}</strong><br>
            {{ agendamento.inicio|date('d/m/Y \\à\\s H:i') }}
            {% if agendamento.medico %}
            <br>Com: {{ agendamento.medico.nome }}
            {% endif %}
        </div>
        {% endif %}
    </main>
</body>
</html>
