{% extends 'layout/hub.html.twig' %}

{% block title %}Agenda · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Agenda' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = vista == 'dia' ? 'Visão do dia — recepção e atendimento' : 'Visão da semana — paciente, médico e status' %}
{% set hub_search_hidden = true %}

{% set status_labels = status_labels|default({
    marcado: 'Marcado',
    confirmado: 'Confirmado',
    chegou: 'Chegou',
    em_atendimento: 'Em atendimento',
    faltou: 'Faltou',
    cancelado: 'Cancelado',
    atendido: 'Atendido'
}) %}
{% set status_tones = {
    marcado: 'default',
    confirmado: 'sky',
    chegou: 'warning',
    em_atendimento: 'amber',
    faltou: 'warning',
    cancelado: 'default',
    atendido: 'success'
} %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_agenda_novo') }}" class="btn-unio btn-sm">Novo horário</a>
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: stats.total|default(0), label: vista == 'dia' ? 'No dia' : 'Na semana', icon: 'fa-calendar', tone: 'sky' },
    { value: stats.confirmado|default(0), label: 'Confirmados', icon: 'fa-check', tone: 'sky' },
    { value: stats.chegou|default(0), label: 'Chegaram', icon: 'fa-door-open', tone: 'amber', variant: (stats.chegou|default(0)) > 0 ? 'warning' : '' },
    { value: stats.em_atendimento|default(0), label: 'Em atendimento', icon: 'fa-stethoscope', tone: 'amber', variant: (stats.em_atendimento|default(0)) > 0 ? 'warning' : '' },
    { value: stats.atendido|default(0), label: 'Atendidos', icon: 'fa-circle-check', tone: 'sage' },
    { value: stats.faltou|default(0), label: 'Faltas', icon: 'fa-user-xmark', tone: 'rose', variant: (stats.faltou|default(0)) > 0 ? 'warning' : '' },
], mb: 'mb-3' } %}
{% endblock %}

{% block hub_content %}
{% set filtro_medico_id = medico_filtro ? medico_filtro.id : null %}
<section class="unio-card mb-3 clinic-agenda-filter">
    <form method="get" action="{{ path('app_pos_operatorio_agenda') }}" class="clinic-agenda-filter__form">
        <div class="clinic-agenda-filter__field">
            <span class="clinic-agenda-filter__label" id="agenda-vista-label">Vista</span>
            <div class="clinic-agenda-seg" role="group" aria-labelledby="agenda-vista-label">
                <a href="{{ path('app_pos_operatorio_agenda', { vista: 'dia', dia: day|date('Y-m-d') }|merge(filtro_medico_id ? { medico_id: filtro_medico_id } : {})) }}"
                   class="{{ vista == 'dia' ? 'is-active' : '' }}">Dia</a>
                <a href="{{ path('app_pos_operatorio_agenda', { vista: 'semana', semana: week_start|date('Y-m-d') }|merge(filtro_medico_id ? { medico_id: filtro_medico_id } : {})) }}"
                   class="{{ vista == 'semana' ? 'is-active' : '' }}">Semana</a>
            </div>
        </div>

        {% if vista == 'dia' %}
        <div class="clinic-agenda-filter__field clinic-agenda-filter__field--date">
            <label class="clinic-agenda-filter__label" for="dia">Dia</label>
            <input id="dia" type="date" name="dia" class="form-control form-control-sm" value="{{ day|date('Y-m-d') }}">
            <input type="hidden" name="vista" value="dia">
        </div>
        {% else %}
        <div class="clinic-agenda-filter__field clinic-agenda-filter__field--date">
            <label class="clinic-agenda-filter__label" for="semana">A partir de</label>
            <input id="semana" type="date" name="semana" class="form-control form-control-sm" value="{{ week_start|date('Y-m-d') }}">
            <input type="hidden" name="vista" value="semana">
        </div>
        {% endif %}

        <div class="clinic-agenda-filter__field clinic-agenda-filter__field--medico">
            <label class="clinic-agenda-filter__label" for="medico_id">Médico</label>
            <select id="medico_id" name="medico_id" class="form-control form-control-sm">
                <option value="">Todos</option>
                {% for m in medicos %}
                <option value="{{ m.id }}" {{ medico_filtro and medico_filtro.id == m.id ? 'selected' : '' }}>{{ m.nome }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="clinic-agenda-filter__actions">
            <span class="clinic-agenda-filter__label clinic-agenda-filter__label--spacer" aria-hidden="true">&nbsp;</span>
            <div class="clinic-agenda-filter__actions-row">
                <button type="submit" class="btn-unio-ghost btn-sm">Filtrar</button>
                <a href="{{ path('app_pos_operatorio_agenda', { vista: vista }) }}" class="btn-unio-ghost btn-sm">
                    {{ vista == 'dia' ? 'Hoje' : 'Semana atual' }}
                </a>
            </div>
        </div>

        <div class="clinic-agenda-filter__meta">
            <span class="clinic-agenda-filter__label clinic-agenda-filter__label--spacer" aria-hidden="true">&nbsp;</span>
            <p class="clinic-agenda-filter__meta-text mb-0">
                {% if vista == 'dia' %}
                {{ day|date('d/m/Y') }}
                {% else %}
                {{ week_start|date('d/m') }} — {{ week_end|date_modify('-1 day')|date('d/m/Y') }}
                {% endif %}
                · {{ agendamentos|length }} horário(s)
            </p>
        </div>
    </form>
</section>

<section class="unio-card clinic-agenda-card">
    {% if agendamentos is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-calendar-plus',
            title: 'Nenhum agendamento',
            text: vista == 'dia' ? 'Nenhum horário neste dia.' : 'Nenhum horário nesta semana.',
            btn_label: 'Criar horário',
            btn_href: path('app_pos_operatorio_agenda_novo'),
            btn_icon: 'fa-plus',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive clinic-agenda-table-wrap">
        <table class="admin-table clinic-stack-mobile">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Título</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for a in agendamentos %}
                <tr class="{{ a.status == 'em_atendimento' ? 'admin-table-row--highlight' : '' }}">
                    <td data-label="Quando">
                        {% if vista == 'dia' %}
                        <strong>{{ a.inicio|date('H:i') }}</strong>
                        {% else %}
                        <strong>{{ a.inicio|date('d/m H:i') }}</strong>
                        {% endif %}
                        <span class="d-block text-muted small">até {{ a.fim|date('H:i') }}</span>
                    </td>
                    <td data-label="Paciente">
                        <strong>{{ a.paciente.nome }}</strong>
                        <span class="d-block text-muted small">{{ a.paciente.codigo }}</span>
                    </td>
                    <td data-label="Médico">{{ a.medico ? a.medico.nome : '—' }}</td>
                    <td data-label="Título">
                        {{ a.titulo|default('Consulta') }}
                        {% if a.protocoloDia %}
                        <span class="d-block text-muted small">D+{{ a.protocoloDia }} · {{ a.origem }}</span>
                        {% elseif a.origem == 'protocolo' %}
                        <span class="d-block text-muted small">{{ a.origem }}</span>
                        {% endif %}
                    </td>
                    <td data-label="Status">
                        <span class="badge-perfil {{ status_tones[a.status]|default('default') }}">{{ status_labels[a.status]|default(a.status) }}</span>
                    </td>
                    <td data-label="" class="text-right clinic-agenda-col-actions">
                        {% set wa = whatsapp_map[a.id]|default(null) %}
                        {% set can_faltou_cancelar = a.status not in ['cancelado', 'atendido', 'faltou', 'em_atendimento'] %}
                        {% set show_whatsapp = wa and a.status in ['marcado', 'confirmado'] %}
                        {# CTA = próximo passo do fluxo; Editar no ⋮. Sem próximo passo: Editar no botão (sem duplicar no menu). #}
                        {% set edit_as_primary = a.status not in ['marcado', 'confirmado', 'chegou', 'em_atendimento'] %}
                        {% set show_overflow = (not edit_as_primary) or show_whatsapp or can_faltou_cancelar %}
                        <div class="clinic-agenda-row-actions">
                            <div class="clinic-agenda-row-actions__primary">
                                {% if a.status == 'marcado' %}
                                <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                    <input type="hidden" name="status" value="confirmado">
                                    <input type="hidden" name="vista" value="{{ vista }}">
                                    {% if filtro_medico_id %}
                                    <input type="hidden" name="medico_id" value="{{ filtro_medico_id }}">
                                    {% endif %}
                                    <button type="submit" class="btn-unio btn-sm">Confirmar</button>
                                </form>
                                {% elseif a.status == 'confirmado' %}
                                <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                    <input type="hidden" name="status" value="chegou">
                                    <input type="hidden" name="vista" value="{{ vista }}">
                                    {% if filtro_medico_id %}
                                    <input type="hidden" name="medico_id" value="{{ filtro_medico_id }}">
                                    {% endif %}
                                    <button type="submit" class="btn-unio btn-sm">Chegou</button>
                                </form>
                                {% elseif a.status == 'chegou' %}
                                <form method="post" action="{{ path('app_pos_operatorio_atendimento_abrir', { agendamentoId: a.id }) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('clinic_atendimento_abrir_' ~ a.id) }}">
                                    <button type="submit" class="btn-unio btn-sm">Atender</button>
                                </form>
                                {% elseif a.status == 'em_atendimento' %}
                                <form method="post" action="{{ path('app_pos_operatorio_atendimento_abrir', { agendamentoId: a.id }) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('clinic_atendimento_abrir_' ~ a.id) }}">
                                    <button type="submit" class="btn-unio btn-sm">Abrir atendimento</button>
                                </form>
                                {% elseif edit_as_primary %}
                                <a href="{{ path('app_pos_operatorio_agenda_editar', { id: a.id }) }}" class="btn-unio-ghost btn-sm">Editar</a>
                                {% endif %}
                            </div>

                            {% if show_overflow %}
                            <div class="dropdown clinic-agenda-row-actions__menu">
                                <button type="button"
                                        class="clinic-agenda-menu-btn"
                                        data-toggle="dropdown"
                                        data-display="static"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        aria-label="Mais ações para {{ a.paciente.nome|e('html_attr') }}"
                                        title="Mais ações">
                                    <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right unio-dropdown clinic-agenda-row-dropdown">
                                    {% if not edit_as_primary %}
                                    <a href="{{ path('app_pos_operatorio_agenda_editar', { id: a.id }) }}" class="dropdown-item">Editar</a>
                                    {% endif %}
                                    {% if show_whatsapp %}
                                    <a href="{{ wa }}" class="dropdown-item" target="_blank" rel="noopener">WhatsApp</a>
                                    {% endif %}
                                    {% if can_faltou_cancelar %}
                                    {% if not edit_as_primary or show_whatsapp %}
                                    <div class="dropdown-divider"></div>
                                    {% endif %}
                                    <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                        <input type="hidden" name="status" value="faltou">
                                        <input type="hidden" name="vista" value="{{ vista }}">
                                        {% if filtro_medico_id %}
                                        <input type="hidden" name="medico_id" value="{{ filtro_medico_id }}">
                                        {% endif %}
                                        <button type="submit" class="dropdown-item">Faltou</button>
                                    </form>
                                    <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                        <input type="hidden" name="status" value="cancelado">
                                        <input type="hidden" name="vista" value="{{ vista }}">
                                        {% if filtro_medico_id %}
                                        <input type="hidden" name="medico_id" value="{{ filtro_medico_id }}">
                                        {% endif %}
                                        <button type="submit" class="dropdown-item text-danger">Cancelar</button>
                                    </form>
                                    {% endif %}
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
