{% extends 'layout/hub.html.twig' %}

{% block title %}Agenda · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Agenda' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = vista == 'dia' ? 'Visão do dia — recepção e atendimento' : 'Visão da semana — paciente, médico e status' %}
{% set hub_search_hidden = true %}

{% set status_labels = status_labels|default({
    marcado: 'Marcado',
    confirmado: 'Confirmado',
    chegou: 'Chegou',
    em_atendimento: 'Em atendimento',
    faltou: 'Faltou',
    cancelado: 'Cancelado',
    atendido: 'Atendido'
}) %}
{% set status_tones = {
    marcado: 'default',
    confirmado: 'sky',
    chegou: 'warning',
    em_atendimento: 'amber',
    faltou: 'warning',
    cancelado: 'default',
    atendido: 'success'
} %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_agenda_novo') }}" class="btn-unio btn-sm">Novo horário</a>
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: stats.total|default(0), label: vista == 'dia' ? 'No dia' : 'Na semana', icon: 'fa-calendar', tone: 'sky' },
    { value: stats.confirmado|default(0), label: 'Confirmados', icon: 'fa-check', tone: 'sky' },
    { value: stats.chegou|default(0), label: 'Chegaram', icon: 'fa-door-open', tone: 'amber', variant: (stats.chegou|default(0)) > 0 ? 'warning' : '' },
    { value: stats.em_atendimento|default(0), label: 'Em atendimento', icon: 'fa-stethoscope', tone: 'amber', variant: (stats.em_atendimento|default(0)) > 0 ? 'warning' : '' },
    { value: stats.atendido|default(0), label: 'Atendidos', icon: 'fa-circle-check', tone: 'sage' },
    { value: stats.faltou|default(0), label: 'Faltas', icon: 'fa-user-xmark', tone: 'rose', variant: (stats.faltou|default(0)) > 0 ? 'warning' : '' },
], mb: 'mb-3' } %}
{% endblock %}

{% block hub_content %}
<section class="unio-card mb-3 p-3">
    <form method="get" action="{{ path('app_pos_operatorio_agenda') }}" class="d-flex flex-wrap gap-3 align-items-end">
        <div class="d-flex gap-1 align-items-center">
            <span class="small text-muted mr-1">Vista</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Vista da agenda">
                <a href="{{ path('app_pos_operatorio_agenda', { vista: 'dia', dia: day|date('Y-m-d'), medico_id: medico_filtro ? medico_filtro.id : null }) }}"
                   class="btn-unio-ghost btn-sm {{ vista == 'dia' ? 'is-active' : '' }}">Dia</a>
                <a href="{{ path('app_pos_operatorio_agenda', { vista: 'semana', semana: week_start|date('Y-m-d'), medico_id: medico_filtro ? medico_filtro.id : null }) }}"
                   class="btn-unio-ghost btn-sm {{ vista == 'semana' ? 'is-active' : '' }}">Semana</a>
            </div>
        </div>

        {% if vista == 'dia' %}
        <div>
            <label class="small text-muted d-block" for="dia">Dia</label>
            <input id="dia" type="date" name="dia" class="form-control form-control-sm" value="{{ day|date('Y-m-d') }}">
            <input type="hidden" name="vista" value="dia">
        </div>
        {% else %}
        <div>
            <label class="small text-muted d-block" for="semana">Semana a partir de</label>
            <input id="semana" type="date" name="semana" class="form-control form-control-sm" value="{{ week_start|date('Y-m-d') }}">
            <input type="hidden" name="vista" value="semana">
        </div>
        {% endif %}

        <div>
            <label class="small text-muted d-block" for="medico_id">Médico</label>
            <select id="medico_id" name="medico_id" class="form-control form-control-sm">
                <option value="">Todos</option>
                {% for m in medicos %}
                <option value="{{ m.id }}" {{ medico_filtro and medico_filtro.id == m.id ? 'selected' : '' }}>{{ m.nome }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="btn-unio-ghost btn-sm">Filtrar</button>
        <a href="{{ path('app_pos_operatorio_agenda', { vista: vista }) }}" class="btn-unio-ghost btn-sm">
            {{ vista == 'dia' ? 'Hoje' : 'Semana atual' }}
        </a>
        <span class="text-muted small align-self-center ml-auto">
            {% if vista == 'dia' %}
            {{ day|date('d/m/Y') }}
            {% else %}
            {{ week_start|date('d/m') }} — {{ week_end|date_modify('-1 day')|date('d/m/Y') }}
            {% endif %}
            · {{ agendamentos|length }} horário(s)
        </span>
    </form>
</section>

<section class="unio-card">
    {% if agendamentos is empty %}
    <p class="text-muted p-4 mb-0">
        Nenhum agendamento {{ vista == 'dia' ? 'neste dia' : 'nesta semana' }}.
        <a href="{{ path('app_pos_operatorio_agenda_novo') }}">Criar horário</a>
    </p>
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Título</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for a in agendamentos %}
                <tr class="{{ a.status == 'em_atendimento' ? 'admin-table-row--highlight' : '' }}">
                    <td>
                        {% if vista == 'dia' %}
                        <strong>{{ a.inicio|date('H:i') }}</strong>
                        {% else %}
                        <strong>{{ a.inicio|date('d/m H:i') }}</strong>
                        {% endif %}
                        <span class="d-block text-muted small">até {{ a.fim|date('H:i') }}</span>
                    </td>
                    <td>
                        <strong>{{ a.paciente.nome }}</strong>
                        <span class="d-block text-muted small">{{ a.paciente.codigo }}</span>
                    </td>
                    <td>{{ a.medico ? a.medico.nome : '—' }}</td>
                    <td>
                        {{ a.titulo|default('Consulta') }}
                        {% if a.protocoloDia %}
                        <span class="d-block text-muted small">D+{{ a.protocoloDia }} · {{ a.origem }}</span>
                        {% elseif a.origem == 'protocolo' %}
                        <span class="d-block text-muted small">{{ a.origem }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge-perfil {{ status_tones[a.status]|default('default') }}">{{ status_labels[a.status]|default(a.status) }}</span>
                    </td>
                    <td class="text-right">
                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                            {% set wa = whatsapp_map[a.id]|default(null) %}
                            {% if wa and a.status in ['marcado', 'confirmado'] %}
                            <a href="{{ wa }}" class="btn-unio-ghost btn-sm" target="_blank" rel="noopener" title="Confirmar no WhatsApp">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
                            </a>
                            {% endif %}
                            <a href="{{ path('app_pos_operatorio_agenda_editar', { id: a.id }) }}" class="btn-unio-ghost btn-sm">Editar</a>

                            {% if a.status == 'marcado' %}
                            <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                <input type="hidden" name="status" value="confirmado">
                                <input type="hidden" name="vista" value="{{ vista }}">
                                <button type="submit" class="btn-unio-ghost btn-sm">Confirmar</button>
                            </form>
                            {% endif %}

                            {% if a.status in ['marcado', 'confirmado'] %}
                            <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                <input type="hidden" name="status" value="chegou">
                                <input type="hidden" name="vista" value="{{ vista }}">
                                <button type="submit" class="btn-unio btn-sm">Chegou</button>
                            </form>
                            {% endif %}

                            {% if a.status == 'chegou' %}
                            <a href="{{ path('app_pos_operatorio_atendimento_abrir', { agendamentoId: a.id }) }}" class="btn-unio btn-sm">Atender</a>
                            {% endif %}

                            {% if a.status == 'em_atendimento' %}
                            <a href="{{ path('app_pos_operatorio_atendimento_abrir', { agendamentoId: a.id }) }}" class="btn-unio btn-sm">Abrir atendimento</a>
                            {% endif %}

                            {% if a.status in ['chegou', 'em_atendimento', 'confirmado'] %}
                            <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                <input type="hidden" name="status" value="atendido">
                                <input type="hidden" name="vista" value="{{ vista }}">
                                <button type="submit" class="btn-unio-ghost btn-sm">Atendido</button>
                            </form>
                            {% endif %}

                            {% if a.status not in ['cancelado', 'atendido', 'faltou'] %}
                            <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                <input type="hidden" name="status" value="faltou">
                                <input type="hidden" name="vista" value="{{ vista }}">
                                <button type="submit" class="btn-unio-ghost btn-sm">Faltou</button>
                            </form>
                            <form method="post" action="{{ path('app_pos_operatorio_agenda_status', { id: a.id }) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_status_' ~ a.id) }}">
                                <input type="hidden" name="status" value="cancelado">
                                <input type="hidden" name="vista" value="{{ vista }}">
                                <button type="submit" class="btn-unio-ghost btn-sm">Cancelar</button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
