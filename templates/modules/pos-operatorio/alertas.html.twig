{% extends 'layout/hub.html.twig' %}

{% set _copy = organismo.copy|default({}) %}
{% set _label_alertas = _copy.nav_alertas|default('Alertas') %}

{% block title %}{{ org_clinic|default(false) ? 'Alertas clínicos' : _label_alertas }}{% if not org_clinic %} · {{ _copy.brand_name|default('Studio') }}{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = org_clinic|default(false) ? 'Fila de alertas clínicos' : 'Fila de ' ~ _label_alertas|lower %}
{% set hub_page_eyebrow = org_clinic ? org_brand_label : '' %}
{% set hub_page_subtitle = 'Prioridade P1–P4 · SLA de resposta' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}
{% set status_tones = {
    aberto: 'sky',
    em_atendimento: 'amber',
    resolvido: 'success',
    ativos: 'default'
} %}

{% set _st = filters.status|default('ativos') %}
{% set _pri = filters.prioridade|default('') %}
{% set _ativos_count = stats.abertos|default(0) + stats.em_atendimento|default(0) %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_sala_critica') }}" class="btn-unio btn-sm">
    <i class="fas fa-flag mr-1" aria-hidden="true"></i> {{ _copy.nav_sala_critica|default(org_clinic|default(false) ? 'Sala Crítica P1' : 'Prioridade alta') }}
</a>
{% if not org_clinic %}
{% embed 'components/hub_toolbar_more_menu.html.twig' %}
    {% block items %}
    <a href="{{ path('app_pos_operatorio') }}" class="dropdown-item">
        <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Visão geral
    </a>
    {% endblock %}
{% endembed %}
{% endif %}
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: stats.p1, label: 'P1 abertos', icon: 'fa-fire', tone: 'rose', variant: stats.p1 > 0 ? 'danger' : '', pulse: stats.p1 > 0, route: 'app_pos_operatorio_sala_critica' },
    { value: stats.p2, label: 'P2 abertos', icon: 'fa-triangle-exclamation', tone: 'amber', variant: stats.p2 > 0 ? 'warning' : '' },
    { value: stats.abertos, label: 'Aguardando', icon: 'fa-inbox', tone: 'sky' },
    { value: stats.em_atendimento, label: 'Em atendimento', icon: 'fa-user-nurse', tone: 'sage' },
], mb: 'mb-3' } %}
{% endblock %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with { use_form: false } %}
    {% block filter_chips %}
    <div class="hub-page-filter-bar__chip-groups">
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar por status',
            chips: [
                { href: path('app_pos_operatorio_alertas', { status: 'ativos' }|merge(_pri ? { prioridade: _pri } : {})), label: 'Ativos', active: _st == 'ativos' or not _st, count: _ativos_count },
                { href: path('app_pos_operatorio_alertas', { status: 'aberto' }|merge(_pri ? { prioridade: _pri } : {})), label: 'Aberto', active: _st == 'aberto', count: stats.abertos|default(null) },
                { href: path('app_pos_operatorio_alertas', { status: 'em_atendimento' }|merge(_pri ? { prioridade: _pri } : {})), label: 'Em atendimento', active: _st == 'em_atendimento', count: stats.em_atendimento|default(null) },
                { href: path('app_pos_operatorio_alertas', { status: 'resolvido' }|merge(_pri ? { prioridade: _pri } : {})), label: 'Resolvido', active: _st == 'resolvido' },
            ]
        } %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar por prioridade',
            chips: [
                { href: path('app_pos_operatorio_alertas', { status: _st }), label: 'Todas P', active: _pri == '' },
                { href: path('app_pos_operatorio_alertas', { status: _st, prioridade: 'P1' }), label: 'P1', active: _pri == 'P1', count: stats.p1|default(null) },
                { href: path('app_pos_operatorio_alertas', { status: _st, prioridade: 'P2' }), label: 'P2', active: _pri == 'P2', count: stats.p2|default(null) },
                { href: path('app_pos_operatorio_alertas', { status: _st, prioridade: 'P3' }), label: 'P3', active: _pri == 'P3' },
                { href: path('app_pos_operatorio_alertas', { status: _st, prioridade: 'P4' }), label: 'P4', active: _pri == 'P4' },
            ]
        } %}
    </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
<div data-pos-op-live
     data-pos-op-mercure-url="{{ path('app_pos_operatorio_api_mercure') }}"
     data-pos-op-poll-url="{{ path('app_pos_operatorio_api_alertas_poll') }}"
     data-pos-op-stats="{{ stats|json_encode|e('html_attr') }}"
     hidden aria-hidden="true"></div>

<section class="unio-card p-0 ops-queue-animate mb-3">
    {% if tickets is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-bell',
            title: 'Fila vazia',
            text: 'Nenhum alerta neste filtro.',
            btn_label: 'Sala crítica',
            btn_href: path('app_pos_operatorio_sala_critica'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Pri</th>
                    <th>Paciente</th>
                    <th>Motivo</th>
                    <th>Status</th>
                    <th>Responsável</th>
                    <th>SLA</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for t in tickets %}
                <tr class="admin-table-row">
                    <td data-label="Pri">
                        <span class="badge-perfil {{ t.prioridade == 'P1' ? 'danger' : (t.prioridade == 'P2' ? 'warning' : 'sky') }}">{{ t.prioridade }}</span>
                    </td>
                    <td data-label="Paciente">
                        <strong>{{ t.paciente_nome }}</strong><br>
                        <code class="admin-table-mono">{{ t.paciente_codigo }}</code>
                        {% if t.dia_pos is not null %}<span class="badge-perfil default ml-1">D+{{ t.dia_pos }}</span>{% endif %}
                        <div class="mt-1">
                            <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: t.paciente_id }) }}" class="btn-unio-ghost btn-xs">Ficha</a>
                        </div>
                    </td>
                    <td data-label="Motivo">{{ t.motivo }}</td>
                    <td data-label="Status">
                        <span class="badge-perfil {{ status_tones[t.status]|default('default') }}">{{ t.status_label }}</span>
                    </td>
                    <td data-label="Responsável">{{ t.responsavel }}</td>
                    <td data-label="SLA">
                        {% if t.sla_pct is not null %}
                        <span class="small{{ t.sla_breach_imminent ? ' text-danger font-weight-bold' : '' }}">{{ t.sla_remaining_label }}</span>
                        <div class="progress progress-xs mt-1" style="height:4px">
                            <div class="progress-bar bg-{{ t.sla_pct > 80 ? 'danger' : 'warning' }}" style="width:{{ t.sla_pct }}%"></div>
                        </div>
                        {% else %}—{% endif %}
                    </td>
                    <td data-label="Ações" class="text-nowrap">
                        {% if t.status != 'resolvido' %}
                        <form method="post" action="{{ path('app_pos_operatorio_alerta_assumir', {id: t.id}) }}" class="d-inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_alerta_' ~ t.id) }}">
                            <button type="submit" class="btn-unio-ghost btn-xs">Assumir</button>
                        </form>
                        <form method="post" action="{{ path('app_pos_operatorio_alerta_resolver', {id: t.id}) }}" class="d-inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_alerta_' ~ t.id) }}">
                            <button type="submit" class="btn-unio-ghost btn-xs text-success">Resolver</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/pos-operatorio-live.js') }}?v=1"></script>
{% endblock %}
