{% extends 'layout/hub.html.twig' %}

{% block title %}Painel do dia · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Painel do dia' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Pré-op da semana, retornos, questionários e carteirinhas' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_recepcao') }}" class="btn-unio btn-sm">
    <i class="fas fa-qrcode mr-1" aria-hidden="true"></i> Scanner
</a>
<a href="{{ path('app_pos_operatorio_retornos') }}" class="btn-unio-ghost btn-sm">Retornos</a>
{% endblock %}

{% block hub_content %}
<div class="clinic-ops-stats clinic-ops-stats--4 mb-4">
    <div>
        <dt>Pacientes ativos</dt>
        <dd>{{ painel.totais.pacientes_ativos }}</dd>
    </div>
    <div>
        <dt>Check-ins hoje</dt>
        <dd>{{ painel.totais.checkins }}</dd>
    </div>
    <div>
        <dt>Pré-op (7 dias)</dt>
        <dd>{{ painel.totais.pre_op_semana|default(painel.pre_op_semana|default([])|length) }}</dd>
    </div>
    <div>
        <dt>Sem questionário</dt>
        <dd>{{ painel.sem_questionario|length }}</dd>
    </div>
</div>

<div class="clinic-ops-panels clinic-ops-panels--3">
    <section class="unio-card clinic-ops-panel">
        <h3 class="clinic-ops-panel__title">Pacientes em pré-op esta semana</h3>
        {% if painel.pre_op_semana|default([]) is empty %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-hospital',
                title: 'Sem cirurgias',
                text: 'Nenhuma cirurgia nos próximos 7 dias.',
                btn_label: 'Pacientes',
                btn_href: path('app_pos_operatorio_pacientes'),
                btn_sm: true,
                compact: true
            } %}
        {% else %}
        <ul class="clinic-ops-list">
            {% for p in painel.pre_op_semana|default([]) %}
            <li>
                <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: p.id|default(0) }) }}">{{ p.nome }}</a>
                <span class="text-muted">({{ p.codigo }}) · {{ p.dia_label|default('pré') }}{% if p.data_cirurgia %} · cirurgia {{ p.data_cirurgia }}{% endif %}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>

    <section class="unio-card clinic-ops-panel">
        <h3 class="clinic-ops-panel__title">Retornos hoje</h3>
        {% if painel.retornos_hoje is empty %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-calendar-day',
                title: 'Sem retornos',
                text: 'Nenhum retorno previsto.',
                btn_label: 'Ver retornos',
                btn_href: path('app_pos_operatorio_retornos'),
                btn_sm: true,
                compact: true
            } %}
        {% else %}
        <ul class="clinic-ops-list">
            {% for p in painel.retornos_hoje %}
            <li>{{ p.nome }} ({{ p.codigo }}) · {{ p.dia_label|default(p.dia_pos is not null ? 'D+' ~ p.dia_pos : '—') }}</li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>

    <section class="unio-card clinic-ops-panel">
        <h3 class="clinic-ops-panel__title">Questionário pendente</h3>
        {% if painel.sem_questionario is empty %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-clipboard-check',
                title: 'Tudo respondido',
                text: 'Todos responderam hoje.',
                btn_label: 'Questionários',
                btn_href: path('app_pos_operatorio_questionarios'),
                btn_sm: true,
                compact: true
            } %}
        {% else %}
        <ul class="clinic-ops-list">
            {% for p in painel.sem_questionario %}
            <li>{{ p.nome }} ({{ p.codigo }})</li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
</div>

<section class="unio-card clinic-ops-panel mt-3">
    <h3 class="clinic-ops-panel__title">Carteirinhas vencendo (7 dias)</h3>
    {% if painel.carteirinhas_vencendo is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-id-card',
            title: 'Nenhuma vencendo',
            text: 'Nenhuma carteirinha próxima do vencimento.',
            btn_label: 'Carteirinhas',
            btn_href: path('app_pos_operatorio_carteirinha'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <ul class="clinic-ops-list">
        {% for p in painel.carteirinhas_vencendo %}
        <li>
            <a href="{{ path('app_pos_operatorio_carteirinha_paciente', { id: p.id|default(0) }) }}">{{ p.nome }}</a>
            <span class="text-muted">({{ p.codigo }})</span>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
{% endblock %}
