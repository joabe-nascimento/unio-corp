{% extends 'layout/hub.html.twig' %}

{% block title %}Painel do dia · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Painel do dia' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Retornos, questionários pendentes e carteirinhas a vencer' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_content %}
<p class="pos-op-back">
    <a href="{{ path('app_pos_operatorio_recepcao') }}"><i class="fas fa-qrcode" aria-hidden="true"></i> Abrir scanner da recepção</a>
    <span class="pos-op-back__sep" aria-hidden="true">·</span>
    <a href="{{ path('app_pos_operatorio_comercial') }}">Comercial</a>
</p>

<div class="clinic-ops-stats clinic-ops-stats--4 mb-4">
    <div>
        <dt>Pacientes ativos</dt>
        <dd>{{ painel.totais.pacientes_ativos }}</dd>
    </div>
    <div>
        <dt>Check-ins hoje</dt>
        <dd>{{ painel.totais.checkins }}</dd>
    </div>
    <div>
        <dt>Sem questionário</dt>
        <dd>{{ painel.sem_questionario|length }}</dd>
    </div>
    <div>
        <dt>Carteirinhas vencendo</dt>
        <dd>{{ painel.carteirinhas_vencendo|length }}</dd>
    </div>
</div>

<div class="clinic-ops-panels clinic-ops-panels--3">
    <section class="unio-card clinic-ops-panel">
        <h3 class="clinic-ops-panel__title">Retornos hoje</h3>
        <ul class="clinic-ops-list">
            {% for p in painel.retornos_hoje %}
            <li>{{ p.nome }} ({{ p.codigo }}) — D+{{ p.dia_pos }}</li>
            {% else %}
            <li class="text-muted">Nenhum retorno previsto.</li>
            {% endfor %}
        </ul>
    </section>

    <section class="unio-card clinic-ops-panel">
        <h3 class="clinic-ops-panel__title">Questionário pendente</h3>
        <ul class="clinic-ops-list">
            {% for p in painel.sem_questionario %}
            <li>{{ p.nome }} ({{ p.codigo }})</li>
            {% else %}
            <li class="text-muted">Todos responderam hoje.</li>
            {% endfor %}
        </ul>
    </section>

    <section class="unio-card clinic-ops-panel">
        <h3 class="clinic-ops-panel__title">Carteirinhas vencendo (7 dias)</h3>
        <ul class="clinic-ops-list">
            {% for p in painel.carteirinhas_vencendo %}
            <li>{{ p.nome }} ({{ p.codigo }})</li>
            {% else %}
            <li class="text-muted">Nenhuma carteirinha próxima do vencimento.</li>
            {% endfor %}
        </ul>
    </section>
</div>
{% endblock %}
