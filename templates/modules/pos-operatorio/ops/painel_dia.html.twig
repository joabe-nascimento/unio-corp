{% extends 'layout/hub.html.twig' %}

{% block title %}Painel do dia{% endblock %}

{% block hub_content %}
<section class="pos-op-page">
    <header class="pos-op-page__head">
        <h1>Painel do dia</h1>
        <p>Retornos, questionários pendentes e carteirinhas a vencer.</p>
    </header>

    <div class="pos-op-kpi-strip">
        <div class="pos-op-kpi"><strong>{{ painel.totais.pacientes_ativos }}</strong><span>Pacientes ativos</span></div>
        <div class="pos-op-kpi"><strong>{{ painel.totais.checkins }}</strong><span>Check-ins hoje</span></div>
        <div class="pos-op-kpi"><strong>{{ painel.sem_questionario|length }}</strong><span>Sem questionário</span></div>
        <div class="pos-op-kpi"><strong>{{ painel.carteirinhas_vencendo|length }}</strong><span>Carteirinhas vencendo</span></div>
    </div>

    <div class="pos-op-panel">
        <h2>Retornos hoje</h2>
        <ul class="pos-op-list">
            {% for p in painel.retornos_hoje %}
            <li>{{ p.nome }} ({{ p.codigo }}) — D+{{ p.dia_pos }}</li>
            {% else %}
            <li class="is-empty">Nenhum retorno previsto.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="pos-op-panel">
        <h2>Questionário pendente</h2>
        <ul class="pos-op-list">
            {% for p in painel.sem_questionario %}
            <li>{{ p.nome }} ({{ p.codigo }})</li>
            {% else %}
            <li class="is-empty">Todos responderam hoje.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="pos-op-panel">
        <h2>Carteirinhas vencendo (7 dias)</h2>
        <ul class="pos-op-list">
            {% for p in painel.carteirinhas_vencendo %}
            <li>{{ p.nome }} ({{ p.codigo }})</li>
            {% else %}
            <li class="is-empty">Nenhuma carteirinha próxima do vencimento.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="pos-op-page__actions">
        <a href="{{ path('app_pos_operatorio_recepcao') }}" class="btn btn-primary">Abrir scanner da recepção</a>
    </div>
</section>
{% endblock %}
