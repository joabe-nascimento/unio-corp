{% extends 'layout/hub.html.twig' %}

{% block title %}Lembretes · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Lembretes' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = reminders.continuity_lead|default('Questionários pendentes e confirmação de agenda') %}
{% set hub_search_hidden = true %}
{% set agenda_amanha = reminders.agenda_amanha|default([]) %}

{% block hub_toolbar_actions %}
<form method="post" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_reminders') }}">
    <button type="submit" class="btn-unio btn-sm">Preparar confirmações de amanhã</button>
</form>
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: reminders.pendentes_hoje, label: 'Questionários pendentes', icon: 'fa-bell', tone: 'amber', variant: reminders.pendentes_hoje > 0 ? 'warning' : '' },
    { value: agenda_amanha|length, label: 'Agenda amanhã', icon: 'fa-calendar-check', tone: 'sky' },
], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<div class="clinic-ops-panels">
    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Canais</h3>
        <ul class="clinic-ops-list">
            {% for canal in reminders.canais %}
            <li>
                <strong>{{ canal.nome }}</strong>
                <span class="badge-perfil {{ canal.status == 'active' ? 'success' : (canal.status == 'prepared' ? 'warning' : 'default') }}">
                    {% if canal.status == 'active' %}Ativo{% elseif canal.status == 'prepared' %}Preparado{% elseif canal.status == 'waiting' %}Aguardando provedor{% elseif canal.status == 'off' %}Desligado{% else %}{{ canal.status }}{% endif %}
                </span>
                <span class="d-block text-muted small">{{ canal.desc }}</span>
            </li>
            {% endfor %}
        </ul>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Escalação</h3>
        <ul class="clinic-ops-list">
            {% for step in reminders.escalacao %}
            <li>{{ step.horas }}h · {{ step.acao }} <span class="text-muted">({{ step.status }})</span></li>
            {% endfor %}
        </ul>
    </section>
</div>

<section class="unio-card mt-3">
    <h3 class="clinic-ops-panel__title px-3 pt-3 mb-0">Confirmação de agenda — amanhã</h3>
    <p class="text-muted small px-3 mb-2">Prepara e-mail, link WhatsApp e webhook <code>agenda_confirmacao</code> (Meta/Twilio depois).</p>
    {% if agenda_amanha is empty %}
    <p class="text-muted px-3 pb-3 mb-0">Nenhum horário marcado/confirmado para amanhã.</p>
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Paciente</th>
                    <th>Título</th>
                    <th>Lembrete</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for a in agenda_amanha %}
                <tr>
                    <td><strong>{{ a.quando }}</strong></td>
                    <td>
                        <strong>{{ a.paciente }}</strong>
                        <span class="d-block text-muted small">{{ a.codigo }}</span>
                    </td>
                    <td>{{ a.titulo }}</td>
                    <td>
                        {% if a.lembrete_em %}
                        <span class="badge-perfil success">Enviado {{ a.lembrete_em }}</span>
                        {% else %}
                        <span class="badge-perfil warning">Pendente</span>
                        {% endif %}
                    </td>
                    <td class="text-right">
                        {% if a.whatsapp_url %}
                        <a href="{{ a.whatsapp_url }}" class="btn-unio-ghost btn-sm" target="_blank" rel="noopener" title="WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                        {% endif %}
                        <a href="{{ path('app_pos_operatorio_agenda_editar', { id: a.id }) }}" class="btn-unio-ghost btn-sm">Abrir</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

<section class="unio-card mt-3">
    <h3 class="clinic-ops-panel__title px-3 pt-3">Pacientes sem resposta hoje</h3>
    {% if reminders.pacientes is empty %}
    <p class="text-muted px-3 pb-3 mb-0">Todos responderam o questionário de hoje.</p>
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Paciente</th>
                    <th>D+</th>
                    <th>Contato</th>
                    <th>Médico</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for p in reminders.pacientes %}
                <tr>
                    <td><strong>{{ p.nome }}</strong> <span class="text-muted small">{{ p.codigo }}</span></td>
                    <td>{{ p.dia_pos|default('—') }}</td>
                    <td class="small">{{ p.telefone|default('—') }}<br>{{ p.email|default('') }}</td>
                    <td>{{ p.medico|default('—') }}</td>
                    <td class="text-right">
                        {% if p.whatsapp_url %}
                        <a href="{{ p.whatsapp_url }}" class="btn-unio-ghost btn-sm" target="_blank" rel="noopener" title="WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                        {% endif %}
                        <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: p.id }) }}" class="btn-unio-ghost btn-sm">Ficha</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
