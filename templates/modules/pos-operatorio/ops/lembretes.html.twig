{% extends 'layout/hub.html.twig' %}

{% block title %}Lembretes · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Lembretes' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = reminders.continuity_lead|default('Questionários pendentes e confirmação de cirurgia/consulta amanhã') %}
{% set hub_search_hidden = true %}
{% set agenda_amanha = reminders.agenda_amanha|default([]) %}

{% block hub_toolbar_actions %}
<form method="post" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('clinic_agenda_reminders') }}">
    <button type="submit" class="btn-unio btn-sm">{% if reminders.whatsapp_live|default(false) %}Enviar confirmações de amanhã{% else %}Preparar confirmações de amanhã{% endif %}</button>
</form>
<a href="{{ path('app_pos_operatorio_agenda') }}" class="btn-unio-ghost btn-sm">Agenda</a>
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: reminders.pendentes_hoje, label: 'Questionários pendentes', icon: 'fa-bell', tone: 'amber', variant: reminders.pendentes_hoje > 0 ? 'warning' : '' },
    { value: agenda_amanha|length, label: 'Agenda amanhã', icon: 'fa-calendar-check', tone: 'sky' },
    { value: reminders.whatsapp_live|default(false) ? 'Live' : 'wa.me', label: 'WhatsApp', icon: 'fa-mobile-screen', tone: reminders.whatsapp_live|default(false) ? 'teal' : 'amber' },
], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<div class="clinic-ops-panels">
    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Canais</h3>
        <ul class="clinic-ops-list">
            {% for canal in reminders.canais %}
            <li>
                <strong>{{ canal.nome }}</strong>
                <span class="badge-perfil {{ canal.status == 'active' ? 'success' : (canal.status == 'prepared' ? 'warning' : 'default') }}">
                    {% if canal.status == 'active' %}Ativo{% elseif canal.status == 'prepared' %}Preparado{% elseif canal.status == 'waiting' %}Aguardando provedor{% elseif canal.status == 'off' %}Desligado{% else %}{{ canal.status }}{% endif %}
                </span>
                <span class="d-block text-muted small">{{ canal.desc }}</span>
            </li>
            {% endfor %}
        </ul>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Escalação</h3>
        <ul class="clinic-ops-list">
            {% for step in reminders.escalacao %}
            <li>{{ step.horas }}h · {{ step.acao }} <span class="text-muted">({{ step.status }})</span></li>
            {% endfor %}
        </ul>
    </section>
</div>

<section class="unio-card mt-3 p-0 ops-queue-animate">
    <h3 class="clinic-ops-panel__title px-3 pt-3 mb-0">Confirmação de cirurgia/consulta — amanhã (D−1)</h3>
    <p class="text-muted small px-3 mb-2">
        Lembrete de presença para o horário de amanhã. Quando o paciente tiver Trilha com marco D−1, o envio/confirmação também atualiza a Trilha Unio.
        {% if reminders.whatsapp_live|default(false) %}
        Envia via <strong>Meta Cloud API</strong>, e-mail e webhook <code>agenda_confirmacao</code>. Link wa.me permanece como atalho manual.
        {% else %}
        Prepara e-mail, link WhatsApp (wa.me) e webhook <code>agenda_confirmacao</code>. Configure <code>WHATSAPP_META_*</code> no servidor para envio automático.
        {% endif %}
    </p>
    {% if agenda_amanha is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-calendar-check',
            title: 'Agenda de amanhã vazia',
            text: 'Nenhum horário marcado/confirmado para amanhã.',
            btn_label: 'Abrir agenda',
            btn_href: path('app_pos_operatorio_agenda'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Paciente</th>
                    <th>Título</th>
                    <th>Lembrete</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for a in agenda_amanha %}
                <tr>
                    <td data-label="Quando"><strong>{{ a.quando }}</strong></td>
                    <td data-label="Paciente">
                        <strong>{{ a.paciente }}</strong>
                        <span class="d-block text-muted small">{{ a.codigo }}</span>
                    </td>
                    <td data-label="Título">{{ a.titulo }}</td>
                    <td data-label="Lembrete">
                        {% if a.lembrete_em %}
                        <span class="badge-perfil success">Enviado {{ a.lembrete_em }}</span>
                        {% else %}
                        <span class="badge-perfil warning">Pendente</span>
                        {% endif %}
                    </td>
                    <td data-label="Ações" class="text-right">
                        {% embed 'components/row_actions_menu.html.twig' with { aria_label: 'Mais ações' } %}
                            {% block items %}
                            <a href="{{ path('app_pos_operatorio_agenda_editar', { id: a.id }) }}" class="dropdown-item">Abrir</a>
                            {% if a.whatsapp_url %}
                            <a href="{{ a.whatsapp_url }}" class="dropdown-item" target="_blank" rel="noopener">WhatsApp</a>
                            {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

{% set marcos_pre = reminders.marcos_pre|default([]) %}
<section class="unio-card mt-3 p-0 ops-queue-animate">
    <h3 class="clinic-ops-panel__title px-3 pt-3 mb-0">Marcos pré-op da Trilha (D−7 / D−3)</h3>
    <p class="text-muted small px-3 mb-2">
        Lembretes do protocolo relativo à data da cirurgia. O botão acima também dispara estes envios.
    </p>
    {% if marcos_pre is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-route',
            title: 'Sem marcos pré-op',
            text: 'Nenhum paciente em D−7 ou D−3 hoje.',
            btn_label: 'Trilha / pacientes',
            btn_href: path('app_pos_operatorio_pacientes'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Dia</th>
                    <th>Paciente</th>
                    <th>Marco</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for m in marcos_pre %}
                <tr>
                    <td data-label="Dia"><strong>{{ m.dia_label }}</strong></td>
                    <td data-label="Paciente">
                        <strong>{{ m.paciente }}</strong>
                        <span class="d-block text-muted small">{{ m.codigo }}</span>
                    </td>
                    <td data-label="Marco">{{ m.item }}</td>
                    <td data-label="Status">
                        {% if m.enviado_hoje %}
                        <span class="badge-perfil success">Enviado hoje</span>
                        {% else %}
                        <span class="badge-perfil warning">Pendente</span>
                        {% endif %}
                    </td>
                    <td data-label="Ações" class="text-right">
                        {% embed 'components/row_actions_menu.html.twig' with { aria_label: 'Mais ações' } %}
                            {% block items %}
                            <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: m.paciente_id }) }}" class="dropdown-item">Ficha</a>
                            {% if m.whatsapp_url %}
                            <a href="{{ m.whatsapp_url }}" class="dropdown-item" target="_blank" rel="noopener">WhatsApp</a>
                            {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

<section class="unio-card mt-3 p-0 ops-queue-animate">
    <h3 class="clinic-ops-panel__title px-3 pt-3 mb-0">Últimos envios WhatsApp</h3>
    <p class="text-muted small px-3 mb-2">Log de entrega Meta / noop (últimos 20).</p>
    {% set outbound = reminders.outbound_recent|default([]) %}
    {% if outbound is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-paper-plane',
            title: 'Nenhum envio',
            text: 'Nenhum envio registrado ainda.',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Evento</th>
                    <th>Destino</th>
                    <th>Status</th>
                    <th>Provedor</th>
                </tr>
            </thead>
            <tbody>
                {% for m in outbound %}
                <tr>
                    <td data-label="Quando">{{ m.quando }}</td>
                    <td data-label="Evento"><code>{{ m.evento }}</code></td>
                    <td data-label="Destino">{{ m.destino|default('—') }}</td>
                    <td data-label="Status">
                        <span class="badge-perfil {{ m.status == 'sent' ? 'success' : (m.status == 'failed' ? 'danger' : 'warning') }}">{{ m.status }}</span>
                        {% if m.erro %}<span class="d-block text-muted small">{{ m.erro }}</span>{% endif %}
                    </td>
                    <td data-label="Provedor">{{ m.provider }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

<section class="unio-card mt-3 p-0 ops-queue-animate">
    <h3 class="clinic-ops-panel__title px-3 pt-3">Pacientes sem resposta hoje</h3>
    {% if reminders.pacientes is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-clipboard-check',
            title: 'Tudo em dia',
            text: 'Todos responderam o questionário de hoje.',
            btn_label: 'Questionários',
            btn_href: path('app_pos_operatorio_questionarios'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Paciente</th>
                    <th>D+</th>
                    <th>Contato</th>
                    <th>Médico</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for p in reminders.pacientes %}
                <tr>
                    <td data-label="Paciente"><strong>{{ p.nome }}</strong> <span class="text-muted small">{{ p.codigo }}</span></td>
                    <td data-label="D+">{{ p.dia_pos|default('—') }}</td>
                    <td data-label="Contato" class="small">{{ p.telefone|default('—') }}<br>{{ p.email|default('') }}</td>
                    <td data-label="Médico">{{ p.medico|default('—') }}</td>
                    <td data-label="Ações" class="text-right">
                        {% embed 'components/row_actions_menu.html.twig' with { aria_label: 'Mais ações de ' ~ p.nome } %}
                            {% block items %}
                            <a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: p.id }) }}" class="dropdown-item">Ficha</a>
                            {% if p.whatsapp_url %}
                            <a href="{{ p.whatsapp_url }}" class="dropdown-item" target="_blank" rel="noopener">WhatsApp</a>
                            {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
