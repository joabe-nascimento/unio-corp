{% extends 'layout/hub.html.twig' %}

{% block title %}LGPD · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'LGPD e compliance' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = compliance.continuity_lead|default('Consentimento, trilha de acesso e retenção') %}
{% set hub_search_hidden = true %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: compliance.sem_consentimento, label: 'Sem consentimento', icon: 'fa-user-shield', tone: 'amber', variant: compliance.sem_consentimento > 0 ? 'warning' : '' },
    { value: compliance.retention.elegiveis|default(0), label: 'Elegíveis retenção', icon: 'fa-database', tone: 'lavender' },
    { value: compliance.auditoria|length, label: 'Eventos recentes', icon: 'fa-clipboard-list', tone: 'sky' },
], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<div class="clinic-ops-panels">
    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Políticas</h3>
        <ul class="clinic-ops-list">
            {% for pol in compliance.politicas %}
            <li>
                <strong>{{ pol.titulo }}</strong>
                <span class="badge-perfil {{ pol.status == 'active' ? 'success' : 'warning' }}">{{ pol.status == 'active' ? 'Ativo' : 'Preparado' }}</span>
                <span class="d-block text-muted small">{{ pol.desc }}</span>
            </li>
            {% endfor %}
        </ul>
        <p class="text-muted small mt-3 mb-2">Retenção configurada: {{ compliance.retencao_dias|default(365) }} dias · job <code>app:pos-operatorio:retention</code></p>
        <a href="{{ path('app_pos_operatorio_relatorios_export_auditoria') }}" class="btn-unio-ghost btn-sm">Exportar trilha LGPD (CSV)</a>
        <a href="{{ path('app_pos_operatorio_relatorios_export_attestacoes') }}" class="btn-unio-ghost btn-sm ml-2">Exportar atestações Trilha (CSV)</a>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Auditoria recente</h3>
        {% if compliance.auditoria is empty %}
        <p class="text-muted small mb-0">Nenhum evento de compliance registrado.</p>
        {% else %}
        <ul class="clinic-ops-list clinic-ops-list--audit">
            {% for ev in compliance.auditoria %}
            <li>
                <strong>{{ ev.label }}</strong> · {{ ev.paciente }}
                <span class="d-block text-muted small">{{ ev.detalhe }} · {{ ev.em }}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
</div>

<section class="unio-card clinic-ops-panel p-3 mt-3">
    <h3 class="clinic-ops-panel__title">Atestações da Trilha (evidência)</h3>
    {% set att = compliance.attestacoes_recentes|default([]) %}
    {% if att is empty %}
    <p class="text-muted small mb-0">Nenhuma atestação registrada ainda.</p>
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Paciente</th>
                    <th>Marco</th>
                    <th>Autor</th>
                    <th>Evidência</th>
                    <th>Hash</th>
                </tr>
            </thead>
            <tbody>
                {% for a in att %}
                <tr>
                    <td>{{ a.em }}</td>
                    <td>{{ a.paciente }}</td>
                    <td><code>{{ a.marco }}</code></td>
                    <td>{{ a.autor }}</td>
                    <td>{{ a.evidencia }}</td>
                    <td class="admin-table-mono small">{{ a.hash }}…</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
