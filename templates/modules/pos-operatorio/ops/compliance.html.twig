{% extends 'layout/hub.html.twig' %}

{% block title %}LGPD · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'LGPD e compliance' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = 'Consentimento, trilha de acesso e políticas de retenção' %}
{% set hub_search_hidden = true %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: compliance.sem_consentimento, label: 'Sem consentimento', icon: 'fa-user-shield', tone: 'amber', variant: compliance.sem_consentimento > 0 ? 'warning' : '' },
    { value: compliance.auditoria|length, label: 'Eventos recentes', icon: 'fa-clipboard-list', tone: 'lavender' },
], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<div class="clinic-ops-panels">
    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Políticas</h3>
        <ul class="clinic-ops-list">
            {% for pol in compliance.politicas %}
            <li>
                <strong>{{ pol.titulo }}</strong>
                <span class="badge-perfil success">{{ pol.status }}</span>
                <span class="d-block text-muted small">{{ pol.desc }}</span>
            </li>
            {% endfor %}
        </ul>
        <a href="{{ path('app_pos_operatorio_relatorios_export_auditoria') }}" class="btn-unio-ghost btn-sm mt-3">Exportar trilha</a>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Auditoria recente</h3>
        {% if compliance.auditoria is empty %}
        <p class="text-muted small mb-0">Nenhum evento de compliance registrado.</p>
        {% else %}
        <ul class="clinic-ops-list clinic-ops-list--audit">
            {% for ev in compliance.auditoria %}
            <li>
                <strong>{{ ev.label }}</strong> · {{ ev.paciente }}
                <span class="d-block text-muted small">{{ ev.detalhe }} · {{ ev.em }}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
