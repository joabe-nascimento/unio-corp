{% extends 'layout/hub.html.twig' %}

{% block title %}O que fazer agora · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'O que fazer agora' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = continuity_lead|default('Fila unificada · ninguém fica sem resposta') %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
{% embed 'components/hub_toolbar_more_menu.html.twig' %}
    {% block items %}
    <a href="{{ path('app_pos_operatorio_alertas') }}" class="dropdown-item">
        <i class="fas fa-triangle-exclamation mr-1" aria-hidden="true"></i> Alertas
    </a>
    <a href="{{ path('app_pos_operatorio_sala_critica') }}" class="dropdown-item">
        <i class="fas fa-bed-pulse mr-1" aria-hidden="true"></i> Sala crítica
    </a>
    {% endblock %}
{% endembed %}
{% endblock %}

{% set _tc = type_counts|default({}) %}
{% set _ft = filter_tipo|default('') %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with { use_form: false } %}
    {% block filter_chips %}
        {% include 'components/hub_filter_metrics.html.twig' with {
            metrics: [
                { value: queue.stats.p1, label: 'P1', tone: 'rose' },
                { value: queue.stats.questionarios, label: 'Quest. pendentes', tone: 'amber' },
                { value: queue.stats.total, label: 'Na fila', tone: 'sky' },
            ]
        } %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar fila do dia',
            chips: [
                { href: path('app_pos_operatorio_trabalho'), label: 'Todos', active: _ft == '' or _ft == 'todos', count: _tc.todos|default(null) },
                { href: path('app_pos_operatorio_trabalho', { tipo: 'alerta' }), label: 'Alertas', active: _ft == 'alerta', count: _tc.alerta|default(null) },
                { href: path('app_pos_operatorio_trabalho', { tipo: 'questionario' }), label: 'Questionários', active: _ft == 'questionario', count: _tc.questionario|default(null) },
                { href: path('app_pos_operatorio_trabalho', { tipo: 'retorno' }), label: 'Retornos', active: _ft == 'retorno', count: _tc.retorno|default(null) },
            ]
        } %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
{% if queue.stats.p1|default(0) > 0 %}
<div class="clinic-banner clinic-banner--danger">
    <i class="fas fa-fire" aria-hidden="true"></i>
    <div><strong>{{ queue.stats.p1 }}</strong> incidente(s) P1 na fila — priorize a Sala Crítica.</div>
</div>
{% endif %}

<section class="unio-card p-0 ops-queue-animate">
    {% if queue.items is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-list-check',
            title: 'Fila limpa',
            text: 'Nenhuma ação neste filtro.',
            btn_label: _ft ? 'Ver todos' : 'Visão geral',
            btn_href: _ft ? path('app_pos_operatorio_trabalho') : path('app_pos_operatorio'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Paciente</th>
                    <th>Detalhe</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in queue.items %}
                <tr>
                    <td data-label="Tipo">
                        <span class="badge-perfil {{ item.tone == 'danger' ? 'danger' : (item.tone == 'warning' ? 'warning' : 'default') }}">{{ item.type_label }}</span>
                    </td>
                    <td data-label="Paciente">
                        <strong>{{ item.title }}</strong>
                        <span class="d-block text-muted small">{{ item.meta }}</span>
                    </td>
                    <td data-label="Detalhe">{{ item.subtitle }}</td>
                    <td data-label="Ações" class="text-right">
                        <a href="{{ path(item.route, item.route_params|default({})) }}" class="btn-unio btn-sm">{{ item.action_label }}</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
