{% extends 'layout/hub.html.twig' %}

{% block title %}Qualidade · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Qualidade clínica' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = quality.continuity_lead|default('Resposta, SLA, check-in pré e handoff D0') %}
{% set hub_search_hidden = true %}
{% set pre = quality.pre_op|default({}) %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: quality.taxa_resposta ~ '%', label: 'Taxa resposta hoje', icon: 'fa-percent', tone: 'sage' },
    { value: (pre.checkin_taxa|default(0)) ~ '%', label: 'Check-in pré (7d)', icon: 'fa-clipboard-check', tone: 'sky' },
    { value: (pre.noshow_d1_taxa|default(0)) ~ '%', label: 'No-show pós D−1', icon: 'fa-user-xmark', tone: 'amber' },
    { value: (pre.conversao_taxa|default(0)) ~ '%', label: 'Prep → cirurgia', icon: 'fa-arrow-right', tone: 'lavender' },
], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
<div class="clinic-ops-panels clinic-ops-panels--3">
    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Questionários hoje</h3>
        <dl class="clinic-ops-stats">
            <div><dt>Respondidos</dt><dd>{{ quality.respondidos_hoje }}</dd></div>
            <div><dt>Pendentes</dt><dd>{{ quality.pendentes_hoje }}</dd></div>
            <div><dt>Alertas abertos</dt><dd>{{ quality.alertas_abertos }}</dd></div>
        </dl>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Pré-op</h3>
        <dl class="clinic-ops-stats">
            <div><dt>Pré esta semana</dt><dd>{{ pre.pre_semana|default(0) }}</dd></div>
            <div><dt>Check-in ok</dt><dd>{{ pre.checkin_ok|default(0) }}</dd></div>
            <div><dt>No-show (base D−1)</dt><dd>{{ pre.noshow_d1|default(0) }}/{{ pre.noshow_base|default(0) }}</dd></div>
            <div><dt>Conversão 30d</dt><dd>{{ pre.conversao_ok|default(0) }}/{{ pre.conversao_base|default(0) }}</dd></div>
        </dl>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Pacientes por fase</h3>
        {% if quality.heatmap is empty %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-chart-simple',
                title: 'Sem dados',
                text: 'Sem dados de acompanhamento.',
                btn_sm: true,
                compact: true
            } %}
        {% else %}
        <ul class="clinic-ops-list">
            {% for bucket, count in quality.heatmap %}
            <li><strong>{{ bucket }}</strong>: {{ count }} paciente(s)</li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
