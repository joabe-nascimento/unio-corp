{% extends 'layout/hub.html.twig' %}

{% block title %}Plantão · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Plantão e SLA' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = plantao.continuity_lead|default(plantao.roteamento) %}
{% set hub_search_hidden = true %}

{% block hub_content %}
<p class="text-muted small mb-3">{{ plantao.roteamento }}</p>

<div class="clinic-ops-panels clinic-ops-panels--3 mb-3">
    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">SLA por prioridade</h3>
        <dl class="clinic-ops-stats">
            <div><dt>P1</dt><dd>{{ plantao.sla_p1_min }} min</dd></div>
            <div><dt>P2</dt><dd>{{ plantao.sla_p2_min }} min</dd></div>
            <div><dt>P3</dt><dd>{{ plantao.sla_p3_min }} min</dd></div>
            <div><dt>P4</dt><dd>{{ plantao.sla_p4_min }} min</dd></div>
        </dl>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Roteamento</h3>
        <p class="text-muted small mb-0">{{ plantao.roteamento }}</p>
        <a href="{{ path('app_pos_operatorio_config') }}" class="btn-unio-ghost btn-sm mt-3">Ajustar SLA</a>
    </section>

    <section class="unio-card clinic-ops-panel p-3">
        <h3 class="clinic-ops-panel__title">Ações rápidas</h3>
        <div class="d-flex flex-column gap-2">
            <a href="{{ path('app_pos_operatorio_sala_critica') }}" class="btn-unio-ghost btn-sm">Sala crítica P1</a>
            <a href="{{ path('app_pos_operatorio_alertas') }}" class="btn-unio-ghost btn-sm">Fila de alertas</a>
        </div>
    </section>
</div>

<section class="unio-card mb-3">
    <h3 class="clinic-ops-panel__title px-3 pt-3">Quem está de plantão</h3>
    <form method="post" action="{{ path('app_pos_operatorio_plantao_salvar') }}" class="px-3 pb-3">
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_plantao') }}">
        {% if plantao.candidates is empty %}
        <p class="text-muted mb-0">Nenhum usuário ativo na clínica para escala.</p>
        {% else %}
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Plantão</th>
                        <th>Profissional</th>
                        <th>E-mail</th>
                        <th>Pacientes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in plantao.plantonistas %}
                    <tr>
                        <td>
                            <input type="checkbox" name="plantao_user_ids[]" value="{{ m.id }}" {{ m.on_call|default(m.definido) ? 'checked' : '' }}>
                        </td>
                        <td><strong>{{ m.nome }}</strong></td>
                        <td>{{ m.email|default('—') }}</td>
                        <td>{{ m.pacientes }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn-unio btn-sm mt-2">Salvar escala</button>
        {% if not plantao.has_roster %}
        <p class="text-muted small mt-2 mb-0">Sem plantonista marcado, P1 segue para o médico responsável do paciente.</p>
        {% endif %}
        {% endif %}
    </form>
</section>
{% endblock %}
