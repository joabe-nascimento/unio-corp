{% extends 'layout/hub.html.twig' %}

{% block title %}Integrações · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Integrações' %}
{% set hub_page_eyebrow = org_brand_label %}
{% set hub_page_subtitle = 'WhatsApp, alta cirúrgica, PEP e webhooks' %}
{% set hub_search_hidden = true %}

{% block hub_content %}
<div class="clinic-ops-grid mb-4">
    {% for int in integrations %}
    <article class="unio-card clinic-ops-card clinic-ops-card--stacked p-3">
        <div class="clinic-ops-card__body">
            <strong class="clinic-ops-card__title">{{ int.nome }}</strong>
            <p class="clinic-ops-card__desc">{{ int.desc }}</p>
            <span class="badge-perfil {{ int.status == 'active' ? 'success' : 'default' }}">{{ int.status }}</span>
        </div>
        {% if int.route %}
        <a href="{{ path(int.route) }}" class="btn-unio-ghost btn-sm clinic-ops-card__footer">{{ int.route_label|default('Abrir') }}</a>
        {% endif %}
    </article>
    {% endfor %}
</div>

<section class="unio-card p-4 mb-3">
    <h3 class="clinic-ops-panel__title">Alta cirúrgica (inbound)</h3>
    <p class="text-muted small mb-2">POST JSON autenticado por token — cria ou atualiza paciente e associa protocolo.</p>
    <p class="small mb-1"><strong>Endpoint</strong></p>
    <code class="d-block mb-2">{{ alta_endpoint }}</code>
    <p class="small mb-1"><strong>Header</strong></p>
    <code class="d-block mb-2">X-Unio-Alta-Token: {{ alta_token }}</code>
    <p class="small mb-1"><strong>Payload exemplo</strong></p>
    <pre class="small mb-0">{
  "nome": "Maria Silva",
  "telefone": "11999990000",
  "email": "maria@email.com",
  "data_cirurgia": "2026-07-12",
  "protocolo_slug": "apendicectomia-lap",
  "procedimento": "Apendicectomia",
  "medico_email": "medico@clinica.com"
}</pre>
</section>

<section class="unio-card p-4 mb-3">
    <h3 class="clinic-ops-panel__title">WhatsApp Meta Cloud API</h3>
    <p class="text-muted small mb-2">
        Envio automático de confirmação D-1 e questionário pós-op.
        Credenciais ficam no servidor (<code>.env.local</code>), não neste formulário.
    </p>
    <p class="mb-2">
        <strong>Status:</strong>
        {% if whatsapp_live|default(false) %}
        <span class="badge-perfil success">Live ({{ whatsapp_provider|default('meta') }})</span>
        {% else %}
        <span class="badge-perfil warning">Preparado (wa.me)</span>
        {% endif %}
    </p>
    <p class="small mb-1"><strong>Webhook inbound (confirmação CONFIRMO)</strong></p>
    <code class="d-block mb-2">{{ whatsapp_meta_webhook_url|default('') }}</code>
    <pre class="small mb-3">WHATSAPP_PROVIDER=meta
WHATSAPP_META_TOKEN=...
WHATSAPP_META_PHONE_NUMBER_ID=...
WHATSAPP_META_EMPRESA_CNPJ=...
WHATSAPP_META_VERIFY_TOKEN=...
WHATSAPP_META_APP_SECRET=...
WHATSAPP_META_GRAPH_VERSION=v21.0</pre>
    <p class="text-muted small mb-3">O lembrete D−1 inclui link assinado de confirmação (funciona também com wa.me).</p>
    {% if whatsapp_live|default(false) %}
    <form method="post" action="{{ path('app_pos_operatorio_integracoes_whatsapp_teste') }}" class="d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_whatsapp_teste') }}">
        <div class="form-group mb-0 flex-grow-1">
            <label for="whatsapp_teste_tel">Telefone de teste (com DDD)</label>
            <input id="whatsapp_teste_tel" name="telefone" type="tel" class="form-control" placeholder="11999990000" required>
        </div>
        <button type="submit" class="btn-unio">Enviar teste</button>
    </form>
    {% else %}
    <p class="text-muted small mb-0">Com as variáveis acima no servidor Unio Saúde, o canal passa a <strong>Ativo</strong> em Lembretes.</p>
    {% endif %}
</section>

<section class="unio-card p-4 mb-3">
    <h3 class="clinic-ops-panel__title">Asaas · Pix e link de pagamento</h3>
    <p class="text-muted small mb-2">
        Gera cobrança nas Contas particulares abertas. Webhook marca a conta como paga.
    </p>
    <p class="mb-2">
        <strong>Status:</strong>
        {% if asaas_ready|default(false) %}
        <span class="badge-perfil success">Pronto</span>
        {% else %}
        <span class="badge-perfil warning">Não configurado</span>
        {% endif %}
    </p>
    <p class="small mb-1"><strong>Webhook Asaas</strong></p>
    <code class="d-block mb-2">{{ asaas_webhook_url|default('') }}</code>
    <p class="text-muted small">No painel Asaas, envie o segredo pelo header <code>asaas-access-token</code>. API key e token ficam somente no <code>.env.local</code> do servidor.</p>
    <form method="post" action="{{ path('app_pos_operatorio_integracoes_asaas') }}" class="mt-3">
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_asaas') }}">
        <div class="form-group">
            <label for="asaas_env">Ambiente</label>
            <select id="asaas_env" name="asaas_env" class="form-control">
                <option value="sandbox"{{ (integration_config.asaas_env|default('sandbox')) == 'sandbox' ? ' selected' : '' }}>Sandbox</option>
                <option value="production"{{ (integration_config.asaas_env|default('sandbox')) == 'production' ? ' selected' : '' }}>Produção</option>
            </select>
        </div>
        <label class="d-flex align-items-center gap-2 mb-3">
            <input type="checkbox" name="asaas_enabled" value="1"{{ integration_config.asaas_enabled|default(false) ? ' checked' : '' }}>
            <span>Ativar cobranças Asaas nesta clínica</span>
        </label>
        <pre class="small mb-3">ASAAS_API_KEY=$aact_...
ASAAS_WEBHOOK_TOKEN=segredo-forte</pre>
        <button type="submit" class="btn-unio">Salvar Asaas</button>
    </form>
</section>

<section class="unio-card p-4">
    <h3 class="clinic-ops-panel__title">Webhook de alertas</h3>
    <p class="text-muted small">Notificações P1, escalação, questionários e <code>agenda_confirmacao</code> para sistemas externos.</p>
    <form method="post" action="{{ path('app_pos_operatorio_integracoes_webhook') }}" class="mt-3">
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_webhook') }}">
        <div class="form-group">
            <label for="webhook_url">URL do webhook</label>
            <input id="webhook_url" name="webhook_url" type="url" class="form-control"
                   value="{{ integration_config.webhook_url|default('') }}"
                   placeholder="https://...">
        </div>
        <label class="d-flex align-items-center gap-2 mb-3">
            <input type="checkbox" name="lembretes_sms" value="1"{{ integration_config.lembretes_sms|default(false) ? ' checked' : '' }}>
            <span>Habilitar lembretes SMS (via webhook)</span>
        </label>
        <button type="submit" class="btn-unio">Salvar integração</button>
    </form>
</section>
{% endblock %}
