{% extends 'layout/hub.html.twig' %}

{% block title %}Atendimentos · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Atendimentos' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Consultas leves ligadas à agenda' %}
{% set hub_search_hidden = true %}
{% set status_tones = {
    em_andamento: 'amber',
    finalizado: 'success',
    cancelado: 'default'
} %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_agenda') }}" class="btn-unio btn-sm">Abrir agenda</a>
{% endblock %}

{% set _ac = atendimento_counts|default({}) %}
{% set _fq = filter_q|default('') %}
{% set _fs = filter_status|default('') %}

{% block hub_section_toolbar %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_pos_operatorio_atendimento'),
    show_search: true,
    use_form: true,
    search_placeholder: 'Buscar paciente, código ou médico…',
    search_name: 'q',
    search_value: _fq,
    hidden_fields: _fs != '' ? { status: _fs } : {}
} %}
    {% block filter_chips %}
        {% include 'components/hub_filter_chips.html.twig' with {
            aria_label: 'Filtrar atendimentos por status',
            chips: [
                { href: path('app_pos_operatorio_atendimento', _fq ? { q: _fq } : {}), label: 'Todos', active: _fs == '', count: _ac.total|default(null) },
            ]|merge(
                status_labels|keys|map(sid => {
                    href: path('app_pos_operatorio_atendimento', { status: sid }|merge(_fq ? { q: _fq } : {})),
                    label: status_labels[sid],
                    active: _fs == sid,
                    count: _ac[sid]|default(null)
                })
            )
        } %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
<section class="unio-card p-0 ops-queue-animate">
    {% if atendimentos is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-stethoscope',
            title: 'Nenhum atendimento',
            text: 'Nenhum atendimento ainda. Na agenda, use Atender quando o paciente chegar.',
            btn_label: 'Abrir agenda',
            btn_href: path('app_pos_operatorio_agenda'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="table admin-table mb-0 align-middle clinic-stack-mobile">
            <thead>
                <tr>
                    <th>Início</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for a in atendimentos %}
                <tr>
                    <td data-label="Início">{{ a.iniciadoEm|date('d/m/Y H:i') }}</td>
                    <td data-label="Paciente">
                        <strong>{{ a.paciente.nome }}</strong>
                        <div class="small text-muted">{{ a.paciente.codigo }}</div>
                    </td>
                    <td data-label="Médico">{{ a.medico ? a.medico.nome : '—' }}</td>
                    <td data-label="Status">
                        <span class="badge-perfil {{ status_tones[a.status]|default('default') }}">{{ status_labels[a.status]|default(a.status) }}</span>
                    </td>
                    <td data-label="Ações" class="text-right">
                        <a href="{{ path('app_pos_operatorio_atendimento_show', { id: a.id }) }}" class="btn-unio-ghost btn-sm">
                            {{ a.status == 'em_andamento' ? 'Continuar' : 'Ver' }}
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
