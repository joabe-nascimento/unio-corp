{% extends 'layout/hub.html.twig' %}

{% block title %}Atendimento · {{ atendimento.paciente.nome }} · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = atendimento.paciente.nome %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Atendimento · ' ~ (agendamento.titulo|default('Consulta')) ~ ' · ' ~ agendamento.inicio|date('d/m/Y H:i') %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_agenda', { vista: 'dia', dia: agendamento.inicio|date('Y-m-d') }) }}" class="btn-unio-ghost btn-sm">Voltar à agenda</a>
<a href="{{ path('app_pos_operatorio_pacientes', { open_ficha: atendimento.paciente.id }) }}" class="btn-unio-ghost btn-sm">Ficha do paciente</a>
{% endblock %}

{% block hub_content %}
<div class="row">
    <div class="col-lg-4 mb-3">
        <section class="unio-card p-3">
            <p class="small text-muted mb-1">Status</p>
            <p class="mb-3"><strong>{{ status_labels[atendimento.status]|default(atendimento.status) }}</strong></p>
            <p class="small text-muted mb-1">Paciente</p>
            <p class="mb-2"><strong>{{ atendimento.paciente.nome }}</strong><br><span class="text-muted">{{ atendimento.paciente.codigo }}</span></p>
            <p class="small text-muted mb-1">Médico</p>
            <p class="mb-2">{{ atendimento.medico ? atendimento.medico.nome : '—' }}</p>
            <p class="small text-muted mb-1">Horário</p>
            <p class="mb-0">{{ agendamento.inicio|date('d/m/Y H:i') }} – {{ agendamento.fim|date('H:i') }}</p>
        </section>
    </div>
    <div class="col-lg-8 mb-3">
        <section class="unio-card p-3">
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('clinic_atendimento_' ~ atendimento.id) }}">
                {% if atendimento.status == 'em_andamento' and soap_templates|default([]) is not empty %}
                <div class="mb-3">
                    <label class="small text-muted d-block" for="soap_template_id">Modelo SOAP</label>
                    <select id="soap_template_id" class="form-control" data-soap-template-select>
                        <option value="">— Aplicar modelo —</option>
                        {% for t in soap_templates %}
                        <option value="{{ t.id }}"
                                data-queixa="{{ t.queixa|default('')|e('html_attr') }}"
                                data-exame="{{ t.exame|default('')|e('html_attr') }}"
                                data-hipotese="{{ t.hipotese|default('')|e('html_attr') }}"
                                data-conduta="{{ t.conduta|default('')|e('html_attr') }}"
                                data-cid10="{{ t.cid10Sugerido|default('')|e('html_attr') }}">
                            {{ t.nome }}{% if t.procedimentoTipo %} · {{ t.procedimentoTipo }}{% endif %}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="mb-3">
                    <label class="small text-muted d-block" for="queixa">Queixa / motivo</label>
                    <textarea id="queixa" name="queixa" class="form-control" rows="3" {{ atendimento.status != 'em_andamento' ? 'readonly' : '' }}>{{ atendimento.queixa }}</textarea>
                </div>
                <div class="mb-3">
                    <label class="small text-muted d-block" for="exame">Exame / achados</label>
                    <textarea id="exame" name="exame" class="form-control" rows="3" {{ atendimento.status != 'em_andamento' ? 'readonly' : '' }}>{{ atendimento.exame }}</textarea>
                </div>
                <div class="mb-3">
                    <label class="small text-muted d-block" for="conduta">Conduta</label>
                    <textarea id="conduta" name="conduta" class="form-control" rows="3" {{ atendimento.status != 'em_andamento' ? 'readonly' : '' }}>{{ atendimento.conduta }}</textarea>
                </div>
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="small text-muted d-block" for="hipotese">Hipótese diagnóstica</label>
                        <input id="hipotese" type="text" name="hipotese" class="form-control" maxlength="500"
                               value="{{ atendimento.hipotese }}"
                               {{ atendimento.status != 'em_andamento' ? 'readonly' : '' }}
                               placeholder="Ex.: pós-op D+14 sem sinais de infecção">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="small text-muted d-block" for="cid10">CID-10</label>
                        <input id="cid10" type="text" name="cid10" class="form-control" maxlength="16"
                               value="{{ atendimento.cid10 }}"
                               {{ atendimento.status != 'em_andamento' ? 'readonly' : '' }}
                               placeholder="Ex.: Z48.0"
                               data-cid-search="{{ cid10_search_url|default(path('app_pos_operatorio_cid10_search')) }}"
                               list="cid10-suggestions"
                               autocomplete="off">
                        <datalist id="cid10-suggestions"></datalist>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="small text-muted d-block" for="observacao">Observação</label>
                    <textarea id="observacao" name="observacao" class="form-control" rows="2" {{ atendimento.status != 'em_andamento' ? 'readonly' : '' }}>{{ atendimento.observacao }}</textarea>
                </div>
                {% if atendimento.status == 'em_andamento' %}
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" name="action" value="salvar" class="btn-unio-ghost">Salvar rascunho</button>
                    <button type="submit" name="action" value="finalizar" class="btn-unio">Finalizar atendimento</button>
                </div>
                {% else %}
                <p class="text-muted small mb-0">Finalizado em {{ atendimento.finalizadoEm ? atendimento.finalizadoEm|date('d/m/Y H:i') : '—' }}.</p>
                <a href="{{ path('app_pos_operatorio_contas', { status: 'aberto' }) }}" class="btn-unio-ghost btn-sm mt-2">Ver contas</a>
                {% endif %}
            </form>
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
  var templateSelect = document.querySelector('[data-soap-template-select]');
  if (templateSelect) {
    templateSelect.addEventListener('change', function () {
      var opt = templateSelect.options[templateSelect.selectedIndex];
      if (!opt || !opt.value) return;
      var set = function (id, attr) {
        var el = document.getElementById(id);
        if (el && opt.getAttribute(attr)) el.value = opt.getAttribute(attr);
      };
      set('queixa', 'data-queixa');
      set('exame', 'data-exame');
      set('hipotese', 'data-hipotese');
      set('conduta', 'data-conduta');
      set('cid10', 'data-cid10');
    });
  }

  var cidInput = document.querySelector('[data-cid-search]');
  var list = document.getElementById('cid10-suggestions');
  if (!cidInput || !list) return;
  var timer = null;
  cidInput.addEventListener('input', function () {
    var q = cidInput.value.trim();
    clearTimeout(timer);
    if (q.length < 2) {
      list.innerHTML = '';
      return;
    }
    timer = setTimeout(function () {
      fetch(cidInput.getAttribute('data-cid-search') + '?q=' + encodeURIComponent(q) + '&limit=15', {
        headers: { 'Accept': 'application/json' }
      }).then(function (r) { return r.json(); }).then(function (data) {
        list.innerHTML = '';
        (data.items || []).forEach(function (item) {
          var option = document.createElement('option');
          option.value = item.codigo || item.code || '';
          option.label = (item.codigo || item.code || '') + ' — ' + (item.descricao || item.label || '');
          list.appendChild(option);
        });
      }).catch(function () {});
    }, 250);
  });
})();
</script>
{% endblock %}
