{% extends 'layout/hub.html.twig' %}

{% block title %}Anti-glosa TISS · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Painel anti-glosa' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Guias glosadas, taxa por convênio e reabertura para correção' %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_guias', { status: 'glosado' }) }}" class="btn-unio-ghost btn-sm">Só glosadas</a>
<a href="{{ path('app_pos_operatorio_guias') }}" class="btn-unio-ghost btn-sm">Todas as guias</a>
{% endblock %}

{% block hub_kpis %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: panel.total_glosadas, label: 'Guias glosadas', icon: 'fa-triangle-exclamation', tone: 'amber', variant: panel.total_glosadas > 0 ? 'warning' : '' },
    { value: panel.taxa_geral ~ '%', label: 'Taxa geral de glosa', icon: 'fa-percent', tone: 'rose' },
    { value: panel.stats|length, label: 'Convênios no funil', icon: 'fa-building', tone: 'sky' },
], mb: 'mb-0' } %}
{% endblock %}

{% block hub_content %}
{% if panel.total_glosadas|default(0) > 0 %}
<div class="clinic-banner clinic-banner--warn">
    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
    <div><strong>{{ panel.total_glosadas }}</strong> guia(s) glosada(s) — reabra, corrija e reenvie.</div>
</div>
{% endif %}

<section class="unio-card p-0 mb-3 ops-queue-animate">
    <h3 class="h6 px-3 pt-3 mb-3">Taxa de glosa por convênio</h3>
    {% if panel.stats is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-chart-pie',
            title: 'Sem dados de glosa',
            text: 'Ainda não há guias enviadas/autorizadas/pagas/glosadas para calcular taxa.',
            btn_label: 'Ver guias',
            btn_href: path('app_pos_operatorio_guias'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Convênio</th>
                    <th>No funil</th>
                    <th>Glosadas</th>
                    <th>Pagas</th>
                    <th>Taxa</th>
                </tr>
            </thead>
            <tbody>
                {% for row in panel.stats %}
                <tr>
                    <td data-label="Convênio">{{ row.convenio }}</td>
                    <td data-label="No funil">{{ row.total }}</td>
                    <td data-label="Glosadas">{{ row.glosadas }}</td>
                    <td data-label="Pagas">{{ row.pagas }}</td>
                    <td data-label="Taxa"><strong>{{ row.taxa_glosa }}%</strong></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

<section class="unio-card p-0 ops-queue-animate">
    <h3 class="h6 px-3 pt-3 mb-0">Guias glosadas</h3>
    <p class="text-muted small px-3 mb-2">Reabra para corrigir itens/cabeçalho e reenviar.</p>
    {% if panel.glosadas is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-circle-check',
            title: 'Nenhuma guia glosada',
            text: 'Nenhuma guia glosada no momento.',
            btn_label: 'Ver guias',
            btn_href: path('app_pos_operatorio_guias'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table clinic-stack-mobile mb-0">
            <thead>
                <tr>
                    <th>Nº</th>
                    <th>Paciente</th>
                    <th>Convênio</th>
                    <th>Motivo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for g in panel.glosadas %}
                <tr>
                    <td data-label="Nº"><code>{{ g.numeroGuia }}</code></td>
                    <td data-label="Paciente">{{ g.paciente.nome }}</td>
                    <td data-label="Convênio">{{ g.convenio.nome }}</td>
                    <td data-label="Motivo" class="small">{{ g.motivoGlosa|default('—') }}</td>
                    <td data-label="Ações" class="text-right">
                        <a href="{{ path('app_pos_operatorio_guias_show', { id: g.id }) }}" class="btn-unio-ghost btn-sm">Abrir</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
