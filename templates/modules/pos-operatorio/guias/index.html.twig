{% extends 'layout/hub.html.twig' %}

{% block title %}Guias TISS · {{ org_brand_label|default('Unio Saúde') }}{% endblock %}

{% set hub_page_title = 'Guias TISS' %}
{% set hub_page_eyebrow = org_brand_label|default('Unio Saúde') %}
{% set hub_page_subtitle = 'Convênio: rascunho → enviado → autorizado → pago (glosa reabre)' %}
{% set hub_search_hidden = true %}

{% block hub_toolbar_actions %}
<a href="{{ path('app_pos_operatorio_guias_glosas') }}" class="btn-unio btn-sm">
    <i class="fas fa-shield-halved mr-1" aria-hidden="true"></i> Anti-glosa
</a>
{% embed 'components/hub_toolbar_more_menu.html.twig' %}
    {% block items %}
    <a href="{{ path('app_pos_operatorio_lotes') }}" class="dropdown-item">
        <i class="fas fa-boxes-stacked mr-1" aria-hidden="true"></i> Lotes
    </a>
    <a href="{{ path('app_pos_operatorio_convenios') }}" class="dropdown-item">
        <i class="fas fa-building mr-1" aria-hidden="true"></i> Convênios
    </a>
    <a href="{{ path('app_pos_operatorio_contas') }}" class="dropdown-item">
        <i class="fas fa-file-invoice mr-1" aria-hidden="true"></i> Contas
    </a>
    {% endblock %}
{% endembed %}
{% endblock %}

{% set status_tones = {
    rascunho: 'default',
    enviado: 'sky',
    autorizado: 'success',
    pago: 'success',
    glosado: 'danger',
    cancelado: 'default'
} %}

{% block hub_section_toolbar %}
{% set _gc = status_counts|default({}) %}
{% embed 'components/hub_page_filter_bar.html.twig' with {
    form_action: path('app_pos_operatorio_guias'),
    use_form: false
} %}
    {% block filter_chips %}
        <div class="clinic-filter-chips hub-page-filter-chips" role="navigation" aria-label="Filtrar guias por status">
            <a href="{{ path('app_pos_operatorio_guias', { status: 'todos' }) }}" class="{{ filtro_status == 'todos' ? 'is-active' : '' }}">Todas{% if _gc.todos is defined %} ({{ _gc.todos }}){% endif %}</a>
            {% for key, label in status_labels %}
            <a href="{{ path('app_pos_operatorio_guias', { status: key }) }}" class="{{ filtro_status == key ? 'is-active' : '' }}">{{ label }}{% if _gc[key] is defined %} ({{ _gc[key] }}){% endif %}</a>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block hub_content %}
{% if list_truncated|default(false) %}
<div class="clinic-banner clinic-banner--warn">
    <i class="fas fa-circle-info" aria-hidden="true"></i>
    <div>Exibindo as {{ list_limit }} guias mais recentes de {{ list_total }}. Refine o filtro de status para ver o restante.</div>
</div>
{% endif %}

<section class="unio-card p-0">
    {% if guias is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-file-medical',
            title: 'Nenhuma guia',
            text: 'Nenhuma guia neste filtro. Em Contas abertas, use Gerar guia.',
            btn_label: 'Ver contas',
            btn_href: path('app_pos_operatorio_contas'),
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="table admin-table mb-0 align-middle clinic-stack-mobile">
            <thead>
                <tr>
                    <th>Criada</th>
                    <th>Nº guia</th>
                    <th>Paciente</th>
                    <th>Convênio</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for g in guias %}
                <tr>
                    <td data-label="Criada">{{ g.criadoEm|date('d/m/Y H:i') }}</td>
                    <td data-label="Nº guia">{{ g.numeroGuia }}</td>
                    <td data-label="Paciente">
                        <strong>{{ g.paciente.nome }}</strong>
                        <div class="small text-muted">{{ g.paciente.codigo }}</div>
                    </td>
                    <td data-label="Convênio">{{ g.convenio.nome }}</td>
                    <td data-label="Status">
                        <span class="badge-perfil {{ status_tones[g.status]|default('default') }}">{{ status_labels[g.status]|default(g.status) }}</span>
                    </td>
                    <td data-label="Total">
                        {% set total = g.totalCentavos() %}
                        {% if total > 0 %}
                            R$ {{ (total / 100)|number_format(2, ',', '.') }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td data-label="Ações" class="text-right">
                        {% embed 'components/row_actions_menu.html.twig' with { aria_label: 'Mais ações da guia ' ~ g.numeroGuia } %}
                            {% block items %}
                            <a href="{{ path('app_pos_operatorio_guias_show', { id: g.id }) }}" class="dropdown-item">Abrir</a>
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}
