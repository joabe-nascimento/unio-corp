<div class="pos-op-ficha">
    <div class="row pos-op-ficha-grid pos-op-ficha-grid--offcanvas">
        <div class="col-xl-8 pos-op-ficha-main">
            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Dados clínicos',
                    subtitle: 'Identificação e equipe responsável'
                } %}
                <dl class="pos-op-detail-grid">
                    <div class="pos-op-detail-grid__row">
                        <dt>Código</dt>
                        <dd><code class="admin-table-mono">{{ paciente.codigo }}</code></dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>CPF</dt>
                        <dd>
                            {% if paciente.cpf %}
                                {{ paciente.cpf|slice(0,3) }}.{{ paciente.cpf|slice(3,3) }}.{{ paciente.cpf|slice(6,3) }}-{{ paciente.cpf|slice(9,2) }}
                            {% else %}
                                <span class="text-muted">Não informado</span>
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 ml-1 align-baseline"
                                        data-unio-offcanvas-open="pos-op-paciente-edit"
                                        data-pos-op-paciente-edit="{{ paciente.id }}"
                                        data-pos-op-paciente-nome="{{ paciente|pos_op_paciente_nome|e('html_attr') }}"
                                        data-pos-op-paciente-codigo="{{ paciente.codigo|e('html_attr') }}">
                                    Cadastrar
                                </button>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Data de nascimento</dt>
                        <dd>{{ paciente.dataNascimento ? paciente.dataNascimento|date('d/m/Y') : '—' }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Data da cirurgia</dt>
                        <dd>{{ paciente.dataCirurgia ? paciente.dataCirurgia|date('d/m/Y') : '—' }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Procedimento</dt>
                        <dd>{{ paciente.procedimento|default('—') }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Protocolo</dt>
                        <dd>{{ paciente.protocolo ? paciente.protocolo.nome : '—' }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Status clínico</dt>
                        <dd>{{ paciente.status|pos_op_status_label }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Cadastrado em</dt>
                        <dd>{{ cadastrado_em|default('—') }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Médico responsável</dt>
                        <dd>{{ paciente.medicoResponsavel ? paciente.medicoResponsavel.nome : '—' }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Telefone</dt>
                        <dd>{{ paciente.telefoneContato|default('—') }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>E-mail</dt>
                        <dd>{{ paciente.emailContato|default('—') }}</dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Emergência</dt>
                        <dd>
                            {% if paciente.contatoEmergencia or paciente.telefoneEmergencia %}
                                {{ paciente.contatoEmergencia|default('—') }}
                                {% if paciente.telefoneEmergencia %}<span class="text-muted"> · {{ paciente.telefoneEmergencia }}</span>{% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </dd>
                    </div>
                    {% if paciente.observacoes %}
                    <div class="pos-op-detail-grid__row pos-op-detail-grid__row--wide">
                        <dt>Observações</dt>
                        <dd>{{ paciente.observacoes }}</dd>
                    </div>
                    {% endif %}
                    <div class="pos-op-detail-grid__row">
                        <dt>Portal do paciente</dt>
                        <dd>
                            {% if portal_user %}
                                {{ portal_user.nome }} <span class="text-muted">({{ portal_user.email }})</span>
                                {% if portal_vinculado|default(false) %}
                                <div class="pos-op-portal-sync mt-1">
                                    <span class="pos-op-portal-sync__badge pos-op-portal-sync__badge--{{ portal_questionario_hoje|default(false) ? 'ok' : 'pending' }}">
                                        <i class="fas {{ portal_questionario_hoje|default(false) ? 'fa-circle-check' : 'fa-clock' }}" aria-hidden="true"></i>
                                        Questionário hoje: {{ portal_questionario_hoje|default(false) ? ('respondido às ' ~ portal_questionario_hoje_em) : 'pendente no portal' }}
                                    </span>
                                </div>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">Não vinculado</span>
                                <form method="post" action="{{ path('app_pos_operatorio_paciente_convite_portal', { id: paciente.id }) }}" class="d-inline">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_op_convite_' ~ paciente.id) }}">
                                    <button type="submit" class="btn btn-link btn-sm p-0 ml-1 align-baseline">Gerar convite</button>
                                </form>
                                {% set _invite_url = portal_invite_url|default(app.session.get('pos_op_last_invite_url')) %}
                                {% if _invite_url %}
                                <div class="mt-2 p-2 rounded border bg-light">
                                    <div class="small text-muted mb-1">Link do convite (copie e envie):</div>
                                    <code class="d-block small text-break" style="user-select: all;">{{ _invite_url }}</code>
                                </div>
                                {% endif %}
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 ml-1 align-baseline"
                                        data-unio-offcanvas-open="pos-op-paciente-edit"
                                        data-pos-op-paciente-edit="{{ paciente.id }}"
                                        data-pos-op-paciente-nome="{{ paciente|pos_op_paciente_nome|e('html_attr') }}"
                                        data-pos-op-paciente-codigo="{{ paciente.codigo|e('html_attr') }}">
                                    Vincular manualmente
                                </button>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="pos-op-detail-grid__row">
                        <dt>Consentimento LGPD</dt>
                        <dd>{{ consentimento_em|default('Pendente no portal') }}</dd>
                    </div>
                </dl>
            </section>

            {% if care_contract|default(null) %}
            <section class="unio-card pos-op-ficha-card mb-4 organismo-care-card organismo-care-card--trilha">
                <div class="organismo-trilha-head">
                    <div>
                        {% include 'components/section_header.html.twig' with {
                            title: 'Trilha Unio',
                            subtitle: 'Rota de cuidado · v' ~ care_contract.versao ~ ' · ' ~ (care_contract.hash|slice(0, 12)) ~ '…'
                        } %}
                    </div>
                    {% include 'components/unio/selo.html.twig' with { variant: 'compact', label: 'Protocolo ativo' } %}
                </div>
                {% set _next_marco = care_contract.marcos|filter(m => not m.attested)|first %}
                {% if care_contract.marcos|length > 0 %}
                <ul class="organismo-trilha-rail" aria-label="Marcos da Trilha Unio">
                    {% for m in care_contract.marcos %}
                    {% set _p = m.label|split(' — ', 2) %}
                    {% set _when = _p|length == 2 ? _p[0] : m.label %}
                    {% set _is_next = _next_marco and _next_marco.key == m.key %}
                    {% if not loop.first %}<li class="organismo-trilha-rail__sep" aria-hidden="true"></li>{% endif %}
                    <li class="organismo-trilha-rail__step{{ m.attested ? ' is-done' : (_is_next ? ' is-next' : '') }}">
                        <span class="organismo-trilha-rail__dot" aria-hidden="true"></span>
                        <span>{{ _when }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
                <ul class="organismo-care-milestones list-unstyled mb-0 px-3 pb-3">
                    {% for m in care_contract.marcos %}
                    {% set _parts = m.label|split(' — ', 2) %}
                    <li class="organismo-care-milestones__item{{ m.attested ? ' is-done' : '' }}">
                        <div class="organismo-care-milestones__main">
                            <i class="fas {{ m.attested ? 'fa-check-circle' : 'fa-circle' }}" aria-hidden="true"></i>
                            <span class="organismo-care-milestones__label">
                                {% if _parts|length == 2 %}
                                <strong class="organismo-care-milestones__when">{{ _parts[0] }}</strong><span class="organismo-care-milestones__what"> — {{ _parts[1] }}</span>
                                {% else %}
                                <strong class="organismo-care-milestones__when">{{ m.label }}</strong>
                                {% endif %}
                            </span>
                            {% if m.attested %}
                            <span class="text-muted small">{{ m.em }} · {{ m.hash|slice(0, 8) }}…</span>
                            {% include 'components/unio/selo.html.twig' with { variant: 'compact', class: 'organismo-care-milestones__selo', label: 'Atestado' } %}
                            {% endif %}
                        </div>
                        {% if not m.attested %}
                        <form method="post" action="{{ path('app_organismo_contrato_atestar', { id: care_contract.id }) }}" class="organismo-care-milestones__form" data-unio-attest>
                            <input type="hidden" name="marco_key" value="{{ m.key }}">
                            <input type="hidden" name="evidencia" value="Atestação clínica na ficha">
                            <button type="submit" class="btn-unio-ghost btn-sm">Atestar na Trilha</button>
                        </form>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            {% if organism_memory|default([])|length > 0 %}
            <section class="unio-card pos-op-ficha-card mb-4 organismo-memory-card">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 px-3 pt-1">
                    {% include 'components/section_header.html.twig' with {
                        title: 'Memória Unio',
                        subtitle: 'O que a Unio lembra deste cuidado'
                    } %}
                    {% include 'components/unio/selo.html.twig' with { variant: 'compact', label: 'Memória viva' } %}
                </div>
                <ul class="list-unstyled px-3 pb-3 mb-0 organismo-memory-list">
                    {% for fact in organism_memory %}
                    <li class="organismo-memory-list__item">
                        <strong>{{ fact.sujeito }}</strong>
                        <span class="text-muted small d-block">{{ fact.criado_em }} · {{ fact.tipo }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            {% if clinic_products_enabled.carteirinha_digital|default(true) %}
            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Carteirinha digital',
                    subtitle: 'Identidade clínica do paciente'
                } %}
                <p class="px-3 pb-3 mb-0">
                    {% if paciente.hasCarteirinhaAtiva() %}
                    <span class="clinic-status clinic-status--success">Emissão ativa</span>
                    <span class="text-muted small d-block mt-1">Código {{ paciente.carteirinhaVerificacao }} · válida até {{ paciente.carteirinhaValidaAte|date('d/m/Y') }}</span>
                    <span class="text-muted small d-block">Portal: use <code>{{ paciente.codigo }}</code> + <code>{{ paciente.carteirinhaVerificacao }}</code>{% if paciente.cpf %} ou CPF cadastrado{% endif %}.</span>
                    {% else %}
                    <span class="text-muted">Nenhuma carteirinha emitida.</span>
                    {% endif %}
                    <a href="{{ path('app_pos_operatorio_carteirinha_paciente', { id: paciente.id }) }}" class="btn-unio-ghost btn-sm mt-2">
                        <i class="fas fa-id-card" aria-hidden="true"></i> Gerenciar carteirinha
                    </a>
                </p>
            </section>
            {% endif %}

            {% if clinic_products_enabled.comprovante_procedimento|default(true) %}
            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Comprovante de procedimento',
                    subtitle: 'Documento do episódio cirúrgico'
                } %}
                <p class="px-3 pb-3 mb-0">
                    {% if paciente.hasComprovanteAtivo() %}
                    <span class="clinic-status clinic-status--success">Emissão ativa</span>
                    <span class="text-muted small d-block mt-1">Código {{ paciente.comprovanteVerificacao }} · válido até {{ paciente.comprovanteValidaAte|date('d/m/Y') }}</span>
                    {% else %}
                    <span class="text-muted">Nenhum comprovante emitido.</span>
                    {% endif %}
                    <a href="{{ path('app_pos_operatorio_comprovante_paciente', { id: paciente.id }) }}" class="btn-unio-ghost btn-sm mt-2">
                        <i class="fas fa-file-medical" aria-hidden="true"></i> Gerenciar comprovante
                    </a>
                </p>
            </section>
            {% endif %}

            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Nota de evolução',
                    subtitle: 'Registro visível ao paciente no portal'
                } %}
                <form method="post" action="{{ path('app_pos_operatorio_paciente_evolucao', {id: paciente.id}) }}" class="px-3 pb-3">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_op_evolucao_' ~ paciente.id) }}">
                    <div class="form-group mb-2">
                        <label for="pos-op-evolucao-{{ paciente.id }}" class="small text-muted mb-1">Evolução clínica</label>
                        <textarea id="pos-op-evolucao-{{ paciente.id }}" name="nota" class="form-control" rows="3" required placeholder="Ex.: paciente estável, dor controlada, orientado sobre curativo"></textarea>
                    </div>
                    <button type="submit" class="btn-unio-primary btn-sm">
                        <i class="fas fa-notes-medical mr-1" aria-hidden="true"></i> Salvar evolução
                    </button>
                </form>
            </section>

            {% if checklist_progress|length > 0 %}
            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Progresso do protocolo',
                    subtitle: 'Checklist por dia pós-operatório'
                } %}
                <ul class="pos-op-protocol-progress">
                    {% for step in checklist_progress %}
                    <li class="pos-op-protocol-progress__item{% if step.done %} is-done{% endif %}">
                        <span class="pos-op-protocol-progress__day">D+{{ step.dia }}</span>
                        <span class="pos-op-protocol-progress__text">{{ step.item }}</span>
                        {% if step.done %}<i class="fas fa-check pos-op-protocol-progress__check" aria-hidden="true"></i>{% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Questionários recentes',
                    subtitle: questionarios|length ~ ' resposta(s) registrada(s)'
                } %}
                {% if questionarios|length > 0 %}
                <div class="table-responsive">
                    <table class="admin-table admin-table--compact">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Dor</th>
                                <th>Febre</th>
                                <th>Score</th>
                                <th>Enviado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for q in questionarios %}
                            <tr>
                                <td>{{ q.data }}</td>
                                <td>{{ q.dor is not null ? q.dor ~ '/10' : '—' }}</td>
                                <td>{{ q.febre is not null ? q.febre ~ ' °C' : '—' }}</td>
                                <td>
                                    {% include 'components/status_badge.html.twig' with {
                                        label: q.score,
                                        variant: q.score >= 70 ? 'danger' : (q.score >= 40 ? 'warning' : 'success')
                                    } %}
                                </td>
                                <td class="admin-table-date">{{ q.respondido_em }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <a href="{{ path('app_pos_operatorio_questionarios') }}" class="btn-unio-ghost btn-sm mt-3">Ver todos os questionários</a>
                {% else %}
                <p class="text-muted small px-3 pb-3 mb-0">Nenhum questionário respondido ainda.</p>
                {% endif %}
            </section>
        </div>

        <div class="col-xl-4 pos-op-ficha-side">
            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Ações rápidas',
                    subtitle: 'Comunicação com o paciente'
                } %}
                <div class="px-3 pb-3 d-flex flex-wrap gap-2">
                    {% if not portal_questionario_hoje|default(false) and portal_vinculado|default(false) %}
                    <form method="post" action="{{ path('app_pos_operatorio_paciente_lembrete', {id: paciente.id}) }}" class="d-inline">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('pos_op_lembrete_' ~ paciente.id) }}">
                        <button type="submit" class="btn-unio-ghost btn-sm">
                            <i class="fas fa-bell mr-1" aria-hidden="true"></i> Lembrete de questionário
                        </button>
                    </form>
                    {% endif %}
                    <a href="{{ path('app_pos_operatorio_alertas') }}" class="btn-unio-ghost btn-sm">
                        <i class="fas fa-triangle-exclamation mr-1" aria-hidden="true"></i> Fila de alertas
                    </a>
                </div>
            </section>

            {% if alertas|length > 0 %}
            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Alertas abertos',
                    subtitle: alertas|length ~ ' requer(em) acompanhamento'
                } %}
                <div class="pos-op-alerts-feed px-3 pb-3">
                    {% for alerta in alertas %}
                    <div class="pos-op-alert-row pos-op-alert-row--{{ alerta.prioridade == 'P1' ? 'critical' : (alerta.prioridade == 'P2' ? 'warn' : 'info') }}">
                        <span class="pos-op-alert-icon"><i class="fas fa-triangle-exclamation"></i></span>
                        <span class="pos-op-alert-body">
                            <span class="pos-op-alert-head">
                                {% include 'components/status_badge.html.twig' with {
                                    label: alerta.prioridade,
                                    variant: alerta.prioridade == 'P1' ? 'danger' : (alerta.prioridade == 'P2' ? 'warning' : 'info')
                                } %}
                                <small class="text-muted">{{ alerta.criado_em }}</small>
                            </span>
                            <strong class="pos-op-alert-title">{{ alerta.motivo }}</strong>
                        </span>
                    </div>
                    {% endfor %}
                </div>
                <div class="px-3 pb-3">
                    <a href="{{ path('app_pos_operatorio_alertas') }}" class="btn-unio-ghost btn-sm">Ir para fila de alertas</a>
                </div>
            </section>
            {% endif %}

            <section class="unio-card pos-op-ficha-card mb-4">
                {% include 'components/section_header.html.twig' with {
                    title: 'Linha do tempo',
                    subtitle: 'Histórico clínico do paciente'
                } %}
                {% if timeline_groups|default([])|length > 0 %}
                <div class="pos-op-timeline-v2 px-3 pb-3">
                    {% for group in timeline_groups %}
                    <section class="pos-op-timeline-v2__group" aria-label="{{ group.date_label }}">
                        <header class="pos-op-timeline-v2__date">
                            <span class="pos-op-timeline-v2__date-dot" aria-hidden="true"></span>
                            <span class="pos-op-timeline-v2__date-label">{{ group.date_label }}</span>
                        </header>
                        <ol class="pos-op-timeline-v2__events">
                            {% for ev in group.events %}
                            <li class="pos-op-timeline-v2__event pos-op-timeline-v2__event--{{ ev.tone }}">
                                <div class="pos-op-timeline-v2__rail" aria-hidden="true">
                                    <span class="pos-op-timeline-v2__node"></span>
                                </div>
                                <article class="pos-op-timeline-v2__card">
                                    <div class="pos-op-timeline-v2__card-head">
                                        <span class="pos-op-timeline-v2__icon" aria-hidden="true">
                                            <i class="fas {{ ev.icon }}"></i>
                                        </span>
                                        <div class="pos-op-timeline-v2__meta">
                                            <strong>{{ ev.label }}</strong>
                                            <time datetime="{{ ev.datetime }}" class="pos-op-timeline-v2__time">{{ ev.time }}</time>
                                        </div>
                                    </div>
                                    {% if ev.detail %}
                                    <p class="pos-op-timeline-v2__detail">{{ ev.detail }}</p>
                                    {% endif %}
                                    {% if ev.author and ev.type != 'acesso_ficha' %}
                                    <footer class="pos-op-timeline-v2__author">
                                        <i class="fas fa-user-circle" aria-hidden="true"></i>
                                        {{ ev.author }}
                                    </footer>
                                    {% endif %}
                                </article>
                            </li>
                            {% endfor %}
                        </ol>
                    </section>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-muted small px-3 pb-3 mb-0">Sem eventos registrados.</p>
                {% endif %}
            </section>
        </div>
    </div>
</div>
