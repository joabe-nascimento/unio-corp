{% extends 'layout/hub.html.twig' %}

{% block title %}{{ paciente ? 'Editar' : 'Novo' }} paciente · Pós-Operatório{% endblock %}
{% block permissions_scope %}hub_pos_operatorio{% endblock %}

{% set hub_page_title = paciente ? 'Editar paciente' : 'Novo paciente' %}
{% set hub_page_subtitle = paciente ? paciente.codigo : 'Cadastro pós-cirúrgico' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_content %}
<section class="unio-card p-4" style="max-width: 640px;">
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('pos_op_paciente') }}">

        <div class="form-group">
            <label for="nome">Nome completo *</label>
            <input id="nome" name="nome" class="form-control" required value="{{ paciente ? paciente.nome : '' }}">
        </div>

        <div class="form-group">
            <label for="procedimento">Procedimento</label>
            <input id="procedimento" name="procedimento" class="form-control" value="{{ paciente ? paciente.procedimento : '' }}">
        </div>

        <div class="form-group">
            <label for="data_cirurgia">Data da cirurgia</label>
            <input id="data_cirurgia" name="data_cirurgia" type="date" class="form-control"
                   value="{{ paciente and paciente.dataCirurgia ? paciente.dataCirurgia|date('Y-m-d') : '' }}">
        </div>

        <div class="form-group">
            <label for="telefone">Telefone de contato</label>
            <input id="telefone" name="telefone" class="form-control" value="{{ paciente ? paciente.telefoneContato : '' }}">
        </div>

        <div class="form-group">
            <label for="protocolo_id">Protocolo</label>
            <select id="protocolo_id" name="protocolo_id" class="form-control">
                <option value="">— Selecione —</option>
                {% for pr in protocolos %}
                <option value="{{ pr.id }}"{{ paciente and paciente.protocolo and paciente.protocolo.id == pr.id ? ' selected' : '' }}>
                    {{ pr.nome }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="medico_id">Médico responsável</label>
            <select id="medico_id" name="medico_id" class="form-control">
                <option value="">— Selecione —</option>
                {% for m in medicos %}
                <option value="{{ m.id }}"{{ paciente and paciente.medicoResponsavel and paciente.medicoResponsavel.id == m.id ? ' selected' : '' }}>
                    {{ m.nome }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="portal_user_id">Usuário do portal (login do paciente)</label>
            <select id="portal_user_id" name="portal_user_id" class="form-control">
                <option value="">— Nenhum —</option>
                {% for u in portal_users %}
                <option value="{{ u.id }}"{{ paciente and paciente.portalUser and paciente.portalUser.id == u.id ? ' selected' : '' }}>
                    {{ u.nome }} ({{ u.email }})
                </option>
                {% endfor %}
            </select>
            <small class="text-muted">Este usuário acessa o questionário em /pos-operatorio/portal</small>
        </div>

        {% if paciente %}
        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
                {% for st in ['ativo', 'pendente', 'encerrado'] %}
                <option value="{{ st }}"{{ paciente.status == st ? ' selected' : '' }}>{{ st|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
        {% endif %}

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-unio">Salvar</button>
            <a href="{{ paciente ? path('app_pos_operatorio_paciente_show', { id: paciente.id }) : path('app_pos_operatorio_pacientes') }}" class="btn-unio-ghost">Cancelar</a>
        </div>
    </form>
</section>
{% endblock %}

{% block body_attrs %} data-active-hub="hub_pos_operatorio"{% endblock %}
