{% extends 'layout/hub.html.twig' %}

{% block title %}{{ paciente ? 'Editar' : 'Novo' }} paciente{% if not org_clinic %} · Pós-Operatório{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = paciente ? 'Editar paciente' : 'Novo paciente' %}
{% set hub_page_subtitle = paciente ? paciente.codigo : 'Cadastro pós-cirúrgico' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block hub_content %}
<section class="unio-card p-4" style="max-width: 720px;">
    <form method="post" data-clinic-paciente-form>
        <input type="hidden" name="_token" value="{{ csrf_token('pos_op_paciente') }}">

        {% include 'modules/pos-operatorio/pacientes/_form_fields.html.twig' %}

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-unio">Salvar</button>
            <a href="{{ paciente ? path('app_pos_operatorio_paciente_show', { id: paciente.id }) : path('app_pos_operatorio_pacientes') }}" class="btn-unio-ghost">Cancelar</a>
        </div>
    </form>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/clinic-paciente-form.js') }}?v=2" defer></script>
{% endblock %}

{% block body_attrs %}{% if not org_clinic|default(false) %} data-active-hub="pos_operatorio"{% endif %}{% endblock %}
