{# Campos compartilhados — formulário paciente (offcanvas / partial) #}
{% set _pfx = field_prefix|default('') %}
{% set _clinic = org_clinic|default(false) %}
{% set _selected_protocol = paciente and paciente.protocolo ? paciente.protocolo.id : null %}

<div class="clinic-paciente-form" data-clinic-paciente-form>
    <div class="clinic-paciente-form__sections">
        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-user-injured" aria-hidden="true"></i> Identificação
            </legend>
            <div class="form-group">
                <label for="{{ _pfx }}nome">Nome completo *</label>
                <input id="{{ _pfx }}nome" name="nome" class="form-control" required autocomplete="name"
                       value="{{ paciente ? paciente.nome : '' }}">
            </div>
            <div class="row clinic-form-row clinic-form-row--id-meta">
                <div class="col-sm-6 col-lg-4 form-group">
                    <label for="{{ _pfx }}cpf">CPF</label>
                    <input id="{{ _pfx }}cpf" name="cpf" class="form-control clinic-form-control--short" type="text" inputmode="numeric"
                           autocomplete="off" placeholder="000.000.000-00" data-mask="cpf"
                           value="{{ paciente and paciente.cpf ? paciente.cpf|slice(0,3) ~ '.' ~ paciente.cpf|slice(3,3) ~ '.' ~ paciente.cpf|slice(6,3) ~ '-' ~ paciente.cpf|slice(9,2) : '' }}">
                    <small class="text-muted">Carteirinha digital e portal.</small>
                </div>
                <div class="col-sm-6 col-lg-4 form-group">
                    <label for="{{ _pfx }}data_nascimento">Data de nascimento</label>
                    <input id="{{ _pfx }}data_nascimento" name="data_nascimento" type="date" class="form-control clinic-form-control--date"
                           max="{{ 'now'|date('Y-m-d') }}"
                           value="{{ paciente and paciente.dataNascimento ? paciente.dataNascimento|date('Y-m-d') : '' }}">
                    <small class="text-muted">Opcional.</small>
                </div>
                <div class="col-sm-6 col-lg-4 form-group mb-0">
                    <label for="{{ _pfx }}data_cirurgia">Data da cirurgia *</label>
                    <input id="{{ _pfx }}data_cirurgia" name="data_cirurgia" type="date" class="form-control clinic-form-control--date"
                           {{ not paciente ? 'required' : '' }}
                           max="{{ 'now'|date('Y-m-d') }}"
                           value="{{ paciente and paciente.dataCirurgia ? paciente.dataCirurgia|date('Y-m-d') : '' }}">
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-phone" aria-hidden="true"></i> Contato
            </legend>
            <div class="row">
                <div class="col-md-6 form-group mb-md-0">
                    <label for="{{ _pfx }}telefone">Telefone/WhatsApp</label>
                    <input id="{{ _pfx }}telefone" name="telefone" class="form-control" type="tel" inputmode="tel"
                           placeholder="(00) 00000-0000" data-mask="phone"
                           value="{{ paciente ? paciente.telefoneContato : '' }}">
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}email_contato">E-mail do paciente</label>
                    <input id="{{ _pfx }}email_contato" name="email_contato" class="form-control" type="email" autocomplete="email"
                           placeholder="paciente@email.com"
                           value="{{ paciente ? paciente.emailContato : '' }}">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 form-group mb-md-0">
                    <label for="{{ _pfx }}contato_emergencia">Contato de emergência</label>
                    <input id="{{ _pfx }}contato_emergencia" name="contato_emergencia" class="form-control"
                           placeholder="Nome do familiar ou responsável"
                           value="{{ paciente ? paciente.contatoEmergencia : '' }}">
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}telefone_emergencia">Telefone de emergência</label>
                    <input id="{{ _pfx }}telefone_emergencia" name="telefone_emergencia" class="form-control" type="tel"
                           placeholder="(00) 00000-0000" data-mask="phone"
                           value="{{ paciente ? paciente.telefoneEmergencia : '' }}">
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-id-card" aria-hidden="true"></i> Documentos
            </legend>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label for="{{ _pfx }}sexo">Sexo</label>
                    <select id="{{ _pfx }}sexo" name="sexo" class="form-control">
                        <option value="">—</option>
                        <option value="M"{{ paciente and paciente.sexo == 'M' ? ' selected' : '' }}>Masculino</option>
                        <option value="F"{{ paciente and paciente.sexo == 'F' ? ' selected' : '' }}>Feminino</option>
                        <option value="O"{{ paciente and paciente.sexo == 'O' ? ' selected' : '' }}>Outro</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label for="{{ _pfx }}rg">RG</label>
                    <input id="{{ _pfx }}rg" name="rg" class="form-control" maxlength="20"
                           value="{{ paciente ? paciente.rg : '' }}">
                </div>
                <div class="col-md-4 form-group">
                    <label for="{{ _pfx }}cns">CNS</label>
                    <input id="{{ _pfx }}cns" name="cns" class="form-control" inputmode="numeric" maxlength="15"
                           value="{{ paciente ? paciente.cns : '' }}">
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section" data-clinic-endereco
                  data-cep-url="{{ path('app_pos_operatorio_localidades_cep', { cep: '00000000' }) }}"
                  data-cidades-url="{{ path('app_pos_operatorio_localidades_cidades') }}"
                  data-bairros-url="{{ path('app_pos_operatorio_localidades_bairros') }}">
            <legend class="clinic-form-section__title">
                <i class="fas fa-map-marker-alt" aria-hidden="true"></i> Endereço
            </legend>
            <p class="text-muted small mb-2">Digite o CEP para preencher automaticamente. UF, cidade e bairro usam listas oficiais (IBGE / BrasilAPI).</p>
            <div class="row">
                <div class="col-md-3 form-group">
                    <label for="{{ _pfx }}cep">CEP</label>
                    <input id="{{ _pfx }}cep" name="cep" class="form-control" inputmode="numeric" maxlength="9"
                           data-mask="cep" data-endereco-cep autocomplete="postal-code"
                           placeholder="00000-000"
                           value="{{ paciente and paciente.cep ? (paciente.cep|length == 8 ? paciente.cep|slice(0,5) ~ '-' ~ paciente.cep|slice(5) : paciente.cep) : '' }}">
                    <small class="text-muted" data-endereco-cep-status></small>
                </div>
                <div class="col-md-7 form-group">
                    <label for="{{ _pfx }}logradouro">Logradouro</label>
                    <input id="{{ _pfx }}logradouro" name="logradouro" class="form-control" maxlength="180"
                           data-endereco-logradouro autocomplete="address-line1"
                           value="{{ paciente ? paciente.logradouro : '' }}">
                </div>
                <div class="col-md-2 form-group">
                    <label for="{{ _pfx }}numero_endereco">Número</label>
                    <input id="{{ _pfx }}numero_endereco" name="numero_endereco" class="form-control" maxlength="20"
                           data-endereco-numero autocomplete="address-line2"
                           value="{{ paciente ? paciente.numeroEndereco : '' }}">
                </div>
                <div class="col-md-4 form-group">
                    <label for="{{ _pfx }}complemento">Complemento</label>
                    <input id="{{ _pfx }}complemento" name="complemento" class="form-control" maxlength="80"
                           data-endereco-complemento
                           value="{{ paciente ? paciente.complemento : '' }}">
                </div>
                <div class="col-md-3 form-group">
                    <label for="{{ _pfx }}uf">UF</label>
                    <select id="{{ _pfx }}uf" name="uf" class="form-control" data-endereco-uf>
                        <option value="">—</option>
                        {% for ufOpt in ufs|default([]) %}
                        <option value="{{ ufOpt.value }}"{{ paciente and paciente.uf == ufOpt.value ? ' selected' : '' }}>{{ ufOpt.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-5 form-group">
                    <label for="{{ _pfx }}cidade">Cidade</label>
                    <select id="{{ _pfx }}cidade" name="cidade" class="form-control" data-endereco-cidade
                            data-initial-cidade="{{ paciente ? paciente.cidade|default('')|e('html_attr') : '' }}">
                        <option value="">{{ paciente and paciente.uf ? 'Carregando…' : 'Selecione a UF' }}</option>
                        {% if paciente and paciente.cidade %}
                        <option value="{{ paciente.cidade }}" selected>{{ paciente.cidade }}</option>
                        {% endif %}
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label for="{{ _pfx }}bairro">Bairro</label>
                    <select id="{{ _pfx }}bairro" name="bairro" class="form-control" data-endereco-bairro
                            data-initial-bairro="{{ paciente ? paciente.bairro|default('')|e('html_attr') : '' }}">
                        <option value="">{{ paciente and paciente.cidade ? 'Selecione…' : 'Selecione a cidade' }}</option>
                        {% if paciente and paciente.bairro %}
                        <option value="{{ paciente.bairro }}" selected>{{ paciente.bairro }}</option>
                        {% endif %}
                        <option value="__outro__">Outro (digitar)</option>
                    </select>
                    <input type="text" class="form-control mt-2" data-endereco-bairro-outro maxlength="80"
                           placeholder="Digite o bairro" hidden
                           value="">
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-hospital" aria-hidden="true"></i> Convênio
            </legend>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}unidade_id">Unidade</label>
                    <select id="{{ _pfx }}unidade_id" name="unidade_id" class="form-control">
                        <option value="">—</option>
                        {% for u in unidades|default([]) %}
                        <option value="{{ u.id }}"{{ paciente and paciente.unidade and paciente.unidade.id == u.id ? ' selected' : '' }}>{{ u.nome }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}convenio_id">Convênio</label>
                    <select id="{{ _pfx }}convenio_id" name="convenio_id" class="form-control">
                        <option value="">Particular / sem convênio</option>
                        {% for c in convenios|default([]) %}
                        <option value="{{ c.id }}"{{ paciente and paciente.convenio and paciente.convenio.id == c.id ? ' selected' : '' }}>{{ c.nome }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}numero_carteirinha_convenio">Nº carteirinha</label>
                    <input id="{{ _pfx }}numero_carteirinha_convenio" name="numero_carteirinha_convenio" class="form-control" maxlength="40"
                           value="{{ paciente ? paciente.numeroCarteirinhaConvenio : '' }}">
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}validade_carteirinha_convenio">Validade carteirinha</label>
                    <input id="{{ _pfx }}validade_carteirinha_convenio" name="validade_carteirinha_convenio" type="date" class="form-control"
                           value="{{ paciente and paciente.validadeCarteirinhaConvenio ? paciente.validadeCarteirinhaConvenio|date('Y-m-d') : '' }}">
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-bullhorn" aria-hidden="true"></i> Origem
            </legend>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}origem_clinica">Origem clínica</label>
                    <select id="{{ _pfx }}origem_clinica" name="origem_clinica" class="form-control">
                        <option value="">—</option>
                        {% for key, label in origens_clinicas|default({}) %}
                        <option value="{{ key }}"{{ paciente and paciente.origemClinica == key ? ' selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}indicado_por">Indicado por</label>
                    <input id="{{ _pfx }}indicado_por" name="indicado_por" class="form-control" maxlength="160"
                           value="{{ paciente ? paciente.indicadoPor : '' }}">
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-users" aria-hidden="true"></i> Titular / dependente
            </legend>
            <div class="row">
                <div class="col-md-5 form-group">
                    <label for="{{ _pfx }}titular_nome">Nome do titular</label>
                    <input id="{{ _pfx }}titular_nome" name="titular_nome" class="form-control" maxlength="160"
                           value="{{ paciente ? paciente.titularNome : '' }}">
                </div>
                <div class="col-md-4 form-group">
                    <label for="{{ _pfx }}titular_cpf">CPF do titular</label>
                    <input id="{{ _pfx }}titular_cpf" name="titular_cpf" class="form-control" inputmode="numeric" data-mask="cpf"
                           value="{{ paciente and paciente.titularCpf ? paciente.titularCpf|slice(0,3) ~ '.' ~ paciente.titularCpf|slice(3,3) ~ '.' ~ paciente.titularCpf|slice(6,3) ~ '-' ~ paciente.titularCpf|slice(9,2) : '' }}">
                </div>
                <div class="col-md-3 form-group">
                    <label for="{{ _pfx }}parentesco_titular">Parentesco</label>
                    <select id="{{ _pfx }}parentesco_titular" name="parentesco_titular" class="form-control">
                        <option value="">—</option>
                        {% for key, label in parentescos|default({}) %}
                        <option value="{{ key }}"{{ paciente and paciente.parentescoTitular == key ? ' selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </fieldset>

        {% set _anamnese = paciente and paciente.anamnese ? paciente.anamnese : {} %}
        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-notes-medical" aria-hidden="true"></i> Anamnese estruturada
            </legend>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}anamnese_alergias">Alergias</label>
                    <textarea id="{{ _pfx }}anamnese_alergias" name="anamnese_alergias" class="form-control" rows="2">{{ _anamnese.alergias|default('') }}</textarea>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}anamnese_medicamentos">Medicamentos em uso</label>
                    <textarea id="{{ _pfx }}anamnese_medicamentos" name="anamnese_medicamentos" class="form-control" rows="2">{{ _anamnese.medicamentos_uso|default('') }}</textarea>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}anamnese_comorbidades">Comorbidades</label>
                    <textarea id="{{ _pfx }}anamnese_comorbidades" name="anamnese_comorbidades" class="form-control" rows="2">{{ _anamnese.comorbidades|default('') }}</textarea>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}anamnese_cirurgias">Cirurgias prévias</label>
                    <textarea id="{{ _pfx }}anamnese_cirurgias" name="anamnese_cirurgias" class="form-control" rows="2">{{ _anamnese.cirurgias_previas|default('') }}</textarea>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}anamnese_habitos">Hábitos</label>
                    <textarea id="{{ _pfx }}anamnese_habitos" name="anamnese_habitos" class="form-control" rows="2">{{ _anamnese.habitos|default('') }}</textarea>
                </div>
                <div class="col-md-6 form-group">
                    <label for="{{ _pfx }}anamnese_obs">Observações da anamnese</label>
                    <textarea id="{{ _pfx }}anamnese_obs" name="anamnese_obs" class="form-control" rows="2">{{ _anamnese.observacoes|default('') }}</textarea>
                </div>
            </div>
        </fieldset>

        <fieldset class="clinic-form-section">
            <legend class="clinic-form-section__title">
                <i class="fas fa-notes-medical" aria-hidden="true"></i> Observações clínicas
            </legend>
            <div class="form-group mb-0">
                <label for="{{ _pfx }}observacoes" class="sr-only">Observações clínicas</label>
                <textarea id="{{ _pfx }}observacoes" name="observacoes" class="form-control" rows="3"
                          placeholder="Alergias, comorbidades, orientações pós-alta, medicamentos em uso…">{{ paciente ? paciente.observacoes : '' }}</textarea>
            </div>
        </fieldset>

        <details class="clinic-form-advanced">
            <summary>Equipe e portal do paciente</summary>
            <div class="clinic-form-advanced__body">
                <div class="form-group">
                    <label for="{{ _pfx }}medico_id">Médico responsável</label>
                    <select id="{{ _pfx }}medico_id" name="medico_id" class="form-control">
                        <option value="">— Selecione —</option>
                        {% for m in medicos %}
                        <option value="{{ m.id }}"{{ (paciente and paciente.medicoResponsavel and paciente.medicoResponsavel.id == m.id) or (not paciente and current_user_id|default(null) == m.id) ? ' selected' : '' }}>
                            {{ m.nome }}
                        </option>
                        {% endfor %}
                    </select>
                    <small class="text-muted">Padrão: você ({{ app.user.nome|split(' ')|first }})</small>
                </div>
                <div class="form-group mb-0">
                    <label for="{{ _pfx }}portal_user_id">Login no portal do paciente</label>
                    <select id="{{ _pfx }}portal_user_id" name="portal_user_id" class="form-control">
                        <option value="">— Vincular depois —</option>
                        {% for u in portal_users %}
                        <option value="{{ u.id }}"{{ paciente and paciente.portalUser and paciente.portalUser.id == u.id ? ' selected' : '' }}>
                            {{ u.nome }} ({{ u.email }})
                        </option>
                        {% endfor %}
                    </select>
                    <small class="text-muted">Opcional no cadastro. O paciente pode responder questionários diários pelo portal.</small>
                </div>
                <div class="form-group">
                    <label for="{{ _pfx }}profissional_id">Profissional (catálogo)</label>
                    <select id="{{ _pfx }}profissional_id" name="profissional_id" class="form-control">
                        <option value="">—</option>
                        {% for p in profissionais|default([]) %}
                        <option value="{{ p.id }}"{{ paciente and paciente.profissional and paciente.profissional.id == p.id ? ' selected' : '' }}>{{ p.nome }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label for="{{ _pfx }}procedimento_id">Procedimento (catálogo)</label>
                    <select id="{{ _pfx }}procedimento_id" name="procedimento_id" class="form-control">
                        <option value="">—</option>
                        {% for pr in procedimentos_catalogo|default([]) %}
                        <option value="{{ pr.id }}"{{ paciente and paciente.procedimentoCatalogo and paciente.procedimentoCatalogo.id == pr.id ? ' selected' : '' }}>{{ pr.nome }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label for="{{ _pfx }}pacote_id">Pacote</label>
                    <select id="{{ _pfx }}pacote_id" name="pacote_id" class="form-control">
                        <option value="">—</option>
                        {% for pk in pacotes|default([]) %}
                        <option value="{{ pk.id }}"{{ paciente and paciente.pacote and paciente.pacote.id == pk.id ? ' selected' : '' }}>{{ pk.nome }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </details>

        <fieldset class="clinic-form-section clinic-form-section--procedimento">
            <legend class="clinic-form-section__title">
                <i class="fas fa-file-medical" aria-hidden="true"></i> Procedimento
            </legend>
            <div class="form-group mb-0">
                <label for="{{ _pfx }}protocolo_id">Procedimento *</label>
                <select id="{{ _pfx }}protocolo_id" name="protocolo_id" class="form-control" data-clinic-protocol-select
                        {{ not paciente ? 'required' : '' }}>
                    <option value="">— Selecione o procedimento —</option>
                    {% for pr in protocolos %}
                    <option value="{{ pr.id }}"
                            data-procedimento="{{ pr.nome|e('html_attr') }}"
                            data-dias="{{ pr.duracaoDias }}"
                            data-checklist="{{ pr.checklist|length }}"
                            {{ _selected_protocol == pr.id ? ' selected' : '' }}>
                        {{ pr.nome }}
                    </option>
                    {% endfor %}
                </select>
                {% if protocolos is empty %}
                <small class="text-danger d-block mt-1">
                    Nenhum protocolo ativo.
                    <a href="{{ path('app_pos_operatorio_protocolo_novo') }}">Criar protocolo</a>
                </small>
                {% else %}
                <small class="text-muted">Lista baseada nos protocolos cadastrados. Vincula checklist e alertas automaticamente.</small>
                {% endif %}
                <input type="hidden" id="{{ _pfx }}procedimento" name="procedimento"
                       value="{{ paciente ? paciente.procedimento : '' }}">
            </div>
        </fieldset>

        <div class="clinic-paciente-preview unio-card" id="{{ _pfx }}paciente-preview" hidden>
            <div class="clinic-paciente-preview__head">
                <span class="org-icon org-icon--sm org-icon--sky" aria-hidden="true"><i class="fas fa-heart-pulse"></i></span>
                <div>
                    <strong class="clinic-paciente-preview__title">Resumo do acompanhamento</strong>
                    <p class="clinic-paciente-preview__sub" data-clinic-preview-phase>Selecione procedimento e data da cirurgia</p>
                </div>
            </div>
            <dl class="clinic-paciente-preview__metrics">
                <div><dt>Fase atual</dt><dd data-clinic-preview-dia>—</dd></div>
                <div><dt>Duração</dt><dd data-clinic-preview-dias>—</dd></div>
                <div><dt>Marcos</dt><dd data-clinic-preview-marcos>—</dd></div>
            </dl>
        </div>

        {% if paciente %}
        <div class="form-group">
            <label for="{{ _pfx }}status">Status do acompanhamento</label>
            <select id="{{ _pfx }}status" name="status" class="form-control">
                {% for st in ['ativo', 'pendente', 'encerrado'] %}
                <option value="{{ st }}"{{ paciente.status == st ? ' selected' : '' }}>{{ st|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
        {% endif %}
    </div>
</div>
