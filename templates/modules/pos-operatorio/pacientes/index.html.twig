{% extends 'layout/hub.html.twig' %}

{% set _copy = organismo.copy|default({}) %}
{% set _label_clients = _copy.nav_pacientes|default(org_clinic|default(false) ? 'Pacientes' : 'Clientes') %}
{% set _cta_label = org_clinic|default(false) ? 'Novo paciente' : 'Novo projeto' %}

{% block title %}{{ _label_clients }}{% if not org_clinic %} · {{ _copy.brand_name|default('Studio') }}{% endif %}{% endblock %}
{% block permissions_scope %}{% if not org_clinic %}hub_pos_operatorio{% endif %}{% endblock %}

{% set hub_page_title = _label_clients %}
{% set hub_page_eyebrow = org_clinic ? org_brand_label : '' %}
{% set hub_page_subtitle = org_clinic|default(false) ? 'Cadastro e acompanhamento pós-cirúrgico' : 'Cadastro de clientes e projetos digitais' %}
{% set hub_search_hidden = true %}
{% set hub_show_tabs = false %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pos-operatorio-hub.css') }}?v=16">
{% endblock %}

{% block hub_toolbar_actions %}
<button type="button"
        class="btn-unio btn-sm"
        data-unio-offcanvas-open="pos-op-paciente-form"
        data-pos-op-paciente-form-open>
    <i class="fas fa-plus mr-1" aria-hidden="true"></i>
    {{ _cta_label }}
</button>
<button type="button"
        class="btn-unio-ghost btn-sm"
        id="posOpUltimaFichaBtn"
        hidden
        title="Abrir a última ficha vista nesta clínica">
    <i class="fas fa-clock-rotate-left mr-1" aria-hidden="true"></i>
    Última ficha
</button>
{% if not org_clinic %}
<a href="{{ path('app_pos_operatorio') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Visão geral
</a>
{% endif %}
{% endblock %}

{% block hub_section_toolbar %}
<form method="get" action="{{ path('app_pos_operatorio_pacientes') }}" style="display:contents;">
{% embed 'components/section_toolbar.html.twig' with {
    search_in_section: true,
    search_placeholder: org_clinic|default(false) ? 'Buscar nome, código ou procedimento…' : 'Buscar nome ou código…',
    search_name: 'q',
    search_value: filter_q|default(''),
    btn_sm: true
} %}
    {% block section_toolbar_filters %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Status',
            name: 'status',
            value: filter_status|default(''),
            min_width: '150px',
            options: [
                { value: '', label: 'Em acompanhamento' },
                { value: 'ativo', label: 'Ativo' },
                { value: 'alerta', label: 'Alerta' },
                { value: 'pendente', label: 'Pendente' },
                { value: 'encerrado', label: 'Encerrado' },
            ]
        } %}
        {% include 'components/toolbar_filter_actions.html.twig' with {
            clear_href: path('app_pos_operatorio_pacientes'),
            has_filters: filter_q|default('') or filter_status|default('')
        } %}
    {% endblock %}
{% endembed %}
</form>
{% endblock %}

{% block hub_content %}
<section class="unio-card">
    {% if pacientes is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: org_clinic|default(false) ? 'fa-user-injured' : 'fa-folder-open',
            title: filter_q|default('') or filter_status|default('')
                ? 'Nenhum resultado'
                : (org_clinic|default(false) ? 'Nenhum paciente cadastrado' : 'Nenhum projeto cadastrado'),
            text: filter_q|default('') or filter_status|default('')
                ? 'Ajuste a busca ou limpe os filtros.'
                : 'Cadastre o primeiro registro para começar o acompanhamento.',
            btn_label: (filter_q|default('') or filter_status|default('')) ? '' : _cta_label,
            btn_opens: (filter_q|default('') or filter_status|default('')) ? '' : 'pos-op-paciente-form',
            btn_icon: 'fa-plus',
            btn_sm: true,
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Procedimento</th>
                    <th>Fase</th>
                    <th>Médico</th>
                    <th>Status</th>
                    <th>Portal hoje</th>
                    <th class="text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for p in pacientes %}
                <tr>
                    <td><code>{{ p.codigo }}</code></td>
                    <td><strong>{{ p|pos_op_paciente_nome }}</strong></td>
                    <td>{{ p.procedimento|default('—') }}</td>
                    <td>{% if p.diaPosOperatorio is not null %}D+{{ p.diaPosOperatorio }}{% else %}—{% endif %}</td>
                    <td>{{ p.medicoResponsavel ? p.medicoResponsavel.nome : '—' }}</td>
                    <td>{{ p.status|pos_op_status_label }}</td>
                    <td>
                        {% if silenciosos_hoje[p.id]|default(false) %}
                        {% include 'components/status_badge.html.twig' with { label: 'Sem resposta', variant: 'warning' } %}
                        {% else %}
                        <span class="text-muted small">—</span>
                        {% endif %}
                    </td>
                    <td class="text-right">
                        <div class="pos-op-paciente-row-actions">
                            <button type="button"
                                    class="btn-unio-ghost btn-sm"
                                    title="Ver ficha"
                                    data-unio-offcanvas-open="pos-op-paciente-ficha"
                                    data-pos-op-paciente-ficha="{{ p.id }}"
                                    data-pos-op-paciente-nome="{{ p|pos_op_paciente_nome|e('html_attr') }}"
                                    data-pos-op-paciente-codigo="{{ p.codigo|e('html_attr') }}">
                                <i class="fas fa-eye" aria-hidden="true"></i>
                                <span class="ml-1">Ficha</span>
                            </button>
                            <button type="button"
                                    class="btn-unio-ghost btn-sm"
                                    title="Editar paciente"
                                    data-unio-offcanvas-open="pos-op-paciente-edit"
                                    data-pos-op-paciente-edit="{{ p.id }}"
                                    data-pos-op-paciente-nome="{{ p|pos_op_paciente_nome|e('html_attr') }}"
                                    data-pos-op-paciente-codigo="{{ p.codigo|e('html_attr') }}">
                                <i class="fas fa-pen" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>
{% endblock %}

{% block page_overlays %}
{% include 'components/pos_operatorio/paciente_form_offcanvas.html.twig' with {
    open: app.request.query.getBoolean('open_novo'),
    paciente: null,
    protocolos: protocolos,
    medicos: medicos,
    portal_users: portal_users
} %}
{% include 'components/pos_operatorio/paciente_edit_offcanvas.html.twig' %}
{% include 'components/pos_operatorio/paciente_ficha_offcanvas.html.twig' %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/clinic-paciente-form.js') }}?v=2" defer></script>
<script src="{{ asset('js/pos-operatorio-hub.js') }}?v=7"></script>
<script>
(function () {
    if (window.UnioOffcanvas && typeof window.UnioOffcanvas.refresh === 'function') {
        window.UnioOffcanvas.refresh();
    }
    if (window.PosOperatorioHub && typeof window.PosOperatorioHub.initPacientesList === 'function') {
        window.PosOperatorioHub.initPacientesList({
            openNovo: {{ app.request.query.getBoolean('open_novo') ? 'true' : 'false' }},
            openEditId: {{ app.request.query.get('open_edit')|default(0) }},
            openFichaId: {{ app.request.query.get('open_ficha')|default(0) }}
        });
    }
})();
</script>
{% endblock %}

{% block body_attrs %}{% if not org_clinic|default(false) %} data-active-hub="pos_operatorio"{% endif %}{% endblock %}
