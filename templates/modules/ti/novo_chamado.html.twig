{% extends 'modules/ti/_base.html.twig' %}
{% block ti_section_content %}
{% set cat_options = [] %}
{% for c in categories %}
    {% set cat_options = cat_options|merge([{ value: c.id, label: c.label }]) %}
{% endfor %}
{% set pri_options = [] %}
{% for p in priorities %}
    {% set pri_options = pri_options|merge([{ value: p, label: p }]) %}
{% endfor %}
<div class="row">
    <div class="col-lg-7 mb-4">
        <section class="unio-card">
            {% include 'components/section_header.html.twig' with {
                title: 'Abrir chamado',
                subtitle: 'Descreva o problema — triagem Cortex automática'
            } %}
            <form action="{{ path('app_ti_chamado_novo_submit') }}" method="post" class="ti-form-page" id="tiChamadoForm">
                <input type="hidden" name="_token" value="{{ csrf_token('ti_novo_chamado') }}">
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'title', name: 'title', label: 'Título', required: true,
                    placeholder: 'Ex.: VPN não conecta após atualização'
                } %}
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'summary', name: 'summary', label: 'Descrição', type: 'textarea', rows: 4,
                    placeholder: 'Detalhe sintomas, mensagens de erro e impacto no trabalho.'
                } %}
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'category', name: 'category', label: 'Categoria', type: 'select', required: true,
                    value: 'sistema',
                    options: cat_options
                } %}
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'priority', name: 'priority', label: 'Prioridade', type: 'select', required: true,
                    value: 'P3',
                    options: pri_options
                } %}
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn-unio-primary">Abrir chamado</button>
                    <a href="{{ path('app_ti_chamados') }}" class="btn-unio-ghost">Cancelar</a>
                </div>
            </form>
        </section>
    </div>
    <div class="col-lg-5 mb-4">
        <section class="unio-card">
            {% include 'components/section_header.html.twig' with {
                title: 'Catálogo rápido',
                subtitle: 'Ou escolha um serviço padronizado'
            } %}
            <div class="ti-catalog-quick">
                {% for item in catalog %}
                <button type="button" class="ti-catalog-quick-item" data-ti-catalog-pick="{{ item.title }}" data-ti-catalog-cat="{{ item.id }}">
                    <i class="fas {{ item.icon }}" aria-hidden="true"></i>
                    <span>{{ item.title }}</span>
                    <small>{{ item.sla }}</small>
                </button>
                {% endfor %}
            </div>
        </section>
    </div>
</div>
{% endblock %}
