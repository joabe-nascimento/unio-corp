{% extends 'base.html.twig' %}
{% block title %}War Room — Núcleo TI{% endblock %}
{% block page_show_title %}{% endblock %}
{% block page_scroll_mode %}flow{% endblock %}
{% block body_attrs %} data-page="ti-war-room"{% endblock %}

{% block content %}
<div class="ti-war-room-page">
    <div class="ti-war-room wr-root"
         data-wr-poll-url="{{ path('app_ti_war_room_poll') }}"
         data-wr-severity="{{ severity_score }}"
         data-severity="{{ severity_level }}">
        <div class="wr-scanline" aria-hidden="true"></div>

        {% include 'components/ti/war_room_header.html.twig' %}

        <div class="wr-main">
            <div class="wr-command-head">
                {% include 'components/page_banner.html.twig' with {
                    icon: 'fa-skull-crossbones',
                    title: 'Sala de crise P1',
                    subtitle: 'Coordenação de incidentes em tempo real — chamados críticos, NOC, blast radius, briefing ' ~ ai_assistant_name ~ ', runbooks e comunicação com stakeholders.'
                } %}

                {% include 'components/ti/war_room_brief.html.twig' %}
            </div>

            {% include 'components/ti/war_room_board.html.twig' %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/ti-hub.css') }}?v=68">
<link rel="stylesheet" href="{{ asset('css/ti-war-room.css') }}?v=5">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/ti-war-room.js') }}?v=2" defer></script>
{% endblock %}
