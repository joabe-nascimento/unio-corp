{% extends 'modules/ti/_base.html.twig' %}
{% block ti_section_content %}
{% if recurring|default([])|length > 0 %}
<section class="unio-card mb-4 ti-noc-alerts">
    {% include 'components/section_header.html.twig' with {
        title: 'Padrões recorrentes detectados',
        subtitle: 'Helia sugere abrir problemas formais'
    } %}
    <div class="ti-noc-alerts-feed">
        {% for r in recurring %}
        <div class="ti-noc-alert-row ti-noc-alert-row--warn">
            <span class="ti-noc-alert-icon"><i class="fas fa-diagram-project"></i></span>
            <span class="ti-noc-alert-body">
                <span class="ti-noc-alert-head">
                    <span class="section-title mb-0">{{ r.title }}</span>
                    {% include 'components/ti/ti_metric_badge.html.twig' with { label: r.count ~ ' chamados', variant: 'warning' } %}
                </span>
                <span class="ti-noc-alert-detail">{{ r.ticket_ids|join(', ') }}</span>
            </span>
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}

<section class="unio-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Problemas registrados',
        subtitle: 'Gestão de causa raiz',
        btn_label: ti_can('manage_problemas') ? 'Novo problema' : null,
        btn_icon: 'fa-plus',
        btn_tag: 'button',
        btn_attrs: ti_can('manage_problemas') ? { 'data-unio-offcanvas-open': 'ti-problema-form', 'data-ti-infra-open-novo': 'problema' } : {}
    } %}
    <div class="ti-card-list">
    {% for p in problemas %}
    <div class="ti-card-list-item">
        <div class="ti-idea-row-head">
            <code>{{ p.id }}</code>
            {% include 'components/ti/ti_health_badge.html.twig' with { status: p.status == 'resolvido' ? 'done' : (p.status == 'investigacao' ? 'scheduled' : 'approved'), label: p.status|replace({'_': ' '})|capitalize } %}
            {% include 'components/ti/ti_priority_badge.html.twig' with { priority: p.priority } %}
            {% if ti_can('manage_problemas') %}
            {% include 'components/ti/infra_row_actions.html.twig' with {
                resource: 'problema',
                id: p.db_id,
                label: p.title,
                fields: {
                    titulo: p.titulo,
                    resumo: p.resumo,
                    causa_raiz: p.causa_raiz|default(''),
                    prioridade: p.prioridade,
                    status: p.status,
                    categoria: p.categoria
                }
            } %}
            {% endif %}
        </div>
        <p class="section-title mb-1">{{ p.title }}</p>
        <p class="section-subtitle mb-0">{{ p.summary }}{% if p.ticket_count|default(0) > 0 %} · {{ p.ticket_count }} chamado(s){% endif %}</p>
    </div>
    {% else %}
    <p class="text-muted mb-0 py-3">Nenhum problema registrado.</p>
    {% endfor %}
    </div>
</section>
{% if ti_can('manage_problemas') %}
{% include 'components/ti/problema_offcanvas.html.twig' %}
{% endif %}
{% endblock %}
