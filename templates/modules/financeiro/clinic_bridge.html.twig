{% extends 'layout/hub.html.twig' %}
{% block title %}Financeiro clínico{% endblock %}
{% set hub_page_title = 'Financeiro clínico' %}
{% set hub_page_subtitle = 'Contas a receber da clínica — particular e convênio' %}
{% set hub_search_hidden = true %}

{% block hub_content %}
<div class="unio-card p-4">
    <p class="mb-3">
        Na Unio Saúde o caixa leve vive em <strong>Contas</strong>: contas abertas ao finalizar atendimento,
        marcação de pago/cortesia e vínculo com guias TISS.
    </p>
    <a href="{{ path('app_pos_operatorio_contas', { status: 'aberto' }) }}" class="btn-unio">
        Abrir contas a receber
    </a>
    <a href="{{ path('app_pos_operatorio_guias_glosas') }}" class="btn-unio-ghost">
        Painel anti-glosa
    </a>
</div>
{% endblock %}
