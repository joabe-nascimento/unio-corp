{% extends 'layout/hub.html.twig' %}
{% block title %}Núcleo de Operações{% endblock %}
{% block permissions_scope %}hub_operacoes{% endblock %}
{% set hub_page_title = 'Núcleo de Operações' %}
{% set show_rh_card = nav_show_modulo_rh|default(false) and (product_grant('product_rh', 'funcionarios') or product_grant('product_rh', 'admissoes')) %}
{% set show_pessoas_card = nav_show_modulo_pessoas|default(false) and (product_grant('product_pessoas', 'membros') or product_grant('product_pessoas', 'equipes')) %}
{% set show_eng_card = nav_show_modulo_engenharia|default(false) and (product_grant('product_engenharia', 'projetos') or product_grant('product_engenharia', 'cronograma')) %}
{% set hub_has_cards = show_rh_card or show_pessoas_card or show_eng_card %}
{% block hub_kpis %}
{% if hub_has_cards %}
<div class="page-lead-kpis">
    {% set kpi_items = [] %}
    {% if show_rh_card %}
        {% set kpi_items = kpi_items|merge([
            { value: '—', label: 'Recursos Humanos', sub: 'Colaboradores ativos', route: 'app_rh' }
        ]) %}
    {% endif %}
    {% if show_pessoas_card %}
        {% set kpi_items = kpi_items|merge([
            { value: '—', label: 'Gestão de Pessoas', sub: 'Equipes e estrutura', route: 'app_pessoas' }
        ]) %}
    {% endif %}
    {% if show_eng_card %}
        {% set kpi_items = kpi_items|merge([
            { value: '—', label: 'Obras e Projetos', sub: 'Obras em execução', route: 'app_engenharia' }
        ]) %}
    {% endif %}
    {% if kpi_items|length > 0 %}
        {% include 'components/kpi_row.html.twig' with { items: kpi_items, mb: 'mb-0' } %}
    {% endif %}
</div>
{% endif %}
{% endblock %}
{% block hub_content %}
{% if hub_has_cards %}
<div class="row">
    {% if show_rh_card %}
    {% set rh_links = [] %}
    {% if product_grant('product_rh', 'funcionarios') %}
        {% set rh_links = rh_links|merge([{ label: 'Funcionários', route: 'app_rh_funcionarios', icon: 'fa-users' }]) %}
    {% endif %}
    {% if product_grant('product_rh', 'admissoes') %}
        {% set rh_links = rh_links|merge([
            { label: 'Admissões', route: 'app_rh_admissoes', icon: 'fa-user-plus' },
            { label: 'Demissões', route: 'app_rh_demissoes', icon: 'fa-user-minus' },
        ]) %}
    {% endif %}
    {% if rh_links|length > 0 %}
        {% set rh_links = rh_links|merge([{ label: 'Abrir RH', route: 'app_rh', icon: 'fa-arrow-right', primary: true }]) %}
    {% endif %}
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Recursos Humanos',
            subtitle: 'Funcionários, admissões, férias e folha',
            links: rh_links
        } %}
    </div>
    {% endif %}

    {% if show_pessoas_card %}
    {% set pessoas_links = [] %}
    {% if product_grant('product_pessoas', 'membros') %}
        {% set pessoas_links = pessoas_links|merge([{ label: 'Membros', route: 'app_pessoas_membros', icon: 'fa-user' }]) %}
    {% endif %}
    {% if product_grant('product_pessoas', 'equipes') %}
        {% set pessoas_links = pessoas_links|merge([{ label: 'Equipes', route: 'app_pessoas_equipes', icon: 'fa-people-group' }]) %}
    {% endif %}
    {% if pessoas_links|length > 0 %}
        {% set pessoas_links = pessoas_links|merge([{ label: 'Abrir Pessoas', route: 'app_pessoas', icon: 'fa-arrow-right', primary: true }]) %}
    {% endif %}
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Gestão de Pessoas',
            subtitle: 'Membros, equipes, cargos e organograma',
            links: pessoas_links
        } %}
    </div>
    {% endif %}

    {% if show_eng_card %}
    {% set eng_links = [] %}
    {% if product_grant('product_engenharia', 'projetos') %}
        {% set eng_links = eng_links|merge([{ label: 'Projetos', route: 'app_engenharia_projetos', icon: 'fa-diagram-project' }]) %}
    {% endif %}
    {% if product_grant('product_engenharia', 'cronograma') %}
        {% set eng_links = eng_links|merge([{ label: 'Cronograma', route: 'app_engenharia_cronograma', icon: 'fa-calendar-days' }]) %}
    {% endif %}
    {% if eng_links|length > 0 %}
        {% set eng_links = eng_links|merge([{ label: 'Abrir módulo', route: 'app_engenharia', icon: 'fa-arrow-right', primary: true }]) %}
    {% endif %}
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Obras e Projetos',
            subtitle: 'Cronograma, orçamentos e equipes de campo',
            links: eng_links
        } %}
    </div>
    {% endif %}
</div>
{% else %}
    {% include 'components/hub_scope_empty.html.twig' with {
        icon: 'fa-briefcase',
        title: 'Nenhum módulo disponível no Núcleo de Operações',
        text: 'Você ainda não tem permissão para acessar RH, Pessoas ou Engenharia. Solicite ao gestor da equipe.'
    } %}
{% endif %}
{% endblock %}
