{% extends 'base.html.twig' %}
{% block title %}Hub Operações{% endblock %}
{% block page_title %}Hub Operações{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Hub Operações</li>{% endblock %}
{% block content %}

<div class="row stats-row mb-2">
    <div class="col-lg-3 col-md-6 col-sm-6">
        <a href="{{ path('app_rh') }}" class="text-decoration-none d-flex w-100">
            {% include 'components/stat_card.html.twig' with { icon: 'fa-id-card', value: '—', label: 'Recursos Humanos' } %}
        </a>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6">
        <a href="{{ path('app_pessoas') }}" class="text-decoration-none d-flex w-100">
            {% include 'components/stat_card.html.twig' with { icon: 'fa-users', value: '—', label: 'Gestão de Pessoas' } %}
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4 d-flex">
        <div class="huplex-card flex-fill">
            <div class="section-title mb-1">Recursos Humanos</div>
            <div class="section-subtitle mb-4">Funcionários, admissões, férias e folha</div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_rh_funcionarios') }}" class="btn-huplex-ghost btn-sm">Funcionários</a>
                <a href="{{ path('app_rh_admissoes') }}" class="btn-huplex-ghost btn-sm">Admissões</a>
                <a href="{{ path('app_rh') }}" class="btn-huplex btn-sm">Abrir RH</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4 d-flex">
        <div class="huplex-card flex-fill">
            <div class="section-title mb-1">Gestão de Pessoas</div>
            <div class="section-subtitle mb-4">Equipes, cargos e organograma</div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_pessoas_equipes') }}" class="btn-huplex-ghost btn-sm">Equipes</a>
                <a href="{{ path('app_pessoas_organograma') }}" class="btn-huplex-ghost btn-sm">Organograma</a>
                <a href="{{ path('app_pessoas') }}" class="btn-huplex btn-sm">Abrir Pessoas</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
