{% extends 'layout/page_list.html.twig' %}
{% block title %}Editar Cargo{% endblock %}
{% block permissions_scope %}product_pessoas{% endblock %}
{% set page_list_title = 'Editar cargo' %}
{% set page_list_actions_in_top = true %}
{% set fd = form_data|default({}) %}

{% block page_list_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: membros_count|default(0), label: 'Membros', sub: 'Com este cargo' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block page_list_content %}
<div class="rh-admissao-page">
    <div class="rh-admissao-main unio-card">
        <header class="rh-admissao-main-head">
            <h2 class="rh-admissao-main-title">{{ cargo.titulo }}</h2>
            <p class="rh-admissao-main-sub">
                Atualize o catálogo de funções. Alterações no título refletem na busca de membros.
            </p>
        </header>

        {% if membros_count|default(0) > 0 %}
        <div class="pessoas-cargo-offcanvas-hint unio-card p-3 mb-3">
            <i class="fas fa-users text-info mr-2" aria-hidden="true"></i>
            <span class="section-subtitle mb-0">
                <strong>{{ membros_count }}</strong> membro{{ membros_count != 1 ? 's' : '' }} usa{{ membros_count == 1 ? '' : 'm' }} este título.
                <a href="{{ path('app_pessoas_membros', { cargo: cargo.titulo }) }}">Ver na listagem</a>
            </span>
        </div>
        {% endif %}

        <form method="post"
              action="{{ path('app_pessoas_cargo_editar', { id: cargo.id }) }}"
              class="unio-form p-4 pt-0">
            <input type="hidden" name="_token" value="{{ csrf_token('pessoas_cargo_form') }}">

            {% include 'components/pessoas/cargo_form_fields.html.twig' with {
                prefix: 'cargo-edit',
                cargo: cargo,
                form_data: fd,
                areas_sugestoes: areas_sugestoes|default([]),
                nivel_options: nivel_options|default([])
            } %}

            <div class="d-flex gap-2 justify-content-end pt-2">
                <a href="{{ path('app_pessoas_cargos') }}" class="btn-unio-ghost">Cancelar</a>
                <button type="submit" class="btn-unio">
                    <i class="fas fa-check mr-1"></i> Salvar alterações
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
