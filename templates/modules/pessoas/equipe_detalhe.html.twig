{% extends 'layout/hub.html.twig' %}
{% block title %}Detalhe da Equipe{% endblock %}
{% block permissions_scope %}product_pessoas{% endblock %}

{% block content_lead %}
<div class="page-lead-zone">
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: equipe.nome,
        search_disabled: true,
        actions_in_top: true
    } %}
        {% block toolbar_actions %}
            <a href="{{ path('app_pessoas_equipes') }}" class="btn-unio-ghost btn-sm">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
            {% if grant_at_least('product_pessoas', 'equipes', 'GESTOR_EQUIPE') %}
            <a href="{{ path('app_pessoas_equipe_editar', { id: equipe.id }) }}" class="btn-unio btn-sm">
                <i class="fas fa-pen"></i> Editar
            </a>
            {% endif %}
        {% endblock %}
    {% endembed %}
    <div class="page-lead-kpis">
        {% include 'components/kpi_row.html.twig' with { items: [
            { value: stats.total, label: 'Total de Membros' },
            { value: stats.ativos, label: 'Ativos' },
            { value: stats.ferias, label: 'Em Férias' },
            { value: stats.inativos, label: 'Inativos' },
        ], mb: 'mb-0' } %}
    </div>
</div>
{% endblock %}

{% block hub_content %}
<div class="unio-card ficha-hero mb-3">
    <div class="team-hero-icon">{{ equipe.nome|slice(0,2)|upper }}</div>
    <div class="ficha-hero-info">
        <div class="ficha-hero-name">{{ equipe.nome }}</div>
        <div class="ficha-hero-role">{{ equipe.descricao|default('Equipe da empresa') }}</div>
        <div class="ficha-hero-meta">
            <span><i class="fas fa-user-tie"></i> {{ equipe.lider ? equipe.lider.nome : 'Sem líder definido' }}</span>
            <span><i class="fas fa-users"></i> {{ stats.total }} membros</span>
            {% if equipe.area %}<span><i class="fas fa-tag"></i> {{ equipe.area }}</span>{% endif %}
            {% if equipe.codigo %}<span><i class="fas fa-hashtag"></i> {{ equipe.codigo }}</span>{% endif %}
        </div>
    </div>
    {% if grant_at_least('product_pessoas', 'equipes', 'GESTOR_EQUIPE') %}
    <div class="ficha-hero-actions">
        <a href="{{ path('app_pessoas_membro_novo') }}" class="btn-unio btn-sm d-block text-center">
            <i class="fas fa-user-plus mr-1"></i> Adicionar membro
        </a>
    </div>
    {% endif %}
</div>

{% set av_palette = ['av-c1','av-c2','av-c3','av-c4','av-c5','av-c6','av-c7','av-c8'] %}

{% embed 'components/section_toolbar.html.twig' with {
    btn_label: 'Ver todos os membros',
    btn_href: path('app_pessoas_membros', { equipe: equipe.id }),
    btn_icon: 'fa-users',
    btn_ghost: true
} %}
    {% block section_toolbar_filters %}
        {% include 'components/view_toggle.html.twig' with {
            container_id: 'equipe-membros-container',
            storage_key:  'equipe_membros_view'
        } %}
    {% endblock %}
{% endembed %}

<div class="unio-card">
    {% if membros is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-users',
            title: 'Nenhum membro nesta equipe',
            text: 'Alocar colaboradores editando o cadastro ou criando um novo membro.',
            btn_label: grant_at_least('product_pessoas', 'membros', 'GESTOR_EQUIPE') ? 'Novo membro' : '',
            btn_href: grant_at_least('product_pessoas', 'membros', 'GESTOR_EQUIPE') ? path('app_pessoas_membro_novo') : ''
        } %}
    {% else %}
    <div id="equipe-membros-container" data-view-mode="list">
        {% for mb in membros %}
        {% set status_slug = mb.pessoasStatusSlug %}
        {% set ci = (loop.index - 1) % av_palette|length %}
        <div class="view-list-only">
            {% include 'components/member_card.html.twig' with {
                nome: mb.nome,
                cargo: mb.cargo|default('—'),
                equipe: equipe.nome,
                status: status_slug,
                route: 'app_pessoas_membro_ficha',
                route_params: { id: mb.id }
            } %}
        </div>
        <a href="{{ path('app_pessoas_membro_ficha', {id: mb.id}) }}"
           class="view-grid-only text-decoration-none">
            <div class="member-grid-card">
                <div class="member-grid-avatar">
                    {% include 'components/member_avatar.html.twig' with {
                        nome: mb.nome, size: 'lg', class: av_palette[ci]
                    } %}
                    <span class="member-status member-status--{{ status_slug }} member-grid-status">
                        {{ mb.statusLabel }}
                    </span>
                </div>
                <div class="member-grid-info">
                    <div class="member-grid-name">{{ mb.nome }}</div>
                    <div class="member-grid-role">{{ mb.cargo|default('—') }}</div>
                    <div class="member-grid-team">
                        <i class="fas fa-user-group"></i> {{ equipe.nome }}
                    </div>
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
