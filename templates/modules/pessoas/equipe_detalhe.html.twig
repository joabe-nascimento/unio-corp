{# Seleciona a equipe pelo ID ou usa a 1 como fallback #}
{% set eq = all_teams[equipe_id] ?? all_teams[1] %}

{% block content_lead %}
<div class="page-lead-zone">
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: eq.nome,
        search_disabled: true,
        actions_in_top: true
    } %}
        {% block toolbar_actions %}
            <a href="{{ path('app_pessoas_equipes') }}" class="btn-huplex-ghost btn-sm">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        {% endblock %}
    {% endembed %}
    <div class="page-lead-kpis">
        {% include 'components/kpi_row.html.twig' with { items: [
            { value: eq.membros|length,                                   label: 'Total de Membros' },
            { value: eq.membros|filter(m => m.status == 'ativo')|length,  label: 'Ativos' },
            { value: eq.membros|filter(m => m.status == 'ferias')|length, label: 'Em Férias' },
            { value: eq.membros|filter(m => m.status == 'inativo')|length, label: 'Inativos' },
        ], mb: 'mb-0' } %}
    </div>
</div>
{% endblock %}

{% block hub_content %}
<div class="ficha-stub-banner mb-3">
    <i class="fas fa-circle-info"></i>
    Dados fictícios de demonstração — equipe <strong>{{ eq.nome }}</strong>
    (ID #{{ equipe_id }}).
</div>

{# Hero da equipe #}
<div class="huplex-card ficha-hero mb-3">
    <div class="team-hero-icon">{{ eq.nome|slice(0,2)|upper }}</div>
    <div class="ficha-hero-info">
        <div class="ficha-hero-name">{{ eq.nome }}</div>
        <div class="ficha-hero-role">{{ eq.descricao }}</div>
        <div class="ficha-hero-meta">
            <span><i class="fas fa-user-tie"></i> {{ eq.lider }}</span>
            <span><i class="fas fa-users"></i> {{ eq.membros|length }} membros</span>
            <span><i class="fas fa-tag"></i> {{ eq.area }}</span>
            <span><i class="fas fa-calendar"></i> Criada em {{ eq.criada_em }}</span>
        </div>
    </div>
    {% if grant_at_least('product_pessoas', 'equipes', 'GESTOR_EQUIPE') %}
    <div class="ficha-hero-actions">
        <a href="#" class="btn-huplex-ghost btn-sm">
            <i class="fas fa-pen mr-1"></i> Editar equipe
        </a>
        <a href="{{ path('app_pessoas_membros') }}" class="btn-huplex btn-sm mt-2 d-block text-center">
            <i class="fas fa-user-plus mr-1"></i> Adicionar membro
        </a>
    </div>
    {% endif %}
</div>

{# Lista de membros com toggle lista/grid #}
{% set av_palette = ['av-c1','av-c2','av-c3','av-c4','av-c5','av-c6','av-c7','av-c8'] %}

{% embed 'components/section_toolbar.html.twig' with {
    btn_label: 'Ver todos os membros',
    btn_href: path('app_pessoas_membros'),
    btn_icon: 'fa-users',
    btn_ghost: true
} %}
    {% block section_toolbar_filters %}
        {% include 'components/view_toggle.html.twig' with {
            container_id: 'equipe-membros-container',
            storage_key:  'equipe_membros_view'
        } %}
    {% endblock %}
{% endembed %}

<div class="huplex-card">
    <div id="equipe-membros-container" data-view-mode="list">
        {% for mb in eq.membros %}
        {% set ci = (loop.index - 1) % av_palette|length %}

        {# Modo lista #}
        <div class="view-list-only">
            {% include 'components/member_card.html.twig' with {
                nome:         mb.nome,
                cargo:        mb.cargo,
                equipe:       eq.nome,
                status:       mb.status,
                route:        'app_pessoas_membro_ficha',
                route_params: { id: mb.id }
            } %}
        </div>

        {# Modo grid #}
        <a href="{{ path('app_pessoas_membro_ficha', {id: mb.id}) }}"
           class="view-grid-only text-decoration-none">
            <div class="member-grid-card">
                <div class="member-grid-avatar">
                    {% include 'components/member_avatar.html.twig' with {
                        nome:  mb.nome,
                        size:  'lg',
                        class: av_palette[ci]
                    } %}
                    <span class="member-status member-status--{{ mb.status }} member-grid-status">
                        {{ mb.status == 'ativo' ? 'Ativo' : (mb.status == 'ferias' ? 'Férias' : 'Inativo') }}
                    </span>
                </div>
                <div class="member-grid-info">
                    <div class="member-grid-name">{{ mb.nome }}</div>
                    <div class="member-grid-role">{{ mb.cargo }}</div>
                    <div class="member-grid-team">
                        <i class="fas fa-user-group"></i> {{ eq.nome }}
                    </div>
                </div>
            </div>
        </a>

        {% endfor %}
    </div>
</div>
{% endblock %}
