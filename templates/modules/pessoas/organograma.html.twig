{% extends 'layout/hub.html.twig' %}
{% block title %}Organograma{% endblock %}
{% block permissions_scope %}product_pessoas{% endblock %}
{% set hub_page_title = 'Organograma' %}

{% macro render_node(node) %}
<li>
    <a href="{{ path('app_pessoas_membro_ficha', { id: node.id }) }}" class="text-decoration-none">
        <strong>{{ node.nome }}</strong>
    </a>
    {% if node.cargo %}<span class="text-muted"> — {{ node.cargo }}</span>{% endif %}
    {% if node.children|length > 0 %}
    <ul>{% for child in node.children %}{{ _self.render_node(child) }}{% endfor %}</ul>
    {% endif %}
</li>
{% endmacro %}

{% block hub_content %}
<div class="unio-card p-4">
    <p class="text-muted mb-3">{{ total_nodes }} colaborador(es) na hierarquia (ativos, férias e afastados).</p>
    {% if tree is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-sitemap',
            title: 'Organograma vazio',
            text: 'Cadastre gestores nos membros para montar a árvore hierárquica.',
            btn_label: 'Ver membros',
            btn_href: path('app_pessoas_membros')
        } %}
    {% else %}
    <ul class="organograma-tree mb-0">
        {% for root in tree %}{{ _self.render_node(root) }}{% endfor %}
    </ul>
    {% endif %}
</div>
{% endblock %}
