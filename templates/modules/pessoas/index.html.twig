{% extends 'layout/hub.html.twig' %}
{% block title %}Gestão de Pessoas{% endblock %}
{% set hub_page_title = 'Gestão de Pessoas' %}
{% block hub_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: '0', label: 'Total de Membros',  sub: 'Cadastrados',    route: 'app_pessoas_membros' },
        { value: '0', label: 'Equipes Ativas',    sub: 'Formadas',       route: 'app_pessoas_equipes' },
        { value: '0', label: 'Cargos',            sub: 'Registrados',    route: 'app_pessoas_cargos' },
        { value: '0', label: 'Avaliações',        sub: 'Realizadas',     route: 'app_pessoas_avaliacao' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}
{% block hub_content %}
<div class="row">
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Membros',
            subtitle: 'Fichas técnicas, perfis, habilidades e histórico',
            links: [
                { label: 'Ver todos',       route: 'app_pessoas_membros' },
                { label: 'Adicionar',       route: 'app_pessoas_membro_novo' },
                { label: 'Abrir módulo',    route: 'app_pessoas_membros', primary: true },
            ]
        } %}
    </div>
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Equipes',
            subtitle: 'Criação e gestão de times, líderes e composição',
            links: [
                { label: 'Ver equipes',     route: 'app_pessoas_equipes' },
                { label: 'Nova equipe',     route: 'app_pessoas_equipe_nova' },
                { label: 'Abrir módulo',    route: 'app_pessoas_equipes', primary: true },
            ]
        } %}
    </div>
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Cargos',
            subtitle: 'Estrutura de funções e hierarquia de posições',
            links: [
                { label: 'Ver cargos',      route: 'app_pessoas_cargos' },
                { label: 'Abrir módulo',    route: 'app_pessoas_cargos', primary: true },
            ]
        } %}
    </div>
    <div class="col-md-6 mb-4 d-flex">
        {% include 'components/module_card.html.twig' with {
            title: 'Organograma',
            subtitle: 'Visualização da estrutura organizacional',
            links: [
                { label: 'Ver organograma', route: 'app_pessoas_organograma' },
                { label: 'Abrir módulo',    route: 'app_pessoas_organograma', primary: true },
            ]
        } %}
    </div>
</div>
{% endblock %}
