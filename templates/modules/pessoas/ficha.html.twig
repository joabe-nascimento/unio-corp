{% extends 'layout/hub.html.twig' %}
{% block title %}Ficha Técnica{% endblock %}
{% block permissions_scope %}product_pessoas{% endblock %}

{% block content_lead %}
<div class="page-lead-zone">
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: membro.nome,
        search_disabled: true,
        actions_in_top: true
    } %}
        {% block toolbar_actions %}
            {% if grant_at_least('product_pessoas', 'membros', 'GESTOR_EQUIPE') %}
            <a href="{{ path('app_pessoas_membro_editar', { id: membro.id }) }}" class="btn-unio btn-sm">
                <i class="fas fa-pen"></i> Editar
            </a>
            {% endif %}
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}

{% block hub_content %}
{% set status_slug = membro.pessoasStatusSlug %}
{% set competencias = membro.competencias|default([]) %}

<div class="unio-card ficha-hero mb-3">
    <div class="ficha-hero-avatar">
        {% if membro.foto %}
        <img src="{{ asset(membro.foto) }}" alt="" class="member-avatar member-avatar--xl" style="object-fit:cover;">
        {% else %}
        {% include 'components/member_avatar.html.twig' with { nome: membro.nome, size: 'xl' } %}
        {% endif %}
    </div>
    <div class="ficha-hero-info">
        <div class="ficha-hero-name">{{ membro.nome }}</div>
        <div class="ficha-hero-role">{{ membro.cargo|default('—') }}
            {% if membro.departamento %}
            <span class="ficha-hero-dept">· {{ membro.departamento.nome }}</span>
            {% endif %}
        </div>
        <div class="ficha-hero-meta">
            <span><i class="fas fa-envelope"></i> {{ membro.email }}</span>
            {% if membro.telefone %}<span><i class="fas fa-phone"></i> {{ membro.telefone }}</span>{% endif %}
            {% if membro.dataAdmissao %}<span><i class="fas fa-calendar-check"></i> Desde {{ membro.dataAdmissao|date('d/m/Y') }}</span>{% endif %}
        </div>
    </div>
    <div class="ficha-hero-actions">
        <span class="member-status member-status--{{ status_slug }}">{{ membro.statusLabel }}</span>
        {% if membro.gestor %}
        <div class="text-muted small mt-2">
            <i class="fas fa-user-tie"></i> Gestor: {{ membro.gestor.nome }}
        </div>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-3">
        {% if membro.observacoes %}
        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Sobre' } %}
            <p class="ficha-bio mb-0">{{ membro.observacoes|nl2br }}</p>
        </div>
        {% endif %}

        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Dados do Colaborador' } %}
            <div class="ficha-fields-grid">
                {% for f in [
                    { label: 'Nome completo', value: membro.nome },
                    { label: 'Cargo', value: membro.cargo|default('—') },
                    { label: 'Equipe', value: membro.departamento ? membro.departamento.nome : '—' },
                    { label: 'E-mail', value: membro.email },
                    { label: 'Telefone', value: membro.telefone|default('—') },
                    { label: 'Data de admissão', value: membro.dataAdmissao ? membro.dataAdmissao|date('d/m/Y') : '—' },
                    { label: 'Nível', value: membro.nivelMaturidade|default('—') },
                    { label: 'Status', value: membro.statusLabel },
                ] %}
                <div class="ficha-field">
                    <div class="ficha-field-label">{{ f.label }}</div>
                    <div class="ficha-field-value">{{ f.value }}</div>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Competências' } %}
            {% if competencias|length > 0 %}
            <div class="skill-tags">
                {% for s in competencias %}
                    <span class="skill-tag">{{ s }}</span>
                {% endfor %}
            </div>
            {% else %}
                {% include 'components/empty_state.html.twig' with { icon: 'fa-lightbulb', title: 'Nenhuma competência registrada', compact: true } %}
            {% endif %}
        </div>

        {% if avaliacoes|length > 0 %}
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Avaliações de desempenho' } %}
            <div class="table-responsive">
                <table class="table table-unio mb-0">
                    <thead>
                        <tr><th>Período</th><th>Nota</th><th>Avaliador</th><th>Data</th></tr>
                    </thead>
                    <tbody>
                        {% for av in avaliacoes %}
                        <tr>
                            <td>{{ av.periodo }}</td>
                            <td><strong>{{ av.nota }}</strong>/5</td>
                            <td>{{ av.avaliador ? av.avaliador.email : '—' }}</td>
                            <td>{{ av.criadoEm|date('d/m/Y') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}
    </div>

    <div class="col-lg-4">
        {% if membro.departamento %}
        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with {
                title: 'Equipe',
                btn_label: 'Ver equipe',
                btn_href: path('app_pessoas_equipe_detalhe', { id: membro.departamento.id }),
                btn_ghost: true
            } %}
            <a href="{{ path('app_pessoas_equipe_detalhe', { id: membro.departamento.id }) }}" class="ficha-equipe-item text-decoration-none">
                {% include 'components/member_avatar.html.twig' with { nome: membro.departamento.nome, size: 'sm' } %}
                <div>
                    <div class="ficha-equipe-nome">{{ membro.departamento.nome }}</div>
                    <div class="ficha-equipe-papel">{{ membro.cargo|default('Membro') }}</div>
                </div>
            </a>
        </div>
        {% endif %}

        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Histórico', subtitle: 'Linha do tempo' } %}
            {% if historico|length > 0 %}
            <div class="ficha-timeline">
                {% set type_icons = {
                    admissao: 'fa-door-open',
                    treinamento: 'fa-graduation-cap',
                    avaliacao: 'fa-star',
                    promocao: 'fa-arrow-up',
                    certificacao: 'fa-certificate'
                } %}
                {% for ev in historico|reverse %}
                <div class="timeline-item">
                    <div class="timeline-dot">
                        <i class="fas {{ type_icons[ev.tipo]|default('fa-circle') }}"></i>
                    </div>
                    <div class="timeline-body">
                        <div class="timeline-event">{{ ev.evento }}</div>
                        <div class="timeline-date">{{ ev.data }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
                {% include 'components/empty_state.html.twig' with { icon: 'fa-clock', title: 'Sem eventos registrados', compact: true } %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
