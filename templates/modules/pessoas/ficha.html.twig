{% set m = all[membro_id] ?? all[1] %}

{% block content_lead %}
<div class="page-lead-zone">
    {% embed 'components/list_toolbar.html.twig' with {
        page_title: m.nome,
        search_disabled: true,
        actions_in_top: true
    } %}
        {% block toolbar_actions %}
            <a href="{{ path('app_pessoas_membros') }}" class="btn-unio-ghost btn-sm">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        {% endblock %}
    {% endembed %}
</div>
{% endblock %}

{% block hub_content %}
<div class="ficha-stub-banner mb-3">
    <i class="fas fa-circle-info"></i>
    Dados fictícios de demonstração — ficha de <strong>{{ m.nome }}</strong> (ID #{{ membro_id }}).
</div>

{# ── Hero do perfil ── #}
<div class="unio-card ficha-hero mb-3">
    <div class="ficha-hero-avatar">
        {% include 'components/member_avatar.html.twig' with { nome: m.nome, size: 'xl' } %}
    </div>
    <div class="ficha-hero-info">
        <div class="ficha-hero-name">{{ m.nome }}</div>
        <div class="ficha-hero-role">{{ m.cargo }}
            <span class="ficha-hero-dept">· {{ m.dept }}</span>
        </div>
        <div class="ficha-hero-meta">
            <span><i class="fas fa-envelope"></i> {{ m.email }}</span>
            <span><i class="fas fa-phone"></i> {{ m.tel }}</span>
            <span><i class="fas fa-calendar-check"></i> Desde {{ m.admissao }}</span>
        </div>
    </div>
    <div class="ficha-hero-actions">
        <span class="member-status member-status--{{ m.status }}">
            {{ m.status == 'ativo' ? 'Ativo' : (m.status == 'ferias' ? 'Férias' : 'Inativo') }}
        </span>
        {% if grant_at_least('product_pessoas', 'membros', 'GESTOR_EQUIPE') %}
        <a href="#" class="btn-unio-ghost btn-sm mt-2 d-block text-center">
            <i class="fas fa-pen mr-1"></i> Editar
        </a>
        {% endif %}
        <a href="{{ path('app_pessoas_membros') }}" class="btn-unio-ghost btn-sm mt-1 d-block text-center">
            <i class="fas fa-arrow-left mr-1"></i> Voltar
        </a>
    </div>
</div>

{# ── Corpo da ficha ── #}
<div class="row">

    {# Coluna principal #}
    <div class="col-lg-8 mb-3">

        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Sobre' } %}
            <p class="ficha-bio">{{ m.bio }}</p>
        </div>

        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Dados do Colaborador' } %}
            <div class="ficha-fields-grid">
                {% for f in [
                    { label: 'Nome completo',    value: m.nome },
                    { label: 'Cargo',            value: m.cargo },
                    { label: 'Departamento',     value: m.dept },
                    { label: 'E-mail',           value: m.email },
                    { label: 'Telefone',         value: m.tel },
                    { label: 'Data de admissão', value: m.admissao },
                    { label: 'Status',           value: m.status == 'ativo' ? 'Ativo' : (m.status == 'ferias' ? 'Em Férias' : 'Inativo') },
                ] %}
                <div class="ficha-field">
                    <div class="ficha-field-label">{{ f.label }}</div>
                    <div class="ficha-field-value">{{ f.value }}</div>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Habilidades Técnicas' } %}
            <div class="skill-tags">
                {% for s in m.skills %}
                    <span class="skill-tag">{{ s }}</span>
                {% endfor %}
            </div>
        </div>

        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Certificações' } %}
            {% if m.certs %}
                <div class="d-flex flex-column gap-1">
                    {% for c in m.certs %}
                    <div class="ficha-cert-item">
                        <i class="fas fa-certificate ficha-cert-icon"></i>
                        <span>{{ c }}</span>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                {% include 'components/empty_state.html.twig' with { icon: 'fa-certificate', title: 'Nenhuma certificação', compact: true } %}
            {% endif %}
        </div>
    </div>

    {# Coluna lateral #}
    <div class="col-lg-4">

        <div class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with {
                title: 'Equipes',
                btn_label: 'Ver equipes',
                btn_href: path('app_pessoas_equipes'),
                btn_ghost: true
            } %}
            <div class="d-flex flex-column gap-2">
                {% for eq in m.equipes %}
                <a href="{{ path('app_pessoas_equipes') }}" class="ficha-equipe-item text-decoration-none">
                    {% include 'components/member_avatar.html.twig' with { nome: eq.nome, size: 'sm' } %}
                    <div>
                        <div class="ficha-equipe-nome">{{ eq.nome }}</div>
                        <div class="ficha-equipe-papel">{{ eq.papel }}</div>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>

        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Histórico', subtitle: 'Linha do tempo' } %}
            <div class="ficha-timeline">
                {% set type_icons = {
                    admissao:     'fa-door-open',
                    treinamento:  'fa-graduation-cap',
                    avaliacao:    'fa-star',
                    promocao:     'fa-arrow-up',
                    certificacao: 'fa-certificate'
                } %}
                {% for ev in m.historico|reverse %}
                <div class="timeline-item">
                    <div class="timeline-dot">
                        <i class="fas {{ type_icons[ev.tipo]|default('fa-circle') }}"></i>
                    </div>
                    <div class="timeline-body">
                        <div class="timeline-event">{{ ev.evento }}</div>
                        <div class="timeline-date">{{ ev.data }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>
{% endblock %}
