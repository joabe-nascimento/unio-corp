{% extends 'layout/page_list.html.twig' %}
{% block title %}Membros{% endblock %}
{% block permissions_scope %}product_pessoas{% endblock %}
{% set page_list_title = 'Membros' %}

{% block page_list_kpis %}
    <div class="page-lead-kpis">
        {% include 'components/kpi_row.html.twig' with { items: [
            { value: stats.total, label: 'Total de Membros',  sub: 'Cadastrados' },
            { value: stats.ativos, label: 'Ativos',            sub: 'Trabalhando agora' },
            { value: stats.ferias, label: 'Em Férias',         sub: 'Este mês' },
            { value: stats.equipes, label: 'Equipes',           sub: 'Formadas', route: 'app_pessoas_equipes' },
        ], mb: 'mb-0' } %}
    </div>
{% endblock %}

{% block page_list_section_toolbar %}
<form method="get" action="{{ path('app_pessoas_membros') }}" style="display:contents;">
{% embed 'components/section_toolbar.html.twig' with {
    btn_label: grant_at_least('product_pessoas', 'membros', 'GESTOR_EQUIPE') ? 'Novo Membro' : '',
    btn_href: path('app_pessoas_membro_novo'),
    btn_icon: 'fa-user-plus',
    search_in_section: true,
    search_placeholder: 'Buscar por nome, cargo ou equipe…',
    search_name: 'q',
    search_value: filter_q|default('')
} %}
    {% block section_toolbar_filters %}
        {% set status_options = [{ value: '', label: 'Todos' }] %}
        {% for s in [
            { value: 'ATIVO', label: 'Ativo' },
            { value: 'INATIVO', label: 'Inativo' },
            { value: 'FERIAS', label: 'Férias' },
            { value: 'AFASTADO', label: 'Afastado' },
        ] %}
            {% set status_options = status_options|merge([s]) %}
        {% endfor %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Status',
            name: 'status',
            value: filter_status|default(''),
            min_width: '140px',
            options: status_options
        } %}
        {% set equipe_options = [{ value: '', label: 'Todas' }] %}
        {% for d in departamentos|default([]) %}
            {% set equipe_options = equipe_options|merge([{ value: d.id, label: d.nome }]) %}
        {% endfor %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Equipe',
            name: 'equipe',
            value: filter_equipe|default(''),
            min_width: '160px',
            options: equipe_options
        } %}
        {% set cargo_options = [{ value: '', label: 'Todos' }] %}
        {% for c in cargos_opcoes|default([]) %}
            {% set cargo_options = cargo_options|merge([{ value: c, label: c }]) %}
        {% endfor %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Cargo',
            name: 'cargo',
            value: filter_cargo|default(''),
            min_width: '160px',
            options: cargo_options
        } %}
        {% include 'components/view_toggle.html.twig' with {
            container_id: 'members-container',
            storage_key:  'membros_view'
        } %}
        {% include 'components/toolbar_filter_actions.html.twig' with {
            clear_href: path('app_pessoas_membros'),
            has_filters: filter_q|default('') or filter_status|default('') or filter_equipe|default('') or filter_cargo|default('')
        } %}
    {% endblock %}
{% endembed %}
</form>
{% endblock %}

{% block page_list_content %}
<div class="unio-card">
    {% if membros is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-users',
            title: 'Nenhum membro encontrado',
            text: filter_q|default('') or filter_status|default('') or filter_equipe|default('') or filter_cargo|default('')
                ? 'Nenhum resultado para os filtros aplicados.'
                : 'Cadastre colaboradores ou conclua uma admissão no RH.'
        } %}
    {% else %}
    {% set av_palette = ['av-c1','av-c2','av-c3','av-c4','av-c5','av-c6','av-c7','av-c8'] %}
    <div id="members-container" data-view-mode="list">
        {% for m in membros %}
        {% set status_slug = m.pessoasStatusSlug %}
        <div class="view-list-only">
            {% include 'components/member_card.html.twig' with {
                nome: m.nome,
                cargo: m.cargo|default('—'),
                equipe: m.departamento ? m.departamento.nome : 'Sem equipe',
                status: status_slug,
                route: 'app_pessoas_membro_ficha',
                route_params: { id: m.id }
            } %}
        </div>
        {% set ci = (loop.index - 1) % av_palette|length %}
        <a href="{{ path('app_pessoas_membro_ficha', {id: m.id}) }}"
           class="view-grid-only text-decoration-none">
            <div class="member-grid-card">
                <div class="member-grid-avatar">
                    {% include 'components/member_avatar.html.twig' with {
                        nome:  m.nome,
                        size:  'lg',
                        class: av_palette[ci]
                    } %}
                    <span class="member-status member-status--{{ status_slug }} member-grid-status">
                        {{ m.statusLabel }}
                    </span>
                </div>
                <div class="member-grid-info">
                    <div class="member-grid-name">{{ m.nome }}</div>
                    <div class="member-grid-role">{{ m.cargo|default('—') }}</div>
                    <div class="member-grid-team">
                        <i class="fas fa-user-group"></i> {{ m.departamento ? m.departamento.nome : 'Sem equipe' }}
                    </div>
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
