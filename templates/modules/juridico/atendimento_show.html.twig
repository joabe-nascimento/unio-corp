{% extends 'layout/page_list.html.twig' %}
{% block title %}{{ ticket.assunto }} · Atendimento{% endblock %}
{% set page_list_title = ticket.assunto %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/jur-wa-chat-template.css') }}?v=2">
<style>
.jur-wa-chat__thread--wa-bg {
    background-image: url("{{ asset('images/wa/wa-chat-bg-light.png') }}");
}
[data-theme="dark"] .jur-wa-chat__thread--wa-bg {
    background-image: url("{{ asset('images/wa/wa-chat-bg-dark.png') }}");
}
</style>
{% endblock %}

{% block page_list_toolbar_actions %}
<div class="jur-atendimento-show__toolbar">
    <form method="post" action="{{ path('app_juridico_atendimento_status', { id: ticket.id }) }}" class="jur-atendimento-show__status-form">
        <input type="hidden" name="_token" value="{{ csrf_token('juridico_atendimento_status_' ~ ticket.id) }}">
        <select name="status" class="jur-form-select jur-form-select--inline" aria-label="Status do ticket" onchange="this.form.submit()">
            <option value="aberto" {% if ticket.status == 'aberto' %}selected{% endif %}>Novo</option>
            <option value="em_atendimento" {% if ticket.status == 'em_atendimento' %}selected{% endif %}>Em atendimento</option>
            <option value="aguardando_cliente" {% if ticket.status == 'aguardando_cliente' %}selected{% endif %}>Aguardando cliente</option>
            <option value="resolvido" {% if ticket.status == 'resolvido' %}selected{% endif %}>Resolvido</option>
        </select>
    </form>
    <a href="{{ path('app_juridico_atendimento') }}" class="btn-unio-ghost btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Voltar
    </a>
</div>
{% endblock %}

{% block page_list_content %}
<div class="jur-atendimento-show">
    <div class="jur-atendimento-show__chips" aria-label="Resumo do ticket">
        {% if ticket.canal == 'whatsapp' %}
        <span class="jur-atendimento-show__chip jur-atendimento-show__chip--wa"><i class="fab fa-whatsapp"></i> WhatsApp</span>
        {% elseif ticket.canal == 'email' %}
        <span class="jur-atendimento-show__chip"><i class="fas fa-envelope"></i> E-mail</span>
        {% else %}
        <span class="jur-atendimento-show__chip"><i class="fas fa-headset"></i> Interno</span>
        {% endif %}
        {% if ticket.prioridade == 'alta' %}
        <span class="jur-atendimento-show__chip jur-atendimento-show__chip--warn">Premium · SLA {{ ticket.slaHoras }}h</span>
        {% else %}
        <span class="jur-atendimento-show__chip jur-atendimento-show__chip--muted">SLA {{ ticket.slaHoras }}h · até {{ ticket.slaLimiteEm|date('d/m H:i') }}</span>
        {% endif %}
        {% if ticket.slaEstourado %}
        <span class="jur-atendimento-show__chip jur-atendimento-show__chip--danger">SLA estourado</span>
        {% endif %}
    </div>

    <div class="row g-3 align-items-start jur-atendimento-show__grid">
        <div class="col-xl-8 col-lg-7">
            {% include 'components/juridico/atendimento_whatsapp_chat.html.twig' %}
        </div>

        <div class="col-xl-4 col-lg-5">
            <aside class="jur-atendimento-show__aside">
                <section class="unio-card jur-atendimento-show__card p-0">
                    {% include 'components/section_header.html.twig' with { title: 'Ticket' } %}
                    <div class="jur-atendimento-show__body jur-atendimento-show__body--compact">
                        <dl class="jur-pub-meta-grid">
                            <div class="jur-pub-meta-grid__item">
                                <dt><i class="fas fa-comments" aria-hidden="true"></i> Canal</dt>
                                <dd>{{ ticket.canal|capitalize }}</dd>
                            </div>
                            <div class="jur-pub-meta-grid__item">
                                <dt><i class="fas fa-flag" aria-hidden="true"></i> Prioridade</dt>
                                <dd>{{ ticket.prioridade|capitalize }}</dd>
                            </div>
                            <div class="jur-pub-meta-grid__item jur-pub-meta-grid__item--full">
                                <dt><i class="fas fa-user" aria-hidden="true"></i> Cliente</dt>
                                <dd>{{ ticket.cliente ? ticket.cliente.nome : '—' }}</dd>
                            </div>
                            <div class="jur-pub-meta-grid__item jur-pub-meta-grid__item--full">
                                <dt><i class="fas fa-hashtag" aria-hidden="true"></i> Processo</dt>
                                <dd>{% if ticket.processo %}<code class="jur-pub-meta-grid__code">{{ ticket.processo.numero }}</code>{% else %}—{% endif %}</dd>
                            </div>
                        </dl>
                    </div>
                </section>

                {% if contexto.processo %}
                <section class="unio-card jur-atendimento-show__card p-0">
                    {% include 'components/section_header.html.twig' with { title: 'Contexto do caso', subtitle: 'Sem trocar de tela' } %}
                    <div class="jur-atendimento-show__body jur-atendimento-show__body--compact">
                        {% set proc = contexto.processo %}
                        <dl class="jur-pub-meta-grid">
                            <div class="jur-pub-meta-grid__item">
                                <dt><i class="fas fa-layer-group" aria-hidden="true"></i> Fase</dt>
                                <dd>{{ proc.fase|capitalize }}</dd>
                            </div>
                            <div class="jur-pub-meta-grid__item">
                                <dt><i class="fas fa-circle" aria-hidden="true"></i> Status</dt>
                                <dd>{{ proc.status|capitalize }}</dd>
                            </div>
                            <div class="jur-pub-meta-grid__item">
                                <dt><i class="fas fa-landmark" aria-hidden="true"></i> Tribunal</dt>
                                <dd>{{ proc.tribunal|default('—') }}</dd>
                            </div>
                            <div class="jur-pub-meta-grid__item">
                                <dt><i class="fas fa-briefcase" aria-hidden="true"></i> Área</dt>
                                <dd>{{ proc.area|default('—') }}</dd>
                            </div>
                        </dl>
                        {% if contexto.prazos is not empty %}
                        <h6 class="jur-atendimento-show__subhead">Prazos pendentes</h6>
                        <ul class="jur-atendimento-show__prazos">
                            {% for pr in contexto.prazos|slice(0, 5) %}
                            <li><strong>{{ pr.tipo }}</strong> — {{ pr.dataLimite|date('d/m/Y') }}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                        <a href="{{ path('app_juridico_processo_show', { id: proc.id }) }}" class="jur-atendimento-show__link">Abrir processo <i class="fas fa-external-link-alt"></i></a>
                    </div>
                </section>
                {% endif %}

                <section class="unio-card jur-atendimento-show__card p-0">
                    {% include 'components/section_header.html.twig' with { title: 'Vincular caso' } %}
                    <div class="jur-atendimento-show__body jur-atendimento-show__body--compact">
                        <form method="post" action="{{ path('app_juridico_atendimento_vincular', { id: ticket.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('juridico_atendimento_vincular_' ~ ticket.id) }}">
                            <label class="jur-form-label" for="atendClienteSelect">Cliente</label>
                            <select id="atendClienteSelect" name="cliente_id" class="jur-form-select mb-2">
                                <option value="">— Nenhum —</option>
                                {% for c in clientes %}
                                <option value="{{ c.id }}" {% if ticket.cliente and ticket.cliente.id == c.id %}selected{% endif %}>{{ c.nome }}</option>
                                {% endfor %}
                            </select>
                            <label class="jur-form-label" for="atendProcessoSelect">Processo</label>
                            <select id="atendProcessoSelect" name="processo_id" class="jur-form-select mb-3">
                                <option value="">— Nenhum —</option>
                                {% for p in processos %}
                                <option value="{{ p.id }}" {% if ticket.processo and ticket.processo.id == p.id %}selected{% endif %}>{{ p.numero }}{% if p.cliente %} — {{ p.cliente.nome }}{% endif %}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn-unio btn-sm w-100">Salvar vínculos</button>
                        </form>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var thread = document.getElementById('jur-atendimento-thread');
    if (thread) thread.scrollTop = thread.scrollHeight;

    var tplSelect = document.getElementById('jurAtendimentoTemplateSelect');
    var corpo = document.getElementById('jurAtendimentoCorpo');
    if (tplSelect && corpo) {
        tplSelect.addEventListener('change', function () {
            var opt = tplSelect.options[tplSelect.selectedIndex];
            var url = opt.getAttribute('data-preview-url');
            if (!url) return;
            fetch(url, { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (data) { if (data.ok) corpo.value = data.texto; });
        });
    }

    var btn = document.getElementById('jurAtendimentoSugerirBtn');
    if (btn && corpo) {
        btn.addEventListener('click', function () {
            btn.disabled = true;
            var fd = new FormData();
            fd.append('_token', btn.getAttribute('data-csrf'));
            fetch(btn.getAttribute('data-url'), { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.ok) corpo.value = data.sugestao;
                    else alert(data.erro || 'Sasha indisponível.');
                })
                .catch(function () { alert('Erro ao consultar a Sasha.'); })
                .finally(function () { btn.disabled = false; });
        });
    }
})();
</script>
{% endblock %}
