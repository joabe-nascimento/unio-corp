{% extends 'layout/page_list.html.twig' %}
{% block title %}{{ processo.numero }} · Processos{% endblock %}
{% set page_list_title = processo.numero %}

{% block page_list_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="juridico-processo-editar">
    <i class="fas fa-pen mr-1" aria-hidden="true"></i> Editar
</button>
<a href="{{ path('app_juridico_processos') }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
</a>
{% endblock %}

{% block page_list_content %}
{% if alertas_processo|default([]) is not empty %}
{% include 'components/juridico/alertas_risco_panel.html.twig' with { alertas: alertas_processo, title: 'Alertas deste processo', show_processo: false } %}
{% endif %}
<div class="row g-4">
    <div class="col-xl-7">
        <div class="unio-card">
            {% include 'components/unio/detail_field_section.html.twig' with { title: 'Dados do processo', items: [
                { label: 'Número (CNJ)', value: processo.numero, icon: 'fa-hashtag' },
                { label: 'Cliente', value: processo.cliente ? processo.cliente.nome : '—', icon: 'fa-building' },
                { label: 'Área', value: processo.area|default('—'), icon: 'fa-layer-group' },
                { label: 'Fase', value: processo.fase|capitalize, icon: 'fa-diagram-project' },
                { label: 'Tribunal', value: processo.tribunal|default('—'), icon: 'fa-landmark' },
                { label: 'Responsável', value: processo.responsavel ? processo.responsavel.nome : '—', icon: 'fa-user-tie' },
                { label: 'Valor da causa', value: processo.valor ? 'R$ ' ~ processo.valor|number_format(2, ',', '.') : '—', icon: 'fa-coins' },
                { label: 'Resultado', value: processo.resultado ? processo.resultado|capitalize : 'Em andamento', icon: 'fa-flag-checkered' },
                { label: 'Observações', value: processo.observacoes|default('—'), icon: 'fa-note-sticky', multiline: true },
            ]} %}
        </div>

        <div class="unio-card mt-4">
            {% include 'components/section_header.html.twig' with { title: 'Tarefas', subtitle: tarefas|filter(t => not t.concluida)|length ~ ' pendente(s) de ' ~ tarefas|length } %}
            <div class="px-3 pb-3">
                <form method="post" action="{{ path('app_juridico_processo_tarefa_novo', { id: processo.id }) }}" class="jur-inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('juridico_processo_tarefa_form') }}">
                    <input type="text" name="titulo" class="form-control" placeholder="Nova tarefa…" required>
                    <input type="date" name="prazo" class="form-control jur-inline-form__date" title="Prazo">
                    <select name="responsavel_id" class="form-control jur-inline-form__select" title="Responsável">
                        <option value="">— Responsável —</option>
                        {% for u in responsaveis %}
                        <option value="{{ u.id }}">{{ u.nome }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn-unio btn-sm"><i class="fas fa-plus" aria-hidden="true"></i></button>
                </form>

                {% if tarefas is empty %}
                <p class="text-muted small mt-3 mb-0">Nenhuma tarefa cadastrada para este processo ainda.</p>
                {% else %}
                <ul class="jur-tarefa-list">
                    {% for t in tarefas %}
                    <li class="jur-tarefa-item{{ t.concluida ? ' jur-tarefa-item--concluida' : '' }}{{ t.atrasada ? ' jur-tarefa-item--atrasada' : '' }}">
                        <form method="post" action="{{ path('app_juridico_processo_tarefa_concluir', { id: processo.id, tarefaId: t.id }) }}" class="jur-tarefa-item__toggle-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('juridico_processo_tarefa_concluir_' ~ t.id) }}">
                            <button type="submit" class="jur-tarefa-item__toggle" title="{{ t.concluida ? 'Reabrir tarefa' : 'Marcar como concluída' }}">
                                <i class="fas {{ t.concluida ? 'fa-circle-check' : 'fa-circle' }}" aria-hidden="true"></i>
                            </button>
                        </form>
                        <div class="jur-tarefa-item__body">
                            <span class="jur-tarefa-item__titulo">{{ t.titulo }}</span>
                            <span class="jur-tarefa-item__meta">
                                {% if t.prazo %}<i class="fas fa-calendar-day" aria-hidden="true"></i> {{ t.prazo|date('d/m/Y') }}{% endif %}
                                {% if t.responsavel %} · {{ t.responsavel.nome }}{% endif %}
                                {% if t.atrasada %} · <strong>atrasada</strong>{% endif %}
                            </span>
                        </div>
                        <form method="post" action="{{ path('app_juridico_processo_tarefa_excluir', { id: processo.id, tarefaId: t.id }) }}"
                              onsubmit="return confirm('Remover esta tarefa?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('juridico_processo_tarefa_excluir_' ~ t.id) }}">
                            <button type="submit" class="jur-tarefa-item__delete" title="Remover"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                        </form>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
        </div>

        <div class="unio-card mt-4">
            {% include 'components/section_header.html.twig' with { title: 'Partes e representação', subtitle: partes|length ~ ' cadastrada(s)' } %}
            <div class="px-3 pb-3">
                <form method="post" action="{{ path('app_juridico_processo_parte_novo', { id: processo.id }) }}" class="jur-inline-form jur-inline-form--wrap">
                    <input type="hidden" name="_token" value="{{ csrf_token('juridico_processo_parte_form') }}">
                    <input type="text" name="nome" class="form-control" placeholder="Nome da parte…" required>
                    <select name="polo" class="form-control jur-inline-form__select" title="Polo">
                        <option value="ativo">Polo ativo</option>
                        <option value="passivo">Polo passivo</option>
                        <option value="outro">Outro</option>
                    </select>
                    <select name="tipo" class="form-control jur-inline-form__select" title="Tipo">
                        <option value="autor">Autor</option>
                        <option value="reu">Réu</option>
                        <option value="terceiro">Terceiro</option>
                        <option value="testemunha">Testemunha</option>
                        <option value="perito">Perito</option>
                        <option value="outro">Outro</option>
                    </select>
                    <input type="text" name="advogado" class="form-control jur-inline-form__select" placeholder="Advogado (opcional)">
                    <input type="text" name="oab" class="form-control jur-inline-form__date" placeholder="OAB">
                    <button type="submit" class="btn-unio btn-sm"><i class="fas fa-plus" aria-hidden="true"></i></button>
                </form>

                {% if partes is empty %}
                <p class="text-muted small mt-3 mb-0">Nenhuma parte cadastrada — adicione autor, réu, terceiros e advogados envolvidos.</p>
                {% else %}
                <ul class="jur-parte-list">
                    {% for parte in partes %}
                    <li class="jur-parte-item">
                        <span class="badge {{ parte.polo == 'ativo' ? 'badge-soft-primary' : (parte.polo == 'passivo' ? 'badge-soft-secondary' : 'badge-secondary') }}">{{ parte.polo|capitalize }}</span>
                        <div class="jur-parte-item__body">
                            <span class="jur-parte-item__nome">{{ parte.nome }}</span>
                            <span class="jur-parte-item__meta">
                                {{ parte.tipo|capitalize }}
                                {% if parte.advogado %} · Adv. {{ parte.advogado }}{% endif %}
                                {% if parte.oab %} (OAB {{ parte.oab }}){% endif %}
                            </span>
                        </div>
                        <form method="post" action="{{ path('app_juridico_processo_parte_excluir', { id: processo.id, parteId: parte.id }) }}"
                              onsubmit="return confirm('Remover esta parte?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('juridico_processo_parte_excluir_' ~ parte.id) }}">
                            <button type="submit" class="jur-tarefa-item__delete" title="Remover"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                        </form>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Status' } %}
            <div class="px-3 pb-3">
                {% if processo.status == 'critico' %}
                <span class="badge badge-danger">Crítico</span>
                {% elseif processo.status == 'encerrado' %}
                <span class="badge badge-secondary">Encerrado</span>
                {% else %}
                <span class="badge badge-success">Ativo</span>
                {% endif %}
            </div>
        </div>
        <div class="unio-card mt-4">
            {% include 'components/section_header.html.twig' with { title: 'Zona de risco' } %}
            <div class="px-3 pb-3">
                <form method="post" action="{{ path('app_juridico_processo_excluir', { id: processo.id }) }}"
                      onsubmit="return confirm('Tem certeza que deseja excluir este processo? Esta ação não pode ser desfeita.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('juridico_processo_excluir_' ~ processo.id) }}">
                    <button type="submit" class="btn-unio-ghost btn-danger-ghost btn-sm">
                        <i class="fas fa-trash mr-1" aria-hidden="true"></i> Excluir processo
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_overlays %}
{% include 'components/juridico/processo_offcanvas.html.twig' with {
    id: 'juridico-processo-editar',
    processo: processo,
    clientes: clientes,
    responsaveis: responsaveis,
    form_id: 'juridicoProcessoEditarForm',
    form_action: path('app_juridico_processo_editar', { id: processo.id }),
    open: app.request.query.getBoolean('open_editar')
} %}
{% endblock %}
