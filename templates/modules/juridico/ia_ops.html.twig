{% extends 'layout/page_list.html.twig' %}
{% block title %}Operações de IA · Unio Jurídico{% endblock %}
{% set page_list_title = 'Operações de IA' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-heart-pulse" aria-hidden="true"></i> Inteligência · Observabilidade</span>
        <h2 class="jur-proc-hero__title">Operações da Sasha</h2>
        <p class="jur-proc-hero__text">Saúde do JurisFlow, modelo em uso e capacidade disponível — para o escritório não depender de “está fora” sem diagnóstico.</p>
    </div>
</section>
{% endblock %}

{% block page_list_content %}
<div class="unio-card">
    {% include 'components/section_header.html.twig' with { title: 'Status do motor', subtitle: escritorio } %}
    <div class="px-3 pb-3">
        <p class="mb-2">
            <span class="badge badge-{{ available ? 'success' : 'danger' }}">{{ available ? 'Online' : 'Offline' }}</span>
        </p>
        {% if status %}
        <dl class="row mb-0 small">
            <dt class="col-sm-4">Serviço</dt><dd class="col-sm-8">{{ status.service|default('JurisFlow') }}</dd>
            <dt class="col-sm-4">LLM</dt><dd class="col-sm-8">{{ status.llm_provider|default('—') }} · {{ status.llm_model|default('—') }}</dd>
            <dt class="col-sm-4">Versão</dt><dd class="col-sm-8">{{ status.version|default('—') }}</dd>
        </dl>
        {% else %}
        <p class="text-muted mb-0">Não foi possível ler <code>/v1/status</code>. O watchdog deve religar o serviço em instantes.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
