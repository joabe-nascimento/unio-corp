{% extends 'layout/page_list.html.twig' %}
{% block title %}Integração Tribunais · Unio Jurídico{% endblock %}
{% set page_list_title = 'Integração Tribunais' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-building-columns" aria-hidden="true"></i> PJe · e-SAJ · Projudi · EPROC</span>
        <h2 class="jur-proc-hero__title">Andamentos oficiais via DataJud (CNJ)</h2>
        <p class="jur-proc-hero__text">
            O DataJud é a base nacional do CNJ que agrega, oficialmente, os metadados processuais de mais de 90 tribunais —
            incluindo PJe, e-SAJ e Projudi. Cadastre sua chave gratuita e consulte andamentos direto pelo número do processo.
        </p>
    </div>
</section>
{% endblock %}

{% block page_list_toolbar_actions %}
<a href="{{ path('app_juridico_modulo', { slug: 'tribunais' }) }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-th-large mr-1" aria-hidden="true"></i> Sobre o módulo
</a>
{% endblock %}

{% block page_list_content %}
<div class="row g-4">
    <div class="col-lg-5">
        <section class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Chave de acesso DataJud', subtitle: 'Cadastro gratuito em datajud-wiki.cnj.jus.br' } %}
            <div class="px-3 pb-3">
                {% if config and config.configurado %}
                    <p class="mb-2">
                        <span class="badge {{ config.ultimoTesteOk ? 'badge-success' : 'badge-warning' }}">
                            <i class="fas {{ config.ultimoTesteOk ? 'fa-circle-check' : 'fa-triangle-exclamation' }} mr-1" aria-hidden="true"></i>
                            {{ config.ultimoTesteOk ? 'Conectado' : 'Não validado' }}
                        </span>
                    </p>
                    {% if config.ultimoTesteMensagem %}
                    <p class="small text-muted">{{ config.ultimoTesteMensagem }}</p>
                    {% endif %}
                    <p class="small text-muted mb-3">{{ config.totalConsultas }} consulta(s) realizada(s){% if config.ultimoTesteEm %} · último teste {{ config.ultimoTesteEm|date('d/m/Y H:i') }}{% endif %}</p>
                    <form method="post" action="{{ path('app_juridico_tribunais_testar') }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('juridico_tribunal_testar') }}">
                        <button type="submit" class="btn-unio-ghost btn-sm"><i class="fas fa-plug mr-1" aria-hidden="true"></i> Testar novamente</button>
                    </form>
                {% else %}
                    <p class="text-muted mb-3">Nenhuma chave configurada ainda. Cadastre-se gratuitamente em
                        <a href="https://datajud-wiki.cnj.jus.br/" target="_blank" rel="noopener">datajud-wiki.cnj.jus.br</a>
                        (aprovação em 1 a 5 dias úteis) e cole a chave abaixo.</p>
                {% endif %}
                <form method="post" action="{{ path('app_juridico_tribunais_configurar') }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('juridico_tribunal_config') }}">
                    <label class="form-label small">Chave de API (APIKey)</label>
                    <div class="d-flex gap-2">
                        <input type="text" name="datajud_api_key" class="form-control form-control-sm" placeholder="Cole a chave do DataJud aqui" autocomplete="off">
                        <button type="submit" class="btn-unio btn-sm text-nowrap"><i class="fas fa-save mr-1" aria-hidden="true"></i> Salvar</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Consultar processo', subtitle: 'Número no padrão CNJ (NNNNNNN-DD.AAAA.J.TR.OOOO)' } %}
            <div class="px-3 pb-3">
                <div class="d-flex gap-2 mb-3">
                    <input type="text" id="jurDatajudNumero" class="form-control form-control-sm" placeholder="0000000-00.0000.0.00.0000">
                    <button type="button" id="jurDatajudBtn" class="btn-unio btn-sm text-nowrap"><i class="fas fa-magnifying-glass mr-1" aria-hidden="true"></i> Consultar</button>
                </div>
                <div id="jurDatajudResultado" class="jur-datajud-resultado" aria-live="polite"></div>
            </div>
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/juridico-datajud.js') }}?v=1" defer
        data-consultar-url="{{ path('app_juridico_tribunais_consultar') }}"
        data-csrf="{{ csrf_token('juridico_datajud_ajax') }}"></script>
{% endblock %}
