{% extends 'layout/page_list.html.twig' %}
{% block title %}Portal do Cliente · Unio Jurídico{% endblock %}
{% set page_list_title = 'Portal do Cliente' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-globe" aria-hidden="true"></i> Relacionamento · Transparência</span>
        <h2 class="jur-proc-hero__title">
            {% if is_cliente_portal %}
                Olá, {{ cliente.nome|split(' ')|first }}!
            {% else %}
                Portal do Cliente
            {% endif %}
        </h2>
        <p class="jur-proc-hero__text">
            {% if is_cliente_portal %}
                Acompanhe seus processos, prazos e documentos compartilhados pelo escritório.
            {% elseif metricas.convites_pendentes|default(0) > 0 %}
                <strong>{{ metricas.convites_pendentes }}</strong> convite{{ metricas.convites_pendentes > 1 ? 's' : '' }} aguardando aceite · <strong>{{ metricas.clientes_portal|default(0) }}</strong> cliente{{ metricas.clientes_portal|default(0) != 1 ? 's' : '' }} com acesso ativo.
            {% else %}
                Gere convites em CRM Clientes — <strong>{{ metricas.clientes_portal|default(0) }}</strong> cliente{{ metricas.clientes_portal|default(0) != 1 ? 's' : '' }} com portal ativo.
            {% endif %}
        </p>
    </div>
</section>
{% if not is_cliente_portal %}
{% include 'components/kpi_row.html.twig' with { items: [
    { value: metricas.clientes_portal|default(0), label: 'Clientes ativos', sub: 'Portal vinculado', icon: 'fa-user-check', tone: 'sage' },
    { value: metricas.convites_pendentes|default(0), label: 'Convites pendentes', sub: 'Aguardando login', icon: 'fa-link', tone: metricas.convites_pendentes|default(0) > 0 ? 'amber' : 'lavender' },
    { value: metricas.docs_compartilhados|default(0), label: 'Docs compartilhados', sub: 'Visíveis no portal', icon: 'fa-file-alt', tone: 'sky' },
] } %}
{% endif %}
{% endblock %}

{% block page_list_content %}
{% if not is_cliente_portal %}
<div class="unio-card mb-4">
    <div class="p-4">
        <h5 class="mb-2"><i class="fas fa-link mr-2" aria-hidden="true"></i> Como ativar o portal</h5>
        <p class="text-muted mb-0">Abra um cliente em <a href="{{ path('app_juridico_clientes') }}">CRM Clientes</a> e clique em <strong>Gerar convite do portal</strong>. O cliente recebe um link válido por 30 dias.</p>
    </div>
</div>
{% else %}
<div class="jur-ops-split">
    <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Timeline', subtitle: 'Andamentos em linguagem simples' } %}
            {% if timeline is empty %}
            <p class="jur-empty-inline">Nenhuma atualização recente nos seus processos.</p>
            {% else %}
            <ul class="jur-timeline jur-timeline--inset">
                {% for ev in timeline %}
                <li class="jur-timeline__item">
                    <span class="jur-timeline__dot jur-timeline__dot--{{ ev.tom|default('muted') }}">
                        <i class="fas {{ ev.icone }}" aria-hidden="true"></i>
                    </span>
                    <div>
                        <span class="jur-timeline__title">{{ ev.titulo }}</span>
                        <p class="jur-timeline__text">{{ ev.texto }}</p>
                        <span class="jur-timeline__when">{{ ev.data|date('d/m/Y') }}</span>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
    </div>
    <div>
        <div class="unio-card mb-4">
            {% include 'components/section_header.html.twig' with { title: 'Seus processos' } %}
            {% if processos is empty %}
            <p class="jur-empty-inline">Nenhum processo vinculado.</p>
            {% else %}
            <ul class="jur-ops-list">
                {% for p in processos %}
                <li class="jur-ops-list__item">
                    <div class="jur-ops-list__main"><code>{{ p.numero }}</code></div>
                    <span class="jur-status jur-status--{{ p.status == 'critico' ? 'aberto' : 'agendada' }}">{{ p.fase|capitalize }}</span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Documentos compartilhados' } %}
            {% if documentos is empty %}
            <p class="jur-empty-inline">Nenhum documento disponível no portal.</p>
            {% else %}
            <ul class="jur-ops-list">
                {% for d in documentos %}
                <li class="jur-ops-list__item">
                    <div class="jur-ops-list__main"><i class="fas fa-file-alt mr-1" aria-hidden="true"></i> {{ d.nome }}</div>
                    <a href="{{ path('app_juridico_documento_download', { id: d.id }) }}" class="btn-unio-ghost btn-sm">Baixar</a>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
