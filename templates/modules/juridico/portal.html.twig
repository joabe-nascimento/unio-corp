{% extends 'layout/page_list.html.twig' %}
{% block title %}Portal do Cliente · Unio Jurídico{% endblock %}
{% set page_list_title = 'Portal do Cliente' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-globe" aria-hidden="true"></i> Relacionamento · Transparência</span>
        <h2 class="jur-proc-hero__title">
            {% if is_cliente_portal %}
                Olá, {{ cliente.nome|split(' ')|first }}!
            {% else %}
                Portal do Cliente
            {% endif %}
        </h2>
        <p class="jur-proc-hero__text">
            {% if is_cliente_portal %}
                Acompanhe seus processos, prazos e documentos compartilhados pelo escritório.
            {% else %}
                Gere convites em CRM Clientes para dar acesso seguro aos seus clientes.
            {% endif %}
        </p>
    </div>
</section>
{% endblock %}

{% block page_list_content %}
{% if not is_cliente_portal %}
<div class="unio-card mb-4">
    <div class="p-4">
        <h5 class="mb-2"><i class="fas fa-link mr-2" aria-hidden="true"></i> Como ativar o portal</h5>
        <p class="text-muted mb-0">Abra um cliente em <a href="{{ path('app_juridico_clientes') }}">CRM Clientes</a> e clique em <strong>Gerar convite do portal</strong>. O cliente recebe um link válido por 30 dias.</p>
    </div>
</div>
{% else %}
<div class="row g-4">
    <div class="col-xl-7">
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Timeline', subtitle: 'Andamentos em linguagem simples' } %}
            {% if timeline is empty %}
            <p class="text-muted px-3 pb-3">Nenhuma atualização recente nos seus processos.</p>
            {% else %}
            <ul class="list-unstyled px-3 pb-3 mb-0">
                {% for ev in timeline %}
                <li class="d-flex gap-3 mb-3 pb-3 border-bottom">
                    <span class="text-{{ ev.tom == 'danger' ? 'danger' : (ev.tom == 'warning' ? 'warning' : 'muted') }}">
                        <i class="fas {{ ev.icone }}" aria-hidden="true"></i>
                    </span>
                    <div>
                        <strong>{{ ev.titulo }}</strong>
                        <p class="text-muted mb-0 small">{{ ev.texto }}</p>
                        <small class="text-muted">{{ ev.data|date('d/m/Y') }}</small>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
    <div class="col-xl-5">
        <div class="unio-card mb-4">
            {% include 'components/section_header.html.twig' with { title: 'Seus processos' } %}
            {% if processos is empty %}
            <p class="text-muted px-3 pb-3">Nenhum processo vinculado.</p>
            {% else %}
            <ul class="list-unstyled px-3 pb-3 mb-0">
                {% for p in processos %}
                <li class="mb-2">
                    <code>{{ p.numero }}</code>
                    <span class="badge badge-{{ p.status == 'critico' ? 'danger' : 'info' }} ml-1">{{ p.fase|capitalize }}</span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Documentos compartilhados' } %}
            {% if documentos is empty %}
            <p class="text-muted px-3 pb-3">Nenhum documento disponível no portal.</p>
            {% else %}
            <ul class="list-unstyled px-3 pb-3 mb-0">
                {% for d in documentos %}
                <li class="mb-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-file-lines mr-1" aria-hidden="true"></i> {{ d.nome }}</span>
                    <a href="{{ path('app_juridico_documento_download', { id: d.id }) }}" class="btn-unio-ghost btn-sm">Baixar</a>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
