{% extends 'layout/page_list.html.twig' %}
{% block title %}Conflito de interesses · Unio Jurídico{% endblock %}
{% set page_list_title = 'Conflito de interesses' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-user-times" aria-hidden="true"></i> Governança · Ética</span>
        <h2 class="jur-proc-hero__title">Conflito de interesses</h2>
        <p class="jur-proc-hero__text">Cruze o nome da parte com clientes e polos da carteira antes de aceitar o caso.</p>
    </div>
</section>
{% include 'components/kpi_row.html.twig' with { items: [
    { value: metricas.verificacoes|default(0), label: 'Verificações', sub: 'Histórico do escritório', icon: 'fa-search', tone: 'sky' },
    { value: metricas.alertas|default(0), label: 'Alertas', sub: metricas.alertas|default(0) > 0 ? 'Revisar agora' : 'Nenhum bloqueio', icon: 'fa-ban', tone: metricas.alertas|default(0) > 0 ? 'rose' : 'sage' },
] } %}
{% endblock %}

{% block page_list_toolbar_actions %}
<a href="{{ path('app_juridico_modulo', { slug: 'conflitos' }) }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-th-large mr-1" aria-hidden="true"></i> Sobre o módulo
</a>
{% endblock %}

{% block page_list_content %}
<div class="jur-ops-split">
    <div class="unio-card">
        {% include 'components/section_header.html.twig' with { title: 'Verificar nome', subtitle: 'Cliente, parte adversa ou lead' } %}
        <form method="post" class="jur-ops-form">
            <input type="hidden" name="_token" value="{{ csrf_token('juridico_conflito_form') }}">
            <label class="form-label">Nome completo</label>
            <input type="text" name="nome" class="form-control" required placeholder="Nome completo">
            <button type="submit" class="btn-unio">Verificar</button>
        </form>
        {% if resultado %}
        <div class="jur-ops-form">
            <span class="jur-status jur-status--{{ resultado.resultado }}">{{ resultado.resultado }}</span>
            {% if resultado.matches is empty %}
            <p class="jur-empty-inline" style="padding: 0.75rem 0 0;">Nenhum conflito encontrado na carteira.</p>
            {% else %}
            <ul class="mt-2 mb-0 pl-3 small">
                {% for m in resultado.matches %}
                <li><strong>{{ m.nome }}</strong> — {{ m.detalhe }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endif %}
    </div>
    <div class="unio-card">
        {% include 'components/section_header.html.twig' with { title: 'Histórico', subtitle: 'Consultas recentes' } %}
        {% if historico is empty %}
        <p class="jur-empty-inline">As verificações aparecerão aqui.</p>
        {% else %}
        <ul class="jur-ops-list">
            {% for h in historico %}
            <li class="jur-ops-list__item">
                <div class="jur-ops-list__main">
                    <strong>{{ h.nomeConsultado }}</strong>
                    {% if h.criadoEm is defined %}
                    <div class="jur-ops-list__meta">{{ h.criadoEm|date('d/m/Y H:i') }}</div>
                    {% endif %}
                </div>
                <span class="jur-status jur-status--{{ h.resultado }}">{{ h.resultado }}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
