{% extends 'layout/page_list.html.twig' %}
{% block title %}Compliance OAB & LGPD · Unio Jurídico{% endblock %}
{% set page_list_title = 'Compliance' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-shield-alt" aria-hidden="true"></i> Governança · Privacidade</span>
        <h2 class="jur-proc-hero__title">Compliance OAB & LGPD</h2>
        <p class="jur-proc-hero__text">Registre incidentes, redija dados pessoais antes de enviar à IA e mantenha trilha auditável.</p>
    </div>
</section>
{% include 'components/kpi_row.html.twig' with { items: [
    { value: metricas.abertos|default(0), label: 'Abertos', sub: metricas.abertos|default(0) > 0 ? 'Em tratamento' : 'Nada pendente', icon: 'fa-exclamation-triangle', tone: metricas.abertos|default(0) > 0 ? 'rose' : 'sage' },
    { value: metricas.total|default(0), label: 'Incidentes', sub: 'Na trilha', icon: 'fa-clipboard-check', tone: 'sky' },
] } %}
{% endblock %}

{% block page_list_toolbar_actions %}
<a href="{{ path('app_juridico_modulo', { slug: 'compliance' }) }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-th-large mr-1" aria-hidden="true"></i> Sobre o módulo
</a>
{% endblock %}

{% block page_list_content %}
<div class="jur-ops-split">
    <div>
        <div class="unio-card mb-4">
            {% include 'components/section_header.html.twig' with { title: 'Novo incidente', subtitle: 'LGPD, ética OAB ou acesso' } %}
            <form method="post" class="jur-ops-form">
                <input type="hidden" name="_token" value="{{ csrf_token('juridico_compliance_form') }}">
                <label class="form-label">Título</label>
                <input type="text" name="titulo" class="form-control" required placeholder="Resumo do incidente">
                <label class="form-label">Categoria</label>
                <select name="categoria" class="form-control">
                    <option value="lgpd">LGPD</option>
                    <option value="etica_oab">Ética OAB</option>
                    <option value="acesso">Acesso indevido</option>
                </select>
                <label class="form-label">Descrição</label>
                <textarea name="descricao" class="form-control" rows="3" placeholder="O que aconteceu, quem foi afetado e a ação imediata"></textarea>
                <button class="btn-unio" type="submit">Registrar</button>
            </form>
        </div>
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Redação de PII', subtitle: 'Teste o guardrail antes de colar no chat' } %}
            <form method="post" class="jur-ops-form">
                <input type="hidden" name="_token" value="{{ csrf_token('juridico_compliance_redact') }}">
                <label class="form-label">Trecho</label>
                <textarea name="texto_redact" class="form-control" rows="4" placeholder="Cole um trecho com CPF, e-mail ou telefone"></textarea>
                <button class="btn-unio-ghost" type="submit">Redigir</button>
            </form>
            {% if redacted %}
            <pre class="jur-pre">{{ redacted }}</pre>
            {% endif %}
        </div>
    </div>
    <div class="unio-card">
        {% include 'components/section_header.html.twig' with { title: 'Incidentes', subtitle: 'Trilha do escritório' } %}
        {% if incidentes is empty %}
        <p class="jur-empty-inline">Nenhum incidente registrado.</p>
        {% else %}
        <ul class="jur-ops-list">
            {% for i in incidentes %}
            <li class="jur-ops-list__item">
                <div class="jur-ops-list__main">
                    <strong>{{ i.titulo }}</strong>
                    <div class="jur-ops-list__meta">{{ i.categoria|replace({'_': ' '}) }} · {{ i.criadoEm|date('d/m/Y') }}</div>
                    {% if i.status != 'resolvido' %}
                    <form method="post" action="{{ path('app_juridico_compliance_resolver', { id: i.id }) }}" class="mt-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('juridico_compliance_resolver_' ~ i.id) }}">
                        <button class="btn-unio-ghost btn-sm" type="submit">Marcar resolvido</button>
                    </form>
                    {% endif %}
                </div>
                <span class="jur-status jur-status--{{ i.status == 'resolvido' ? 'resolvido' : 'aberto' }}">{{ i.status }}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
