{% extends 'layout/page_list.html.twig' %}
{% block title %}Compliance OAB & LGPD · Unio Jurídico{% endblock %}
{% set page_list_title = 'Compliance' %}

{% block page_list_kpis %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-shield-halved" aria-hidden="true"></i> Governança · Privacidade</span>
        <h2 class="jur-proc-hero__title">Compliance OAB & LGPD</h2>
        <p class="jur-proc-hero__text">Registre incidentes, redija PII antes de enviar à IA e mantenha trilha auditável.</p>
    </div>
</section>
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: metricas.abertos|default(0), label: 'Abertos', icon: 'fa-triangle-exclamation', tone: metricas.abertos|default(0) > 0 ? 'rose' : 'sage' },
        { value: metricas.total|default(0), label: 'Incidentes', icon: 'fa-clipboard-check', tone: 'sky' },
    ] } %}
</div>
{% endblock %}

{% block page_list_content %}
<div class="row g-4">
    <div class="col-lg-6">
        <div class="unio-card mb-4">
            {% include 'components/section_header.html.twig' with { title: 'Novo incidente' } %}
            <form method="post" class="px-3 pb-3">
                <input type="hidden" name="_token" value="{{ csrf_token('juridico_compliance_form') }}">
                <input type="text" name="titulo" class="form-control mb-2" required placeholder="Título">
                <select name="categoria" class="form-control mb-2">
                    <option value="lgpd">LGPD</option>
                    <option value="etica_oab">Ética OAB</option>
                    <option value="acesso">Acesso indevido</option>
                </select>
                <textarea name="descricao" class="form-control mb-3" rows="3" placeholder="Descrição"></textarea>
                <button class="btn-unio" type="submit">Registrar</button>
            </form>
        </div>
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Redação de PII', subtitle: 'Teste o guardrail antes de colar no chat' } %}
            <form method="post" class="px-3 pb-3">
                <input type="hidden" name="_token" value="{{ csrf_token('juridico_compliance_redact') }}">
                <textarea name="texto_redact" class="form-control mb-2" rows="4" placeholder="Cole um trecho com CPF, e-mail ou telefone"></textarea>
                <button class="btn-unio-ghost" type="submit">Redigir</button>
            </form>
            {% if redacted %}
            <pre class="px-3 pb-3 small" style="white-space:pre-wrap;">{{ redacted }}</pre>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-6">
        <div class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Incidentes' } %}
            {% if incidentes is empty %}
            <p class="text-muted px-3 pb-3">Nenhum incidente aberto.</p>
            {% else %}
            <ul class="list-unstyled px-3 pb-3 mb-0">
                {% for i in incidentes %}
                <li class="border-bottom py-2">
                    <strong>{{ i.titulo }}</strong>
                    <span class="badge badge-{{ i.status == 'resolvido' ? 'success' : 'warning' }}">{{ i.status }}</span>
                    <div class="small text-muted">{{ i.categoria }} · {{ i.criadoEm|date('d/m/Y') }}</div>
                    {% if i.status != 'resolvido' %}
                    <form method="post" action="{{ path('app_juridico_compliance_resolver', { id: i.id }) }}" class="mt-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('juridico_compliance_resolver_' ~ i.id) }}">
                        <button class="btn-unio-ghost btn-sm" type="submit">Marcar resolvido</button>
                    </form>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
