{% extends 'layout/page_list.html.twig' %}
{% block title %}Processos · Unio Jurídico{% endblock %}
{% set page_list_title = 'Processos' %}

{% block page_list_kpis %}
{% set _first_name = app.user.nome|default('')|split(' ')|first %}
<section class="jur-proc-hero" style="--jur-proc-hero-img: url('{{ asset('images/marketing/hero-juridico.jpg') }}');">
    <div class="jur-proc-hero__content">
        <span class="jur-proc-hero__eyebrow"><i class="fas fa-scale-balanced" aria-hidden="true"></i> Contencioso · Painel do escritório</span>
        <h2 class="jur-proc-hero__title">{{ _first_name ? 'Olá, ' ~ _first_name ~ '!' : 'Painel de processos' }}</h2>
        <p class="jur-proc-hero__text">
            {% if stats.total|default(0) == 0 %}
                Cadastre o primeiro processo do escritório para acompanhar fases, valores e prazos em um só lugar.
            {% elseif stats.criticos|default(0) > 0 %}
                Você tem <strong>{{ stats.criticos }}</strong> processo{{ stats.criticos > 1 ? 's' : '' }} crítico{{ stats.criticos > 1 ? 's' : '' }} pedindo atenção agora, de uma carteira com <strong>{{ stats.total }}</strong> processo{{ stats.total != 1 ? 's' : '' }} no total.
            {% else %}
                Nenhum processo crítico no momento — sua carteira com <strong>{{ stats.total }}</strong> processo{{ stats.total != 1 ? 's' : '' }} está sob controle.
            {% endif %}
        </p>
        <div class="jur-proc-hero__actions">
            <button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="juridico-processo-novo">
                <i class="fas fa-plus mr-1" aria-hidden="true"></i> Novo processo
            </button>
            <button type="button" class="btn-unio-ghost btn-sm jur-proc-hero__ghost js-helix-prompt" data-helix-prompt="Analise a saúde da minha carteira de processos e sugira prioridades para esta semana.">
                <i class="fas fa-robot mr-1" aria-hidden="true"></i> Perguntar à Sasha
            </button>
        </div>
    </div>
</section>
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        {
            value: stats.ativos|default(0),
            label: 'Processos ativos',
            sub: 'Em andamento',
            icon: 'fa-folder-open',
            tone: 'sky',
            route: 'app_juridico_processos',
            route_params: { status: 'ativo' },
        },
        {
            value: stats.criticos|default(0),
            label: 'Críticos',
            sub: stats.criticos|default(0) > 0 ? 'Precisam de atenção' : 'Tudo sob controle',
            icon: 'fa-triangle-exclamation',
            tone: stats.criticos|default(0) > 0 ? 'rose' : 'sage',
            pulse: stats.criticos|default(0) > 0,
            route: 'app_juridico_processos',
            route_params: { status: 'critico' },
        },
        {
            value: 'R$ ' ~ stats.valorAtivo|default(0)|number_format(2, ',', '.'),
            label: 'Valor em carteira',
            sub: 'Processos ativos',
            icon: 'fa-sack-dollar',
            tone: 'amber',
        },
        {
            value: stats.taxaExito is defined and stats.taxaExito is not null ? stats.taxaExito|number_format(1, ',', '.') ~ '%' : '—',
            label: 'Taxa de êxito',
            sub: 'Processos encerrados',
            icon: 'fa-chart-line',
            tone: 'lavender',
        },
    ] } %}
</div>
{% endblock %}

{% block page_list_toolbar_actions %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="juridico-processo-novo">
    <i class="fas fa-plus mr-1" aria-hidden="true"></i> Novo processo
</button>
<a href="{{ path('app_juridico_modulo', { slug: 'processos' }) }}" class="btn-unio-ghost btn-sm">
    <i class="fas fa-th-large mr-1" aria-hidden="true"></i> Sobre o módulo
</a>
{% endblock %}

{% block page_list_section_toolbar %}
<form method="get" action="{{ path('app_juridico_processos') }}" style="display:contents;">
{% embed 'components/section_toolbar.html.twig' with {
    search_in_section: true,
    search_placeholder: 'Buscar número, cliente ou área…',
    search_name: 'q',
    search_value: filter_q|default('')
} %}
    {% block section_toolbar_filters %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Status',
            name: 'status',
            value: filter_status|default(''),
            min_width: '140px',
            options: [
                { value: '', label: 'Todos' },
                { value: 'ativo', label: 'Ativo' },
                { value: 'critico', label: 'Crítico' },
                { value: 'encerrado', label: 'Encerrado' },
            ]
        } %}
        {% include 'components/toolbar_filter_actions.html.twig' with {
            clear_href: path('app_juridico_processos'),
            has_filters: filter_q|default('') or filter_status|default('')
        } %}
    {% endblock %}
{% endembed %}
</form>
{% endblock %}

{% block page_list_content %}
{% include 'components/juridico/alertas_risco_panel.html.twig' with { alertas: alertas|default([]), limit: 5 } %}

{% set _view_params = { status: filter_status|default(''), q: filter_q|default('') } %}
<div class="jur-view-tabs" data-view-toggle data-view-url="{{ path('app_juridico_processos', _view_params) }}">
    <button type="button" class="jur-view-tab{{ view == 'kanban' ? '' : ' is-active' }}" data-view-btn="lista">
        <i class="fas fa-list mr-1" aria-hidden="true"></i> Lista
    </button>
    <button type="button" class="jur-view-tab{{ view == 'kanban' ? ' is-active' : '' }}" data-view-btn="kanban">
        <i class="fas fa-table-columns mr-1" aria-hidden="true"></i> Kanban de fases
    </button>
</div>

<div data-view-panel="kanban" class="{{ view == 'kanban' ? '' : 'd-none' }}">
    {% include 'components/juridico/processos_kanban.html.twig' with { kanban_colunas: kanban_colunas, fases: fases } %}
</div>
<div data-view-panel="lista" class="{{ view == 'kanban' ? 'd-none' : '' }}">
<div class="unio-card">
    {% if processos is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-scale-balanced',
            title: 'Nenhum processo cadastrado',
            text: filter_q|default('') or filter_status|default('') ? 'Nenhum resultado para os filtros aplicados.' : 'Cadastre o primeiro processo do escritório.',
            btn_label: 'Novo processo',
            btn_opens: 'juridico-processo-novo',
            btn_icon: 'fa-plus'
        } %}
    {% else %}
    {% set _criticos = 0 %}
    {% for p in processos %}{% if p.status == 'critico' %}{% set _criticos = _criticos + 1 %}{% endif %}{% endfor %}
    {% include 'components/juridico/table_meta_bar.html.twig' with {
        count: processos|length,
        label_singular: 'processo encontrado',
        label_plural: 'processos encontrados',
        extra_html: _criticos > 0 ? '<span class="jur-table-meta-highlight"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> ' ~ _criticos ~ ' crítico(s)</span>' : ''
    } %}
    <div class="table-responsive">
        <table class="table table-unio table-hover mb-0">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Área</th>
                    <th>Fase</th>
                    <th>Responsável</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th class="text-right">Ação</th>
                </tr>
            </thead>
            <tbody>
                {% for p in processos %}
                <tr>
                    <td><code class="text-muted" style="font-size: 0.85rem;">{{ p.numero }}</code></td>
                    <td>{{ p.cliente ? p.cliente.nome : '—' }}</td>
                    <td>{% if p.area %}<span class="badge badge-soft-primary">{{ p.area }}</span>{% else %}—{% endif %}</td>
                    <td>{{ p.fase|capitalize }}</td>
                    <td>{{ p.responsavel ? p.responsavel.nome : '—' }}</td>
                    <td>{{ p.valor ? 'R$ ' ~ p.valor|number_format(2, ',', '.') : '—' }}</td>
                    <td>
                        {% if p.status == 'critico' %}
                        <span class="badge badge-danger">Crítico</span>
                        {% elseif p.status == 'encerrado' %}
                        <span class="badge badge-secondary">Encerrado</span>
                        {% else %}
                        <span class="badge badge-success">Ativo</span>
                        {% endif %}
                    </td>
                    <td class="text-right">
                        <a href="{{ path('app_juridico_processo_show', { id: p.id }) }}" class="btn-unio-ghost btn-sm">
                            <i class="fas fa-arrow-right mr-1" aria-hidden="true"></i>Abrir
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
</div>
{% endblock %}

{% block page_overlays %}
{% include 'components/juridico/processo_offcanvas.html.twig' with {
    id: 'juridico-processo-novo',
    clientes: clientes,
    responsaveis: responsaveis,
    form_id: 'juridicoProcessoNovoForm',
    form_action: path('app_juridico_processo_novo'),
    open: open_novo|default(false)
} %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/unio-processos-kanban.js') }}?v=2" defer></script>
{% endblock %}
