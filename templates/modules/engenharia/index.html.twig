{% extends 'layout/hub.html.twig' %}
{% block title %}Obras e Projetos{% endblock %}
{% block permissions_scope %}product_engenharia{% endblock %}
{% set hub_page_title = 'Obras e Projetos' %}
{% set hub_page_subtitle = 'Preview · em desenvolvimento' %}
{% set eng_items = [
    { icon:'fa-building',        title:'Projetos e Obras',      subtitle:'Cadastro e status das obras',       product:'projetos' },
    { icon:'fa-calendar-days',   title:'Cronograma',            subtitle:'Marcos, entregas e prazos',         product:'cronograma' },
    { icon:'fa-calculator',      title:'Orçamentos',            subtitle:'Custos, medições e aditivos',       product:'orcamentos' },
    { icon:'fa-hard-hat',        title:'Equipes de Campo',      subtitle:'Alocação e produtividade',          product:'equipes' },
    { icon:'fa-file-lines',      title:'Documentação Técnica',  subtitle:'Plantas, ART e relatórios',         product:'projetos' },
    { icon:'fa-clipboard-check', title:'Normas e Conformidade', subtitle:'NBRs, licenças e inspeções',        product:'projetos' },
] %}
{% set eng_visible_items = [] %}
{% for item in eng_items %}
    {% if product_grant('product_engenharia', item.product) %}
        {% set eng_visible_items = eng_visible_items|merge([item|merge({ preview: true })]) %}
    {% endif %}
{% endfor %}
{% block hub_content %}
{% if eng_visible_items|length > 0 %}
<div class="alert alert-info unio-alert mb-4" role="status">
    <i class="fas fa-circle-info mr-2" aria-hidden="true"></i>
    <strong>Núcleo em preview.</strong> As áreas abaixo estão planejadas; você verá funcionalidades conforme forem liberadas.
</div>
{% include 'components/module_grid.html.twig' with {
    title: 'Funções do módulo',
    subtitle: 'Gestão de obras, prazos, custos e conformidade técnica',
    items: eng_visible_items
} %}
{% else %}
    {% include 'components/hub_scope_empty.html.twig' with {
        icon: 'fa-hard-hat',
        title: 'Nenhuma área disponível em Engenharia',
        text: 'Você ainda não tem permissão para acessar Projetos, Cronograma ou outras áreas deste módulo. Solicite ao gestor da equipe.'
    } %}
{% endif %}
{% endblock %}
