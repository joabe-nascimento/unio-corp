{% extends 'base.html.twig' %}
{% block title %}Hub de Talentos{% endblock %}
{% block page_title %}Hub de Talentos{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Hub de Talentos</li>{% endblock %}
{% block content %}

{% include 'components/kpi_row.html.twig' with { items: [
    { value: '0', label: 'Banco de Talentos', sub: 'Cadastrados' },
    { value: '0', label: 'Vagas Abertas',     sub: 'Disponíveis' },
    { value: '0', label: 'Trilhas Ativas',    sub: 'Em progresso' },
    { value: '0', label: 'Mentorias Ativas',  sub: 'Em andamento' },
] } %}

<div class="row">
    <div class="col-md-6 mb-4 d-flex">
        <div class="huplex-card flex-fill">
            {% include 'components/section_header.html.twig' with {
                title: 'Banco de Talentos',
                subtitle: 'Profissionais identificados para crescimento',
                btn_label: 'Gerenciar',
                btn_href: path('app_talentos_banco'),
                btn_ghost: true
            } %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-star',
                title: 'Banco de talentos vazio',
                text: 'Identifique talentos a partir das avaliações de desempenho.',
                compact: true
            } %}
        </div>
    </div>
    <div class="col-md-6 mb-4 d-flex">
        <div class="huplex-card flex-fill">
            {% include 'components/section_header.html.twig' with {
                title: 'Trilhas de Carreira',
                subtitle: 'Planos de desenvolvimento individuais',
                btn_label: 'Nova Trilha',
                btn_href: path('app_talentos_trilhas'),
                btn_ghost: true
            } %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-route',
                title: 'Nenhuma trilha criada',
                text: 'Crie trilhas de carreira personalizadas para cada cargo.',
                compact: true
            } %}
        </div>
    </div>
</div>
{% endblock %}
