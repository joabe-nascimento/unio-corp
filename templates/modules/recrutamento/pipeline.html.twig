{% extends 'layout/hub.html.twig' %}
{% block title %}Pipeline de Seleção{% endblock %}
{% block permissions_scope %}hub_recrutamento{% endblock %}
{% set hub_page_title = 'Pipeline de Seleção' %}
{% set hub_page_subtitle = 'Núcleo de Recrutamento · Funil de seleção' %}
{% set can_view_pipeline = recrutamento_grant('pipeline') %}

{% set vaga_filter_options = [{ value: '', label: 'Todas as vagas' }] %}
{% for v in vagas %}
    {% set vaga_filter_options = vaga_filter_options|merge([{ value: v.id ~ '', label: v.titulo }]) %}
{% endfor %}

{% block hub_kpis %}
{% set total_ativos = 0 %}
{% for stage in pipeline_stages %}
    {% if stage.id != 'REPROVADO' %}
        {% set total_ativos = total_ativos + pipeline_board[stage.id]|default([])|length %}
    {% endif %}
{% endfor %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: total_ativos, label: 'No funil', sub: 'Candidatos ativos', kpi_key: 'funil' },
        { value: pipeline_board['TRIAGEM']|default([])|length, label: 'Triagem', sub: 'Aguardando análise', kpi_key: 'TRIAGEM' },
        { value: pipeline_board['ENTREVISTA']|default([])|length, label: 'Entrevista', sub: 'Em conversa', kpi_key: 'ENTREVISTA' },
        { value: pipeline_board['PROPOSTA']|default([])|length, label: 'Proposta', sub: 'Negociação', kpi_key: 'PROPOSTA' },
        { value: pipeline_board['CONTRATADO']|default([])|length, label: 'Contratados', sub: 'Prontos p/ admissão', kpi_key: 'CONTRATADO' },
        { value: pipeline_board['REPROVADO']|default([])|length, label: 'Reprovados', sub: 'Fora do funil', kpi_key: 'REPROVADO' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block hub_section_toolbar %}
<form method="get" action="{{ path('app_recrutamento_pipeline') }}" style="display:contents">
{% embed 'components/section_toolbar.html.twig' with {
    btn_label: '',
    search_in_section: true,
    search_placeholder: 'Buscar candidato…',
    search_name: 'q',
    search_value: filter_q|default('')
} %}
    {% block section_toolbar_filters %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Vaga',
            show_label: true,
            name: 'vaga',
            id: 'pipeline-vaga',
            min_width: '220px',
            group_class: 'mb-0',
            value: filter_vaga_id ? filter_vaga_id ~ '' : '',
            options: vaga_filter_options,
            select_attrs: { onchange: 'this.form.submit()' }
        } %}
        <div class="section-toolbar-actions">
            {% include 'components/toolbar_filter_actions.html.twig' with {
                clear_href: path('app_recrutamento_pipeline'),
                has_filters: has_filters|default(false),
                show_submit: false
            } %}
            {% if can_view_pipeline %}
            <a href="{{ path('app_recrutamento_candidatos') }}" class="btn-unio-ghost btn-sm">
                <i class="fas fa-users mr-1" aria-hidden="true"></i> Candidatos
            </a>
            <a href="{{ path('app_recrutamento_vagas') }}" class="btn-unio-ghost btn-sm">
                <i class="fas fa-briefcase mr-1" aria-hidden="true"></i> Vagas
            </a>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
</form>
{% endblock %}

{% block hub_content %}
<div class="recrutamento-shell">
{% if pipeline_total > 0 %}
<div class="unio-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Kanban do pipeline',
        subtitle: filter_vaga_id or filter_q|default('')
            ? 'Resultados filtrados — arraste ou use os botões para mover candidatos'
            : 'Arraste os cards entre colunas ou use os botões de ação'
    } %}
    <div class="recrutamento-pipeline-board-wrap">
        {% include 'components/recrutamento/pipeline_board.html.twig' with {
            pipeline_board: pipeline_board,
            pipeline_stages: pipeline_stages,
            filter_vaga_id: filter_vaga_id,
            filter_q: filter_q|default('')
        } %}
    </div>
</div>
{% else %}
<div class="unio-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Kanban do pipeline',
        subtitle: has_filters|default(false) ? 'Nenhum resultado com os filtros atuais' : 'Nenhum candidato no funil'
    } %}
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-diagram-project',
        title: has_filters|default(false) ? 'Nenhum candidato encontrado' : 'Pipeline vazio',
        text: has_filters|default(false)
            ? 'Ajuste os filtros ou adicione candidatos em Vagas.'
            : 'Adicione candidatos em Vagas para movimentá-los aqui.',
        btn_label: 'Ir para Vagas',
        btn_href: path('app_recrutamento_vagas'),
        compact: false
    } %}
</div>
{% endif %}
</div>
{% endblock %}

{% block page_overlays %}
{% if recrutamento_grant_at_least('pipeline', 'GESTOR_EQUIPE') or recrutamento_grant_at_least('product_rh', 'recrutamento', 'GESTOR_EQUIPE') %}
{% include 'components/recrutamento/candidato_reject_offcanvas.html.twig' %}
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% set can_manage_pipeline = recrutamento_grant_at_least('pipeline', 'GESTOR_EQUIPE')
    or recrutamento_grant_at_least('product_rh', 'recrutamento', 'GESTOR_EQUIPE') %}
{% if can_manage_pipeline %}
<script src="{{ asset('js/sortable.min.js') }}"></script>
{% endif %}
<script src="{{ asset('js/recrutamento-hub.js') }}"></script>
<script>
(function () {
    if (window.RecrutamentoHub && typeof window.RecrutamentoHub.initPipelineBoard === 'function') {
        window.RecrutamentoHub.initPipelineBoard();
    }
})();
</script>
{% endblock %}
