{% extends 'layout/hub.html.twig' %}
{% block title %}Marca e Comunicação{% endblock %}
{% block permissions_scope %}product_publicidade{% endblock %}
{% set hub_page_title = 'Marca e Comunicação' %}
{% set hub_page_subtitle = 'Preview · em desenvolvimento' %}
{% set pub_items = [
    { icon:'fa-bullhorn',          title:'Campanhas',         subtitle:'Planejamento e veiculação',           product:'campanhas' },
    { icon:'fa-building-columns',  title:'Clientes e Marcas', subtitle:'Contas e contratos',                  product:'clientes' },
    { icon:'fa-palette',           title:'Criativos',         subtitle:'Peças, revisões e aprovações',        product:'criativos' },
    { icon:'fa-tower-broadcast',   title:'Mídia e Canais',    subtitle:'TV, digital, OOH e mídia paga',       product:'campanhas' },
    { icon:'fa-lightbulb',         title:'Briefings',         subtitle:'Demandas e direcionamento criativo',  product:'campanhas' },
    { icon:'fa-chart-line',        title:'Métricas e ROI',    subtitle:'KPIs, alcance e conversão',           product:'metricas' },
] %}
{% set pub_visible_items = [] %}
{% for item in pub_items %}
    {% if product_grant('product_publicidade', item.product) %}
        {% set pub_visible_items = pub_visible_items|merge([item|merge({ preview: true })]) %}
    {% endif %}
{% endfor %}
{% block hub_content %}
{% if pub_visible_items|length > 0 %}
<div class="alert alert-info unio-alert mb-4" role="status">
    <i class="fas fa-circle-info mr-2" aria-hidden="true"></i>
    <strong>Núcleo em preview.</strong> Campanhas, criativos e métricas serão habilitados em versões futuras.
</div>
{% include 'components/module_grid.html.twig' with {
    title: 'Funções do módulo',
    subtitle: 'Campanhas, criativos, mídia e performance de marca',
    items: pub_visible_items
} %}
{% else %}
    {% include 'components/hub_scope_empty.html.twig' with {
        icon: 'fa-bullhorn',
        title: 'Nenhuma área disponível em Publicidade',
        text: 'Você ainda não tem permissão para acessar Campanhas, Criativos ou Métricas. Solicite ao gestor da equipe.'
    } %}
{% endif %}
{% endblock %}
