{% extends 'layout/hub.html.twig' %}
{% block title %}RH{% endblock %}
{% set hub_page_title = 'Recursos Humanos' %}
{% block hub_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: '3',  label: 'Admissões',  sub: 'Novas contratações', route: 'app_rh_admissoes' },
        { value: '8',  label: 'Férias',     sub: 'Em férias agora',    route: 'app_rh_ferias' },
        { value: '1',  label: 'Demissões',  sub: 'Em andamento',       route: 'app_rh_demissoes' },
        { value: 'OK', label: 'Folha',      sub: 'Mês atual',          route: 'app_rh_folha' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}
{% block hub_content %}
<div class="huplex-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Funcionários Recentes',
        subtitle: 'Últimas alterações no quadro',
        btn_label: 'Novo Funcionário',
        btn_href: path('app_rh_funcionarios'),
        btn_icon: 'fa-plus'
    } %}
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-users',
        title: 'Nenhum funcionário cadastrado',
        text: 'Comece cadastrando o primeiro funcionário da empresa.',
        btn_label: 'Cadastrar Funcionário',
        btn_href: path('app_rh_funcionarios')
    } %}
</div>
{% endblock %}
