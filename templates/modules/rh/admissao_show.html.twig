{% extends 'layout/page_list.html.twig' %}
{% block title %}Admissão — {{ process.nome }}{% endblock %}
{% set page_list_title = process.nome %}

{% block page_list_toolbar_actions %}
{% include 'components/page_back_link.html.twig' with {
    href: path('app_rh_admissoes'),
    label: 'Voltar às admissões'
} %}
{% endblock %}

{% block page_list_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: process.statusLabel, label: 'Status', sub: 'Processo de onboarding' },
        { value: process.checklistProgress ~ '%', label: 'Checklist', sub: 'Itens concluídos' },
        { value: process.dataPrevista ? process.dataPrevista|date('d/m/Y') : '—', label: 'Início previsto', sub: 'Data planejada' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block page_list_content %}
{% set colaborador_items = [
    { label: 'E-mail', value: process.email, icon: 'fa-envelope' },
    { label: 'Cargo', value: process.cargo|default('—'), icon: 'fa-briefcase' },
] %}
{% if process.observacoes %}
    {% set colaborador_items = colaborador_items|merge([{
        label: 'Observações',
        value: process.observacoes,
        icon: 'fa-note-sticky',
        multiline: true
    }]) %}
{% endif %}

{% set processo_items = [
    { label: 'Início previsto', value: process.dataPrevista ? process.dataPrevista|date('d/m/Y') : '—', icon: 'fa-calendar' },
    { label: 'Aberto em', value: process.criadoEm|date('d/m/Y'), icon: 'fa-clock' },
] %}
{% if process.funcionario %}
    {% set processo_items = processo_items|merge([{
        label: 'Funcionário',
        value: '<a href="' ~ path('app_rh_funcionarios') ~ '">#' ~ process.funcionario.id ~ ' — ver cadastro</a>',
        icon: 'fa-user-check',
        html: true
    }]) %}
{% endif %}
{% if process.dataConclusao %}
    {% set processo_items = processo_items|merge([{
        label: 'Concluído em',
        value: process.dataConclusao|date('d/m/Y'),
        icon: 'fa-flag-checkered'
    }]) %}
{% endif %}

{% include 'components/rh_process_detail.html.twig' with {
    documentos: documentos|default([]),
    process: process,
    variant: 'onboarding',
    checklist_title: 'Checklist de onboarding',
    complete_label: 'Concluir onboarding',
    confirm_message: 'Concluir onboarding e cadastrar o funcionário?',
    profile: {
        name: process.nome,
        subtitle: process.email,
        badge: process.statusLabel,
        badge_tone: process.status == 'CONCLUIDO' ? 'success' : 'info'
    },
    detail_sections: [
        { title: 'Colaborador', items: colaborador_items },
        { title: 'Processo', items: processo_items }
    ],
    hint: 'Hub <strong>Operações</strong> → RH → Admissões. Ao concluir, o colaborador é cadastrado como funcionário ativo na empresa.',
    documentos: documentos|default([])
} %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include 'components/rh_process_confirm_script.html.twig' %}
{% endblock %}
