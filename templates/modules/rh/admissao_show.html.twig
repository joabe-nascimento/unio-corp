{% extends 'layout/page_list.html.twig' %}
{% block title %}Admissão — {{ process.nome }}{% endblock %}
{% set page_list_title = process.nome %}

{% block page_list_toolbar_actions %}
<a href="{{ path('app_rh_admissoes') }}" class="btn-huplex-ghost btn-sm">
    <i class="fas fa-arrow-left"></i> Voltar
</a>
{% endblock %}

{% block page_list_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: process.statusLabel, label: 'Status', sub: 'Processo de onboarding' },
        { value: process.checklistProgress ~ '%', label: 'Checklist', sub: 'Itens concluídos' },
        { value: process.dataPrevista ? process.dataPrevista|date('d/m/Y') : '—', label: 'Início previsto', sub: 'Data planejada' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block page_list_content %}
<div class="row">
    <div class="col-lg-7 mb-3">
        <div class="huplex-card">
            <div class="section-title mb-3">Checklist de onboarding</div>
            {% include 'components/rh_process_checklist.html.twig' with { process: process } %}
            {% if process.status != 'CONCLUIDO' and grant_at_least('product_rh', 'admissoes', 'GESTOR_EQUIPE') %}
                <hr>
                <form method="post" onsubmit="return confirm('Concluir onboarding e cadastrar o funcionário?');">
                    <input type="hidden" name="action" value="complete">
                    <button type="submit" class="btn-huplex" {{ process.checklistProgress < 100 ? 'disabled title=\"Marque todos os itens do checklist\"' : '' }}>
                        Concluir onboarding
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-5 mb-3">
        <div class="huplex-card">
            <div class="section-title mb-3">Dados</div>
            <dl class="mb-0">
                <dt class="text-muted small">E-mail</dt>
                <dd>{{ process.email }}</dd>
                <dt class="text-muted small">Cargo</dt>
                <dd>{{ process.cargo|default('—') }}</dd>
                {% if process.observacoes %}
                <dt class="text-muted small">Observações</dt>
                <dd>{{ process.observacoes }}</dd>
                {% endif %}
                {% if process.funcionario %}
                <dt class="text-muted small">Funcionário criado</dt>
                <dd><a href="{{ path('app_rh_funcionarios') }}">#{{ process.funcionario.id }} — ver lista</a></dd>
                {% endif %}
                {% if process.dataConclusao %}
                <dt class="text-muted small">Concluído em</dt>
                <dd>{{ process.dataConclusao|date('d/m/Y') }}</dd>
                {% endif %}
            </dl>
        </div>
        <p class="text-muted small mt-2 mb-0">
            <i class="fas fa-map-marker-alt"></i>
            Hub <strong>Operações</strong> → RH → Admissões. Após conclusão, o colaborador entra como funcionário ativo.
        </p>
    </div>
</div>
{% endblock %}
