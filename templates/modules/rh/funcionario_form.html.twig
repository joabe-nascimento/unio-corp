{% extends 'layout/page_list.html.twig' %}
{% set f = funcionario|default(null) %}
{% set is_edit = f is not null %}
{% block title %}{{ is_edit ? 'Editar funcionário' : 'Novo funcionário' }}{% endblock %}
{% set page_list_title = is_edit ? 'Editar — ' ~ f.nome : 'Novo funcionário' %}

{% block page_list_content %}
<div class="rh-admissao-page rh-funcionario-form-page">
    <div class="rh-admissao-main unio-card">
        <header class="rh-admissao-main-head">
            <h2 class="rh-admissao-main-title">{{ is_edit ? 'Atualizar cadastro' : 'Cadastro completo' }}</h2>
            <p class="rh-admissao-main-sub">
                Preencha os dados do colaborador para folha, portal e processos de RH.
            </p>
        </header>

        <div class="rh-admissao-offcanvas-progress rh-admissao-offcanvas-progress--page mb-3" data-rh-form-progress>
            <div class="progress-unio" style="min-width: 120px; flex: 1;">
                <div class="progress-unio-bar progress-unio-bar--accent"
                     data-rh-form-progress-bar
                     style="width: 20%;"
                     role="progressbar"
                     aria-valuenow="20"
                     aria-valuemin="0"
                     aria-valuemax="100"></div>
            </div>
            <small class="progress-unio-label" data-rh-form-progress-pct>20%</small>
            <span class="rh-admissao-offcanvas-progress-label" data-rh-form-progress-label>Identificação · 1 de 5</span>
        </div>

        {% include 'components/rh/funcionario_form_body.html.twig' with {
            empresa: empresa,
            departamentos: departamentos|default([]),
            gestores: gestores|default([]),
            funcionario: f,
            form_data: form_data|default({}),
            form_id: 'rh-funcionario-form',
            form_action: is_edit ? path('app_rh_funcionario_editar', { id: f.id }) : path('app_rh_funcionario_novo'),
            is_edit: is_edit,
            layout: 'page'
        } %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/rh-funcionario-form.js') }}?v=6"></script>
{% endblock %}
