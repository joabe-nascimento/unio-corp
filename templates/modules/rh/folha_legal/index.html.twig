{% extends 'layout/hub.html.twig' %}
{% block title %}Folha legal{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Folha legal' %}

{% block hub_content %}
<div class="d-flex gap-2 mb-3 flex-wrap">
    {% if grant_at_least('product_rh', 'folha_legal', 'GESTOR') %}
    <form method="post" action="{{ path('app_rh_folha_legal') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_folha_legal_seed') }}">
        <input type="hidden" name="action" value="seed_rubricas">
        <button type="submit" class="btn-unio-ghost btn-sm">Rubricas padrão</button>
    </form>
    {% endif %}
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="unio-card p-4">
            {% include 'components/section_header.html.twig' with { title: 'Rubricas' } %}
            {% if rubricas is empty %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'fa-list',
                    title: 'Nenhuma rubrica cadastrada.',
                    compact: true
                } %}
            {% else %}
            <ul class="list-unstyled mb-0">
                {% for r in rubricas %}
                <li class="mb-1"><code>{{ r.codigo }}</code> — {{ r.descricao }} ({{ r.tipo }})</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-7">
        <div class="unio-card p-4">
            {% include 'components/section_header.html.twig' with {
                title: 'Gerar holerites (INSS/IRRF/FGTS stub)'
            } %}
            {% if grant_at_least('product_rh', 'folha_legal', 'GESTOR') and competencias is not empty %}
            <form method="post" action="{{ path('app_rh_folha_legal') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('rh_folha_legal_gerar') }}">
                <input type="hidden" name="action" value="gerar_holerites">
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'folha-legal-competencia',
                    name: 'competencia_id',
                    label: 'Competência',
                    type: 'select',
                    required: true,
                    options: competencias|map(c => { value: c.id ~ '', label: c.referencia })
                } %}
                <button type="submit" class="btn-unio btn-sm">Gerar holerites</button>
            </form>
            {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-file-invoice',
                title: 'Gere uma competência em Folha operacional primeiro.',
                compact: true
            } %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
