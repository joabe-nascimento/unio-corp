{% extends 'layout/hub.html.twig' %}
{% block title %}Comunicação{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Comunicação interna' %}

{% block hub_content %}
{% if grant_at_least('product_rh', 'comunicacao', 'GESTOR_EQUIPE') %}
<div class="unio-card p-4 mb-3">
    {% include 'components/section_header.html.twig' with { title: 'Novo comunicado' } %}
    <form method="post" action="{{ path('app_rh_comunicacao') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_comunicacao_form') }}">
        <input type="hidden" name="action" value="criar">
        {% include 'components/unio_form_field.html.twig' with {
            id: 'comunicado-titulo', name: 'titulo', label: 'Título', placeholder: 'Título', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'comunicado-corpo', name: 'corpo', label: 'Conteúdo',
            type: 'textarea', rows: 3, placeholder: 'Conteúdo', required: true
        } %}
        <button type="submit" class="btn-unio btn-sm">Publicar</button>
    </form>
</div>
{% endif %}

<div class="unio-card p-4">
    {% if comunicados is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-bullhorn',
            title: 'Nenhum comunicado ativo.',
            compact: true
        } %}
    {% else %}
    {% for c in comunicados %}
    <article class="mb-4 pb-3 border-bottom">
        <h4 class="h6">{{ c.titulo }}</h4>
        <p class="mb-2">{{ c.corpo }}</p>
        <small class="text-muted">{{ c.publicadoEm|date('d/m/Y H:i') }}</small>
        {% if funcionario %}
        <form method="post" action="{{ path('app_rh_comunicacao') }}" class="mt-2">
            <input type="hidden" name="_token" value="{{ csrf_token('rh_comunicacao_ler') }}">
            <input type="hidden" name="action" value="ler">
            <input type="hidden" name="comunicado_id" value="{{ c.id }}">
            <button type="submit" class="btn-unio-ghost btn-sm">Marcar como lido</button>
        </form>
        {% endif %}
    </article>
    {% endfor %}
    {% endif %}
</div>
{% endblock %}
