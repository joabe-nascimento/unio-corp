{% extends 'layout/page_list.html.twig' %}
{% block title %}Demissões{% endblock %}
{% set page_list_title = 'Demissões (Offboarding)' %}

{% block page_list_toolbar_actions %}
{% if grant_at_least('product_rh', 'admissoes', 'GESTOR_EQUIPE') %}
<button type="button" class="btn-unio btn-sm" data-unio-offcanvas-open="rh-demissao-nova" data-rh-demissao-nova-open>
    <i class="fas fa-user-minus mr-1" aria-hidden="true"></i> Nova demissão
</button>
{% endif %}
{% endblock %}

{% block page_list_section_toolbar %}
<form method="get" action="{{ path('app_rh_demissoes') }}" style="display:contents;">
{% embed 'components/section_toolbar.html.twig' with {
    search_in_section: true,
    search_placeholder: 'Buscar funcionário ou motivo…',
    search_name: 'q',
    search_value: filter_q|default('')
} %}
    {% block section_toolbar_filters %}
        {% include 'components/filter_group.html.twig' with {
            label: 'Status',
            name: 'status',
            value: filter_status|default(''),
            min_width: '150px',
            options: [
                { value: '', label: 'Todos' },
                { value: 'EM_ANDAMENTO', label: 'Em andamento' },
                { value: 'CONCLUIDO', label: 'Concluído' },
                { value: 'CANCELADO', label: 'Cancelado' },
            ]
        } %}
        {% include 'components/toolbar_filter_actions.html.twig' with {
            clear_href: path('app_rh_demissoes'),
            has_filters: filter_q|default('') or filter_status|default('')
        } %}
    {% endblock %}
{% endembed %}
</form>
{% endblock %}

{% block page_list_content %}
{% include 'components/rh_process_table.html.twig' with {
    type: 'offboarding',
    processos: processos,
    empty_title: 'Nenhum processo de demissão',
    empty_text: filter_q|default('') or filter_status|default('') ? 'Nenhum resultado para os filtros aplicados.' : 'Inicie o offboarding para desligar colaboradores com checklist de TI, acessos e documentação.'
} %}
{% endblock %}

{% block page_overlays %}
{% if grant_at_least('product_rh', 'admissoes', 'GESTOR_EQUIPE') %}
{% include 'components/rh/demissao_offcanvas.html.twig' with {
    open: open_demissao_offcanvas|default(app.request.query.getBoolean('open_nova')),
    empresa: empresa|default(null),
    funcionarios: funcionarios_offboarding|default([]),
    checklist_preview: checklist_preview|default([]),
    all_active_blocked: all_active_blocked|default(false),
    funcionario_id: funcionario_id|default(app.request.query.get('funcionario_id', '')),
    data_prevista: data_prevista|default(''),
    motivo: motivo|default(''),
    observacoes: observacoes|default('')
} %}
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    var dateInput = document.getElementById('data_prevista');
    if (dateInput && !dateInput.min) {
        dateInput.min = '{{ "now"|date("Y-m-d") }}';
    }
    {% if open_demissao_offcanvas|default(app.request.query.getBoolean('open_nova')) %}
    window.UnioOffcanvas && window.UnioOffcanvas.open('rh-demissao-nova');
    {% endif %}
})();
</script>
{% endblock %}
