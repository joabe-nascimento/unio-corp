{% extends 'layout/hub.html.twig' %}
{% block title %}Assinatura digital{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Assinatura digital' %}

{% block hub_content %}
{% if grant_at_least('product_rh', 'assinatura', 'GESTOR_EQUIPE') %}
<div class="unio-card p-4 mb-3">
    <form method="post" action="{{ path('app_rh_assinatura') }}" class="d-flex gap-2 align-items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('rh_assinatura_envelope') }}">
        <div class="flex-fill">
            {% include 'components/unio_form_field.html.twig' with {
                id: 'envelope-titulo', name: 'titulo', label: 'Título do documento',
                placeholder: 'Título do documento', required: true
            } %}
        </div>
        <button type="submit" class="btn-unio btn-sm">Criar envelope</button>
    </form>
</div>
{% endif %}

<div class="unio-card p-4">
    {% if envelopes is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-file-signature',
            title: 'Nenhum envelope de assinatura.',
            compact: true
        } %}
    {% else %}
    <ul class="list-unstyled mb-0">
        {% for e in envelopes %}
        <li class="mb-2"><strong>{{ e.titulo }}</strong> — {{ e.status }} ({{ e.criadoEm|date('d/m/Y') }})</li>
        {% endfor %}
    </ul>
    {% endif %}
</div>
{% endblock %}
