{% extends 'layout/hub.html.twig' %}
{% block title %}Auditoria RH{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Auditoria' %}

{% block hub_content %}
<div class="unio-card p-4 mb-3">
    <form method="get" class="d-flex gap-2 align-items-end">
        {% include 'components/filter_group.html.twig' with {
            type: 'text',
            name: 'modulo',
            placeholder: 'Filtrar módulo',
            value: filter_modulo|default('')
        } %}
        <button type="submit" class="btn-unio-ghost btn-sm">Filtrar</button>
    </form>
</div>
<div class="unio-card">
    {% if logs is empty %}
        <div class="p-4">
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-shield-halved',
                title: 'Nenhum registro de auditoria.',
                compact: true
            } %}
        </div>
    {% else %}
    <div class="table-responsive p-3">
        <table class="table table-unio mb-0 table-sm">
            <thead><tr><th>Data</th><th>Módulo</th><th>Ação</th><th>Usuário</th></tr></thead>
            <tbody>
            {% for log in logs %}
            <tr>
                <td>{{ log.criadoEm|date('d/m/Y H:i') }}</td>
                <td>{{ log.modulo }}</td>
                <td>{{ log.acao }}</td>
                <td>{{ log.user ? log.user.nome : '—' }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}
