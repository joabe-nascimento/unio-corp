{% extends 'layout/page_list.html.twig' %}
{% block title %}Demissão — {{ process.funcionario.nome }}{% endblock %}
{% set page_list_title = process.funcionario.nome %}

{% block page_list_toolbar_actions %}
{% include 'components/page_back_link.html.twig' with { href: path('app_rh_demissoes') } %}
{% endblock %}

{% block page_list_kpis %}
<div class="page-lead-kpis">
    {% include 'components/kpi_row.html.twig' with { items: [
        { value: process.statusLabel, label: 'Status', sub: 'Processo de offboarding' },
        { value: process.checklistProgress ~ '%', label: 'Checklist', sub: 'Itens concluídos' },
        { value: process.dataPrevista ? process.dataPrevista|date('d/m/Y') : '—', label: 'Desligamento previsto', sub: 'Data planejada' },
    ], mb: 'mb-0' } %}
</div>
{% endblock %}

{% block page_list_content %}
{% set detail_items = [
    { label: 'E-mail', value: process.funcionario.email|default('—') },
    { label: 'Cargo', value: process.funcionario.cargo|default('—') },
    { label: 'Motivo', value: process.motivo|default('—') },
] %}
{% if process.observacoes %}
    {% set detail_items = detail_items|merge([{ label: 'Observações', value: process.observacoes }]) %}
{% endif %}
{% if process.dataConclusao %}
    {% set detail_items = detail_items|merge([{ label: 'Concluído em', value: process.dataConclusao|date('d/m/Y') }]) %}
{% endif %}

{% include 'components/rh_process_detail.html.twig' with {
    process: process,
    checklist_title: 'Checklist de offboarding',
    complete_label: 'Concluir offboarding',
    confirm_message: 'Concluir offboarding? O funcionário será inativado e o usuário da plataforma desativado, se existir.',
    detail_items: detail_items,
    hint: 'Hub <strong>Operações</strong> → RH → Demissões. A conclusão inativa o funcionário e desativa o login na plataforma.'
} %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include 'components/rh_process_confirm_script.html.twig' %}
{% endblock %}
