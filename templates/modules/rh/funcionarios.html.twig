{% extends 'base.html.twig' %}
{% block title %}Funcionários{% endblock %}
{% block page_title %}Funcionários{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_rh') }}">RH</a></li>
    <li class="breadcrumb-item active">Funcionários</li>
{% endblock %}
{% block content %}
<div class="huplex-card">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="section-title">Lista de Funcionários</div>
            <div class="section-subtitle">Gerencie o quadro completo de colaboradores</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn-huplex-ghost"><i class="fas fa-filter mr-1"></i> Filtrar</button>
            <button type="button" class="btn-huplex"><i class="fas fa-plus mr-1"></i> Novo</button>
        </div>
    </div>
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-id-card',
        title: 'Nenhum funcionário encontrado',
        text: 'Adicione funcionários para visualizá-los aqui.',
        btn_label: 'Cadastrar Funcionário'
    } %}
</div>
{% endblock %}
