{% extends 'layout/hub.html.twig' %}
{% block title %}Funcionários{% endblock %}
{% set hub_page_title = 'Funcionários' %}
{% block hub_toolbar_actions %}
    <button type="button" class="btn-huplex"><i class="fas fa-plus"></i> Novo</button>
{% endblock %}
{% block hub_content %}
<div class="huplex-card">
    {% include 'components/section_header.html.twig' with {
        title: 'Lista de Funcionários',
        subtitle: 'Gerencie o quadro completo de colaboradores'
    } %}
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-id-card',
        title: 'Nenhum funcionário encontrado',
        text: 'Adicione funcionários para visualizá-los aqui.',
        btn_label: 'Cadastrar Funcionário'
    } %}
</div>
{% endblock %}
