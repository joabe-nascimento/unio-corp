{% extends 'layout/hub.html.twig' %}
{% block title %}Analytics RH{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Analytics RH' %}

{% block hub_content %}
<div class="unio-card p-4">
    <p class="text-muted mb-4">Indicadores por módulo do roadmap (fase 3 — visão consolidada).</p>
    <div class="row g-3">
        {% for mod in modules %}
        {% if product_grant('product_rh', mod.grant) %}
        <div class="col-md-4 col-lg-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small mb-1">Fase {{ mod.phase }}</div>
                <strong>{{ mod.title }}</strong>
                <div class="display-6 my-2">{{ mod.count }}</div>
                <small class="text-muted">{{ mod.count_label }}</small>
            </div>
        </div>
        {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}
