{% extends 'layout/hub.html.twig' %}
{% block title %}Meus holerites{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Meus holerites' %}

{% block hub_content %}
{% include 'components/rh/portal_nav.html.twig' with { active: 'holerites' } %}

<div class="unio-card p-4">
    <p class="text-muted small mb-3">Exibimos apenas competências com folha <strong>fechada</strong>.</p>
    {% if holerites is empty %}
        {% include 'components/empty_state.html.twig' with {
            icon: 'fa-file-invoice-dollar',
            title: 'Nenhum holerite',
            text: 'Quando o RH fechar a competência e gerar os holerites, eles aparecerão aqui.',
            compact: true
        } %}
    {% else %}
    <div class="table-responsive">
        <table class="table table-sm mb-0 rh-portal-table">
            <thead>
                <tr>
                    <th>Competência</th>
                    <th>Bruto</th>
                    <th>INSS</th>
                    <th>IRRF</th>
                    <th>Líquido</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for h in holerites %}
                <tr>
                    <td>{{ h.competencia.referencia }}</td>
                    <td>R$ {{ h.salarioBruto|number_format(2, ',', '.') }}</td>
                    <td>R$ {{ h.inss|number_format(2, ',', '.') }}</td>
                    <td>R$ {{ h.irrf|number_format(2, ',', '.') }}</td>
                    <td><strong>R$ {{ h.liquido|number_format(2, ',', '.') }}</strong></td>
                    <td class="text-right">
                        <a href="{{ path('app_rh_portal_holerite', { id: h.id }) }}" class="btn-unio btn-sm">Detalhes</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}
