{% extends 'layout/hub.html.twig' %}
{% block title %}Minhas férias{% endblock %}
{% block permissions_scope %}product_rh{% endblock %}
{% set hub_page_title = 'Minhas férias' %}

{% set ferias_status_labels = {
    'SOLICITADA': 'Pendente',
    'APROVADA': 'Aprovada',
    'REJEITADA': 'Rejeitada',
    'EM_GOZO': 'Em gozo',
    'CONCLUIDA': 'Concluída'
} %}

{% block hub_content %}
{% include 'components/rh/portal_nav.html.twig' with { active: 'ferias' } %}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="unio-card p-4">
            {% include 'components/section_header.html.twig' with { title: 'Nova solicitação' } %}
            {% if funcionario.status != 'ATIVO' %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'fa-user-clock',
                    title: 'Somente colaboradores ativos podem solicitar férias.',
                    compact: true
                } %}
            {% else %}
            <form method="post" action="{{ path('app_rh_portal_ferias') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('rh_portal_ferias') }}">
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'data_inicio', name: 'data_inicio', label: 'Data início', type: 'date', required: true
                } %}
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'data_fim', name: 'data_fim', label: 'Data fim', type: 'date', required: true
                } %}
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'observacoes', name: 'observacoes', label: 'Observações',
                    type: 'textarea', rows: 3, placeholder: 'Opcional'
                } %}
                <button type="submit" class="btn-unio">Enviar solicitação</button>
            </form>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-7">
        <div class="unio-card p-4">
            {% include 'components/section_header.html.twig' with { title: 'Histórico' } %}
            {% if ferias is empty %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'fa-umbrella-beach',
                    title: 'Você ainda não possui solicitações de férias.',
                    compact: true
                } %}
            {% else %}
            <div class="table-responsive">
                <table class="table table-sm mb-0 rh-portal-table">
                    <thead>
                        <tr>
                            <th>Período</th>
                            <th>Dias</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for f in ferias %}
                        <tr>
                            <td>{{ f.dataInicio|date('d/m/Y') }} — {{ f.dataFim|date('d/m/Y') }}</td>
                            <td>{{ f.dias }}</td>
                            <td>
                                {% set _ferias_variant = f.status == 'APROVADA' ? 'success' : (f.status == 'REJEITADA' ? 'danger' : (f.status == 'SOLICITADA' ? 'warning' : 'info')) %}
                                {% include 'components/status_badge.html.twig' with {
                                    label: ferias_status_labels[f.status]|default(f.status),
                                    variant: _ferias_variant
                                } %}
                                {% if f.status == 'REJEITADA' and f.motivoRejeicao %}
                                    <br><small class="text-muted">{{ f.motivoRejeicao }}</small>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
