{# Documento institucional Unio (Studio) — mPDF: capa full-bleed + corpo compacto #}
<style>
    body { font-family: dejavusans, sans-serif; color: #334155; font-size: 9.5pt; line-height: 1.4; }
    h1 { font-size: 15pt; color: #071428; margin: 0 0 5pt; font-weight: bold; }
    h2 { font-size: 11pt; color: #071428; margin: 0 0 4pt; font-weight: bold; }
    h3 { font-size: 9.5pt; color: #0f172a; margin: 0 0 2pt; font-weight: bold; }
    p { margin: 0 0 6pt; }
    .eyebrow { font-size: 7.5pt; letter-spacing: 1.4px; text-transform: uppercase; color: #4F7FFF; font-weight: bold; margin: 0 0 3pt; }
    .lead { font-size: 9pt; color: #64748b; margin: 0 0 8pt; }
    .page { page-break-after: always; }
    .page-last { page-break-after: auto; }
    .muted { color: #64748b; }
    .small { font-size: 8pt; }
    .card {
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 7pt 8pt;
        margin: 0 0 6pt;
        background: #fff;
    }
    .callout {
        border-left: 2.5px solid #4F7FFF;
        background: #f0f5ff;
        padding: 6pt 8pt;
        margin: 8pt 0 0;
    }
    .callout strong { display: block; color: #0c2563; margin-bottom: 1pt; font-size: 8.5pt; }
    table.grid { width: 100%; border-collapse: separate; border-spacing: 4pt; margin: 0 -4pt; }
    table.grid td {
        width: 50%;
        vertical-align: top;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 6pt 7pt;
        background: #fff;
    }
    table.stats { width: 100%; border-collapse: collapse; margin: 6pt 0 8pt; }
    table.stats td {
        text-align: center;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 7pt 4pt;
    }
    table.stats strong { display: block; font-size: 12pt; color: #071428; line-height: 1.1; }
    table.stats span { font-size: 7pt; color: #64748b; }
    table.data { width: 100%; border-collapse: collapse; margin-top: 4pt; }
    table.data th {
        text-align: left;
        background: #f1f5f9;
        color: #4F7FFF;
        font-size: 7pt;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 4pt 5pt;
        border-bottom: 1px solid #e2e8f0;
    }
    table.data td {
        padding: 5pt;
        border-bottom: 1px solid #e2e8f0;
        font-size: 8.5pt;
        vertical-align: top;
    }
    table.data td:first-child { font-weight: bold; color: #0c2563; white-space: nowrap; }
    ul.clean { margin: 2pt 0 0 12pt; padding: 0; }
    ul.clean li { margin: 0 0 2pt; font-size: 8.5pt; color: #64748b; }
    .toc td { padding: 3.5pt 0; border-bottom: 1px solid #e2e8f0; font-size: 9pt; }
    .toc .num { color: #4F7FFF; font-weight: bold; width: 22pt; }
    .toc .pg { color: #94a3b8; width: 18pt; text-align: right; }
    .pill {
        display: inline-block;
        font-size: 6.5pt;
        font-weight: bold;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: #0c2563;
        background: #eef4ff;
        border: 1px solid #c7d7ef;
        padding: 2pt 5pt;
        margin: 0 2pt 2pt 0;
        border-radius: 8pt;
    }
    .close-box {
        background: #071428;
        color: #fff;
        padding: 12pt;
        text-align: center;
        border-radius: 4px;
        margin-top: 10pt;
    }
    .close-box h2 { color: #fff; margin: 0 0 3pt; font-size: 13pt; }
    .close-box p { color: rgba(248,250,252,0.7); margin: 0; font-size: 8.5pt; }
    .close-box a { color: #bfdbfe; font-weight: bold; text-decoration: none; }

    /* ── Capa full-bleed ── */
    .cover-bleed {
        width: 210mm;
        height: 297mm;
        background: #071428;
        color: #f8fafc;
        padding: 0;
        margin: 0;
    }
    .cover-inner { padding: 18mm 16mm 14mm; }
    .cover-top {
        border-bottom: 1px solid rgba(255,255,255,0.12);
        padding-bottom: 8pt;
        margin-bottom: 14pt;
        font-size: 7.5pt;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: rgba(248,250,252,0.55);
    }
    .cover-badge {
        float: right;
        font-size: 7pt;
        letter-spacing: 1px;
        color: #bfdbfe;
        border: 1px solid rgba(79,127,255,0.45);
        background: rgba(79,127,255,0.14);
        padding: 3pt 7pt;
        border-radius: 8pt;
        text-transform: uppercase;
    }
    .cover-logo { margin: 8pt 0 14pt; }
    .cover-logo img { height: 38pt; width: auto; }
    .cover-tag {
        font-size: 8pt;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #4F7FFF;
        font-weight: bold;
        margin: 0 0 6pt;
    }
    .cover-title {
        font-size: 18pt;
        font-weight: bold;
        color: #fff;
        line-height: 1.2;
        margin: 0 0 8pt;
    }
    .cover-title span { color: #93b4ff; }
    .cover-lead {
        font-size: 9pt;
        color: rgba(248,250,252,0.65);
        margin: 0 0 12pt;
        line-height: 1.45;
    }
    .cover-kpi { width: 100%; border-collapse: collapse; margin-bottom: 10pt; }
    .cover-kpi td {
        width: 25%;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
        padding: 8pt 3pt;
        vertical-align: top;
    }
    .cover-kpi strong { display: block; font-size: 11pt; color: #eef4ff; line-height: 1.1; }
    .cover-kpi span { font-size: 6.5pt; color: rgba(248,250,252,0.5); }
    .cover-box {
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.03);
        padding: 6pt 8pt;
        margin: 0 0 4pt;
        font-size: 8pt;
        color: rgba(248,250,252,0.78);
    }
    .cover-box strong { color: #bfdbfe; }
    .cover-foot {
        margin-top: 12pt;
        border-top: 1px solid rgba(255,255,255,0.12);
        padding-top: 8pt;
        font-size: 7.5pt;
        color: rgba(248,250,252,0.45);
    }
</style>

{% if doc_section|default('body') == 'cover' %}

{# ═══════════════════════════════════════════ CAPA FULL-BLEED ═══════════════════════════════════════════ #}
<div class="cover-bleed">
    <div class="cover-inner">
        <div class="cover-top">
            <span class="cover-badge">Confidencial</span>
            Documento institucional · v{{ doc_version }}
        </div>

        {% if logo_path|default('') %}
        <div class="cover-logo">
            <img src="{{ logo_path }}" alt="Unio" height="48" />
        </div>
        {% else %}
        <div class="cover-logo" style="font-size:22pt;font-weight:bold;color:#fff;letter-spacing:-0.5px;">Unio</div>
        {% endif %}

        <div class="cover-tag">Plataforma digital · Evolui com você.</div>
        <div class="cover-title">Sites, sistemas e produtos<br><span>em um só organismo.</span></div>
        <p class="cover-lead">
            A Unio é a plataforma digital que concentra CRM comercial, pessoas &amp; RH,
            projetos &amp; metas, portal do cliente e operação (TI / integrações) no mesmo workspace —
            com entregas rastreáveis e assistente Vitória.
        </p>

        <table class="cover-kpi">
            <tr>
                <td><strong>CRM</strong><span>Pipeline &amp; leads</span></td>
                <td><strong>RH</strong><span>Pessoas &amp; times</span></td>
                <td><strong>Projetos</strong><span>Kanban &amp; metas</span></td>
                <td><strong>Portal</strong><span>Cliente &amp; entrega</span></td>
            </tr>
        </table>

        <div class="cover-box"><strong>Comercial —</strong> Do lead ao fechamento com kanban, clientes, atividades e analytics no mesmo ritmo da operação.</div>
        <div class="cover-box"><strong>Organismo —</strong> Módulos ligados: RH, recrutamento, projetos, TI e portal do cliente sem silos entre áreas.</div>
        <div class="cover-box"><strong>Multi-empresa —</strong> Workspaces isolados, grants por produto e identidade white-label por unidade.</div>
        <div class="cover-box"><strong>Vitória —</strong> Copiloto contextual que navega módulos e indicadores dentro das regras de acesso.</div>

        <div class="cover-foot">
            {{ doc_date }} · uniowork.com.br · © {{ doc_year }} Unio · Não distribuir sem autorização
        </div>
    </div>
</div>

{% else %}

{# ═══════════════════════════════════════════ CORPO ═══════════════════════════════════════════ #}

{# 2. Sumário + ideia atual #}
<div class="page">
    <p class="eyebrow">Documento · v{{ doc_version }}</p>
    <h1>Sumário e ideia atual</h1>
    <p class="lead">A Unio de hoje é um <strong>organismo digital</strong>: sites, sistemas e produtos operando juntos — não um catálogo genérico de “30 núcleos”.</p>

    <table class="toc" width="100%">
        <tr><td class="num">01</td><td>Capa</td><td class="pg">1</td></tr>
        <tr><td class="num">02</td><td>Sumário e ideia atual</td><td class="pg">2</td></tr>
        <tr><td class="num">03</td><td>O que a plataforma entrega agora</td><td class="pg">3</td></tr>
        <tr><td class="num">04</td><td>CRM comercial</td><td class="pg">4</td></tr>
        <tr><td class="num">05</td><td>Projetos, metas e portal</td><td class="pg">5</td></tr>
        <tr><td class="num">06</td><td>Pessoas, RH e recrutamento</td><td class="pg">6</td></tr>
        <tr><td class="num">07</td><td>TI, integrações e Vitória</td><td class="pg">7</td></tr>
        <tr><td class="num">08</td><td>Multi-empresa e governança</td><td class="pg">8</td></tr>
        <tr><td class="num">09</td><td>Jornada de uso</td><td class="pg">9</td></tr>
        <tr><td class="num">10</td><td>Encerramento</td><td class="pg">10</td></tr>
    </table>

    <div class="callout">
        <strong>Posicionamento atual (Unio Studio)</strong>
        <span class="small muted">Evolui com você. · Sites, sistemas e produtos em um só organismo. · Módulos, portal do cliente e entregas rastreáveis em um só lugar. · Vertical clínico (Unio Saúde) é produto separado em uniosaude.uniowork.com.br.</span>
    </div>
</div>

{# 3. Entrega atual #}
<div class="page">
    <p class="eyebrow">Plataforma em produção</p>
    <h1>O que a Uniowork entrega agora</h1>
    <p class="lead">Foco no que está no ar em uniowork.com.br — operação comercial, entrega de projetos e gestão de pessoas no mesmo login.</p>

    <table class="stats">
        <tr>
            <td style="width:25%"><strong>CRM</strong><span>Funil comercial</span></td>
            <td style="width:25%"><strong>Kanban</strong><span>Projetos &amp; vendas</span></td>
            <td style="width:25%"><strong>RH</strong><span>Pessoas &amp; times</span></td>
            <td style="width:25%"><strong>1</strong><span>Workspace unificado</span></td>
        </tr>
    </table>

    <table class="data">
        <thead>
            <tr><th>Área</th><th>Em produção</th><th>Para quem</th></tr>
        </thead>
        <tbody>
            <tr><td>Comercial</td><td>Leads, pipeline DnD, clientes, atividades, analytics</td><td>Time de vendas e gestão</td></tr>
            <tr><td>Entrega</td><td>Projetos, metas, kanban de tarefas, portal do cliente</td><td>Operação e CS</td></tr>
            <tr><td>Pessoas</td><td>RH, recrutamento (pipeline), organograma</td><td>RH e líderes</td></tr>
            <tr><td>Plataforma</td><td>Multi-empresa, grants, white-label, Vitória, TI</td><td>Admin e operação</td></tr>
        </tbody>
    </table>

    <div class="callout">
        <strong>Não confundir com Unio Saúde</strong>
        <span class="small muted">Unio Saúde (uniosaude.uniowork.com.br) é a vertical clínica — pós-operatório, carteirinha, guia médico. Este documento trata da <strong>Uniowork</strong>, a plataforma central.</span>
    </div>
</div>

{# 4. CRM #}
<div class="page">
    <p class="eyebrow">Núcleo comercial</p>
    <h1>CRM — do lead ao fechamento</h1>
    <p class="lead">Pipeline visual com drag-and-drop, contas, atividades e indicadores — o coração comercial da Unio atual.</p>

    <table class="grid">
        <tr>
            <td>
                <h3>Pipeline kanban</h3>
                <ul class="clean">
                    <li>Estágios: lead → ganho / perdido</li>
                    <li>Arrastar pelo grip ou usar o select</li>
                    <li>Valor do funil e contadores ao vivo</li>
                    <li>Persistência AJAX com rollback se falhar</li>
                </ul>
            </td>
            <td>
                <h3>Operação comercial</h3>
                <ul class="clean">
                    <li>Leads e clientes (contas)</li>
                    <li>Atividades e follow-ups</li>
                    <li>Analytics de conversão / origem</li>
                    <li>Mesmo ritmo da operação e dos projetos</li>
                </ul>
            </td>
        </tr>
    </table>

    <div class="card">
        <h3>Tokens da landing atual</h3>
        <p class="small muted" style="margin:0">
            <span class="pill">CRM comercial</span>
            <span class="pill">Pipeline de vendas</span>
            <span class="pill">Pessoas e RH</span>
            <span class="pill">Portal do cliente</span>
        </p>
    </div>
</div>

{# 5. Projetos #}
<div class="page">
    <p class="eyebrow">Entrega</p>
    <h1>Projetos, metas e portal do cliente</h1>
    <p class="lead">Organize o que está em desenvolvimento: backlog → a fazer → em andamento → feito, com metas e relacionamento com o cliente.</p>

    <table class="grid">
        <tr>
            <td>
                <h3>Projetos &amp; Metas</h3>
                <ul class="clean">
                    <li>Kanban de tarefas com prioridade</li>
                    <li>Cards arrastáveis entre colunas</li>
                    <li>Lista de projetos e visão de metas</li>
                    <li>Painel: ativos, tarefas abertas, total</li>
                </ul>
            </td>
            <td>
                <h3>Portal do cliente</h3>
                <ul class="clean">
                    <li>Entregas rastreáveis sem app nativo</li>
                    <li>Relação com cliente no mesmo organismo</li>
                    <li>Alinha CS e operação à venda</li>
                    <li>Continuum comercial → entrega</li>
                </ul>
            </td>
        </tr>
    </table>

    <div class="callout">
        <strong>Idea-chave</strong>
        <span class="small muted">“Do lead ao fechamento, no mesmo ritmo da operação.” CRM, projetos e portal compartilham o workspace — não três ferramentas soltas.</span>
    </div>
</div>

{# 6. RH #}
<div class="page">
    <p class="eyebrow">Pessoas</p>
    <h1>RH e recrutamento</h1>
    <p class="lead">Quem opera a plataforma também gerencia times: RH operacional e funil de seleção no mesmo login.</p>

    <table class="data">
        <thead>
            <tr><th>Módulo</th><th>Capacidades atuais</th></tr>
        </thead>
        <tbody>
            <tr><td>RH</td><td>Funcionários, admissões, férias, organograma, documentos</td></tr>
            <tr><td>Recrutamento</td><td>Vagas, candidatos, pipeline kanban (triagem → contratado)</td></tr>
            <tr><td>Inovação</td><td>Kanban de iniciativas e analytics de maturidade</td></tr>
            <tr><td>Portal colaborador</td><td>Autosserviço alinhado ao núcleo de pessoas</td></tr>
        </tbody>
    </table>

    <table class="grid" style="margin-top:8pt">
        <tr>
            <td>
                <h3>Por que importa</h3>
                <p class="small muted" style="margin:0">Venda (CRM) e entrega (projetos) precisam de time certo. Recrutamento e RH fecham o ciclo pessoas ↔ operação.</p>
            </td>
            <td>
                <h3>Padrão Unio</h3>
                <p class="small muted" style="margin:0">Kanban, KPIs e grants iguais aos do comercial — a equipe aprende uma linguagem visual para todos os núcleos.</p>
            </td>
        </tr>
    </table>
</div>

{# 7. TI + Vitória #}
<div class="page">
    <p class="eyebrow">Operação digital</p>
    <h1>TI, integrações e Vitória</h1>
    <p class="lead">A plataforma não para no CRM: service desk, conectores e copiloto contextual completam o organismo.</p>

    <table class="grid">
        <tr>
            <td>
                <h3>Núcleo TI</h3>
                <ul class="clean">
                    <li>Chamados e SLA</li>
                    <li>Escalação e NOC</li>
                    <li>Knowledge base</li>
                </ul>
            </td>
            <td>
                <h3>Integrações</h3>
                <ul class="clean">
                    <li>APIs e webhooks</li>
                    <li>Conectores observáveis</li>
                    <li>Filas e dead letter</li>
                </ul>
            </td>
        </tr>
        <tr>
            <td>
                <h3>Vitória</h3>
                <ul class="clean">
                    <li>Assistente inteligente</li>
                    <li>Contexto da tela / módulo</li>
                    <li>Respeita permissões do perfil</li>
                </ul>
            </td>
            <td>
                <h3>Inovação</h3>
                <ul class="clean">
                    <li>Backlog de iniciativas</li>
                    <li>Radar / maturidade</li>
                    <li>Mesmo padrão kanban</li>
                </ul>
            </td>
        </tr>
    </table>
</div>

{# 8. Multi-empresa #}
<div class="page">
    <p class="eyebrow">Arquitetura</p>
    <h1>Multi-empresa e governança</h1>
    <p class="lead">Uma conta Unio pode operar várias empresas/unidades com dados isolados, grants por produto e marca própria.</p>

    <table class="grid">
        <tr>
            <td>
                <h3>Workspaces</h3>
                <p class="small muted" style="margin:0">Troca de empresa sem novo login. Colaboradores, CRM e projetos ficam no escopo da unidade escolhida.</p>
            </td>
            <td>
                <h3>Grants</h3>
                <p class="small muted" style="margin:0">Libere Comercial, RH, TI ou Recrutamento por pessoa — perfil Tenant, Admin, Gestor, Supervisor.</p>
            </td>
        </tr>
        <tr>
            <td>
                <h3>White-label</h3>
                <p class="small muted" style="margin:0">Logo, cores e textos configuráveis. Ideal quando a operação atende marcas diferentes.</p>
            </td>
            <td>
                <h3>Segurança</h3>
                <p class="small muted" style="margin:0">Auth CSRF, sessão, LGPD (privacidade/termos) e trilha operacional nos módulos críticos.</p>
            </td>
        </tr>
    </table>

    <h2 style="margin-top:8pt">Mapa compacto de módulos</h2>
    <table class="data">
        <thead>
            <tr><th>Bloco</th><th>Módulos</th></tr>
        </thead>
        <tbody>
            {% for cat in hub_categories %}
            <tr>
                <td>{{ cat.title }}</td>
                <td>{{ cat.hubs|join(' · ') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# 9. Jornada #}
<div class="page">
    <p class="eyebrow">Uso real</p>
    <h1>Jornada no dia a dia</h1>
    <p class="lead">Como um time entra e opera a Uniowork atual — quatro passos.</p>

    <table class="data">
        <thead>
            <tr><th>#</th><th>Passo</th><th>O que acontece</th></tr>
        </thead>
        <tbody>
            <tr><td>01</td><td>Acesso</td><td>Login em uniowork.com.br com identidade Unio e sessão segura.</td></tr>
            <tr><td>02</td><td>Workspace</td><td>Escolha da empresa/unidade — dados e módulos no escopo certo.</td></tr>
            <tr><td>03</td><td>Hub</td><td>Atalhos liberados ao perfil: Comercial, Projetos, RH, TI…</td></tr>
            <tr><td>04</td><td>Operação</td><td>Pipeline, kanban de tarefas, recrutamento ou chamados — conforme o grant.</td></tr>
        </tbody>
    </table>

    <div class="card" style="margin-top:8pt">
        <h3>Slogan operacional</h3>
        <p class="small muted" style="margin:0"><strong style="color:#071428">Evolui com você.</strong> — a plataforma cresce com os módulos que a operação precisa, sem trocar de sistema a cada área.</p>
    </div>
</div>

{# 10. Encerramento #}
<div class="page-last">
    <p class="eyebrow">Próximos passos</p>
    <h1>Pronto para apresentar</h1>
    <p class="lead">PDF institucional da <strong>Uniowork atual</strong> — organismo digital com CRM, entrega, pessoas e operação.</p>

    <table class="grid">
        <tr>
            <td>
                <h3>Ambiente</h3>
                <p class="small muted" style="margin:0">Produção<br><strong style="color:#071428">uniowork.com.br</strong></p>
            </td>
            <td>
                <h3>Documento</h3>
                <p class="small muted" style="margin:0">v{{ doc_version }} · {{ doc_date }}<br>10 págs · A4 · mPDF · marca d’água</p>
            </td>
        </tr>
    </table>

    <div class="close-box">
        {% if logo_path|default('') %}
        <img src="{{ logo_path }}" alt="Unio" height="36" style="margin-bottom:8pt" /><br>
        {% endif %}
        <h2>Unio</h2>
        <p>Sites, sistemas e produtos em um só organismo.</p>
        <p style="margin-top:6pt"><a href="https://uniowork.com.br">uniowork.com.br</a></p>
    </div>

    <p class="small muted" style="margin-top:10pt;text-align:center">© {{ doc_year }} Unio · Confidencial · v{{ doc_version }}</p>
</div>

{% endif %}
