{# Captura numerada do tour da plataforma #}

<article class="apr-tour-item" id="tour-{{ screen.step }}">

    <div class="apr-tour-rail" aria-hidden="true">

        <span class="apr-tour-num">{{ screen.step }}</span>

    </div>

    <div class="apr-tour-content">

        <div class="apr-tour-item-head">

            <div class="apr-tour-item-copy">

                <h3 class="apr-tour-item-title">{{ screen.title }}</h3>

                <p class="apr-tour-item-desc">{{ screen.desc }}</p>

            </div>

        </div>

        <div class="apr-shot-block apr-shot-block--tour">

            <div class="apr-browser-shell apr-browser-shell--light">

            <div class="apr-browser-frame apr-browser-frame--light">

                <div class="apr-browser-chrome">

                    <div class="apr-browser-dots"><span></span><span></span><span></span></div>

                    <div class="apr-browser-url">{{ screen.url }}</div>

                </div>

                <div class="apr-browser-body">

                    <img src="{{ asset('images/apresentacao/' ~ screen.image) }}?v=4"

                         alt="{{ screen.title }}"

                         loading="{{ screen.step == '01' ? 'eager' : 'lazy' }}"

                         decoding="async">

                </div>

            </div>

            </div>

            <p class="apr-shot-caption">{{ screen.caption }}</p>

        </div>

    </div>

</article>

