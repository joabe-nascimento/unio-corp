<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Preview — Dock de núcleos | Unio</title>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/unio-app.min.css') }}?v=260">
    <style>
        body {
            margin: 0;
            background: #f1f5f9;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
        }
        #capture-root {
            width: 1100px;
            padding: 40px 44px 44px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(15, 23, 42, 0.08);
        }
        .dock-preview {
            width: 100%;
        }
        .dock-preview-head { margin-bottom: 28px; }
        .dock-preview-eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 8px;
        }
        .dock-preview-head h2 {
            font-family: 'Sora', sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: var(--text-1);
            margin: 0 0 6px;
        }
        .dock-preview-head p {
            margin: 0;
            font-size: 14px;
            color: var(--text-2);
        }
        .welcome-hubs-dock {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }
        .welcome-hub-dock-tile {
            position: relative;
        }
        .welcome-hub-dock-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 22px 12px 18px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--bg);
            text-decoration: none;
            transition: border-color 0.15s, transform 0.12s;
        }
        .welcome-hub-dock-link:hover {
            border-color: rgba(79,127,255,0.35);
            transform: translateY(-2px);
            text-decoration: none;
        }
        .welcome-hub-dock-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--accent);
            background: rgba(79,127,255,0.12);
            border: 1px solid rgba(79,127,255,0.22);
        }
        .welcome-hub-dock-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-1);
            text-align: center;
            line-height: 1.3;
        }
    </style>
</head>
<body>
<div id="capture-root">
<div class="dock-preview">
    <header class="dock-preview-head">
        <p class="dock-preview-eyebrow">Boas-vindas · Nexus Saúde</p>
        <h2>Escolha seu ponto de partida</h2>
        <p>Acesse os núcleos e módulos liberados para o seu perfil nesta área de trabalho.</p>
    </header>
    <div class="welcome-hubs-dock">
        {% for item in dock_items %}
        <div class="welcome-hub-tile welcome-hub-dock-tile">
            <a href="#" class="welcome-hub-dock-link" title="{{ item.subtitle }}">
                <span class="welcome-hub-dock-icon"><i class="fas {{ item.icon }}"></i></span>
                <span class="welcome-hub-dock-label">{{ item.title }}</span>
            </a>
        </div>
        {% endfor %}
    </div>
</div>
</div>
</body>
</html>
