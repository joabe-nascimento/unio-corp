<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Preview — Workspace | Unio</title>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/unio-app.min.css') }}?v=276">
    <style>
        html, body { height: 100%; overflow: hidden; margin: 0; }
        body {
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
        }
        #capture-root {
            width: 540px;
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid var(--border-2);
            box-shadow: 0 12px 48px rgba(15,23,42,0.12);
            background: var(--surface);
        }
        .ws-header {
            padding: 32px 36px 24px;
            text-align: center;
            border-bottom: 1px solid var(--border);
        }
        .ws-logo-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }
        .ws-logo-wrap img { height: 36px; width: auto; }
        .ws-eyebrow {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 8px;
        }
        .ws-title {
            font-family: 'Sora', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: var(--text-1);
            letter-spacing: -0.02em;
            margin-bottom: 6px;
        }
        .ws-sub {
            font-size: 13px;
            color: var(--text-2);
        }
        .ws-user-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 5px 14px 5px 5px;
            margin-top: 16px;
        }
        .ws-user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--accent-dim);
            border: 1px solid var(--accent-line);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            font-weight: 700;
            color: var(--accent);
        }
        .ws-user-name { font-size: 12px; font-weight: 500; color: var(--text-1); }
        .ws-body { padding: 20px 24px 28px; }
        .ws-list { display: flex; flex-direction: column; gap: 10px; }
        .ws-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 16px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--surface-2);
            cursor: pointer;
            transition: border-color 0.15s;
        }
        .ws-item.ws-active {
            border-color: var(--accent-line);
            background: var(--accent-dim);
        }
        .ws-item-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: var(--surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            color: var(--accent);
            flex-shrink: 0;
        }
        .ws-active .ws-item-icon {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }
        .ws-item-info { flex: 1; min-width: 0; }
        .ws-item-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-1);
            line-height: 1.3;
        }
        .ws-item-meta {
            font-size: 11px;
            color: var(--text-3);
            margin-top: 2px;
        }
        .ws-item-check {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 1.5px solid var(--border-2);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 10px;
            color: transparent;
        }
        .ws-active .ws-item-check {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }
        .ws-btn-enter {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: none;
            font-size: 14px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            background: var(--brand-gradient);
            color: #fff;
            cursor: pointer;
            margin-top: 20px;
        }
    </style>
</head>
<body>
<div id="capture-root">
    <div class="ws-header">
        <div class="ws-logo-wrap">
            {% include 'components/platform_logo.html.twig' with { variant: 'full' } only %}
        </div>
        <div class="ws-eyebrow">Multi-empresa · mesma conta</div>
        <div class="ws-title">Selecione a área de trabalho</div>
        <div class="ws-sub">Você tem acesso a {{ empresas|length }} workspaces</div>
        <div>
            <div class="ws-user-chip">
                <div class="ws-user-avatar">UA</div>
                <span class="ws-user-name">User Admin · Administrador</span>
            </div>
        </div>
    </div>

    <div class="ws-body">
        <div class="ws-list">
            {% for emp in empresas %}
            <div class="ws-item{% if loop.index == 2 %} ws-active{% endif %}">
                <div class="ws-item-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div class="ws-item-info">
                    <div class="ws-item-name">{{ emp.nome }}</div>
                    <div class="ws-item-meta">{% if emp.setor %}{{ emp.setor }} · {% endif %}{{ loop.index == 2 ? 'Último acesso: hoje, 09:14' : (loop.index == 1 ? 'Último acesso: ontem' : 'Último acesso: há 3 dias') }}</div>
                </div>
                <div class="ws-item-check"><i class="fas fa-check"></i></div>
            </div>
            {% endfor %}
        </div>

        <button type="button" class="ws-btn-enter">
            <i class="fas fa-arrow-right-to-bracket"></i>
            Entrar no workspace selecionado
        </button>
    </div>
</div>
</body>
</html>
