<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Preview — Workspace | Unio</title>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
        }
        #capture-root {
            width: 100%;
            max-width: 580px;
            padding: 40px 36px 44px;
            background: var(--bg);
            border-radius: 16px;
            border: 1px solid var(--border);
            box-shadow: 0 8px 32px rgba(15, 23, 42, 0.08);
        }
        .ws-header { text-align: center; margin-bottom: 32px; }
        .ws-header .logo { display: flex; align-items: center; justify-content: center; margin-bottom: 22px; }
        .ws-brand-logo {
            height: 52px;
            width: auto;
            object-fit: contain;
        }
        .ws-header h2 { font-size: 20px; font-weight: 700; color: var(--text-1); letter-spacing: -0.02em; margin-bottom: 8px; }
        .ws-header p { font-size: 13px; color: var(--text-2); }
        .user-chip {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 100px; padding: 6px 16px 6px 6px; margin-bottom: 28px;
        }
        .user-chip .uc-avatar {
            width: 28px; height: 28px; border-radius: 50%;
            background: rgba(79,127,255,0.12); border: 1px solid rgba(79,127,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 10px; font-weight: 700; color: var(--accent);
        }
        .user-chip .uc-name { font-size: 12px; font-weight: 500; color: var(--text-1); }
        .ws-grid { display: flex; flex-direction: column; gap: 14px; }
        .ws-card {
            display: flex; align-items: center; gap: 16px;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 12px; padding: 18px 20px;
            position: relative;
        }
        .ws-card.ws-active {
            border-color: rgba(79,127,255,0.4);
            background: rgba(79,127,255,0.06);
        }
        .ws-card .empresa-logo-fallback {
            width: 46px; height: 46px; border-radius: 11px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: rgba(79,127,255,0.1); border: 1px solid rgba(79,127,255,0.22);
            color: var(--accent); font-size: 18px;
        }
        .ws-card .wc-info { flex: 1; min-width: 0; }
        .ws-card .wc-name { font-size: 15px; font-weight: 600; color: var(--text-1); line-height: 1.3; }
        .ws-card .wc-meta { font-size: 12px; color: var(--text-3); margin-top: 3px; }
        .ws-card .wc-check {
            width: 24px; height: 24px; border-radius: 50%;
            border: 1.5px solid rgba(79,127,255,0.35);
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .ws-card.ws-active .wc-check { background: var(--accent); border-color: var(--accent); }
        .ws-card .wc-check i { font-size: 10px; color: transparent; }
        .ws-card.ws-active .wc-check i { color: #fff; }
        .ws-card .wc-arrow { font-size: 11px; color: var(--text-3); margin-left: 4px; }
        .text-center { text-align: center; }
    </style>
</head>
<body>
<div id="capture-root">
    <div class="ws-wrap">
        <div class="ws-header">
            <div class="logo">
                {% include 'components/platform_logo.html.twig' with {
                    variant: 'full',
                    class: 'ws-brand-logo'
                } only %}
            </div>
            <h2>Selecione a área de trabalho</h2>
            <p>Escolha a empresa que deseja acessar agora</p>
        </div>

        <div class="text-center">
            <div class="user-chip">
                <div class="uc-avatar">UA</div>
                <span class="uc-name">User Admin</span>
            </div>
        </div>

        <div class="ws-grid">
            {% for emp in empresas %}
            <div class="ws-card{% if loop.first %} ws-active{% endif %}">
                <div class="empresa-logo-fallback"><i class="fas fa-building"></i></div>
                <div class="wc-info">
                    <div class="wc-name">{{ emp.nome }}</div>
                    <div class="wc-meta">{% if emp.setor %}{{ emp.setor }}{% endif %}</div>
                </div>
                <div class="wc-check"><i class="fas fa-check"></i></div>
                <i class="fas fa-chevron-right wc-arrow"></i>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
</body>
</html>
