<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Preview — Núcleo TI | Unio</title>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/unio-app.min.css') }}?v=276">
    <style>
        html, body { height: 100%; overflow: hidden; margin: 0; }
        body { background: var(--bg); display: flex; align-items: center; justify-content: center; padding: 28px; }
        #capture-root {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--border-2);
            box-shadow: 0 8px 40px rgba(15,23,42,0.12);
        }
        .preview-shell {
            display: grid;
            grid-template-columns: 260px 1fr;
            width: 1340px;
            height: 840px;
            overflow: hidden;
        }
        .preview-sidebar {
            background: var(--sidebar-bg) !important;
            border-right: 1px solid var(--border);
            height: 100%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .preview-brand {
            padding: 16px 18px 14px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }
        .preview-brand img { height: 26px; width: auto; }
        .preview-brand-sub {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 500;
            margin-top: 3px;
        }
        .preview-nav { flex: 1; padding: 8px 0; overflow: hidden; }
        .preview-nav-section {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--text-3);
            padding: 10px 16px 4px;
        }
        .preview-main {
            background: var(--bg);
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .preview-topbar {
            height: 54px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 14px;
            flex-shrink: 0;
            background: var(--bg);
        }
        .preview-topbar-title {
            flex: 1;
            min-width: 0;
        }
        .preview-topbar-title h1 {
            font-family: 'Sora', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-1);
            margin: 0;
            letter-spacing: -0.02em;
        }
        .preview-topbar-title p {
            font-size: 11px;
            color: var(--text-3);
            margin: 1px 0 0;
        }
        .preview-topbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .preview-content {
            flex: 1;
            padding: 16px 20px 20px;
            overflow: hidden;
        }
        /* Toolbar de filtros */
        .preview-filters {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 18px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
        }
        .preview-filter-select {
            height: 32px;
            padding: 0 10px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--control-bg);
            color: var(--text-2);
            font-size: 12px;
            font-family: inherit;
        }
        .preview-filter-input {
            flex: 1;
            max-width: 240px;
            height: 32px;
            padding: 0 10px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-3);
            font-size: 12px;
            font-family: inherit;
        }
        /* Badges topo TI */
        .ti-pulse-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface);
            font-size: 11px;
            font-weight: 600;
            color: var(--text-2);
        }
        .ti-pulse-chip--ok { border-color: rgba(62, 207, 142, 0.3); background: rgba(62,207,142,0.1); color: #3ECF8E; }
        .ti-pulse-chip--warn { border-color: rgba(224,80,80,0.3); background: rgba(224,80,80,0.1); color: #E05050; }
    </style>
</head>
<body>
<div class="preview-shell" id="capture-root">
    <aside class="preview-sidebar">
        <div class="preview-brand">
            {% include 'components/platform_logo.html.twig' with { variant: 'full' } only %}
        </div>
        <nav class="preview-nav">
            <span class="preview-nav-section">Navegação</span>
            <ul class="nav nav-sidebar flex-column" role="menu">
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-gauge-high nav-icon"></i>
                        <p>Dashboard</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-building nav-icon"></i>
                        <p>Operações</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-id-card nav-icon"></i>
                        <p>Recursos Humanos</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link active">
                        <i class="fas fa-tower-broadcast nav-icon"></i>
                        <p>Núcleo TI</p>
                    </a>
                </li>
            </ul>
            <span class="preview-nav-section">Módulos TI</span>
            <ul class="nav nav-sidebar flex-column" role="menu">
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link active">
                        <i class="fas fa-headset nav-icon"></i>
                        <p>Chamados</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-gauge-high nav-icon"></i>
                        <p>NOC · Live Ops</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-desktop nav-icon"></i>
                        <p>Ativos</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-key nav-icon"></i>
                        <p>Licenças</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-plug nav-icon"></i>
                        <p>Integrações</p>
                    </a>
                </li>
                <li class="nav-item sidebar-hub-pick-item">
                    <a href="#" class="nav-link">
                        <i class="fas fa-chart-line nav-icon"></i>
                        <p>Analytics</p>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <div class="preview-main">
        <header class="preview-topbar">
            <div class="preview-topbar-title">
                <h1>Chamados</h1>
                <p>Núcleo TI · Service desk &amp; NOC · Unio 2 · Tecnologia</p>
            </div>
            <div class="preview-topbar-actions">
                <span class="ti-pulse-chip ti-pulse-chip--ok"><i class="fas fa-chart-line"></i> SLA 94%</span>
                <span class="ti-pulse-chip"><i class="fas fa-inbox"></i> 24 abertos</span>
                <span class="ti-pulse-chip ti-pulse-chip--warn"><i class="fas fa-fire"></i> 2 P1</span>
                <button type="button" class="btn-unio btn-sm">
                    <i class="fas fa-plus mr-1"></i> Abrir chamado
                </button>
            </div>
        </header>

        <div class="preview-content">
            {# KPIs #}
            <div class="row stats-row mb-3">
                <div class="col-lg-3 col-md-6 d-flex">
                    <div class="unio-card stat-card w-100">
                        <div class="card-icon"><i class="fas fa-layer-group"></i></div>
                        <div class="stat-card-body">
                            <div class="card-value">24</div>
                            <div class="card-label">Total no funil</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex">
                    <div class="unio-card stat-card w-100">
                        <div class="card-icon"><i class="fas fa-inbox"></i></div>
                        <div class="stat-card-body">
                            <div class="card-value">6</div>
                            <div class="card-label">Novos · triagem</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex">
                    <div class="unio-card stat-card w-100">
                        <div class="card-icon"><i class="fas fa-gears"></i></div>
                        <div class="stat-card-body">
                            <div class="card-value">8</div>
                            <div class="card-label">Em execução</div>
                        </div>
                        <div class="stat-trend stat-trend--up"><i class="fas fa-arrow-up"></i></div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex">
                    <div class="unio-card stat-card w-100">
                        <div class="card-icon"><i class="fas fa-check"></i></div>
                        <div class="stat-card-body">
                            <div class="card-value">10</div>
                            <div class="card-label">Resolvidos</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Tabela #}
            <div class="unio-card" style="padding: 0; overflow: hidden;">
                <div class="section-header--in-card" style="padding: 16px 18px 0;">
                    <div class="section-header-text">
                        <div class="section-title">Fila de chamados</div>
                        <div class="section-subtitle">24 registros · P1 → P4, depois data de abertura</div>
                    </div>
                </div>

                <div class="preview-filters">
                    <select class="preview-filter-select">
                        <option>Todos status</option>
                    </select>
                    <select class="preview-filter-select">
                        <option>Prioridade</option>
                    </select>
                    <select class="preview-filter-select">
                        <option>Categoria</option>
                    </select>
                    <input class="preview-filter-input" type="text" placeholder="Buscar chamado, técnico ou categoria…" readonly>
                </div>

                <table class="table table-unio table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Chamado</th>
                            <th>Status</th>
                            <th>Categoria</th>
                            <th>Solicitante</th>
                            <th>SLA</th>
                            <th>Aberto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div style="display:flex;align-items:flex-start;gap:8px;">
                                    <span class="status-badge status-badge--danger ti-badge ti-badge-priority ti-badge-priority--p1">P1</span>
                                    <div>
                                        <div style="font-weight:600;color:var(--text-1);font-size:13px;">Indisponibilidade VPN corporativa</div>
                                        <div style="font-size:11px;color:var(--text-3);">#TI-1042 · War Room · há 12 min</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-badge status-badge--secondary ti-badge">Em execução</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Infra</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Carlos M.</span></td>
                            <td><span class="status-badge status-badge--danger ti-badge">Crítico</span></td>
                            <td><span style="font-size:11px;color:var(--text-3);">hoje 09:04</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div style="display:flex;align-items:flex-start;gap:8px;">
                                    <span class="status-badge status-badge--warning ti-badge ti-badge-priority ti-badge-priority--p2">P2</span>
                                    <div>
                                        <div style="font-weight:600;color:var(--text-1);font-size:13px;">Provisionamento de acesso — novo colaborador</div>
                                        <div style="font-size:11px;color:var(--text-3);">#TI-1038 · Service desk · técnico Ana R.</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-badge status-badge--secondary ti-badge">Em execução</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Acesso</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">RH · Admissão</span></td>
                            <td><span class="status-badge status-badge--success ti-badge">No prazo</span></td>
                            <td><span style="font-size:11px;color:var(--text-3);">hoje 08:30</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div style="display:flex;align-items:flex-start;gap:8px;">
                                    <span class="status-badge status-badge--warning ti-badge ti-badge-priority ti-badge-priority--p2">P2</span>
                                    <div>
                                        <div style="font-weight:600;color:var(--text-1);font-size:13px;">Falha no conector ERP → folha</div>
                                        <div style="font-size:11px;color:var(--text-3);">#TI-1031 · Integrações · fila DLQ · há 1h</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-badge status-badge--info ti-badge">Novo</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Integração</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Financeiro</span></td>
                            <td><span class="status-badge status-badge--success ti-badge">No prazo</span></td>
                            <td><span style="font-size:11px;color:var(--text-3);">hoje 08:15</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div style="display:flex;align-items:flex-start;gap:8px;">
                                    <span class="status-badge status-badge--secondary ti-badge ti-badge-priority ti-badge-priority--p3">P3</span>
                                    <div>
                                        <div style="font-weight:600;color:var(--text-1);font-size:13px;">Renovação de licença Microsoft 365</div>
                                        <div style="font-size:11px;color:var(--text-3);">#TI-1024 · Ativos · 45 seats · vence em 18d</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-badge status-badge--info ti-badge">Novo</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Licença</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">TI</span></td>
                            <td><span class="status-badge status-badge--success ti-badge">No prazo</span></td>
                            <td><span style="font-size:11px;color:var(--text-3);">ontem</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div style="display:flex;align-items:flex-start;gap:8px;">
                                    <span class="status-badge status-badge--secondary ti-badge ti-badge-priority ti-badge-priority--p3">P3</span>
                                    <div>
                                        <div style="font-weight:600;color:var(--text-1);font-size:13px;">Impressora financeiro offline</div>
                                        <div style="font-size:11px;color:var(--text-3);">#TI-1019 · Facilities · solicitante João M.</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-badge status-badge--success ti-badge">Resolvido</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">Hardware</span></td>
                            <td><span style="font-size:12px;color:var(--text-2);">João M.</span></td>
                            <td><span class="status-badge status-badge--success ti-badge">Cumprido</span></td>
                            <td><span style="font-size:11px;color:var(--text-3);">ontem</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</body>
</html>
