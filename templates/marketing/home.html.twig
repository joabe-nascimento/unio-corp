    {# ── Dashboard preview Hub TI ── #}
    <section class="mkt-section" id="dashboard-preview" aria-labelledby="mkt-dash-title">
        <div class="mkt-section-head mkt-section-head--split">
            <div class="mkt-section-head-main">
                <p class="mkt-section-eyebrow">Hub TI — visão operacional</p>
