            <img class="mkt-hero-deco mkt-hero-deco--orbit" src="{{ asset('images/auth/deco-orbit.svg') }}" alt="">
            <img class="mkt-hero-deco mkt-hero-deco--chip" src="{{ asset('images/auth/deco-chip.svg') }}" alt="">
