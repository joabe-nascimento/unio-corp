                    <span class="mkt-bar-label">Recrutamento</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:82%"></div></div>
                    <span class="mkt-bar-pct">82%</span>
                </div>
                <div class="mkt-bar-row">
                    <span class="mkt-bar-label">Operações</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:76%"></div></div>
