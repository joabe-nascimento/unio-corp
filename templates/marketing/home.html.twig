<script>
(function () {
    function animateCount(el) {
        var target = parseInt(el.dataset.to, 10);
        var duration = 1400;
        var start = null;
        function step(ts) {
            if (!start) start = ts;
            var progress = Math.min((ts - start) / duration, 1);
            var ease = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(ease * target);
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target;
        }
        requestAnimationFrame(step);
    }
    var counters = document.querySelectorAll('.mkt-count');
    if (counters.length && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) { animateCount(e.target); io.unobserve(e.target); }
            });
        }, { threshold: 0.4 });
        counters.forEach(function(c) { io.observe(c); });
    } else {
        counters.forEach(function(c) { c.textContent = c.dataset.to; });
    }

    if ('IntersectionObserver' in window) {
        var barIo = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) { e.target.classList.add('mkt-bars--visible'); barIo.unobserve(e.target); }
            });
        }, { threshold: 0.2 });
        document.querySelectorAll('.mkt-bars, .mkt-dash-bar-chart, .mkt-sla-bars').forEach(function(el) { barIo.observe(el); });
    } else {
        document.querySelectorAll('.mkt-bars, .mkt-dash-bar-chart, .mkt-sla-bars').forEach(function(el) { el.classList.add('mkt-bars--visible'); });
    }

    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var icon = document.getElementById('guestThemeIcon');
        if (icon) icon.className = t === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        var btn = document.getElementById('guestThemeToggle');
        if (btn) { btn.title = t === 'dark' ? 'Ativar tema claro' : 'Ativar tema escuro'; btn.setAttribute('aria-label', btn.title); }
    }
    var saved = localStorage.getItem('unio-theme') || document.documentElement.getAttribute('data-theme') || 'light';
    applyTheme(saved);

    function bindThemeToggle(id) {
        var btn = document.getElementById(id);
        if (!btn) return;
        btn.addEventListener('click', function () {
            var cur = document.documentElement.getAttribute('data-theme') || 'light';
            var next = cur === 'dark' ? 'light' : 'dark';
            localStorage.setItem('unio-theme', next);
            applyTheme(next);
            var fi = document.getElementById('footerThemeIcon');
            if (fi) fi.className = next === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        });
    }
    bindThemeToggle('guestThemeToggle');
    bindThemeToggle('footerThemeToggle');
})();
</script>

