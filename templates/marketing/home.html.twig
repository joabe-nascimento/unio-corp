                </div>
                <div class="mkt-who-item">
                    <i class="fas fa-headset" aria-hidden="true"></i>
                    <div><strong>Equipes de TI</strong><span>Chamados, SLA, ativos e NOC</span></div>
                </div>
                <div class="mkt-who-item">
                    <i class="fas fa-briefcase" aria-hidden="true"></i>
                    <div><strong>Recrutadores</strong><span>Vagas, pipeline e banco de talentos</span></div>
                </div>
                <div class="mkt-who-item">
                    <i class="fas fa-crown" aria-hidden="true"></i>
                    <div><strong>Administradores</strong><span>Multi-empresa, white-label e controle</span></div>
                </div>
            </div>
        </section>
