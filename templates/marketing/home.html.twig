                <div class="mkt-hero-stats">
                    <div class="mkt-hero-stat">
                        <strong>30+</strong>
                        <span>Núcleos disponíveis</span>
                    </div>
                    <div class="mkt-hero-stat">
                        <strong>Multi-empresa</strong>
                        <span>Workspaces isolados</span>
                    </div>
                    <div class="mkt-hero-stat">
                        <strong>Vitória IA</strong>
                        <span>Copiloto contextual</span>
                    </div>
                </div>
            </div>
            <div class="mkt-hero-visual" aria-hidden="true">
                <div class="mkt-hero-card">
                    <div class="mkt-hero-card-head">
                        <span class="mkt-hero-card-dot"></span>
                        <span class="mkt-hero-card-label">Painel {{ _pnome }} — visão geral</span>
                    </div>
                    <div class="mkt-hero-card-rows">
                        <div class="mkt-hero-card-row">
                            <span class="mkt-hero-card-icon"><i class="fas fa-id-card"></i></span>
                            <span class="mkt-hero-card-text">
                                <strong>RH operacional completo</strong>
                                <span>Admissão, férias, folha e offboarding</span>
                            </span>
                        </div>
                        <div class="mkt-hero-card-row">
                            <span class="mkt-hero-card-icon"><i class="fas fa-headset"></i></span>
                            <span class="mkt-hero-card-text">
                                <strong>Hub TI — Service desk</strong>
                                <span>Chamados, SLA, P1 e infraestrutura</span>
                            </span>
                        </div>
                        <div class="mkt-hero-card-row">
                            <span class="mkt-hero-card-icon"><i class="fas fa-briefcase"></i></span>
                            <span class="mkt-hero-card-text">
                                <strong>Recrutamento</strong>
                                <span>Vagas, banco de talentos e pipeline</span>
                            </span>
                        </div>
                        <div class="mkt-hero-card-row">
                            <span class="mkt-hero-card-icon"><i class="fas fa-building"></i></span>
                            <span class="mkt-hero-card-text">
                                <strong>Multi-empresa nativo</strong>
                                <span>Troca de workspace em um clique</span>
                            </span>
                        </div>
