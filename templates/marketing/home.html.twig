{% set _tema = platform_config.tema|default('dark') %}
{% set _pnome = platform_config.plataforma_nome|default('Unio') %}
{% set _tagline = platform_config.plataforma_tagline|default('Plataforma de Gestão de Pessoas') %}
{% set _logo_custom = platform_asset_custom('full') %}
{% import 'macros/helix.html.twig' as helix %}

<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ _pnome }} — {{ _tagline }}</title>
    <meta name="description" content="{{ _pnome }}: plataforma multi-empresa com 30+ núcleos — RH operacional, Hub TI, Recrutamento, Bate-papo, Integrações e assistente inteligente Vitória.">
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('unio-theme')||'{{ _tema }}')}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
