                        Criar minha conta
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="mkt-footer">
    <div class="mkt-footer-inner">
        {% include 'components/platform_logo.html.twig' with {
