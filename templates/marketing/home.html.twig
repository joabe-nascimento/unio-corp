<body class="marketing-home">

<header class="mkt-header">
    <div class="mkt-header-inner">
        <a href="{{ path('app_home') }}" class="mkt-brand" title="{{ _pnome }}">
            {% include 'components/platform_logo.html.twig' with {
                variant: 'full',
                class: 'mkt-logo' ~ (_logo_custom ? ' mkt-logo--custom' : ' mkt-logo--default')
            } only %}
        </a>
        <nav class="mkt-nav" aria-label="Navegação principal">
            <a href="#recursos">Recursos</a>
            <a href="#nucleos">Núcleos</a>
            <a href="#hub-ti">Hub TI</a>
            <a href="#como-funciona">Como funciona</a>
            <a href="#vitoria">Vitória</a>
            <a href="#faq">FAQ</a>
            <a href="#comecar">Começar</a>
        </nav>
        <div class="mkt-header-actions">
            <button type="button" class="mkt-theme-btn" id="guestThemeToggle" title="Alternar tema" aria-label="Alternar tema">
                <i class="fas fa-sun" id="guestThemeIcon" aria-hidden="true"></i>
            </button>
            <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--ghost">Entrar</a>
            {% if platform_config.registro_publico ?? true %}
            <a href="{{ path('app_register') }}" class="mkt-btn mkt-btn--primary">Criar conta</a>
            {% else %}
            <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--primary">Acessar plataforma</a>
            {% endif %}
        </div>
    </div>
</header>

