{% set _tema = platform_config.tema|default('dark') %}
{% set _pnome = platform_config.plataforma_nome|default('Unio') %}
{% set _tagline = platform_config.plataforma_tagline|default('Plataforma de Gestão de Pessoas') %}
{% set _logo_custom = platform_asset_custom('full') %}
{% import 'macros/helix.html.twig' as helix %}

<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ _pnome }} — {{ _tagline }}</title>
    <meta name="description" content="{{ _pnome }}: plataforma multi-empresa com 30+ núcleos — RH operacional, Hub TI, Recrutamento, Bate-papo, Integrações e assistente inteligente Vitória.">
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('unio-theme')||'{{ _tema }}')}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/marketing-home.css') }}?v=16">
    <link rel="stylesheet" href="{{ asset('css/marketing-home-v2.css') }}?v=2">
</head>
<body class="marketing-home mkt-v2">

<header class="mkt-header mkt-header--v2">
    <div class="mkt-header-inner mkt-header-inner--v2">
        <a href="{{ path('app_home') }}" class="mkt-brand mkt-brand--v2" title="{{ _pnome }}">
            {% include 'components/platform_logo.html.twig' with {
                variant: 'full',
                class: 'mkt-logo mkt-logo--v2' ~ (_logo_custom ? ' mkt-logo--custom' : ' mkt-logo--default')
            } only %}
        </a>
        <nav class="mkt-nav mkt-nav--v2" aria-label="Navegação principal">
            <a href="#recursos">Recursos</a>
            <a href="#nucleos">Núcleos</a>
            <a href="#modulos">Módulos</a>
            <a href="#vitoria">Vitória</a>
            <a href="#comparacao">Comparar</a>
            <a href="#faq">FAQ</a>
        </nav>
        <div class="mkt-header-actions mkt-header-actions--v2">
            <button type="button" class="mkt-theme-btn mkt-theme-btn--v2" id="guestThemeToggle" title="Alternar tema" aria-label="Alternar tema">
                <i class="fas fa-sun" id="guestThemeIcon" aria-hidden="true"></i>
            </button>
            <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--ghost-v2">Entrar</a>
            {% if platform_config.registro_publico ?? true %}
            <a href="{{ path('app_register') }}" class="mkt-btn mkt-btn--glow">Começar grátis</a>
            {% else %}
            <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--glow">Acessar plataforma</a>
            {% endif %}
        </div>
    </div>
</header>

<main>
    {# ── Hero v2 ── #}
    <section class="mkt-hero mkt-hero--v2" aria-labelledby="mkt-hero-title">
        <div class="mkt-hero-v2-bg" aria-hidden="true">
            <div class="mkt-hero-v2-grid"></div>
            <div class="mkt-hero-v2-orb mkt-hero-v2-orb--cyan"></div>
            <div class="mkt-hero-v2-orb mkt-hero-v2-orb--indigo"></div>
        </div>
        <div class="mkt-hero-inner mkt-hero-inner--v2">
            <div class="mkt-hero-copy mkt-hero-copy--v2">
                <p class="mkt-hero-eyebrow mkt-hero-eyebrow--v2">
                    <span class="mkt-hero-eyebrow-dot"></span>
                    Plataforma multi-empresa · 30+ núcleos
                </p>
                <h1 class="mkt-hero-title mkt-hero-title--v2" id="mkt-hero-title">
                    Gestão de pessoas e operações,
                    <span class="mkt-gradient-text">unificadas</span>
                </h1>
                <p class="mkt-hero-lead mkt-hero-lead--v2">
                    {{ _pnome }} conecta RH, Hub TI, Recrutamento e Integrações em workspaces isolados —
                    com permissões granulares, white-label e a copiloto Vitória.
                </p>
                <div class="mkt-hero-cta mkt-hero-cta--v2">
                    <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--glow mkt-btn--lg">
                        Entrar na plataforma
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    {% if platform_config.registro_publico ?? true %}
                    <a href="{{ path('app_register') }}" class="mkt-btn mkt-btn--surface mkt-btn--lg">Criar conta</a>
                    {% endif %}
                </div>
                <div class="mkt-hero-chips">
                    <span class="mkt-hero-chip"><i class="fas fa-shield-halved" aria-hidden="true"></i> LGPD</span>
                    <span class="mkt-hero-chip"><i class="fas fa-building" aria-hidden="true"></i> Multi-empresa</span>
                    <span class="mkt-hero-chip"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> Vitória IA</span>
                </div>
            </div>
            <div class="mkt-hero-visual mkt-hero-visual--v2" aria-hidden="true">
                <div class="mkt-preview">
                    <div class="mkt-preview-chrome">
                        <span class="mkt-preview-dot mkt-preview-dot--r"></span>
                        <span class="mkt-preview-dot mkt-preview-dot--y"></span>
                        <span class="mkt-preview-dot mkt-preview-dot--g"></span>
                        <span class="mkt-preview-url">uniowork.com.br — dashboard</span>
                    </div>
                    <div class="mkt-preview-layout">
                        <div class="mkt-preview-sidebar">
                            <span class="mkt-preview-nav-item mkt-preview-nav-item--active"><i class="fas fa-grip"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-id-card"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-headset"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-briefcase"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-plug"></i></span>
                        </div>
                        <div class="mkt-preview-main">
                            <div class="mkt-preview-kpis">
                                <div class="mkt-preview-kpi"><strong>248</strong><span>Colaboradores</span></div>
                                <div class="mkt-preview-kpi"><strong>12</strong><span>Chamados abertos</span></div>
                                <div class="mkt-preview-kpi mkt-preview-kpi--accent"><strong>98%</strong><span>SLA TI</span></div>
                            </div>
                            <div class="mkt-preview-modules">
                                <div class="mkt-preview-module">
                                    <i class="fas fa-id-card" aria-hidden="true"></i>
                                    <div><strong>RH operacional</strong><span>Admissão, férias, folha</span></div>
                                </div>
                                <div class="mkt-preview-module">
                                    <i class="fas fa-headset" aria-hidden="true"></i>
                                    <div><strong>Hub TI</strong><span>Chamados, SLA, P1</span></div>
                                </div>
                                <div class="mkt-preview-module">
                                    <i class="fas fa-briefcase" aria-hidden="true"></i>
                                    <div><strong>Recrutamento</strong><span>Vagas e pipeline</span></div>
                                </div>
                                <div class="mkt-preview-module mkt-preview-module--highlight">
                                    <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                                    <div><strong>Vitória</strong><span>Copiloto contextual</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── Faixa de confiança empresarial ── #}
    <div class="mkt-pro-strip" aria-label="Diferenciais empresariais">
        <div class="mkt-pro-strip-inner">
            <div class="mkt-pro-badge">
                <i class="fas fa-shield-halved" aria-hidden="true"></i>
                <div><strong>LGPD conforme</strong><span>Auditoria e consentimento</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-building" aria-hidden="true"></i>
                <div><strong>Multi-empresa nativo</strong><span>Workspaces isolados</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-key" aria-hidden="true"></i>
                <div><strong>85+ permissões</strong><span>Controle por perfil e núcleo</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-palette" aria-hidden="true"></i>
                <div><strong>White-label</strong><span>Identidade por workspace</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-code" aria-hidden="true"></i>
                <div><strong>API &amp; Webhooks</strong><span>Integração com ecossistema</span></div>
            </div>
        </div>
    </div>

    {# ── Plataforma em números ── #}
    <div class="mkt-section-wrap mkt-section-wrap--alt">
    <section class="mkt-section mkt-section--metrics" id="metricas" aria-labelledby="mkt-metrics-title">
        <div class="mkt-section-head mkt-section-head--split">
            <div class="mkt-section-head-main">
                <p class="mkt-section-eyebrow">Plataforma em números</p>
                <h2 class="mkt-section-title" id="mkt-metrics-title">Escala real para operações reais</h2>
            </div>
            <p class="mkt-section-sub mkt-section-sub--left">Indicadores que refletem a profundidade da {{ _pnome }} — de permissões granulares a cobertura funcional cross-hub.</p>
        </div>

        <div class="mkt-metric-grid">
            <div class="mkt-metric-card">
                <div class="mkt-metric-icon"><i class="fas fa-cubes" aria-hidden="true"></i></div>
                <div class="mkt-metric-val"><span class="mkt-count" data-to="30">0</span><sup>+</sup></div>
                <span class="mkt-metric-label">Núcleos disponíveis</span>
                <span class="mkt-metric-sub">RH, TI, Recrutamento e mais</span>
            </div>
            <div class="mkt-metric-card">
                <div class="mkt-metric-icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></div>
                <div class="mkt-metric-val"><span class="mkt-count" data-to="85">0</span><sup>+</sup></div>
                <span class="mkt-metric-label">Permissões configuráveis</span>
                <span class="mkt-metric-sub">Controle granular por perfil</span>
            </div>
            <div class="mkt-metric-card">
                <div class="mkt-metric-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
                <div class="mkt-metric-val"><span class="mkt-count" data-to="7">0</span></div>
                <span class="mkt-metric-label">Categorias de hub</span>
                <span class="mkt-metric-sub">Pessoas, TI, Operações e mais</span>
            </div>
            <div class="mkt-metric-card mkt-metric-card--accent">
                <div class="mkt-metric-icon"><i class="fas fa-building" aria-hidden="true"></i></div>
                <div class="mkt-metric-val"><span class="mkt-count" data-to="100">0</span><sup>%</sup></div>
                <span class="mkt-metric-label">Multi-empresa nativo</span>
                <span class="mkt-metric-sub">Workspaces totalmente isolados</span>
            </div>
        </div>

        <div class="mkt-coverage-chart">
            <h3 class="mkt-chart-title">Cobertura por área funcional</h3>
            <div class="mkt-bars">
                <div class="mkt-bar-row">
                    <span class="mkt-bar-label">RH e Pessoas</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:95%"></div></div>
                    <span class="mkt-bar-pct">95%</span>
                </div>
                <div class="mkt-bar-row">
                    <span class="mkt-bar-label">TI e Infraestrutura</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:88%"></div></div>
                    <span class="mkt-bar-pct">88%</span>
                </div>
                <div class="mkt-bar-row">
                    <span class="mkt-bar-label">Recrutamento</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:82%"></div></div>
                    <span class="mkt-bar-pct">82%</span>
                </div>
                <div class="mkt-bar-row">
                    <span class="mkt-bar-label">Operações</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:76%"></div></div>
                    <span class="mkt-bar-pct">76%</span>
                </div>
                <div class="mkt-bar-row">
                    <span class="mkt-bar-label">Integrações &amp; APIs</span>
                    <div class="mkt-bar-track"><div class="mkt-bar-fill" style="--pct:70%"></div></div>
                    <span class="mkt-bar-pct">70%</span>
                </div>
            </div>
            <p class="mkt-chart-note">* Cobertura estimada de processos típicos por área em relação a ferramentas especializadas individuais.</p>
        </div>
    </section>
    </div>

    {# ── Recursos ── #}
    <section class="mkt-section" id="recursos" aria-labelledby="mkt-features-title">
        <div class="mkt-section-head mkt-section-head--split">
            <div class="mkt-section-head-main">
                <p class="mkt-section-eyebrow">Recursos</p>
                <h2 class="mkt-section-title" id="mkt-features-title">Tudo que sua operação precisa — em um único lugar</h2>
            </div>
            <p class="mkt-section-sub mkt-section-sub--left">Módulos pensados para RH, TI, recrutamento e operações — com governança, clareza e escala corporativa.</p>
        </div>
        <div class="mkt-features">
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-id-card" aria-hidden="true"></i></div>
                <h3>RH de ponta a ponta</h3>
                <p>Funcionários, admissão, demissão, férias, folha e documentos — com trilha de auditoria e fluxos operacionais.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-headset" aria-hidden="true"></i></div>
                <h3>Hub TI — Service desk</h3>
                <p>Chamados, SLA, NOC, gestão de ativos, licenças, integrações e War Room para incidentes P1.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-briefcase" aria-hidden="true"></i></div>
                <h3>Recrutamento completo</h3>
                <p>Vagas, banco de talentos, pipeline de seleção, página de carreiras pública e analytics de contratação.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></div>
                <h3>Permissões granulares</h3>
                <p>Controle fino por perfil, núcleo e produto. Cada usuário acessa apenas o que foi liberado para seu papel.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-comments" aria-hidden="true"></i></div>
                <h3>Bate-papo integrado</h3>
                <p>Chat em tempo real entre membros, galeria de mídia e histórico por workspace — sem sair da plataforma.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-palette" aria-hidden="true"></i></div>
                <h3>White-label</h3>
                <p>Logo, cores, slogan, tema claro ou escuro e identidade visual completa configuráveis pelo administrador.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-plug" aria-hidden="true"></i></div>
                <h3>Hub de integrações</h3>
                <p>Conectores, webhooks e observabilidade causal — com Dead Letter Queue e SLO por fluxo de negócio.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-bell" aria-hidden="true"></i></div>
                <h3>Notificações e central</h3>
                <p>Dashboard, notificações persistentes, busca global e navegação por núcleos em toda a plataforma.</p>
            </article>
            <article class="mkt-feature">
                <div class="mkt-feature-icon"><i class="fas fa-mobile-screen" aria-hidden="true"></i></div>
                <h3>Responsivo e mobile</h3>
                <p>Interface adaptada a desktop e mobile, com filtros, busca e FAB otimizados para telas pequenas.</p>
            </article>
        </div>
    </section>

    {# ── Visão empresarial ── #}
    <div class="mkt-section-wrap mkt-section-wrap--alt">
    <section class="mkt-section" id="empresarial" aria-labelledby="mkt-enterprise-title">
        <div class="mkt-section-head mkt-section-head--split">
            <div class="mkt-section-head-main">
                <p class="mkt-section-eyebrow">Visão empresarial</p>
                <h2 class="mkt-section-title" id="mkt-enterprise-title">Arquitetura pensada para grupos, holdings e operações complexas</h2>
            </div>
            <p class="mkt-section-sub mkt-section-sub--left">Governança, isolamento de dados e integração nativa — sem depender de dezenas de ferramentas desconectadas.</p>
        </div>
        <div class="mkt-pillars">
            <article class="mkt-pillar">
                <div class="mkt-pillar-icon"><i class="fas fa-sitemap" aria-hidden="true"></i></div>
                <h3>Governança centralizada</h3>
                <p>Perfis, permissões e políticas definidos uma vez — aplicados em todos os núcleos e workspaces. Admins controlam quem vê o quê, por empresa e por módulo.</p>
                <ul class="mkt-pillar-list">
                    <li>85+ permissões configuráveis</li>
                    <li>Controle por núcleo e produto</li>
                    <li>Trilha de auditoria completa</li>
                </ul>
            </article>
            <article class="mkt-pillar">
                <div class="mkt-pillar-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
                <h3>Multi-empresa nativo</h3>
                <p>Cada workspace opera de forma independente — dados, usuários, branding e configurações isolados. Ideal para grupos com múltiplas unidades ou marcas.</p>
                <ul class="mkt-pillar-list">
                    <li>Troca de workspace em 1 clique</li>
                    <li>White-label por empresa</li>
                    <li>Identidade visual configurável</li>
                </ul>
            </article>
            <article class="mkt-pillar">
                <div class="mkt-pillar-icon"><i class="fas fa-plug" aria-hidden="true"></i></div>
                <h3>Integração sem silos</h3>
                <p>RH, TI e Recrutamento compartilham a mesma base de pessoas, permissões e histórico. Conectores e webhooks eliminam integrações manuais entre sistemas.</p>
                <ul class="mkt-pillar-list">
                    <li>Hub de integrações observável</li>
                    <li>API REST &amp; webhooks</li>
                    <li>Dead Letter Queue e SLO</li>
                </ul>
            </article>
            <article class="mkt-pillar">
                <div class="mkt-pillar-icon"><i class="fas fa-chart-line" aria-hidden="true"></i></div>
                <h3>Inteligência operacional</h3>
                <p>Dashboards, analytics cross-hub e a copiloto Vitória transformam dados dispersos em decisões rápidas — do chamado P1 ao pipeline de contratação.</p>
                <ul class="mkt-pillar-list">
                    <li>Cortex Analytics integrado</li>
                    <li>MTTR, SLA e CSAT em tempo real</li>
                    <li>Vitória IA contextualizada</li>
                </ul>
            </article>
        </div>
    </section>
    </div>

    {# ── Como funciona + Para quem é ── #}
    <div class="mkt-section-wrap mkt-section-wrap--alt">
        <section class="mkt-section" id="como-funciona" aria-labelledby="mkt-steps-title">
            <div class="mkt-section-head mkt-section-head--split">
                <div class="mkt-section-head-main">
                    <p class="mkt-section-eyebrow">Como funciona</p>
                    <h2 class="mkt-section-title" id="mkt-steps-title">Do acesso ao resultado em quatro passos</h2>
                </div>
                <p class="mkt-section-sub mkt-section-sub--left">Uma jornada clara para qualquer perfil — sem fricção, sem configuração complexa.</p>
