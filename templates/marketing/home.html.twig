                <details class="mkt-faq-item">
                    <summary>Como funciona o Recrutamento?</summary>
                    <p>Você abre vagas, gerencia candidatos em pipeline Kanban, consulta o banco de talentos, publica uma página de carreiras pública e acompanha analytics de contratação — tudo no mesmo workspace.</p>
                </details>
                <details class="mkt-faq-item">
                    <summary>A Vitória já responde automaticamente?</summary>
                    <p>A Vitória é um copiloto contextual integrado à interface — responde dúvidas sobre módulos, fluxos e indicadores com base no seu workspace e perfil, e está em evolução contínua.</p>
                </details>
                <details class="mkt-faq-item">
                    <summary>Posso personalizar a identidade visual?</summary>
                    <p>Administradores configuram logo, slogan, cores, tema padrão (claro ou escuro) e informações de suporte diretamente nas configurações da plataforma — sem código.</p>
                </details>
            </div>
        </section>
    </div>

    {# ── CTA final ── #}
    <section class="mkt-section" id="comecar" aria-labelledby="mkt-cta-title">
        <div class="mkt-cta-banner">
            <div class="mkt-cta-banner-inner">
                <h2 id="mkt-cta-title">Pronto para unificar RH, TI e operações?</h2>
                <p>Acesse a {{ _pnome }}, escolha sua área de trabalho e comece com RH, Hub TI, Recrutamento e a Vitória ao seu lado.</p>
                <div class="mkt-cta-banner-actions">
                    <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--white">
                        <i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i>
                        Entrar agora
                    </a>
                    {% if platform_config.registro_publico ?? true %}
                    <a href="{{ path('app_register') }}" class="mkt-btn mkt-btn--outline-light">
                        Criar minha conta
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="mkt-footer">
    <div class="mkt-footer-inner">
        {% include 'components/platform_logo.html.twig' with {
            variant: 'full',
            class: 'mkt-footer-logo mkt-logo' ~ (_logo_custom ? ' mkt-logo--custom' : ' mkt-logo--default')
        } only %}
        <p class="mkt-footer-text">
            © {{ "now"|date("Y") }} {{ _pnome }}. {{ platform_config.rodape_texto|default(_tagline) }}
        </p>
        {% include 'components/platform_support.html.twig' %}
    </div>
</footer>

<script>
(function () {
    /* ── Animated counters ── */
    function animateCount(el) {
        var target = parseInt(el.dataset.to, 10);
        var duration = 1400;
        var start = null;
        function step(ts) {
            if (!start) start = ts;
            var progress = Math.min((ts - start) / duration, 1);
            var ease = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(ease * target);
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target;
        }
        requestAnimationFrame(step);
    }
    var observed = false;
    var counters = document.querySelectorAll('.mkt-count');
    if (counters.length && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) { animateCount(e.target); io.unobserve(e.target); }
            });
        }, { threshold: 0.4 });
        counters.forEach(function(c) { io.observe(c); });
    } else {
        counters.forEach(function(c) { c.textContent = c.dataset.to; });
    }

    /* ── Bar chart entrance ── */
    if ('IntersectionObserver' in window) {
        var barIo = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    e.target.classList.add('mkt-bars--visible');
                    barIo.unobserve(e.target);
                }
            });
        }, { threshold: 0.2 });
        document.querySelectorAll('.mkt-bars, .mkt-dash-bar-chart, .mkt-sla-bars').forEach(function(el) { barIo.observe(el); });
    } else {
        document.querySelectorAll('.mkt-bars, .mkt-dash-bar-chart, .mkt-sla-bars').forEach(function(el) { el.classList.add('mkt-bars--visible'); });
    }

    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var icon = document.getElementById('guestThemeIcon');
        if (icon) {
            icon.className = t === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        }
        var btn = document.getElementById('guestThemeToggle');
        if (btn) {
            btn.title = t === 'dark' ? 'Ativar tema claro' : 'Ativar tema escuro';
            btn.setAttribute('aria-label', btn.title);
        }
    }

    var saved = localStorage.getItem('unio-theme')
        || localStorage.getItem('unio-theme')
        || document.documentElement.getAttribute('data-theme')
        || 'dark';
    applyTheme(saved);

    var toggle = document.getElementById('guestThemeToggle');
    if (toggle) {
        toggle.addEventListener('click', function () {
            var cur = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = cur === 'dark' ? 'light' : 'dark';
            localStorage.setItem('unio-theme', next);
            applyTheme(next);
        });
    }
})();
</script>

</body>
</html>
