                            <span class="mkt-hero-card-icon"><i class="fas fa-wand-magic-sparkles"></i></span>
                            <span class="mkt-hero-card-text">
                                <strong>Vitória — assistente IA</strong>
                                <span>Copiloto contextual integrado</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

