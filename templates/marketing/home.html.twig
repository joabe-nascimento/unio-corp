            class: 'mkt-footer-logo mkt-logo' ~ (_logo_custom ? ' mkt-logo--custom' : ' mkt-logo--default')
        } only %}
        <p class="mkt-footer-text">
            © {{ "now"|date("Y") }} {{ _pnome }}. {{ platform_config.rodape_texto|default(_tagline) }}
        </p>
        {% include 'components/platform_support.html.twig' %}
    </div>
</footer>

<script>
(function () {
    function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        var icon = document.getElementById('guestThemeIcon');
        if (icon) {
            icon.className = t === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        }
        var btn = document.getElementById('guestThemeToggle');
        if (btn) {
            btn.title = t === 'dark' ? 'Ativar tema claro' : 'Ativar tema escuro';
            btn.setAttribute('aria-label', btn.title);
        }
    }

    var saved = localStorage.getItem('unio-theme')
        || localStorage.getItem('unio-theme')
        || document.documentElement.getAttribute('data-theme')
        || 'dark';
    applyTheme(saved);

    var toggle = document.getElementById('guestThemeToggle');
    if (toggle) {
        toggle.addEventListener('click', function () {
            var cur = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = cur === 'dark' ? 'light' : 'dark';
            localStorage.setItem('unio-theme', next);
            applyTheme(next);
        });
    }
})();
</script>

</body>
</html>
