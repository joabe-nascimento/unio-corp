{% set _tema = platform_config.tema|default('light') %}
{% set _pnome = platform_config.plataforma_nome|default('Unio') %}
{% set _logo_custom = platform_asset_custom('full') %}

<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ organismo.copy.brand_name|default('Unio Saúde') }} | {{ organismo.copy.marketing_tagline|default('Saúde que acompanha.') }}</title>
    <meta name="description" content="{{ organismo.copy.brand_name|default('Unio Saúde') }} | {{ organismo.copy.marketing_tagline|default('Saúde que acompanha.') }}">
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('unio-theme')||'{{ _tema }}')}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/marketing-home.css') }}?v=19">
    <link rel="stylesheet" href="{{ asset('css/marketing-home-v2.css') }}?v=5">
    {% if org_clinic|default(false) %}
    <link rel="stylesheet" href="{{ asset('css/marketing-home-rich.css') }}?v=34">
    <link rel="stylesheet" href="{{ asset('css/marketing-carteirinha.css') }}?v=35">
    <link rel="stylesheet" href="{{ asset('css/marketing-home-clinic.css') }}?v=77">
    <link rel="stylesheet" href="{{ asset('css/patient-demo-embed.css') }}?v=3">
    {% endif %}
    <style>
    /* ── Clínica overrides ── */
    :root {
        --mkt-accent: #4b72be;
        --mkt-accent-glow: rgba(75, 114, 190, 0.35);
        --mkt-accent-soft: #eaf0fb;
    }
    .marketing-home { font-family: 'Quicksand', 'Nunito', system-ui, sans-serif; }
    .marketing-home.mkt-clinic,
    .marketing-home.mkt-clinic button,
    .marketing-home.mkt-clinic input,
    .marketing-home.mkt-clinic select,
    .marketing-home.mkt-clinic textarea {
        font-family: 'Quicksand', 'Nunito', system-ui, sans-serif;
    }
    .marketing-home.mkt-clinic h1,
    .marketing-home.mkt-clinic h2,
    .marketing-home.mkt-clinic h3,
    .marketing-home.mkt-clinic h4,
    .marketing-home.mkt-clinic .mkt-hero-title--v2,
    .marketing-home.mkt-clinic .mkt-section-title,
    .marketing-home.mkt-clinic .mkt-btn {
        font-family: 'Quicksand', 'Nunito', system-ui, sans-serif !important;
        letter-spacing: -0.02em;
        font-weight: 700;
    }
    .marketing-home.mkt-clinic .mkt-hero-title--v2 {
        font-family: 'Nunito', 'Quicksand', system-ui, sans-serif !important;
        font-weight: 800 !important;
        -webkit-text-stroke: 0.2px currentColor;
    }
    .mkt-hero-eyebrow-dot { background: #4b72be !important; }
    .mkt-gradient-text { color: #4b72be; -webkit-text-fill-color: #4b72be; }
    .mkt-heva-accent { color: #4b72be; -webkit-text-fill-color: #4b72be; }
    [data-theme="light"] .mkt-gradient-text,
    [data-theme="light"] .mkt-heva-accent { color: #4b72be; -webkit-text-fill-color: #4b72be; }
    .mkt-btn--glow { background: #4b72be !important; box-shadow: 0 4px 20px rgba(75,114,190,.45) !important; }
    .mkt-hero-v2-orb--cyan { background: radial-gradient(circle at 40% 50%, rgba(75,114,190,.18) 0%, transparent 70%) !important; }
    .mkt-hero-v2-orb--indigo { background: radial-gradient(circle at 60% 50%, rgba(100,149,237,.14) 0%, transparent 70%) !important; }

    /* Preview sidebar, azul clínico */
    .mkt-preview-nav-item--active { background: #4b72be !important; color: #fff !important; }
    .mkt-preview-kpi--accent { color: #4b72be !important; }
    .mkt-preview-module--highlight { border-color: #4b72be !important; background: #eaf0fb !important; }
    .mkt-preview-module--highlight i { color: #4b72be !important; }
    [data-theme="dark"] .mkt-preview-module--highlight { border-color: rgba(75, 114, 190, 0.35) !important; background: rgba(75, 114, 190, 0.16) !important; }

    /* Feature icons */
    .mkt-feature-icon { display: none !important; }
    .mkt-pillar-icon { display: none !important; }
    .mkt-metric-icon { display: none !important; }
    .mkt-rich-module-card__icon { display: none !important; }
    .mkt-home-patient-products__icon { display: none !important; }
    .mkt-preview-module > i { display: none !important; }
    .mkt-metric-card--accent { background: var(--surface-2) !important; border-color: var(--border) !important; }
    .mkt-metric-card--accent .mkt-metric-val { color: #4b72be !important; }
    .mkt-bar-fill { background: #4b72be !important; }
    .mkt-outcome-val { color: #4b72be !important; }
    .mkt-step-num { background: #4b72be !important; color: #fff !important; }
    .mkt-who-item i { color: #4b72be !important; }
    .mkt-compare-yes i { color: #4b72be !important; }
    .mkt-compare-th--unio { background: #eaf0fb !important; }
    .mkt-compare-brand { color: #4b72be !important; }
    .mkt-compare-badge { background: #4b72be !important; }

    /* Clinic slogan */
    .clinic-hero-slogan {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #eaf0fb;
        color: #3d61a8;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.02em;
        margin-bottom: 16px;
    }
    .clinic-hero-slogan i { font-size: 12px; }

    /* Dashboard preview clinic */
    .mkt-preview-kpi strong { font-size: 1.1rem; }
    .mkt-preview-module i { color: #4b72be; }
    </style>
</head>
<body class="marketing-home mkt-v2{% if org_clinic|default(false) %} mkt-clinic{% endif %}">
{% import 'macros/marketing_protocol.html.twig' as protocol %}

<header class="mkt-header mkt-header--v2">
    <div class="mkt-header-inner mkt-header-inner--v2">
        <a href="{{ path('app_home') }}" class="mkt-brand mkt-brand--v2" title="{{ organismo.copy.brand_name|default('Unio Saúde') }}">
            {% include 'components/platform_logo.html.twig' with {
                variant: 'full',
                class: 'mkt-logo mkt-logo--v2' ~ (_logo_custom ? ' mkt-logo--custom' : ' mkt-logo--default')
            } only %}
        </a>
        <nav class="mkt-nav mkt-nav--v2 mkt-nav--clinic-products" id="mktMainNav" aria-label="Navegação principal">
            {% if org_clinic|default(false) %}
            {% include 'components/marketing/clinic_product_nav.html.twig' with { mkt_nav_active: 'home' } only %}
            {% else %}
            <a href="#recursos">Recursos</a>
            <a href="#modulos">Módulos</a>
            <a href="#funcionalidades">Funcionalidades</a>
            <a href="#como-funciona">Como funciona</a>
            {% endif %}
            {% if not org_clinic|default(false) %}
            <a href="#faq">FAQ</a>
            {% endif %}
        </nav>
        <div class="mkt-header-actions mkt-header-actions--v2">
            <button type="button" class="mkt-nav-toggle" id="mktNavToggle" aria-controls="mktMainNav" aria-expanded="false" aria-label="Abrir menu">
                <i class="fas fa-bars" aria-hidden="true" data-mkt-nav-icon></i>
            </button>
            <button type="button" class="mkt-theme-btn mkt-theme-btn--v2" id="guestThemeToggle" title="Alternar tema" aria-label="Alternar tema">
                <i class="fas fa-sun" id="guestThemeIcon" aria-hidden="true"></i>
            </button>
            <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--glow mkt-header-login">
                <span class="mkt-header-login__full">Acessar plataforma</span>
                <span class="mkt-header-login__short">Entrar</span>
            </a>
        </div>
    </div>
</header>

<main>
    {# ── Hero ── #}
    <section class="mkt-hero mkt-hero--v2" aria-labelledby="mkt-hero-title">
        <div class="mkt-hero-v2-bg" aria-hidden="true">
            <div class="mkt-hero-v2-grid"></div>
            <div class="mkt-hero-v2-orb mkt-hero-v2-orb--cyan"></div>
            <div class="mkt-hero-v2-orb mkt-hero-v2-orb--indigo"></div>
        </div>
        <div class="mkt-hero-inner mkt-hero-inner--v2">
            <div class="mkt-hero-copy mkt-hero-copy--v2">
                <span class="clinic-hero-slogan">
                    {% if org_clinic|default(false) %}
                    {{ organismo.copy.marketing_eyebrow|default('Atendimento clínico') }}
                    {% else %}
                    <i class="fas fa-code" aria-hidden="true"></i>
                    {{ organismo.copy.marketing_eyebrow|default('Studio digital') }}
                    {% endif %}
                </span>
                <p class="mkt-hero-eyebrow mkt-hero-eyebrow--v2">
                    <span class="mkt-hero-eyebrow-dot"></span>
                    {{ organismo.copy.marketing_tagline|default('Saúde que acompanha.') }}
                </p>
                <h1 class="mkt-hero-title mkt-hero-title--v2" id="mkt-hero-title">
                    {% if org_clinic|default(false) %}
                        {% if organismo.copy.hero_title|default('') %}
                            {{ organismo.copy.hero_title }}{% if organismo.copy.hero_title_accent|default('') %}, <span class="mkt-heva-accent">{{ organismo.copy.hero_title_accent }}</span>{% endif %}
                        {% else %}
                            Estamos prontos para <span class="mkt-heva-accent">acompanhar você</span>
                        {% endif %}
                    {% else %}
                        {{ organismo.copy.hero_title|default('Acompanhamento pós-cirúrgico') }}{% if organismo.copy.hero_title_accent|default('') %}, <span class="mkt-gradient-text">{{ organismo.copy.hero_title_accent }}</span>{% endif %}
                    {% endif %}
                </h1>
                <p class="mkt-hero-lead mkt-hero-lead--v2">
                    {{ organismo.copy.hero_desc|default('Unio Saúde reúne cadastro de pacientes, protocolos de recuperação, alertas clínicos e questionários de acompanhamento.') }}
                </p>
                <div class="mkt-hero-cta mkt-hero-cta--v2">
                    <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--glow mkt-btn--lg">
                        Acessar plataforma
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    {% if org_clinic|default(false) %}
                    <a href="#modulos" class="mkt-btn mkt-btn--surface mkt-btn--lg">Ver módulos</a>
                    {% elseif platform_config.registro_publico ?? true %}
                    <a href="{{ path('app_register') }}" class="mkt-btn mkt-btn--surface mkt-btn--lg">Criar conta</a>
                    {% endif %}
                </div>
                <div class="mkt-hero-chips mkt-hero-tokens">
                    {% if org_clinic|default(false) %}
                    <span class="mkt-hero-token"><span class="mkt-hero-token__icon" aria-hidden="true"><i class="fas fa-calendar-alt"></i></span><span class="mkt-hero-token__label">Agenda</span></span>
                    <span class="mkt-hero-token"><span class="mkt-hero-token__icon" aria-hidden="true"><i class="fas fa-file-invoice-dollar"></i></span><span class="mkt-hero-token__label">TISS</span></span>
                    <span class="mkt-hero-token"><span class="mkt-hero-token__icon" aria-hidden="true"><i class="fas fa-user-nurse"></i></span><span class="mkt-hero-token__label">Pós-op</span></span>
                    <span class="mkt-hero-token"><span class="mkt-hero-token__icon" aria-hidden="true"><i class="fas fa-handshake"></i></span><span class="mkt-hero-token__label">CRM</span></span>
                    <span class="mkt-hero-token"><span class="mkt-hero-token__icon" aria-hidden="true"><i class="fas fa-user-shield"></i></span><span class="mkt-hero-token__label">Perfis</span></span>
                    {% else %}
                    <span class="mkt-hero-chip"><i class="fas fa-handshake" aria-hidden="true"></i> CRM comercial</span>
                    <span class="mkt-hero-chip"><i class="fas fa-shield-halved" aria-hidden="true"></i> LGPD</span>
                    <span class="mkt-hero-chip"><i class="fas fa-diagram-project" aria-hidden="true"></i> Pipeline de vendas</span>
                    <span class="mkt-hero-chip"><i class="fas fa-bell" aria-hidden="true"></i> Alertas em tempo real</span>
                    {% endif %}
                </div>
            </div>
            <div class="mkt-hero-visual mkt-hero-visual--v2" aria-hidden="true">
                {% if org_clinic|default(false) %}
                <div class="mkt-hero-heva">
                    <div class="mkt-hero-heva__ghost" aria-hidden="true">
                        <img src="{{ asset('images/marketing/hero-clinic-ghost.jpg') }}?v=1" alt="" width="1000" height="750" loading="lazy" decoding="async">
                    </div>
                    <div class="mkt-hero-heva__frame">
                        <figure class="mkt-hero-heva__photo">
                            <img src="{{ asset('images/marketing/hero-clinic-main.jpg') }}?v=1" alt="" width="1200" height="1600" loading="eager" decoding="async">
                        </figure>
                        <span class="mkt-hero-heva__live"><span class="mkt-hero-heva__live-dot"></span> Continuidade ativa</span>
                    </div>
                    <aside class="mkt-hero-heva__card">
                        <div class="mkt-hero-heva__card-top">
                            <div class="mkt-hero-heva__icon" aria-hidden="true"><i class="fas fa-heart-pulse"></i></div>
                            <div>
                                <p class="mkt-hero-heva__kicker">Pulso do dia</p>
                                <p class="mkt-hero-heva__slogan">Cuidado que continua depois da alta</p>
                            </div>
                        </div>
                        <div class="mkt-hero-heva__metrics">
                            <div><strong>D+3</strong><span>Marco ativo</span></div>
                            <div><strong>Baixo</strong><span>Risco</span></div>
                            <div><strong>OK</strong><span>Questionário</span></div>
                        </div>
                        <ul class="mkt-hero-heva__list">
                            <li>Agenda, atendimento e guias TISS</li>
                            <li>Pós-operatório, alertas e perfis clínicos</li>
                            <li>CRM comercial · carteirinha e portal</li>
                        </ul>
                    </aside>
                </div>
                {% else %}
                <div class="mkt-preview">
                    <div class="mkt-preview-chrome">
                        <span class="mkt-preview-dot mkt-preview-dot--r"></span>
                        <span class="mkt-preview-dot mkt-preview-dot--y"></span>
                        <span class="mkt-preview-dot mkt-preview-dot--g"></span>
                        <span class="mkt-preview-url">uniowork.com.br, studio</span>
                    </div>
                    <div class="mkt-preview-layout">
                        <div class="mkt-preview-sidebar">
                            <span class="mkt-preview-nav-item mkt-preview-nav-item--active"><i class="fas fa-house"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-folder-open"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-flag"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-book"></i></span>
                            <span class="mkt-preview-nav-item"><i class="fas fa-bell"></i></span>
                        </div>
                        <div class="mkt-preview-main">
                            <div class="mkt-preview-kpis">
                                <div class="mkt-preview-kpi"><strong>18</strong><span>Leads no funil</span></div>
                                <div class="mkt-preview-kpi"><strong>R$ 66k</strong><span>Pipeline aberto</span></div>
                                <div class="mkt-preview-kpi mkt-preview-kpi--accent"><strong>42%</strong><span>Win rate</span></div>
                            </div>
                            <div class="mkt-preview-modules">
                                <div class="mkt-preview-module mkt-preview-module--highlight">
                                    <i class="fas fa-handshake" aria-hidden="true"></i>
                                    <div><strong>CRM Comercial</strong><span>Leads, pipeline e clientes</span></div>
                                </div>
                                <div class="mkt-preview-module">
                                    <i class="fas fa-diagram-project" aria-hidden="true"></i>
                                    <div><strong>Pipeline</strong><span>Kanban até o fechamento</span></div>
                                </div>
                                <div class="mkt-preview-module">
                                    <i class="fas fa-list-check" aria-hidden="true"></i>
                                    <div><strong>Atividades</strong><span>Follow-ups e reuniões</span></div>
                                </div>
                                <div class="mkt-preview-module">
                                    <i class="fas fa-chart-pie" aria-hidden="true"></i>
                                    <div><strong>Analytics</strong><span>Conversão e origem</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </section>

    {# ── Faixa de confiança ── #}
    <div class="mkt-pro-strip" aria-label="Diferenciais clínicos">
        <div class="mkt-pro-strip-inner">
            {% if org_clinic|default(false) %}
            <div class="mkt-pro-badge">
                <a href="{{ path('app_carteirinha_digital') }}" class="mkt-pro-badge__link">
                <i class="fas fa-id-card" aria-hidden="true"></i>
                <div><strong>Carteirinha digital</strong><span>Foto, QR e validação</span></div>
                </a>
            </div>
            <div class="mkt-pro-badge">
                <a href="{{ path('app_guia_medico_beneficiario') }}" class="mkt-pro-badge__link">
                <i class="fas fa-book-medical" aria-hidden="true"></i>
                <div><strong>Guia médico</strong><span>Orientações no portal</span></div>
                </a>
            </div>
            <div class="mkt-pro-badge">
                <a href="{{ path('app_portal_pos_operatorio') }}" class="mkt-pro-badge__link">
                <i class="fas fa-user-nurse" aria-hidden="true"></i>
                <div><strong>Pós-operatório</strong><span>Protocolos e alertas</span></div>
                </a>
            </div>
            <div class="mkt-pro-badge">
                <a href="{{ path('app_paciente_hub') }}" class="mkt-pro-badge__link">
                <i class="fas fa-person-circle-check" aria-hidden="true"></i>
                <div><strong>Portal do paciente</strong><span>Acesso e questionários online</span></div>
                </a>
            </div>
            {% else %}
            <div class="mkt-pro-badge">
                <i class="fas fa-handshake" aria-hidden="true"></i>
                <div><strong>CRM comercial</strong><span>Leads, pipeline e clientes</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-shield-halved" aria-hidden="true"></i>
                <div><strong>LGPD conforme</strong><span>Dados protegidos por tenant</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-diagram-project" aria-hidden="true"></i>
                <div><strong>Pipeline de vendas</strong><span>Do lead ao ganho</span></div>
            </div>
            <div class="mkt-pro-badge">
                <i class="fas fa-mobile-screen" aria-hidden="true"></i>
                <div><strong>Responsivo</strong><span>Desktop, tablet e celular</span></div>
            </div>
            {% endif %}
        </div>
    </div>

    {% if org_clinic|default(false) %}
    {% include 'components/marketing/landing_patient_products.html.twig' %}
    {% endif %}

    {% if org_clinic|default(false) %}
    {# ── Spotlight visual (referência editorial) ── #}
    <section class="mkt-rich-spotlight mkt-reveal" aria-labelledby="mkt-spotlight-title">
        <div class="mkt-rich-spotlight__grid">
            <div class="mkt-rich-spotlight__copy">
                <p class="mkt-section-eyebrow">Gestão + continuidade</p>
                <h2 id="mkt-spotlight-title">Um sistema para a clínica, <span class="mkt-heva-accent">inclusive depois da alta</span></h2>
                <p>
                    Em vez de um software para cada etapa, a {{ organismo.copy.brand_name|default('Unio Saúde') }}
                    reúne agenda, atendimento, faturamento TISS, continuidade pós-operatória, documentos do paciente e alertas.
                    O pós-op continua sendo o diferencial, agora com o caminho clínico e financeiro fechado.
                </p>
                <ul class="mkt-rich-spotlight__list mkt-rich-spotlight__list--clean">
                    <li>Agenda, atendimento e contas no mesmo fluxo</li>
                    <li>Monitoramento diário, alertas P1–P4 e sala crítica</li>
                    <li>Guias TISS, lote/remessa e XML para o convênio</li>
                    <li>Carteirinha, guia médico e comprovante no mesmo organismo</li>
                </ul>
                <a href="{{ path('app_login') }}" class="mkt-btn mkt-btn--glow">
                    Conhecer a plataforma <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="mkt-rich-spotlight__visual mkt-reveal mkt-reveal--delay-1" aria-hidden="true">
                <div class="mkt-spotlight-board">
                    <details class="mkt-rich-day-card mkt-rich-day-card--interactive">
                        <summary class="mkt-rich-day-card__summary">
                            <div class="mkt-rich-day-card__head">
                                <strong>Resumo do dia</strong>
                                <span>11/07/2026</span>
                            </div>
                            <div class="mkt-rich-day-card__stats">
                                <div><strong>42</strong><span>Pacientes ativos</span></div>
                                <div><strong>89%</strong><span>Questionários</span></div>
                                <div><strong>2</strong><span>Em triagem</span></div>
                            </div>
                            <span class="mkt-rich-day-card__cta">Ver insights</span>
                        </summary>
                        <div class="mkt-day-insight mkt-day-insight--compact">
                            <ul>
                                <li>97% dos protocolos em dia, 3 pendências de D+3 aguardando resposta.</li>
                                <li>SLA médio P1 em 12 min; fila com João Pereira e Maria Silva.</li>
                            </ul>
                        </div>
                    </details>

                    <div class="mkt-spotlight-board__chips">
                        <span>97% protocolos OK</span>
                        <span class="is-warn">2 alertas em triagem</span>
                    </div>

                    <div class="mkt-spotlight-board__main">
                        {{ protocol.timeline('Linha do protocolo', [
                            {state: 'is-done', day: 'D+1', text: 'Checklist inicial'},
                            {state: 'is-current', day: 'D+3', text: 'Questionário respondido'},
                            {state: '', day: 'D+7', text: 'Retorno ambulatorial'},
                        ], 'mkt-protocol-rail--compact') }}
                        <div class="mkt-spotlight-board__metrics">
                            <div><strong>12 min</strong><span>SLA médio P1</span></div>
                            <div><strong>6</strong><span>Retornos hoje</span></div>
                            <div><strong>100%</strong><span>LGPD OK</span></div>
                        </div>
                    </div>

