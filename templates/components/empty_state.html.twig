{#
  empty_state — placeholder de lista ou página

  Props: icon, title, text, btn_label, btn_href, btn_opens, turbo_frame
  Modifiers:
    compact — cards internos / tabelas (não estica o painel)
    hero    — páginas inteiras via .empty-state-panel (hubs, stubs)
  Layout:
    Listas vazias → .unio-card dentro de .page-body-fill (layout/page_list, hub)
  Ação primária:
    Se a mesma ação já está no section_toolbar / list_toolbar, não passe btn_* aqui.
#}
<div class="empty-state{% if compact|default(false) %} empty-state--compact{% endif %}{% if hero|default(false) %} empty-state--hero{% endif %}">
    <div class="empty-icon"><i class="fas {{ icon|default('fa-inbox') }}"></i></div>
    <h6>{{ title|default('Nenhum registro') }}</h6>
    {% if text is defined and text %}
        <p>{{ text }}</p>
    {% endif %}
    {% if btn_label is defined and btn_label %}
        {% if btn_opens is defined and btn_opens %}
            <button type="button" class="btn-unio mt-3"
                    data-unio-offcanvas-open="{{ btn_opens }}"
                    data-{{ btn_opens }}-open>{{ btn_label }}</button>
        {% elseif btn_href is defined and btn_href %}
            <a href="{{ btn_href }}" class="btn-unio mt-3"{% if turbo_frame|default('') %} data-turbo-frame="{{ turbo_frame }}"{% endif %}>{{ btn_label }}</a>
        {% else %}
            <button type="button" class="btn-unio mt-3">{{ btn_label }}</button>
        {% endif %}
    {% endif %}
</div>
