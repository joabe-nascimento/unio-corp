{#
  permissions_panel — lista de membros + offcanvas de tags por hub
  Props:
    permission_data (array) retorno de permissions_scope()
#}
{% if permission_data %}
{% set can_edit = can_manage_permissions(permission_data.scope) %}
{% set perm_tags_modal_id = 'perm-tags-modal-' ~ permission_data.scope %}
<div class="permissions-panel" data-perm-panel data-perm-scope="{{ permission_data.scope }}" data-perm-api-url="{{ path('app_permissions_api_grants', {memberId: 'MEMBER'}) }}" data-perm-csrf="{{ csrf_token('perm_grants') }}">
    <div class="unio-card permissions-panel-card">
        {% include 'components/section_header.html.twig' with {
            title: 'Permissões',
            subtitle: permission_data.rows|length ~ ' membros · ' ~ permission_data.subtitle
        } %}

        <div class="permissions-panel-toolbar">
            <div class="permissions-panel-toolbar-start">
                {% include 'components/perm_tags_legend.html.twig' with {
                    profiles: permission_data.profiles,
                    no_access_description: permission_data.no_access_description,
                    modal_id: perm_tags_modal_id,
                    render_modal: false
                } %}
            </div>
            {% include 'components/view_toggle.html.twig' with {
                container_id: 'perm-members-container',
                storage_key: 'perm_members_view'
            } %}
        </div>

        <div id="perm-members-container" class="perm-member-list" data-view-mode="list">
            {% for row in permission_data.rows %}
                {% set member = row.member %}
                {% set scope_summary = row.scope_summary %}
                <div class="view-list-only perm-member-row">
                    <span class="permissions-avatar">{{ member.initials }}</span>
                    <div class="permissions-member-info">
                        <span class="permissions-member-name">{{ member.nome }}</span>
                        <span class="permissions-member-email">{{ member.email }}</span>
                    </div>
                    <span class="unio-tooltip badge-perfil perm-scope-tag {{ scope_summary.class }}"
                          data-perm-scope-badge="{{ member.id }}"
                          tabindex="0">
                        <span class="perm-scope-badge-label">{{ scope_summary.label }}</span>
                        <span class="unio-tooltip-bubble" data-perm-scope-badge-tip="{{ member.id }}">{{ scope_summary.description }}</span>
                    </span>
                    <div class="perm-row-actions">
                        {% if can_edit %}
                        <div class="perm-picker-wrap perm-row-picker" data-perm-row-picker data-member-id="{{ member.id }}">
                            <button type="button"
                                    class="perm-tags-btn"
                                    data-perm-picker-trigger
                                    data-value=""
                                    title="Aplicar perfil a todos os núcleos e produtos de uma vez">
                                <i class="fas fa-tags"></i>
                                <span class="perm-tags-btn-label">Todos</span>
                                <i class="fas fa-chevron-down perm-picker-chevron"></i>
                            </button>
                            <div class="perm-picker-menu" hidden>
                                {% for profile in permission_data.profiles %}
                                    <button type="button"
                                            class="perm-picker-option badge-perfil {{ profile.class }}"
                                            data-value="{{ profile.id }}">{{ profile.label }}</button>
                                {% endfor %}
                                <button type="button" class="perm-picker-option permissions-tag-none" data-value="">Sem acesso</button>
                            </div>
                        </div>
                        {% endif %}
                        <button type="button"
                                class="perm-tags-btn"
                                data-perm-open
                                data-member-id="{{ member.id }}"
                                aria-label="Editar permissões de {{ member.nome }}">
                            <i class="fas fa-sliders"></i>
                            <span class="perm-tags-btn-label">Editar</span>
                            <span class="perm-tags-btn-count" data-perm-count="{{ member.id }}">{{ row.grant_count }}</span>
                        </button>
                    </div>
                </div>

                <div class="view-grid-only perm-member-grid-card">
                    <span class="permissions-avatar permissions-avatar--grid">{{ member.initials }}</span>
                    <div class="perm-member-grid-name">{{ member.nome }}</div>
                    <span class="unio-tooltip badge-perfil perm-scope-tag {{ scope_summary.class }} perm-member-grid-tag"
                          data-perm-scope-badge="{{ member.id }}"
                          tabindex="0">
                        <span class="perm-scope-badge-label">{{ scope_summary.label }}</span>
                    </span>
                    <button type="button"
                            class="perm-tags-btn perm-tags-btn--grid"
                            data-perm-open
                            data-member-id="{{ member.id }}"
                            aria-label="Editar permissões de {{ member.nome }}">
                        <i class="fas fa-sliders"></i>
                        Editar
                        <span class="perm-tags-btn-count" data-perm-count="{{ member.id }}">{{ row.grant_count }}</span>
                    </button>
                </div>
            {% endfor %}
        </div>

        {% if can_edit %}
            <div class="permissions-footer">
                <span class="permissions-save-hint" data-perm-status hidden>
                    <i class="fas fa-check-circle"></i> Salvo — o membro verá ao recarregar a página (F5)
                </span>
                <span class="permissions-save-hint permissions-save-hint--error" data-perm-status-error hidden>
                    <i class="fas fa-circle-exclamation"></i> <span data-perm-status-error-text></span>
                </span>
            </div>
        {% else %}
            <div class="permissions-footer permissions-footer--readonly">
                <i class="fas fa-lock"></i> Apenas gestores podem alterar permissões.
            </div>
        {% endif %}
    </div>

    {% include 'components/perm_tags_legend_modal.html.twig' with {
        profiles: permission_data.profiles,
        no_access_description: permission_data.no_access_description,
        modal_id: perm_tags_modal_id
    } only %}

    <div class="perm-offcanvas" data-perm-offcanvas aria-hidden="true">
        <div class="perm-offcanvas-backdrop" data-perm-close tabindex="-1"></div>
        <aside class="perm-offcanvas-drawer" role="dialog" aria-modal="true" aria-labelledby="permOffcanvasTitle">
            <header class="perm-offcanvas-header">
                <div class="perm-offcanvas-profile" data-perm-drawer-profile></div>
                <div class="perm-offcanvas-toolbar">
                    <div class="perm-offcanvas-toolbar-actions" data-perm-drawer-actions></div>
                    <button type="button" class="perm-offcanvas-close" data-perm-close aria-label="Fechar">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>
            </header>
            <div class="perm-offcanvas-body">
                <div data-perm-drawer-body></div>
            </div>
        </aside>
    </div>
</div>

<script>
(function () {
    var panel = document.querySelector('[data-perm-panel][data-perm-scope="{{ permission_data.scope|e('js') }}"]');
    if (!panel) return;

    var canEdit = {{ can_edit ? 'true' : 'false' }};
    var profiles = {{ permission_data.profiles|json_encode|raw }};
    var allHubs = {{ permission_data.all_hubs|json_encode|raw }};
    var permRows = {{ permission_data.rows|json_encode|raw }};
    var permScopeProducts = {{ permission_data.products|json_encode|raw }};

    var members = permRows.map(function (r) { return r.member; });
    var defaultByMember = {};
    permRows.forEach(function (r) {
        defaultByMember[r.member.id] = r.all_grants || {};
    });

    var offcanvas = panel.querySelector('[data-perm-offcanvas]');
    var drawerBody = panel.querySelector('[data-perm-drawer-body]');
    var drawerProfile = panel.querySelector('[data-perm-drawer-profile]');
    var drawerActions = panel.querySelector('[data-perm-drawer-actions]');
    var activeMemberId = null;
    var fichaUrlTpl = {{ path('app_pessoas_membro_ficha', {id: 0})|json_encode|raw }};
    var apiUrlTpl = panel.getAttribute('data-perm-api-url') || '';
    var csrfToken = panel.getAttribute('data-perm-csrf') || '';
    var panelScope = panel.getAttribute('data-perm-scope') || '';

    function memberApiUrl(memberId) {
        return apiUrlTpl.replace('/member/MEMBER/', '/member/' + encodeURIComponent(memberId) + '/');
    }

    function loadMemberGrants(memberId) {
        return Object.assign({}, defaultByMember[memberId] || {});
    }

    function fichaUrl(fichaId) {
        return fichaUrlTpl.replace('/0', '/' + String(fichaId));
    }

    function saveMemberGrants(memberId, grantsMap) {
        if (!canEdit) return;
        var snapshot = JSON.stringify(defaultByMember[memberId] || {});
        defaultByMember[memberId] = Object.assign({}, grantsMap);
        updateMemberRowUI(memberId);
        showSaving();

        fetch(memberApiUrl(memberId), {
            method: 'PUT',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrfToken
            },
            body: JSON.stringify({ grants: grantsMap })
        })
            .then(function (res) {
                return res.json().then(function (data) {
                    return { ok: res.ok, data: data };
                });
            })
            .then(function (result) {
                if (result.ok) {
                    if (result.data && typeof result.data.grant_count === 'number') {
                        var serverCount = String(result.data.grant_count);
                        panel.querySelectorAll('[data-perm-count="' + memberId + '"]').forEach(function (el) {
                            el.textContent = serverCount;
                        });
                    }
                    updateMemberRowUI(memberId);
                    if (activeMemberId === memberId) {
                        var member = members.find(function (m) { return m.id === memberId; });
                        if (member) renderDrawer(member);
                    }
                    showSaved();
                } else {
                    defaultByMember[memberId] = JSON.parse(snapshot);
                    updateMemberRowUI(memberId);
                    showError(result.data && result.data.error ? result.data.error : 'Erro ao salvar permissões.');
                }
            })
            .catch(function () {
                defaultByMember[memberId] = JSON.parse(snapshot);
                updateMemberRowUI(memberId);
                showError('Falha de rede ao salvar permissões.');
            });
    }

    function saveMemberGrant(memberId, grantKey, value) {
        var data = loadMemberGrants(memberId);
        if (value) {
            data[grantKey] = value;
        } else {
            delete data[grantKey];
        }
        saveMemberGrants(memberId, data);
    }

    function applyScopeGrants(memberId, scope, value) {
        var data = loadMemberGrants(memberId);
        var scopeDef = allHubs.find(function (h) { return h.scope === scope; });
        if (!scopeDef) return;
        scopeDef.products.forEach(function (product) {
            var key = scope + ':' + product.id;
            if (value) {
                data[key] = value;
            } else {
                delete data[key];
            }
        });
        saveMemberGrants(memberId, data);
    }

    function applyHubGrants(memberId, hubScope, value) {
        applyScopeGrants(memberId, hubScope, value);
    }

    /** Aplica o perfil escolhido em todos os hubs/produtos da matriz. */
    function applyAllGrants(memberId, value) {
        var data = loadMemberGrants(memberId);
        allHubs.forEach(function (hub) {
            hub.products.forEach(function (product) {
                var key = hub.scope + ':' + product.id;
                if (value) {
                    data[key] = value;
                } else {
                    delete data[key];
                }
            });
        });
        saveMemberGrants(memberId, data);
    }

    function collectGrantValues(grants, scopeFilter) {
        var values = [];
        allHubs.forEach(function (hub) {
            if (scopeFilter && hub.scope !== scopeFilter) {
                return;
            }
            hub.products.forEach(function (product) {
                var v = grants[hub.scope + ':' + product.id];
                if (v) {
                    values.push(v);
                }
            });
        });
        return values;
    }

    function summarizeGrantValues(values, emptyDescription) {
        if (values.length === 0) {
            return {
                label: 'Sem acesso',
                class: 'none',
                description: emptyDescription,
                value: ''
            };
        }

        var unique = values.filter(function (v, i, a) { return a.indexOf(v) === i; });
        if (unique.length === 1) {
            var meta = profileMeta(unique[0]);
            var p = profiles.find(function (x) { return x.id === unique[0]; });
            return {
                label: meta.label,
                class: meta.class,
                description: p && p.description ? p.description : meta.label + ' em todos os produtos.',
                value: unique[0]
            };
        }

        return {
            label: 'Misto (' + unique.length + ')',
            class: 'default',
            description: 'Perfis diferentes entre núcleos ou produtos.',
            value: ''
        };
    }

    function resolveScopeDef(scope) {
        var scopeDef = allHubs.find(function (h) { return h.scope === scope; });
        if (!scopeDef && scope === panelScope && typeof permScopeProducts !== 'undefined') {
            scopeDef = { scope: panelScope, products: permScopeProducts };
        }
        return scopeDef || null;
    }

    function computeScopeSummary(grants, scope) {
        var scopeDef = resolveScopeDef(scope);
        if (!scopeDef) {
            return { label: '—', class: 'none', description: 'Escopo não encontrado.', value: '' };
        }

        var values = [];
        scopeDef.products.forEach(function (product) {
            var v = grants[scopeDef.scope + ':' + product.id];
            if (v) values.push(v);
        });

        if (values.length === 0) {
            return {
                label: 'Sem acesso',
                class: 'none',
                description: 'Sem permissão neste escopo — produtos desta aba bloqueados.',
                value: ''
            };
        }

        return summarizeGrantValues(values, 'Sem permissão neste escopo — produtos desta aba bloqueados.');
    }

    function computeGlobalSummary(grants) {
        return summarizeGrantValues(
            collectGrantValues(grants),
            'Sem permissão em nenhum hub ou produto.'
        );
    }

    function scopeGrantSummary(memberId, scope) {
        return computeScopeSummary(loadMemberGrants(memberId), scope || panelScope);
    }

    function updateScopeBadge(memberId) {
        var meta = scopeGrantSummary(memberId);
        panel.querySelectorAll('[data-perm-scope-badge="' + memberId + '"]').forEach(function (el) {
            el.className = 'unio-tooltip badge-perfil perm-scope-tag ' + meta.class;
            var labelEl = el.querySelector('.perm-scope-badge-label');
            if (labelEl) labelEl.textContent = meta.label;
            var tip = el.querySelector('[data-perm-scope-badge-tip]');
            if (tip) tip.textContent = meta.description;
        });
    }

    function updateRowPickerTrigger(memberId) {
        panel.querySelectorAll('[data-perm-row-picker][data-member-id="' + memberId + '"]').forEach(function (wrap) {
            var trigger = wrap.querySelector('[data-perm-picker-trigger]');
            if (!trigger) return;
            var meta = computeGlobalSummary(loadMemberGrants(memberId));
            trigger.setAttribute('data-value', meta.value || '');
            if (meta.value) {
                trigger.className = 'perm-tags-btn badge-perfil ' + meta.class;
                trigger.innerHTML = '<i class="fas fa-tags"></i> <span class="perm-tags-btn-label">' + esc(meta.label) + '</span> <i class="fas fa-chevron-down perm-picker-chevron"></i>';
            } else {
                trigger.className = 'perm-tags-btn';
                trigger.innerHTML = '<i class="fas fa-tags"></i><span class="perm-tags-btn-label">Todos</span><i class="fas fa-chevron-down perm-picker-chevron"></i>';
            }
        });
    }

    function updateMemberRowUI(memberId) {
        updateGrantCount(memberId);
        updateScopeBadge(memberId);
        updateRowPickerTrigger(memberId);
    }

    function countGrants(memberId) {
        var grants = loadMemberGrants(memberId);
        return Object.keys(grants).filter(function (k) { return grants[k]; }).length;
    }

    function updateGrantCount(memberId) {
        var count = String(countGrants(memberId));
        panel.querySelectorAll('[data-perm-count="' + memberId + '"]').forEach(function (el) {
            el.textContent = count;
        });
    }

    function showSaved() {
        var status = panel.querySelector('[data-perm-status]');
        var err = panel.querySelector('[data-perm-status-error]');
        if (err) err.hidden = true;
        if (!status) return;
        status.hidden = false;
        clearTimeout(status._t);
        status._t = setTimeout(function () { status.hidden = true; }, 3200);
    }

    function showSaving() {
        var status = panel.querySelector('[data-perm-status]');
        if (status) status.hidden = true;
    }

    function showError(message) {
        var err = panel.querySelector('[data-perm-status-error]');
        var text = panel.querySelector('[data-perm-status-error-text]');
        if (!err || !text) return;
        text.textContent = message;
        err.hidden = false;
        clearTimeout(err._t);
        err._t = setTimeout(function () { err.hidden = true; }, 4000);
    }

    function profileMeta(id) {
        if (!id) return { label: 'Sem acesso', class: 'none' };
        var p = profiles.find(function (x) { return x.id === id; });
        return p ? { label: p.label, class: p.class } : { label: id, class: 'default' };
    }

    function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    }

    function closeOffcanvas() {
        offcanvas.classList.remove('is-open');
        offcanvas.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('perm-offcanvas-open');
        activeMemberId = null;
        closeAllPickers();
    }

    function openOffcanvas(memberId) {
        var member = members.find(function (m) { return m.id === memberId; });
        if (!member) return;
        activeMemberId = memberId;
        renderDrawer(member);
        offcanvas.classList.add('is-open');
        offcanvas.setAttribute('aria-hidden', 'false');
        document.body.classList.add('perm-offcanvas-open');
    }

    function handlePickerClick(e) {
        var trigger = e.target.closest('[data-perm-picker-trigger]');
        if (trigger && canEdit) {
            e.stopPropagation();
            var wrap = trigger.closest('.perm-picker-wrap');
            var menu = wrap.querySelector('.perm-picker-menu');
            var wasOpen = !menu.hidden;
            if (!wasOpen) {
                openPickerMenu(wrap);
            } else {
                closeAllPickers();
            }
            return true;
        }

        var option = e.target.closest('.perm-picker-option');
        if (option && canEdit && activeMemberId) {
            e.stopPropagation();
            var value = option.getAttribute('data-value');
            var wrap = option.closest('.perm-picker-wrap');
            var member = members.find(function (m) { return m.id === activeMemberId; });

            if (wrap.hasAttribute('data-perm-bulk-hub')) {
                applyHubGrants(activeMemberId, wrap.getAttribute('data-perm-bulk-hub'), value);
            } else {
                var row = option.closest('.perm-product-row');
                if (row) {
                    saveMemberGrant(activeMemberId, row.getAttribute('data-grant-key'), value);
                }
            }

            if (member) renderDrawer(member);
            return true;
        }
        return false;
    }

    function pickerHtml(value, attrs, displayMeta) {
        var meta = displayMeta || profileMeta(value);
        var extra = attrs || '';
        var html = '<div class="perm-picker-wrap"' + extra + '>';
        html += '<button type="button" class="perm-picker-trigger badge-perfil ' + meta.class + '"' +
            (canEdit ? '' : ' disabled') +
            ' data-perm-picker-trigger data-value="' + esc(value) + '">' +
            esc(meta.label) + ' <i class="fas fa-chevron-down perm-picker-chevron"></i></button>';
        if (canEdit) {
            html += '<div class="perm-picker-menu" hidden>';
            html += '<button type="button" class="perm-picker-option permissions-tag-none' + (value === '' ? ' is-active' : '') + '" data-value="">Sem acesso</button>';
            profiles.forEach(function (p) {
                html += '<button type="button" class="perm-picker-option badge-perfil ' + p.class +
                    (value === p.id ? ' is-active' : '') + '" data-value="' + p.id + '">' + esc(p.label) + '</button>';
            });
            html += '</div>';
        }
        html += '</div>';
        return html;
    }

    function renderDrawer(member) {
        var grants = loadMemberGrants(member.id);
        var grantCount = countGrants(member.id);
        var viewMemberHtml = member.ficha_id
            ? '<a href="' + esc(fichaUrl(member.ficha_id)) + '" class="perm-profile-view-btn" title="Ver membro" aria-label="Ver membro">' +
                '<i class="fas fa-user"></i>' +
              '</a>'
            : '';

        drawerProfile.innerHTML =
            '<div class="perm-profile-card">' +
                '<span class="permissions-avatar permissions-avatar--lg">' + esc(member.initials) + '</span>' +
                '<div class="perm-profile-identity">' +
                    '<h2 class="perm-offcanvas-title" id="permOffcanvasTitle">' + esc(member.nome) + '</h2>' +
                    '<p class="perm-offcanvas-email">' + esc(member.email) + '</p>' +
                    '<div class="perm-profile-meta">' +
                        '<span class="badge-perfil ' + member.perfil_class + '">' + esc(member.perfil_label) + '</span>' +
                        '<span class="perm-profile-grant-count">' + grantCount + ' ativas</span>' +
                    '</div>' +
                '</div>' +
            '</div>';
        if (drawerActions) {
            drawerActions.innerHTML = viewMemberHtml;
        }

        function renderHubBulk(scope) {
            if (!canEdit) {
                return '';
            }
            var hubSummary = computeScopeSummary(grants, scope);
            return pickerHtml(hubSummary.value, ' data-perm-bulk-hub="' + esc(scope) + '" aria-label="Nível para todo o núcleo"', {
                label: hubSummary.label,
                class: hubSummary.class
            });
        }

        function renderHubHead(hub) {
            var html = '<div class="perm-hub-head">';
            html += '<h3 class="perm-hub-title">' + esc(hub.label) + '</h3>';
            if (canEdit) {
                html += '<div class="perm-hub-bulk">' + renderHubBulk(hub.scope) + '</div>';
            }
            html += '</div>';
            return html;
        }

        function renderProductList(hub) {
            if (!hub.products || hub.products.length === 0) {
                return '';
            }
            var html = '<ul class="perm-product-list">';
            hub.products.forEach(function (product) {
                var grantKey = hub.scope + ':' + product.id;
                var value = grants[grantKey] || '';
                html += '<li class="perm-product-row" data-grant-key="' + esc(grantKey) + '">';
                html += '<span class="perm-product-label">' + esc(product.label) + '</span>';
                html += pickerHtml(value);
                html += '</li>';
            });
            html += '</ul>';
            return html;
        }

        function renderHubBlock(hub, opts) {
            opts = opts || {};
            var blockClass = 'perm-hub-block';
            if (opts.current) {
                blockClass += ' perm-hub-block--current';
            }
            var html = '<section class="' + blockClass + '" data-hub-scope="' + esc(hub.scope) + '">';
            if (opts.current) {
                html += '<p class="perm-hub-current-label">Núcleo atual</p>';
            }
            html += renderHubHead(hub);
            html += renderProductList(hub);
            html += '</section>';
            return html;
        }

        function renderCompactRow(hub) {
            var html = '<div class="perm-hub-compact-row" data-hub-scope="' + esc(hub.scope) + '">';
            html += '<span class="perm-hub-compact-label">' + esc(hub.label) + '</span>';
            if (canEdit) {
                html += '<div class="perm-hub-bulk">' + renderHubBulk(hub.scope) + '</div>';
            }
            html += '</div>';
            return html;
        }

        var currentHub = null;
        var hubsWithProducts = [];
        var hubsEmpty = [];
        allHubs.forEach(function (hub) {
            if (hub.scope === panelScope) {
                currentHub = hub;
            } else if (hub.products && hub.products.length > 0) {
                hubsWithProducts.push(hub);
            } else {
                hubsEmpty.push(hub);
            }
        });

        var html = '';
        if (currentHub) {
            html += renderHubBlock(currentHub, { current: true });
        }
        if (hubsWithProducts.length > 0) {
            html += '<details class="perm-hub-group">';
            html += '<summary class="perm-hub-group-summary">Demais núcleos com módulos (' + hubsWithProducts.length + ')</summary>';
            html += '<div class="perm-hub-group-body">';
            hubsWithProducts.forEach(function (hub) {
                html += renderHubBlock(hub);
            });
            html += '</div></details>';
        }
        if (hubsEmpty.length > 0) {
            html += '<details class="perm-hub-group perm-hub-group--simple">';
            html += '<summary class="perm-hub-group-summary">Outros núcleos (' + hubsEmpty.length + ')</summary>';
            html += '<div class="perm-hub-group-body perm-hub-group-body--compact">';
            hubsEmpty.forEach(function (hub) {
                html += renderCompactRow(hub);
            });
            html += '</div></details>';
        }
        drawerBody.innerHTML = html;
    }

    function positionPickerMenu(menu, trigger) {
        menu.classList.remove('is-drop-up');
        if (trigger.closest('[data-perm-row-picker]')) {
            return;
        }
        menu.hidden = false;
        var menuHeight = menu.offsetHeight;
        var gap = 8;
        var rect = trigger.getBoundingClientRect();
        var spaceBelow = window.innerHeight - rect.bottom - gap;
        var spaceAbove = rect.top - gap;
        if (menuHeight > spaceBelow && spaceAbove >= menuHeight) {
            menu.classList.add('is-drop-up');
        } else if (spaceBelow < menuHeight && spaceAbove > spaceBelow) {
            menu.classList.add('is-drop-up');
        }
        menu.hidden = true;
    }

    function openPickerMenu(wrap) {
        var trigger = wrap.querySelector('[data-perm-picker-trigger]');
        var menu = wrap.querySelector('.perm-picker-menu');
        if (!trigger || !menu) {
            return;
        }
        closeAllPickers();
        positionPickerMenu(menu, trigger);
        menu.hidden = false;
        trigger.classList.add('is-open');
    }

    function closeAllPickers() {
        panel.querySelectorAll('.perm-picker-menu').forEach(function (m) {
            m.hidden = true;
            m.classList.remove('is-drop-up');
        });
        panel.querySelectorAll('.perm-picker-trigger.is-open, [data-perm-picker-trigger].is-open').forEach(function (b) {
            b.classList.remove('is-open');
        });
    }

    panel.querySelectorAll('[data-perm-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            openOffcanvas(btn.getAttribute('data-member-id'));
        });
    });

    panel.querySelectorAll('[data-perm-close]').forEach(function (el) {
        el.addEventListener('click', closeOffcanvas);
    });

    var tagsModal = document.getElementById('{{ perm_tags_modal_id|e('js') }}');
    if (tagsModal && tagsModal.parentElement !== document.body) {
        document.body.appendChild(tagsModal);
    }

    function closeTagsModal(modal) {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        modal.hidden = true;
        document.body.classList.remove('perm-tags-modal-open');
    }

    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (offcanvas.classList.contains('is-open')) {
            closeOffcanvas();
            return;
        }
        if (tagsModal && tagsModal.classList.contains('is-open')) {
            closeTagsModal(tagsModal);
        }
    });

    offcanvas.addEventListener('click', function (e) {
        handlePickerClick(e);
    });

    document.addEventListener('click', function () {
        closeAllPickers();
    });

    members.forEach(function (m) { updateMemberRowUI(m.id); });

    // ── Row pickers — "Definir todos" por membro ────────────────────────────
    panel.querySelectorAll('[data-perm-row-picker]').forEach(function (wrap) {
        var memberId = wrap.getAttribute('data-member-id');
        var trigger  = wrap.querySelector('[data-perm-picker-trigger]');
        var menu     = wrap.querySelector('.perm-picker-menu');

        wrap.addEventListener('click', function (e) {
            if (e.target.closest('[data-perm-picker-trigger]')) {
                e.stopPropagation();
                var wasOpen = !menu.hidden;
                if (!wasOpen) {
                    openPickerMenu(wrap);
                } else {
                    closeAllPickers();
                }
                return;
            }
            var option = e.target.closest('.perm-picker-option');
            if (option) {
                e.stopPropagation();
                var value = option.getAttribute('data-value');
                applyAllGrants(memberId, value);
                closeAllPickers();
            }
        });
    });
    // ────────────────────────────────────────────────────────────────────────

    panel.querySelectorAll('[data-perm-tags-modal-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (!tagsModal) return;
            tagsModal.hidden = false;
            tagsModal.setAttribute('aria-hidden', 'false');
            tagsModal.classList.add('is-open');
            document.body.classList.add('perm-tags-modal-open');
        });
    });

    if (tagsModal) {
        tagsModal.querySelectorAll('[data-perm-tags-modal-close]').forEach(function (el) {
            el.addEventListener('click', function () { closeTagsModal(tagsModal); });
        });
    }
})();
</script>
{% endif %}
