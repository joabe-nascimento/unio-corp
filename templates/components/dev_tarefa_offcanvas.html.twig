{#
  dev_tarefa_offcanvas — nova tarefa no kanban (usa unio_offcanvas)
#}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'dev-tarefa',
    title: 'Nova tarefa',
    subtitle: 'Adicione ao kanban com projeto, coluna, prioridade e meta opcional.',
    icon: 'fa-list-check',
    open: open is defined and open,
    size: 'md'
} %}
    {% block offcanvas_body %}
        <form method="post"
              action="{{ path('app_core_tarefa_nova') }}"
              class="unio-form unio-offcanvas-form"
              data-dev-tarefa-form
              data-locked-projeto="{{ locked_projeto_id|default(0) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('dev_tarefa_create') }}">
            {% if redirect|default('') == 'show' %}
                <input type="hidden" name="redirect" value="show" data-dev-tarefa-redirect>
            {% else %}
                <input type="hidden" name="redirect_view" value="{{ active_view|default('kanban') }}">
            {% endif %}
            {% include 'modules/core/projetos/_tarefa_form_fields.html.twig' with {
                rd: rd|default({}),
                projetos: projetos|default([]),
                metas: metas|default([]),
                kanban_columns: kanban_columns|default({}),
                locked_projeto_id: locked_projeto_id|default(0)
            } %}
            <div class="unio-form-actions unio-offcanvas-form-actions">
                <button type="submit" class="btn-unio">
                    <i class="fas fa-check mr-1" aria-hidden="true"></i> Criar tarefa
                </button>
                <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
            </div>
        </form>
    {% endblock %}
{% endembed %}
