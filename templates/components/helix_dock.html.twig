{# Sasha / Lumen / Sasha — aba de presença na borda (fora do header) #}
{% import 'macros/helix.html.twig' as helix %}
{% set _org = organismo.enabled|default(false) %}
{% set _clinic = org_clinic|default(false) %}
{% set _juridico = org_juridico|default(false) %}
{% set _copy = organismo.copy|default({}) %}
{% set _assistant = _juridico ? _copy.lumen|default('Sasha') : (_org ? _copy.lumen|default('Lumen') : 'Sasha') %}
{% set _subtitle = _org
    ? (_clinic ? (_copy.lumen_subtitle|default('Assistente clínico')) : (_juridico ? (_copy.lumen_subtitle|default('Assistente jurídica')) : (_copy.lumen_subtitle|default('Consciência da colônia'))))
    : 'Assistente virtual' %}
{% set _avatar = _juridico ? 'images/marketing/Sasha-assistant-juridico.jpg' : null %}

<button type="button"
        class="helix-dock helix-trigger{% if _clinic %} helix-dock--clinic{% endif %}{% if _juridico %} helix-dock--juridico{% endif %}"
        id="helixOpenBtn"
        aria-expanded="false"
        aria-controls="helixPanel"
        title="{{ _assistant }} — {{ _subtitle }}"
        data-tour="helix">
    <span class="helix-dock__shell">
        <span class="helix-dock__pulse" aria-hidden="true"></span>
        <span class="helix-dock__avatar">
            {{ helix.avatar('md', false, _avatar) }}
        </span>
        <span class="helix-dock__copy">
            <span class="helix-dock__name">{{ _assistant }}</span>
            <span class="helix-dock__cue">{{ (_clinic or _juridico) ? 'Copiloto' : 'Pergunte' }}</span>
        </span>
        <span class="helix-dock__chev" aria-hidden="true">
            <i class="fas fa-chevron-left"></i>
        </span>
    </span>
</button>
