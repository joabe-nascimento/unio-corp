{# Chips de produto — painel de marca do login #}
<div class="auth-chips" aria-label="Produtos da plataforma">
    {% if organismo.enabled|default(false) %}
        <div class="auth-chip">
            <i class="fas fa-heart-pulse" aria-hidden="true"></i>
            <span>Pós-operatório</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-id-card" aria-hidden="true"></i>
            <span>Carteirinha digital</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-book-medical" aria-hidden="true"></i>
            <span>Guia médico</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-shield-halved" aria-hidden="true"></i>
            <span>LGPD</span>
        </div>
    {% else %}
        <div class="auth-chip">
            <i class="fas fa-users" aria-hidden="true"></i>
            <span>Pessoas</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-diagram-project" aria-hidden="true"></i>
            <span>Processos</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-chart-line" aria-hidden="true"></i>
            <span>Resultados</span>
        </div>
    {% endif %}
</div>
