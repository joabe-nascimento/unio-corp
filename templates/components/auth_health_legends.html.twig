{# Chips de produto — painel de marca do login #}
<div class="auth-chips" aria-label="Produtos da plataforma">
    {% if org_clinic|default(false) %}
        <div class="auth-chip">
            <i class="fas fa-heart-pulse" aria-hidden="true"></i>
            <span>Pós-operatório</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-id-card" aria-hidden="true"></i>
            <span>Carteirinha digital</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-book-medical" aria-hidden="true"></i>
            <span>Guia médico</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-shield-halved" aria-hidden="true"></i>
            <span>LGPD</span>
        </div>
    {% else %}
        <div class="auth-chip">
            <i class="fas fa-heart-pulse" aria-hidden="true"></i>
            <span>Saúde</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-graduation-cap" aria-hidden="true"></i>
            <span>Educação</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-users" aria-hidden="true"></i>
            <span>Pessoas & RH</span>
        </div>
        <div class="auth-chip">
            <i class="fas fa-compass-drafting" aria-hidden="true"></i>
            <span>Engenharia</span>
        </div>
    {% endif %}
</div>
