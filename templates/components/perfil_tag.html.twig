{#
  perfil_tag — badge de perfil com tooltip explicativo

  Props:
    label        (string)
    class        (string, opt)  classe extra do badge (ex.: membro, gestor)
    description  (string)        texto do tooltip
#}
<span class="huplex-tooltip badge-perfil {{ class|default('') }}" tabindex="0">
    {{ label }}
    <span class="huplex-tooltip-bubble" role="tooltip">{{ description }}</span>
</span>
