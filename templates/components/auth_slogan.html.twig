{# Slogan institucional — painel esquerdo do login #}
{% set _slogan = platform_config.plataforma_tagline|default('Pessoas. Processos. Resultados.') %}
{% set _parts = [] %}
{% for piece in _slogan|split('.') %}
    {% set piece = piece|trim %}
    {% if piece != '' %}
        {% set _parts = _parts|merge([piece]) %}
    {% endif %}
{% endfor %}
<p class="auth-slogan" aria-label="{{ _slogan }}">
    {% if _parts is not empty %}
        {% for part in _parts %}
            <span class="auth-slogan__word">{{ part }}<span class="auth-slogan__dot" aria-hidden="true">.</span></span>
        {% endfor %}
    {% else %}
        <span class="auth-slogan__word">Pessoas<span class="auth-slogan__dot" aria-hidden="true">.</span></span>
        <span class="auth-slogan__word">Processos<span class="auth-slogan__dot" aria-hidden="true">.</span></span>
        <span class="auth-slogan__word">Resultados<span class="auth-slogan__dot" aria-hidden="true">.</span></span>
    {% endif %}
</p>
