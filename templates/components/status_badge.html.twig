{#
  status_badge — badge de status (substitui badge Bootstrap)

  Props:
    label        (string)
    variant      (string)  info | success | warning | secondary | danger | accent  (default: secondary)
    extra_class  (string)  classes adicionais
    attrs        (object)  atributos HTML extras, ex.: { 'data-ti-status-badge': 'novo' }
#}
<span class="status-badge status-badge--{{ variant|default('secondary') }}{% if extra_class|default('') %} {{ extra_class }}{% endif %}"
      {% for k, v in attrs|default({}) %} {{ k }}="{{ v }}"{% endfor %}>{{ label }}</span>
