{#
  table_empty_row — linha vazia dentro de <tbody>

  Props:
    colspan  (int)
    title    (string)
    text     (string, opt)
    icon     (string, opt)
#}
<tr class="table-empty-row">
    <td colspan="{{ colspan }}" class="p-0 border-0">
        {% include 'components/empty_state.html.twig' with {
            icon: icon|default('fa-inbox'),
            title: title,
            text: text|default(''),
            compact: true
        } %}
    </td>
</tr>
