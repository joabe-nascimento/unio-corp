{#
  toolbar_mobile_fab — botão flutuante (somente mobile) para abrir filtros/busca

  Props:
    offcanvas_id (string)  id do unio_offcanvas (obrigatório)
    label        (string, opt)  default: 'Filtros e busca'
    icon         (string, opt)  default: 'fa-sliders'
#}
<button type="button"
        class="toolbar-mobile-fab"
        data-unio-offcanvas-open="{{ offcanvas_id }}"
        aria-label="{{ label|default('Filtros e busca') }}"
        title="{{ label|default('Filtros e busca') }}">
    <i class="fas {{ icon|default('fa-sliders') }}" aria-hidden="true"></i>
</button>
