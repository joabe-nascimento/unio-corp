{#
  chart_empty_slot — placeholder dentro de card de gráfico

  Props: icon, title, text, btn_label, btn_href, class
#}
<div class="chart-slot-empty{{ class|default('') ? ' ' ~ class : '' }}">
    {% include 'components/empty_state.html.twig' with {
        icon: icon|default('fa-chart-line'),
        title: title|default('Sem dados ainda'),
        text: text|default(''),
        btn_label: btn_label|default(null),
        btn_href: btn_href|default(null),
        compact: true
    } %}
</div>
