{#
  juridico/prazo_form_fields — campos do formulário de prazo (criar/editar)

  Props: prazo (JuridicoPrazo|null), processos (list), responsaveis (list<User>), form_id, form_action, csrf_id
#}
{% set pr = prazo|default(null) %}
<form method="post" action="{{ form_action }}" id="{{ form_id }}" class="crm-form">
    <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">

    <div class="row">
        <div class="col-md-6 form-group">
            <label for="{{ form_id }}-tipo">Tipo de prazo *</label>
            <input class="form-control" id="{{ form_id }}-tipo" name="tipo" required autofocus
                   value="{{ pr ? pr.tipo : '' }}" placeholder="Ex.: Contestação, Apelação…">
        </div>
        <div class="col-md-6 form-group">
            <label for="{{ form_id }}-data-limite">Data limite *</label>
            <input class="form-control" id="{{ form_id }}-data-limite" name="data_limite" type="date" required
                   value="{{ pr ? pr.dataLimite|date('Y-m-d') : '' }}">
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 form-group">
            <label for="{{ form_id }}-processo">Processo vinculado</label>
            <select class="form-control" id="{{ form_id }}-processo" name="processo_id">
                <option value="">— Sem processo vinculado —</option>
                {% for p in processos %}
                <option value="{{ p.id }}"{% if pr and pr.processo and pr.processo.id == p.id %} selected{% endif %}>{{ p.numero }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-6 form-group">
            <label for="{{ form_id }}-responsavel">Responsável</label>
            <select class="form-control" id="{{ form_id }}-responsavel" name="responsavel_id">
                <option value="">— A definir —</option>
                {% for u in responsaveis %}
                <option value="{{ u.id }}"{% if pr and pr.responsavel and pr.responsavel.id == u.id %} selected{% endif %}>{{ u.nome }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    <div class="form-group mb-0">
        <label for="{{ form_id }}-descricao">Descrição</label>
        <textarea class="form-control" id="{{ form_id }}-descricao" name="descricao" rows="4">{{ pr ? pr.descricao : '' }}</textarea>
    </div>

    {% if pr %}
    <div class="form-group form-check mt-3 mb-0">
        <input type="checkbox" class="form-check-input" id="{{ form_id }}-cumprido" name="cumprido" value="1"{% if pr.cumprido %} checked{% endif %}>
        <label class="form-check-label" for="{{ form_id }}-cumprido">Prazo cumprido</label>
    </div>
    {% endif %}
</form>
