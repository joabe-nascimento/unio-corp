{% embed 'components/unio_offcanvas.html.twig' with {
    id: id|default('juridico-publicacao-manual'),
    title: 'Registrar publicação manual',
    subtitle: 'Cole o texto do DJe/DJEN',
    icon: 'fa-plus',
    size: 'lg',
    open: open|default(false)
} %}
{% block offcanvas_body %}
<form method="post" action="{{ form_action }}" id="juridicoPublicacaoManualForm">
    <input type="hidden" name="_token" value="{{ csrf_token('juridico_publicacao_manual') }}">
    <div class="mb-3">
        <label class="form-label small">Número do processo (CNJ)</label>
        <input type="text" name="numero_processo" class="form-control form-control-sm" placeholder="0000000-00.0000.0.00.0000">
    </div>
    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label small">Tipo de comunicação</label>
            <input type="text" name="tipo_comunicacao" class="form-control form-control-sm" placeholder="Intimação">
        </div>
        <div class="col-6">
            <label class="form-label small">Tribunal</label>
            <input type="text" name="tribunal" class="form-control form-control-sm" placeholder="TJSP">
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label small">Data da publicação</label>
        <input type="date" name="data_disponibilizacao" class="form-control form-control-sm">
    </div>
    <div class="mb-3">
        <label class="form-label small">Texto da publicação <span class="text-danger">*</span></label>
        <textarea name="texto" class="form-control form-control-sm" rows="10" required placeholder="Cole aqui o texto completo da publicação…"></textarea>
    </div>
</form>
{% endblock %}
{% block offcanvas_footer %}
<div class="unio-offcanvas-footer d-flex justify-content-end gap-2">
    <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
    <button type="submit" form="juridicoPublicacaoManualForm" class="btn-unio">Registrar</button>
</div>
{% endblock %}
{% endembed %}
