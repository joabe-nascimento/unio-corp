{% embed 'components/unio_offcanvas.html.twig' with {
    id: id|default('juridico-atendimento-templates'),
    title: 'Templates Sasha',
    subtitle: 'Respostas prontas por área do direito',
    icon: 'fa-file-alt',
    size: 'lg',
    open: open|default(false)
} %}
{% block offcanvas_body %}
<div class="jur-atendimento-templates">
    <section class="jur-atendimento-templates__section">
        <h6 class="jur-atendimento-templates__heading">Novo template</h6>
        <form method="post" action="{{ path('app_juridico_atendimento_template_novo') }}" id="juridicoAtendimentoTemplateForm" class="jur-atendimento-templates__form">
            <input type="hidden" name="_token" value="{{ csrf_token('juridico_atendimento_template') }}">
            <div class="jur-atendimento-templates__form-row">
                <label class="jur-atendimento-templates__field jur-atendimento-templates__field--title">
                    <span class="jur-atendimento-templates__label">Título</span>
                    <input type="text" name="titulo" class="form-control form-control-sm" placeholder="Ex.: Agendamento de reunião" required maxlength="120">
                </label>
                <label class="jur-atendimento-templates__field jur-atendimento-templates__field--area">
                    <span class="jur-atendimento-templates__label">Área</span>
                    <input type="text" name="area" class="form-control form-control-sm" placeholder="Ex.: trabalhista" maxlength="80">
                </label>
            </div>
            <label class="jur-atendimento-templates__field jur-atendimento-templates__field--body">
                <span class="jur-atendimento-templates__label">Texto</span>
                <textarea name="corpo" class="form-control form-control-sm" rows="4" required placeholder="Texto do template. Use variáveis: cliente, processo, escritorio…"></textarea>
            </label>
            <div class="jur-atendimento-templates__form-actions">
                <button type="submit" class="btn-unio btn-sm">Salvar template</button>
            </div>
        </form>
    </section>

    {% if templates is empty %}
    <p class="jur-atendimento-templates__empty">Nenhum template cadastrado.</p>
    {% else %}
    <section class="jur-atendimento-templates__section">
        <h6 class="jur-atendimento-templates__heading">Templates ativos ({{ templates|length }})</h6>
        <div class="jur-atendimento-templates__list">
            {% for tpl in templates %}
            <article class="jur-atendimento-templates__item">
                <header class="jur-atendimento-templates__item-head">
                    <h3 class="jur-atendimento-templates__item-title">{{ tpl.titulo }}</h3>
                    {% if tpl.area %}
                    <span class="jur-atendimento-templates__item-area">{{ tpl.area }}</span>
                    {% endif %}
                </header>
                <p class="jur-atendimento-templates__item-body">{{ tpl.corpo|slice(0, 200) }}{% if tpl.corpo|length > 200 %}…{% endif %}</p>
                <footer class="jur-atendimento-templates__item-foot">
                    <form method="post" action="{{ path('app_juridico_atendimento_template_excluir', { id: tpl.id }) }}" onsubmit="return confirm('Remover este template?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('juridico_atendimento_template_del_' ~ tpl.id) }}">
                        <button type="submit" class="jur-atendimento-templates__remove">Remover</button>
                    </form>
                </footer>
            </article>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <p class="jur-atendimento-templates__hint">Na tela do ticket, use <strong>Sugerir com Sasha</strong> para respostas personalizadas com IA.</p>
</div>
{% endblock %}
{% block offcanvas_footer %}
<div class="unio-offcanvas-footer d-flex justify-content-end">
    <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Fechar</button>
</div>
{% endblock %}
{% endembed %}
