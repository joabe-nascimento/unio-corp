{% embed 'components/unio_offcanvas.html.twig' with {
    id: id|default('juridico-atendimento-templates'),
    title: 'Templates Sasha',
    subtitle: 'Respostas prontas por área do direito',
    icon: 'fa-file-alt',
    size: 'lg',
    open: open|default(false)
} %}
{% block offcanvas_body %}
<div class="mb-4">
    <h6 class="small text-uppercase text-muted mb-2">Novo template</h6>
    <form method="post" action="{{ path('app_juridico_atendimento_template_novo') }}" id="juridicoAtendimentoTemplateForm">
        <input type="hidden" name="_token" value="{{ csrf_token('juridico_atendimento_template') }}">
        <div class="row g-2 mb-2">
            <div class="col-8">
                <input type="text" name="titulo" class="form-control form-control-sm" placeholder="Título" required maxlength="120">
            </div>
            <div class="col-4">
                <input type="text" name="area" class="form-control form-control-sm" placeholder="Área" maxlength="80">
            </div>
        </div>
        <textarea name="corpo" class="form-control form-control-sm mb-2" rows="4" required placeholder="Texto do template. Use variáveis: cliente, processo, escritorio…"></textarea>
        <button type="submit" class="btn-unio btn-sm">Salvar template</button>
    </form>
</div>

{% if templates is empty %}
<p class="text-muted small">Nenhum template cadastrado.</p>
{% else %}
<h6 class="small text-uppercase text-muted mb-2">Templates ativos ({{ templates|length }})</h6>
<div class="list-group list-group-flush">
    {% for tpl in templates %}
    <div class="list-group-item px-0 py-3">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <strong class="small">{{ tpl.titulo }}</strong>
            {% if tpl.area %}<span class="badge badge-light">{{ tpl.area }}</span>{% endif %}
        </div>
        <pre class="small text-muted mb-2" style="white-space:pre-wrap;font-family:inherit;">{{ tpl.corpo|slice(0, 200) }}{% if tpl.corpo|length > 200 %}…{% endif %}</pre>
        <form method="post" action="{{ path('app_juridico_atendimento_template_excluir', { id: tpl.id }) }}" class="d-inline" onsubmit="return confirm('Remover este template?');">
            <input type="hidden" name="_token" value="{{ csrf_token('juridico_atendimento_template_del_' ~ tpl.id) }}">
            <button type="submit" class="btn-unio-ghost btn-sm text-danger">Remover</button>
        </form>
    </div>
    {% endfor %}
</div>
{% endif %}
<p class="small text-muted mt-3 mb-0">Na tela do ticket, use <strong>Sugerir com Sasha</strong> para respostas personalizadas com IA.</p>
{% endblock %}
{% block offcanvas_footer %}
<div class="unio-offcanvas-footer d-flex justify-content-end">
    <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Fechar</button>
</div>
{% endblock %}
{% endembed %}
