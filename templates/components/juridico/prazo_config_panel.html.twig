<form method="post" action="{{ path('app_juridico_prazo_config') }}" class="jur-oab-capture__auto-form">
    <input type="hidden" name="_token" value="{{ csrf_token('juridico_prazo_config') }}">
    <p class="jur-oab-capture__hint">Alertas em cascata: D-7, D-3, D-1, hoje e vencido. Cada nível é enviado uma única vez por canal.</p>

    <label class="jur-oab-capture__toggle">
        <input type="checkbox" name="alerta_whatsapp" value="1" {{ config.alertaWhatsapp ? 'checked' : '' }}>
        <span class="jur-oab-capture__toggle-box" aria-hidden="true"></span>
        <span class="jur-oab-capture__toggle-text">
            <strong>WhatsApp Meta</strong>
            <small>Alertas de prazo crítico no telefone do escritório</small>
        </span>
    </label>

    <label class="jur-oab-capture__toggle">
        <input type="checkbox" name="alerta_email" value="1" {{ config.alertaEmail ? 'checked' : '' }}>
        <span class="jur-oab-capture__toggle-box" aria-hidden="true"></span>
        <span class="jur-oab-capture__toggle-text">
            <strong>E-mail</strong>
            <small>Resumo de prazos no e-mail configurado</small>
        </span>
    </label>

    <div class="jur-oab-capture__phone">
        <label class="jur-oab-capture__label" for="jurPrazoPhone">Telefone WhatsApp (com DDD)</label>
        <input type="tel" id="jurPrazoPhone" name="telefone_alerta" class="form-control form-control-sm"
               placeholder="11999999999" value="{{ config.telefoneAlerta|default('') }}">
    </div>

    <div class="jur-oab-capture__phone mt-2">
        <label class="jur-oab-capture__label" for="jurPrazoEmail">E-mail de alertas</label>
        <input type="email" id="jurPrazoEmail" name="email_alerta" class="form-control form-control-sm"
               placeholder="socio@escritorio.com.br" value="{{ config.emailAlerta|default('') }}">
    </div>

    <button type="submit" class="btn-unio btn-sm mt-3">
        <i class="fas fa-save mr-1" aria-hidden="true"></i> Salvar alertas
    </button>
</form>
