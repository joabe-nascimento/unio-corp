{# Placeholder visual — SVG inline (sem requisição externa) #}
{% set _type = type|default('full') %}
{% if _type == 'mark' %}
<svg class="cfg-placeholder-svg cfg-placeholder-svg--mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" role="img" aria-label="Ícone padrão">
  <rect x="1" y="1" width="62" height="62" rx="14" stroke="#4F7FFF" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="5 3" fill="rgba(79,127,255,0.08)"/>
  <rect x="16" y="16" width="32" height="32" rx="8" fill="rgba(79,127,255,0.14)" stroke="rgba(79,127,255,0.24)" stroke-width="1"/>
  <path d="M28 32h8M32 28v8" stroke="#6B9AFF" stroke-width="2" stroke-linecap="round"/>
</svg>
{% elseif _type == 'favicon' %}
<svg class="cfg-placeholder-svg cfg-placeholder-svg--favicon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" role="img" aria-label="Favicon padrão">
  <rect x="1" y="1" width="30" height="30" rx="8" stroke="#4F7FFF" stroke-opacity="0.4" stroke-width="1.2" stroke-dasharray="4 2" fill="rgba(79,127,255,0.1)"/>
  <path d="M14 16h4M16 14v4" stroke="#6B9AFF" stroke-width="1.6" stroke-linecap="round"/>
</svg>
{% else %}
<svg class="cfg-placeholder-svg cfg-placeholder-svg--full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 80" fill="none" role="img" aria-label="Logotipo padrão">
  <rect x="1" y="1" width="318" height="78" rx="12" stroke="#4F7FFF" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="6 4" fill="rgba(79,127,255,0.06)"/>
  <rect x="18" y="18" width="44" height="44" rx="10" fill="rgba(79,127,255,0.12)" stroke="rgba(79,127,255,0.22)" stroke-width="1"/>
  <path d="M30 42h18M39 33v18" stroke="#6B9AFF" stroke-width="2" stroke-linecap="round"/>
  <path d="M78 28h148M78 40h112M78 52h88" stroke="rgba(15,23,42,0.12)" stroke-width="6" stroke-linecap="round"/>
  <text x="78" y="68" fill="rgba(15,23,42,0.45)" font-family="Inter, system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing="0.04em">SEU LOGOTIPO</text>
</svg>
{% endif %}
