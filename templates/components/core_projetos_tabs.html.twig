{# Abas Projetos e Metas — troca client-side (Stimulus), sem recarregar conteúdo #}
{% set _view = active_view|default('kanban') %}
<div class="hub-overview-tabs" data-hub-tabs data-initial-tab="{{ _view }}" role="tablist" aria-label="Projetos e Metas">
    <button type="button"
            class="hub-overview-tab{{ _view == 'kanban' ? ' hub-overview-tab--active' : '' }}"
            data-hub-tab="kanban"
            role="tab"
            aria-selected="{{ _view == 'kanban' ? 'true' : 'false' }}">
        <i class="fas fa-columns mr-1"></i> Kanban
    </button>
    <button type="button"
            class="hub-overview-tab{{ _view == 'lista' ? ' hub-overview-tab--active' : '' }}"
            data-hub-tab="lista"
            role="tab"
            aria-selected="{{ _view == 'lista' ? 'true' : 'false' }}">
        <i class="fas fa-diagram-project mr-1"></i> Projetos
    </button>
    <button type="button"
            class="hub-overview-tab{{ _view == 'metas' ? ' hub-overview-tab--active' : '' }}"
            data-hub-tab="metas"
            role="tab"
            aria-selected="{{ _view == 'metas' ? 'true' : 'false' }}">
        <i class="fas fa-bullseye mr-1"></i> Metas
    </button>
    {% if perm_scope|default('') and can_manage_permissions(perm_scope) %}
    <button type="button"
            class="hub-overview-tab{{ _view == 'permissions' ? ' hub-overview-tab--active' : '' }}"
            data-hub-tab="permissions"
            role="tab"
            aria-selected="{{ _view == 'permissions' ? 'true' : 'false' }}">
        <i class="fas fa-shield-halved mr-1"></i> Permissões
    </button>
    {% endif %}
</div>
