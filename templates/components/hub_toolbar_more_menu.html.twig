{#
  hub_toolbar_more_menu — ações secundárias no topo (dropdown "Mais")

  Blocks:
    items — links, botões ou forms dentro do menu
#}
<div class="dropdown hub-toolbar-more">
    <button type="button"
            class="btn-unio-ghost btn-sm dropdown-toggle"
            data-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
            title="Mais ações">
        <i class="fas fa-ellipsis-h mr-1" aria-hidden="true"></i>
        Mais
    </button>
    <div class="dropdown-menu dropdown-menu-right unio-dropdown">
        {% block items %}{% endblock %}
    </div>
</div>
