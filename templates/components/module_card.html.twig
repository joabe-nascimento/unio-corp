{#
  module_card — card de submódulo com título, descrição e atalhos (estilo apps: ícone + nome)

  Props:
    title     (string)
    subtitle  (string, opt)
    links     (array)  { label, route, icon, primary? }
#}
<div class="huplex-card flex-fill module-card">
    <div class="section-title mb-1">{{ title }}</div>
    {% if subtitle is defined and subtitle %}
        <div class="section-subtitle {% if links is defined and links %}mb-3{% else %}mb-0{% endif %}">{{ subtitle }}</div>
    {% endif %}
    {% if links is defined and links|length > 0 %}
        {% set dock_links = links|filter(l => not l.primary|default(false)) %}
        {% set primary_links = links|filter(l => l.primary|default(false)) %}
        <div class="module-card-actions">
            {% if dock_links|length > 0 %}
            <div class="dashboard-module-dock module-card-dock" role="list">
                {% for link in dock_links %}
                    {% include 'components/module_tile.html.twig' with {
                        icon: link.icon|default('fa-circle'),
                        title: link.label,
                        route: link.route,
                        variant: 'dock',
                        index: loop.index0
                    } %}
                {% endfor %}
            </div>
            {% endif %}
            {% for link in primary_links %}
            <a href="{{ path(link.route) }}" class="btn-huplex btn-sm module-card-actions__primary">
                <i class="fas {{ link.icon|default('fa-arrow-right') }} mr-1" aria-hidden="true"></i>{{ link.label }}
            </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
