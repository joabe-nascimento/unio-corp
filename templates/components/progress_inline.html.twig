{#
  progress_inline — barra de progresso compacta (design system Unio)

  Props:
    percent   (int)     0–100
    variant   (string)  accent | info | warning | success  (default: accent)
    min_width (int)     largura mínima em px (default: 80)
    show_label (bool)   exibe % abaixo (default: true)
#}
{% set _variant = variant|default('accent') %}
{% set _compact = compact|default(false) %}
<div class="progress-unio-wrap{% if _compact %} progress-unio-wrap--compact{% endif %}">
    <div class="progress-unio"{% if min_width is defined %} style="min-width: {{ min_width }}px;"{% endif %}>
        <div class="progress-unio-bar progress-unio-bar--{{ _variant }}" style="width: {{ percent|default(0) }}%;" role="progressbar" aria-valuenow="{{ percent|default(0) }}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    {% if show_label|default(true) %}
        <small class="progress-unio-label">{{ percent|default(0) }}%</small>
    {% endif %}
</div>
