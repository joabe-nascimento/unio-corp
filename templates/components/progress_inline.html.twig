{#
  progress_inline — barra de progresso compacta (design system Huplex)

  Props:
    percent   (int)     0–100
    variant   (string)  accent | info | warning | success  (default: accent)
    min_width (int)     largura mínima em px (default: 80)
    show_label (bool)   exibe % abaixo (default: true)
#}
{% set _variant = variant|default('accent') %}
<div class="progress-huplex"{% if min_width is defined %} style="min-width: {{ min_width }}px;"{% endif %}>
    <div class="progress-huplex-bar progress-huplex-bar--{{ _variant }}" style="width: {{ percent|default(0) }}%;" role="progressbar" aria-valuenow="{{ percent|default(0) }}" aria-valuemin="0" aria-valuemax="100"></div>
</div>
{% if show_label|default(true) %}
    <small class="progress-huplex-label">{{ percent|default(0) }}%</small>
{% endif %}
