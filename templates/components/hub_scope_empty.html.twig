{#
  hub_scope_empty — módulo acessível mas sem produtos visíveis (grants)

  Props:
    icon   (string, opt)
    title  (string, opt)
    text   (string, opt)
#}
<div class="empty-state-panel">
    {% include 'components/empty_state.html.twig' with {
        icon: icon|default('fa-lock'),
        title: title|default('Nenhuma área disponível'),
        text: text|default('Você ainda não tem permissão para acessar os produtos deste módulo. Solicite ao gestor da equipe.'),
        hero: true
    } %}
</div>
