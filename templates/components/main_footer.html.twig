{# Rodapé global do app logado (base.html.twig) #}
{% set _pnome = platform_config.plataforma_nome|default('Unio') %}
<footer class="main-footer">
    <div class="main-footer__stack">
        <p class="main-footer__line">
            <span class="main-footer__brand">{{ _pnome }}</span><span class="main-footer__dot" aria-hidden="true">·</span><span class="main-footer__copy">&copy; {{ "now"|date("Y") }}</span><span class="main-footer__dot" aria-hidden="true">·</span><span class="main-footer__tagline">{{ platform_config.rodape_texto|default(platform_config.plataforma_tagline|default('Plataforma de Gestão de Pessoas')) }}</span>
        </p>
        {% include 'components/platform_support.html.twig' with { extra_class: ' platform-support--footer' } %}
        {% include 'components/platform_legal.html.twig' with { variant: 'minimal', extra_class: ' platform-legal--footer' } %}
    </div>
</footer>
