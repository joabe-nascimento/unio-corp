{#
  global_search — busca por intenção (Organismo) ou legado
#}
{% set _org = organismo.enabled|default(false) %}
{% set _copy = organismo.copy|default({}) %}
<div class="global-search"
     data-global-search
     data-members="{{ global_search_members_json|default('[]')|e('html_attr') }}"
     data-organismo="{{ _org ? '1' : '0' }}">
    <div class="global-search-input-wrap">
        <i class="fas fa-magnifying-glass global-search-icon" aria-hidden="true"></i>
        <input type="search"
               class="global-search-input"
               placeholder="{{ _org ? _copy.search_placeholder|default('O que você quer fazer?') : 'Busque por um app, núcleo ou membro…' }}"
               autocomplete="off"
               aria-label="Busca global"
               aria-expanded="false"
               aria-controls="globalSearchPanel"
               aria-autocomplete="list">
        <kbd class="global-search-kbd d-none d-md-inline" aria-hidden="true">Ctrl K</kbd>{# substituído por JS conforme SO #}
    </div>

    <div class="global-search-panel"
         id="globalSearchPanel"
         role="region"
         aria-label="Resultados da busca"
         hidden>
        <div class="global-search-filters" role="tablist" aria-label="Filtrar resultados">
            <button type="button" class="global-search-filter is-active" data-filter="all" role="tab" aria-selected="true">{{ _org ? _copy.search_filter_all|default('Tudo') : 'Tudo' }}</button>
            <button type="button" class="global-search-filter" data-filter="hub" role="tab" aria-selected="false">{{ _org ? _copy.search_filter_pratica|default('Práticas') : 'Núcleos' }}</button>
            <button type="button" class="global-search-filter" data-filter="app" role="tab" aria-selected="false">
                <i class="fas fa-grip" aria-hidden="true"></i> {{ _org ? 'Atalhos' : 'Apps' }}
            </button>
            <button type="button" class="global-search-filter" data-filter="member" role="tab" aria-selected="false">{{ _org ? _copy.membros|default('Membros') : 'Membros' }}</button>
            {% if not _org %}
            <button type="button" class="global-search-filter global-search-filter--helix" data-helix-open title="Abrir Vitória — assistente">
                <span class="global-search-filter-helix-dot" aria-hidden="true"></span>
                Buscar com a Vitória
            </button>
            {% endif %}
        </div>

        <div class="global-search-body">
            <p class="global-search-recent-label" data-search-recent-label hidden>Recentes</p>
            <div class="global-search-empty" data-search-empty>
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <p class="global-search-empty-title">Nada por aqui ainda!</p>
                <p class="global-search-empty-text">{{ _org ? 'Digite uma intenção — admitir membro, ver férias, abrir chamado…' : 'Comece digitando no campo de busca para descobrir núcleos, apps e membros.' }}</p>
            </div>
            <ul class="global-search-results" id="globalSearchResults" data-search-results role="listbox" hidden></ul>
        </div>
    </div>
</div>
