{# Paleta global — carregar antes de unio-app.css #}
{% set _cor = platform_config.cor_primaria|default('#3D5AE8') %}
<link rel="stylesheet" href="{{ asset('css/unio-theme.css') }}?v=16">
{# cor_primaria da plataforma — accent sólido em ambos os temas #}
<style>
[data-theme="dark"],
[data-theme="light"] {
    --accent: {{ _cor }};
    --action-solid: {{ _cor }};
}
</style>
