{# Seção Sasha / IA — card compacto #}
{% import 'macros/helix.html.twig' as helix %}

<section class="welcome-ai-spotlight welcome-ai-spotlight--compact" data-welcome-section="helix" aria-labelledby="welcome-ai-title">
    <div class="welcome-ai-spotlight-bg" aria-hidden="true"></div>

    <div class="welcome-ai-spotlight-inner">
        <div class="welcome-ai-spotlight-brand">
            {{ helix.avatar('md', true) }}
        </div>

        <div class="welcome-ai-spotlight-copy">
            <p class="welcome-ai-eyebrow">Assistente inteligente</p>
            <h2 class="welcome-ai-title" id="welcome-ai-title">Conheça a Sasha</h2>
            <p class="welcome-ai-lead">
                Copiloto contextual para dúvidas sobre módulos, fluxos e indicadores da sua área.
            </p>
        </div>

        <div class="welcome-ai-actions welcome-ai-actions--compact">
            <button type="button" class="welcome-ai-btn welcome-ai-btn--primary" id="welcomeOpenHelixBtn">
                <i class="fas fa-comment-dots" aria-hidden="true"></i>
                Conversar
            </button>
            <a href="{{ path('app_chat') }}" class="welcome-ai-btn welcome-ai-btn--ghost">
                <i class="fas fa-comments" aria-hidden="true"></i>
                Bate-papo
            </a>
        </div>
    </div>
</section>

<script>
(function () {
    var btn = document.getElementById('welcomeOpenHelixBtn');
    if (!btn) { return; }
    btn.addEventListener('click', function () {
        var helixBtn = document.getElementById('helixOpenBtn');
        if (helixBtn) {
            helixBtn.click();
            return;
        }
        var panel = document.getElementById('helixPanel');
        if (panel) {
            panel.hidden = false;
            panel.classList.add('is-open');
            document.body.classList.add('helix-open');
        }
    });
})();
</script>
