{# Resumo profissional — props: summary_cards #}
{% if summary_cards|length > 0 %}
<section class="welcome-pro-summary" data-welcome-section="resumo" aria-label="Resumo da sua área">
    <header class="welcome-present-section-head welcome-present-section-head--compact">
        <div>
            <h2 class="welcome-present-section-title">Sua área em resumo</h2>
            <p class="welcome-present-section-sub">Informações profissionais da sessão e do seu perfil de acesso</p>
        </div>
    </header>
    <div class="welcome-pro-summary-grid">
        {% for card in summary_cards %}
        <article class="welcome-pro-summary-card">
            <div class="welcome-pro-summary-card-icon" aria-hidden="true">
                <i class="fas {{ card.icon }}"></i>
            </div>
            <div class="welcome-pro-summary-card-body">
                <span class="welcome-pro-summary-card-label">{{ card.label }}</span>
                <strong class="welcome-pro-summary-card-value">{{ card.value }}</strong>
                <p class="welcome-pro-summary-card-hint">{{ card.hint }}</p>
            </div>
        </article>
        {% endfor %}
    </div>
</section>
{% endif %}
