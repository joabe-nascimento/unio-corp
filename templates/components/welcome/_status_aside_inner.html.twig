<span class="welcome-present-datetime-pill welcome-present-datetime-pill--compact">
    <i class="fas fa-calendar-day" aria-hidden="true"></i>
    <span>{{ weekday }}, {{ date_label }}</span>
</span>
<span class="welcome-present-datetime-pill welcome-present-datetime-pill--time welcome-present-datetime-pill--compact">
    <i class="fas fa-clock" aria-hidden="true"></i>
    <span data-welcome-time>{{ time_label }}</span>
</span>
