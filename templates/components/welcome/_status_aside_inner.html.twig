<div class="welcome-present-aside-datetime">
    <span class="welcome-present-datetime-pill">
        <i class="fas fa-calendar-day" aria-hidden="true"></i>
        <span>{{ weekday }}, {{ date_label }}</span>
    </span>
    <span class="welcome-present-datetime-pill welcome-present-datetime-pill--time">
        <i class="fas fa-clock" aria-hidden="true"></i>
        <span data-welcome-time>{{ time_label }}</span>
    </span>
</div>
