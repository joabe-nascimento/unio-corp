{# Fundo geométrico — página Centro de Partida (referência Unio / POSMED, refinado) #}
<svg class="welcome-geometric-bg" viewBox="0 0 1440 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
        <pattern id="welcome-geo-dots" width="26" height="26" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="1.1" class="welcome-geo-dot"/>
        </pattern>
        <linearGradient id="welcome-geo-accent-a" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" class="welcome-geo-accent-stop-a"/>
            <stop offset="100%" class="welcome-geo-accent-stop-b"/>
        </linearGradient>
        <radialGradient id="welcome-geo-glow" cx="18%" cy="8%" r="55%">
            <stop offset="0%" class="welcome-geo-glow-stop-a"/>
            <stop offset="100%" class="welcome-geo-glow-stop-b"/>
        </radialGradient>
    </defs>

    <rect width="1440" height="900" fill="url(#welcome-geo-glow)"/>
    <rect width="1440" height="900" fill="url(#welcome-geo-dots)" opacity="0.85"/>

    <g class="welcome-geo-shapes" fill="none" stroke-width="1">
        <path d="M 1040 140 L 1120 220 L 1040 300 L 960 220 Z" class="welcome-geo-stroke"/>
        <rect x="180" y="48" width="128" height="80" rx="10" transform="rotate(-12 244 88)" class="welcome-geo-stroke"/>
        <path d="M 720 88 L 760 88 L 780 123 L 760 158 L 720 158 L 700 123 Z" class="welcome-geo-stroke"/>
        <path d="M 1280 320 L 1340 320 L 1310 272 Z" class="welcome-geo-stroke"/>
        <circle cx="420" cy="180" r="42" class="welcome-geo-stroke"/>
        <line x1="0" y1="220" x2="380" y2="0" class="welcome-geo-line"/>
        <line x1="820" y1="0" x2="1440" y2="180" class="welcome-geo-line"/>
        <line x1="1440" y1="260" x2="960" y2="0" class="welcome-geo-line"/>
        <line x1="60" y1="420" x2="320" y2="420" class="welcome-geo-line welcome-geo-line--soft"/>
    </g>

    <circle cx="1180" cy="96" r="3" class="welcome-geo-node"/>
    <circle cx="290" cy="120" r="2.5" class="welcome-geo-node"/>
    <circle cx="680" cy="64" r="2" class="welcome-geo-node welcome-geo-node--accent"/>
    <circle cx="1320" cy="280" r="2.5" class="welcome-geo-node"/>
</svg>
