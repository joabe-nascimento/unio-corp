{# Opção de layout — props: value, label, icon, name (opcional), checked (opcional) #}
<label class="welcome-prefs-layout-opt">
    <input type="radio"
           name="{{ name|default('welcome_layout') }}"
           value="{{ value }}"
           {% if checked|default(false) %}checked{% endif %}
           data-welcome-pref="layout">
    <span><i class="fas {{ icon }}" aria-hidden="true"></i> {{ label }}</span>
</label>
