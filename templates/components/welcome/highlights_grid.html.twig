{# Valor da plataforma — props: highlights #}
<section class="welcome-present-highlights huplex-card" data-welcome-section="highlights">
    <header class="welcome-present-section-head">
        <div>
            <h2 class="welcome-present-section-title">Por que usar esta plataforma</h2>
            <p class="welcome-present-section-sub">Recursos pensados para gestão moderna de pessoas e operações</p>
        </div>
    </header>
    <div class="welcome-present-highlights-grid">
        {% for item in highlights %}
        <article class="welcome-present-highlight">
            <div class="welcome-present-highlight-icon" aria-hidden="true">
                <i class="fas {{ item.icon }}"></i>
            </div>
            <h3 class="welcome-present-highlight-title">{{ item.title }}</h3>
            <p class="welcome-present-highlight-text">{{ item.text }}</p>
        </article>
        {% endfor %}
    </div>
</section>
