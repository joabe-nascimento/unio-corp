{# Hero de apresentação — visual alinhado ao painel teal da tela de login #}
{% set p = presentation %}

<section class="welcome-present-hero welcome-present-hero--login">
    <div class="welcome-present-hero-bg" aria-hidden="true">
        <img class="welcome-present-deco welcome-present-deco--mesh"
             src="{{ asset('images/auth/mesh-network.svg') }}" alt="">
        <img class="welcome-present-deco welcome-present-deco--orbit"
             src="{{ asset('images/auth/deco-orbit.svg') }}" alt="">
        <img class="welcome-present-deco welcome-present-deco--chip"
             src="{{ asset('images/auth/deco-chip.svg') }}" alt="">
        <img class="welcome-present-deco welcome-present-deco--nodes"
             src="{{ asset('images/auth/deco-nodes-cluster.svg') }}" alt="">
    </div>

    <div class="welcome-present-hero-grid">
        <div class="welcome-present-hero-copy">
            <p class="welcome-present-eyebrow">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                {{ p.eyebrow }}
            </p>
            <h1 class="welcome-present-title">{{ greeting }}, {{ app.user.nome|split(' ')|first }}!</h1>
            <p class="welcome-present-pitch">{{ p.pitch }}</p>
            <p class="welcome-present-intro">{{ p.intro }}</p>

            {% if empresas_count > 1 %}
            <a href="{{ path('app_workspace_select', {force: 1}) }}" class="welcome-present-workspace-switch">
                <span class="welcome-present-workspace-switch-icon" aria-hidden="true">
                    <i class="fas fa-building"></i>
                </span>
                <span class="welcome-present-workspace-switch-text">
                    <strong>Trocar área de trabalho</strong>
                    <small>Selecione outra empresa ou ambiente</small>
                </span>
                <i class="fas fa-arrow-right welcome-present-workspace-switch-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}

            <div class="welcome-present-cta">
                {% if p.first_hub %}
                <a href="{{ path(p.first_hub.route) }}" class="welcome-present-btn welcome-present-btn--primary">
                    <i class="fas {{ p.first_hub.icon|default('fa-rocket') }}" aria-hidden="true"></i>
                    Começar em {{ p.first_hub.title }}
                </a>
                {% endif %}
                <a href="{{ path('app_dashboard') }}" class="welcome-present-btn welcome-present-btn--ghost">
                    <i class="fas fa-gauge-high" aria-hidden="true"></i>
                    Central do dashboard
                </a>
            </div>
        </div>

        <aside class="welcome-present-hero-aside" aria-label="Resumo da sessão">
            <div class="welcome-present-aside-meta" id="welcomeDateTime">
                {% include 'components/welcome/_status_aside_inner.html.twig' %}
            </div>
        </aside>
    </div>
</section>
