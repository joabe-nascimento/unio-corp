{# Hero — centro de partida (enxuto) #}
{% set p = presentation %}
{% set _context_parts = [] %}
{% if empresa %}
    {% set _context_parts = _context_parts|merge([empresa.nome]) %}
{% else %}
    {% set _context_parts = _context_parts|merge([platform_config.plataforma_nome|default('Unio')]) %}
{% endif %}
{% set _context_parts = _context_parts|merge([perfil_label|default('')]) %}

<section class="welcome-present-hero welcome-present-hero--login welcome-present-hero--start">
    <div class="welcome-present-hero-bg" aria-hidden="true">
        <img class="welcome-present-deco welcome-present-deco--mesh"
             src="{{ asset('images/auth/mesh-network.svg') }}" alt="">
    </div>

    <div class="welcome-present-hero-grid welcome-present-hero-grid--start">
        <header class="welcome-present-hero-top">
            <p class="welcome-present-context">
                {{ _context_parts|join(' · ') }}
            </p>
            <div class="welcome-present-datetime-compact" id="welcomeDateTime">
                {% include 'components/welcome/_status_aside_inner.html.twig' %}
            </div>
        </header>

        <div class="welcome-present-hero-copy">
            <h1 class="welcome-present-title">{{ greeting }}, {{ app.user.nome|split(' ')|first }}!</h1>
            <p class="welcome-present-subtitle">{{ p.hero_subtitle }}</p>

            <div class="welcome-present-cta">
                {% if p.first_hub %}
                <a href="{{ path(p.first_hub.route) }}" class="welcome-present-btn welcome-present-btn--primary">
                    <i class="fas {{ p.first_hub.icon|default('fa-rocket') }}" aria-hidden="true"></i>
                    Começar em {{ p.first_hub.title }}
                </a>
                {% endif %}
                <a href="#welcome-hubs" class="welcome-present-btn welcome-present-btn--ghost">
                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                    Ver todos os núcleos
                </a>
            </div>

            {% if empresas_count > 1 %}
            <a href="{{ path('app_workspace_select', {force: 1}) }}" class="welcome-present-workspace-link">
                <i class="fas fa-building" aria-hidden="true"></i>
                Trocar área de trabalho
            </a>
            {% endif %}
        </div>
    </div>
</section>
