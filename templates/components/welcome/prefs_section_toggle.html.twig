{# Toggle de seção visível — props: section_id, label, checked (opcional, default true) #}
<label class="welcome-prefs-toggle">
    <input type="checkbox"
           {% if checked|default(true) %}checked{% endif %}
           data-welcome-pref-section="{{ section_id }}">
    <span class="welcome-prefs-toggle-ui" aria-hidden="true"></span>
    <span class="welcome-prefs-toggle-label">{{ label }}</span>
</label>
