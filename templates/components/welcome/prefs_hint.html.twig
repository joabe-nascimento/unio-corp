{# Dica do painel de preferências — props: text, icon (opcional), class (opcional) #}
<p class="welcome-prefs-hint{{ class is defined and class ? ' ' ~ class : '' }}">
    {% if icon is defined and icon %}
        <i class="fas {{ icon }} mr-1" aria-hidden="true"></i>
    {% endif %}
    {{ text }}
</p>
