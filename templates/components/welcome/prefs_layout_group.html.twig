{# Grupo de layout (Confortável / Compacto) — props: options, group_label, aria_label #}
{% include 'components/welcome/prefs_group_label.html.twig' with {
    label: group_label|default('Layout')
} only %}

<div class="welcome-prefs-layout" role="radiogroup" aria-label="{{ aria_label|default('Densidade do layout') }}">
    {% for opt in options %}
        {% include 'components/welcome/prefs_layout_option.html.twig' with opt only %}
    {% endfor %}
</div>
