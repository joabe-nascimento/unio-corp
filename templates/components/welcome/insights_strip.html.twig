{# Dicas profissionais — props: insights #}
{% if insights|length > 0 %}
<section class="welcome-pro-insights unio-card" data-welcome-section="insights" aria-label="Dicas profissionais">
    <header class="welcome-present-section-head">
        <div>
            <h2 class="welcome-present-section-title">Boas práticas para você</h2>
            <p class="welcome-present-section-sub">Recomendações alinhadas ao seu perfil na plataforma</p>
        </div>
    </header>
    <div class="welcome-pro-insights-grid">
        {% for tip in insights %}
        <article class="welcome-pro-insight">
            <div class="welcome-pro-insight-icon" aria-hidden="true">
                <i class="fas {{ tip.icon }}"></i>
            </div>
            <h3 class="welcome-pro-insight-title">{{ tip.title }}</h3>
            <p class="welcome-pro-insight-text">{{ tip.text }}</p>
        </article>
        {% endfor %}
    </div>
</section>
{% endif %}
