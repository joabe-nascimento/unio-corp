{# Banner de ativação — onboarding escritório com Sasha IA #}
{% import 'macros/helix.html.twig' as helix %}
{% set _desc = desc|default('Explore processos, prazos e documentos com a Sasha — copiloto jurídica do escritório.') %}
{% set _primary_label = primary_label|default('Ver processos') %}
{% set _primary_route = primary_route|default('app_juridico') %}
{% set _primary_params = primary_params|default({}) %}

<aside class="unio-ritual unio-ritual--juridico" aria-label="Ativação Unio Jurídico">
    <div class="unio-ritual__content">
        <header class="unio-ritual__head">
            {% include 'components/unio/selo.html.twig' with {
                variant: 'compact',
                label: label|default('Ativação do escritório'),
                show_slogan: false
            } %}
            <span class="unio-ritual__ai-pill">
                {{ helix.avatar('sm', false, 'images/marketing/Sasha-assistant-juridico.jpg') }}
                <span>Sasha · copiloto IA</span>
            </span>
        </header>

        <h2 class="unio-ritual__title">Bem-vindo à&nbsp;Unio&nbsp;Jurídico</h2>
        <p class="unio-ritual__desc">{{ _desc }}</p>

        <div class="unio-ritual__actions">
            <a href="{{ path(_primary_route, _primary_params) }}" class="btn-unio btn-sm">{{ _primary_label }}</a>
            <button type="button" class="btn-unio-ghost btn-sm js-unio-open-helix">
                <i class="fas fa-robot" aria-hidden="true"></i>
                Falar com a Sasha
            </button>
        </div>
    </div>

    <figure class="unio-ritual__portrait" aria-hidden="true">
        <img
            class="unio-ritual__banner-art"
            src="{{ asset('images/marketing/hero-juridico.jpg') }}"
            alt=""
            width="960"
            height="540"
            loading="lazy"
            decoding="async"
        >
    </figure>
</aside>
