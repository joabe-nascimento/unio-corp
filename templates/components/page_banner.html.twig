{# Banner de contexto (perfil / empresa) #}
{% import 'macros/empresa.html.twig' as empresa_macro %}
<div class="page-banner">
    <div class="page-banner-icon">
        {% if use_empresa_logo|default(false) and empresa is defined and empresa and empresa.logo %}
            {{ empresa_macro.logo(empresa, 'empresa-logo banner-logo') }}
        {% elseif use_huplex_mark|default(true) %}
            <img src="{{ asset('images/huplex-mark.svg') }}" alt="" class="banner-logo huplex-brand-mark" width="32" height="32">
        {% else %}
            <i class="fas {{ icon|default('fa-circle-info') }}"></i>
        {% endif %}
    </div>
    <div class="page-banner-text">
        <div class="page-banner-title">{{ title }}</div>
        {% if subtitle is defined and subtitle %}
            <div class="page-banner-sub">{{ subtitle }}</div>
        {% endif %}
    </div>
</div>
