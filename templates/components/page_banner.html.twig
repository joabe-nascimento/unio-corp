{# Banner de contexto (perfil / empresa)
   Props: title, subtitle (opt), icon (opt, FA class), use_empresa_logo (opt)
#}
{% import 'macros/empresa.html.twig' as empresa_macro %}

{# Decide o conteúdo do ícone #}
{% set _has_empresa_logo = use_empresa_logo|default(false) and empresa is defined and empresa %}
{% set _icon_class = icon|default(null) %}

<div class="page-banner">
    {# Só renderiza a caixa do ícone se houver algo para mostrar #}
    {% if _has_empresa_logo or _icon_class %}
    <div class="page-banner-icon">
        {% if _has_empresa_logo %}
            {{ empresa_macro.logo(empresa, 'empresa-logo banner-logo') }}
        {% elseif _icon_class %}
            <i class="fas {{ _icon_class }}"></i>
        {% endif %}
    </div>
    {% endif %}

    <div class="page-banner-text">
        <div class="page-banner-title">{{ title }}</div>
        {% if subtitle is defined and subtitle %}
            <div class="page-banner-sub">{{ subtitle }}</div>
        {% endif %}
    </div>
</div>
