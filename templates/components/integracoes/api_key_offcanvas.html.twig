{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'integ-api-key-form',
    title: 'Nova chave de API',
    subtitle: 'Exibida apenas uma vez após criação',
    icon: 'fa-key',
    size: 'md',
    open: app.request.query.get('open_novo') == '1'
} %}
{% block offcanvas_body %}
<form method="post" action="{{ path('app_integracoes_api_nova_submit') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('integ_api_key_form') }}">
    <div class="form-group">
        <label for="integKeyNome">Nome</label>
        <input type="text" class="form-control" id="integKeyNome" name="nome" required placeholder="Ex.: Integração BI produção">
    </div>
    <div class="form-group">
        <label for="integKeyAmb">Ambiente</label>
        <select class="form-control" id="integKeyAmb" name="ambiente">
            <option value="prod">Produção</option>
            <option value="dev">Desenvolvimento</option>
        </select>
    </div>
    <div class="form-group">
        <label>Scopes</label>
        {% for scope in scopes|default([]) %}
        <div class="form-check">
            <input type="checkbox" class="form-check-input" name="scopes[]" value="{{ scope.id }}" id="scope_{{ scope.id }}">
            <label class="form-check-label" for="scope_{{ scope.id }}"><code>{{ scope.id }}</code> — {{ scope.label }}</label>
        </div>
        {% endfor %}
    </div>
    <button type="submit" class="btn-unio btn-block">Gerar chave</button>
</form>
{% endblock %}
{% endembed %}
