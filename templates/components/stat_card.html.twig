{#
  stat_card — KPI (usado por kpi_row em toda a plataforma)
  Props:
    value   (string|int)  valor principal
    label   (string)      descrição
    sub     (string, opt) texto secundário pequeno
    icon    (string, opt) classe Font Awesome, ex: fa-users
    route   (string, opt) se passado, envolve o card em <a href>
    trend   (string, opt) 'up' | 'down' | null
#}
{% set card_html %}
<div class="unio-card stat-card w-100">
    <div class="unio-kpi-icon" aria-hidden="true">
        <i class="fas {{ icon|default('fa-chart-line') }}"></i>
    </div>
    <div class="stat-card-body">
        <div class="card-value">{{ value }}</div>
        <div class="card-label">{{ label }}</div>
        {% if sub is defined and sub %}
            <div class="card-sub">{{ sub }}</div>
        {% endif %}
    </div>
    {% if trend is defined and trend %}
        <div class="stat-trend stat-trend--{{ trend }}">
            <i class="fas fa-arrow-{{ trend == 'up' ? 'up' : 'down' }}"></i>
        </div>
    {% endif %}
</div>
{% endset %}

{% if route is defined and route %}
    <a href="{{ path(route) }}" class="text-decoration-none d-flex w-100">{{ card_html }}</a>
{% else %}
    {{ card_html }}
{% endif %}
