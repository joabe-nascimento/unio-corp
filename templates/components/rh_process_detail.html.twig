{#
  rh_process_detail — detalhe de onboarding/offboarding (checklist + ficha)

  Props:
    process, variant (onboarding|offboarding), checklist_title,
    complete_label, confirm_message, detail_sections (array of {title, items}),
    hint (string), profile { name, subtitle, badge? }
#}
{% set variant = variant|default('onboarding') %}
{% set progress = process.checklistProgress %}
{% set done_count = process.checklistDoneCount %}
{% set total_count = process.checklist|length %}
{% set is_complete = process.status == 'CONCLUIDO' %}

<div class="rh-process-show rh-process-show--{{ variant }}">
    <div class="rh-process-show-layout">
        <section class="rh-process-show-main unio-card" aria-labelledby="rh-checklist-heading">
            <header class="rh-process-show-checklist-head">
                <div class="rh-process-show-checklist-title-wrap">
                    <h2 id="rh-checklist-heading" class="rh-process-show-checklist-title">{{ checklist_title }}</h2>
                    <p class="rh-process-show-checklist-meta">
                        {% if is_complete %}
                            Processo concluído
                        {% else %}
                            {{ done_count }} de {{ total_count }} itens concluídos
                        {% endif %}
                    </p>
                </div>
                <div class="rh-process-show-progress-wrap" role="progressbar"
                     aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100"
                     aria-label="Progresso do checklist">
                    <span class="rh-process-show-progress-pct">{{ progress }}%</span>
                    <div class="rh-process-show-progress-bar">
                        <div class="rh-process-show-progress-fill" style="width: {{ progress }}%"></div>
                    </div>
                </div>
            </header>

            {% include 'components/rh_process_checklist.html.twig' with { process: process } %}

            {% if not is_complete and grant_at_least('product_rh', 'admissoes', 'GESTOR_EQUIPE') %}
            <footer class="rh-process-show-checklist-foot">
                <form method="post" class="rh-process-complete-form" data-confirm="{{ confirm_message }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('rh_process_action') }}">
                    <input type="hidden" name="action" value="complete">
                    <button type="submit"
                            class="btn-unio rh-process-show-complete-btn"
                            {% if progress < 100 %}disabled{% endif %}>
                        <i class="fas fa-flag-checkered mr-2" aria-hidden="true"></i>
                        {{ complete_label }}
                    </button>
                    {% if progress < 100 %}
                    <p class="rh-process-show-complete-hint">
                        Marque todos os itens acima para habilitar a conclusão.
                    </p>
                    {% endif %}
                </form>
            </footer>
            {% endif %}
        </section>

        <aside class="rh-process-show-aside">
            {% if profile is defined and profile %}
            <div class="rh-process-show-profile unio-card">
                <div class="rh-process-show-avatar" aria-hidden="true">
                    {{ profile.name|slice(0, 1)|upper }}
                </div>
                <div class="rh-process-show-profile-body">
                    <p class="rh-process-show-profile-name">{{ profile.name }}</p>
                    {% if profile.subtitle is defined and profile.subtitle %}
                    <p class="rh-process-show-profile-sub">{{ profile.subtitle }}</p>
                    {% endif %}
                    {% if profile.badge is defined and profile.badge %}
                    <span class="status-badge status-badge--{{ profile.badge_tone|default('info') }}">{{ profile.badge }}</span>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {% for section in detail_sections|default([]) %}
            <div class="rh-process-show-section unio-card">
                {% include 'components/unio/detail_field_section.html.twig' with {
                    title: section.title,
                    items: section.items
                } only %}
            </div>
            {% endfor %}

            {% if hint is defined and hint %}
            <div class="rh-process-show-hint unio-card">
                <p class="rh-process-show-hint-label">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    Como funciona
                </p>
                <p class="rh-process-show-hint-text">{{ hint|raw }}</p>
            </div>
            {% endif %}

            {% if show_process_extras|default(true) %}
                {% include 'components/rh/process_extras_panel.html.twig' with {
                    process: process,
                    documentos: documentos|default([]),
                    variant: variant
                } %}
            {% endif %}
        </aside>
    </div>
</div>
