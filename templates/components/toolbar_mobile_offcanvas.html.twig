{#
  toolbar_mobile_offcanvas — painel lateral mobile para filtros/busca clonados

  Props:
    id    (string)  slug do offcanvas (obrigatório)
    title (string, opt)
    icon  (string, opt)
#}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: id,
    title: title|default('Filtros e busca'),
    icon: icon|default('fa-sliders'),
    placement: 'bottom',
    size: 'md',
    accent: false
} %}
    {% block offcanvas_root_attrs %} data-toolbar-mobile-offcanvas{% endblock %}
    {% block offcanvas_body %}
        <div class="toolbar-mobile-offcanvas-mount" data-toolbar-mobile-mount="{{ id }}"></div>
    {% endblock %}
{% endembed %}
