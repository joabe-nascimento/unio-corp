{#
  list_toolbar — título no topo; ações/filtros/busca opcionais

  Layout --page (page_title definido):
    - Busca oculta no topo por padrão (use section_toolbar)
    - Passe search_in_top: true para manter busca aqui (ex.: Notificações)

  Variáveis:
    page_title         (string, opt) layout --page (colado no topo, sem margens)
    search_placeholder (string)
    search_disabled    (bool)
    search_hidden      (bool)  default: true em --page, exceto search_in_top
    search_in_top      (bool)  força busca no topo mesmo em --page
    filters_in_top     (bool)  exibe bloco de filtros no topo
    actions_in_top     (bool)  default: false em --page (ações vão na section_toolbar)
    actions_before_title (bool)  seta/voltar à esquerda do título

  Blocks:
    toolbar_actions
    toolbar_filters
    toolbar_subnav

  Voltar: usa page_back_route (global via PageBackResolver) com page_back_link componentizado.
#}
{% set _is_page = page_title is defined and page_title %}
{% set _search_in_top = search_in_top|default(false) %}
{% set _search_hidden = search_hidden is defined ? search_hidden : (_is_page and not _search_in_top) %}
{% set _filters_in_top = filters_in_top|default(false) %}
{% set _show_page_back = page_back_route|default(null) and not page_back_hide|default(false) %}
{% set _show_actions = not _is_page or actions_in_top|default(false) %}
{% set _toolbar_actions_html = block('toolbar_actions')|trim %}
{# CTAs no cabeçalho ficam à direita (não colados ao título) #}
{% set _actions_on_right = _show_actions and _toolbar_actions_html != '' and not actions_before_title|default(false) and (_is_page or _show_page_back) %}
{% set _back_first = _show_page_back or (actions_before_title|default(false) and _show_actions) %}
{% set _show_toolbar_end = _filters_in_top or not _search_hidden or _actions_on_right %}
<div class="list-toolbar{% if _is_page %} list-toolbar--page{% else %} unio-card mb-3{% endif %}">
    <div class="list-toolbar-main">
        <div class="list-toolbar-left{% if _back_first %} list-toolbar-left--back-first{% else %} list-toolbar-left--stacked{% endif %}">
            {% if _back_first %}
                <div class="list-toolbar-actions list-toolbar-back">
                    {% if _show_page_back %}
                        {% include 'components/page_back_link.html.twig' with {
                            href: path(page_back_route, page_back_route_params|default({})),
                            label: 'Voltar',
                            icon_only: true,
                            inline: true
                        } %}
                    {% elseif _show_actions %}
                        {{ block('toolbar_actions') }}
                    {% endif %}
                </div>
            {% endif %}
            <div class="list-toolbar-heading">
                {% if _is_page %}
                    <div class="list-toolbar-heading-text">
                        <h1 class="list-toolbar-title">{{ page_title }}</h1>
                        {% if page_subtitle|default('') %}
                        <p class="list-toolbar-subtitle">{{ page_subtitle }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            {% if not _back_first and _show_actions and not _actions_on_right %}
                <div class="list-toolbar-actions">
                    {{ block('toolbar_actions') }}
                </div>
            {% endif %}
        </div>
        {% if _show_toolbar_end %}
            <div class="list-toolbar-end">
                {% if _actions_on_right %}
                    <div class="list-toolbar-actions list-toolbar-actions--top-end">
                        {{ block('toolbar_actions') }}
                    </div>
                {% endif %}
                {% if _filters_in_top or not _search_hidden %}
                {% set _route = app.request.attributes.get('_route')|default('page') %}
                {% set _offcanvas_id = offcanvas_id|default('list-toolbar-filters-' ~ _route|replace({'.': '-'})) %}
                {% embed 'components/toolbar_controls_dual.html.twig' with {
                    offcanvas_id: _offcanvas_id,
                    fab_label: fab_label|default('Filtros e busca')
                } %}
                    {% block toolbar_dual_filters %}
                        {% block toolbar_filters %}{% endblock %}
                    {% endblock %}
                    {% block toolbar_dual_search %}
                        {% if not _search_hidden %}
                            {% include 'components/toolbar_search.html.twig' with {
                                search_placeholder: search_placeholder|default('Buscar…'),
                                search_disabled: search_disabled|default(false)
                            } %}
                        {% endif %}
                    {% endblock %}
                {% endembed %}
                {% endif %}
            </div>
        {% endif %}
    </div>
    {% block toolbar_subnav %}{% endblock %}
</div>
