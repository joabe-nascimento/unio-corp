{#
  recrutamento/hub_back_link — voltar ao núcleo ou tela pai

  Props:
    href   (string, default app_recrutamento)
    label  (string, default 'Recrutamento')
    icon   (string, FA icon without fa- prefix, default 'arrow-left')
#}
<a href="{{ href|default(path('app_recrutamento')) }}" class="btn-unio-ghost btn-sm recrutamento-hub-back">
    <i class="fas fa-{{ icon|default('arrow-left') }} mr-1" aria-hidden="true"></i> {{ label|default('Recrutamento') }}
</a>
