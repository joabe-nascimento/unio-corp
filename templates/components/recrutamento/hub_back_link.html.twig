{#
  recrutamento/hub_back_link — legado; prefira page_back_route automático + page_back_link

  Props:
    href   (string, default app_recrutamento)
    label  (string, default 'Recrutamento')
    icon   (string, FA icon without fa- prefix, default 'arrow-left')
#}
{% include 'components/page_back_link.html.twig' with {
    href: href|default(path('app_recrutamento')),
    label: label|default('Recrutamento'),
    icon: 'fa-' ~ icon|default('arrow-left'),
    icon_only: true
} %}
