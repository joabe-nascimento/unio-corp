{# Indicador do Agente Autônomo — monitoramento de prazos/tarefas/carteira em background #}
{% if app.user and organismo.enabled|default(false) and org_juridico|default(false) %}
<div class="agente-autonomo-meter" id="agenteAutonomoMeter" data-status-url="{{ path('api_vitoria_agente_status') }}" title="Agente Autônomo — monitoramento em background">
    <span class="agente-autonomo-meter__icon" aria-hidden="true"><i class="fas fa-robot"></i></span>
    <span class="agente-autonomo-meter__body">
        <span class="agente-autonomo-meter__label">Agente</span>
        <span class="agente-autonomo-meter__value" id="agenteAutonomoMeterValue">—</span>
    </span>
    <span class="agente-autonomo-meter__dot" id="agenteAutonomoMeterDot" aria-hidden="true"></span>
</div>
{% endif %}
