{# Indicador do Agente Autônomo — monitoramento de prazos/tarefas/carteira em background #}
{% if app.user and organismo.enabled|default(false) and org_juridico|default(false) %}
<div class="org-meter org-meter--agente agente-autonomo-meter" id="agenteAutonomoMeter" data-status-url="{{ path('api_Sasha_agente_status') }}">
    <span class="org-meter__icon agente-autonomo-meter__icon" aria-hidden="true"><i class="fas fa-robot"></i></span>
    <span class="org-meter__body agente-autonomo-meter__body">
        <span class="org-meter__label agente-autonomo-meter__label">Agente</span>
        <span class="org-meter__value agente-autonomo-meter__value" id="agenteAutonomoMeterValue">—</span>
    </span>
    <span class="org-meter__dot agente-autonomo-meter__dot" id="agenteAutonomoMeterDot" aria-hidden="true"></span>
</div>
{% endif %}
