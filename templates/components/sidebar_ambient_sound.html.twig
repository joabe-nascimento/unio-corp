{# Som ambiente — ícone minimal à esquerda. Props: user_id #}
<div class="sidebar-ambient"
     data-ambient-sound
     data-user-id="{{ user_id|default(0) }}">
    <button type="button"
            class="sidebar-ambient-btn"
            data-ambient-toggle
            aria-pressed="false"
            title="Som ambiente"
            aria-label="Ativar som ambiente">
        <i class="fas fa-volume-off" data-ambient-icon aria-hidden="true"></i>
    </button>
</div>
