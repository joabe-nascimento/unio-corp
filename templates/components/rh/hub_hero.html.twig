{# rh/hub_hero — banner principal do hub RH #}
<section class="rh-hub-hero huplex-card">
    <div class="rh-hub-hero-bg" aria-hidden="true"></div>
    <div class="rh-hub-hero-inner rh-hub-hero-inner--banner">
        <div class="rh-hub-hero-copy">
            <p class="rh-hub-hero-eyebrow">
                <i class="fas fa-building mr-1" aria-hidden="true"></i>
                {{ empresa.nome }}
            </p>
            <h2 class="rh-hub-hero-title">Centro de Pessoas</h2>
            <p class="rh-hub-hero-desc">
                Visão unificada de admissões, operação, férias, folha e desligamentos — dados em tempo real da empresa ativa.
            </p>
            <div class="rh-hub-hero-chips">
                <span class="rh-hub-chip"><i class="fas fa-users"></i> {{ ativos }} ativos</span>
                <span class="rh-hub-chip"><i class="fas fa-user-plus"></i> {{ onboarding_open }} admissões</span>
                <span class="rh-hub-chip"><i class="fas fa-umbrella-beach"></i> {{ ferias_pendentes }} férias pendentes</span>
                <span class="rh-hub-chip"><i class="fas fa-layer-group"></i> {{ processos_abertos_total }} processos abertos</span>
                <span class="rh-hub-chip rh-hub-chip--muted"><i class="fas fa-calendar"></i> {{ folha_ref_label }}</span>
            </div>
        </div>
        <aside class="rh-hub-hero-aside" aria-label="RH Pulse">
            {% include 'components/rh/hub_pulse_widget.html.twig' with { rh_pulse: rh_pulse, variant: 'hero' } %}
        </aside>
    </div>
</section>
