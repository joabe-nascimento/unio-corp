{# rh/hub_insights_row — métricas rápidas do hub #}
<section class="rh-hub-insights" aria-label="Indicadores de RH">
    <div class="rh-hub-insights-grid">
        {% for item in items %}
        <div class="rh-hub-insight rh-hub-insight--{{ item.tone }}">
            <span class="rh-hub-insight-icon" aria-hidden="true"><i class="fas {{ item.icon }}"></i></span>
            <div class="rh-hub-insight-body">
                <span class="rh-hub-insight-label">{{ item.label }}</span>
                <span class="rh-hub-insight-value" data-count-target="{{ item.value|replace({'%': ''}) }}">{{ item.value }}</span>
                <span class="rh-hub-insight-sub">{{ item.sub }}</span>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
