{#
  rh/funcionario_offcanvas — wizard passo a passo com Stimulus (rh-wizard + tom-select)
#}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'rh-funcionario-novo',
    title: 'Novo funcionário',
    subtitle: 'Cadastro passo a passo',
    icon: 'fa-id-card',
    size: 'lg',
    wizard: true,
    open: open|default(false)
} %}
    {% block offcanvas_drawer_attrs %}data-controller="rh-wizard"{% endblock %}

    {% block offcanvas_body %}
    <div class="rh-funcionario-wizard-body rh-funcionario-wizard">
        <div class="rh-admissao-offcanvas-progress">
            <div class="rh-admissao-offcanvas-progress-track">
                <div class="progress-unio">
                    <div class="progress-unio-bar progress-unio-bar--accent"
                         data-rh-wizard-target="progressBar"
                         style="width: 20%;"
                         role="progressbar"
                         aria-valuenow="20"
                         aria-valuemin="0"
                         aria-valuemax="100"></div>
                </div>
                <small class="progress-unio-label" data-rh-wizard-target="progressPct">20%</small>
            </div>
            <span class="rh-admissao-offcanvas-progress-label" data-rh-wizard-target="progressLabel">Identificação · 1 de 5</span>
        </div>

        {% include 'components/rh/funcionario_form_body.html.twig' with {
            empresa: empresa,
            departamentos: departamentos|default([]),
            gestores: gestores|default([]),
            form_data: form_data|default({}),
            form_id: 'rhFuncionarioNovaForm',
            form_action: path('app_rh_funcionario_novo'),
            layout: 'wizard'
        } %}
    </div>
    {% endblock %}

    {% block offcanvas_footer %}
    <div class="unio-offcanvas-footer rh-funcionario-wizard-footer">
        <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
        <div class="rh-funcionario-wizard-footer-actions">
            <button type="button" class="btn-unio-ghost" data-rh-wizard-target="prev" data-action="rh-wizard#goPrev" hidden>
                <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Anterior
            </button>
            <button type="button" class="btn-unio" data-rh-wizard-target="next" data-action="rh-wizard#goNext">
                Próximo <i class="fas fa-arrow-right ml-1" aria-hidden="true"></i>
            </button>
            <button type="submit" form="rhFuncionarioNovaForm" class="btn-unio" data-rh-wizard-target="submit" hidden>
                <i class="fas fa-check mr-1" aria-hidden="true"></i> Salvar funcionário
            </button>
        </div>
    </div>
    {% endblock %}
{% endembed %}
