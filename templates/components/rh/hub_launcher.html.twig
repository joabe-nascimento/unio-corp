{#
  rh/hub_launcher — dock agrupado (2 grupos), destaque em módulos com pendências

  Props: modules — icon, short|title, route, count, tone, group, has_activity
#}
<section class="rh-hub-modules" aria-label="Módulos de RH">
    <header class="rh-hub-modules-head">
        <h3 class="rh-hub-modules-title">Módulos</h3>
    </header>

    {% set group_labels = {
        'operacao': 'Operação',
        'folha': 'Folha & compliance'
    } %}

    <div class="rh-hub-modules-groups">
        {% for group_key, group_label in group_labels %}
            {% set group_has_items = false %}
            {% for mod in modules %}
                {% if mod.group|default('operacao') == group_key %}{% set group_has_items = true %}{% endif %}
            {% endfor %}
            {% if group_has_items %}
            <div class="rh-hub-modules-group">
                <h4 class="rh-hub-modules-group-label">{{ group_label }}</h4>
                <div class="rh-hub-modules-dock" role="list">
                    {% for mod in modules %}
                    {% if mod.group|default('operacao') == group_key %}
                    <a href="{{ path(mod.route) }}"
                       class="rh-hub-mod-pill rh-hub-mod-pill--{{ mod.tone }}{% if mod.has_activity|default(false) %} rh-hub-mod-pill--active{% else %} rh-hub-mod-pill--idle{% endif %}"
                       role="listitem"
                       title="{{ mod.title }}{% if mod.has_activity|default(false) %} · {{ mod.count }} pendente(s){% endif %}">
                        <span class="rh-hub-mod-icon-wrap">
                            <span class="rh-hub-mod-icon" aria-hidden="true">
                                <i class="fas {{ mod.icon }}"></i>
                            </span>
                            {% if mod.has_activity|default(false) %}
                            <span class="rh-hub-mod-badge" aria-label="{{ mod.count }} pendente(s)">{{ mod.count > 9 ? '9+' : mod.count }}</span>
                            {% endif %}
                        </span>
                        <span class="rh-hub-mod-name">{{ mod.short|default(mod.title) }}</span>
                    </a>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        {% endfor %}
    </div>
</section>
