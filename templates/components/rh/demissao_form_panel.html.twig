{# Formulário de nova demissão (offboarding) #}
{% set checklist = checklist_preview|default([]) %}
{% set funcionario_options = [{ value: '', label: 'Selecione o colaborador…' }] %}
{% for f in funcionarios %}
    {% set funcionario_options = funcionario_options|merge([{
        value: f.id,
        label: f.nome ~ (f.cargo ? ' — ' ~ f.cargo : '')
    }]) %}
{% endfor %}

<div class="rh-admissao-page rh-offboard-page">
    <div class="rh-admissao-layout">
        <div class="rh-admissao-main huplex-card">
            <div class="rh-admissao-steps" aria-label="Etapas do processo">
                <div class="rh-admissao-step rh-admissao-step--active">
                    <span class="rh-admissao-step-num">1</span>
                    <span class="rh-admissao-step-text">
                        <strong>Dados do desligamento</strong>
                        <small>Colaborador e prazos</small>
                    </span>
                </div>
                <div class="rh-admissao-step rh-admissao-step--next" aria-hidden="true">
                    <span class="rh-admissao-step-num">2</span>
                    <span class="rh-admissao-step-text">
                        <strong>Checklist de offboarding</strong>
                        <small>Após salvar</small>
                    </span>
                </div>
            </div>

            <header class="rh-admissao-main-head">
                <h2 class="rh-admissao-main-title">Iniciar offboarding</h2>
                <p class="rh-admissao-main-sub">
                    Registre o desligamento do colaborador. Em seguida você acompanha revogação de acessos, equipamentos e documentação rescisória.
                </p>
            </header>

            <form method="post" class="huplex-form rh-admissao-form">
                <input type="hidden" name="_token" value="{{ csrf_token('rh_demissao_form') }}">
                <div class="rh-admissao-fields">
                    <div class="rh-admissao-field rh-admissao-field--full">
                        {% include 'components/huplex_form_field.html.twig' with {
                            id: 'funcionario_id',
                            name: 'funcionario_id',
                            label: 'Colaborador',
                            type: 'select',
                            required: true,
                            value: funcionario_id|default(''),
                            options: funcionario_options
                        } %}
                    </div>
                    <div class="rh-admissao-field">
                        {% include 'components/huplex_form_field.html.twig' with {
                            id: 'data_prevista',
                            name: 'data_prevista',
                            label: 'Data prevista de desligamento',
                            type: 'date',
                            value: data_prevista|default('')
                        } %}
                    </div>
                    <div class="rh-admissao-field">
                        {% include 'components/huplex_form_field.html.twig' with {
                            id: 'motivo',
                            name: 'motivo',
                            label: 'Motivo do desligamento',
                            value: motivo|default(''),
                            placeholder: 'Ex.: pedido de demissão, término de contrato'
                        } %}
                    </div>
                    <div class="rh-admissao-field rh-admissao-field--full">
                        {% include 'components/huplex_form_field.html.twig' with {
                            id: 'observacoes',
                            name: 'observacoes',
                            label: 'Observações',
                            type: 'textarea',
                            value: observacoes|default(''),
                            placeholder: 'Informações para RH, gestor ou TI (opcional)',
                            rows: 4
                        } %}
                    </div>
                </div>

                <p class="rh-admissao-required-note">
                    <span class="huplex-form-required">*</span> Campos obrigatórios
                </p>

                <div class="huplex-form-actions rh-admissao-actions">
                    <a href="{{ path('app_rh_demissoes') }}" class="btn-huplex-ghost">Cancelar</a>
                    <button type="submit" class="btn-huplex rh-offboard-submit">
                        <i class="fas fa-door-open mr-2" aria-hidden="true"></i>
                        Iniciar offboarding
                    </button>
                </div>
            </form>
        </div>

        <aside class="rh-admissao-aside">
            {% if empresa is defined and empresa %}
            <div class="rh-admissao-aside-card huplex-card">
                <p class="rh-admissao-aside-label">Área de trabalho</p>
                <p class="rh-admissao-aside-empresa">{{ empresa.nome }}</p>
                {% if empresa.setor %}
                <p class="rh-admissao-aside-meta">{{ empresa.setor }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% if checklist|length > 0 %}
            <div class="rh-admissao-aside-card huplex-card">
                <p class="rh-admissao-aside-label">
                    <i class="fas fa-list-check" aria-hidden="true"></i>
                    Próxima etapa
                </p>
                <p class="rh-admissao-aside-hint">
                    Após iniciar, marque cada item até concluir. O funcionário será inativado e os acessos revogados ao finalizar.
                </p>
                <ul class="rh-admissao-checklist-preview">
                    {% for item in checklist %}
                    <li>
                        <i class="far fa-circle" aria-hidden="true"></i>
                        <span>{{ item.label }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div class="rh-admissao-aside-card rh-admissao-aside-card--tip rh-offboard-tip huplex-card">
                <p class="rh-admissao-aside-label">
                    <i class="fas fa-lightbulb" aria-hidden="true"></i>
                    Dica
                </p>
                <p class="rh-admissao-aside-hint mb-0">
                    Revogue acessos à plataforma antes de concluir, se possível. O checklist pode ser preenchido aos poucos até a data de desligamento.
                </p>
            </div>
        </aside>
    </div>
</div>
