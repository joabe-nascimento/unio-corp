{#
  rh/hub_timeline — painel lateral de movimentações recentes

  Props:
    title, subtitle, empty_text, items
    cada item: { icon, tone, title, subtitle, meta, route, route_params }
#}
<section class="rh-hub-timeline unio-card">
    <header class="rh-hub-section-head">
        <h3 class="rh-hub-section-title">{{ title }}</h3>
        {% if subtitle is defined %}<p class="rh-hub-section-sub">{{ subtitle }}</p>{% endif %}
    </header>
    {% if items|length > 0 %}
    <ul class="rh-hub-timeline-list">
        {% for item in items %}
        <li>
            <a href="{{ path(item.route, item.route_params|default({})) }}" class="rh-hub-timeline-item">
                <span class="rh-hub-timeline-dot rh-hub-timeline-dot--{{ item.tone|default('blue') }}" aria-hidden="true">
                    <i class="fas {{ item.icon }}"></i>
                </span>
                <span class="rh-hub-timeline-body">
                    <span class="rh-hub-timeline-title">{{ item.title }}</span>
                    <span class="rh-hub-timeline-sub">{{ item.subtitle }}</span>
                    {% if item.meta is defined %}<span class="rh-hub-timeline-meta">{{ item.meta }}</span>{% endif %}
                </span>
            </a>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="rh-hub-empty text-muted small mb-0">{{ empty_text|default('Nada por aqui.') }}</p>
    {% endif %}
</section>
