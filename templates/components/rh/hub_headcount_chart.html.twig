{# Gráfico de headcount — Chart.js via Stimulus (POC Symfony UX Chartjs) #}
{% if headcount_trend is defined and headcount_trend.values|default([])|length > 0 %}
<div class="rh-hub-chart-card huplex-card">
    <div class="rh-hub-chart-head">
        <div>
            <p class="rh-hub-chart-label">Tendência</p>
            <h3 class="rh-hub-chart-title">Headcount · 6 meses</h3>
        </div>
        <span class="rh-hub-chart-badge">{{ ativos|default(0) }} ativos hoje</span>
    </div>
    <div class="rh-hub-chart-canvas-wrap">
        <canvas data-controller="huplex-chart"
                data-huplex-chart-type-value="line"
                data-huplex-chart-label-value="Colaboradores ativos"
                data-huplex-chart-labels-value="{{ headcount_trend.labels|json_encode|e('html_attr') }}"
                data-huplex-chart-values-value="{{ headcount_trend.values|json_encode|e('html_attr') }}"></canvas>
    </div>
</div>
{% endif %}
