{# Formulário de nova admissão — props: empresa, checklist_preview, form values #}
{% set checklist = checklist_preview|default([]) %}

<div class="rh-admissao-page">
    <div class="rh-admissao-layout">
        <div class="rh-admissao-main unio-card">
            <div class="rh-admissao-offcanvas-progress rh-admissao-offcanvas-progress--page">
                {% include 'components/progress_inline.html.twig' with {
                    percent: 50,
                    variant: 'accent',
                    min_width: 120,
                    show_label: true
                } %}
                <span class="rh-admissao-offcanvas-progress-label">Etapa 1 de 2</span>
            </div>

            {% include 'components/rh/admissao_steps.html.twig' with { active_step: 1 } %}

            <header class="rh-admissao-main-head">
                <h2 class="rh-admissao-main-title">Dados para admissão</h2>
                <p class="rh-admissao-main-sub">
                    Cadastre quem está entrando na empresa. Em seguida você acompanha documentação, TI e integração em um único fluxo.
                </p>
            </header>

            <form method="post" class="unio-form rh-admissao-form">
                <input type="hidden" name="_token" value="{{ csrf_token('rh_admissao_form') }}">
                {% include 'components/rh/admissao_form_fields.html.twig' %}

                <div class="unio-form-actions rh-admissao-actions">
                    <a href="{{ path('app_rh_admissoes') }}" class="btn-unio-ghost">Cancelar</a>
                    <button type="submit" class="btn-unio">
                        <i class="fas fa-user-plus mr-2" aria-hidden="true"></i>
                        Iniciar onboarding
                    </button>
                </div>
            </form>
        </div>

        <aside class="rh-admissao-aside">
            {% if empresa is defined and empresa %}
            <div class="rh-admissao-aside-card unio-card">
                <p class="rh-admissao-aside-label">Área de trabalho</p>
                <p class="rh-admissao-aside-empresa">{{ empresa.nome }}</p>
                {% if empresa.setor %}
                <p class="rh-admissao-aside-meta">{{ empresa.setor }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% if checklist|length > 0 %}
            <div class="rh-admissao-aside-card unio-card">
                <p class="rh-admissao-aside-label">
                    <i class="fas fa-list-check" aria-hidden="true"></i>
                    Próxima etapa
                </p>
                <p class="rh-admissao-aside-hint">
                    Após iniciar, você marcará cada item até concluir e gerar o cadastro do funcionário.
                </p>
                <ul class="rh-admissao-checklist-preview">
                    {% for item in checklist %}
                    <li>
                        <i class="far fa-circle" aria-hidden="true"></i>
                        <span>{{ item.label }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div class="rh-admissao-aside-card rh-admissao-aside-card--tip unio-card">
                <p class="rh-admissao-aside-label">
                    <i class="fas fa-lightbulb" aria-hidden="true"></i>
                    Dica
                </p>
                <p class="rh-admissao-aside-hint mb-0">
                    Use o e-mail que será usado na plataforma. Você pode concluir o checklist aos poucos antes de finalizar a admissão.
                </p>
            </div>
        </aside>
    </div>
</div>
