{# Exibe asset de imagem — SVG usa <object> para carregar dependências externas #}
{% set _href = href|default('') %}
{% set _alt = alt|default('') %}
{% set _classes = class|default('') %}
{% set _is_svg = _href|lower ends with '.svg' %}

{% set _width = width|default(null) %}
{% set _height = height|default(null) %}
{% set _id = id|default(null) %}
{% set _crossorigin = crossorigin|default(null) %}
{% if _is_svg %}
<object type="image/svg+xml"
        data="{{ _href }}"
        class="platform-asset-svg {{ _classes }}"
        aria-label="{{ _alt }}"
        {% if _width is not null %}width="{{ _width }}"{% endif %}
        {% if _height is not null %}height="{{ _height }}"{% endif %}
        {% if _id is not null %}id="{{ _id }}"{% endif %}></object>
{% else %}
<img src="{{ _href }}"
     alt="{{ _alt }}"
     {% if _classes %}class="{{ _classes }}"{% endif %}
     {% if _width is not null %}width="{{ _width }}"{% endif %}
     {% if _height is not null %}height="{{ _height }}"{% endif %}
     {% if _id is not null %}id="{{ _id }}"{% endif %}
     {% if _crossorigin is not null %}crossorigin="{{ _crossorigin }}"{% endif %}>
{% endif %}
