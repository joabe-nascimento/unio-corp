{#
  ti_metric_badge — badge genérico sólido (SLA %, Cortex, logs, novidades)

  Props:
    label        (string)
    variant      (string)  info | success | warning | danger | secondary
    attrs        (object)
#}
{% set tone = variant|default('info') %}
{% include 'components/status_badge.html.twig' with {
    label: label,
    variant: tone,
    extra_class: 'ti-badge ti-badge-metric ti-badge-metric--' ~ tone,
    attrs: attrs|default({})
} %}
