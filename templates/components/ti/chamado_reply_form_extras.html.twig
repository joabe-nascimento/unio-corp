{# Campos extras vinculados ao formulário principal (modo flutuante) #}
{% set is_operator = ti_can('operate_chamados') %}
{% set is_requester = can_requester_reply|default(ti_can('reply_chamado', { ticket: ticket })) %}
{% set is_reopen_only = can_reopen|default(false) and not is_requester and not is_operator %}
{% set can_use_member_form = is_requester or is_reopen_only %}
{% set st_key = ticket.status|default('novo') %}
{% set technicians = technicians|default([]) %}
{% set assignee_id = ticket.assignee_id|default(null) %}
{% set form_dom_id = form_id|default('tiChamadoReplyForm-float-' ~ ticket.id) %}
{% set status_field_id = form_dom_id ~ '-status' %}
{% set tech_field_id = form_dom_id ~ '-technician' %}
{% set status_member_field_id = form_dom_id ~ '-status-member' %}
{% set member_status_options = solicitante_status_options|default({
    '': 'Manter status atual',
    'resolvido': 'Confirmar como resolvido'
}) %}

<div class="ti-chamado-helix-extras-panel">
    <p class="helix-sidebar-label mb-3">Opções de envio</p>
    {% if is_operator %}
    <div class="ti-chamado-reply-toolbar">
        <div class="ti-chamado-reply-toolbar-field">
            <label class="unio-form-label" for="{{ status_field_id }}">Status</label>
            <select id="{{ status_field_id }}" name="status" class="unio-form-control" form="{{ form_dom_id }}">
                {% for key, label in status_labels|default({}) %}
                <option value="{{ key }}"{% if key == st_key %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="ti-chamado-reply-toolbar-field">
            <label class="unio-form-label" for="{{ tech_field_id }}">Técnico</label>
            {% if technicians is empty %}
            <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control" form="{{ form_dom_id }}" disabled>
                <option value="">Nenhum usuário ativo</option>
            </select>
            {% else %}
            <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control" form="{{ form_dom_id }}">
                <option value=""{% if not assignee_id %} selected{% endif %}>— Sem alteração —</option>
                {% for tech in technicians %}
                <option value="{{ tech.id }}"{% if assignee_id == tech.id %} selected{% endif %}>{{ tech.name }}</option>
                {% endfor %}
            </select>
            {% endif %}
        </div>
    </div>
    {% elseif can_use_member_form %}
    <div class="ti-chamado-reply-toolbar ti-chamado-reply-toolbar--member">
        <div class="ti-chamado-reply-toolbar-field">
            <label class="unio-form-label" for="{{ status_member_field_id }}">Situação</label>
            <select id="{{ status_member_field_id }}" name="status" class="unio-form-control" form="{{ form_dom_id }}">
                {% for key, label in member_status_options %}
                <option value="{{ key }}"{% if is_reopen_only and key == 'em_analise' %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    {% endif %}
    <p class="helix-msg-muted mb-0 mt-3">Use o campo de mensagem abaixo para enviar. Anexos ficam na aba <strong>Anexos</strong>.</p>
</div>
