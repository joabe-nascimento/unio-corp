{# Resposta pública do solicitante — visível na timeline para TI e solicitante #}
<form method="post"
      action="{{ path('app_ti_chamado_comentario', { id: ticket.id }) }}"
      class="ti-chamado-quick-form unio-form">
    <input type="hidden" name="_token" value="{{ csrf_token('ti_chamado_comentario_' ~ ticket.id) }}">
    <label class="unio-form-label" for="tiChamadoReply">Sua resposta</label>
    <textarea id="tiChamadoReply"
              name="message"
              class="unio-form-control mb-2"
              rows="3"
              maxlength="2000"
              placeholder="Informe detalhes, testes feitos ou dúvidas para a equipe de TI…"
              required></textarea>
    <button type="submit" class="btn-unio btn-sm">
        <i class="fas fa-paper-plane mr-1" aria-hidden="true"></i> Enviar resposta
    </button>
</form>
