{#
  ti_insight_badge — badges Sasha/Cortex (match, sentimento, modo)

  Props:
    kind         (string)  match | sentiment | mode
    label        (string)  obrigatório para match/sentiment
    tone         (string)  success | warning | danger | info (sentiment)
    mode         (string)  auto | review (kind=mode)
    attrs        (object)
#}
{% set kind = kind|default('match') %}
{% if kind == 'match' %}
    {% set extra = 'ti-badge-match' %}
    {% set variant = 'info' %}
{% elseif kind == 'sentiment' %}
    {% set tone = tone|default('success') %}
    {% set extra = 'ti-badge-sentiment ti-badge-sentiment--' ~ tone %}
    {% set variant = tone %}
{% elseif kind == 'mode' %}
    {% set is_auto = mode|default('review') == 'auto' %}
    {% set extra = is_auto ? 'ti-badge-auto' : 'ti-badge-review' %}
    {% set variant = is_auto ? 'success' : 'secondary' %}
    {% set label = label|default(is_auto ? 'Auto-aplicado' : 'Revisão manual') %}
{% endif %}
{% include 'components/status_badge.html.twig' with {
    label: label|default(''),
    variant: variant|default('info'),
    extra_class: extra,
    attrs: attrs|default({})
} %}
