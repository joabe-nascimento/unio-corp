{# Resposta unificada — mensagem + opções extras #}
{% set is_operator = ti_can('operate_chamados') %}
{% set is_requester = can_requester_reply|default(ti_can('reply_chamado', { ticket: ticket })) %}
{% set is_reopen_only = can_reopen|default(false) and not is_requester and not is_operator %}
{% set can_use_member_form = is_requester or is_reopen_only %}
{% set st_key = ticket.status|default('novo') %}
{% set technicians = technicians|default([]) %}
{% set assignee_id = ticket.assignee_id|default(null) %}
{% set upload_id = upload_id|default(is_operator ? 'tiChamadoOperatorReplyAttachments' : 'tiChamadoReplyAttachments') %}
{% set member_status_options = solicitante_status_options|default({
    '': 'Manter status atual',
    'resolvido': 'Confirmar como resolvido'
}) %}
{% set has_extras = is_operator or can_use_member_form %}
{% set tabbed = tabbed|default(false) %}
{% set helix_composer = helix_composer|default(false) %}
{% set helix_composer_only = helix_composer_only|default(false) %}
{% set form_dom_id = form_id|default('tiChamadoReplyForm-' ~ ticket.id) %}
{% set message_field_id = form_dom_id ~ '-message' %}
{% set status_field_id = form_dom_id ~ '-status' %}
{% set tech_field_id = form_dom_id ~ '-technician' %}
{% set status_member_field_id = form_dom_id ~ '-status-member' %}
{% set message_label = is_operator ? 'Responder ao solicitante' : (is_reopen_only ? 'Motivo da reabertura' : 'Sua resposta') %}
{% set message_placeholder = is_operator ? 'Escreva a resposta para o solicitante…' : (is_reopen_only ? 'Explique por que o problema persiste ou voltou…' : 'Informe detalhes, testes feitos ou dúvidas para a equipe de TI…') %}

<form method="post"
      id="{{ form_dom_id }}"
      action="{{ path(is_operator ? 'app_ti_chamado_nota' : 'app_ti_chamado_comentario', { id: ticket.id }) }}"
      enctype="multipart/form-data"
      class="{% if helix_composer %}helix-composer ti-chamado-helix-composer{% else %}ti-chamado-reply-form unio-form{% endif %}{% if tabbed and not helix_composer %} ti-chamado-reply-form--tabbed{% endif %}"
      data-ti-chamado-reply>
    <input type="hidden" name="_token" value="{{ csrf_token(is_operator ? 'ti_chamado_nota_' ~ ticket.id : 'ti_chamado_comentario_' ~ ticket.id) }}">

    {% if helix_composer and has_extras and not helix_composer_only %}
    <div class="ti-chamado-helix-extras">
        {% if is_operator %}
        <div class="ti-chamado-reply-toolbar">
            <div class="ti-chamado-reply-toolbar-field">
                <label class="unio-form-label" for="{{ status_field_id }}">Status</label>
                <select id="{{ status_field_id }}" name="status" class="unio-form-control">
                    {% for key, label in status_labels|default({}) %}
                    <option value="{{ key }}"{% if key == st_key %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="ti-chamado-reply-toolbar-field">
                <label class="unio-form-label" for="{{ tech_field_id }}">Técnico</label>
                {% if technicians is empty %}
                <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control" disabled>
                    <option value="">Nenhum usuário ativo</option>
                </select>
                {% else %}
                <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control">
                    <option value=""{% if not assignee_id %} selected{% endif %}>— Sem alteração —</option>
                    {% for tech in technicians %}
                    <option value="{{ tech.id }}"{% if assignee_id == tech.id %} selected{% endif %}>{{ tech.name }}</option>
                    {% endfor %}
                </select>
                {% endif %}
            </div>
        </div>
        {% elseif can_use_member_form %}
        <div class="ti-chamado-reply-toolbar ti-chamado-reply-toolbar--member">
            <div class="ti-chamado-reply-toolbar-field">
                <label class="unio-form-label" for="{{ status_member_field_id }}">Situação</label>
                <select id="{{ status_member_field_id }}" name="status" class="unio-form-control">
                    {% for key, label in member_status_options %}
                    <option value="{{ key }}"{% if is_reopen_only and key == 'em_analise' %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if helix_composer %}
    <div class="helix-composer-inner">
        <textarea id="{{ message_field_id }}"
                  name="message"
                  class="helix-input"
                  rows="1"
                  maxlength="2000"
                  placeholder="{{ message_placeholder }}"
                  aria-label="{{ message_label }}"></textarea>
        <button type="submit" class="helix-send-btn" aria-label="{{ is_reopen_only ? 'Reabrir chamado' : 'Enviar resposta' }}">
            <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
    </div>
    {% else %}
    <label class="unio-form-label" for="{{ message_field_id }}">{{ message_label }}</label>
    <textarea id="{{ message_field_id }}"
              name="message"
              class="unio-form-control ti-chamado-reply-textarea"
              rows="3"
              maxlength="2000"
              placeholder="{{ message_placeholder }}"></textarea>
    {% endif %}

    {% if has_extras and not helix_composer %}
    {% if tabbed %}
    <div class="ti-chamado-reply-extras">
        {% if is_operator %}
        <div class="ti-chamado-reply-toolbar">
            <div class="ti-chamado-reply-toolbar-field">
                <label class="unio-form-label" for="{{ status_field_id }}">Status</label>
                <select id="{{ status_field_id }}" name="status" class="unio-form-control">
                    {% for key, label in status_labels|default({}) %}
                    <option value="{{ key }}"{% if key == st_key %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="ti-chamado-reply-toolbar-field">
                <label class="unio-form-label" for="{{ tech_field_id }}">Técnico</label>
                {% if technicians is empty %}
                <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control" disabled>
                    <option value="">Nenhum usuário ativo</option>
                </select>
                {% else %}
                <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control">
                    <option value=""{% if not assignee_id %} selected{% endif %}>— Sem alteração —</option>
                    {% for tech in technicians %}
                    <option value="{{ tech.id }}"{% if assignee_id == tech.id %} selected{% endif %}>{{ tech.name }}</option>
                    {% endfor %}
                </select>
                {% endif %}
            </div>
        </div>
        {% elseif can_use_member_form %}
        <div class="ti-chamado-reply-toolbar ti-chamado-reply-toolbar--member">
            <div class="ti-chamado-reply-toolbar-field">
                <label class="unio-form-label" for="{{ status_member_field_id }}">Situação</label>
                <select id="{{ status_member_field_id }}" name="status" class="unio-form-control">
                    {% for key, label in member_status_options %}
                    <option value="{{ key }}"{% if is_reopen_only and key == 'em_analise' %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% endif %}
    </div>
    {% else %}
    {% embed 'components/unio/disclosure.html.twig' with {
        label: 'Ver mais opções',
        icon: 'fa-sliders-h',
        variant: 'ti',
        modifier: 'reply',
        open: is_reopen_only
    } %}
        {% block disclosure_body %}
            {% if is_operator %}
            <div class="ti-chamado-reply-toolbar">
                <div class="ti-chamado-reply-toolbar-field">
                    <label class="unio-form-label" for="{{ status_field_id }}">Status</label>
                    <select id="{{ status_field_id }}" name="status" class="unio-form-control">
                        {% for key, label in status_labels|default({}) %}
                        <option value="{{ key }}"{% if key == st_key %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="ti-chamado-reply-toolbar-field">
                    <label class="unio-form-label" for="{{ tech_field_id }}">Técnico</label>
                    {% if technicians is empty %}
                    <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control" disabled>
                        <option value="">Nenhum usuário ativo</option>
                    </select>
                    {% else %}
                    <select id="{{ tech_field_id }}" name="technician_id" class="unio-form-control">
                        <option value=""{% if not assignee_id %} selected{% endif %}>— Sem alteração —</option>
                        {% for tech in technicians %}
                        <option value="{{ tech.id }}"{% if assignee_id == tech.id %} selected{% endif %}>{{ tech.name }}</option>
                        {% endfor %}
                    </select>
                    {% endif %}
                </div>
            </div>
            {% elseif can_use_member_form %}
            <div class="ti-chamado-reply-toolbar ti-chamado-reply-toolbar--member">
                <div class="ti-chamado-reply-toolbar-field">
                    <label class="unio-form-label" for="{{ status_member_field_id }}">Situação</label>
                    <select id="{{ status_member_field_id }}" name="status" class="unio-form-control">
                        {% for key, label in member_status_options %}
                        <option value="{{ key }}"{% if is_reopen_only and key == 'em_analise' %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            {% endif %}

            <div class="ti-chamado-reply-attachments">
                {% include 'components/ti/chamado_attachments_upload.html.twig' with {
                    upload_id: upload_id,
                    compact: true
                } %}
            </div>
        {% endblock %}
    {% endembed %}
    {% endif %}
    {% endif %}

    {% if not helix_composer %}
    <div class="ti-chamado-reply-actions">
        <button type="submit" class="btn-unio btn-sm">
            <i class="fas fa-paper-plane mr-1" aria-hidden="true"></i>
            {{ is_reopen_only ? 'Reabrir chamado' : 'Enviar resposta' }}
        </button>
    </div>
    {% endif %}
</form>
