{# War Room — cabeçalho imersivo (tela dedicada, fora do hub) #}
<header class="wr-header wr-page-header">
    <div class="wr-header-left">
        <a href="{{ path('app_ti') }}" class="wr-exit">
            <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Núcleo TI
        </a>
        <div class="wr-logo">
            <div>
                <h1>War Room</h1>
                <div class="wr-logo-sub">Incident Command Center · P1</div>
            </div>
        </div>
    </div>
    <div class="wr-header-right ti-war-room-toolbar">
        <div class="wr-severity-gauge" title="Índice de severidade operacional">
            <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true">
                <circle cx="26" cy="26" r="22" fill="none" stroke="#1a2840" stroke-width="4"/>
                <circle id="wrSeverityCircle" cx="26" cy="26" r="22" fill="none"
                    stroke="{{ severity_level == 'critical' ? '#ff3b3b' : (severity_level == 'elevated' ? '#f59e0b' : '#10b981') }}"
                    stroke-width="4" stroke-linecap="round"/>
            </svg>
            <div class="wr-severity-gauge-val" id="wrSeverityVal">{{ severity_score }}</div>
        </div>
        <span class="wr-live-dot" title="Monitoramento ao vivo"></span>
        {% include 'components/status_badge.html.twig' with {
            label: p1_count > 0 ? (p1_count ~ ' P1 ATIVO' ~ (p1_count != 1 ? 'S' : '')) : 'SISTEMA ESTÁVEL',
            variant: p1_count > 0 ? 'danger' : 'success',
            extra_class: 'ti-badge-priority ti-badge-priority--p1',
            attrs: { id: 'wrP1Badge' }
        } %}
        <span class="wr-clock" id="wrClock">--:--:--</span>
        {% include 'components/status_badge.html.twig' with { label: 'Live · 15s', variant: 'info' } %}
        <a href="{{ path('app_ti_chamados') }}" class="btn-unio-ghost btn-sm wr-header-link">
            <i class="fas fa-list mr-1" aria-hidden="true"></i> Fila de chamados
        </a>
    </div>
</header>

<section class="wr-kpi-strip" aria-label="Indicadores operacionais">
    <div class="wr-kpi-card">
        <span class="wr-kpi-icon" aria-hidden="true"><i class="fas fa-inbox"></i></span>
        <span class="wr-kpi-body">
            <strong>{{ metrics.open_total }}</strong>
            <span>Abertos</span>
        </span>
    </div>
    <div class="wr-kpi-card">
        <span class="wr-kpi-icon" aria-hidden="true"><i class="fas fa-exclamation-triangle"></i></span>
        <span class="wr-kpi-body">
            <strong>{{ metrics.p2_active }}</strong>
            <span>P2</span>
        </span>
    </div>
    <div class="wr-kpi-card">
        <span class="wr-kpi-icon" aria-hidden="true"><i class="fas fa-server"></i></span>
        <span class="wr-kpi-body">
            <strong>{{ metrics.systems_up }}/{{ metrics.systems_total }}</strong>
            <span>Sistemas OK</span>
        </span>
    </div>
    <div class="wr-kpi-card">
        <span class="wr-kpi-icon" aria-hidden="true"><i class="fas fa-gauge-high"></i></span>
        <span class="wr-kpi-body">
            <strong>{{ metrics.sla_compliance }}%</strong>
            <span>SLA 7d</span>
        </span>
    </div>
</section>
