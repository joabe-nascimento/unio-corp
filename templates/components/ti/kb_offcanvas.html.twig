{# Offcanvas CRUD — Base de Conhecimento #}
<div class="unio-offcanvas" id="ti-kb-form" data-unio-offcanvas="ti-kb-form">
    <div class="unio-offcanvas-backdrop" data-unio-offcanvas-close></div>
    <div class="unio-offcanvas-panel">
        <div class="unio-offcanvas-head">
            <h2 class="unio-offcanvas-title section-title mb-0">Artigo KB</h2>
            <button type="button" class="btn-unio-ghost btn-sm" data-unio-offcanvas-close aria-label="Fechar"><i class="fas fa-times"></i></button>
        </div>
        <form method="post" action="{{ path('app_ti_kb_novo_submit') }}" class="unio-offcanvas-body" id="tiKbForm" data-ti-infra-form="kb" data-ti-edit-url="{{ path('app_ti_kb_editar_submit', { id: 0 }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('ti_kb_form') }}">
            <div class="mb-3">
                <label class="perm-label">Título</label>
                <input type="text" name="titulo" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="perm-label">Resumo</label>
                <textarea name="resumo" class="form-control" rows="3" required></textarea>
            </div>
            <div class="mb-3">
                <label class="perm-label">Conteúdo</label>
                <textarea name="conteudo" class="form-control" rows="6"></textarea>
            </div>
            <div class="mb-3">
                <label class="perm-label">Categoria</label>
                <input type="text" name="categoria" class="form-control" value="geral">
            </div>
            <div class="mb-3">
                <label class="perm-label">Tags (vírgula)</label>
                <input type="text" name="tags" class="form-control" placeholder="vpn, senha, rede">
            </div>
            <button type="submit" class="btn-unio" data-ti-infra-submit-label="kb">Salvar artigo</button>
        </form>
    </div>
</div>
