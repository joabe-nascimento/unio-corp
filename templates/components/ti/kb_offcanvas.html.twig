{# Offcanvas CRUD — Base de Conhecimento #}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'ti-kb-form',
    title: 'Novo artigo KB',
    subtitle: 'Base de conhecimento · triagem Sasha',
    icon: 'fa-book',
    size: 'lg',
    open: app.request.query.getBoolean('open_novo') or (app.request.query.get('resource') == 'kb' and app.request.query.get('open_edit'))
} %}
    {% block offcanvas_drawer_attrs %}data-ti-infra-form="kb"{% endblock %}
    {% block offcanvas_body %}
    <form method="post"
          action="{{ path('app_ti_kb_novo_submit') }}"
          class="unio-form"
          id="tiKbForm"
          data-ti-infra-form-el="kb"
          data-ti-edit-url="{{ path('app_ti_kb_editar_submit', { id: 0 }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('ti_kb_form') }}">
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_kb_titulo', name: 'titulo', label: 'Título',
            placeholder: 'Ex.: VPN pós-patch Windows', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_kb_resumo', name: 'resumo', label: 'Resumo', type: 'textarea',
            rows: 3, placeholder: 'Descrição curta para listagens…', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_kb_conteudo', name: 'conteudo', label: 'Conteúdo', type: 'textarea',
            rows: 8, placeholder: 'Runbook completo (opcional)'
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_kb_categoria', name: 'categoria', label: 'Categoria',
            value: 'geral', placeholder: 'geral, rede, acesso…'
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_kb_tags', name: 'tags', label: 'Tags (vírgula)',
            placeholder: 'vpn, senha, rede'
        } %}
    </form>
    {% endblock %}
    {% block offcanvas_footer %}
    <div class="unio-offcanvas-footer">
        <button type="submit" form="tiKbForm" class="btn-unio" data-ti-infra-submit="kb">
            <i class="fas fa-check mr-1"></i> <span data-ti-infra-submit-label="kb">Salvar artigo</span>
        </button>
        <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
    </div>
    {% endblock %}
{% endembed %}
