{# Ações da ficha — barra no topo da área principal (fora da sidebar) #}
<div class="ti-ticket-detail-actions">
    {% if ti_can('operate_chamados') and ti_can('manage_chamados') %}
    {% include 'components/ti/chamado_escalar_form.html.twig' with { ticket: ticket, inline: true } %}
    {% endif %}
    <a href="{{ path(ti_portal_view|default(false) ? 'app_ti_meus_chamados' : 'app_ti_chamados') }}"
       class="btn-unio-ghost btn-sm">
        <i class="fas fa-list mr-1" aria-hidden="true"></i> Voltar à lista
    </a>
</div>
