{# Live ops ticker #}
<div class="ti-live-ops" data-ti-live-ops>
    {% for item in live_ops|default([]) %}
    <div class="ti-live-ops-item ti-live-ops-item--{{ item.tone|default('neutral') }}">
        <i class="fas {{ item.icon }}" aria-hidden="true"></i>
        <span>{{ item.text }}</span>
    </div>
    {% endfor %}
</div>
