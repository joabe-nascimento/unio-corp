{# Widget global — chat minimizado em toda a plataforma #}
<button type="button"
        class="ti-chamado-chat-launcher"
        id="tiChamadoChatLauncher"
        data-ti-chat-launcher-global
        hidden
        aria-label="Conversa com a TI">
    <i class="fas fa-comments" aria-hidden="true"></i>
    <span class="ti-chamado-chat-launcher-label" data-ti-chat-launcher-label>Conversa TI</span>
    <code class="ti-chamado-chat-launcher-id" data-ti-chat-launcher-id hidden></code>
    <span class="ti-chamado-chat-launcher-badge" data-ti-chat-launcher-badge hidden>0</span>
</button>
