{# War Room — painéis operacionais (layout hub + componentes globais) #}

<section class="unio-card mb-3 wr-brief wr-brief-bar">
    <div class="wr-brief-icon"><i class="fas fa-brain" aria-hidden="true"></i></div>
    <div class="wr-brief-content flex-fill">
        {% include 'components/section_header.html.twig' with {
            title: command_brief.headline,
            subtitle: command_brief.summary
        } %}
        <div class="wr-brief-actions d-flex flex-wrap gap-2 mt-2">
            {% for action in command_brief.actions %}
            <span class="wr-brief-action"><i class="fas fa-chevron-right fa-xs" aria-hidden="true"></i> {{ action }}</span>
            {% endfor %}
            {% include 'components/ti/ti_helia_badge.html.twig' with {
                confidence: command_brief.confidence|round,
                style: 'helia'
            } %}
        </div>
    </div>
</section>

<div class="wr-body">
    <div class="wr-col wr-col-main">
        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with {
                title: 'Teatro de Incidentes P1',
                subtitle: p1_count ~ ' ativos'
            } %}

            {% if p1_incidents|length > 0 %}
            {% for inc in p1_incidents %}
            {% set sla = inc.sla_pct|default(100) %}
            {% set sla_color = sla < 25 ? '#ff3b3b' : (sla < 50 ? '#f59e0b' : '#10b981') %}
            <article class="wr-incident{% if inc.sla_breach_imminent %} is-imminent{% endif %}{% if not loop.last %} mb-3{% endif %}">
                <div class="wr-incident-top">
                    <div>
                        <div class="wr-incident-code">{{ inc.id }}</div>
                        <div class="wr-incident-title">{{ inc.title }}</div>
                    </div>
                    <div class="wr-death-clock" data-wr-death-clock="{{ inc.sla_remaining_sec }}">
                        {{ inc.sla_remaining_label }}
                        <small>SLA RESTANTE</small>
                    </div>
                </div>
                <div class="wr-incident-meta">
                    <span><i class="fas fa-user" aria-hidden="true"></i> {{ inc.assignee|default('Sem responsável') }}</span>
                    <span><i class="fas fa-tag" aria-hidden="true"></i> {{ inc.category|default('—') }}</span>
                    <span><i class="fas fa-clock" aria-hidden="true"></i> {{ inc.elapsed_label }}</span>
                    <span><i class="fas fa-users" aria-hidden="true"></i> ~{{ inc.affected_users }} usuários</span>
                    {% if inc.helia_analysis %}
                    <span><i class="fas fa-brain" aria-hidden="true"></i> {{ ai_assistant_name }}</span>
                    {% endif %}
                </div>
                <div class="wr-sla-bar mt-2">
                    <div class="wr-sla-fill" style="width:{{ sla }}%;background:{{ sla_color }};"></div>
                </div>
                {% if inc.helia_analysis %}
                <p class="section-subtitle mt-2 mb-2">
                    <i class="fas fa-brain" aria-hidden="true"></i>
                    {{ inc.helia_analysis|slice(0, 140) }}{% if inc.helia_analysis|length > 140 %}…{% endif %}
                </p>
                {% endif %}
                {% if inc.playbook_steps|length > 0 %}
                <div class="wr-runbook">
                    <div class="wr-runbook-title">
                        <i class="fas fa-book-open" aria-hidden="true"></i>
                        Runbook: {{ inc.playbook.titulo|default('P1') }}
                    </div>
                    <div class="wr-runbook-steps" data-ti-playbook data-url="{{ path('app_ti_chamado_playbook_step', { id: inc.id }) }}" data-csrf="{{ csrf_token('ti_playbook_' ~ inc.id) }}">
                        {% for step in inc.playbook_steps|slice(0, 6) %}
                        {% set step_num = step.step|default(loop.index) %}
                        <div class="wr-runbook-step{% if step.feito|default(false) %} is-done{% endif %}">
                            <label class="wr-runbook-step-label mb-0">
                                <span class="ti-playbook-step-num" aria-hidden="true">{{ step_num }}</span>
                                <input type="checkbox"
                                       class="ti-playbook-step-check"
                                       data-ti-playbook-step="{{ step_num }}"
                                       {% if step.feito|default(false) %}checked{% endif %}
                                       aria-label="Marcar passo {{ step_num }}">
                                <span>{{ step.titulo }}</span>
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                <div class="wr-incident-actions d-flex flex-wrap gap-2 mt-2">
                    <a href="{{ path('app_ti_chamado_show', { id: inc.id }) }}" class="btn-unio btn-sm" target="_blank" rel="noopener">
                        <i class="fas fa-external-link-alt mr-1" aria-hidden="true"></i> Comandar chamado
                    </a>
                    {% if inc.integ_conector_id %}
                    <a href="{{ path('app_integracoes_observatorio') }}" class="btn-unio-ghost btn-sm" target="_blank" rel="noopener">
                        <i class="fas fa-diagram-project mr-1" aria-hidden="true"></i> Malha causal
                    </a>
                    {% endif %}
                </div>
            </article>
            {% endfor %}
            {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-shield-check',
                title: 'Nenhum incidente P1 ativo.',
                text: 'War Room em modo observação — monitorando NOC e fila P2.',
                compact: true
            } %}
            {% endif %}
        </section>

        {% if maintenance_alerts|length > 0 %}
        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with {
                title: 'Manutenções programadas',
                subtitle: maintenance_alerts|length ~ ' janelas'
            } %}
            {% for m in maintenance_alerts %}
            <div class="wr-maint-alert{% if not loop.last %} mb-2{% endif %}">
                <strong>{{ m.titulo }}</strong><br>
                <span class="section-subtitle">{{ m.janela }} · {{ m.impacto }}</span>
                {% if not m.aprovada %}
                {% include 'components/status_badge.html.twig' with { label: 'Aguardando CAB', variant: 'warning', extra_class: 'ms-2' } %}
                {% endif %}
            </div>
            {% endfor %}
        </section>
        {% endif %}
    </div>

    <div class="wr-col">
        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with {
                title: 'Blast Radius',
                subtitle: blast_radius|length ~ ' nós'
            } %}
            <div class="wr-radar-wrap">
                <div class="wr-radar">
                    <div class="wr-radar-sweep" aria-hidden="true"></div>
                    {% for node in blast_radius %}
                    <div class="wr-radar-blip wr-radar-blip--{{ node.severity }}"
                         style="left:{{ [15, 85, 50, 30, 70, 45, 60, 25][loop.index0 % 8] }}%;top:{{ [20, 75, 50, 65, 30, 80, 40, 55][loop.index0 % 8] }}%;"
                         title="{{ node.name }} · ~{{ node.users }} usuários"></div>
                    {% endfor %}
                </div>
            </div>
            <ul class="wr-blast-list">
                {% for node in blast_radius %}
                <li>
                    <span>
                        {% include 'components/ti/ti_metric_badge.html.twig' with {
                            label: node.severity|upper,
                            variant: node.severity == 'critical' ? 'danger' : (node.severity == 'ok' ? 'success' : 'warning')
                        } %}
                        {{ node.name }}
                    </span>
                    <span class="section-subtitle">~{{ node.users }} usr</span>
                </li>
                {% endfor %}
            </ul>
        </section>

        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Timeline unificada' } %}
            <div class="wr-timeline">
                {% for ev in unified_timeline|slice(0, 10) %}
                <div class="wr-timeline-item wr-timeline-item--{{ ev.tone|default('neutral') }}">
                    <div class="wr-timeline-time">{{ ev.at }}</div>
                    <div class="wr-timeline-event">{{ ev.event }}</div>
                    <div class="wr-timeline-actor">{{ ev.actor }}</div>
                </div>
                {% else %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'fa-timeline',
                    title: 'Sem eventos recentes.',
                    compact: true
                } %}
                {% endfor %}
            </div>
        </section>

        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Comms Bridge' } %}
            <div class="wr-comms-tabs">
                <button type="button" class="wr-comms-tab is-active btn-unio-ghost btn-xs" data-comms-text="{{ status_comms.internal|e('html_attr') }}">Interno</button>
                <button type="button" class="wr-comms-tab btn-unio-ghost btn-xs" data-comms-text="{{ status_comms.external|e('html_attr') }}">Status Page</button>
                <button type="button" class="wr-comms-tab btn-unio-ghost btn-xs" data-comms-text="{{ status_comms.executive|e('html_attr') }}">Executivo</button>
            </div>
            <div class="wr-comms-box" id="wrCommsBox">{{ status_comms.internal }}</div>
            <button type="button" class="btn-unio-ghost btn-sm mt-2" id="wrCommsCopy">
                <i class="fas fa-copy mr-1" aria-hidden="true"></i> Copiar mensagem
            </button>
        </section>
    </div>

    <div class="wr-col">
        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'Cadeia de integrações' } %}
            <div class="wr-chain">
                {% for node in integration_chain|slice(0, 6) %}
                <div class="wr-chain-node wr-chain-node--{{ node.status == 'incident' ? 'incident' : (node.status == 'degraded' ? 'degraded' : '') }}">
                    <i class="fas {{ node.icon }}" aria-hidden="true"></i>
                    {{ node.name|slice(0, 12) }}{% if node.name|length > 12 %}…{% endif %}
                    <div class="wr-chain-latency">{{ node.latency }}</div>
                </div>
                {% endfor %}
            </div>
        </section>

        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with {
                title: 'NOC Status',
                subtitle: noc_systems|filter(s => s.status == 'operational')|length ~ '/' ~ noc_systems|length
            } %}
            {% for sys in noc_systems %}
            <div class="wr-noc-row">
                <div class="wr-noc-dot wr-noc-dot--{{ sys.status|default('operational') }}"></div>
                <i class="fas {{ sys.icon|default('fa-server') }}" aria-hidden="true"></i>
                <span class="wr-noc-name">{{ sys.name }}</span>
                <span class="wr-noc-meta">{{ sys.uptime|default('—') }} · {{ sys.latency|default('—') }}</span>
            </div>
            {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-tower-broadcast',
                title: 'Sem sistemas monitorados.',
                compact: true
            } %}
            {% endfor %}
        </section>

        <section class="unio-card mb-3">
            {% include 'components/section_header.html.twig' with { title: 'War Board · Equipe' } %}
            {% for tech in team_board %}
            <div class="wr-team-row{% if tech.on_p1 %} is-on-p1{% endif %}">
                <div class="wr-team-avatar">{{ tech.name|slice(0, 2)|upper }}</div>
                <div class="wr-team-info">
                    <div>{{ tech.name }}</div>
                    <div class="section-subtitle">
                        {{ tech.open_tickets }} abertos
                        {% if tech.p1_assigned > 0 %} · <strong>{{ tech.p1_assigned }} P1</strong>{% endif %}
                    </div>
                </div>
                <div class="wr-team-load">
                    <div class="wr-team-load-fill" style="width:{{ tech.load_pct }}%;{% if tech.load_pct > 70 %}background:var(--wr-accent);{% endif %}"></div>
                </div>
            </div>
            {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'fa-users-gear',
                title: 'Nenhum técnico cadastrado.',
                compact: true
            } %}
            {% endfor %}
        </section>

        <section class="unio-card">
            {% include 'components/section_header.html.twig' with { title: 'Live Ops' } %}
            {% for item in live_ops|slice(0, 5) %}
            <div class="wr-live-ops-row">
                <i class="fas {{ item.icon|default('fa-circle') }} wr-live-ops-icon wr-live-ops-icon--{{ item.tone|default('neutral') }}" aria-hidden="true"></i>
                <span>{{ item.text }}</span>
            </div>
            {% endfor %}
        </section>
    </div>
</div>
