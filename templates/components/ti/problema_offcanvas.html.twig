{# Offcanvas CRUD — Problemas #}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'ti-problema-form',
    title: 'Novo problema',
    subtitle: 'Gestão de causa raiz',
    icon: 'fa-diagram-project',
    size: 'lg',
    open: app.request.query.getBoolean('open_novo') or (app.request.query.get('resource') == 'problema' and app.request.query.get('open_edit'))
} %}
    {% block offcanvas_drawer_attrs %}data-ti-infra-form="problema"{% endblock %}
    {% block offcanvas_body %}
    <form method="post"
          action="{{ path('app_ti_problema_novo_submit') }}"
          class="unio-form"
          id="tiProblemaForm"
          data-ti-infra-form-el="problema"
          data-ti-edit-url="{{ path('app_ti_problema_editar_submit', { id: 0 }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('ti_problema_form') }}">
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_problema_titulo', name: 'titulo', label: 'Título',
            placeholder: 'Ex.: Instabilidade VPN recorrente', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_problema_resumo', name: 'resumo', label: 'Resumo', type: 'textarea',
            rows: 3, placeholder: 'Impacto e contexto…', required: true
        } %}
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_problema_causa_raiz', name: 'causa_raiz', label: 'Causa raiz', type: 'textarea',
            rows: 3, placeholder: 'Hipótese ou causa confirmada (opcional)'
        } %}
        <div class="row">
            <div class="col-6">
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'ti_problema_prioridade', name: 'prioridade', label: 'Prioridade', type: 'select', required: true,
                    value: 'P3',
                    options: [
                        { value: 'P1', label: 'P1' },
                        { value: 'P2', label: 'P2' },
                        { value: 'P3', label: 'P3' },
                        { value: 'P4', label: 'P4' },
                    ]
                } %}
            </div>
            <div class="col-6">
                {% include 'components/unio_form_field.html.twig' with {
                    id: 'ti_problema_status', name: 'status', label: 'Status', type: 'select', required: true,
                    value: 'aberto',
                    options: [
                        { value: 'aberto', label: 'Aberto' },
                        { value: 'investigacao', label: 'Investigação' },
                        { value: 'resolvido', label: 'Resolvido' },
                    ]
                } %}
            </div>
        </div>
        {% include 'components/unio_form_field.html.twig' with {
            id: 'ti_problema_categoria', name: 'categoria', label: 'Categoria',
            value: 'sistema', placeholder: 'sistema, rede, acesso…'
        } %}
    </form>
    {% endblock %}
    {% block offcanvas_footer %}
    <div class="unio-offcanvas-footer">
        <button type="submit" form="tiProblemaForm" class="btn-unio" data-ti-infra-submit="problema">
            <i class="fas fa-check mr-1"></i> <span data-ti-infra-submit-label="problema">Registrar problema</span>
        </button>
        <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
    </div>
    {% endblock %}
{% endembed %}
