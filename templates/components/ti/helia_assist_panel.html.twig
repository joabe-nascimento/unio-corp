{# Vitória assist — painel IA no formulário de chamado #}
<div class="ti-helia-assist" data-ti-helia-assist hidden>
    <div class="ti-helia-assist-head">
        <span class="ti-helia-assist-avatar" aria-hidden="true"><i class="fas fa-brain"></i></span>
        <div>
            <div class="section-title mb-0">{{ ai_assistant_name }} · Triagem Cortex</div>
            <p class="section-subtitle mb-0" data-ti-helia-status>Analisando descrição…</p>
        </div>
        <span class="ti-helia-confidence" data-ti-helia-confidence hidden></span>
    </div>
    <p class="ti-helia-assist-text mb-2" data-ti-helia-summary></p>
    <div class="ti-helia-suggestions mb-2" data-ti-helia-suggestions hidden>
        <span class="perm-label d-block mb-2">Sugestões automáticas</span>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn-unio-ghost btn-sm" data-ti-helia-apply="category" hidden>
                <i class="fas fa-tag mr-1"></i> Categoria: <span data-ti-helia-val-category></span>
            </button>
            <button type="button" class="btn-unio-ghost btn-sm" data-ti-helia-apply="priority" hidden>
                <i class="fas fa-flag mr-1"></i> Prioridade: <span data-ti-helia-val-priority></span>
            </button>
            <button type="button" class="btn-unio-ghost btn-sm" data-ti-helia-apply="impact" hidden>
                <i class="fas fa-bolt mr-1"></i> Impacto: <span data-ti-helia-val-impact></span>
            </button>
        </div>
    </div>
    <div data-ti-helia-kb hidden>
        <span class="perm-label d-block mb-2">Base de conhecimento</span>
        <ul class="ti-helia-kb-list mb-0" data-ti-helia-kb-list></ul>
    </div>
</div>
<div class="ti-helia-assist-trigger mt-2">
    <button type="button" class="btn-unio-ghost btn-sm" data-ti-helia-analyze>
        <i class="fas fa-wand-magic-sparkles mr-1" aria-hidden="true"></i> Analisar com {{ ai_assistant_name }}
    </button>
    <span class="text-muted small ml-2">IA sugere categoria, prioridade e artigos KB</span>
</div>
