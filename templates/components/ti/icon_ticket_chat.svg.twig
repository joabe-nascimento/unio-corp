{# Ícones SVG — chat TI e ticket chamado #}
{% set class = class|default('') %}
{% set kind = kind|default('chat') %}

{% if kind == 'chat' %}
<svg class="ti-svg-icon ti-svg-icon--chat {{ class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M7.5 18.5 5 20v-3.5H5a6.5 6.5 0 1 1 2.2-12.6A5.2 5.2 0 0 1 18.5 9 6.5 6.5 0 0 1 7.5 18.5Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
    <path d="M9 10.5h6M9 13.5h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
</svg>
{% elseif kind == 'ticket' %}
<svg class="ti-svg-icon ti-svg-icon--ticket {{ class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M6 5.5h12a1.5 1.5 0 0 1 1.5 1.5v2.2a1.8 1.8 0 0 0 0 3.6V16a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 16v-2.7a1.8 1.8 0 0 0 0-3.6V7A1.5 1.5 0 0 1 6 5.5Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
    <path d="M9.5 8v8M14.5 8v8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="1.5 2.5"/>
    <circle cx="12" cy="12" r="1.15" fill="currentColor"/>
</svg>
{% endif %}
