{# Anexos do chamado — card standalone (legado; preferir conversa integrada) #}
{% set attachments = attachments|default(ticket.attachments|default([])) %}
{% if attachments|length > 0 %}
<section class="unio-card mb-4">
    {% include 'components/section_header.html.twig' with {
        title: 'Anexos',
        subtitle: attachments|length ~ ' arquivo' ~ (attachments|length != 1 ? 's' : '')
    } %}
    <div class="ti-chamado-attachments-panel-body">
    {% include 'components/ti/chamado_attachments_grid.html.twig' with { attachments: attachments } %}
    </div>
</section>
{% endif %}
