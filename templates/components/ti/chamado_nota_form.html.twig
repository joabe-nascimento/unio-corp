{# Formulário — adicionar nota interna #}
<form method="post"
      action="{{ path('app_ti_chamado_nota', { id: ticket.id }) }}"
      class="ti-chamado-quick-form unio-form">
    <input type="hidden" name="_token" value="{{ csrf_token('ti_chamado_nota_' ~ ticket.id) }}">
    <label class="unio-form-label" for="tiChamadoNote">Adicionar nota</label>
    <textarea id="tiChamadoNote"
              name="note"
              class="unio-form-control mb-2"
              rows="2"
              maxlength="2000"
              placeholder="Registro interno visível na timeline…"
              required></textarea>
    <button type="submit" class="btn-unio-ghost btn-sm">
        <i class="fas fa-comment mr-1" aria-hidden="true"></i> Salvar nota
    </button>
</form>
