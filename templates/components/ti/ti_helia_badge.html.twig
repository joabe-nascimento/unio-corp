{#
  ti_helia_badge — badge Sasha / confiança (Núcleo TI)

  Props:
    label        (string)  texto completo
    confidence   (int)     monta label automaticamente
    style        (string)  confidence | helia  (default: confidence)
    attrs        (object)
#}
{% if label|default('') == '' and confidence is defined %}
    {% if style|default('confidence') == 'helia' %}
        {% set label = ai_assistant_name ~ ' ' ~ confidence ~ '%' %}
    {% else %}
        {% set label = confidence ~ '% confiança' %}
    {% endif %}
{% endif %}
{% include 'components/status_badge.html.twig' with {
    label: label|default(ai_assistant_name),
    variant: 'info',
    extra_class: 'ti-badge-helia',
    attrs: attrs|default({})
} %}
