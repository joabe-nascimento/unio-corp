{# Painel de emojis — composer do chat TI #}
{% set emojis = ['👍', '😊', '😂', '🙏', '✅', '❌', '⚠️', '🔧', '💻', '📎', '🎉', '👋', '🤔', '😅', '🚀', '❤️', '👀', '💡', '⏳', '🔥'] %}
<div class="ti-chat-emoji-panel" data-ti-chat-emoji-panel hidden>
    {% for emoji in emojis %}
    <button type="button" class="ti-chat-emoji-item" data-ti-chat-emoji="{{ emoji }}" aria-label="Inserir {{ emoji }}">{{ emoji }}</button>
    {% endfor %}
</div>
