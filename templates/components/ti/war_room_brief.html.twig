{# War Room — briefing operacional (estável / incidente) #}
<section class="unio-card mb-0 wr-brief wr-brief-bar">
    <div class="wr-brief-icon"><i class="fas fa-brain" aria-hidden="true"></i></div>
    <div class="wr-brief-content flex-fill">
        {% include 'components/section_header.html.twig' with {
            title: command_brief.headline,
            subtitle: command_brief.summary
        } %}
        <div class="wr-brief-actions d-flex flex-wrap gap-2 mt-2">
            {% for action in command_brief.actions %}
            <span class="wr-brief-action"><i class="fas fa-chevron-right fa-xs" aria-hidden="true"></i> {{ action }}</span>
            {% endfor %}
            {% include 'components/ti/ti_helia_badge.html.twig' with {
                confidence: command_brief.confidence|round,
                style: 'helia'
            } %}
        </div>
    </div>
</section>
