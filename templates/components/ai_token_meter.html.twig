{# Medidor de tokens Azure OpenAI — visível só para o usuário de diagnóstico #}
{% if app.user and app.user.email|lower == constant('App\\Dev\\DevSeedEmails::JOABE')|lower and organismo.enabled|default(false) and org_juridico|default(false) %}
<div class="ai-token-meter" id="aiTokenMeter" data-usage-url="{{ path('api_vitoria_ai_usage') }}" title="Consumo de tokens Azure OpenAI">
    <span class="ai-token-meter__icon" aria-hidden="true"><i class="fas fa-microchip"></i></span>
    <span class="ai-token-meter__body">
        <span class="ai-token-meter__label">IA</span>
        <span class="ai-token-meter__value" id="aiTokenMeterValue">—</span>
    </span>
    <span class="ai-token-meter__dot" id="aiTokenMeterDot" aria-hidden="true"></span>
</div>
{% endif %}
