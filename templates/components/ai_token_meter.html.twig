{# Medidor de tokens Azure OpenAI — visível só para o usuário de diagnóstico #}
{% if app.user and app.user.email|lower == constant('App\\Dev\\DevSeedEmails::JOABE')|lower and organismo.enabled|default(false) and org_juridico|default(false) %}
<div class="org-meter org-meter--ia ai-token-meter" id="aiTokenMeter" data-usage-url="{{ path('api_Sasha_ai_usage') }}">
    <span class="org-meter__icon ai-token-meter__icon" aria-hidden="true"><i class="fas fa-microchip"></i></span>
    <span class="org-meter__body ai-token-meter__body">
        <span class="org-meter__label ai-token-meter__label">IA</span>
        <span class="org-meter__value ai-token-meter__value" id="aiTokenMeterValue">—</span>
    </span>
    <span class="org-meter__dot ai-token-meter__dot" id="aiTokenMeterDot" aria-hidden="true"></span>
</div>
{% endif %}
