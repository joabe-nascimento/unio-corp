{# Filtro de estágios — botões padrão da plataforma #}
<div class="inov-stage-toolbar" data-inov-stage-strip>
    <button type="button" class="btn-unio-ghost btn-sm is-active" data-inov-stage="all">
        <i class="fas fa-layer-group mr-1" aria-hidden="true"></i>
        Completo <span class="text-muted">({{ pipeline_total }})</span>
    </button>
    {% for chip in stage_chips %}
    <button type="button" class="btn-unio-ghost btn-sm" data-inov-stage="{{ chip.id }}">
        <i class="fas {{ chip.icon }} mr-1" aria-hidden="true"></i>
        {{ chip.label }} <span class="text-muted">({{ chip.value }})</span>
    </button>
    {% endfor %}
</div>
