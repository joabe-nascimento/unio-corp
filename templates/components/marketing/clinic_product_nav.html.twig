{# Navbar de produtos clínicos — marketing #}
{% set _active = mkt_nav_active|default('') %}
{% set _clinic = org_clinic|default(false) %}
{% set _on_product = mkt_nav_on_product_page|default(false) %}
{% set _home = path('app_home') %}
{% set _labels = {
    '': 'Produtos',
    'home': 'Produtos',
    'paciente': 'Área do paciente',
    'pos-operatorio': 'Pós-operatório',
    'carteirinha': 'Carteirinha',
    'comprovante': 'Comprovante',
    'guia': 'Guia médico'
} %}

{% if _clinic %}

{% if not _on_product %}
<a href="#equipe-paciente">Jornada</a>
{% endif %}

<div class="mkt-nav-dropdown" data-nav-dropdown>
    <button
        type="button"
        class="mkt-nav-dropdown__trigger{{ _active and _active != 'home' ? ' is-active' : '' }}"
        aria-haspopup="true"
        aria-expanded="false"
        id="mkt-nav-products-trigger"
    >
        {{ _labels[_active]|default('Produtos') }}
        <i class="fas fa-chevron-down mkt-nav-dropdown__caret" aria-hidden="true"></i>
    </button>
    <div class="mkt-nav-dropdown__panel" role="menu" aria-labelledby="mkt-nav-products-trigger" hidden>
        <a href="{{ path('app_portal_pos_operatorio') }}" role="menuitem" class="{{ _active == 'pos-operatorio' ? 'is-active' : '' }}" data-nav-product-link>
            <i class="fas fa-user-nurse" aria-hidden="true"></i>
            Pós-operatório
        </a>
        <a href="{{ _on_product ? path('app_carteirinha_digital') : _home ~ '#carterinha-digital' }}" role="menuitem" class="{{ _active == 'carteirinha' ? 'is-active' : '' }}" data-nav-product-link>
            <i class="fas fa-id-card" aria-hidden="true"></i>
            Carteirinha digital
        </a>
        <a href="{{ path('app_comprovante_procedimento') }}" role="menuitem" class="{{ _active == 'comprovante' ? 'is-active' : '' }}" data-nav-product-link>
            <i class="fas fa-file-medical" aria-hidden="true"></i>
            Comprovante
        </a>
        <a href="{{ _on_product ? path('app_paciente_hub') : _home ~ '#area-paciente' }}" role="menuitem" class="{{ _active == 'paciente' ? 'is-active' : '' }}" data-nav-product-link>
            <i class="fas fa-house-medical" aria-hidden="true"></i>
            Área do paciente
        </a>
        <a href="{{ path('app_guia_medico_beneficiario') }}" role="menuitem" class="{{ _active == 'guia' ? 'is-active' : '' }}" data-nav-product-link>
            <i class="fas fa-book-medical" aria-hidden="true"></i>
            Guia médico
        </a>
    </div>
</div>

{% if not _on_product %}
<a href="#casos-procedimento">Protocolos</a>
<a href="#planos">Planos</a>
<a href="#operacao-tempo-real">Operação</a>
<a href="#carterinha-digital">Demonstração</a>
<a href="#faq">FAQ</a>
{% else %}
<a href="{{ path('app_home') }}">Início</a>
{% endif %}

{% else %}
<nav class="mkt-nav mkt-nav--v2" aria-label="Navegação">
    <a href="#recursos">Recursos</a>
    <a href="#modulos">Módulos</a>
    <a href="#funcionalidades">Funcionalidades</a>
    <a href="#como-funciona">Como funciona</a>
    <a href="#faq">FAQ</a>
</nav>
{% endif %}
