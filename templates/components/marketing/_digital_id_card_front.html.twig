<span class="mkt-idcard__shine" aria-hidden="true"></span>
<span class="mkt-idcard__pattern" aria-hidden="true"></span>
<header class="mkt-idcard__header">
    <span class="mkt-idcard__brand">
        <i class="fas fa-heart-pulse" aria-hidden="true"></i>
        {{ card.clinica|default('UNIO SAÚDE') }}
    </span>
    {% if card.ribbon|default(null) %}
    <span class="mkt-idcard__ribbon">{{ card.ribbon }}</span>
    {% endif %}
</header>

<span class="mkt-idcard__body">
    <span class="mkt-idcard__media">
        <span class="mkt-idcard__avatar{{ card.foto|default(null) ? ' mkt-idcard__avatar--photo' : '' }}" aria-hidden="true">
            {% if card.foto|default(null) %}
            <img src="{{ card.foto }}" alt="" width="56" height="56" loading="lazy" decoding="async">
            {% else %}
            {{ card.iniciais|default('JP') }}
            {% endif %}
        </span>
        <span class="mkt-idcard__qr" aria-hidden="true">
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
        </span>
    </span>
    <span class="mkt-idcard__info">
        <span class="mkt-idcard__identity">
            <strong class="mkt-idcard__name">{{ card.nome|default('Paciente') }}</strong>
            <span class="mkt-idcard__role">{{ card.role|default('Paciente') }}</span>
            <span class="mkt-idcard__identity-meta">
                {% if card.plano_label|default('') %}
                <span class="mkt-idcard__plan-tag">{{ card.plano_label }}</span>
                {% endif %}
                {% if card.dia_pos is defined %}
                <span class="mkt-idcard__phase">Dia {{ card.dia_pos }} pós-op</span>
                {% endif %}
            </span>
        </span>
        <dl class="mkt-idcard__fields">
            <div class="mkt-idcard__field">
                <dt>Código</dt>
                <dd>{{ card.codigo|default('PO-0000') }}</dd>
            </div>
            <div class="mkt-idcard__field">
                <dt>Válido até</dt>
                <dd>{{ card.valido_ate|default('—') }}</dd>
            </div>
            {% if card.cpf_masked|default(null) %}
            <div class="mkt-idcard__field">
                <dt>CPF</dt>
                <dd>{{ card.cpf_masked }}</dd>
            </div>
            <div class="mkt-idcard__field">
                <dt>Emitido em</dt>
                <dd>{{ card.emitido_em|default('—') }}</dd>
            </div>
            {% else %}
            <div class="mkt-idcard__field">
                <dt>Emitido em</dt>
                <dd>{{ card.emitido_em|default('—') }}</dd>
            </div>
            <div class="mkt-idcard__field">
                <dt>Protocolo</dt>
                <dd>{{ card.protocolo|default('—') }}</dd>
            </div>
            {% endif %}
            <div class="mkt-idcard__field mkt-idcard__field--wide">
                <dt>Procedimento</dt>
                <dd>{{ card.procedimento|default('Procedimento') }}</dd>
            </div>
            <div class="mkt-idcard__field">
                <dt>Médico</dt>
                <dd>{{ card.medico|default('—') }}</dd>
            </div>
            {% if card.cpf_masked|default(null) %}
            <div class="mkt-idcard__field">
                <dt>Protocolo</dt>
                <dd>{{ card.protocolo|default('—') }}</dd>
            </div>
            {% else %}
            <div class="mkt-idcard__field">
                <dt>Cirurgia</dt>
                <dd>{{ card.cirurgia|default('—') }}</dd>
            </div>
            {% endif %}
        </dl>
        <span class="mkt-idcard__footer-bar">
            <span class="mkt-idcard__type">{{ card.doc_type_label|default('Carteira digital') }}</span>
            {% if card.clinica|default(null) %}
            <span class="mkt-idcard__issuer">{{ card.clinica }}</span>
            {% endif %}
        </span>
    </span>
</span>
