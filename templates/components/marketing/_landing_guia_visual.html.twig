{# Visual do guia médico na landing (estilo painel clínico) #}
{% import 'macros/marketing_protocol.html.twig' as protocol %}
{% set _guia = guia|default({}) %}
{% set _card = card|default({}) %}

<div class="mkt-guia-board" aria-hidden="true">
    <div class="mkt-guia-board__head">
        <strong>Seu guia médico</strong>
        <span>D+{{ _card.dia_pos|default(3) }}</span>
    </div>

    <div class="mkt-guia-board__hero">
        <span class="mkt-guia-board__phase">{{ _guia.fase_label|default('Fase intermediária') }}</span>
        <strong class="mkt-guia-board__name">{{ _card.nome|default('Ana Costa') }}</strong>
        <span class="mkt-guia-board__meta">{{ _card.procedimento|default('Herniorrafia inguinal') }} · D+{{ _card.dia_pos|default(3) }}</span>
    </div>

    <div class="mkt-guia-board__chips">
        <span>Protocolo ativo</span>
        <span class="is-warn">2 sinais de alerta</span>
    </div>

    <div class="mkt-guia-board__main">
        {{ protocol.timeline('Linha do protocolo', _guia.marco_steps|default([
            {state: 'is-done', day: 'D+1', text: 'Repouso e analgesia'},
            {state: 'is-current', day: 'D+3', text: 'Curativo e mobilização'},
            {state: '', day: 'D+7', text: 'Retorno ambulatorial'},
        ]), 'mkt-protocol-rail--compact') }}
        <div class="mkt-guia-board__metrics">
            <div><strong>3/10</strong><span>Dor relatada</span></div>
            <div><strong>D+7</strong><span>Próximo retorno</span></div>
            <div><strong>100%</strong><span>LGPD OK</span></div>
        </div>
    </div>

    <div class="mkt-guia-board__patient">
        <img class="mkt-guia-board__avatar" src="{{ _card.foto|default('https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80') }}" alt="" width="44" height="44" loading="lazy">
        <div class="mkt-guia-board__patient-body">
            <strong>{{ _card.nome|default('Ana Costa') }} · D+{{ _card.dia_pos|default(3) }} · {{ _card.procedimento|default('Herniorrafia') }}</strong>
            <span>{{ _card.medico|default('Dra. Renata Oliveira') }} acompanha · Portal ativo</span>
            <div class="mkt-guia-board__tags">
                <span>Risco baixo</span>
                <span>Checklist do dia</span>
                <span>Carteirinha vinculada</span>
            </div>
        </div>
    </div>
</div>
