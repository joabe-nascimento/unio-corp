{# Hero do dashboard — saudação, perfil e data/hora #}
{% set access_badge = user_access_badge() %}
{% set headline = layout_headline|default({}) %}

<section class="dashboard-hero huplex-card mb-4">
    <div class="dashboard-hero-bg" aria-hidden="true"></div>
    <div class="dashboard-hero-inner">
        <div class="dashboard-hero-main">
            <h1 class="dashboard-hero-greeting">{{ greeting }}, {{ app.user.nome|split(' ')|first }}!</h1>
            <div class="dashboard-hero-meta">
                <span class="dashboard-hero-name">{{ app.user.nome }}</span>
                <span class="badge-perfil {{ access_badge.class }}"
                      {% if access_badge.elevated %}title="Conta global: {{ access_badge.global_label }}"{% endif %}>
                    {{ access_badge.label }}
                </span>
            </div>
            {% if headline.title is defined %}
            <p class="dashboard-hero-context">
                <i class="fas {{ headline.icon|default('fa-gauge-high') }}" aria-hidden="true"></i>
                <span>{{ headline.title }}</span>
                {% if headline.subtitle is defined and headline.subtitle %}
                <span class="dashboard-hero-context-sep">—</span>
                <span class="dashboard-hero-context-sub">{{ headline.subtitle }}</span>
                {% endif %}
            </p>
            {% endif %}
            {% if empresa %}
            <p class="dashboard-hero-empresa">
                <i class="fas fa-building" aria-hidden="true"></i>
                {{ empresa.nome }}{% if empresa.setor %} · {{ empresa.setor }}{% endif %}
            </p>
            {% endif %}
        </div>
        <div class="dashboard-hero-datetime" id="dashboardDateTime">
            <div class="dw-date">
                <i class="fas fa-calendar-day" aria-hidden="true"></i>
                <span data-dashboard-weekday>{{ weekday }}</span>,
                <span data-dashboard-date>{{ date_label }}</span>
            </div>
            <div class="dw-time">
                <i class="fas fa-clock" aria-hidden="true"></i>
                <span data-dashboard-time>{{ time_label }}</span>
            </div>
        </div>
    </div>
</section>
