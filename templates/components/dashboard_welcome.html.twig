{# Hero do dashboard — compacto (central de comando) #}
{% set access_badge = user_access_badge() %}
{% set headline = layout_headline|default({}) %}
{% set _context_parts = [] %}
{% if empresa %}
    {% set _context_parts = _context_parts|merge([org_brand_label|default(empresa.nome)]) %}
{% else %}
    {% set _context_parts = _context_parts|merge([platform_config.plataforma_nome|default('Unio')]) %}
{% endif %}
{% set _context_parts = _context_parts|merge([access_badge.label]) %}

<section class="dashboard-hero dashboard-hero--compact unio-card unio-shell-hero unio-shell-surface mb-4">
    <div class="dashboard-hero-bg" aria-hidden="true"></div>
    <div class="dashboard-hero-inner dashboard-hero-inner--compact">
        <header class="dashboard-hero-top">
            <p class="dashboard-hero-context-line">{{ _context_parts|join(' · ') }}</p>
            <div class="dashboard-hero-datetime-compact" id="dashboardDateTime">
                <span class="dashboard-hero-datetime-pill">
                    <i class="fas fa-calendar-day" aria-hidden="true"></i>
                    <span>{{ weekday }}, {{ date_label }}</span>
                </span>
                <span class="dashboard-hero-datetime-pill dashboard-hero-datetime-pill--time">
                    <i class="fas fa-clock" aria-hidden="true"></i>
                    <span data-dashboard-time>{{ time_label }}</span>
                </span>
            </div>
        </header>

        <div class="dashboard-hero-main">
            <h1 class="dashboard-hero-greeting">{{ greeting }}, {{ app.user.nome|split(' ')|first }}!</h1>
            <div class="dashboard-hero-subtitle">
                {% if headline.title is defined and headline.subtitle is defined %}
                    <span class="dashboard-hero-subtitle-line dashboard-hero-subtitle-line--lead">{{ headline.title }}</span>
                    {% for part in headline.subtitle|split(' · ') %}
                        {% if part|trim %}
                        <span class="dashboard-hero-subtitle-line">{{ part|trim }}</span>
                        {% endif %}
                    {% endfor %}
                {% elseif headline.title is defined %}
                    <span class="dashboard-hero-subtitle-line">{{ headline.title }}</span>
                {% else %}
                    <span class="dashboard-hero-subtitle-line">Visão geral da sua área de trabalho.</span>
                {% endif %}
            </div>
        </div>
    </div>
</section>
