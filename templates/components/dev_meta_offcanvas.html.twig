{#
  dev_meta_offcanvas — nova meta (usa unio_offcanvas)
#}
{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'dev-meta',
    title: 'Nova meta',
    subtitle: 'Defina uma meta vinculada a um projeto ou à plataforma.',
    icon: 'fa-bullseye',
    open: open is defined and open,
    size: 'md'
} %}
    {% block offcanvas_body %}
        <form method="post" action="{{ path('app_core_metas_nova') }}" class="unio-form unio-offcanvas-form">
            <input type="hidden" name="_token" value="{{ csrf_token('dev_meta_create') }}">
            {% include 'modules/core/projetos/_meta_form_fields.html.twig' with {
                rd: rd|default({}),
                projetos: projetos|default([])
            } %}
            <div class="unio-form-actions unio-offcanvas-form-actions">
                <button type="submit" class="btn-unio">
                    <i class="fas fa-check mr-1" aria-hidden="true"></i> Criar meta
                </button>
                <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
            </div>
        </form>
    {% endblock %}
{% endembed %}
