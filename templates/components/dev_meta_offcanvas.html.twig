{#
  dev_meta_offcanvas — nova meta (usa huplex_offcanvas)
#}
{% embed 'components/huplex_offcanvas.html.twig' with {
    id: 'dev-meta',
    title: 'Nova meta',
    subtitle: 'Defina uma meta vinculada a um projeto ou à plataforma.',
    icon: 'fa-bullseye',
    open: open is defined and open,
    size: 'md'
} %}
    {% block offcanvas_body %}
        <form method="post" action="{{ path('app_core_metas_nova') }}" class="huplex-form huplex-offcanvas-form">
            <input type="hidden" name="_token" value="{{ csrf_token('dev_meta_create') }}">
            {% include 'modules/core/projetos/_meta_form_fields.html.twig' with {
                rd: rd|default({}),
                projetos: projetos|default([])
            } %}
            <div class="huplex-form-actions huplex-offcanvas-form-actions">
                <button type="submit" class="btn-huplex">
                    <i class="fas fa-check mr-1" aria-hidden="true"></i> Criar meta
                </button>
                <button type="button" class="btn-huplex-ghost" data-huplex-offcanvas-close>Cancelar</button>
            </div>
        </form>
    {% endblock %}
{% endembed %}
