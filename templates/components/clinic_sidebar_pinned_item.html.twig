{#
  Item fixo da zona HOJE (link de 1º nível, sem treeview)

  Props:
    feature   (array)  item do ClinicFeatureCatalog
    route     (string) rota atual
    badges    (array)  clinic_nav_badges
#}
{% set _active = clinic_feature_route_active(route, feature) %}
{% set _bk = feature.badge_key|default('') %}
{% set _actionable = _bk in ['precisa_acao', 'alertas', 'questionarios', 'sala_critica', 'solicitacoes', 'assinaturas', 'tarefas'] %}
{% set _badge = _actionable ? badges[_bk]|default(0) : 0 %}
<li class="nav-item clinic-nav-pinned">
    <a href="{{ path(feature.route) }}"
       class="nav-link clinic-nav-pinned__link{{ _active ? ' active' : '' }}"
       {% if feature.external|default(false) %}target="_blank" rel="noopener"{% endif %}
       {{ _active ? ' aria-current="page"' : '' }}>
        <span class="nav-icon-slot">
            <i class="fas {{ feature.icon }} nav-icon" aria-hidden="true"></i>
            {% if _badge > 0 %}
            <span class="nav-clinic-badge{% if _bk == 'sala_critica' %} nav-clinic-badge--danger{% elseif _bk in ['alertas', 'questionarios', 'precisa_acao', 'solicitacoes', 'assinaturas', 'tarefas'] %} nav-clinic-badge--warning{% endif %}">{{ _badge }}</span>
            {% endif %}
        </span>
        <p>{{ feature.short|default(feature.title) }}</p>
    </a>
</li>
