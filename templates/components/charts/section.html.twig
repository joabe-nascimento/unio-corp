{#
  charts/section — grupo de gráficos dentro de um painel

  Props:
    section     (array)   id, title, subtitle, icon, tier, badge, charts[]
    panel_id    (string)
#}
{% set _section = section %}
{% set _panel = panel_id|default('default') %}
{% set _tier = _section.tier|default('operational') %}

<section class="unio-chart-section unio-card unio-shell-surface unio-chart-section--{{ _tier }}"
         data-unio-chart-section="{{ _section.id }}">
    {% include 'components/shell_section_head.html.twig' with {
        head_class: 'unio-chart-section-head',
        badge_class: 'unio-chart-section-badge',
        title_class: 'unio-chart-section-title',
        sub_class: 'unio-chart-section-sub',
        count_class: 'unio-chart-section-count',
        badge: _section.badge|default(''),
        title: _section.title,
        subtitle: _section.subtitle,
        count: _section.charts|length ~ ' visuais'
    } only %}
    <div class="unio-charts-grid unio-charts-grid--enterprise">
        {% for chart in _section.charts %}
            {% include 'components/charts/card.html.twig' with {
                chart: chart,
                panel_id: _panel
            } only %}
        {% endfor %}
    </div>
</section>
