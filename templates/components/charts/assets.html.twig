{#
  charts/assets — carrega Chart.js + huplex-charts.js (incluir uma vez por página com gráficos)

  Props:
    sections   (list)  só carrega scripts se length > 0
    version    (int)   cache bust do huplex-charts.js
#}
{% if sections|default([])|length > 0 %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script src="{{ asset('js/huplex-charts.js') }}?v={{ version|default(1) }}"></script>
{% endif %}
