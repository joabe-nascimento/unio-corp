{# Wordmark Unio: U-n-i ligados na base (traço contínuo) + o separado #}
{% set size = size|default('sm') %}
<span class="unio-wordmark unio-wordmark-{{ size }}" aria-label="Unio">
    <svg class="unio-wordmark-svg" viewBox="0 0 88 34" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            {# Hastes do U #}
            <path d="M4 5v17M20 5v17"/>
            {# Base contínua: U → n → i (setas vermelhas do mockup) #}
            <path d="M4 22Q12 27 20 22L23 22V8Q28 8 33 8v14L50 22"/>
            {# Haste do i #}
            <path d="M50 9v13"/>
        </g>
        <circle cx="50" cy="5.5" r="2.4" fill="currentColor"/>
        <rect x="3" y="29" width="49" height="3" rx="1.5" fill="#6B9AFF"/>
        <ellipse cx="66" cy="16" rx="6.5" ry="7.5" fill="#6B9AFF"/>
    </svg>
</span>
