{# Tile de módulo no dashboard #}
<a href="{{ path(route) }}" class="module-item">
    <div class="mi-icon"><i class="fas {{ icon }}"></i></div>
    <div class="module-item-body">
        <div class="mi-title">{{ title }}</div>
        <div class="mi-sub">{{ subtitle }}</div>
    </div>
    <i class="fas fa-chevron-right mi-arrow"></i>
</a>
