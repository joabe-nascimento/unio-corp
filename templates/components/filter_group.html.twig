{#
  filter_group — select de filtro (toolbar / listagem)

  Props:
    label     (string)  usado em aria-label do select (ex.: Área)
    options   (array)   lista de opções (string ou { value, label })
    name      (string, opt)
    disabled  (bool, opt)
    min_width (string, opt)  ex.: '130px'
#}
<div class="filter-group">
    <select class="filter-select"
            aria-label="{{ label|default('Filtrar') }}"
            {% if name is defined and name %}id="filter-{{ name }}" name="{{ name }}"{% endif %}
            {% if disabled|default(false) %}disabled{% endif %}
            {% if min_width is defined and min_width %}style="min-width: {{ min_width }}"{% endif %}>
        {% for opt in options|default([]) %}
            {% if opt is iterable and opt.label is defined %}
                <option value="{{ opt.value|default(opt.label) }}">{{ opt.label }}</option>
            {% else %}
                <option>{{ opt }}</option>
            {% endif %}
        {% endfor %}
    </select>
</div>
