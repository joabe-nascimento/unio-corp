{#
  filter_group — filtro de toolbar / listagem (select, month, text)

  Props:
    label        (string)  aria-label; visível se show_label=true
    type         (string, opt)  select | month | text  (default: select)
    show_label   (bool, opt)  label acima do controle
    options      (array, opt)  opções do select
    name         (string, opt)
    id           (string, opt)  id do controle (default: filter-{name})
    value        (string, opt)
    disabled     (bool, opt)
    min_width    (string, opt)  ex.: '150px'
    group_id     (string, opt)  id no wrapper .filter-group
    group_class  (string, opt)  classes extras no wrapper .filter-group
    select_attrs (array, opt)  atributos extras no select/input (data-*, etc.)
#}
{% set _type = type|default('select') %}
{% set _id = id|default(name is defined and name ? 'filter-' ~ name : '') %}
{% set _select_attrs = select_attrs|default({}) %}
<div class="filter-group{% if group_class|default('') %} {{ group_class }}{% endif %}"{% if group_id is defined and group_id %} id="{{ group_id }}"{% endif %}>
    {% if show_label|default(false) and label is defined and label %}
        <label class="filter-label"{% if _id %} for="{{ _id }}"{% endif %}>{{ label }}</label>
    {% endif %}
    {% if _type == 'month' %}
        <input type="month"
               class="filter-select"
               {% if _id %}id="{{ _id }}"{% endif %}
               {% if name is defined and name %}name="{{ name }}"{% endif %}
               {% if value is defined and value %}value="{{ value }}"{% endif %}
               {% if disabled|default(false) %}disabled{% endif %}
               aria-label="{{ label|default('Filtrar') }}"
               {% if min_width is defined and min_width %}style="min-width: {{ min_width }}"{% endif %}>
    {% elseif _type in ['text', 'date'] %}
        <input type="{{ _type == 'text' ? input_type|default('text') : _type }}"
               class="filter-select"
               {% if _id %}id="{{ _id }}"{% endif %}
               {% if name is defined and name %}name="{{ name }}"{% endif %}
               {% if value is defined and value %}value="{{ value }}"{% endif %}
               {% if placeholder is defined and placeholder %}placeholder="{{ placeholder }}"{% endif %}
               {% if disabled|default(false) %}disabled{% endif %}
               aria-label="{{ label|default('Filtrar') }}"
               {% if min_width is defined and min_width %}style="min-width: {{ min_width }}"{% endif %}>
    {% else %}
        {% set _selected_label = label|default('Filtrar') %}
        {% for opt in options|default([]) %}
            {% if opt is iterable and opt.label is defined %}
                {% set _opt_val = opt.value|default(opt.label) %}
                {% set _is_selected = (value is defined and value is not null and value|length > 0 and value == _opt_val)
                    or (loop.first and (value is not defined or value is null or value|length == 0)) %}
                {% if _is_selected %}{% set _selected_label = opt.label %}{% endif %}
            {% else %}
                {% set _is_selected = (value is defined and value is not null and value|length > 0 and value == opt)
                    or (loop.first and (value is not defined or value is null or value|length == 0)) %}
                {% if _is_selected %}{% set _selected_label = opt %}{% endif %}
            {% endif %}
        {% endfor %}
        <div class="filter-select-wrap"{% if min_width is defined and min_width %} style="max-width: {{ min_width }}"{% endif %}>
            <span class="filter-select-sizer" aria-hidden="true">{{ _selected_label }}</span>
            <select class="filter-select"
                    data-filter-select
                    aria-label="{{ label|default('Filtrar') }}"
                    {% if _id %}id="{{ _id }}"{% endif %}
                    {% if name is defined and name %}name="{{ name }}"{% endif %}
                    {% if disabled|default(false) %}disabled{% endif %}
                    {% for attr, val in _select_attrs %}{{ attr }}="{{ val }}" {% endfor %}>
                {% for opt in options|default([]) %}
                    {% if opt is iterable and opt.label is defined %}
                        {% set _opt_val = opt.value|default(opt.label) %}
                        {% set _is_selected = (value is defined and value is not null and value|length > 0 and value == _opt_val)
                            or (loop.first and (value is not defined or value is null or value|length == 0)) %}
                        <option value="{{ _opt_val }}"{% if _is_selected %} selected{% endif %}>
                            {{ opt.label }}
                        </option>
                    {% else %}
                        {% set _is_selected = (value is defined and value is not null and value|length > 0 and value == opt)
                            or (loop.first and (value is not defined or value is null or value|length == 0)) %}
                        <option{% if _is_selected %} selected{% endif %}>{{ opt }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>
    {% endif %}
</div>
