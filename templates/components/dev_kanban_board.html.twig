{#
  dev_kanban_board — kanban com drag-and-drop (SortableJS)

  Props: kanban, kanban_columns, projeto_filter, move_url_template, csrf_move,
         tarefa_edit_url_template, csrf_tarefa_delete, projetos (opt), redirect (opt)
#}
{% set _projeto_filter = projeto_filter|default(0) %}
{% set _projetos = projetos|default([]) %}
{% set _can_add = _projetos is not empty %}
<div class="kanban-board dev-kanban-board"
     data-dev-kanban
     data-move-url-template="{{ move_url_template }}"
     data-csrf="{{ csrf_move }}"
     {% if tarefa_edit_url_template is defined %}data-edit-url-template="{{ tarefa_edit_url_template }}"{% endif %}
     {% if tarefa_delete_url_template is defined %}data-delete-url-template="{{ tarefa_delete_url_template }}"{% endif %}
     {% if csrf_tarefa_delete is defined %}data-csrf-delete="{{ csrf_tarefa_delete }}"{% endif %}
     {% if _projeto_filter > 0 %}data-projeto-filter="{{ _projeto_filter }}"{% endif %}
     {% if redirect|default('') == 'show' %}data-redirect="show"{% endif %}
     {% if not _can_add %}data-kanban-add-disabled{% endif %}>
    {% for status, label in kanban_columns %}
    {% set _column_tasks = kanban[status]|default([]) %}
    {% set _default_projeto_id = _projeto_filter > 0 ? _projeto_filter : (_column_tasks|first.projeto.id|default(0)) %}
    <div class="kanban-column" data-kanban-column-wrap="{{ status }}">
        <div class="kanban-column-header">
            <span class="kanban-column-title">{{ label }}</span>
            <span class="kanban-column-count" data-kanban-count="{{ status }}">{{ _column_tasks|length }}</span>
        </div>
        <div class="kanban-column-body">
            <button type="button"
                    class="kanban-column-add-card"
                    data-kanban-add
                    data-kanban-status="{{ status }}"
                    data-kanban-projeto-id="{{ _default_projeto_id }}"
                    aria-label="Adicionar tarefa em {{ label }}"
                    title="Nova tarefa em {{ label }}">
                <i class="fas fa-plus" aria-hidden="true"></i>
                <span>Adicionar tarefa</span>
            </button>
            <div class="kanban-column-cards dev-kanban-column"
                 data-status="{{ status }}"
                 data-kanban-column="{{ status }}">
                {% for tarefa in _column_tasks %}
                <div class="kanban-card dev-kanban-card"
                     data-task-id="{{ tarefa.id }}"
                     data-task-titulo="{{ tarefa.titulo|e('html_attr') }}"
                     data-task-descricao="{{ tarefa.descricao|default('')|e('html_attr') }}"
                     data-task-status="{{ tarefa.status }}"
                     data-task-prioridade="{{ tarefa.prioridade }}"
                     data-task-projeto-id="{{ tarefa.projeto.id }}"
                     data-task-meta-id="{{ tarefa.meta ? tarefa.meta.id : '' }}"
                     data-task-projeto-nome="{{ tarefa.projeto.nome|e('html_attr') }}">
                    <div class="dropdown kanban-card-actions">
                        <button type="button"
                                class="kanban-card-menu-btn"
                                data-toggle="dropdown"
                                aria-haspopup="true"
                                aria-expanded="false"
                                aria-label="Opções da tarefa"
                                title="Opções">
                            <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right huplex-dropdown kanban-card-dropdown">
                            <button type="button"
                                    class="dropdown-item"
                                    data-kanban-edit
                                    data-task-id="{{ tarefa.id }}">
                                <i class="fas fa-pen" aria-hidden="true"></i> Editar
                            </button>
                            {% if not hide_project_link|default(false) %}
                            <a href="{{ path('app_core_projetos_show', { id: tarefa.projeto.id }) }}"
                               class="dropdown-item">
                                <i class="fas fa-diagram-project" aria-hidden="true"></i> Ver projeto
                            </a>
                            {% endif %}
                            <div class="dropdown-divider"></div>
                            <button type="button"
                                    class="dropdown-item dropdown-item-danger"
                                    data-kanban-delete
                                    data-task-id="{{ tarefa.id }}"
                                    data-task-titulo="{{ tarefa.titulo|e('html_attr') }}">
                                <i class="fas fa-trash" aria-hidden="true"></i> Excluir
                            </button>
                        </div>
                    </div>
                    <div class="kanban-card-top">
                        <span class="kanban-card-drag-handle" title="Arrastar" aria-hidden="true"><i class="fas fa-grip-vertical"></i></span>
                        <p class="kanban-card-title" title="{{ tarefa.titulo }}">{{ tarefa.titulo }}</p>
                    </div>
                    {% if not hide_project_link|default(false) %}
                    <a href="{{ path('app_core_projetos_show', { id: tarefa.projeto.id }) }}" class="kanban-card-project">
                        {{ tarefa.projeto.nome }}
                    </a>
                    {% endif %}
                    {% if tarefa.descricao %}
                        <p class="kanban-card-desc" title="{{ tarefa.descricao }}">{{ tarefa.descricao|length > 90 ? tarefa.descricao|slice(0, 90) ~ '…' : tarefa.descricao }}</p>
                    {% endif %}
                    <div class="kanban-card-footer">
                        <span class="kanban-card-priority kanban-card-priority--{{ tarefa.prioridade|lower }}">{{ tarefa.prioridadeLabel }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
