{#
  kpi_row — linha de KPIs componentizada (Organismo usa org_kpi_strip premium)

  Props:
    items   (array)   cada item: { value, label, sub?, icon?, tone?, variant?, route?,
                       route_params?, href?, delta?, delta_variant?, pulse?, span?,
                       value_html?, sublist?, kpi_key?, trend? }
    mb      (string, opt)  margem bottom Bootstrap (legado sem organismo). Default: 'mb-3'
    extra_class (string, opt)
    layout  (string, opt) strip | tiles | compact — repassado ao org_kpi_strip
#}
{% set n = items|length %}
{% if organismo.enabled|default(false) %}
<div class="page-lead-kpis page-lead-kpis--organismo{% if extra_class is defined and extra_class %} {{ extra_class }}{% endif %}">
    {% include 'components/org_kpi_strip.html.twig' with { items: items, layout: layout|default('strip') } %}
</div>
{% else %}
{% set col_class = n == 1 ? 'col-12'
    : (n == 2 ? 'col-md-6'
    : (n == 3 ? 'col-md-4'
    : (n == 4 ? 'col-lg-3 col-md-6'
    : 'col-lg-3 col-md-6'))) %}

<div class="row stats-row {{ mb|default('mb-3') }}{% if extra_class is defined and extra_class %} {{ extra_class }}{% endif %}">
    {% for item in items %}
    <div class="col-sm-6 {{ col_class }}">
        {% include 'components/stat_card.html.twig' with item %}
    </div>
    {% endfor %}
</div>
{% endif %}
