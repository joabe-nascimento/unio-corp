{#
  page_back_link — voltar no topo da page_list

  Props:
    label (string, opt)  default: Voltar
    href  (string)
    icon  (string, opt)  default: fa-arrow-left
    icon_only (bool, opt)  só a seta
#}
<a href="{{ href }}"
   class="page-back-link{% if icon_only|default(false) %} page-back-link--icon-only{% endif %}{% if small|default(false) %} page-back-link--sm{% endif %}{% if inline|default(false) %} page-back-link--inline{% endif %}{% if bare|default(false) %} page-back-link--bare{% endif %}"
   aria-label="{{ label|default('Voltar') }}">
    <i class="fas {{ icon|default('fa-arrow-left') }}" aria-hidden="true"></i>
    {% if not icon_only|default(false) %}
        <span>{{ label|default('Voltar') }}</span>
    {% endif %}
</a>
