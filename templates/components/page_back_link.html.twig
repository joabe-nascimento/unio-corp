{#
  page_back_link — voltar no topo da page_list

  Props:
    label (string, opt)  default: Voltar
    href  (string)
    icon  (string, opt)  default: fa-arrow-left
#}
<a href="{{ href }}" class="btn-huplex-ghost btn-sm">
    <i class="fas {{ icon|default('fa-arrow-left') }}"></i> {{ label|default('Voltar') }}
</a>
