{% if notifications is empty %}
    {% include 'components/empty_state.html.twig' with {
        icon: 'fa-bell-slash',
        title: 'Nenhuma notificação',
        text: 'Quando houver novidades no recrutamento e nos módulos da plataforma, elas aparecerão aqui.'
    } %}
{% else %}
    <div class="notif-list" role="list">
        {% for n in notifications %}
            <a href="{{ path(n.open_url|default('app_notifications_open'), { id: n.id }) }}" class="notif-item notif-item--link notif-item--{{ n.type }} {{ n.read ? 'notif-item--read' : 'notif-item--unread' }}" role="listitem">
                <div class="notif-item-icon" aria-hidden="true">
                    <i class="fas {{ n.icon }}"></i>
                </div>
                <div class="notif-item-body">
                    <div class="notif-item-head">
                        <span class="notif-item-title">{{ n.title }}</span>
                        {% if not n.read %}
                            <span class="notif-item-dot" aria-label="Não lida"></span>
                        {% endif %}
                    </div>
                    <p class="notif-item-text">{{ n.body }}</p>
                    <span class="notif-item-time">{{ n.time_label }}</span>
                </div>
                <i class="fas fa-chevron-right notif-item-arrow" aria-hidden="true"></i>
            </a>
        {% endfor %}
    </div>
{% endif %}
