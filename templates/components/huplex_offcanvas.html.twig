{#
  huplex_offcanvas — painel lateral reutilizável (Unio)

  Props obrigatórias:
    id (string)  slug único, ex.: dev-projeto

  Props opcionais:
    title, subtitle, icon (classe FA, ex. fa-diagram-project)
    open (bool)
    placement ('end'|'start', default end)
    size ('sm'|'md'|'lg'|'xl', default md)
    accent (bool, default true) — faixa e ícone no header

  Blocks:
    offcanvas_header  — substitui o header padrão
    offcanvas_body    — conteúdo
    offcanvas_footer  — rodapé fixo (opcional)

  Abrir:  data-huplex-offcanvas-open="{{ id }}"
  Fechar: data-huplex-offcanvas-close (dentro do painel)
#}
{% set _id = id %}
{% set _open = open is defined and open %}
{% set _placement = placement|default('end') %}
{% set _size = size|default('md') %}
{% set _accent = accent is not defined or accent %}
{% set _title_id = 'huplexOffcanvasTitle-' ~ _id|replace({'-': ''}) %}
<div class="huplex-offcanvas huplex-offcanvas--{{ _placement }} huplex-offcanvas--{{ _size }}{% if _open %} is-open{% endif %}{% if _accent %} huplex-offcanvas--accent{% endif %}"
     data-huplex-offcanvas="{{ _id }}"
     aria-hidden="{{ _open ? 'false' : 'true' }}">
    <div class="huplex-offcanvas-backdrop" data-huplex-offcanvas-close tabindex="-1" aria-hidden="true"></div>
    <aside class="huplex-offcanvas-drawer" role="dialog" aria-modal="true" aria-labelledby="{{ _title_id }}">
        {% block offcanvas_header %}
        <header class="huplex-offcanvas-header">
            <div class="huplex-offcanvas-header-main">
                {% if icon is defined and icon %}
                <div class="huplex-offcanvas-icon" aria-hidden="true">
                    <i class="fas {{ icon }}"></i>
                </div>
                {% endif %}
                <div class="huplex-offcanvas-heading">
                    {% if title is defined and title %}
                    <h2 class="huplex-offcanvas-title" id="{{ _title_id }}">{{ title }}</h2>
                    {% endif %}
                    {% if subtitle is defined and subtitle %}
                    <p class="huplex-offcanvas-subtitle">{{ subtitle }}</p>
                    {% endif %}
                </div>
            </div>
            <button type="button" class="huplex-offcanvas-close" data-huplex-offcanvas-close aria-label="Fechar">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </header>
        {% endblock %}
        <div class="huplex-offcanvas-body">
            {% block offcanvas_body %}{% endblock %}
        </div>
        {% block offcanvas_footer %}{% endblock %}
    </aside>
</div>
