{# Núcleo de identidade — topo da sidebar: conta e atalhos #}
{% set _first_name = app.user.nome|split(' ')|first %}

<div class="sidebar-identity" data-tour="identity">
    <button type="button"
            class="sidebar-identity__trigger"
            id="sidebarIdentityBtn"
            aria-expanded="false"
            aria-controls="sidebarIdentityPanel"
            aria-haspopup="dialog"
            aria-label="{{ app.user.nome }}">
        <span class="sidebar-identity__avatar-wrap" aria-hidden="true">
            {% include 'components/member_avatar.html.twig' with {
                nome: app.user.nome,
                foto: app.user.avatar,
                size: 'sm',
                class: 'sidebar-identity__avatar'
            } %}
        </span>
        <span class="sidebar-identity__text">
            <span class="sidebar-identity__name">{{ _first_name }}</span>
            {% if empresa is defined and empresa %}
            <span class="sidebar-identity__workspace">{{ org_brand_label|default(empresa.nome) }}</span>
            {% endif %}
        </span>
        <i class="fas fa-chevron-down sidebar-identity__chevron" aria-hidden="true"></i>
    </button>

    <div id="sidebarIdentityPanel"
         class="sidebar-identity-panel"
         role="dialog"
         aria-label="Conta"
         hidden>
        <div class="sidebar-identity-panel__hero">
            <div class="sidebar-identity-panel__hero-bg" aria-hidden="true"></div>
            <div class="sidebar-identity-panel__hero-inner">
                <div class="sidebar-identity-panel__user">
                    <span class="sidebar-identity-panel__avatar-wrap" aria-hidden="true">
                        {% include 'components/member_avatar.html.twig' with {
                            nome: app.user.nome,
                            foto: app.user.avatar,
                            size: 'md',
                            class: 'sidebar-identity-panel__avatar'
                        } %}
                        <span class="sidebar-identity-panel__status"></span>
                    </span>
                    <div class="sidebar-identity-panel__user-meta">
                        <div class="sidebar-identity-panel__user-name">{{ app.user.nome }}</div>
                        <div class="sidebar-identity-panel__user-email">{{ app.user.email }}</div>
                        {% if empresa is defined and empresa %}
                        <div class="sidebar-identity-panel__user-org">
                            <i class="fas fa-dna" aria-hidden="true"></i>
                            <span>{{ org_brand_label|default(empresa.nome) }}{% if not org_brand_label and empresa.setor %} · {{ empresa.setor }}{% endif %}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <nav class="sidebar-identity-panel__nav" aria-label="Menu da conta">
            {% if not organismo.enabled|default(false) and nav_show_plataforma|default(false) %}
            <p class="sidebar-identity-panel__section-label">Conta</p>
            {% if nav_show_plataforma|default(false) %}
            <a class="sidebar-identity-panel__link" href="{{ path('app_admin_empresas') }}">
                <span class="sidebar-identity-panel__link-icon"><i class="fas fa-building" aria-hidden="true"></i></span>
                <span class="sidebar-identity-panel__link-text">Minha empresa</span>
                <i class="fas fa-chevron-right sidebar-identity-panel__link-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if empresas is defined and empresas|length > 1 %}
            <a class="sidebar-identity-panel__link" href="{{ path('app_workspace_select', {force: 1}) }}">
                <span class="sidebar-identity-panel__link-icon"><i class="fas fa-right-left" aria-hidden="true"></i></span>
                <span class="sidebar-identity-panel__link-text">Trocar área de trabalho</span>
                <i class="fas fa-chevron-right sidebar-identity-panel__link-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% endif %}

            <p class="sidebar-identity-panel__section-label">Preferências</p>

            <a class="sidebar-identity-panel__link" href="{{ path('app_profile') }}">
                <span class="sidebar-identity-panel__link-icon"><i class="fas fa-user" aria-hidden="true"></i></span>
                <span class="sidebar-identity-panel__link-text">Meu perfil</span>
                <i class="fas fa-chevron-right sidebar-identity-panel__link-arrow" aria-hidden="true"></i>
            </a>

            <button type="button" class="sidebar-identity-panel__link sidebar-identity-panel__link--btn" onclick="toggleTheme()">
                <span class="sidebar-identity-panel__link-icon"><i class="fas fa-adjust" id="themeMenuIcon" aria-hidden="true"></i></span>
                <span class="sidebar-identity-panel__link-text" id="themeMenuLabel">Tema claro</span>
            </button>
        </nav>

        <div class="sidebar-identity-panel__footer">
            <a class="sidebar-identity-panel__link sidebar-identity-panel__link--danger" href="{{ path('app_logout') }}">
                <span class="sidebar-identity-panel__link-icon"><i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i></span>
                <span class="sidebar-identity-panel__link-text">Sair da conta</span>
            </a>
        </div>
    </div>
</div>
