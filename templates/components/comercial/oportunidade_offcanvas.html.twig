{% embed 'components/unio_offcanvas.html.twig' with {
    id: 'crm-oportunidade-nova',
    title: 'Nova oportunidade',
    subtitle: 'Entrada no funil de vendas',
    icon: 'fa-diagram-project',
    size: 'lg',
    open: open|default(false)
} %}
{% block offcanvas_body %}
<form method="post" action="{{ path('app_comercial_pipeline') }}" id="crmOportunidadeNovaForm" class="crm-form">
    <input type="hidden" name="_token" value="{{ csrf_token('crm_oportunidade_nova') }}">

    <fieldset class="crm-form-section">
        <legend class="crm-form-section__title">Essencial</legend>
        <div class="form-group">
            <label for="crm-op-titulo">Título *</label>
            <input class="form-control" id="crm-op-titulo" name="titulo" required autofocus
                   placeholder="Ex.: Plano Clínica — 3 médicos">
        </div>
        <div class="form-row mb-0">
            <div class="form-group col-md-6 mb-md-0">
                <label for="crm-op-estagio">Estágio no funil</label>
                <select class="form-control" id="crm-op-estagio" name="estagio">
                    {% for s in stages %}
                    <option value="{{ s }}">{{ stage_meta[s].label|default(s) }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group col-md-6 mb-0">
                <label for="crm-op-valor">Valor estimado (R$)</label>
                <input class="form-control" id="crm-op-valor" name="valor" placeholder="0,00" inputmode="decimal">
            </div>
        </div>
    </fieldset>

    <details class="crm-form-advanced">
        <summary>Mais detalhes</summary>
        <div class="crm-form-advanced__body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="crm-op-prob">Probabilidade (%)</label>
                    <input class="form-control" id="crm-op-prob" type="number" min="0" max="100" name="probabilidade" value="20">
                </div>
                <div class="form-group col-md-6">
                    <label for="crm-op-fecha">Fecha prevista</label>
                    <input class="form-control" id="crm-op-fecha" type="date" name="fecha_prevista">
                </div>
            </div>
            <div class="form-group">
                <label for="crm-op-conta">Cliente</label>
                <select class="form-control" id="crm-op-conta" name="conta_id">
                    <option value="">Sem cliente ainda</option>
                    {% for c in contas %}
                    <option value="{{ c.id }}">{{ c.nome }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="crm-op-lead">Lead de origem</label>
                <select class="form-control" id="crm-op-lead" name="lead_id">
                    <option value="">Sem lead</option>
                    {% for l in leads %}
                    <option value="{{ l.id }}">{{ l.nome }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group mb-0">
                <label for="crm-op-notas">Notas</label>
                <textarea class="form-control" id="crm-op-notas" name="notas" rows="3"
                          placeholder="Ex.: proposta enviada; aguardando retorno da coordenação"></textarea>
            </div>
        </div>
    </details>
</form>
{% endblock %}
{% block offcanvas_footer %}
<div class="unio-offcanvas-footer d-flex justify-content-end gap-2">
    <button type="button" class="btn-unio-ghost" data-unio-offcanvas-close>Cancelar</button>
    <button type="submit" form="crmOportunidadeNovaForm" class="btn-unio">Salvar oportunidade</button>
</div>
{% endblock %}
{% endembed %}
