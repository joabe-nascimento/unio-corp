{#
  detail_field_section — bloco de campos (ficha / detalhe)

  Props:
    title (string)
    items (array)  cada item: { label, value, icon?, html?, multiline? }
#}
<div class="huplex-detail-section">
    {% if title is defined and title %}
    <h3 class="huplex-detail-section-title">{{ title }}</h3>
    {% endif %}
    <div class="huplex-detail-list">
        {% for item in items|default([]) %}
            {% include 'components/huplex/detail_field_row.html.twig' with item only %}
        {% endfor %}
    </div>
</div>
