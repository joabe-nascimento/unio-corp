{#
  huplex/file_upload — zona de upload com drag-and-drop (input nativo oculto)

  Props:
    id           (string, obrig.)   id do input file (e do label for)
    name         (string, obrig.)   name do input
    accept       (string, opt)     ex.: .pdf,.jpg,.png
    hint         (string, opt)      texto de formatos/tamanho
    required     (bool, opt)
    compact      (bool, opt)        versão mais baixa para painéis laterais
#}
{% set _id = id %}
{% set _hint = hint|default('PDF, JPG, PNG ou DOC — máx. 10 MB') %}
<div class="huplex-file-upload{% if compact|default(false) %} huplex-file-upload--compact{% endif %}"
     data-huplex-file-upload>
    <input type="file"
           id="{{ _id }}"
           name="{{ name }}"
           class="huplex-file-upload-input"
           {% if accept is defined and accept %}accept="{{ accept }}"{% endif %}
           {% if required|default(false) %}required{% endif %}>
    <label class="huplex-file-upload-drop" for="{{ _id }}">
        <span class="huplex-file-upload-icon" aria-hidden="true">
            <i class="fas fa-cloud-arrow-up"></i>
        </span>
        <span class="huplex-file-upload-text">
            <span class="huplex-file-upload-label">Clique ou arraste o arquivo</span>
            <span class="huplex-file-upload-hint">{{ _hint }}</span>
        </span>
    </label>
    <div class="huplex-file-upload-preview" hidden>
        <span class="huplex-file-upload-preview-icon" aria-hidden="true">
            <i class="fas fa-file-lines"></i>
        </span>
        <span class="huplex-file-upload-preview-name" data-file-name></span>
        <button type="button" class="huplex-file-upload-clear" data-file-clear aria-label="Remover arquivo">
            <i class="fas fa-xmark"></i>
        </button>
    </div>
</div>
