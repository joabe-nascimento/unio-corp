<header class="clinic-home-hero-compact" aria-label="Resumo do dia">
    <div class="clinic-home-hero-compact__meta">
        <span>{{ weekday|default('') }}{% if weekday is defined and weekday %}, {% endif %}{{ date_label|default('') }}</span>
        <span class="clinic-home-hero-compact__sep" aria-hidden="true">·</span>
        <span id="clinicDashClock">{{ time_label|default('') }}</span>
    </div>
    <h1 class="clinic-home-hero-compact__title">Painel do dia</h1>
    <p class="clinic-home-hero-compact__desc">{{ organismo.copy.brand_slogan|default('Saúde que acompanha.') }}</p>
</header>
