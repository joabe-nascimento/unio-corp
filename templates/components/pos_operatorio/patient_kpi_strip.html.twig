{#
  KPIs do paciente — pós-operatório / clínica
  variant: full (página) | offcanvas (painel lateral)
#}
{% set _variant = variant|default('full') %}
{% set _status_variant = paciente.status == 'alerta' ? 'danger' : (paciente.status == 'pendente' or paciente.status == 'encerrado' ? 'muted' : 'success') %}
{% set _score_variant = ultima_resposta and ultima_resposta.scoreRisco >= 70 ? 'danger' : (ultima_resposta and ultima_resposta.scoreRisco >= 40 ? 'warning' : '') %}
{% set _status_label = paciente.status|pos_op_status_label %}
{% set _dia_kpi = dia_relativo_label|default(dia_pos is not null ? 'D+' ~ dia_pos : null) %}
{% set _proximo_val = proximo_checklist ? (proximo_checklist.dia_label|default(proximo_checklist.dia < 0 ? 'D−' ~ (proximo_checklist.dia|abs) : 'D+' ~ proximo_checklist.dia)) : 'Concluído' %}
{% set _proximo_sub = proximo_checklist ? proximo_checklist.item : 'Protocolo em dia' %}
{% if _variant == 'offcanvas' and _proximo_sub|length > 28 %}
    {% set _proximo_sub = _proximo_sub|slice(0, 26) ~ '…' %}
{% endif %}

{% set _items = [
    {
        value: _dia_kpi|default('—'),
        label: is_pre_op|default(false) ? (_variant == 'offcanvas' ? 'Pré-op' : 'Dia pré-op') : (_variant == 'offcanvas' ? 'Pós-op' : 'Dia pós-op'),
        label_title: is_pre_op|default(false) ? 'Dia pré-operatório' : 'Dia pós-operatório',
        icon: 'fa-calendar-day',
        tone: 'sky'
    },
    {
        value: alertas_abertos,
        label: _variant == 'offcanvas' ? 'Alertas' : 'Alertas abertos',
        label_title: 'Alertas abertos',
        icon: 'fa-triangle-exclamation',
        tone: 'rose',
        variant: alertas_abertos > 0 ? 'danger' : '',
        pulse: alertas_abertos > 0
    }
] %}

{% if _variant == 'full' %}
    {% set _items = _items|merge([{
        label: 'Status clínico',
        icon: 'fa-heart-pulse',
        tone: 'sage',
        value_html: '<span class="org-kpi-badge org-kpi-badge--' ~ _status_variant ~ '">' ~ _status_label ~ '</span>'
    }, {
        value: ultima_resposta ? ultima_resposta.scoreRisco : '—',
        label: 'Último score',
        icon: 'fa-chart-line',
        tone: 'lavender',
        variant: _score_variant
    }]) %}
{% else %}
    {% set _items = _items|merge([{
        value: ultima_resposta ? ultima_resposta.scoreRisco : '—',
        label: 'Score',
        label_title: 'Último score de risco',
        icon: 'fa-chart-line',
        tone: 'lavender',
        variant: _score_variant
    }, {
        value: _proximo_val,
        label: 'Próximo',
        label_title: 'Próximo passo do protocolo',
        icon: 'fa-shoe-prints',
        tone: 'teal',
        sub: _proximo_sub,
        sub_title: _proximo_sub
    }]) %}
{% endif %}

{% include 'components/org_kpi_strip.html.twig' with {
    layout: layout|default(_variant == 'offcanvas' ? 'compact' : 'strip'),
    class: (class|default('')) ~ (_variant == 'offcanvas' ? ' org-kpi-strip--ficha' : ''),
    items: _items
} %}
