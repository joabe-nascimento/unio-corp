{# pos_operatorio/hub_hero — banner principal do hub Pós-Operatório (layout rh-hub-hero) #}
<section class="rh-hub-hero unio-card pos-op-hub-hero mb-4" aria-label="Resumo do núcleo">
    <div class="rh-hub-hero-bg" aria-hidden="true"></div>
    <div class="rh-hub-hero-inner rh-hub-hero-inner--banner">
        <div class="rh-hub-hero-copy">
            <p class="rh-hub-hero-eyebrow">
                <i class="fas fa-building mr-1" aria-hidden="true"></i>
                {{ empresa.nome }}
            </p>
            <h2 class="rh-hub-hero-title">Núcleo Pós-Operatório</h2>
            {% include 'components/pos_operatorio/hub_ticker_carousel.html.twig' with { pos_ticker: pos_ticker|default([]) } %}
        </div>
        <aside class="rh-hub-hero-aside" aria-label="Pulse clínico">
            {% include 'components/rh/hub_pulse_widget.html.twig' with { rh_pulse: pos_pulse, variant: 'hero' } %}
        </aside>
    </div>
    {% include 'components/pos_operatorio/hub_vitoria_copilot.html.twig' with { vitoria_insight: vitoria_insight|default({}) } %}
</section>
