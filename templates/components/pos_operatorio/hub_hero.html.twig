{# Banner principal — Unio Clínica / pós-operatório #}
<section class="rh-hub-hero unio-card pos-op-hub-hero mb-4" aria-label="Resumo clínico">
    <div class="rh-hub-hero-bg" aria-hidden="true"></div>
    <div class="rh-hub-hero-inner rh-hub-hero-inner--banner">
        <div class="rh-hub-hero-copy">
            <p class="rh-hub-hero-eyebrow">
                <i class="fas fa-house-medical mr-1" aria-hidden="true"></i>
                {{ org_clinic|default(false) ? org_brand_label|default('Unio Clínica') : (org_brand_label|default(empresa.nome|default('Unio'))) }}
            </p>
            <h2 class="rh-hub-hero-title">{{ org_clinic|default(false) ? organismo.copy.hub_hero_title|default('Painel de projetos') : 'Pós-operatório' }}</h2>
            {% include 'components/pos_operatorio/hub_ticker_carousel.html.twig' with { pos_ticker: pos_ticker|default([]) } %}
        </div>
        <aside class="rh-hub-hero-aside" aria-label="Pulse clínico">
            {% include 'components/rh/hub_pulse_widget.html.twig' with { rh_pulse: pos_pulse, variant: 'hero' } %}
        </aside>
    </div>
</section>
