{# Fundo geométrico inset — reutilizável (welcome, dashboard, hubs) #}
{% set _gid = geo_id|default('inset') %}
<svg class="inset-geo-bg" viewBox="0 0 1440 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
        <pattern id="{{ _gid }}-dots" width="24" height="24" patternUnits="userSpaceOnUse">
            <circle cx="1.2" cy="1.2" r="0.95" class="inset-geo-dot"/>
        </pattern>
        <pattern id="{{ _gid }}-grid" width="72" height="72" patternUnits="userSpaceOnUse">
            <path d="M 72 0 L 0 0 0 72" fill="none" class="inset-geo-grid-line"/>
        </pattern>
        <linearGradient id="{{ _gid }}-accent-a" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" class="inset-geo-accent-stop-a"/>
            <stop offset="100%" class="inset-geo-accent-stop-b"/>
        </linearGradient>
        <linearGradient id="{{ _gid }}-accent-b" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" class="inset-geo-accent-stop-c"/>
            <stop offset="100%" class="inset-geo-accent-stop-b"/>
        </linearGradient>
        <radialGradient id="{{ _gid }}-glow-primary" cx="14%" cy="6%" r="58%">
            <stop offset="0%" class="inset-geo-glow-stop-a"/>
            <stop offset="100%" class="inset-geo-glow-stop-b"/>
        </radialGradient>
        <radialGradient id="{{ _gid }}-glow-secondary" cx="92%" cy="18%" r="42%">
            <stop offset="0%" class="inset-geo-glow-stop-c"/>
            <stop offset="100%" class="inset-geo-glow-stop-b"/>
        </radialGradient>
        <filter id="{{ _gid }}-blur-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="28" result="blur"/>
            <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>
    </defs>

    <g class="inset-geo-glow-layer">
        <rect width="1440" height="900" fill="url(#{{ _gid }}-glow-primary)"/>
        <rect width="1440" height="900" fill="url(#{{ _gid }}-glow-secondary)" opacity="0.75"/>
    </g>

    <rect width="1440" height="900" fill="url(#{{ _gid }}-grid)" opacity="0.35" class="inset-geo-grid"/>
    <rect width="1440" height="900" fill="url(#{{ _gid }}-dots)" opacity="0.9" class="inset-geo-dots-layer"/>

    <g class="inset-geo-shapes" fill="none" stroke-width="1">
        <path d="M 1080 120 L 1168 208 L 1080 296 L 992 208 Z" class="inset-geo-stroke inset-geo-shape inset-geo-shape--a"/>
        <rect x="148" y="36" width="136" height="84" rx="12" transform="rotate(-14 216 78)" class="inset-geo-stroke inset-geo-shape inset-geo-shape--b"/>
        <path d="M 700 72 L 744 72 L 766 110 L 744 148 L 700 148 L 678 110 Z" class="inset-geo-stroke inset-geo-shape inset-geo-shape--c"/>
        <circle cx="1260" cy="300" r="46" class="inset-geo-stroke inset-geo-shape inset-geo-shape--d"/>
        <path d="M 1320 88 L 1388 88 L 1354 42 Z" class="inset-geo-stroke inset-geo-shape inset-geo-shape--e"/>
        <line x1="0" y1="200" x2="420" y2="0" class="inset-geo-line inset-geo-line--a"/>
        <line x1="780" y1="0" x2="1440" y2="160" class="inset-geo-line inset-geo-line--b"/>
        <line x1="1440" y1="240" x2="900" y2="0" class="inset-geo-line inset-geo-line--c"/>
        <line x1="40" y1="400" x2="360" y2="400" class="inset-geo-line inset-geo-line--soft"/>
        <path d="M 520 320 L 620 280 L 720 320 L 620 360 Z" class="inset-geo-stroke inset-geo-shape inset-geo-shape--f" opacity="0.55"/>
    </g>

    <g class="inset-geo-network" stroke-width="1">
        <line x1="290" y1="118" x2="420" y2="178" class="inset-geo-network-line"/>
        <line x1="420" y1="178" x2="680" y2="64" class="inset-geo-network-line"/>
        <line x1="680" y1="64" x2="1180" y2="94" class="inset-geo-network-line inset-geo-network-line--long"/>
        <line x1="1180" y1="94" x2="1320" y2="278" class="inset-geo-network-line"/>
    </g>

    <g class="inset-geo-nodes">
        <circle cx="1180" cy="94" r="3.2" class="inset-geo-node inset-geo-node--pulse"/>
        <circle cx="290" cy="118" r="2.6" class="inset-geo-node"/>
        <circle cx="420" cy="178" r="2" class="inset-geo-node"/>
        <circle cx="680" cy="64" r="2.4" class="inset-geo-node inset-geo-node--accent inset-geo-node--pulse"/>
        <circle cx="1320" cy="278" r="2.6" class="inset-geo-node"/>
        <circle cx="900" cy="48" r="1.8" class="inset-geo-node inset-geo-node--accent"/>
    </g>

    <ellipse cx="200" cy="520" rx="180" ry="120" fill="url(#{{ _gid }}-accent-a)" opacity="0.45" filter="url(#{{ _gid }}-blur-soft)" class="inset-geo-orb inset-geo-orb--a"/>
    <ellipse cx="1240" cy="440" rx="140" ry="100" fill="url(#{{ _gid }}-accent-b)" opacity="0.35" filter="url(#{{ _gid }}-blur-soft)" class="inset-geo-orb inset-geo-orb--b"/>
</svg>
