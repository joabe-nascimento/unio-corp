{# KPIs da ficha do paciente — perfil clínica #}
<div class="clinic-ficha-page-kpis" aria-label="Indicadores do paciente">
    <article class="clinic-metric">
        <span class="clinic-metric__label">Dia pós-op</span>
        <span class="clinic-metric__value">{{ dia_pos is not null ? 'D+' ~ dia_pos : '—' }}</span>
    </article>
    <article class="clinic-metric">
        <span class="clinic-metric__label">Alertas abertos</span>
        <span class="clinic-metric__value{% if alertas_abertos > 0 %} clinic-metric__value--danger{% endif %}">{{ alertas_abertos }}</span>
    </article>
    <article class="clinic-metric">
        <span class="clinic-metric__label">Status clínico</span>
        <span class="clinic-metric__value clinic-metric__value--compact">
            <span class="clinic-status clinic-status--{% if paciente.status == 'alerta' %}danger{% elseif paciente.status == 'pendente' %}muted{% elseif paciente.status == 'encerrado' %}muted{% else %}success{% endif %}">
                {{ paciente.status|pos_op_status_label }}
            </span>
        </span>
    </article>
    <article class="clinic-metric">
        <span class="clinic-metric__label">Último score</span>
        <span class="clinic-metric__value{% if ultima_resposta and ultima_resposta.scoreRisco >= 70 %} clinic-metric__value--danger{% elseif ultima_resposta and ultima_resposta.scoreRisco >= 40 %} clinic-metric__value--warning{% endif %}">
            {{ ultima_resposta ? ultima_resposta.scoreRisco : '—' }}
        </span>
    </article>
</div>
