{#
  section_header — cabeçalho de seção reutilizável
  Props:
    title       (string)       título principal
    subtitle    (string, opt)  subtítulo descritivo
    btn_label   (string, opt)  texto do botão de ação
    btn_href    (string, opt)  href do botão (url ou path já resolvido)
    btn_icon    (string, opt)  ícone FA, ex: 'fa-plus'
    btn_ghost   (bool, opt)    true para estilo ghost. Default: false

  Uso:
    {% include 'components/section_header.html.twig' with {
        title: 'Funcionários',
        subtitle: 'Quadro de colaboradores',
        btn_label: 'Novo Funcionário',
        btn_href: path('app_rh_funcionarios'),
        btn_icon: 'fa-plus'
    } %}
#}
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="section-title">{{ title }}</div>
        {% if subtitle is defined and subtitle %}
            <div class="section-subtitle">{{ subtitle }}</div>
        {% endif %}
    </div>
    {% if btn_label is defined and btn_label %}
        <a href="{{ btn_href|default('#') }}"
           class="{{ btn_ghost|default(false) ? 'btn-huplex-ghost' : 'btn-huplex' }}">
            {% if btn_icon is defined and btn_icon %}
                <i class="fas {{ btn_icon }} mr-1"></i>
            {% endif %}
            {{ btn_label }}
        </a>
    {% endif %}
</div>
