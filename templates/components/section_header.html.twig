{#
  section_header — título de seção dentro de card (sem ações/filtros)

  Props:
    title       (string)
    subtitle    (string, opt)
    btn_label   (string, opt)  botão à direita (uso simples)
    btn_href    (string, opt)
    btn_icon    (string, opt)
    btn_ghost   (bool, opt)
#}
<div class="section-header section-header--in-card">
    <div class="section-header-text">
        <div class="section-title">{{ title }}</div>
        {% if subtitle is defined and subtitle %}
            <div class="section-subtitle">{{ subtitle }}</div>
        {% endif %}
    </div>
    {% if btn_label is defined and btn_label %}
        <a href="{{ btn_href|default('#') }}"
           class="section-header-action {{ btn_ghost|default(false) ? 'btn-unio-ghost' : 'btn-unio' }}">
            {% if btn_icon is defined and btn_icon %}
                <i class="fas {{ btn_icon }} mr-1"></i>
            {% endif %}
            {{ btn_label }}
        </a>
    {% endif %}
</div>
