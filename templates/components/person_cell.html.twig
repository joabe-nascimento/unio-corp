{#
  person_cell — nome + linha secundária (e-mail, cargo, etc.)

  Props:
    name      (string)
    subtitle  (string, opt)
#}
<div class="person-cell">
    <div class="person-cell-name">{{ name }}</div>
    {% if subtitle is defined and subtitle %}
        <div class="person-cell-sub">{{ subtitle }}</div>
    {% endif %}
</div>
