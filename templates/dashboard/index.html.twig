{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Dashboard</li>{% endblock %}

{% block stylesheets %}
<style>
.stat-card { display:flex;align-items:center;gap:14px; }
.banner-info {
    background: var(--accent-dim);
    border: 1px solid var(--accent-line);
    border-radius: 10px; padding: 14px 18px;
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 20px;
}
.banner-icon {
    width: 36px; height: 36px; border-radius: 8px;
    background: var(--accent-dim); border: 1px solid var(--accent-line);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); font-size: 14px; flex-shrink: 0;
}
.banner-title { color: var(--text-1); font-weight: 600; font-size: 13px; }
.banner-sub   { color: var(--text-2); font-size: 12px; margin-top: 1px; }

.module-item {
    display: flex; align-items: center; gap: 12px;
    background: var(--surface-2); border: 1px solid var(--border);
    border-radius: 9px; padding: 12px 14px;
    transition: border-color 0.15s, background 0.15s;
    text-decoration: none;
}
.module-item:hover {
    border-color: var(--accent-line);
    background: var(--accent-dim);
    text-decoration: none;
}
.module-item .mi-icon {
    width: 36px; height: 36px; border-radius: 8px;
    background: var(--accent-dim); border: 1px solid var(--accent-line);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); font-size: 14px; flex-shrink: 0;
}
.module-item .mi-title { color: var(--text-1); font-size: 13px; font-weight: 600; line-height: 1.3; }
.module-item .mi-sub   { color: var(--text-3); font-size: 11px; margin-top: 1px; }
.module-item .mi-arrow { color: var(--text-3); font-size: 10px; margin-left: auto; flex-shrink: 0; }

.perm-row { display:flex;align-items:center;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--border); }
.perm-row:last-child { border-bottom: none; }
.perm-label { color: var(--text-2); font-size: 12px; }
.perm-yes { color: #42b883; font-size: 12px; }
.perm-no  { color: var(--text-3); font-size: 11px; }

.empresa-box {
    background: var(--accent-dim); border: 1px solid var(--accent-line);
    border-radius: 8px; padding: 10px 13px;
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 16px;
}
.empresa-box .eb-name { color: var(--text-1); font-size: 12px; font-weight: 600; }
.empresa-box .eb-setor { color: var(--text-3); font-size: 11px; }
</style>
{% endblock %}

{% block content %}

{# ── Banner por perfil ── #}
{% if layout == 'admin' %}
<div class="banner-info">
    <div class="banner-icon"><i class="fas fa-shield-halved"></i></div>
    <div>
        <div class="banner-title">Visão Administrativa{% if is_granted('ROLE_TENANT') %} · Multi-empresa{% endif %}</div>
        <div class="banner-sub">Acesso total à plataforma{{ empresa ? ' — ' ~ empresa.nome : '' }}</div>
    </div>
</div>
{% elseif layout == 'gestor' %}
<div class="banner-info">
    <div class="banner-icon"><i class="fas fa-chart-pie"></i></div>
    <div>
        <div class="banner-title">Visão do Gestor{{ empresa ? ' — ' ~ empresa.nome : '' }}</div>
        <div class="banner-sub">Dados consolidados da empresa</div>
    </div>
</div>
{% elseif layout == 'supervisor' %}
<div class="banner-info">
    <div class="banner-icon"><i class="fas fa-user-group"></i></div>
    <div>
        <div class="banner-title">Sua Equipe{{ empresa ? ' — ' ~ empresa.nome : '' }}</div>
        <div class="banner-sub">Colaboradores sob sua supervisão</div>
    </div>
</div>
{% endif %}

{# ── Stats ── #}
<div class="row mb-4">
    {% if layout == 'admin' %}
        {% set cards = [
            {icon:'fa-users',          v: stats.funcionarios,  l:'Funcionários'},
            {icon:'fa-sitemap',        v: stats.departamentos, l:'Departamentos'},
            {icon:'fa-briefcase',      v: stats.vagas_abertas, l:'Vagas Abertas'},
            {icon:'fa-graduation-cap', v: stats.treinamentos,  l:'Treinamentos'},
            {icon:'fa-user-shield',    v: stats.usuarios,      l:'Usuários'},
            {icon:'fa-building',       v: stats.empresas,      l:'Empresas'},
        ] %}
        {% for c in cards %}
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="huplex-card stat-card">
                <div class="card-icon"><i class="fas {{ c.icon }}"></i></div>
                <div><div class="card-value">{{ c.v }}</div><div class="card-label">{{ c.l }}</div></div>
            </div>
        </div>
        {% endfor %}
    {% elseif layout == 'membro' %}
        <div class="col-12 mb-3">
            <div class="huplex-card d-flex align-items-center gap-3" style="gap:14px">
                <div class="avatar-circle" style="width:52px;height:52px;font-size:18px;border-radius:13px;flex-shrink:0">{{ app.user.initials }}</div>
                <div>
                    <div style="color:var(--text-1);font-weight:700;font-size:16px">Olá, {{ app.user.nome }}</div>
                    <div style="margin-top:4px"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span>{% if empresa %}<span style="color:var(--text-3);font-size:12px;margin-left:8px">{{ empresa.nome }}</span>{% endif %}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="huplex-card stat-card">
                <div class="card-icon"><i class="fas fa-graduation-cap"></i></div>
                <div><div class="card-value">{{ stats.treinamentos }}</div><div class="card-label">Treinamentos</div></div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="huplex-card stat-card">
                <div class="card-icon"><i class="fas fa-chart-bar"></i></div>
                <div><div class="card-value">{{ stats.avaliacoes }}</div><div class="card-label">Avaliações</div></div>
            </div>
        </div>
    {% else %}
        {% set cards = [
            {icon:'fa-users',          v: stats.funcionarios,  l:'Funcionários'},
            {icon:'fa-sitemap',        v: stats.departamentos, l:'Departamentos'},
            {icon:'fa-briefcase',      v: stats.vagas_abertas, l:'Vagas'},
            {icon:'fa-graduation-cap', v: stats.treinamentos,  l:'Treinamentos'},
        ] %}
        {% for c in cards %}
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="huplex-card stat-card">
                <div class="card-icon"><i class="fas {{ c.icon }}"></i></div>
                <div><div class="card-value">{{ c.v }}</div><div class="card-label">{{ c.l }}</div></div>
            </div>
        </div>
        {% endfor %}
    {% endif %}
</div>

{# ── Módulos + painel ── #}
<div class="row">
    <div class="col-md-8 mb-4">
        <div class="huplex-card">
            <div class="mb-4">
                <div class="section-title">Módulos da Plataforma</div>
                <div class="section-subtitle">Acesso rápido às funcionalidades</div>
            </div>
            <div class="row">
                {% set modules = [
                    {icon:'fa-id-card',      title:'Recursos Humanos',  sub:'Funcionários e folha',    route:'app_rh',         role:'ROLE_SUPERVISOR_EQUIPE'},
                    {icon:'fa-users',        title:'Gestão de Pessoas', sub:'Equipes e organograma',   route:'app_pessoas',    role:'ROLE_SUPERVISOR_EQUIPE'},
                    {icon:'fa-gem',          title:'Hub de Talentos',   sub:'Banco, vagas e trilhas',  route:'app_talentos',   role:'ROLE_GESTOR_EQUIPE'},
                    {icon:'fa-chart-line',   title:'Hub de Maturidade', sub:'Radar e plano de ação',   route:'app_maturidade', role:'ROLE_GESTOR_EQUIPE'},
                    {icon:'fa-cog',          title:'Administração',     sub:'Usuários e configurações',route:'app_admin',      role:'ROLE_ADMIN'},
                ] %}
                {% for m in modules %}{% if is_granted(m.role) %}
                <div class="col-md-6 mb-3">
                    <a href="{{ path(m.route) }}" class="module-item">
                        <div class="mi-icon"><i class="fas {{ m.icon }}"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="mi-title">{{ m.title }}</div>
                            <div class="mi-sub">{{ m.sub }}</div>
                        </div>
                        <i class="fas fa-chevron-right mi-arrow"></i>
                    </a>
                </div>
                {% endif %}{% endfor %}
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="huplex-card">
            <div class="section-title mb-1">Meu Acesso</div>
            <div class="section-subtitle mb-3">Nível de permissão atual</div>

            <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle" style="width:46px;height:46px;font-size:15px;border-radius:12px;flex-shrink:0">{{ app.user.initials }}</div>
                <div class="ml-3">
                    <div style="color:var(--text-1);font-weight:600;font-size:13px;line-height:1.3">{{ app.user.nome }}</div>
                    <div style="color:var(--text-3);font-size:11px">{{ app.user.email }}</div>
                    <div class="mt-1"><span class="badge-perfil {{ app.user.perfilClass }}">{{ app.user.perfilLabel }}</span></div>
                </div>
            </div>

            {% if empresa %}
            <div class="empresa-box">
                <i class="fas fa-building" style="color:var(--accent);font-size:13px"></i>
                <div>
                    <div class="eb-name">{{ empresa.nome }}</div>
                    {% if empresa.setor %}<div class="eb-setor">{{ empresa.setor }}</div>{% endif %}
                </div>
            </div>
            {% endif %}

            <div style="font-size:10px;color:var(--text-3);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px">Permissões</div>
            {% set perms = [
                {l:'Dashboard',           g: is_granted('ROLE_USER')},
                {l:'RH & Pessoas',        g: is_granted('ROLE_SUPERVISOR_EQUIPE')},
                {l:'Visão global RH',     g: is_granted('ROLE_SUPERVISOR')},
                {l:'Hub Talentos',        g: is_granted('ROLE_GESTOR_EQUIPE')},
                {l:'Hub Talentos total',  g: is_granted('ROLE_GESTOR')},
                {l:'Hub Maturidade',      g: is_granted('ROLE_GESTOR_EQUIPE')},
                {l:'Administração',       g: is_granted('ROLE_ADMIN')},
                {l:'Multi-empresa',       g: is_granted('ROLE_TENANT')},
            ] %}
            {% for p in perms %}
            <div class="perm-row">
                <span class="perm-label">{{ p.l }}</span>
                {% if p.g %}<i class="fas fa-check-circle perm-yes"></i>{% else %}<i class="fas fa-lock perm-no"></i>{% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}