{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Dashboard</li>{% endblock %}

{% block content %}

{# ── Cards de stats ── #}
<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="huplex-card d-flex align-items-center gap-3">
            <div class="card-icon"><i class="fas fa-users"></i></div>
            <div class="ml-3">
                <div class="card-value">{{ stats.funcionarios }}</div>
                <div class="card-label">Funcionários Ativos</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="huplex-card d-flex align-items-center">
            <div class="card-icon" style="background:rgba(139,92,246,0.1);border-color:rgba(139,92,246,0.2);color:#8b5cf6">
                <i class="fas fa-sitemap"></i>
            </div>
            <div class="ml-3">
                <div class="card-value">{{ stats.departamentos }}</div>
                <div class="card-label">Departamentos</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="huplex-card d-flex align-items-center">
            <div class="card-icon" style="background:rgba(234,179,8,0.1);border-color:rgba(234,179,8,0.2);color:#eab308">
                <i class="fas fa-briefcase"></i>
            </div>
            <div class="ml-3">
                <div class="card-value">{{ stats.vagas_abertas }}</div>
                <div class="card-label">Vagas Abertas</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="huplex-card d-flex align-items-center">
            <div class="card-icon" style="background:rgba(34,197,94,0.1);border-color:rgba(34,197,94,0.2);color:#22c55e">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="ml-3">
                <div class="card-value">{{ stats.treinamentos }}</div>
                <div class="card-label">Treinamentos Ativos</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    {# ── Módulos de acesso rápido ── #}
    <div class="col-md-8 mb-4">
        <div class="huplex-card">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <div class="section-title">Módulos da Plataforma</div>
                    <div class="section-subtitle">Acesso rápido às funcionalidades</div>
                </div>
            </div>
            <div class="row">
                {% set modules = [
                    { icon: 'fas fa-users',      title: 'RH',               sub: 'Funcionários e folha',     route: 'app_rh',         color: '#3D72FF', role: 'ROLE_SUPERVISOR' },
                    { icon: 'fas fa-sitemap',     title: 'Gest. de Pessoas', sub: 'Equipes e organograma',   route: 'app_pessoas',    color: '#8b5cf6', role: 'ROLE_SUPERVISOR' },
                    { icon: 'fas fa-star',        title: 'Hub de Talentos',  sub: 'Banco e trilhas',          route: 'app_talentos',   color: '#eab308', role: 'ROLE_GESTOR' },
                    { icon: 'fas fa-chart-line',  title: 'Hub Maturidade',   sub: 'Radar e plano de ação',   route: 'app_maturidade', color: '#22c55e', role: 'ROLE_GESTOR' },
                ] %}
                {% for m in modules %}
                    {% if is_granted(m.role) %}
                    <div class="col-md-6 mb-3">
                        <a href="{{ path(m.route) }}" class="d-block text-decoration-none">
                            <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:18px 20px;transition:all 0.2s"
                                 onmouseover="this.style.borderColor='rgba(61,114,255,0.22)';this.style.background='rgba(61,114,255,0.04)'"
                                 onmouseout="this.style.borderColor='rgba(255,255,255,0.06)';this.style.background='rgba(255,255,255,0.02)'">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width:40px;height:40px;border-radius:9px;background:{{ m.color }}18;border:1px solid {{ m.color }}30;display:flex;align-items:center;justify-content:center;color:{{ m.color }};font-size:16px;flex-shrink:0">
                                        <i class="{{ m.icon }}"></i>
                                    </div>
                                    <div class="ml-2">
                                        <div style="color:#fff;font-size:13px;font-weight:600">{{ m.title }}</div>
                                        <div style="color:rgba(255,255,255,0.3);font-size:11px">{{ m.sub }}</div>
                                    </div>
                                    <i class="fas fa-chevron-right ml-auto" style="color:rgba(255,255,255,0.15);font-size:11px"></i>
                                </div>
                            </div>
                        </a>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    {# ── Painel do usuário ── #}
    <div class="col-md-4 mb-4">
        <div class="huplex-card">
            <div class="section-title mb-1">Meu Acesso</div>
            <div class="section-subtitle mb-4">Nível de permissão atual</div>

            <div class="d-flex align-items-center mb-4">
                <div class="avatar-circle" style="width:52px;height:52px;font-size:18px;border-radius:14px">
                    {{ app.user.initials }}
                </div>
                <div class="ml-3">
                    <div style="color:#fff;font-weight:600;font-size:14px">{{ app.user.nome }}</div>
                    <div style="color:rgba(255,255,255,0.3);font-size:12px">{{ app.user.email }}</div>
                    <div class="mt-1">
                        <span class="badge-perfil {{ app.user.perfil|lower }}">{{ app.user.perfilLabel }}</span>
                    </div>
                </div>
            </div>

            <div style="border-top:1px solid rgba(255,255,255,0.06);padding-top:16px">
                <div style="font-size:11px;color:rgba(255,255,255,0.2);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:10px">Permissões</div>
                {% set perms = [
                    { label: 'Dashboard',        granted: is_granted('ROLE_USER') },
                    { label: 'RH & Pessoas',     granted: is_granted('ROLE_SUPERVISOR') },
                    { label: 'Hub de Talentos',  granted: is_granted('ROLE_GESTOR') },
                    { label: 'Hub Maturidade',   granted: is_granted('ROLE_GESTOR') },
                    { label: 'Administração',    granted: is_granted('ROLE_ADMIN') },
                    { label: 'Visão Tenant',     granted: is_granted('ROLE_TENANT') },
                ] %}
                {% for perm in perms %}
                <div class="d-flex align-items-center justify-content-between py-1">
                    <span style="color:rgba(255,255,255,0.4);font-size:12px">{{ perm.label }}</span>
                    {% if perm.granted %}
                        <i class="fas fa-check-circle" style="color:#22c55e;font-size:12px"></i>
                    {% else %}
                        <i class="fas fa-lock" style="color:rgba(255,255,255,0.12);font-size:11px"></i>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
