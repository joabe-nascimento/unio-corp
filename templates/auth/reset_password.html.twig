<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova senha | Unio</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap">
    {% include 'auth/_guest_auth_styles.html.twig' %}
</head>
<body>
<div class="guest-auth-card">
    <div class="brand-name">Uni<em>o</em></div>
    <h1>Nova senha</h1>
    <p class="sub">Defina uma nova senha para <strong>{{ email }}</strong></p>

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        <div class="form-row-cols">
            <div class="form-group">
                <label class="form-label" for="{{ form.plainPassword.first.vars.id }}">Nova senha</label>
                {{ form_widget(form.plainPassword.first, { attr: { class: 'form-control' } }) }}
            </div>
            <div class="form-group">
                <label class="form-label" for="{{ form.plainPassword.second.vars.id }}">Confirmar</label>
                {{ form_widget(form.plainPassword.second, { attr: { class: 'form-control' } }) }}
            </div>
        </div>
        {% if form.plainPassword.vars.errors|length %}
            <span class="invalid-feedback d-block mb-3">{{ form.plainPassword.vars.errors[0].message }}</span>
        {% endif %}
        <button type="submit" class="btn-primary">Salvar nova senha</button>
    {{ form_end(form) }}

    <p class="guest-auth-back"><a href="{{ path('app_login') }}">← Voltar ao login</a></p>
</div>
</body>
</html>
