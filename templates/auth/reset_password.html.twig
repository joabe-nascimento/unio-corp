{% extends 'auth/_guest_auth_base.html.twig' %}

{% block guest_title %}Nova senha{% endblock %}

{% block guest_content %}
    <h1>Nova senha</h1>
    <p class="sub">Defina uma nova senha para <strong>{{ email }}</strong></p>

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        <div class="form-row-cols">
            <div class="form-group">
                <label class="form-label" for="{{ form.plainPassword.first.vars.id }}">Nova senha</label>
                {{ form_widget(form.plainPassword.first, { attr: { class: 'form-control' } }) }}
            </div>
            <div class="form-group">
                <label class="form-label" for="{{ form.plainPassword.second.vars.id }}">Confirmar</label>
                {{ form_widget(form.plainPassword.second, { attr: { class: 'form-control' } }) }}
            </div>
        </div>
        {% if form.plainPassword.vars.errors|length %}
            <span class="invalid-feedback d-block mb-3">{{ form.plainPassword.vars.errors[0].message }}</span>
        {% endif %}
        <button type="submit" class="btn-primary">Salvar nova senha</button>
    {{ form_end(form) }}

    <p class="guest-auth-back">
        <a href="{{ path('app_login') }}">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Voltar ao login
        </a>
    </p>
{% endblock %}
