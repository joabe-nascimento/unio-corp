<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body.guest-auth-page {
        background: var(--bg, #0A0E18);
        font-family: 'Quicksand', 'Nunito', system-ui, sans-serif;
        min-height: 100vh;
        min-height: 100dvh;
        color: var(--text-1, #E8ECF4);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .guest-auth-page__inner {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .guest-auth-card {
        width: 100%;
        max-width: 420px;
        background: var(--surface, #0E1320);
        border: 1px solid var(--border, rgba(255, 255, 255, 0.06));
        border-radius: 16px;
        padding: 40px 36px;
        box-shadow: var(--inset-panel-shadow, 0 1px 3px rgba(0, 0, 0, 0.22));
    }

    [data-theme="light"] .guest-auth-card {
        box-shadow: 0 8px 32px rgba(15, 23, 42, 0.08);
    }

    .guest-auth-logo {
        width: 100%;
        max-width: 200px;
        margin: 0 auto 24px;
        line-height: 0;
        text-align: center;
    }

    .guest-auth-logo__img,
    .guest-auth-logo img,
    .guest-auth-logo object,
    .guest-auth-logo svg,
    .guest-auth-logo .platform-logo-placeholder-wrap {
        display: block;
        width: 100%;
        height: auto;
        max-height: 72px;
        margin-inline: auto;
        object-fit: contain;
    }

    .guest-auth-card h1 {
        color: var(--text-1, #E8ECF4);
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: -0.02em;
    }

    .guest-auth-card .sub {
        color: var(--text-3, rgba(232, 236, 244, 0.4));
        font-size: 13px;
        line-height: 1.5;
        margin-bottom: 24px;
    }

    .guest-auth-card .sub strong {
        color: var(--text-2, rgba(232, 236, 244, 0.62));
        font-weight: 600;
    }

    .form-group { margin-bottom: 14px; }

    .form-label {
        color: var(--text-3, rgba(232, 236, 244, 0.4));
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: block;
        margin-bottom: 5px;
    }

    .form-control {
        background: var(--surface-2, #121828);
        border: 1px solid var(--border-2, rgba(255, 255, 255, 0.1));
        border-radius: 8px;
        color: var(--text-1, #E8ECF4);
        padding: 10px 13px;
        font-size: 13px;
        width: 100%;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    [data-theme="light"] .form-control {
        background: #fff;
        border-color: rgba(15, 23, 42, 0.12);
        color: #0f172a;
    }

    .form-control:focus {
        border-color: var(--accent, #5B7CF5);
        box-shadow: 0 0 0 3px var(--accent-dim, rgba(91, 124, 245, 0.14));
    }

    .invalid-feedback {
        color: #f87171;
        font-size: 11px;
        margin-top: 4px;
        display: block;
    }

    .form-row-cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .btn-primary {
        width: 100%;
        background: var(--action-solid, #3D5AE8);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 4px;
        transition: background 0.15s ease, opacity 0.15s ease;
    }

    .btn-primary:hover {
        background: var(--action-solid-hover, #3350E0);
    }

    .guest-auth-back {
        text-align: center;
        margin-top: 18px;
        font-size: 12px;
    }

    .guest-auth-back a {
        color: var(--accent, #5B7CF5);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .guest-auth-back a:hover {
        text-decoration: underline;
    }

    .theme-float {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 100;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: 1px solid var(--border, rgba(255, 255, 255, 0.06));
        background: var(--surface, #0E1320);
        color: var(--text-2, rgba(232, 236, 244, 0.62));
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        transition: color 0.15s ease, border-color 0.15s ease;
    }

    .theme-float:hover {
        color: var(--text-1, #E8ECF4);
        border-color: var(--border-2, rgba(255, 255, 255, 0.1));
    }

    @media (max-width: 480px) {
        .guest-auth-card { padding: 32px 24px; }
        .form-row-cols { grid-template-columns: 1fr; }
    }
</style>
