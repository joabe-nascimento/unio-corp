{% extends 'auth/_guest_auth_base.html.twig' %}

{% block guest_title %}Esqueci a senha{% endblock %}

{% block guest_content %}
    <h1>Recuperar senha</h1>
    <p class="sub">Informe seu e-mail. Se estiver cadastrado, enviaremos um link para redefinir a senha.</p>

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        <div class="form-group">
            <label class="form-label" for="{{ form.email.vars.id }}">E-mail</label>
            {{ form_widget(form.email, { attr: { class: 'form-control' } }) }}
            {% if form.email.vars.errors|length %}
                <span class="invalid-feedback">{{ form.email.vars.errors[0].message }}</span>
            {% endif %}
        </div>
        <button type="submit" class="btn-primary">Enviar link de recuperação</button>
    {{ form_end(form) }}

    <p class="guest-auth-back">
        <a href="{{ path('app_login') }}">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Voltar ao login
        </a>
    </p>
    {% include 'components/platform_legal.html.twig' with { extra_class: ' platform-legal--auth' } %}
{% endblock %}
