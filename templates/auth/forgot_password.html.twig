<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esqueci a senha | Unio</title>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap">
    {% include 'auth/_guest_auth_styles.html.twig' %}
</head>
<body>
<div class="guest-auth-card">
    <div class="brand-name">Uni<em>o</em></div>
    <h1>Recuperar senha</h1>
    <p class="sub">Informe seu e-mail. Se estiver cadastrado, enviaremos um link para redefinir a senha.</p>

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        <div class="form-group">
            <label class="form-label" for="{{ form.email.vars.id }}">E-mail</label>
            {{ form_widget(form.email, { attr: { class: 'form-control' } }) }}
            {% if form.email.vars.errors|length %}
                <span class="invalid-feedback">{{ form.email.vars.errors[0].message }}</span>
            {% endif %}
        </div>
        <button type="submit" class="btn-primary">Enviar link de recuperação</button>
    {{ form_end(form) }}

    <p class="guest-auth-back"><a href="{{ path('app_login') }}">← Voltar ao login</a></p>
</div>
</body>
</html>
