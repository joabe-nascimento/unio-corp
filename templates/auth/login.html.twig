<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if active_tab == 'register' %}Criar Conta{% else %}Entrar{% endif %} | Unio</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #07080F;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            max-width: 960px;
            min-height: 600px;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.07);
        }

        /* ── Lado esquerdo ──────────────────────────────── */
        .auth-left {
            background: linear-gradient(145deg, #0C0D18 0%, #0f1435 100%);
            padding: 36px 48px 60px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .auth-left::before {
            content: '';
            position: absolute;
            top: -120px; right: -80px;
            width: 360px; height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(61,114,255,0.14) 0%, transparent 68%);
            pointer-events: none;
        }

        .auth-left::after {
            content: '';
            position: absolute;
            bottom: -60px; left: -40px;
            width: 200px; height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(107,154,255,0.08) 0%, transparent 70%);
            pointer-events: none;
        }

        .auth-left > * { position: relative; z-index: 1; }

        .auth-brand-logo {
            display: block;
            height: 180px;
            width: auto;
            object-fit: contain;
            margin: 0;
        }
        [data-theme="light"] .auth-brand-logo {
            filter: invert(1) hue-rotate(180deg);
        }

        .auth-tagline-wrap {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            margin: 32px 0 24px;
        }

        .auth-tagline h2 {
            color: #fff;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1.25;
            margin-bottom: 10px;
        }

        .auth-tagline h2 span {
            background: linear-gradient(90deg, #8BB0FF, #3D72FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .auth-tagline p {
            color: rgba(255,255,255,0.36);
            font-size: 14px;
            line-height: 1.65;
            max-width: 300px;
        }

        .auth-features {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .auth-feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255,255,255,0.38);
            font-size: 12px;
        }

        .auth-feature-item span {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #3D72FF;
            flex-shrink: 0;
        }

        /* ── Lado direito ───────────────────────────────── */
        .auth-right {
            background: #0C0D18;
            padding: 52px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* ── Tabs ───────────────────────────────────────── */
        .auth-tabs {
            display: flex;
            gap: 0;
            margin-bottom: 32px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .auth-tab {
            padding: 10px 20px;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.3);
            cursor: pointer;
            border: none;
            background: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color 0.2s, border-color 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .auth-tab:hover { color: rgba(255,255,255,0.65); }

        .auth-tab.active {
            color: #fff;
            border-bottom-color: #3D72FF;
        }

        /* ── Formulário ─────────────────────────────────── */
        .auth-panel { display: none; }
        .auth-panel.active { display: block; }

        .auth-panel h3 {
            color: #fff;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .auth-panel .sub {
            color: rgba(255,255,255,0.32);
            font-size: 12px;
            margin-bottom: 24px;
        }

        .form-group { margin-bottom: 14px; }

        .form-label {
            color: rgba(255,255,255,0.38);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 5px;
        }

        .form-control {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 7px;
            color: #fff;
            padding: 10px 13px;
            font-size: 13px;
            font-family: inherit;
            width: 100%;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            border-color: rgba(61,114,255,0.5);
            box-shadow: 0 0 0 3px rgba(61,114,255,0.1);
        }

        .form-control::placeholder { color: rgba(255,255,255,0.18); }
        .form-control.is-invalid { border-color: rgba(239,68,68,0.45); }

        .invalid-feedback {
            color: #f87171;
            font-size: 11px;
            margin-top: 4px;
            display: block;
        }

        .form-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .form-row label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: rgba(255,255,255,0.32);
            font-size: 12px;
            cursor: pointer;
        }

        .form-row label input { accent-color: #3D72FF; }

        .form-row a {
            color: rgba(61,114,255,0.75);
            font-size: 12px;
            text-decoration: none;
        }

        .form-row a:hover { color: #6B9AFF; }

        .btn-primary {
            width: 100%;
            background: #3D72FF;
            color: #fff;
            border: none;
            border-radius: 7px;
            padding: 12px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            margin-top: 4px;
        }

        .btn-primary:hover {
            background: #5585ff;
            transform: translateY(-1px);
        }

        /* ── Alertas ────────────────────────────────────── */
        .alert {
            border-radius: 7px;
            padding: 10px 13px;
            font-size: 12px;
            margin-bottom: 18px;
        }

        .alert-danger {
            background: rgba(239,68,68,0.09);
            border: 1px solid rgba(239,68,68,0.22);
            color: #f87171;
        }

        .alert-success {
            background: rgba(34,197,94,0.09);
            border: 1px solid rgba(34,197,94,0.22);
            color: #4ade80;
        }

        .form-row-cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* ── Divider ────────────────────────────────────── */
        .auth-divider {
            text-align: center;
            margin: 14px 0 0;
            font-size: 12px;
            color: rgba(255,255,255,0.25);
        }

        .auth-divider a {
            color: #6B9AFF;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-divider a:hover { color: #8BB0FF; }

        /* ── Responsive ─────────────────────────────────── */
        @media (max-width: 640px) {
            .auth-wrapper { grid-template-columns: 1fr; margin: 16px; }
            .auth-left { display: none; }
            .auth-right { padding: 36px 24px; }
        }

        .platform-support { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 20px; }
        .platform-support__item { font-size: 12.5px; color: rgba(255,255,255,0.45); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
        .platform-support__item:hover { color: rgba(255,255,255,0.75); }
    </style>
</head>
<body>
<div class="auth-wrapper">

    {# ── Lado esquerdo ── #}
    <div class="auth-left">
        <img src="{{ asset('images/logos/unio-logotipo.png') }}"
             alt="Unio"
             class="auth-brand-logo">

        <div class="auth-tagline-wrap">
            <div class="auth-tagline">
                <h2>Pessoas. Processos.<br><span>Resultados.</span></h2>
                <p>Tudo conectado. Toda gestão em um só lugar.</p>
            </div>
        </div>


        {% include 'components/platform_support.html.twig' with { extra_class: ' platform-support--auth' } %}
    </div>

    {# ── Lado direito ── #}
    <div class="auth-right">

        {# ── Tabs ── #}
        <div class="auth-tabs">
            <a href="{{ path('app_login') }}"
               class="auth-tab {{ active_tab == 'login' ? 'active' : '' }}">
                Entrar
            </a>
            {% if platform_config.registro_publico ?? true %}
            <a href="{{ path('app_register') }}"
               class="auth-tab {{ active_tab == 'register' ? 'active' : '' }}">
                Criar conta
            </a>
            {% endif %}
        </div>

        {# ──────────────────────────── PAINEL LOGIN ──────────────────────────── #}
        <div class="auth-panel {{ active_tab == 'login' ? 'active' : '' }}" id="panel-login">

            <h3>Bem-vindo de volta</h3>
            <p class="sub">Entre com suas credenciais para acessar a plataforma</p>

            {% for msg in app.flashes('register_success') %}
                <div class="alert alert-success">{{ msg }}</div>
            {% endfor %}

            {% for msg in app.flashes('auth_info') %}
                <div class="alert alert-success">{{ msg }}</div>
            {% endfor %}

            {% for msg in app.flashes('auth_error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            {% if app.debug %}
                {% for msg in app.flashes('auth_dev_reset_link') %}
                    <div class="alert alert-danger" style="word-break: break-all;">{{ msg }}</div>
                {% endfor %}
            {% endif %}

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label class="form-label" for="email">E-mail</label>
                    <input class="form-control" id="email" type="email" name="email"
                           value="{{ last_username }}" placeholder="seu@email.com"
                           autocomplete="email"{% if active_tab == 'login' %} autofocus{% endif %} required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Senha</label>
                    <input class="form-control" id="password" type="password" name="password"
                           placeholder="••••••••" autocomplete="current-password" required>
                </div>

                <div class="form-row">
                    <label>
                        <input type="checkbox" name="_remember_me">
                        Lembrar-me por 7 dias
                    </label>
                    <a href="{{ path('app_forgot_password') }}">Esqueci a senha</a>
                </div>

                <button type="submit" class="btn-primary">Entrar na plataforma</button>
            </form>

            {% if platform_config.registro_publico ?? true %}
            <p class="auth-divider">
                Não tem conta? <a href="{{ path('app_register') }}">Criar conta grátis</a>
            </p>
            {% endif %}
        </div>

        {# ──────────────────────────── PAINEL CADASTRO ──────────────────────── #}
        {% if registrationForm is defined and registrationForm %}
        <div class="auth-panel {{ active_tab == 'register' ? 'active' : '' }}" id="panel-register">

            <h3>Criar conta</h3>
            <p class="sub">Preencha os dados para acessar a plataforma</p>

            {% for msg in app.flashes('register_error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            {{ form_start(registrationForm, {
                'action': path('app_register'),
                'method': 'POST',
                'attr': {'novalidate': 'novalidate'}
            }) }}

                <div class="form-group">
                    <label class="form-label" for="{{ registrationForm.nome.vars.id }}">Nome completo</label>
                    {{ form_widget(registrationForm.nome, {'attr': (active_tab == 'register' ? {'class': 'form-control' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : ''), 'autofocus': 'autofocus'} : {'class': 'form-control' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : '')})}) }}
                    {% if registrationForm.nome.vars.errors|length %}
                        <span class="invalid-feedback">{{ registrationForm.nome.vars.errors[0].message }}</span>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label class="form-label" for="{{ registrationForm.email.vars.id }}">E-mail</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control' ~ (registrationForm.email.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {% if registrationForm.email.vars.errors|length %}
                        <span class="invalid-feedback">{{ registrationForm.email.vars.errors[0].message }}</span>
                    {% endif %}
                </div>

                <div class="form-row-cols">
                    <div class="form-group">
                        <label class="form-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Senha</label>
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmar senha</label>
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                </div>
                {% if registrationForm.plainPassword.vars.errors|length %}
                    <span class="invalid-feedback" style="margin-top:-8px;margin-bottom:10px;">{{ registrationForm.plainPassword.vars.errors[0].message }}</span>
                {% endif %}

                <button type="submit" class="btn-primary">Criar minha conta</button>

            {{ form_end(registrationForm) }}

            <p class="auth-divider">
                Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a>
            </p>
        </div>
        {% endif %}

    </div>{# /auth-right #}
</div>{# /auth-wrapper #}
</body>
</html>
