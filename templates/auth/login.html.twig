{% set _tema = platform_config.tema|default('dark') %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if active_tab == 'register' %}Criar Conta{% else %}Entrar{% endif %} | Unio</title>
    <script>try{var _p=new URLSearchParams(location.search);var _t=_p.get('theme')||localStorage.getItem('unio-theme')||'{{ _tema }}';document.documentElement.setAttribute('data-theme',_t);if(_p.get('theme'))localStorage.setItem('unio-theme',_t);}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/unio_theme_vars.html.twig' %}
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            background: var(--bg);
            font-family: 'Inter', sans-serif;
            margin: 0;
            color: var(--text-1);
            transition: background 0.2s ease, color 0.2s ease;
        }

        .auth-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            overflow: hidden;
        }

        /* ── Lado esquerdo ──────────────────────────────── */
        .auth-left {
            background: #10131c;
            padding: 56px 64px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            min-height: 0;
            transition: background 0.2s ease;
        }

        [data-theme="light"] .auth-left {
            background: #dcebf2;
        }

        .auth-left-bg {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .auth-left-bg::after {
            content: none;
        }

        .auth-deco {
            position: absolute;
            pointer-events: none;
            user-select: none;
            filter: brightness(0);
        }

        .auth-deco--mesh {
            inset: -8% -12%;
            width: 124%;
            height: 116%;
            object-fit: cover;
            opacity: 0.28;
        }

        [data-theme="light"] .auth-deco--mesh {
            opacity: 0.16;
        }

        .auth-deco--orbit {
            top: 8%;
            right: 6%;
            width: min(28vw, 200px);
            height: auto;
            opacity: 0.42;
            animation: authDecoFloat 14s ease-in-out infinite;
        }

        [data-theme="light"] .auth-deco--orbit { opacity: 0.2; }

        .auth-deco--chip {
            top: 22%;
            right: 18%;
            width: min(18vw, 130px);
            height: auto;
            opacity: 0.36;
            animation: authDecoFloat 11s ease-in-out infinite reverse;
        }

        [data-theme="light"] .auth-deco--chip { opacity: 0.16; }

        .auth-deco--nodes {
            bottom: 14%;
            left: 4%;
            width: min(32vw, 220px);
            height: auto;
            opacity: 0.48;
            animation: authDecoDrift 16s ease-in-out infinite;
        }

        [data-theme="light"] .auth-deco--nodes { opacity: 0.22; }

        .auth-deco--circuit {
            bottom: 28%;
            right: 2%;
            width: min(22vw, 160px);
            height: auto;
            opacity: 0.32;
            animation: authDecoFloat 13s ease-in-out infinite 1.5s;
        }

        [data-theme="light"] .auth-deco--circuit { opacity: 0.14; }

        [data-theme="dark"] .auth-deco--orbit,
        [data-theme="dark"] .auth-deco--chip,
        [data-theme="dark"] .auth-deco--nodes,
        [data-theme="dark"] .auth-deco--circuit {
            opacity: 0.38;
        }

        [data-theme="dark"] .auth-deco--mesh {
            opacity: 0.22;
        }

        @keyframes authDecoFloat {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(1.5deg); }
        }

        @keyframes authDecoDrift {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(8px, -10px); }
        }

        @media (prefers-reduced-motion: reduce) {
            .auth-deco { animation: none !important; }
            .auth-logo-anim,
            .auth-logo-anim *,
            .auth-left-tagline--anim { animation: none !important; }
            .auth-logo-anim__img { opacity: 1 !important; clip-path: none !important; transform: none !important; filter: none !important; }
        }

        .auth-left-inner,
        .auth-left-footer {
            position: relative;
            z-index: 1;
        }

        .auth-left-inner {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 28px;
            min-height: 0;
        }

        .auth-left-footer {
            flex-shrink: 0;
            padding-top: 32px;
        }

        /* ── Logotipo animado ───────────────────────────── */
        .auth-logo-anim {
            position: relative;
            width: 100%;
            max-width: 420px;
            opacity: 0;
            animation: authLogoWrapIn 0.5s ease forwards;
        }

        .auth-logo-anim__glow {
            position: absolute;
            left: 8%;
            top: 50%;
            width: 38%;
            height: 72%;
            transform: translateY(-50%);
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(79, 127, 255, 0.42) 0%, transparent 68%);
            opacity: 0;
            pointer-events: none;
            animation: authLogoGlowPulse 2.8s ease-in-out 0.35s forwards;
        }

        [data-theme="light"] .auth-logo-anim__glow {
            background: radial-gradient(ellipse at center, rgba(79, 127, 255, 0.28) 0%, transparent 70%);
        }

        .auth-logo-anim__stage {
            position: relative;
            z-index: 1;
            overflow: hidden;
        }

        .auth-logo-anim__stage::after {
            content: '';
            position: absolute;
            inset: -4% -8%;
            background: linear-gradient(
                105deg,
                transparent 38%,
                rgba(255, 255, 255, 0.22) 48%,
                rgba(255, 255, 255, 0.38) 50%,
                rgba(255, 255, 255, 0.18) 52%,
                transparent 62%
            );
            transform: translateX(-130%) skewX(-12deg);
            pointer-events: none;
            opacity: 0;
            animation: authLogoShine 1.1s ease-in-out 1.15s forwards;
        }

        [data-theme="light"] .auth-logo-anim__stage::after {
            background: linear-gradient(
                105deg,
                transparent 38%,
                rgba(255, 255, 255, 0.55) 48%,
                rgba(255, 255, 255, 0.75) 50%,
                rgba(255, 255, 255, 0.45) 52%,
                transparent 62%
            );
        }

        @keyframes authLogoShine {
            0% { opacity: 0; transform: translateX(-130%) skewX(-12deg); }
            20% { opacity: 1; }
            100% { opacity: 0; transform: translateX(130%) skewX(-12deg); }
        }

        .auth-logo-anim__img,
        .auth-logo-anim .platform-logo-placeholder-wrap {
            display: block;
            width: 100%;
            max-width: 420px;
            height: auto;
            max-height: min(52vh, 380px);
            object-fit: contain;
            object-position: left center;
        }

        .auth-logo-anim__img {
            opacity: 0;
            transform: translateY(14px) scale(0.96);
            filter: blur(6px);
            clip-path: inset(0 56% 0 0 round 2px);
            animation:
                authLogoIconIn 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.12s forwards,
                authLogoReveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
        }

        .auth-logo-anim--placeholder .auth-logo-anim__img,
        .auth-logo-anim--placeholder .platform-logo-placeholder-wrap {
            clip-path: none;
            animation: authLogoFadeIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
        }

        .auth-logo-anim--idle .auth-logo-anim__stage {
            animation: authLogoFloat 5.5s ease-in-out infinite;
        }

        .auth-logo-anim--idle .auth-logo-anim__glow {
            animation: authLogoGlowIdle 4s ease-in-out infinite;
        }

        @keyframes authLogoWrapIn {
            to { opacity: 1; }
        }

        @keyframes authLogoIconIn {
            0% {
                opacity: 0;
                transform: translateY(14px) scale(0.96);
                filter: blur(6px);
                clip-path: inset(0 56% 0 0 round 2px);
            }
            55% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
                clip-path: inset(0 56% 0 0 round 2px);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
                clip-path: inset(0 56% 0 0 round 2px);
            }
        }

        @keyframes authLogoReveal {
            from { clip-path: inset(0 56% 0 0 round 2px); }
            to { clip-path: inset(0 0 0 0 round 2px); }
        }

        @keyframes authLogoFadeIn {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        @keyframes authLogoGlowPulse {
            0% { opacity: 0; transform: translateY(-50%) scale(0.85); }
            45% { opacity: 0.85; transform: translateY(-50%) scale(1.05); }
            100% { opacity: 0.55; transform: translateY(-50%) scale(1); }
        }

        @keyframes authLogoGlowIdle {
            0%, 100% { opacity: 0.4; transform: translateY(-50%) scale(1); }
            50% { opacity: 0.7; transform: translateY(-50%) scale(1.06); }
        }

        @keyframes authLogoFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }

        .auth-left-tagline--anim {
            opacity: 0;
            transform: translateY(8px);
            animation: authTaglineIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) 1.05s forwards;
        }

        @keyframes authTaglineIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        [data-theme="light"] .auth-left-tagline--anim {
            animation-delay: 0.95s;
        }

        .auth-left-tagline {
            color: rgba(255, 255, 255, 0.58);
            font-size: 15px;
            line-height: 1.6;
            max-width: 380px;
            font-weight: 400;
        }

        [data-theme="light"] .auth-left-tagline {
            color: var(--text-2);
        }

        .auth-left .platform-support__item {
            color: rgba(255, 255, 255, 0.48);
        }

        [data-theme="light"] .auth-left .platform-support__item {
            color: var(--text-3);
        }

        .auth-left .platform-support__item:hover {
            color: rgba(255, 255, 255, 0.78);
        }

        [data-theme="light"] .auth-left .platform-support__item:hover {
            color: var(--accent);
        }

        /* ── Lado direito ───────────────────────────────── */
        .auth-right {
            background: #0C0D18;
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 0;
            overflow-y: auto;
            transition: background 0.2s ease;
        }

        [data-theme="light"] .auth-right {
            background: var(--layout-bg);
        }

        .auth-right-inner {
            width: 100%;
            max-width: 400px;
        }

        /* ── Tabs ───────────────────────────────────────── */
        .auth-tabs {
            display: flex;
            gap: 0;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
        }

        .auth-tab {
            padding: 10px 20px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-3);
            cursor: pointer;
            border: none;
            background: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color 0.2s, border-color 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .auth-tab:hover { color: var(--text-2); }

        .auth-tab.active {
            color: var(--text-1);
            border-bottom-color: var(--accent);
        }

        /* ── Formulário ─────────────────────────────────── */
        .auth-panel { display: none; }
        .auth-panel.active { display: block; }

        .auth-panel h3 {
            color: var(--text-1);
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .auth-panel .sub {
            color: var(--text-2);
            font-size: 12px;
            margin-bottom: 24px;
        }

        .form-group { margin-bottom: 14px; }

        .form-label {
            color: var(--text-2);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 5px;
        }

        .form-control {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text-1);
            padding: 10px 13px;
            font-size: 13px;
            font-family: inherit;
            width: 100%;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        [data-theme="light"] .form-control {
            background: var(--input-bg);
            border-color: var(--border-2);
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim);
        }

        .form-control::placeholder { color: var(--text-3); }
        .form-control.is-invalid { border-color: rgba(239,68,68,0.45); }

        .invalid-feedback {
            color: #f87171;
            font-size: 11px;
            margin-top: 4px;
            display: block;
        }

        .form-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .form-row label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-2);
            font-size: 12px;
            cursor: pointer;
        }

        .form-row label input { accent-color: var(--accent); }

        .form-row a {
            color: var(--accent);
            font-size: 12px;
            text-decoration: none;
            opacity: 0.85;
        }

        .form-row a:hover { opacity: 1; }

        .btn-primary {
            width: 100%;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 7px;
            padding: 12px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            margin-top: 4px;
        }

        .btn-primary:hover {
            background: var(--action-hover);
            transform: translateY(-1px);
        }

        /* ── Alertas ────────────────────────────────────── */
        .alert {
            border-radius: 7px;
            padding: 10px 13px;
            font-size: 12px;
            margin-bottom: 18px;
        }

        .alert-danger {
            background: rgba(239,68,68,0.09);
            border: 1px solid rgba(239,68,68,0.22);
            color: #f87171;
        }

        .alert-success {
            background: rgba(34,197,94,0.09);
            border: 1px solid rgba(34,197,94,0.22);
            color: #4ade80;
        }

        [data-theme="light"] .alert-success {
            color: #15803d;
        }

        .form-row-cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* ── Divider ────────────────────────────────────── */
        .auth-divider {
            text-align: center;
            margin: 14px 0 0;
            font-size: 12px;
            color: var(--text-3);
        }

        .auth-divider a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }

        /* ── Suporte (rodapé do painel esquerdo) ─────────── */
        .platform-support { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 20px; }
        .platform-support__item {
            font-size: 12.5px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* ── Alternador de tema ─────────────────────────── */
        .theme-float {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 100;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-2);
            font-size: 14px;
            transition: color 0.15s, border-color 0.15s, background 0.15s;
        }

        .theme-float:hover {
            color: var(--text-1);
            border-color: var(--border-2);
            background: var(--surface-2);
        }

        .auth-back-home {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.15s, border-color 0.15s, background 0.15s;
            z-index: 2;
        }

        .auth-back-home--banner {
            position: absolute;
            top: 20px;
            right: 24px;
            color: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.32);
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .auth-back-home--banner:hover {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.52);
            background: rgba(255, 255, 255, 0.16);
            text-decoration: none;
        }

        [data-theme="light"] .auth-back-home--banner {
            color: var(--text-2);
            border-color: var(--border-2);
            background: rgba(255, 255, 255, 0.65);
        }

        [data-theme="light"] .auth-back-home--banner:hover {
            color: var(--text-1);
            border-color: var(--accent-line);
            background: #fff;
        }

        .auth-back-home--form {
            display: none;
            margin-bottom: 20px;
            color: var(--text-3);
            border: 1px solid var(--border);
            background: var(--surface-2);
        }

        .auth-back-home--form:hover {
            color: var(--accent);
            border-color: var(--accent-line);
            background: var(--accent-dim);
            text-decoration: none;
        }

        .auth-back-home i {
            font-size: 11px;
        }

        /* ── Responsive ─────────────────────────────────── */
        @media (max-width: 900px) {
            .auth-wrapper {
                grid-template-columns: 1fr;
                height: auto;
                min-height: 100vh;
                min-height: 100dvh;
                overflow-y: auto;
            }
            html, body { overflow: auto; }
            .auth-left {
                min-height: 280px;
                padding: 32px 28px;
            }
            .auth-logo-anim,
            .auth-logo-anim__img,
            .auth-logo-anim .platform-logo-placeholder-wrap { max-height: 200px; max-width: 320px; }
            .auth-left { display: flex; }
        }

        @media (max-width: 640px) {
            .auth-left { display: none; }
            .auth-right { padding: 36px 24px; }
            .auth-back-home--banner { display: none; }
            .auth-back-home--form { display: inline-flex; }
        }
    </style>
</head>
<body>

{% include 'components/guest_theme_toggle.html.twig' %}

<div class="auth-wrapper">

    {# ── Lado esquerdo ── #}
    <div class="auth-left">
        <div class="auth-left-bg" aria-hidden="true">
            <img class="auth-deco auth-deco--mesh"
                 src="{{ asset('images/auth/mesh-network.svg') }}" alt="">
            <img class="auth-deco auth-deco--orbit"
                 src="{{ asset('images/auth/deco-orbit.svg') }}" alt="">
            <img class="auth-deco auth-deco--chip"
                 src="{{ asset('images/auth/deco-chip.svg') }}" alt="">
            <img class="auth-deco auth-deco--nodes"
                 src="{{ asset('images/auth/deco-nodes-cluster.svg') }}" alt="">
            <img class="auth-deco auth-deco--circuit"
                 src="{{ asset('images/auth/deco-circuit.svg') }}" alt="">
        </div>

        <a href="{{ path('app_home') }}" class="auth-back-home auth-back-home--banner">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Voltar para a página inicial
        </a>

        <div class="auth-left-inner">
            {% include 'components/auth_logo_animated.html.twig' with { variant: 'full' } only %}

            {% set _auth_tagline = platform_config.plataforma_tagline|default('')|trim %}
            {% if _auth_tagline %}
            <p class="auth-left-tagline auth-left-tagline--anim">{{ _auth_tagline }}</p>
            {% endif %}
        </div>

        <div class="auth-left-footer">
            {% include 'components/platform_support.html.twig' with { extra_class: ' platform-support--auth' } %}
        </div>
    </div>

    {# ── Lado direito ── #}
    <div class="auth-right">
    <div class="auth-right-inner">

        <a href="{{ path('app_home') }}" class="auth-back-home auth-back-home--form">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Voltar para a página inicial
        </a>

        {# ── Tabs ── #}
        <div class="auth-tabs">
            <a href="{{ path('app_login') }}"
               class="auth-tab {{ active_tab == 'login' ? 'active' : '' }}">
                Entrar
            </a>
            {% if platform_config.registro_publico ?? true %}
            <a href="{{ path('app_register') }}"
               class="auth-tab {{ active_tab == 'register' ? 'active' : '' }}">
                Criar conta
            </a>
            {% endif %}
        </div>

        {# ──────────────────────────── PAINEL LOGIN ──────────────────────────── #}
        <div class="auth-panel {{ active_tab == 'login' ? 'active' : '' }}" id="panel-login">

            <h3>Bem-vindo de volta</h3>
            <p class="sub">Entre com suas credenciais para acessar a plataforma</p>

            {% for msg in app.flashes('register_success') %}
                <div class="alert alert-success">{{ msg }}</div>
            {% endfor %}

            {% for msg in app.flashes('auth_info') %}
                <div class="alert alert-success">{{ msg }}</div>
            {% endfor %}

            {% for msg in app.flashes('auth_error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            {% if app.debug %}
                {% for msg in app.flashes('auth_dev_reset_link') %}
                    <div class="alert alert-danger" style="word-break: break-all;">{{ msg }}</div>
                {% endfor %}
            {% endif %}

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label class="form-label" for="email">E-mail</label>
                    <input class="form-control" id="email" type="email" name="email"
                           value="{{ last_username }}" placeholder="seu@email.com"
                           autocomplete="email"{% if active_tab == 'login' %} autofocus{% endif %} required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Senha</label>
                    <input class="form-control" id="password" type="password" name="password"
                           placeholder="••••••••" autocomplete="current-password" required>
                </div>

                <div class="form-row">
                    <label>
                        <input type="checkbox" name="_remember_me">
                        Lembrar-me por 7 dias
                    </label>
                    <a href="{{ path('app_forgot_password') }}">Esqueci a senha</a>
                </div>

                <button type="submit" class="btn-primary">Entrar na plataforma</button>
            </form>

            {% if platform_config.registro_publico ?? true %}
            <p class="auth-divider">
                Não tem conta? <a href="{{ path('app_register') }}">Criar conta grátis</a>
            </p>
            {% endif %}
        </div>

        {# ──────────────────────────── PAINEL CADASTRO ──────────────────────── #}
        {% if registrationForm is defined and registrationForm %}
        <div class="auth-panel {{ active_tab == 'register' ? 'active' : '' }}" id="panel-register">

            <h3>Criar conta</h3>
            <p class="sub">Preencha os dados para acessar a plataforma</p>

            {% for msg in app.flashes('register_error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            {{ form_start(registrationForm, {
                'action': path('app_register'),
                'method': 'POST',
                'attr': {'novalidate': 'novalidate'}
            }) }}

                <div class="form-group">
                    <label class="form-label" for="{{ registrationForm.nome.vars.id }}">Nome completo</label>
                    {{ form_widget(registrationForm.nome, {'attr': (active_tab == 'register' ? {'class': 'form-control' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : ''), 'autofocus': 'autofocus'} : {'class': 'form-control' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : '')})}) }}
                    {% if registrationForm.nome.vars.errors|length %}
                        <span class="invalid-feedback">{{ registrationForm.nome.vars.errors[0].message }}</span>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label class="form-label" for="{{ registrationForm.email.vars.id }}">E-mail</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control' ~ (registrationForm.email.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {% if registrationForm.email.vars.errors|length %}
                        <span class="invalid-feedback">{{ registrationForm.email.vars.errors[0].message }}</span>
                    {% endif %}
                </div>

                <div class="form-row-cols">
                    <div class="form-group">
                        <label class="form-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Senha</label>
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmar senha</label>
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                </div>
                {% if registrationForm.plainPassword.vars.errors|length %}
                    <span class="invalid-feedback" style="margin-top:-8px;margin-bottom:10px;">{{ registrationForm.plainPassword.vars.errors[0].message }}</span>
                {% endif %}

                <button type="submit" class="btn-primary">Criar minha conta</button>

            {{ form_end(registrationForm) }}

            <p class="auth-divider">
                Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a>
            </p>
        </div>
        {% endif %}

    </div>{# /auth-right-inner #}
    </div>{# /auth-right #}
</div>{# /auth-wrapper #}
<script>
(function () {
    var root = document.querySelector('[data-auth-logo-anim]');
    if (!root) return;
    var img = root.querySelector('.auth-logo-anim__img');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function setIdle() { root.classList.add('auth-logo-anim--idle'); }
    if (reduce) {
        setIdle();
        return;
    }
    if (!img) {
        setTimeout(setIdle, 1200);
        return;
    }
    var done = false;
    function onEnd() {
        if (done) return;
        done = true;
        setIdle();
    }
    img.addEventListener('animationend', function (e) {
        if (e.animationName === 'authLogoReveal') onEnd();
    });
    setTimeout(onEnd, 1600);
})();
</script>
</body>
</html>
