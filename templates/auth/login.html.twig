{% set _tema = platform_config.tema|default('dark') %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if active_tab == 'register' %}Criar Conta{% else %}Entrar{% endif %} | Unio</title>
    <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('unio-theme')||localStorage.getItem('huplex-theme')||'{{ _tema }}')}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% include 'components/huplex_theme_vars.html.twig' %}
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            background: var(--bg);
            font-family: 'Inter', sans-serif;
            margin: 0;
            color: var(--text-1);
            transition: background 0.2s ease, color 0.2s ease;
        }

        .auth-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            overflow: hidden;
        }

        /* ── Lado esquerdo ──────────────────────────────── */
        .auth-left {
            background: linear-gradient(155deg, #0a0c16 0%, #0f1435 48%, #121a42 100%);
            padding: 56px 64px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            min-height: 0;
            transition: background 0.2s ease;
        }

        [data-theme="light"] .auth-left {
            background: linear-gradient(155deg, #0a4a54 0%, var(--accent) 38%, #12616E 62%, #0D3B44 100%);
        }

        .auth-left-bg {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .auth-left-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: radial-gradient(ellipse 80% 60% at 20% 50%, rgba(255,255,255,0.07) 0%, transparent 55%);
            pointer-events: none;
        }

        [data-theme="light"] .auth-left-bg::after {
            background: radial-gradient(ellipse 70% 55% at 25% 45%, rgba(255,255,255,0.10) 0%, transparent 58%);
        }

        .auth-deco {
            position: absolute;
            pointer-events: none;
            user-select: none;
            filter: brightness(0);
        }

        .auth-deco--mesh {
            inset: -8% -12%;
            width: 124%;
            height: 116%;
            object-fit: cover;
            opacity: 0.28;
        }

        [data-theme="light"] .auth-deco--mesh {
            opacity: 0.34;
        }

        .auth-deco--orbit {
            top: 8%;
            right: 6%;
            width: min(28vw, 200px);
            height: auto;
            opacity: 0.42;
            animation: authDecoFloat 14s ease-in-out infinite;
        }

        .auth-deco--chip {
            top: 22%;
            right: 18%;
            width: min(18vw, 130px);
            height: auto;
            opacity: 0.36;
            animation: authDecoFloat 11s ease-in-out infinite reverse;
        }

        .auth-deco--nodes {
            bottom: 14%;
            left: 4%;
            width: min(32vw, 220px);
            height: auto;
            opacity: 0.48;
            animation: authDecoDrift 16s ease-in-out infinite;
        }

        .auth-deco--circuit {
            bottom: 28%;
            right: 2%;
            width: min(22vw, 160px);
            height: auto;
            opacity: 0.32;
            animation: authDecoFloat 13s ease-in-out infinite 1.5s;
        }

        [data-theme="dark"] .auth-deco--orbit,
        [data-theme="dark"] .auth-deco--chip,
        [data-theme="dark"] .auth-deco--nodes,
        [data-theme="dark"] .auth-deco--circuit {
            opacity: 0.38;
        }

        [data-theme="dark"] .auth-deco--mesh {
            opacity: 0.22;
        }

        @keyframes authDecoFloat {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(1.5deg); }
        }

        @keyframes authDecoDrift {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(8px, -10px); }
        }

        @media (prefers-reduced-motion: reduce) {
            .auth-deco { animation: none !important; }
        }

        .auth-left-inner,
        .auth-left-footer {
            position: relative;
            z-index: 1;
        }

        .auth-left-inner {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 28px;
            min-height: 0;
        }

        .auth-left-footer {
            flex-shrink: 0;
            padding-top: 32px;
        }

        .auth-hero-logo {
            display: block;
            width: 100%;
            max-width: 420px;
            height: auto;
            max-height: min(52vh, 380px);
            object-fit: contain;
            object-position: left center;
            /* PNG com fundo preto: fundo some, texto branco e ícone colorido permanecem */
            mix-blend-mode: screen;
        }

        .auth-left-tagline {
            color: rgba(255, 255, 255, 0.58);
            font-size: 15px;
            line-height: 1.6;
            max-width: 380px;
            font-weight: 400;
        }

        .auth-left .platform-support__item {
            color: rgba(255, 255, 255, 0.48);
        }

        .auth-left .platform-support__item:hover {
            color: rgba(255, 255, 255, 0.78);
        }

        /* ── Lado direito ───────────────────────────────── */
        .auth-right {
            background: #0C0D18;
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 0;
            overflow-y: auto;
            transition: background 0.2s ease;
        }

        [data-theme="light"] .auth-right {
            background: var(--layout-bg);
        }

        .auth-right-inner {
            width: 100%;
            max-width: 400px;
        }

        /* ── Tabs ───────────────────────────────────────── */
        .auth-tabs {
            display: flex;
            gap: 0;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
        }

        .auth-tab {
            padding: 10px 20px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-3);
            cursor: pointer;
            border: none;
            background: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color 0.2s, border-color 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .auth-tab:hover { color: var(--text-2); }

        .auth-tab.active {
            color: var(--text-1);
            border-bottom-color: var(--accent);
        }

        /* ── Formulário ─────────────────────────────────── */
        .auth-panel { display: none; }
        .auth-panel.active { display: block; }

        .auth-panel h3 {
            color: var(--text-1);
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .auth-panel .sub {
            color: var(--text-2);
            font-size: 12px;
            margin-bottom: 24px;
        }

        .form-group { margin-bottom: 14px; }

        .form-label {
            color: var(--text-2);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 5px;
        }

        .form-control {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text-1);
            padding: 10px 13px;
            font-size: 13px;
            font-family: inherit;
            width: 100%;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        [data-theme="light"] .form-control {
            background: var(--input-bg);
            border-color: var(--border-2);
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim);
        }

        .form-control::placeholder { color: var(--text-3); }
        .form-control.is-invalid { border-color: rgba(239,68,68,0.45); }

        .invalid-feedback {
            color: #f87171;
            font-size: 11px;
            margin-top: 4px;
            display: block;
        }

        .form-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .form-row label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-2);
            font-size: 12px;
            cursor: pointer;
        }

        .form-row label input { accent-color: var(--accent); }

        .form-row a {
            color: var(--accent);
            font-size: 12px;
            text-decoration: none;
            opacity: 0.85;
        }

        .form-row a:hover { opacity: 1; }

        .btn-primary {
            width: 100%;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 7px;
            padding: 12px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            margin-top: 4px;
        }

        .btn-primary:hover {
            background: var(--action-hover);
            transform: translateY(-1px);
        }

        /* ── Alertas ────────────────────────────────────── */
        .alert {
            border-radius: 7px;
            padding: 10px 13px;
            font-size: 12px;
            margin-bottom: 18px;
        }

        .alert-danger {
            background: rgba(239,68,68,0.09);
            border: 1px solid rgba(239,68,68,0.22);
            color: #f87171;
        }

        .alert-success {
            background: rgba(34,197,94,0.09);
            border: 1px solid rgba(34,197,94,0.22);
            color: #4ade80;
        }

        [data-theme="light"] .alert-success {
            color: #15803d;
        }

        .form-row-cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* ── Divider ────────────────────────────────────── */
        .auth-divider {
            text-align: center;
            margin: 14px 0 0;
            font-size: 12px;
            color: var(--text-3);
        }

        .auth-divider a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }

        /* ── Suporte (rodapé do painel esquerdo) ─────────── */
        .platform-support { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 20px; }
        .platform-support__item {
            font-size: 12.5px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* ── Alternador de tema ─────────────────────────── */
        .theme-float {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 100;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-2);
            font-size: 14px;
            transition: color 0.15s, border-color 0.15s, background 0.15s;
        }

        .theme-float:hover {
            color: var(--text-1);
            border-color: var(--border-2);
            background: var(--surface-2);
        }

        /* ── Responsive ─────────────────────────────────── */
        @media (max-width: 900px) {
            .auth-wrapper {
                grid-template-columns: 1fr;
                height: auto;
                min-height: 100vh;
                min-height: 100dvh;
                overflow-y: auto;
            }
            html, body { overflow: auto; }
            .auth-left {
                min-height: 280px;
                padding: 32px 28px;
            }
            .auth-hero-logo { max-height: 200px; max-width: 320px; }
            .auth-left { display: flex; }
        }

        @media (max-width: 640px) {
            .auth-left { display: none; }
            .auth-right { padding: 36px 24px; }
        }
    </style>
</head>
<body>

{% include 'components/guest_theme_toggle.html.twig' %}

<div class="auth-wrapper">

    {# ── Lado esquerdo ── #}
    <div class="auth-left">
        <div class="auth-left-bg" aria-hidden="true">
            <img class="auth-deco auth-deco--mesh"
                 src="{{ asset('images/auth/mesh-network.svg') }}" alt="">
            <img class="auth-deco auth-deco--orbit"
                 src="{{ asset('images/auth/deco-orbit.svg') }}" alt="">
            <img class="auth-deco auth-deco--chip"
                 src="{{ asset('images/auth/deco-chip.svg') }}" alt="">
            <img class="auth-deco auth-deco--nodes"
                 src="{{ asset('images/auth/deco-nodes-cluster.svg') }}" alt="">
            <img class="auth-deco auth-deco--circuit"
                 src="{{ asset('images/auth/deco-circuit.svg') }}" alt="">
        </div>

        <div class="auth-left-inner">
            <img src="{{ asset('images/logos/logotipo-unio.png') }}"
                 alt="Unio — Pessoas. Processos. Resultados."
                 class="auth-hero-logo">

            {% set _auth_tagline = platform_config.plataforma_tagline|default('')|trim %}
            {% if _auth_tagline %}
            <p class="auth-left-tagline">{{ _auth_tagline }}</p>
            {% endif %}
        </div>

        <div class="auth-left-footer">
            {% include 'components/platform_support.html.twig' with { extra_class: ' platform-support--auth' } %}
        </div>
    </div>

    {# ── Lado direito ── #}
    <div class="auth-right">
    <div class="auth-right-inner">

        {# ── Tabs ── #}
        <div class="auth-tabs">
            <a href="{{ path('app_login') }}"
               class="auth-tab {{ active_tab == 'login' ? 'active' : '' }}">
                Entrar
            </a>
            {% if platform_config.registro_publico ?? true %}
            <a href="{{ path('app_register') }}"
               class="auth-tab {{ active_tab == 'register' ? 'active' : '' }}">
                Criar conta
            </a>
            {% endif %}
        </div>

        {# ──────────────────────────── PAINEL LOGIN ──────────────────────────── #}
        <div class="auth-panel {{ active_tab == 'login' ? 'active' : '' }}" id="panel-login">

            <h3>Bem-vindo de volta</h3>
            <p class="sub">Entre com suas credenciais para acessar a plataforma</p>

            {% for msg in app.flashes('register_success') %}
                <div class="alert alert-success">{{ msg }}</div>
            {% endfor %}

            {% for msg in app.flashes('auth_info') %}
                <div class="alert alert-success">{{ msg }}</div>
            {% endfor %}

            {% for msg in app.flashes('auth_error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            {% if app.debug %}
                {% for msg in app.flashes('auth_dev_reset_link') %}
                    <div class="alert alert-danger" style="word-break: break-all;">{{ msg }}</div>
                {% endfor %}
            {% endif %}

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label class="form-label" for="email">E-mail</label>
                    <input class="form-control" id="email" type="email" name="email"
                           value="{{ last_username }}" placeholder="seu@email.com"
                           autocomplete="email"{% if active_tab == 'login' %} autofocus{% endif %} required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Senha</label>
                    <input class="form-control" id="password" type="password" name="password"
                           placeholder="••••••••" autocomplete="current-password" required>
                </div>

                <div class="form-row">
                    <label>
                        <input type="checkbox" name="_remember_me">
                        Lembrar-me por 7 dias
                    </label>
                    <a href="{{ path('app_forgot_password') }}">Esqueci a senha</a>
                </div>

                <button type="submit" class="btn-primary">Entrar na plataforma</button>
            </form>

            {% if platform_config.registro_publico ?? true %}
            <p class="auth-divider">
                Não tem conta? <a href="{{ path('app_register') }}">Criar conta grátis</a>
            </p>
            {% endif %}
        </div>

        {# ──────────────────────────── PAINEL CADASTRO ──────────────────────── #}
        {% if registrationForm is defined and registrationForm %}
        <div class="auth-panel {{ active_tab == 'register' ? 'active' : '' }}" id="panel-register">

            <h3>Criar conta</h3>
            <p class="sub">Preencha os dados para acessar a plataforma</p>

            {% for msg in app.flashes('register_error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            {{ form_start(registrationForm, {
                'action': path('app_register'),
                'method': 'POST',
                'attr': {'novalidate': 'novalidate'}
            }) }}

                <div class="form-group">
                    <label class="form-label" for="{{ registrationForm.nome.vars.id }}">Nome completo</label>
                    {{ form_widget(registrationForm.nome, {'attr': (active_tab == 'register' ? {'class': 'form-control' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : ''), 'autofocus': 'autofocus'} : {'class': 'form-control' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : '')})}) }}
                    {% if registrationForm.nome.vars.errors|length %}
                        <span class="invalid-feedback">{{ registrationForm.nome.vars.errors[0].message }}</span>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label class="form-label" for="{{ registrationForm.email.vars.id }}">E-mail</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control' ~ (registrationForm.email.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {% if registrationForm.email.vars.errors|length %}
                        <span class="invalid-feedback">{{ registrationForm.email.vars.errors[0].message }}</span>
                    {% endif %}
                </div>

                <div class="form-row-cols">
                    <div class="form-group">
                        <label class="form-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Senha</label>
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmar senha</label>
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                    </div>
                </div>
                {% if registrationForm.plainPassword.vars.errors|length %}
                    <span class="invalid-feedback" style="margin-top:-8px;margin-bottom:10px;">{{ registrationForm.plainPassword.vars.errors[0].message }}</span>
                {% endif %}

                <button type="submit" class="btn-primary">Criar minha conta</button>

            {{ form_end(registrationForm) }}

            <p class="auth-divider">
                Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a>
            </p>
        </div>
        {% endif %}

    </div>{# /auth-right-inner #}
    </div>{# /auth-right #}
</div>{# /auth-wrapper #}
</body>
</html>
