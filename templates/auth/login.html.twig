{% set _tema = platform_config.tema|default('dark') %}
{% set _brand = organismo.copy.brand_name|default(platform_config.plataforma_nome|default('Unio')) %}
{% set _is_clinic = org_clinic|default(false) %}
{% set _slogan = organismo.enabled|default(false)
    ? organismo.copy.marketing_tagline|default(_is_clinic ? 'Saúde que acompanha.' : 'Evolui com você.')
    : platform_config.plataforma_tagline|default('Pessoas. Processos. Resultados.') %}
{# Lead curto no login (mesma ideia do Work: uma frase sob o slogan) #}
{% set _lead = organismo.enabled|default(false)
    ? (_is_clinic
        ? 'Agenda, continuidade pós-operatória e documentos do paciente em um só lugar.'
        : organismo.copy.hero_desc|default(''))
    : '' %}
{% set _eyebrow = organismo.enabled|default(false)
    ? organismo.copy.marketing_eyebrow|default(_is_clinic ? 'Gestão clínica unificada' : 'Plataforma digital')
    : '' %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ _tema }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if active_tab == 'register' %}Criar Conta{% else %}Entrar{% endif %} | {{ _brand }}</title>
    <script>try{var _p=new URLSearchParams(location.search);var _t=_p.get('theme')||localStorage.getItem('unio-theme')||'{{ _tema }}';document.documentElement.setAttribute('data-theme',_t);if(_p.get('theme'))localStorage.setItem('unio-theme',_t);}catch(e){}</script>
    {% include 'components/platform_favicon.html.twig' %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/legal-pages.css') }}?v=3">
    <link rel="stylesheet" href="{{ asset('css/auth-login.css') }}?v=19">
    {% include 'components/unio_theme_vars.html.twig' %}
</head>
<body class="auth-page{% if _is_clinic %} auth-page--clinic{% endif %}">

<div class="auth-scene" aria-hidden="true">
    <div class="auth-scene__gradient"></div>
    <div class="auth-scene__grid"></div>
    <div class="auth-scene__orb auth-scene__orb--1"></div>
    <div class="auth-scene__orb auth-scene__orb--2"></div>
    <div class="auth-scene__ecg"></div>
</div>

<header class="auth-topbar">
    <a href="{{ path('app_home') }}" class="auth-back">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
        Voltar para a página inicial
    </a>
    <div class="auth-topbar__actions">
        {% if platform_config.registro_publico ?? true %}
            {% if active_tab == 'login' %}
            <a href="{{ path('app_register') }}" class="auth-topbar__register">Criar conta</a>
            {% else %}
            <a href="{{ path('app_login') }}" class="auth-topbar__register">Entrar</a>
            {% endif %}
        {% endif %}
        {% include 'components/guest_theme_toggle.html.twig' %}
    </div>
</header>

<main class="auth-main">
    <section class="auth-brand{% if _is_clinic %} auth-brand--story{% endif %}" aria-label="Sobre a plataforma">
        {% if _is_clinic %}
        <div class="auth-brand__media" aria-hidden="true">
            <img
                class="auth-brand__photo"
                src="{{ asset('images/auth/login-clinic-editorial.jpg') }}?v=3"
                alt=""
                width="1200"
                height="1600"
                decoding="async"
            >
            <div class="auth-brand__media-veil"></div>
        </div>
        {% endif %}
        <div class="auth-brand__content{% if _is_clinic %} auth-brand__content--clinic{% else %} auth-brand__content--studio{% endif %}">
            {% if _is_clinic %}
            <div class="auth-brand__top">
                {% include 'components/auth_logo_animated.html.twig' only %}
                <p class="auth-brand__eyebrow">{{ _eyebrow|default('Plataforma clínica') }}</p>
                <h1 class="auth-brand__sr-only">{{ _brand }}</h1>
            </div>
            <div class="auth-brand__story-wrap">
                {% include 'components/auth_brand_story.html.twig' %}
            </div>
            {% else %}
            {% include 'components/auth_logo_animated.html.twig' only %}
            {% if _eyebrow %}
            <p class="auth-brand__eyebrow">{{ _eyebrow }}</p>
            {% endif %}
            <h1 class="auth-brand__title">{{ _slogan }}</h1>
            {% if _lead %}
            <p class="auth-brand__lead">{{ _lead }}</p>
            {% endif %}
            {% endif %}
        </div>

        <footer class="auth-brand__footer">
            {% include 'components/platform_legal.html.twig' with { variant: 'auth', extra_class: ' platform-legal--auth' } %}
        </footer>
    </section>

    <section class="auth-form-zone" aria-label="Acesso à plataforma">
        <div class="auth-card">
            <div class="auth-card__mobile-logo">
                {% include 'components/platform_logo.html.twig' with { variant: 'full', width: 160, height: 48 } only %}
            </div>

            <div class="auth-panel {{ active_tab == 'login' ? 'is-active' : '' }}" id="panel-login">
                <h2 class="auth-panel__title">Bem-vindo de volta</h2>
                <p class="auth-panel__sub">Entre com suas credenciais para acessar a plataforma</p>

                {% for msg in app.flashes('register_success') %}
                    <div class="auth-alert auth-alert--success">{{ msg }}</div>
                {% endfor %}
                {% for msg in app.flashes('auth_info') %}
                    <div class="auth-alert auth-alert--success">{{ msg }}</div>
                {% endfor %}
                {% for msg in app.flashes('auth_error') %}
                    <div class="auth-alert auth-alert--danger">{{ msg }}</div>
                {% endfor %}
                {% if app.debug %}
                    {% for msg in app.flashes('auth_dev_reset_link') %}
                        <div class="auth-alert auth-alert--danger" style="word-break: break-all;">{{ msg }}</div>
                    {% endfor %}
                {% endif %}
                {% if error %}
                    <div class="auth-alert auth-alert--danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="auth-field">
                        <label class="auth-field__label" for="email">E-mail</label>
                        <div class="auth-field__wrap">
                            <i class="fas fa-envelope auth-field__icon" aria-hidden="true"></i>
                            <input class="auth-field__input" id="email" type="email" name="email"
                                   value="{{ last_username }}" placeholder="seu@email.com"
                                   autocomplete="email"{% if active_tab == 'login' %} autofocus{% endif %} required>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="auth-field__label" for="password">Senha</label>
                        <div class="auth-field__wrap">
                            <i class="fas fa-lock auth-field__icon" aria-hidden="true"></i>
                            <input class="auth-field__input" id="password" type="password" name="password"
                                   placeholder="••••••••" autocomplete="current-password" required>
                        </div>
                    </div>

                    <div class="auth-row">
                        <label>
                            <input type="checkbox" name="_remember_me">
                            Lembrar-me por 7 dias
                        </label>
                        <a href="{{ path('app_forgot_password') }}">Esqueci a senha</a>
                    </div>

                    <button type="submit" class="auth-submit">Entrar na plataforma</button>
                </form>

                {% if platform_config.registro_publico ?? true %}
                <div class="auth-card__register">
                    <span class="auth-card__register-label">Ainda não tem conta?</span>
                    <a href="{{ path('app_register') }}" class="auth-register-btn">Criar conta grátis</a>
                </div>
                {% endif %}
            </div>

            {% if registrationForm is defined and registrationForm %}
            <div class="auth-panel {{ active_tab == 'register' ? 'is-active' : '' }}" id="panel-register">
                <h2 class="auth-panel__title">Criar conta</h2>
                <p class="auth-panel__sub">Preencha os dados para acessar a plataforma</p>

                {% for msg in app.flashes('register_error') %}
                    <div class="auth-alert auth-alert--danger">{{ msg }}</div>
                {% endfor %}

                {{ form_start(registrationForm, {
                    action: path('app_register'),
                    method: 'POST',
                    attr: { novalidate: 'novalidate' }
                }) }}

                    <div class="auth-field">
                        <label class="auth-field__label" for="{{ registrationForm.nome.vars.id }}">Nome completo</label>
                        <div class="auth-field__wrap">
                            <i class="fas fa-user auth-field__icon" aria-hidden="true"></i>
                            {{ form_widget(registrationForm.nome, { attr: (active_tab == 'register' ? {
                                class: 'auth-field__input' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : ''),
                                autofocus: 'autofocus'
                            } : {
                                class: 'auth-field__input' ~ (registrationForm.nome.vars.errors|length ? ' is-invalid' : '')
                            }) }) }}
                        </div>
                        {% if registrationForm.nome.vars.errors|length %}
                            <span class="invalid-feedback">{{ registrationForm.nome.vars.errors[0].message }}</span>
                        {% endif %}
                    </div>

                    <div class="auth-field">
                        <label class="auth-field__label" for="{{ registrationForm.email.vars.id }}">E-mail</label>
                        <div class="auth-field__wrap">
                            <i class="fas fa-envelope auth-field__icon" aria-hidden="true"></i>
                            {{ form_widget(registrationForm.email, { attr: {
                                class: 'auth-field__input' ~ (registrationForm.email.vars.errors|length ? ' is-invalid' : '')
                            } }) }}
                        </div>
                        {% if registrationForm.email.vars.errors|length %}
                            <span class="invalid-feedback">{{ registrationForm.email.vars.errors[0].message }}</span>
                        {% endif %}
                    </div>

                    <div class="auth-cols">
                        <div class="auth-field">
                            <label class="auth-field__label" for="{{ registrationForm.plainPassword.first.vars.id }}">Senha</label>
                            {{ form_widget(registrationForm.plainPassword.first, { attr: {
                                class: 'auth-field__input' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')
                            } }) }}
                        </div>
                        <div class="auth-field">
                            <label class="auth-field__label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmar</label>
                            {{ form_widget(registrationForm.plainPassword.second, { attr: {
                                class: 'auth-field__input' ~ (registrationForm.plainPassword.vars.errors|length ? ' is-invalid' : '')
                            } }) }}
                        </div>
                    </div>
                    {% if registrationForm.plainPassword.vars.errors|length %}
                        <span class="invalid-feedback" style="margin-top:-8px;margin-bottom:10px;">{{ registrationForm.plainPassword.vars.errors[0].message }}</span>
                    {% endif %}

                    <div class="register-legal-check">
                        {{ form_widget(registrationForm.aceitoTermos) }}
                        <label for="{{ registrationForm.aceitoTermos.vars.id }}">
                            Li e aceito os
                            <a href="{{ path('app_legal_termos') }}" target="_blank" rel="noopener noreferrer">Termos de Uso</a>
                            e a
                            <a href="{{ path('app_legal_privacidade') }}" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.
                        </label>
                    </div>
                    {% if registrationForm.aceitoTermos.vars.errors|length %}
                        <span class="invalid-feedback" style="display:block;margin-top:-8px;margin-bottom:12px">{{ registrationForm.aceitoTermos.vars.errors[0].message }}</span>
                    {% endif %}

                    <button type="submit" class="auth-submit">Criar minha conta</button>

                {{ form_end(registrationForm) }}

                <p class="auth-footnote">
                    Já tem conta? <a href="{{ path('app_login') }}">Fazer login</a>
                </p>
            </div>
            {% endif %}
        </div>
    </section>
</main>

{% include 'components/cookie_consent_banner.html.twig' %}
<script src="{{ asset('js/unio-cookie-consent.js') }}?v=1" defer></script>
{% if _is_clinic %}
<script src="{{ asset('js/auth-login-story.js') }}?v=1" defer></script>
{% endif %}
</body>
</html>
