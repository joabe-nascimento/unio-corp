# Copie para .env.local no servidor (NÃO commite .env.local)
# Domínio principal: https://uniowork.com.br

APP_ENV=prod
# 1 = erros detalhados + toolbar Symfony (só tenant). Volte para 0 após diagnosticar.
APP_DEBUG=1
APP_SECRET=altere-gerar-string-aleatoria-64-chars

DEFAULT_URI=https://uniowork.com.br

DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO?serverVersion=10.11.2-MariaDB&charset=utf8mb4"

MAILER_DSN=smtp://noreply%40uniowork.com.br:SENHA_SMTP@mail.uniowork.com.br:587
MAILER_FROM_ADDRESS=noreply@uniowork.com.br

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

REDIS_URL=redis://127.0.0.1:6379

VITORIA_AI_ENABLED=false
VITORIA_AI_URL=
VITORIA_AI_KEY=

MERCURE_URL=
MERCURE_PUBLIC_URL=
MERCURE_JWT_SECRET=

# Shell Organismo — Unio Studio (production)
# Clinicaunio usa defaults da clínica em config/packages/unio_organismo.yaml
UNIO_ORGANISMO_ENABLED=true
UNIO_ORGANISMO_PULSO_HOME=true
UNIO_ORGANISMO_BRAND_NAME=Unio Studio
UNIO_ORGANISMO_BRAND_SLOGAN=Sites, sistemas e projetos que evoluem.
UNIO_ORGANISMO_HERO_TITLE=Desenvolvimento de sites, apps e projetos digitais
UNIO_ORGANISMO_HERO_DESC=Unio Studio reúne gestão de projetos, entregas, playbooks de implementação e portal do cliente — um ambiente pensado para equipes que constroem sites, sistemas e projetos clínicos com clareza e ritmo.
UNIO_ORGANISMO_LUMEN_SUBTITLE=Assistente do studio
UNIO_ORGANISMO_UNIT_LABEL=Projeto
UNIO_ORGANISMO_UNIT_LABEL_ARTIGO=do projeto
UNIO_ORGANISMO_UNIT_LABEL_PLURAL=Projetos
UNIO_ORGANISMO_NAV_MATURIDADE=Painel de entregas
UNIO_ORGANISMO_NAV_SECTION_CLIENTS=Projetos
UNIO_ORGANISMO_NAV_PACIENTES=Projetos
UNIO_ORGANISMO_NAV_SALA_CRITICA=Prioridade alta
UNIO_ORGANISMO_NAV_ALERTAS=Alertas
UNIO_ORGANISMO_NAV_SECTION_DELIVERABLES=Entregas
UNIO_ORGANISMO_NAV_PROTOCOLOS=Playbooks
UNIO_ORGANISMO_NAV_QUESTIONARIOS=Check-ins
UNIO_ORGANISMO_NAV_PORTAL=Portal do cliente
UNIO_ORGANISMO_PULSO_PROJECTS_ACTIVE=Projetos ativos
UNIO_ORGANISMO_PULSO_IN_PROGRESS=Em andamento
UNIO_ORGANISMO_PULSO_CASES_HEADING=Entregas em andamento
UNIO_ORGANISMO_PULSO_KPIS_HEADING=Sinais do studio
UNIO_ORGANISMO_PULSO_EMPTY=Nenhuma entrega ativa — tudo em dia.
UNIO_ORGANISMO_HUB_HERO_TITLE=Painel de projetos
UNIO_ORGANISMO_MARKETING_EYEBROW=Studio digital & projetos clínicos
UNIO_ORGANISMO_MARKETING_TAGLINE=Sites, sistemas e projetos que evoluem.
