# =========================================
# Configuração de ambiente para Unio Jurídico
# =========================================
# Copie este arquivo para .env e ajuste os valores
# ou configure diretamente no painel do HostGator

###> jurisflow-ai (Unio Jurídico) - OBRIGATÓRIO ###
# Habilita a Bruna (assistente IA jurídica)
LEGAL_AI_ENABLED=true

# URL do serviço JurisFlow AI
# DESENVOLVIMENTO: http://127.0.0.1:8090
# PRODUÇÃO: https://ia.uniojuridico.com.br (ou IP/domínio do servidor Python)
LEGAL_AI_URL=http://127.0.0.1:8090

# ID padrão do escritório (multi-tenancy)
LEGAL_AI_ESCRITORIO_ID=default
###< jurisflow-ai ###

# =========================================
# INSTRUÇÕES PARA PRODUÇÃO (HostGator)
# =========================================
#
# 1. Hospedar o JurisFlow AI Service:
#    - Opção A: VPS/Cloud separada (AWS, DigitalOcean, Azure)
#    - Opção B: No próprio HostGator (se suportar Python/FastAPI)
#    - Obter URL pública: ex: https://ia.uniojuridico.com.br
#
# 2. Configurar variáveis de ambiente no HostGator:
#    - Acesse: Painel cPanel > Software > Select PHP Version > Switch To PHP Options
#    - Ou adicione ao .htaccess:
#      SetEnv LEGAL_AI_ENABLED true
#      SetEnv LEGAL_AI_URL https://ia.uniojuridico.com.br
#      SetEnv LEGAL_AI_ESCRITORIO_ID default
#
# 3. Limpar cache do Symfony:
#    php bin/console cache:clear --env=prod
#
# =========================================
