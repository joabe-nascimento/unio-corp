# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
DATABASE_URL="mysql://root:@127.0.0.1:3308/unio?serverVersion=10.11.15-MariaDB&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Desenvolvimento (sem envio real):
MAILER_DSN=null://null
# Docker + Mailpit (compose.override): smtp://127.0.0.1:1025
# Produção (SMTP — descomente e ajuste):
# MAILER_DSN=smtp://usuario:senha@smtp.seudominio.com:587
MAILER_FROM_ADDRESS=noreply@unio.local
###< symfony/mailer ###

###> symfony/mercure-bundle ###
# Hub local: docker compose up -d mercure
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=changeme
###< symfony/mercure-bundle ###

###> symfony/cache — Redis (prod: docker compose up -d redis) ###
REDIS_URL=redis://127.0.0.1:6379
###< symfony/cache ###

###> Sasha-ai ###
SASHA_AI_ENABLED=true
SASHA_AI_URL=http://127.0.0.1:8100
SASHA_AI_KEY=dev-Sasha-key-change-me
###< Sasha-ai ###

###> jurisflow-ai (Unio Jurídico) ###
LEGAL_AI_ENABLED=true
LEGAL_AI_URL=http://127.0.0.1:8090
LEGAL_AI_ESCRITORIO_ID=default
###< jurisflow-ai ###

###> unio-organismo (perfil clínica — padrão via unio_organismo.yaml) ###
# Para simular Uniowork localmente, sobrescreva em .env.local:
# UNIO_ORGANISMO_BRAND_NAME=Unio Studio
# UNIO_ORGANISMO_UNIT_LABEL=Projeto
###< unio-organismo ###

###> wallet passes (Apple / Google) — somente Unio Saúde / UnioClínica ###
# Não configure no Uniowork (production). Ver .env.uniosaude.example
# WALLET_APPLE_PASS_TYPE_ID=
# WALLET_GOOGLE_ORIGINS=https://uniosaude.uniowork.com.br
###< wallet passes ###

###> whatsapp meta cloud api (Unio Saúde) ###
# Vazio = noop (wa.me + webhook). Para live:
# WHATSAPP_PROVIDER=meta
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_GRAPH_VERSION=v21.0
WHATSAPP_PROVIDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v21.0
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_EMPRESA_CNPJ=
WHATSAPP_META_TENANT_MAP={}
###< whatsapp meta cloud api ###

###> asaas payments (Unio Saúde) ###
# Use ASAAS_API_KEYS_JSON={"CNPJ_SEM_PONTUACAO":"$aact_..."} para múltiplas clínicas.
ASAAS_API_KEY=
ASAAS_API_KEYS_JSON={}
# Token global obrigatório do webhook Asaas (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
###< asaas payments ###

###> JWT Mobile API ###
# Chave secreta para assinatura de tokens JWT (mínimo 32 caracteres)
# Em produção, use: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
###< JWT Mobile API ###
